                pn := Pen(FA(Alpha(hubCur, 55 + 130*hvL), f), 1.2)
                StrokeRR(lx, lky - lift, 162, HL.lkh, 12, pn), DelP(pn)
                icx2 := lx + 30, icy3 := lky - lift + 28
                b := SBrush(FA(Alpha(hubCur, 34 + 30*hvL), f))
                FillEll(icx2 - 17, icy3 - 17, 34, 34, b), DelB(b)
                pn := Pen(FA(Alpha(hubCur, 130 + 90*hvL), f), 1.2)
                Ell(icx2 - 17, icy3 - 17, 34, 34, pn), DelP(pn)
                icL := FA(Alpha(AccHi(hubCur, 0.45), 235), f)
                if k = 1 {
                    stR := PushXform(icx2, icy3, 1, 12*Sin(DecT(now)*0.0018 + 1))
                    pn := Pen(icL, 1.6)
                    StrokeRR(icx2 - 8, icy3 - 8, 16, 16, 3, pn), DelP(pn)
                    b := SBrush(icL)
                    FillRR(icx2 - 3, icy3 - 3, 6, 6, 1.4, b), DelB(b)
