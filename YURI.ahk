; One table for both the row and the handler, so a card cannot open a profile
; that belongs to the other person. A function rather than a top-level array:
; a top-level `global x := [...]` only exists once control has reached it, and
; this is read from a renderer.
;   u = "" means the handle is copied instead of opened.
CredLinks(who) {
    ; LUNARIS' YouTube card shows "@Lunaris" as a LABEL, not the channel's real
    ; @handle - the url still carries the real handle, so the link resolves. The
    ; discord tag is lower-case because discord names are; the roblox one is not.
    ;
    ; `c` is what a copy card puts on the clipboard when it differs from what
    ; the card SHOWS. Discord wants the bare name - an @ pasted into its search
    ; finds nothing - but the card reads better with one, so the two are stored
    ; apart. Optional: an entry without `c` copies its `h`.
    if (who = 2)
        return [{n: "ROBLOX",  h: "lIIusionator", a: "open profile"
               , u: "https://www.roblox.com/users/10679736474/profile"}
              , {n: "YOUTUBE", h: "@Lunaris",     a: "open channel"
               , u: "https://www.youtube.com/@Luna_.ris182"}
              , {n: "DISCORD", h: "@liiusionator", a: "copy tag", u: "", c: "liiusionator"}]
    return [{n: "ROBLOX",  h: "lmZeaI",   a: "open profile"
           , u: "https://www.roblox.com/users/417371862/profile?friendshipSourceType=PlayerSearch"}
          , {n: "YOUTUBE", h: "@lmZeaI",  a: "open channel"
           , u: "https://www.youtube.com/@lmZeaI"}
          , {n: "DISCORD", h: "@zeaiish", a: "copy tag", u: "", c: "zeaiish"}]
}
HubLink(i) {
    L := CredLinks(credWho)[i]
    if (L.u = "") {
        try A_Clipboard := L.HasOwnProp("c") ? L.c : L.h
        HL.cpAt := A_TickCount
        HubPoke()
        return
    }
    try Run(L.u)
    HubPoke()
}
HubCredWho(w) {
    global credWho, credWhoPrev, credWhoAt
    if (w = credWho)
        return
    ; HubTabSet's guard: reversing before halfway must not make the side you
    ; are leaving the "previous" one, or the crossfade jumps backwards
    if !(credWhoAt && A_TickCount - credWhoAt < FFM_TABMS
         && Ease3((A_TickCount - credWhoAt)/FFM_TABMS) < 0.5)
        credWhoPrev := credWho
    credWho := w, credWhoAt := A_TickCount
    HL.cpAt := 0                     ; the copied flash belongs to the old set
    HubPoke()
}
