; an unset variable, ScreenWatch's bare `try` swallowed it, and the notice was
; gone with no symptom. That is the sixth time this file has been caught by the
; same ordering trap and the previous five were all fixed by moving a
; declaration; this is that move, made to the one place nothing runs before.
global RN_gui := "", RN_dc := 0, RN_bm := 0, RN_g := 0
