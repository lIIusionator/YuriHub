                FFM.clickAt.Delete(cz)
        }
    }
    ; Same for the settings flash. These were never pruned, and the busy
    ; predicate counts them - so changing ONE client setting left an entry in
    ; the map forever and pinned the whole hub at its busy frame rate for the
