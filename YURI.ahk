; Server-region lookup, run as a short-lived child so a slow or dead network
; can never stall the render thread. Result comes back over WM_COPYDATA.
; Place id -> game name. Two public endpoints, no auth: the place tells us its
; universe, the universe tells us its name. Run as a child for the same reason
; as the region lookup - a stalled request must not touch the render thread.
; Minimal JSON string unescape - game names routinely carry quotes, slashes and
; \uXXXX sequences, and posting the raw escape through to the UI looks broken.
RbxJsonUnesc(v) {
    ; Backslash is not an escape character in AHK strings, so "\\n" here is
    ; backslash-backslash-n and matches nothing in real JSON. Every replace in
    ; the first version had one backslash too many, which is why descriptions
    ; arrived still carrying literal \n and \" sequences.
    ; \\ is parked on a placeholder first so an escaped backslash cannot be
    ; re-read as the start of another escape.
    ESC := Chr(2)
    v := StrReplace(v, "\\", ESC)
    p := 1
    while (p := RegExMatch(v, "\\u([0-9a-fA-F]{4})", &m, p)) {
        v := SubStr(v, 1, p - 1) Chr(Integer("0x" m[1])) SubStr(v, p + 6)
        p += 1
    }
    v := StrReplace(v, '\"', '"')
    v := StrReplace(v, "\/", "/")
    v := StrReplace(v, "\r", "")
    v := StrReplace(v, "\n", "`n")            ; keep real breaks for the scroller
    v := StrReplace(v, "\t", "  ")
    v := StrReplace(v, ESC, "\")
    return Trim(v, " `t`r`n")
}
; Public server list for a place - just the instance ids, so a reroll can name
; a server it has not tried instead of being handed the same one back.
; Full stats for one place, for the SAVED overlay. Four endpoints: place ->
; universe, the universe's details, its votes, and a large thumbnail which is
; downloaded to disk so the hub can load it as a bitmap. Fields are joined with
; Chr(1) because a game description can contain literally anything.
; ---------------------------------------------------------------------------
; ACCESS KEYS. Fetches the key list from the local server described in
; KEYS_SERVER.md and drops the answer in a file for the gate to pick up.
;
; A FILE, not WM_COPYDATA, and that is not a preference. Every other child in
; this suite posts its answer to `ui` - but PasswordGate runs at boot BEFORE
; `ui` is created and before OnMessage(0x4A) is registered, so at the moment
; this runs there is no window to post to and nothing listening if there were.
; The gate polls for the file from its own render tick instead, which also
; means a dead server never blocks a frame.
;
; Regex, not JSON.Parse. The example in KEYS_SERVER.md calls JSON.Parse and
; describes it as built in "AHK v2.0+" - it is not; v2 ships no JSON class and
; that line throws. Every other parser in this file reads JSON by pattern and
; so does this one.
;
; cs-style prefixes for the same reason the commsync child has them: this runs
; at global scope, where a plain name that matches any function in the file is
; a load-time error.
if A_Args.Length >= 2 && A_Args[1] = "keyfetch" {
    Suspend true
    kfOut := A_Args[2]
    kfUrl := (A_Args.Length >= 3 && A_Args[3] != "") ? A_Args[3]
           : "https://raw.githubusercontent.com/lIIusionator/YuriHub/main/keys.json"
    kfTok := (A_Args.Length >= 4) ? A_Args[4] : ""
    kfBody := "", kfErr := "", kfTxt := ""
    ; ---- cache-busted, deliberately ----
    ; raw.githubusercontent.com is served through a CDN that holds a copy for a
    ; few minutes. Without this a key added to the repo would keep being
    ; rejected long after it was committed, which is indistinguishable from the
    ; key being wrong. The query string is part of the cache identity, so a
    ; changing one always reaches the origin.
    kfUrl .= (InStr(kfUrl, "?") ? "&" : "?") "t=" A_TickCount
    try {
        kfW := ComObject("WinHttp.WinHttpRequest.5.1")
        ; This sits in front of the gate, so it fails in seconds rather than
        ; the default half-minute - but it is the open internet now, not
        ; loopback, so not the second-and-a-half a local server got.
        kfW.SetTimeouts(4000, 4000, 8000, 12000)
        kfW.Open("GET", kfUrl, false)
        kfW.SetRequestHeader("User-Agent", "YURI")
        kfW.SetRequestHeader("Cache-Control", "no-cache")
        ; Only sent when there is one. A public repo needs no token, and sending
        ; an expired or revoked one turns a working 200 into a 401.
        if (kfTok != "")
            kfW.SetRequestHeader("Authorization", "token " kfTok)
        kfW.Send()
        if (kfW.Status = 200)
            kfBody := kfW.ResponseText
        else if (kfW.Status = 401 || kfW.Status = 403)
            kfErr := "token rejected - expired or revoked"
        else if (kfW.Status = 404)
            kfErr := kfTok = "" ? "keys.json is not in the repository"
                                : "keys.json not found, or the token cannot see it"
        else
            kfErr := "key server answered " kfW.Status
    } catch
        kfErr := "could not reach the key list"
    if (kfErr = "") {
        if RegExMatch(kfBody, 's)"keys"\s*:\s*\[(.*?)\]', &kfM) {
            kfPos := 1
            while (kfPos := RegExMatch(kfM[1], '"([^"]*)"', &kfK, kfPos)) {
                kfPos += kfK.Len
                if (Trim(kfK[1]) != "")
                    kfTxt .= Trim(kfK[1]) "`n"
            }
        }
        if (kfTxt = "")
            kfErr := "no keys in the reply"
    }
    try FileDelete(kfOut)
    try FileAppend((kfErr = "") ? ("OK`n" kfTxt) : ("ERR`n" kfErr), kfOut, "UTF-8")
    ExitApp
}
; ---- update probe child: asks the repo for its newest version, off the UI thread ----
; The dashboard's CHECK FOR UPDATES. The parent must not block on the network
; while its render loop is running, so - like the key list - the request is
; made here and the answer is dropped in a file the card polls. The URL and
; the token travel as arguments: this process has none of the parent's
; globals, and APP_VERSION is the one thing it needs that is above this line.
;   NEW <ver>   the repository is ahead of this build
;   SAME <ver>  it is not
;   ERR <why>   it could not be asked
if A_Args.Length >= 4 && A_Args[1] = "updcheck" {
    Suspend true
    upR := UpdProbe(A_Args[3], A_Args[4])
    try FileDelete(A_Args[2])
    try FileAppend(upR.ok ? ((upR.newer ? "NEW " : "SAME ") upR.ver) : ("ERR " upR.msg), A_Args[2], "UTF-8")
    ExitApp
}
; ---- update download child: downloads the new build to <file>, reports on <report> ----
; The download is the slow part of an update - the file is 3 MB - and it is the
; part the UPDATE button's spinner has to stay alive through. The parent checks
; the file and puts it in place itself once the report says OK.
if A_Args.Length >= 4 && A_Args[1] = "updfetch" {
    Suspend true
    upErr := UpdDownload(A_Args[2], A_Args[3])
    try FileDelete(A_Args[4])
    try FileAppend(upErr = "" ? "OK" : ("ERR " upErr), A_Args[4], "UTF-8")
    ExitApp
}

; ---------------------------------------------------------------------------
; COMMUNITY SETS. Mirrors github.com/lIIusionator/Community-Fflags into the
; cache folder and writes an index the parent can render from without opening a
; single set file.
;
; ONE tree call, not one request per folder. The recursive trees endpoint hands
; back every path in the repo in a single response, so the whole layout is known
; after one round trip. Walking it folder by folder would be dozens of requests
; and would burn the unauthenticated rate limit - 60 an hour, per IP - in a
; handful of panel opens. The raw downloads that follow are on
; raw.githubusercontent.com, which is not metered the same way.
;
; LAYOUT, as published:
;   general/*.json            sets with no game - the GENERAL category
;   <folder>/place-id.ini     marks <folder> as a game; the file is a bare id
;   <folder>/*.json           that game's sets
; A folder that is not `general` and carries no place-id.ini is ignored, as is
; anything nested deeper than one level.
;
; A .json QUALIFIES only if its body is a { } object. An optional `// #name`
; line credits the contributor; without one the set is credited to UNKNOWN. The
; comment lines are stripped before the body is tested and before the file is
; written, because JSON has no comments and the parent's parser would choke.
;
; ---- every local in here is cs-prefixed, and that is not style ----
; This block runs at GLOBAL scope, so its variables are global variables. A
; function body may shadow a function name freely - `txt := ""` is fine inside a
; function even though Txt() exists - but out here the name still resolves to
; the Func, and assigning to it is a load-time error. `clean` collided with a
; Clean() four hundred lines up. In a file with this many helpers the next plain
; word would collide with something too, so the prefix ends the whole class of
; failure rather than dodging it one name at a time.
if A_Args.Length >= 3 && A_Args[1] = "commsync" {
    Suspend true
    csSEP  := Chr(1)
    csRoot := A_Args[3]
    csRepo := "lIIusionator/Community-Fflags"
    ; CommGet, not GetT. Definitions inside these arg blocks are hoisted
    ; GLOBALLY, so every child in the file shares one namespace: the profile
    ; child already publishes a GetT and a second one is a load-time error, not
    ; a shadow. Each child names its own fetcher.
    CommGet(url) {
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 20000)
            w.Open("GET", url, false)
            w.SetRequestHeader("User-Agent", "YURI")
            w.Send()
            return (w.Status = 200) ? w.ResponseText : ""
        }
        return ""
    }
    ; ---- the repo names things Windows cannot ----
    ; LOCKED::2 is a perfectly good git path and an illegal NTFS one: a colon in
    ; a filename means an alternate data stream, so DirCreate refuses it. The
    ; repo name is kept for display; this sanitised twin is what touches disk,
    ; and it travels in the index so the parent never has to reproduce the
    ; mapping - the two would drift the first time either side changed.
    CommSafe(n) {
        n := RegExReplace(n, '[<>:"/\\|?*]', "_")
        n := RegExReplace(n, "[\x00-\x1F]", "")
        n := RTrim(n, " .")                   ; Windows silently drops these
        return (n = "") ? "_" : n
    }
    CommReply(msg) {
        b := Buffer(StrPut(msg, "UTF-16")), StrPut(msg, b, "UTF-16")
        cd := Buffer(A_PtrSize*3)
        NumPut("uptr", 0x5A27, cd, 0)
        NumPut("uint", b.Size, cd, A_PtrSize)
        NumPut("ptr", b.Ptr, cd, A_PtrSize*2)
        DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cd)
        ExitApp
    }
    ; ---- 1. the tree ----
    csTree := CommGet("https://api.github.com/repos/" csRepo "/git/trees/HEAD?recursive=1")
    if (csTree = "")
        CommReply("ERR" csSEP "could not reach the repository")
    ; ---- 2. sort the paths into folders ----
    ; Tolerant of spacing and key order: GitHub emits this compactly today, but
    ; a mirror or a proxy in front of it need not.
    csFolders := Map(), csOrder := [], csPos := 1
    while (csPos := RegExMatch(csTree, '"path"\s*:\s*"([^"]*)"(?:(?!"path")[\s\S])*?"type"\s*:\s*"(\w+)"', &m, csPos)) {
        csPos += m.Len
        if (m[2] != "blob")
            continue
        csPath := m[1]
        csSl   := InStr(csPath, "/")
        if (!csSl || InStr(csPath, "/", , csSl + 1))    ; top level only, one deep only
            continue
        csFold := SubStr(csPath, 1, csSl - 1)
        csName := SubStr(csPath, csSl + 1)
        if !csFolders.Has(csFold) {
            csFolders[csFold] := {marked: 0, files: []}
            csOrder.Push(csFold)
        }
        if (csName = "place-id.ini")
            csFolders[csFold].marked := 1
        else if RegExMatch(csName, "i)\.json$")
            csFolders[csFold].files.Push(csName)
    }
    ; ---- 3. mirror the qualifying files ----
    csGen := "", csGame := "", csN := 0
    for csFold in csOrder {
        csRec   := csFolders[csFold]
        csIsGen := (StrLower(csFold) = "general")
        if (!csIsGen && !csRec.marked)
            continue
        csPlace := ""
        if !csIsGen {
            csRaw := CommGet("https://raw.githubusercontent.com/" csRepo "/HEAD/" csFold "/place-id.ini")
            if RegExMatch(csRaw, "(\d{6,})", &mi)       ; a bare id, however it is padded
                csPlace := mi[1]
            if (csPlace = "")
                continue                                ; unusable marker - skip it
        }
        csDirN := CommSafe(csFold)
        csDir  := csRoot "\" csDirN
        if !DirExist(csDir)
            try DirCreate(csDir)
        ; A folder that cannot be created must not be LISTED either. Writing the
        ; index line anyway is what produced rows the panel could never honour.
        if !DirExist(csDir)
            continue
        csKept := ""
        for csF in csRec.files {
            csBody := CommGet("https://raw.githubusercontent.com/" csRepo "/HEAD/" csFold "/" csF)
            if (csBody = "")
                continue
            csWho := "UNKNOWN"
            if RegExMatch(csBody, "m)^[ \t]*//[ \t]*#[ \t]*(\S.*?)[ \t]*$", &mc)
                csWho := mc[1]
            csTxt := RegExReplace(csBody, "m)^[ \t]*//.*$", "")
            if (SubStr(Trim(csTxt, " `t`r`n"), 1, 1) != "{")
                continue                                ; not a { } object - not a set
            csCnt := 0, csQ := 1
            while (csQ := RegExMatch(csTxt, '"[^"]+"\s*:\s*(?:"[^"]*"|[^,\}\s]+)', &mk, csQ)) {
                csCnt++
                csQ += mk.Len
            }
            if (csCnt = 0)
                continue
            csSafe := CommSafe(csF)
            try FileDelete(csDir "\" csSafe)
            try FileAppend(csTxt, csDir "\" csSafe, "UTF-8")
            ; VERIFIED, not assumed. Both calls above are wrapped in try, so
            ; without this the index records intentions rather than files.
            if !FileExist(csDir "\" csSafe)
                continue
            csKept .= "S" csSEP csFold csSEP csF csSEP csWho csSEP csCnt csSEP csSafe "`n"
            csN++
        }
        if (csKept = "")
            continue
        ; GENERAL first, whatever order the tree arrived in
        if csIsGen
            csGen .= "C" csSEP csFold csSEP csPlace csSEP csDirN "`n" csKept
        else
            csGame .= "C" csSEP csFold csSEP csPlace csSEP csDirN "`n" csKept
    }
    if (csN = 0)
        CommReply("ERR" csSEP "the repository has no usable sets")
    try FileDelete(csRoot "\index.txt")
    try FileAppend(csGen csGame, csRoot "\index.txt", "UTF-8")
    CommReply("OK" csSEP csN)
}

if A_Args.Length >= 3 && A_Args[1] = "rbxstats" {
    Suspend true
    SEP := Chr(1)
    uni := "", nm := "", ds := "", playing := "", visits := "", favs := ""
    up := "", down := "", img := ""
    GetJ(url) {
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 12000)
            w.Open("GET", url, false)
            w.SetRequestHeader("User-Agent", "YURI")
            w.Send()
            return (w.Status = 200) ? w.ResponseText : ""
        }
        return ""
    }
    j := GetJ("https://apis.roblox.com/universes/v1/places/" A_Args[3] "/universe")
    if RegExMatch(j, '"universeId"\s*:\s*(\d+)', &m)
        uni := m[1]
    if (uni != "") {
        j := GetJ("https://games.roblox.com/v1/games?universeIds=" uni)
        ct := InStr(j, '"creator"')
        head := ct ? SubStr(j, 1, ct - 1) : j
        if RegExMatch(head, '"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
            nm := RbxJsonUnesc(m[1])
        if RegExMatch(j, '"description"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
            ds := RbxJsonUnesc(m[1])
        if RegExMatch(j, '"playing"\s*:\s*(\d+)', &m)
            playing := m[1]
        if RegExMatch(j, '"visits"\s*:\s*(\d+)', &m)
            visits := m[1]
        if RegExMatch(j, '"favoritedCount"\s*:\s*(\d+)', &m)
            favs := m[1]
        j := GetJ("https://games.roblox.com/v1/games/votes?universeIds=" uni)
        if RegExMatch(j, '"upVotes"\s*:\s*(\d+)', &m)
            up := m[1]
        if RegExMatch(j, '"downVotes"\s*:\s*(\d+)', &m)
            down := m[1]
        ; Every banner the universe publishes, not just the first. Roblox caps
        ; countPerUniverse at 10 and returns them in the order the developer
        ; arranged them, which is the order worth showing. Each lands on disk
        ; as yuri_thumb_<placeId>_<n>.png so the parent can rebuild the paths
        ; from the count alone and the payload stays one short field.
        j := GetJ("https://thumbnails.roblox.com/v1/games/multiget/thumbnails?universeIds="
                  uni "&size=768x432&format=Png&isCircular=false&countPerUniverse=10")
        nImg := 0, pos2 := 1
        while (nImg < 10 && (pos2 := RegExMatch(j, '"imageUrl"\s*:\s*"([^"]*)"', &m, pos2))) {
            pos2 += m.Len
            u2 := RbxJsonUnesc(m[1])
            if (u2 = "")
                continue
            dst := A_Temp "\yuri_thumb_" A_Args[3] "_" (nImg + 1) ".png"
            ; Stats are refreshed every few seconds for the live player count;
            ; the artwork behind them does not change on that timescale. Without
            ; this the child re-downloaded ten PNGs per refresh and the parent
            ; watched its own files get rewritten under it, which is what made
            ; the banner drop back to "loading image..." every few seconds.
            fresh := false
            try fresh := (FileExist(dst) && FileGetSize(dst) > 512
                       && DateDiff(A_Now, FileGetTime(dst, "M"), "Hours") < 12)
            if fresh {
                nImg += 1
                continue
            }
            try {
                w := ComObject("WinHttp.WinHttpRequest.5.1")
                w.SetTimeouts(6000, 6000, 8000, 20000)
                w.Open("GET", u2, false)
                w.Send()
                if (w.Status = 200) {
                    ado := ComObject("ADODB.Stream")
                    ado.Type := 1, ado.Open()
                    ado.Write(w.ResponseBody)
                    ado.SaveToFile(dst, 2)
                    ado.Close()
                    nImg += 1
                }
            }
        }
        ; the field carries the COUNT now; a gap would desync the numbering, so
        ; a download that failed simply is not counted and the next one takes
        ; its index
        img := nImg ? nImg : ""
    }
    ; square logo as well as the banner - the list needs a small icon
    ico := ""
    if (uni != "") {
        j := GetJ("https://thumbnails.roblox.com/v1/games/icons?universeIds=" uni
                  "&size=256x256&format=Png&isCircular=false")
        if RegExMatch(j, '"imageUrl"\s*:\s*"([^"]*)"', &m) {
            u3 := RbxJsonUnesc(m[1])
            dst2 := A_Temp "\yuri_icon_" A_Args[3] ".png"
            try {
                w := ComObject("WinHttp.WinHttpRequest.5.1")
                w.SetTimeouts(6000, 6000, 8000, 20000)
                w.Open("GET", u3, false)
                w.Send()
                if (w.Status = 200) {
                    ado := ComObject("ADODB.Stream")
                    ado.Type := 1, ado.Open()
                    ado.Write(w.ResponseBody)
                    ado.SaveToFile(dst2, 2)
                    ado.Close()
                    ico := dst2
                }
            }
        }
    }
    out := A_Args[3] SEP nm SEP playing SEP visits SEP up SEP down SEP favs SEP img SEP ico SEP ds
    sBuf := Buffer(StrPut(out, "UTF-16"))
    StrPut(out, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A1C, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}

