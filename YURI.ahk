            }
            cbY := lky + HL.lkh + 18
            FadeLine(x0, x0 + HL.ctw, cbY, 0x1AFFFFFF, f)
            cbdg := ["GDI+ RENDER", "TEAM BUILD", "EST 2026"]
            cbx := x0
            loop 3 {
                k := A_Index
                bwj := 18 + MeasureW(cbdg[k], HL.fS)
                b := SBrush(FA(0x0EFFFFFF, f))
                FillRR(cbx, cbY + 12, bwj, 18, 6, b), DelB(b)
                pn := Pen(FA(Alpha(hubCur, 55 + 30*Abs(Sin(DecT(now)*0.0021 + k))), f), 1)
                StrokeRR(cbx, cbY + 12, bwj, 18, 6, pn), DelP(pn)
                b := SBrush(FA(Alpha(hubCur, 150 + 60*Abs(Sin(DecT(now)*0.0027 + k*1.3))), f))
                FillEll(cbx + 7, cbY + 18.5, 4, 4, b), DelB(b)
                Txt(cbdg[k], cbx + 14, cbY + 13, bwj - 14, 15, HL.fS, FA(0x92C7CBE0, f), fmtL)
                cbx += bwj + 10
            }
            occ := x0 + HL.ctw - 24, ocy2 := cbY + 21
            pn := Pen(FA(Alpha(hubCur, 45), f), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            Ell(occ - 11, ocy2 - 11, 22, 22, pn), DelP(pn)
            oaC := now*0.0024
            b := SBrush(FA(Alpha(AccHi(hubCur, 0.5), 210), f))
            FillEll(occ + 11*Cos(oaC) - 1.8, ocy2 + 11*Sin(oaC) - 1.8, 3.6, 3.6, b), DelB(b)
            b := SBrush(FA(Alpha(hubCur, 140 + 60*emb2G), f))
            FillEll(occ - 2.5, ocy2 - 2.5, 5, 5, b), DelB(b)
            Txt("crafted frame by frame - thank you for running " APPNAME, x0, cbY + 36, HL.ctw - 60, 14, HL.fXs, FA(0x48C7CBE0, f), fmtL)
        } else {
            vbw2 := HL.vbw
            b := SBrush(FA(Alpha(hubCur, 26 + 10*emb2G), f))
            FillRR(x0, y0 + 36, vbw2, 20, 6, b), DelB(b)
            MicroBackdrop(x0, y0 + 36, vbw2, 20, 6, hubCur, f, now, 0.8)
            pn := Pen(FA(Alpha(hubCur, 130), f), 1)
            StrokeRR(x0, y0 + 36, vbw2, 20, 6, pn), DelP(pn)
            Txt(ZVER, x0, y0 + 35, vbw2, 20, fBadge, FA(Alpha(AccHi(hubCur, 0.35), 240), f), fmtC)
            Txt("current build - " (APP_STAGE != "" ? "channel: " StrLower(APP_STAGE) : "release channel")
              , x0 + vbw2 + 12, y0 + 38, 186, 15, fHint, FA(0x66C7CBE0, f), fmtL)
            Txt(APP_VERSION, x0 + HL.ctw - 352, y0 + 60, 150, 64, HL.fG, FA(Alpha(hubCur, 14), f), fmtR)
            Txt((APP_STAGE != "" ? APP_STAGE : "RELEASE") " BUILD", x0 + HL.ctw - 352, y0 + 124, 150, 16, fBadge, FA(Alpha(hubCur, 32), f), fmtR)
            ents := CHANGELOG
            tlx := x0 + 8
            listTop := y0 + 70, listBot := HL.pd + HL.ch - 22
            visH := listBot - listTop
            HL.lgMax := Max(0, ents.Length*24 + 58 - visH)
            HL.lgScT := Clamp(HL.lgScT, 0.0, HL.lgMax + 0.0)
            scp := Clamp(HL.lgSc, 0.0, HL.lgMax + 0.0)
            DllCall("gdiplus\GdipSetClipRect", "ptr", G, "float", x0 - 8, "float", listTop, "float", HL.ctw - 224, "float", visH, "int", 0)
            b := VBrush(tlx, listTop - scp, 1, ents.Length*24 + 6, FA(Alpha(0xFFFFFF, 46), f), Alpha(0xFFFFFF, 0))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", tlx, "float", listTop - scp, "float", 1, "float", ents.Length*24 + 6), DelB(b)
            ppy := listTop - scp + Mod(DecT(now)*0.045, ents.Length*24 + 6)
            b := SBrush(FA(Alpha(hubCur, 60), f))
            FillEll(tlx - 4, ppy - 4, 8, 8, b), DelB(b)
            b := SBrush(FA(Alpha(AccHi(hubCur, 0.4), 220), f))
            FillEll(tlx - 1.6, ppy - 1.6, 3.2, 3.2, b), DelB(b)
            loop ents.Length {
                i4 := A_Index
                tdel := Min(Max((now - scrA - 120 - i4*46)/260.0, 0.0), 1.0)
                ta := 1 - (1 - tdel)**3
                ey := y0 + 76 + (i4 - 1)*24 + (1 - ta)*6 - scp
                if ey > listBot || ey + 20 < listTop
                    continue
                add := ents[i4][1] = "+"
                dcol := add ? hubCur : AMBER
                b := SBrush(FA(Alpha(dcol, 70*ta), f))
                FillEll(tlx - 5.5, ey + 1.5, 11, 11, b), DelB(b)
                b := SBrush(FA(Alpha(dcol, 235*ta), f))
                FillEll(tlx - 2.5, ey + 4.5, 5, 5, b), DelB(b)
                Txt(ents[i4][1], tlx + 14, ey - 1, 14, 16, fBadge, FA(Alpha(dcol, 225*ta), f), fmtL)
                ; Elided, not just clipped. The row was drawn at the full
                ; column width and the clip cut it mid-word, so a long entry
                ; ran straight into the gallery panel on the right.
                ewd := HL.ctw - 262
                Txt(FFMElide(ents[i4][2], fHint, ewd), tlx + 30, ey - 1, ewd, 16, fHint
                    , FA(Alpha(0xC7CBE0, 90 + 120*ta), f), fmtL)
            }
            dxL := x0 + 6, dyL := y0 + 76 + ents.Length*24 + 30 - scp
            if dyL - 16 <= listBot {
                pn := Pen(FA(Alpha(0xFFFFFF, 26), f), 1)
                Line(dxL, dyL, dxL + 44, dyL, pn)
                Line(dxL + 44, dyL, dxL + 44, dyL - 14, pn)
                Line(dxL + 44, dyL - 14, dxL + 108, dyL - 14, pn)
                Line(dxL + 108, dyL - 14, dxL + 108, dyL + 8, pn)
                Line(dxL + 108, dyL + 8, dxL + 168, dyL + 8, pn), DelP(pn)
                b := SBrush(FA(Alpha(0xFFFFFF, 58), f))
                FillEll(dxL + 42.6, dyL - 1.4, 2.8, 2.8, b)
                FillEll(dxL + 106.6, dyL - 15.4, 2.8, 2.8, b), DelB(b)
                tpL := Mod(DecT(now), 3200)/3200.0*216
                if tpL <= 44
                    pxL := dxL + tpL, pyL := dyL
                else if tpL <= 58
                    pxL := dxL + 44, pyL := dyL - (tpL - 44)
                else if tpL <= 122
                    pxL := dxL + 44 + (tpL - 58), pyL := dyL - 14
                else if tpL <= 144
                    pxL := dxL + 108, pyL := dyL - 14 + (tpL - 122)
                else
                    pxL := dxL + 108 + (tpL - 144), pyL := dyL + 8
                b := SBrush(FA(Alpha(hubCur, 55), f))
                FillEll(pxL - 4, pyL - 4, 8, 8, b), DelB(b)
                b := SBrush(FA(Alpha(AccHi(hubCur, 0.4), 220), f))
                FillEll(pxL - 1.8, pyL - 1.8, 3.6, 3.6, b), DelB(b)
            }
            DllCall("gdiplus\GdipResetClip", "ptr", G)
            if HL.lgMax > 0 {
                sbx2 := x0 + HL.ctw - 238
                b := SBrush(FA(Alpha(0xFFFFFF, 22), f))
                FillRR(sbx2, listTop, 3, visH, 1.5, b), DelB(b)
                th2 := Max(24, visH*visH/(visH + HL.lgMax))
                ty2 := listTop + (visH - th2)*(scp/HL.lgMax)
                b := SBrush(FA(Alpha(hubCur, 150 + 30*emb2G), f))
                FillRR(sbx2, ty2, 3, th2, 1.5, b), DelB(b)
            }
            if GalHasRot() {
                ; clamps to the ROTATION range, and back to the START of it. An
                ; index that has fallen out of range is a rotation that needs
                ; restarting, and a restart begins at 1 - see the note in
                ; PasswordGate. GalReload is the one place that still jumps to
                ; the end, because there it means "here is the one you just
                ; added" rather than "here is where the rotation begins".
                if HL.lgIdx < GalLo() || HL.lgIdx > GalHi()
                    HL.lgIdx := GalLo(), HL.lgNext := GalLo()
                if !HL.lgFadeAt && now - HL.lgAt >= 3000
                    HL.lgNext := (HL.lgIdx >= GalHi()) ? GalLo() : HL.lgIdx + 1, HL.lgFadeAt := now
                lgf := HL.lgFadeAt ? Ease3((now - HL.lgFadeAt)/420.0) : 1.0
                gx0 := x0 + HL.ctw - 224, gy0 := y0 + 40, gw2 := 212
                gh2 := HL.pd + HL.ch - HL.cty - 96
