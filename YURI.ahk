                    Ell(gdx - 7.5, ryR + 15.5, 15, 15, pn), DelP(pn)
                }
            }
        } else if tab = 5 {
            py0 := y0 + 34, ph_ := 128
            b := VBrush(x0, py0, HL.ctw, ph_, FA(0xFF171A30, f), FA(0xFF12141F, f))
            FillRR(x0, py0, HL.ctw, ph_, 12, b), DelB(b)
            MiniBackdrop(x0, py0, HL.ctw, ph_, 12, hubCur, f, now, 1.0)
            pn := Pen(FA(Alpha(hubCur, 80 + 30*emb2G), f), 1.2)
            StrokeRR(x0, py0, HL.ctw, ph_, 12, pn), DelP(pn)
            pn := Pen(FA(Alpha(hubCur, 130), f), 1.6)
            Line(x0 + 12, py0 + 1.5, x0 + 30, py0 + 1.5, pn)
            Line(x0 + HL.ctw - 30, py0 + ph_ - 1.5, x0 + HL.ctw - 12, py0 + ph_ - 1.5, pn), DelP(pn)
            ; Two columns in one card rather than two cards: the chrome, the
