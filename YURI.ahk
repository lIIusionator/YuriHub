                    }
                }
            } else {
                sr := (ok = 2) ? 1.6*k : 1.15*k
                b := SBrush(FA(Alpha(AccHi(col, ok = 2 ? 0.25 : 0.1)
                                    , Round((ok = 2 ? 140 : 95) + 70*hv)), f))
                FillEll(cxr + rp*Cos(oa3) - sr, cyr + rp*Sin(oa3) - sr, sr*2, sr*2, b), DelB(b)
            }
        }

    } else {
        ; SOLID - a rim-lit bezel: gradient stroke, inner hairline, and a
        ; breathing outer edge, rather than one flat circle
        gbr := VBrush(cxr - r, cyr - r, r*2, r*2
            , FA(Alpha(AccHi(col, 0.55), Round(235 + 20*hv)), f)
            , FA(Alpha(Mix(col, 0xFF000000, 0.22), Round(150 + 40*hv)), f))
        DllCall("gdiplus\GdipCreatePen2", "ptr", gbr, "float", 2.0, "int", 2, "ptr*", &gpn := 0)
        Ell(cxr - r, cyr - r, r*2, r*2, gpn)
        DllCall("gdiplus\GdipDeletePen", "ptr", gpn), DelB(gbr)
        ri := r - 2.4*k
        pn := Pen(FA(Alpha(0xFFFFFF, Round(30 + 40*hv)), f), 1)
        Ell(cxr - ri, cyr - ri, ri*2, ri*2, pn), DelP(pn)
        re := r + 1.6*k
        pn := Pen(FA(Alpha(lit, Round((34 + 30*ph)*(1 + 1.4*hv))), f), 1)
        Ell(cxr - re, cyr - re, re*2, re*2, pn), DelP(pn)
    }

    ; hover pulse, shared by every style so the portrait answers the cursor
    if hv > 0.01 {
        pr := Mod(now2, 1500)/1500.0
        pn := Pen(FA(Alpha(col, Round(120*hv*(1 - pr)**1.5)), f), 1.8*(1 - pr) + 0.3)
        ex := (2 + pr*11)*k
        Ell(cxr - r - ex, cyr - r - ex, (r + ex)*2, (r + ex)*2, pn), DelP(pn)
    }
}
