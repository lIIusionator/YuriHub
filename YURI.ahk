; ---- keep a transient fault from taking the whole suite down --------------
; Without this, ONE uncaught error inside any timer - render, the process poll,
; a fetch coming back - puts up AutoHotkey's error dialog and ends the script.
; The suite runs ~10 timers, several of which touch another process's memory or
; GDI+ objects that can be disposed a frame early, so the realistic faults here
; are transient: the next tick would have been fine. ResetSurface clears clip
; and transform at the top of every frame, so a frame that dies mid-render
; leaves nothing behind. Log it and let that one thread unwind quietly.
; Errors are still visible - they go to YURI\errors.log - just not fatal.
OnError(YuriError)
YuriSessionStart()
; Where the log goes. One place, so the session markers and the error writer
; cannot disagree about it.
YuriLogDir() {
    dir := YURI_ROOT
    if !DirExist(dir)
        try DirCreate(dir)
    return DirExist(dir) ? dir : A_Temp
}
YuriLog(line) {
    try FileAppend(FormatTime(, "yyyy-MM-dd HH:mm:ss") "  " line "`n"
                 , YuriLogDir() "\errors.log", "UTF-8")
}

; Session markers. OnError only ever sees errors AutoHotkey itself raised - it
; cannot see an access violation inside a DllCall, and a GDI+ handle used after
; it was disposed takes the process down with no Error object and no chance to
; write anything. That failure mode is invisible in a log of errors, which is
; exactly why a crash here reads as "cause unknown".
;
; So the log records the shape of the session as well as its errors:
;   START  ... every launch
;   EXIT   ... every clean shutdown, with the reason
; A START with no matching EXIT and no error line above it means the process
; was killed from outside AutoHotkey - a hard fault, not a script error. A
; START followed by an error line and then no EXIT means the opposite. Those
; two cases need completely different fixes, and this is what tells them apart.
YuriSessionStart() {
    YuriLog("---- START  " ZVER "  ahk " A_AhkVersion (A_IsCompiled ? " compiled" : "") )
}
YuriSessionEnd(reason := "", code := 0) {
    YuriLog("---- EXIT   " (reason != "" ? reason : "normal"))
}

YuriError(e, mode := "") {
    static lastMsg := "", lastAt := 0, dropped := 0
    msg := ""
    try msg := IsObject(e) ? (e.HasOwnProp("Message") ? e.Message : "error") : String(e)
    ; A failing frame repeats sixty times a second, so repeats are collapsed -
    ; but only repeats of the SAME message. The old check dropped anything
    ; within two seconds of the previous error whatever it was, which meant a
    ; cascade hid the one line that explained it: the first error would be
    ; logged and the real root cause two frames later thrown away.
    if (msg = lastMsg && lastAt && A_TickCount - lastAt < 2000) {
        dropped++
        return -1
    }
    try {
        ln := "?", wht := "", ext := "", fil := "", stk := ""
        try ln  := IsObject(e) && e.HasOwnProp("Line")  ? e.Line  : "?"
        try wht := IsObject(e) && e.HasOwnProp("What")  ? e.What  : ""
        try ext := IsObject(e) && e.HasOwnProp("Extra") ? e.Extra : ""
        try fil := IsObject(e) && e.HasOwnProp("File")  ? e.File  : ""
        ; The stack is the part that was missing. Without it the log says which
        ; line threw but not how it was reached, and in a renderer called from
        ; a timer that is most of the answer.
        try stk := IsObject(e) && e.HasOwnProp("Stack") ? e.Stack : ""
        if (fil != "")
            SplitPath(fil, &fil)
        ; What the hub was doing. A crash that only ever happens on one tab or
        ; inside one overlay is a very different search from one that happens
        ; anywhere.
        st := ""
        try st := "tab " hubTab "/mod " hubMod
                . (SPF.view != "" ? " spf:" SPF.view : "")
                . (FFM.view != "" ? " ffm:" FFM.view : "")
                . (HL.drag ? " drag:" HL.drag : "")
        YuriLog("ERROR  " (fil != "" ? fil ":" : "") ln "  " wht "  " msg
              . (ext != "" ? "  [" ext "]" : "")
              . (st  != "" ? "  {" st "}" : "")
              . (dropped ? "  (+" dropped " same suppressed)" : ""))
        if (stk != "") {
            for sl in StrSplit(RTrim(stk, "`r`n"), "`n") {
                if (Trim(sl) != "")
                    try FileAppend("        " Trim(sl, "`r") "`n", YuriLogDir() "\errors.log", "UTF-8")
            }
        }
    }
    lastMsg := msg, lastAt := A_TickCount, dropped := 0
    return -1
}

