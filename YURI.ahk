    ; only lasts 360 ms.
    RSET.srcT += ((rsetSrcOn ? 1.0 : 0.0) - RSET.srcT)*EK(0.24)
    RSET.srcSelT += (rsetSrcSel - RSET.srcSelT)*EK(0.26)
    if RSET.flashAt.Count {
        for fz, ft in RSET.flashAt.Clone() {
