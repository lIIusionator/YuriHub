SPFZone(ux, uy) {
    ax := HL.abx, ay := HL.aby
    ; The sub-options live INSIDE row 1, so they have to be tested before it -
    ; otherwise every chip click lands on the row and flips the parent switch.
    ; Only clickable while that switch is on, which is also the only time they
    ; are drawn.
    sysVis := SPFSysVis()
    ; rows scroll now, so every row test resolves through SPF.sysScr
    if (spfDiscord && HL.modT > 0.5) {
        r1 := ay + SPFSysRowY(1) - SPF.sysScr
        sy := SPFSubY(r1)
        if (uy >= sy && uy <= sy + SPF_SUBH && uy <= ay + sysVis + 6) {
            loop SPF_SUBN {
                k := A_Index
                sx := SPFSubX(ax, k)
                if (ux >= sx && ux <= sx + SPF_SUBW)
                    return 974 + k
            }
        }
    }
    ; ...and row 6 carries its own three, on the same terms: tested before the
    ; row, drawn and clickable only while FPS BOOST is on. Their band is
    ; SPF_SUB6Z - see the note there for why it is not 984.
    if (spfFps && HL.modT > 0.5) {
        r6 := ay + SPFSysRowY(6) - SPF.sysScr
        sy6 := SPFSubY(r6)
        if (uy >= sy6 && uy <= sy6 + SPF_SUBH && uy <= ay + sysVis + 6) {
            loop SPF_SUB6N {
                k := A_Index
                sx6 := SPFSub6X(ax, k)
                if (ux >= sx6 && ux <= sx6 + SPF_SUB6W)
                    return SPF_SUB6Z + k
            }
        }
    }
    ; Systems scrollbar. NOT 964 - that is 960 + SPF_SYSN, i.e. row 4, so a
    ; drag on the bar was landing in SPFToggle and flipping the row it was
    ; scrolling to.
    if (SPFSysTotal() > sysVis
        && ux >= ax + HL.abw - 12 && ux <= ax + HL.abw
        && uy >= ay + 10 && uy <= ay + 10 + sysVis)
        return 971
    if (uy >= ay + 6 && uy <= ay + sysVis + 6 && ux >= ax && ux <= ax + HL.abw) {
        loop SPF_SYSN {
            i := A_Index
            ry := ay + SPFSysRowY(i) - SPF.sysScr
            ; clamped to the window: the clip means the part of a row hanging
            ; past the edge is not drawn, so it must not be clickable either
            top := Max(ry, ay + 10), bot := Min(ry + HL.spfrh, ay + 10 + sysVis)
            if (uy >= top && uy <= bot) {
                if (ux >= ax + HL.abw - 64 && ux <= ax + HL.abw - 16)
                    return 980 + i               ; the switch acts
                ; 1060 + i, NOT 960 + i. A sixth system claims 966, which is
                ; already the GAME LINK field - the row would have swallowed
                ; every click meant for the box. The explaining half of each
                ; row lives in its own band now, the way CLIENT SETTINGS does
                ; it at 1080 + i.
                return 1060 + i                  ; the row explains
            }
        }
    }
    if (uy >= ay + 140 && uy <= ay + 166) {
        ; equal halves - the split has to be computed the same way SPFSystems
        ; draws it, or one button ends up with a hitbox the other owns
        lbTot := HL.abw - 70
        lbW   := (lbTot - 8)/2
        if (ux >= ax + 54 && ux <= ax + 54 + lbW)
            return 1029
        if (ux >= ax + 54 + lbW + 8 && ux <= ax + 54 + lbW*2 + 8)
            return 970
    }
    if (ux >= ax + HL.abw - 88 && ux <= ax + HL.abw - 16) {
        if (uy >= ay + 188 && uy <= ay + 214)
            return 968
        if (uy >= ay + 236 && uy <= ay + 262)
            return 969
    }
    if (uy >= ay + 188 && uy <= ay + 214 && ux >= ax + 54 && ux <= ax + HL.abw - 96)
        return 966
    if (uy >= ay + 236 && uy <= ay + 262 && ux >= ax + 54 && ux <= ax + HL.abw - 96)
        return 967
    px := ax, py := HL.spfby, pw := HL.abw
    if (ux >= px && ux <= px + pw && uy >= py && uy <= py + 96)
        ; 1011, NOT 965: row detail ids run 960 + i, so a fifth system row
        ; claims 965. Leaving this here would have made a click anywhere on the
        ; LIVE panel open the multi-instance sheet.
        return 1011
    return 0
}
SPFStatus() {
    if !SPF.saveOk
        return "settings are not saving - check YURI\config\zeal.ini"
    if (!spfDiscord && !spfRegion && !spfMatch && !spfOdds && !spfMulti)
        return "all features off"
    if !SPF.inGame
        return "waiting for a roblox game"
    if (SPF.region != "")
        return SPF.region
    return spfRegion ? "locating server..." : "in a game"
}

; ---- row glyphs ------------------------------------------------------------
; Drawn rather than fonted so they inherit the accent and the live/idle alpha
; like every other module's icons do.
SPFIcon(i, cx, cy, col, live, now) {
    ; LOW PERFORMANCE MODE: no glyphs. The row still has its name and its
    ; switch, which is everything the row actually means.
    if hubLowPerf
        return
    if (i = 1) {
        ; chat bubble with a tail - discord presence
        pn := Pen(col, 1.4)
        StrokeRR(cx - 8, cy - 7, 16, 12, 4, pn)
        Line(cx - 3, cy + 5, cx - 5, cy + 9, pn)
        Line(cx - 5, cy + 9, cx + 1, cy + 5, pn), DelP(pn)
        b := SBrush(col)
        loop 2 {
            dr := 1.3 + (live ? 0.35*Abs(Sin(DecT(now)*0.005 + A_Index)) : 0)
            FillEll(cx - 2.3 + (A_Index - 1)*5.2 - dr, cy - 0.9 - dr, dr*2, dr*2, b)
        }
        DelB(b)
    } else if (i = 2) {
        ; globe - the meridian sweeps when a region is actually known
        pn := Pen(col, 1.4)
        Ell(cx - 8, cy - 8, 16, 16, pn)
        Line(cx - 6.9, cy - 3.4, cx + 6.9, cy - 3.4, pn)
        Line(cx - 8, cy, cx + 8, cy, pn)
        Line(cx - 6.9, cy + 3.4, cx + 6.9, cy + 3.4, pn)
        mw := live ? (2.8 + Abs(Cos(DecT(now)*0.0016))*5.2) : 5
        Ell(cx - mw, cy - 8, mw*2, 16, pn), DelP(pn)
    } else if (i = 3) {
        ; radar - a sweep hand circling a target, so matchmaking does not wear
        ; the same globe as the row above it
        pn := Pen(col, 1.4)
        Ell(cx - 8, cy - 8, 16, 16, pn)
        Ell(cx - 3.6, cy - 3.6, 7.2, 7.2, pn), DelP(pn)
        aa := live ? now*0.0038 : 0.9
        pn := Pen(col, 1.6)
        Line(cx, cy, cx + 7.4*Cos(aa), cy + 7.4*Sin(aa), pn), DelP(pn)
        b := SBrush(col)
        FillEll(cx - 1.5, cy - 1.5, 3, 3, b), DelB(b)
        if live {
            pk := Mod(DecT(now), 1400)/1400.0
            pn := Pen(FA(col, 1 - pk), 1.2)
            rr := 2 + pk*7
            Ell(cx - rr, cy - rr, rr*2, rr*2, pn), DelP(pn)
        }
    } else if (i = 4) {
        ; three candidate servers with the nearest one picked out - the row
        ; chooses between servers, it does not sweep for them like row 3
        b := SBrush(col)
        pn := Pen(col, 1.3)
        loop 3 {
            k := A_Index
            bxk := cx - 7 + (k - 1)*7
            hk  := (k = 2) ? 11 : 6
            if (k = 2 && live) {
                ; the chosen one lifts and fills, breathing while armed
                lift := 1.4*(Sin(DecT(now)*0.0032) + 1)/2
                FillRR(bxk - 2.2, cy + 5 - hk - lift, 4.4, hk + lift, 1.4, b)
            } else if (k = 2) {
                FillRR(bxk - 2.2, cy + 5 - hk, 4.4, hk, 1.4, b)
            } else {
                StrokeRR(bxk - 2.2, cy + 5 - hk, 4.4, hk, 1.4, pn)
            }
        }
        DelB(b)
        Line(cx - 9, cy + 6, cx + 9, cy + 6, pn), DelP(pn)
        if live {
            ; a tick over the chosen server once the feature has something
            pn := Pen(FA(col, 0.9), 1.5)
            Line(cx - 1.2, cy - 7.4, cx + 0.4, cy - 5.8, pn)
            Line(cx + 0.4, cy - 5.8, cx + 3.4, cy - 9.6, pn), DelP(pn)
        }
    } else if (i = 5) {
        ; three cascading client windows. Off, they sit stacked flat - one
        ; client, the others only implied. On, the stack fans apart and drifts,
        ; which is the whole point of the row stated as a picture.
        sp := live ? (2.6 + 0.7*(Sin(DecT(now)*0.0026) + 1)/2) : 1.5
        ; back to front, so the nearest window sits on top of the others
        loop 3 {
            k   := 4 - A_Index                    ; 3, 2, 1
            ox  := cx - 6.5 + (k - 1)*sp
            oy  := cy - 5.5 + (k - 1)*sp
            dim := (k = 1) ? 1.0 : (live ? 0.62 : 0.4)
            ; each window is punched out of the ones behind it, so the stack
            ; reads as depth rather than as overlapping outlines
            bk := SBrush(FA(Alpha(0xFF0B0D16, 235), 1))
            FillRR(ox, oy, 13, 11, 2.2, bk), DelB(bk)
            pk := Pen(FA(col, dim), 1.3)
            StrokeRR(ox, oy, 13, 11, 2.2, pk)
            Line(ox, oy + 3.4, ox + 13, oy + 3.4, pk), DelP(pk)   ; title bar
            if (k = 1) {
                bk := SBrush(FA(col, live ? 0.85 : 0.45))
                FillEll(ox + 2, oy + 1.1, 2.2, 2.2, bk), DelB(bk)
            }
        }
    } else {
        ; A frame-rate trace: five bars under a running needle. Off, the bars
        ; sit low and even. On, they climb and the needle sweeps across them,
        ; so the glyph reads as "more frames" rather than as a generic gauge -
        ; and nothing about it suggests a quality slider, which is the one
        ; thing this row must not be mistaken for.
        pn := Pen(col, 1.4)
        loop 5 {
            k  := A_Index
            bx := cx - 8.5 + (k - 1)*4.2
            ; each bar has its own phase, so the group ripples instead of
            ; pumping in unison
            amp := live ? (0.5 + 0.5*Sin(DecT(now)*0.0042 + k*0.9)) : 0.18
            bh  := 2.5 + amp*8.5
            Line(bx, cy + 7, bx, cy + 7 - bh, pn)
        }
        DelP(pn)
        if live {
            ; the needle rides the top of whichever bar it is over
            ph := Mod(DecT(now)*0.0011, 1.0)
            nx := cx - 8.5 + ph*16.8
            k2 := Clamp(Floor(ph*5) + 1, 1, 5)
            am := 0.5 + 0.5*Sin(DecT(now)*0.0042 + k2*0.9)
            b2 := SBrush(col)
            FillEll(nx - 1.7, cy + 7 - (2.5 + am*8.5) - 1.7, 3.4, 3.4, b2), DelB(b2)
        }
        pn := Pen(FA(col, live ? 0.75 : 0.4), 1.2)
        Line(cx - 10, cy + 8.2, cx + 10, cy + 8.2, pn), DelP(pn)
    }
}

; ---- systems panel ---------------------------------------------------------
SPFSystems(ax, ay, x0, y0, dx, dy2, ff, now, acc) {
    global spfDiscord, spfRegion, spfMatch, spfOdds, spfMulti, spfFps, spfDcAcct, spfDcJoin, spfDcFocus
    mt := HL.modT
    onN := (spfDiscord ? 1 : 0) + (spfRegion ? 1 : 0) + (spfMatch ? 1 : 0) + (spfOdds ? 1 : 0)
         + (spfMulti ? 1 : 0) + (spfFps ? 1 : 0)

    Txt("SYSTEMS", ax, y0 + 36, 120, 14, fBadge, FA(0x62C7CBE0, ff), fmtL)
    Txt(mt > 0.5 ? SPF_SYSN " listed" : "0 listed", ax + 66, y0 + 36, 80, 14, HL.fS
        , FA(Alpha(acc, 60 + 120*mt), ff), fmtL)
    if (mt > 0.4) {
        fh := ff*Clamp((mt - 0.4)/0.4, 0.0, 1.0)
        Txt(SPFStatus(), ax + HL.abw - 280, y0 + 30, 280, 22, fHint
            , FA(Alpha(SPF.inGame ? 0xFFC7CBE0 : 0xFF9AA8C0, 145), fh), fmtR)
    }

    ; ---- panel shell (same chrome as the other systems panels) ----
    pah := 26 + (HL.spfh - 26)*mt
    b := VBrush(ax, ay, HL.abw, pah, FA(Mix(0xFF141728, 0xFF181C34, mt), ff), FA(0xFF12141F, ff))
    FillRR(ax, ay, HL.abw, pah, 12, b), DelB(b)
    MiniBackdrop(ax, ay, HL.abw, pah, 12, acc, ff, now, 0.9)
    HubEmptyGhost(ax, ay, pah, ff)          ; the collapsed state, fading back in
    pn := Pen(FA(Alpha(acc, 70 + 90*mt), ff), 1.2)
    StrokeRR(ax, ay, HL.abw, pah, 12, pn), DelP(pn)
    gl := 40*mt
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), 200*mt), ff), 1.6)
    Line(ax + 14, ay + 0.6, ax + 14 + gl, ay + 0.6, pn)
    Line(ax + HL.abw - 14 - gl, ay + pah - 0.6, ax + HL.abw - 14, ay + pah - 0.6, pn), DelP(pn)

    ModRing(ax, ay, HL.abw, pah, 12, acc, ff, HL.modAt, now, 700, 18, hubMod != 0)
    if (mt < 0.02)
        return

    pClip := RRPath(ax, ay, HL.abw, pah, 12)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pClip, "int", 0)

    names := ["DISCORD ACTIVITY", "SHOW SERVER REGION", "AUTO-REGION FINDER", "BETTER MATCHMAKING"
            , "MULTI-ROBLOX INSTANCES", "FPS BOOST"]
    hints := ["show the roblox game you are in on your discord profile"
            , "show which region your current server is hosted in"
            , "rejoin until you land on a server in your own region"
            , (spfOdds && SPF.srvSeen.Count)
                ? (SPF.srvSeen.Count " server" (SPF.srvSeen.Count = 1 ? "" : "s") " measured this session")
                : "picks a server this session already measured as close to you"
            ; the count is the proof the switch is doing something - a plain
            ; description would leave the user guessing whether it took
            ; The badge beside this row says RESTART ROBLOX when it applies; the
            ; hint says how many and why, which is the part that does not fit on
            ; a badge.
            , spfMulti
                ? ((stale := SPFMultiStale())
                     ? (stale " client" (stale = 1 ? "" : "s")
                        " started before this was on  ·  close and relaunch from the website")
                 : (rbxN := SPFRbxCount()) ? (rbxN " client" (rbxN = 1 ? "" : "s")
                                              " running  ·  press play on the website to add one")
                                           : "ready  ·  launch from the website, not the shortcut")
                : "run more than one roblox client at once"
            ; the count is the whole story here: the switch does nothing
            ; visible, so the row has to say what it actually took
            ; The row is where the proof lives, so it carries the readings in
            ; priority order: a power state that caps clocks outranks anything
            ; here, then whether the client is even CPU-bound - because where it
            ; is not, every lever is working and none of them can buy a frame,
            ; and saying so is better than letting the switch look broken.
            ; With the chips up there is about 66px left on this line, so the
            ; readout switches to its terse form rather than being elided into
            ; nonsense. The full sentence is what the status line carries.
            , spfFps
                ? SPFFpsHintShort()
                : "more frames without touching a single graphics setting"]
    ons   := [SPF.t1, SPF.t2, SPF.t3, SPF.t4, SPF.t5, SPF.t6]

    ; ---- rows ----
    ; A fourth system outgrew the window, so the rows scroll. The scroll is
    ; eased toward its target rather than snapped, which is what stops a wheel
    ; notch reading as a jump-cut.
    sysVis := SPFSysVis()
    scr := SPF.sysScr
    ; A REAL clip, not just a skip test. Skipping only drops rows that are
    ; entirely outside; a row straddling the edge still drew in full, which is
    ; how row 4 ended up painted over the divider and the SAVED PLACES button
    ; below it. Intersected inside a saved state so the panel clip survives.
    svRows := PushG()
    pRows := RRPath(ax + 2, ay + 8, HL.abw - 4, sysVis + 2, 8)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pRows, "int", 1)
    loop SPF_SYSN {
        i := A_Index
        cg := Clamp((mt - 0.30 - Min(i, 3)*0.07)/0.38, 0.0, 1.0)
        if (cg <= 0.01)
            continue
        fb := ff*cg
        ry := ay + SPFSysRowY(i) - scr
        if (ry + HL.spfrh < ay + 8 || ry > ay + 10 + sysVis)
            continue                             ; wholly outside - the clip handles the rest
        hv := Max(HL.h.Get(1060 + i, 0.0), HL.h.Get(980 + i, 0.0))
        sld := (1 - cg)*10
        axs  := ax + sld                     ; row CONTENT rides the entrance slide; panel chrome does not
        live := ons[i] > 0.5
        fl := (SPF.flashAt.Has(i) && now - SPF.flashAt[i] < 420)
            ? 1 - Clamp((now - SPF.flashAt[i])/420.0, 0.0, 1.0) : 0.0

        if (hv > 0.01 || fl > 0.01) {
            b := HBrush(ax + 6, ry, HL.abw - 12, HL.spfrh, FA(Alpha(0xFFFFFF, 15*hv + 20*fl), fb), FA(Alpha(0xFFFFFF, 3*hv), fb))
            FillRR(ax + 6, ry, HL.abw - 12, HL.spfrh, 8, b), DelB(b)
        }
        b := VBrush(axs + 14, ry + 8, 3, 16, FA(Alpha(live ? AccHi(acc, 0.35) : 0xFFC7CBE0, live ? 235 : 60), fb)
                  , FA(Alpha(live ? acc : 0xFFC7CBE0, live ? 150 : 40), fb))
        FillRR(axs + 14, ry + 8, 3, 16, 1.5, b), DelB(b)

        SPFIcon(i, axs + 36, ry + 16, FA(Alpha(live ? acc : 0xFF9AA8C0, live ? 220 : 110), fb), live, now)

        ; No ON/OFF caption here: it would sit exactly where the description
        ; needs to run, and the switch already states it unambiguously. That
        ; buys the description the full width up to the switch.
        tw := HL.abw - 126
        Txt(names[i], axs + 54, ry + 2, tw, 16, fBadge
            , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.18), 235), fb), fmtL)
        ; row 1 has no id configured -> say so here rather than failing silently
        ht := hints[i]
        ; ---- discord sub-options ----
        ; They occupy the hint line of their own row rather than a strip of
        ; their own: the panel already runs to the bottom of the card, and the
        ; hint is the one thing on the row that stops being worth reading once
        ; the switch is on. Cross-faded, so neither is ever half-legible.
        subE := (i = 1) ? Ease3(Clamp(SPF.t1*1.6 - 0.15, 0.0, 1.0)) : 0.0
        ; ---- row 6 keeps BOTH ----
        ; Row 1's chips replace its hint, because once DISCORD ACTIVITY is on
        ; the hint has nothing left to say. Row 6 is the opposite case: the
        ; client count, the lever tally and the bottleneck reading are the only
        ; proof this switch does anything at all, so the chips take the left of
        ; the line and the hint is PUSHED right into what is left rather than
        ; faded out under them. The push is eased off the same value the chips
        ; arrive on, so the two move as one thing.
        sub6 := (i = 6) ? Ease3(Clamp(SPF.t6*1.6 - 0.15, 0.0, 1.0)) : 0.0
        hOff := Round(SPFSub6Off()*sub6)
        ; row 4 keeps a permanent EXPERIMENTAL mark, so the hint gives way to it
        ; rows 4 and 5 both carry a standing caution: one is unproven, the
        ; other is something Roblox actively works against.
        bLbl := (i = 4 || i = 5) ? SPFBadgeLabel(i) : ""
        expW := (bLbl != "") ? SPFBadgeW(bLbl) + 4 : 0
        if (subE < 0.999)
            Txt(FFMElide(ht, fHint, tw - expW - hOff), axs + 54 + hOff, ry + 17
                , tw - expW - hOff, 13, fHint
                , FA(0x7EC7CBE0, fb*(1 - subE)), fmtL)
        if (subE > 0.001)
            SPFSubRow(1, axs, ry, acc, fb*subE, now, subE)
        if (sub6 > 0.001)
            SPFSubRow(6, axs, ry, acc, fb*sub6, now, sub6)
        if (bLbl != "")
            SPFExpBadge(axs + 54 + tw - expW + 2, ry + 16, fb, now, bLbl)

        FFMTogDraw(axs + HL.abw - 62, ry + 5, 44, 22, ons[i], acc, hv, fb)
    }
    Pop(svRows)
    DllCall("gdiplus\GdipDeletePath", "ptr", pRows)

    ; ---- systems scrollbar ----
    ; Same build as the other three panels, so a scrolling list looks the same
    ; wherever it appears.
    sysTot := SPFSysTotal()
    if (sysTot > sysVis) {
        sbS := Max(HL.h.Get(971, 0.0), (HL.drag = 16) ? 1.0 : 0.0)
        sw2 := 3 + 3*sbS
        sxs := ax + HL.abw - 6 - 3*sbS
        b := SBrush(FA(Alpha(0xFFFFFF, 18 + 26*sbS), ff*mt))
        FillRR(sxs, ay + 10, sw2, sysVis, sw2/2, b), DelB(b)
        th2 := Max(22, sysVis*(sysVis/sysTot))
        ty2 := ay + 10 + (sysVis - th2)*(scr/Max(1, sysTot - sysVis))
        b := VBrush(sxs, ty2, sw2, th2, FA(Alpha(AccHi(acc, 0.35), 190 + 65*sbS), ff*mt)
                  , FA(Alpha(acc, 170 + 60*sbS), ff*mt))
        FillRR(sxs, ty2, sw2, th2, sw2/2, b), DelB(b)
    }


    ; ---- rejoin targets ----
    ; Paste a game link and it rerolls that place; paste a private server link
    ; and it rerolls that instead. A private server is reallocated on join, so
    ; rejoining an empty one is a real way to land in a different region.
    if (mt > 0.55) {
        fg := ff*Clamp((mt - 0.55)/0.35, 0.0, 1.0)
        GroupLine(ax + 14, ax + HL.abw - 14, ay + 134, acc, fg, now)
        ; Its own control, above both boxes and belonging to neither - it opens
        ; the library, and saving happens in there.
        ; The two libraries share this row as equal halves: ACCOUNTS on the
        ; left, directly under the systems list and under MULTI-ROBLOX
        ; INSTANCES in particular, SAVED PLACES on the right. The panel has no
        ; spare vertical band for a third full row - the link fields below run
        ; to the bottom of the card - so a split row is what fits without
        ; crowding the LIVE panel underneath.
        lbTot := HL.abw - 70
        lbW   := (lbTot - 8)/2
        SPFAcctButton(ax + 54, ay + 140, lbW, fg, acc, now)
        SPFSavedButton(ax + 54 + lbW + 8, ay + 140, lbW, fg, acc, now)
        SPFField(ax, ay + 188, HL.abw, 6, 966, "GAME LINK"
               , "paste a roblox game link or place id", SPF.mmLink, acc, fg)
        SPFField(ax, ay + 236, HL.abw, 7, 967, "PRIVATE SERVER LINK"
               , "paste a private server link", SPF.mmPriv, acc, fg)
        ; one button each, so there is no guessing which link it will use
        hg := (SPF.hunting && SPF.huntWhich = 1)
        hp := (SPF.hunting && SPF.huntWhich = 2)
        ; The label states which of the two behaviours the switch above has
        ; selected, so the difference is readable before the click rather than
        ; only afterwards from whether roblox keeps restarting.
        jl := spfMatch ? "HUNT" : "JOIN"
        FFMBtn(968, ax + HL.abw - 88, ay + 188, 72, 26, hg ? "STOP" : jl, acc, fg
             , hg ? 3 : (SPF.mmLink != "" ? 1 : 0))
        FFMBtn(969, ax + HL.abw - 88, ay + 236, 72, 26, hp ? "STOP" : jl, acc, fg
             , hp ? 3 : (SPF.mmPriv != "" ? 1 : 0))
    }

    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", pClip)

    SPFLive(ax, ay + HL.spfh + 12, HL.abw, ff, now, acc, mt)
}



; ---- EXPERIMENTAL badge ----
; A standing mark, not a warning that fires once and is missed. It breathes
; slowly rather than blinking: this is a caveat the user should keep in view
; while the switch is on, not an alarm demanding a response. Amber, which is
; what every other "armed but unproven" state in the suite uses.
; ---- which caution this row is carrying ----
; Row 4 is unproven and always says so. Row 5 is something Roblox actively
; works against, which is a standing caution too - but when the switch is on
; and a client predates it there is something ACTIONABLE to say instead, and
; that outranks a general warning the user has already read.
SPFBadgeLabel(i) {
    if (i = 5 && spfMulti && SPFMultiStale())
        return "RESTART ROBLOX"
    return "EXPERIMENTAL"
}
; Derived from the label rather than a literal, because the row's text width is
; derived from the SAME call - two hand-kept copies of a badge width is how the
; hint ends up running underneath it.
SPFBadgeW(lbl) => Max(88, MeasureW(lbl, HL.fXs) + 30)
SPFExpBadge(bx, by, f, now, lbl := "EXPERIMENTAL") {
    bw := SPFBadgeW(lbl), bh := 14
    pu := (Sin(DecT(now)*0.0024) + 1)/2
    b := SBrush(FA(Alpha(AMBER, Round(20 + 14*pu)), f))
    FillRR(bx, by, bw, bh, 7, b), DelB(b)
    pn := Pen(FA(Alpha(AMBER, Round(80 + 40*pu)), f), 1)
    StrokeRR(bx, by, bw, bh, 7, pn), DelP(pn)
    ; a small caution triangle, drawn rather than fonted so it takes the fade
    tx := bx + 11, ty := by + bh/2
    pn := Pen(FA(Alpha(AccHi(AMBER, 0.35), Round(180 + 60*pu)), f), 1.2)
    Line(tx, ty - 4.2, tx + 4.2, ty + 3.4, pn)
    Line(tx + 4.2, ty + 3.4, tx - 4.2, ty + 3.4, pn)
    Line(tx - 4.2, ty + 3.4, tx, ty - 4.2, pn), DelP(pn)
    b := SBrush(FA(Alpha(AccHi(AMBER, 0.5), Round(200 + 55*pu)), f))
    FillRR(tx - 0.5, ty - 2.2, 1.2, 3.4, 0.6, b)
    FillRR(tx - 0.5, ty + 2.0, 1.2, 1.2, 0.6, b), DelB(b)
    Txt(lbl, bx + 20, by - 1, bw - 24, bh, HL.fXs
        , FA(Alpha(AccHi(AMBER, 0.45), Round(210 + 45*pu)), f), fmtL)
}

; ---- discord sub-option chips ----
; A chip, not a switch: at 16px there is no room for a track and a knob, and
; three switches on one line would read as a second system list rather than as
; options belonging to the row above them. State is carried by fill, border and
; the leading dot together, so it survives the accent being any colour.
; `row` is which system the chips belong to - 1 DISCORD ACTIVITY, 6 FPS BOOST.
; One implementation for both: they are the same control saying different
; things, and a second copy at a different width is how the two would drift
; apart on the next change to either.
SPFSubRow(row, ax, ry, acc, f, now, e) {
    ; The ACCOUNT chip names the account once it is known. Turning an option on
    ; and having nothing anywhere confirm what it will publish is the failure
    ; this avoids - the panel has no room for a readout row, and the chip is
    ; already the thing the user is looking at.
    a1 := (spfDcAcct && SPF.userNm != "") ? ("@" SPF.userNm) : "ACCOUNT"
    if (row = 6) {
        ; Both chips carry their own count rather than a bare label, for the
        ; same reason the ACCOUNT chip carries the account: these two do
        ; something invisible, and the chip is the only place to prove it.
        q2l := SPF.fpsQuiet.Count ? ("QUIET " SPF.fpsQuiet.Count) : "QUIET"
        q3l := SPF.fpsSysN ? ("SYS " SPF.fpsSysN "/" SPFFpsSysMax()) : "SYSTEM"
        labs := [SPF.fpsGpuOn ? "GPU ON" : "GPU", q2l, q3l]
        ons  := [SPF.q1, SPF.q2, SPF.q3]
        nSub := SPF_SUB6N, wSub := SPF_SUB6W, zBase := SPF_SUB6Z, flBase := 20
    } else {
        labs := [a1, "JOINABLE", "FOCUS"]
        ons  := [SPF.u1, SPF.u2, SPF.u3]
        nSub := SPF_SUBN, wSub := SPF_SUBW, zBase := 974, flBase := 10
    }
    sy := SPFSubY(ry) - (1 - e)*4
    loop nSub {
        k := A_Index
        on := ons[k]
        sx := (row = 6) ? SPFSub6X(ax, k) : SPFSubX(ax, k)
        z  := zBase + k
        hv := Ease3(HL.h.Get(z, 0.0))
        fl := (SPF.flashAt.Has(flBase + k) && now - SPF.flashAt[flBase + k] < 420)
            ? 1 - Clamp((now - SPF.flashAt[flBase + k])/420.0, 0.0, 1.0) : 0.0
        st := PushXform(sx + wSub/2, sy + SPF_SUBH/2, 1 + 0.05*hv + 0.06*fl, 0)

        b := SBrush(FA(Alpha(on > 0.02 ? acc : 0xFFFFFF
                           , Round(on > 0.02 ? (30 + 26*on + 26*hv + 40*fl) : (8 + 14*hv))), f))
        FillRR(sx, sy, wSub, SPF_SUBH, 8, b), DelB(b)
        MicroBackdrop(sx, sy, wSub, SPF_SUBH, 8, acc, f, now, 0.8)
        pn := Pen(FA(Alpha(on > 0.02 ? acc : 0xFF9AA8C0
                         , Round(on > 0.02 ? (120 + 80*on + 50*hv) : (34 + 46*hv))), f), 1)
        StrokeRR(sx, sy, wSub, SPF_SUBH, 8, pn), DelP(pn)

        ; leading dot: the state read at a glance, before any label is.
        ; FOCUS carries a third state - on, but currently reporting tabbed out -
        ; and amber is what says that everywhere else in the suite.
        ; Amber is "on, but it has nothing to publish yet". FOCUS uses it while
        ; roblox is not the focused window; JOINABLE uses it when no server
        ; instance is known, which is the one case where the option is enabled
        ; and the join button still cannot appear on the card.
        ;
        ; Row 6 uses the same three-state language for the same reason. GPU
        ; PREF goes amber while it is on but not yet in force - the preference
        ; is read when the client STARTS, so between setting it and restarting
        ; Roblox it is a promise rather than a fact, and green there would be a
        ; lie the user cannot see through. QUIET goes amber when it is on and
        ; has found nothing to demote.
        dc := (on <= 0.02) ? 0xFF6E7590
            : (row = 6)
                ? ((k = 1 && !SPF.fpsGpuOn) ? AMBER
                 : (k = 2 && !SPF.fpsQuiet.Count) ? AMBER
                 ; on, but only part of the set could be taken - which on an
                 ; unelevated run is every value under HKLM
                 : (k = 3 && SPF.fpsSysN < SPFFpsSysMax()) ? AMBER
                 : AccHi(acc, 0.35))
            : (k = 3 && !SPF.focOn) ? AMBER
            : (k = 2 && SPFJoinUrl() = "") ? AMBER
            : AccHi(acc, 0.35)
        dr := 2.4 + 0.6*on
        b := SBrush(FA(Alpha(dc, Round(on > 0.02 ? (200 + 55*Abs(Sin(DecT(now)*0.0035))) : 90)), f))
        FillEll(sx + 9 - dr, sy + SPF_SUBH/2 - dr, dr*2, dr*2, b), DelB(b)

        Txt(FFMElide(labs[k], HL.fXs, wSub - 22), sx + 17, sy + 1, wSub - 22, 14, HL.fXs
            , FA(Alpha(on > 0.02 ? AccHi(acc, 0.45) : 0xFFC7CBE0
                     , Round(on > 0.02 ? 235 : 140 + 60*hv)), f), fmtL)
        if (fl > 0.01) {
            ex := (1 - fl)*10
            pn := Pen(FA(Alpha(acc, Round(190*fl)), f), 1.6*fl + 0.3)
            StrokeRR(sx - ex, sy - ex*0.6, wSub + ex*2, SPF_SUBH + ex*1.2, 8 + ex*0.3, pn), DelP(pn)
        }
        Pop(st)
    }
}

; ---- one link box ----
SPFField(ax, fy, aw, foc, zid, label, ph, val, acc, fg, resv := 80) {
    fdx := ax + 54, fdw := aw - 70 - resv      ; resv = width kept for buttons
    on  := (SH.focus = foc)
    hv  := HL.h.Get(zid, 0.0)
    ok  := (val != "")
    Txt(label, fdx, fy - 16, 220, 13, HL.fXs
        , FA(Alpha(on ? acc : 0xC7CBE0, on ? 200 : 120), fg), fmtL)
    if ok
        Txt("set", fdx + fdw - 60, fy - 16, 60, 13, HL.fXs, FA(Alpha(C_ON, 175), fg), fmtR)

    b := SBrush(FA(Mix(0xFF141728, 0xFF1B2038, Max(hv, on*1.0)), fg))
    FillRR(fdx, fy, fdw, 26, 7, b), DelB(b)
    MicroBackdrop(fdx, fy, fdw, 26, 7, acc, fg, A_TickCount, 0.75)
    pn := Pen(FA(Alpha(on ? acc : (ok ? C_ON : 0xFFFFFF), on ? 190 : (ok ? 80 : 28 + 50*hv)), fg), 1)
    StrokeRR(fdx, fy, fdw, 26, 7, pn), DelP(pn)
    if on {
        b := SBrush(FA(Alpha(acc, 210), fg))
        FillRR(fdx, fy + 6, 2.6, 14, 1.3, b), DelB(b)
    }
    vv := FldWindow(val, on ? SH.fCar : StrLen(val), fHint, fdw - 20, &vo)
    if (on && SH.fSel >= 0 && SH.fSel != SH.fCar) {
        sa := Max(Min(SH.fSel, SH.fCar) - vo, 0), sb := Min(Max(SH.fSel, SH.fCar) - vo, StrLen(vv))
        if (sb > sa) {
            xa := MeasureW(SubStr(vv, 1, sa), fHint), xb := MeasureW(SubStr(vv, 1, sb), fHint)
            b := SBrush(FA(Alpha(acc, 64), fg))
            FillRR(fdx + 10 + xa, fy + 5, xb - xa, 16, 3, b), DelB(b)
        }
    }
    if (vv = "")
        Txt(ph, fdx + 10, fy + 5, fdw - 20, 16, fHint, FA(0x58C7CBE0, fg), fmtL)
    else
        Txt(vv, fdx + 10, fy + 5, fdw - 20, 16, fHint, FA(Alpha(0xFFE8EAF6, 235), fg), fmtL)
    if (on && Mod(A_TickCount - SH.caretAt, 1060) < 530) {
        cx2 := fdx + 10 + MeasureW(SubStr(vv, 1, SH.fCar - vo), fHint)
        b := SBrush(FA(Alpha(0xFFFFFF, 225), fg))
        FillRR(cx2, fy + 5, 1.6, 16, 0.8, b), DelB(b)
    }
}


; ---- saved library button ----
; Wider and taller than a row control because it opens a whole view, and it
; belongs to neither link box - it sits above both.
SPFSavedButton(bx, by, bw, fg, acc, now) {
    bh := 26
    hv := HL.h.Get(970, 0.0)
    op := (SPF.view = "sav")
    hvE := Ease3(hv)
    fl := (SPF.savAt && now - SPF.savAt < 900) ? 1 - (now - SPF.savAt)/900.0 : 0.0

    if (hvE > 0.01 || op) {
        b := SBrush(FA(Alpha(acc, Round(20*hvE + 22*op)), fg))
        FillRR(bx - 3, by - 3, bw + 6, bh + 6, 11, b), DelB(b)
    }
    b := VBrush(bx, by, bw, bh, FA(Mix(0xFF1B2038, 0xFF26305A, Max(hvE, op*1.0)), fg)
              , FA(0xFF12141F, fg))
    FillRR(bx, by, bw, bh, 8, b), DelB(b)
    MicroBackdrop(bx, by, bw, bh, 8, acc, fg, now, 0.9)
    pn := Pen(FA(Alpha(acc, Round(70 + 90*hvE + 80*op + 90*fl)), fg), 1.2)
    StrokeRR(bx, by, bw, bh, 8, pn), DelP(pn)

    ; bookmark glyph, its ribbon lifting on hover
    gx := bx + 16, gy := by + bh/2
    lift := 2*hvE
    pn := Pen(FA(Alpha(AccHi(acc, 0.35), 210 + 45*hvE), fg), 1.5)
    Line(gx - 5, gy - 7 - lift, gx + 5, gy - 7 - lift, pn)
    Line(gx - 5, gy - 7 - lift, gx - 5, gy + 7 - lift, pn)
    Line(gx + 5, gy - 7 - lift, gx + 5, gy + 7 - lift, pn)
    Line(gx - 5, gy + 7 - lift, gx, gy + 2 - lift, pn)
    Line(gx + 5, gy + 7 - lift, gx, gy + 2 - lift, pn), DelP(pn)

    Txt("SAVED PLACES", bx + 32, by + 7, bw - 96, 16, fBadge
        , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.2*hvE), 215 + 40*hvE), fg), fmtL)

    ; count chip on the right
    cw2 := 30
    b := SBrush(FA(Alpha(SPF.saved.Length ? acc : 0xFFFFFF, SPF.saved.Length ? 46 : 14), fg))
    FillRR(bx + bw - cw2 - 24, by + 6, cw2, 16, 8, b), DelB(b)
    Txt(SPF.saved.Length "/" SPF_SAV_MAX, bx + bw - cw2 - 24, by + 7, cw2, 14, HL.fXs
        , FA(Alpha(SPF.saved.Length ? AccHi(acc, 0.5) : 0xFFC7CBE0, 225), fg), fmtC)

    ; chevron, nudging right on hover
    pn := Pen(FA(Alpha(0xFFC7CBE0, 120 + 110*hvE), fg), 1.5)
    cvx := bx + bw - 18 + 2*hvE
    Line(cvx - 3, by + bh/2 - 4, cvx + 2, by + bh/2, pn)
    Line(cvx + 2, by + bh/2, cvx - 3, by + bh/2 + 4, pn), DelP(pn)

    ; ring pulse when an entry was just added
    if (fl > 0.01) {
        pn := Pen(FA(Alpha(acc, Round(170*fl)), fg), 2.0*fl + 0.3)
        ex := (1 - fl)*10
        StrokeRR(bx - ex, by - ex*0.6, bw + ex*2, bh + ex*1.2, 8 + ex*0.3, pn), DelP(pn)
    }
}

; ---- accounts library button ----
; Twin of SPFSavedButton and deliberately built the same way: same plate, same
; hover lift, same count chip, same chevron nudge, same ring pulse when the list
; changes. It sits directly under MULTI-ROBLOX INSTANCES because it is the thing
; that makes that switch useful - a second client is only worth having if it can
; be a different account.
SPFAcctButton(bx, by, bw, fg, acc, now) {
    bh := 26
    hv := HL.h.Get(1029, 0.0)
    op := (SPF.view = "acct")
    hvE := Ease3(hv)
    ; armed only once the singleton is held; before that a launch would just
    ; wake the client already running, so the button says so rather than lying
    arm := spfMulti
    fl := (SPF.savAt && now - SPF.savAt < 900) ? 1 - (now - SPF.savAt)/900.0 : 0.0

    if (hvE > 0.01 || op) {
        b := SBrush(FA(Alpha(acc, Round(20*hvE + 22*op)), fg))
        FillRR(bx - 3, by - 3, bw + 6, bh + 6, 11, b), DelB(b)
    }
    b := VBrush(bx, by, bw, bh, FA(Mix(0xFF1B2038, 0xFF26305A, Max(hvE, op*1.0)), fg)
              , FA(0xFF12141F, fg))
    FillRR(bx, by, bw, bh, 8, b), DelB(b)
    MicroBackdrop(bx, by, bw, bh, 8, acc, fg, now, 0.9)
    ; a soft accent wash while armed, so the pair is not two identical plates
    if arm {
        b := SBrush(FA(Alpha(acc, Round(26 + 16*hvE)), fg))
        FillRR(bx, by, bw, bh, 8, b), DelB(b)
    }
    pn := Pen(FA(Alpha(arm ? acc : 0xFF6E7590, Round(70 + 90*hvE + 80*op + 90*fl)), fg), 1.2)
    StrokeRR(bx, by, bw, bh, 8, pn), DelP(pn)

    ; glyph: a head-and-shoulders with a second one behind it, because the row
    ; is about having MORE THAN ONE identity available
    gx := bx + 16, gy := by + bh/2
    pn := Pen(FA(Alpha(AccHi(acc, 0.35), arm ? 150 : 90), fg), 1.2)
    Ell(gx - 6.5, gy - 6.5, 7, 7, pn)
    Arc(gx - 9, gy - 0.5, 13, 12, 200, 140, pn), DelP(pn)
    pn := Pen(FA(Alpha(AccHi(acc, 0.35), 210 + 45*hvE), fg), 1.5)
    dx2 := 3 + 0.8*hvE
    Ell(gx - 2.6 + dx2, gy - 7, 7.4, 7.4, pn)
    Arc(gx - 5.4 + dx2, gy - 1, 13.6, 12.6, 200, 140, pn), DelP(pn)

    Txt("ACCOUNTS", bx + 32, by + 7, bw - 96, 16, fBadge
        , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.2*hvE), 215 + 40*hvE), fg), fmtL)

    cw2 := 30
    b := SBrush(FA(Alpha(SPF.acct.Length ? acc : 0xFFFFFF, SPF.acct.Length ? 46 : 14), fg))
    FillRR(bx + bw - cw2 - 24, by + 6, cw2, 16, 8, b), DelB(b)
    Txt(SPF.acct.Length "/" ACCT_MAX, bx + bw - cw2 - 24, by + 7, cw2, 14, HL.fXs
        , FA(Alpha(SPF.acct.Length ? AccHi(acc, 0.5) : 0xFFC7CBE0, 225), fg), fmtC)

    pn := Pen(FA(Alpha(0xFFC7CBE0, 120 + 110*hvE), fg), 1.5)
    cvx := bx + bw - 16 + 2*hvE
    Line(cvx - 3, by + bh/2 - 4, cvx + 2, by + bh/2, pn)
    Line(cvx + 2, by + bh/2, cvx - 3, by + bh/2 + 4, pn), DelP(pn)

    if (fl > 0.01) {
        pn := Pen(FA(Alpha(acc, Round(170*fl)), fg), 2.0*fl + 0.3)
        ex := (1 - fl)*10
        StrokeRR(bx - ex, by - ex*0.6, bw + ex*2, bh + ex*1.2, 8 + ex*0.3, pn), DelP(pn)
    }
}

; ---- presence ----
AcctPresName(t) => t = 2 ? "in game" : t = 3 ? "in studio" : t = 1 ? "online" : "offline"
AcctPresCol(t, acc) => t = 2 ? C_ON : t = 3 ? 0xFFA78BFA : t = 1 ? 0xFF38BDF8 : 0xFF6E7590

; ---- avatar viewport ----
; The real avatar mesh, spun live. Roblox publishes the geometry as an OBJ and
; the child keeps a subsample of its vertices, so what turns here is the user's
; actual body, not a canned image.
;
; It is a POINT CLOUD, not a textured model, and that is a deliberate limit
; rather than an unfinished one: this renderer is GDI+ driven from AHK, and a
; few thousand textured triangles per frame is far outside what it can do. A
; few hundred depth-shaded points it can do at full rate, and they read as a
; recognisable figure that responds to the drag immediately. The flat render
; from Roblox is shown instead whenever the mesh has not arrived, or in low
; performance mode.
AcctAvatar(id, x, y, w, h, fo, now, acc) {
    ; The INSIDE of this box is a render surface, not chrome, so it does NOT go
    ; through TH - but it is not theme-blind either. It used to be pinned to the
    ; dark plate in both themes, which left a black box sitting in a white card.
    ;
    ; The reason it was pinned is real: the point cloud is Mix(acc, WHITE, d),
    ; so lighting the plate without touching what stands on it gives a white
    ; figure on white paper. So the surface and everything drawn on it are
    ; flipped TOGETHER here, off thT directly. thT is the eased theme value
    ; rather than the hubTheme boolean, so this crosses over with the rest of
    ; the interface instead of snapping at one end of the transition.
    ;
    ; The light plate is deliberately not pure white - the card behind it
    ; already is, and a viewport needs to read as its own surface.
    avSurf := Mix(0xFF0B0D16, 0xFFEEF2F8, thT)
    ; What the near side of the figure tends toward: highlight on dark, ink on
    ; light. This is the value that made the naive fix fail.
    avInk  := Mix(0xFFFFFFFF, 0xFF0A0C14, thT)
    b := SBrushP(FA(avSurf, fo))
    FillRR(x, y, w, h, 10, b), DelB(b)
    pC := RRPath(x, y, w, h, 10)
    sv := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC, "int", 1)
    ; floor glow, so the figure is standing on something
    b := VBrushP(x, y + h*0.55, w, h*0.45, FA(Alpha(acc, 0), fo)
               , FA(Alpha(acc, Round(40 + 30*thT)), fo))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h*0.55, "float", w, "float", h*0.45), DelB(b)

    pts := (id != "" && SPF.acctPts.Has(id)) ? SPF.acctPts[id] : 0
    if (pts && !hubLowPerf) {
        ; idle spin until the user takes hold of it
        if (SPF.avAuto && !SPF.avDrag)
            SPF.avYaw += 0.011
        cy2 := Cos(SPF.avYaw), sy2 := Sin(SPF.avYaw)
        cp := Cos(SPF.avPitch), sp := Sin(SPF.avPitch)
        sc := h*0.92
        ox := x + w/2, oy := y + h/2
        for v in pts {
            ; yaw about Y, then pitch about X - enough for a turntable, and
            ; two rotations is half the per-point cost of a full matrix
            xr := v[1]*cy2 + v[3]*sy2
            zr := v[3]*cy2 - v[1]*sy2
            yr := v[2]*cp - zr*sp
            zz := zr*cp + v[2]*sp
            ; weak perspective: nearer points sit larger and brighter
            k := 1/(1.9 - zz*0.55)
            px := ox + xr*sc*k
            py := oy - yr*sc*k
            d  := Clamp((zz + 0.5), 0.0, 1.0)
            rr := 0.9 + 1.5*k*d
            ; far points are the faint ones, and faint ink on paper disappears
            ; faster than faint light on black - so the floor lifts with thT
            al := Round(Min(255, (60 + 165*d) + (55 - 40*d)*thT))
            b := SBrushP(FA(Alpha(Mix(acc, avInk, 0.25 + 0.45*d), al), fo))
            FillEll(px - rr, py - rr, rr*2, rr*2, b), DelB(b)
        }
    } else if (bm := AcctBody(id)) {
        BlitFitRR(bm, x, y, w, h, 10, fo, 1.0, 0.5, 0.42)
    } else {
        ph := (Sin(DecT(now)*0.005) + 1)/2
        ; Themed, not preserved: the plate underneath is light now, and
        ; 0xC7CBE0 is a neutral near-white, so TH turns it into ink exactly
        ; where it needs to be ink.
        pn := Pen(FA(Alpha(acc, Round(40 + 60*ph)), fo), 1.4)
        Arc(x + w/2 - 13, y + h/2 - 13, 26, 26, Mod(DecT(now)*0.14, 360), 80, pn), DelP(pn)
        Txt("loading avatar", x, y + h/2 + 16, w, 16, HL.fXs
            , FA(Alpha(0xFFC7CBE0, Round(70 + 60*ph)), fo), fmtC)
    }
    Pop(sv)
    DllCall("gdiplus\GdipDeletePath", "ptr", pC)

    hv := HL.h.Get(1036, 0.0)
    pn := Pen(FA(Alpha(acc, Round(70 + 110*hv + (SPF.avDrag ? 60 : 0))), fo), 1.2)
    StrokeRR(x, y, w, h, 10, pn), DelP(pn)
    ; the affordance appears on hover - a static badge would be clutter
    if (pts && (hv > 0.02 || SPF.avDrag)) {
        e2 := Max(hv, SPF.avDrag ? 1.0 : 0)
        ; Now that the surface follows the theme, so does the chip on it. TH
        ; maps 0x10131F to white, and the accent label darkens on paper, so the
        ; badge stays legible at both ends instead of being dark-on-dark at one.
        b := SBrush(FA(Alpha(0x10131F, Round((150 + 60*thT)*e2)), fo))
        FillRR(x + w/2 - 34, y + h - 22, 68, 15, 7, b), DelB(b)
        Txt("drag to turn", x + w/2 - 34, y + h - 22, 68, 15, HL.fXs
            , FA(Alpha(AccHi(acc, 0.4), Round(225*e2)), fo), fmtC)
    }
}

; ---- accounts overlay ----
; Deliberately spare next to the saved-places library: an account has no banner,
; no stats and nothing to browse - it is a name, a launch and a delete. Adding
; is a clipboard paste rather than a text field, because a .ROBLOSECURITY cookie
; is several hundred characters and nobody types one.
SPFAcctFldX() => HL.ctx + 240
SPFAcctFldW() => (HL.ctw - 242) - 24

SPFAcctView(ff, now, acc, dx := 0, dy2 := 0) {
    e := Ease3(Clamp((now - SPF.viewAt)/300.0, 0.0, 1.0))
    if (SPF.view = "acct")
        t := e
    else if (SPF.viewPrev = "acct")
        t := 1 - e
    else
        return
    if (t <= 0.01)
        return
    fo := ff*t
    x := HL.ctx + dx, y := HL.cty + dy2 + 30, w := HL.ctw, h := 414

    b := SBrush(FA(Alpha(0x06070E, Round(220*t)), ff))
    FillRR(x - 10, HL.cty + dy2 - 6, w + 20, h + 54, 14, b), DelB(b)

    st := PushXform(x + w/2, y + h/2, 0.96 + 0.04*t, 0)
    HubViewChrome(x, y, w, h, fo, now, acc)
    b := SBrush(FA(Alpha(acc, 200), fo))
    FillRR(x, y + 10, 3, 22, 1.5, b), DelB(b)
    Txt("ACCOUNTS", x + 16, y + 11, 200, 20, fBadge, FA(Alpha(0xFFE8EAF6, 240), fo), fmtL)
    cw3 := 42
    b := SBrush(FA(Alpha(SPF.acct.Length ? acc : 0xFFFFFF, SPF.acct.Length ? 56 : 14), fo))
    FillRR(x + 108, y + 13, cw3, 16, 8, b), DelB(b)
    Txt(SPF.acct.Length "/" ACCT_MAX, x + 108, y + 14, cw3, 14, HL.fXs
        , FA(Alpha(SPF.acct.Length ? AccHi(acc, 0.5) : 0xFFC7CBE0, 225), fo), fmtC)
    Txt("launch a client already signed into any saved account"
        , x + 164, y + 14, w - 300, 16, HL.fS, FA(0x66C7CBE0, fo), fmtL)

    ; ---- add from clipboard, header right (mirrors ADD CURRENT) ----
    hvA := HL.h.Get(1030, 0.0)
    abx2 := x + w - 150, aby2 := y + 8
    b := SBrush(FA(Alpha(acc, Round(22 + 34*hvA)), fo))
    FillRR(abx2, aby2, 116, 22, 7, b), DelB(b)
    MicroBackdrop(abx2, aby2, 116, 22, 7, acc, fo, now, 0.9)
    pn := Pen(FA(Alpha(acc, Round(90 + 90*hvA)), fo), 1)
    StrokeRR(abx2, aby2, 116, 22, 7, pn), DelP(pn)
    b := SBrush(FA(Alpha(AccHi(acc, 0.4), 210 + 45*hvA), fo))
    FillRR(abx2 + 11, aby2 + 10, 10, 2, 1, b)
    FillRR(abx2 + 15, aby2 + 6, 2, 10, 1, b), DelB(b)
    Txt("ADD FROM CLIPBOARD", abx2 + 26, aby2 + 4, 86, 14, HL.fXs
        , FA(Alpha(0xFFE8EAF6, 190 + 60*hvA), fo), fmtL)

    hvX := HL.h.Get(1020, 0.0)
    if (hvX > 0.01) {
        b := SBrush(FA(Alpha(acc, Round(40*hvX)), fo))
        FillEll(x + w - 29, y + 3, 22, 22, b), DelB(b)
    }
    pn := Pen(FA(Alpha(hvX > 0.2 ? acc : 0xFFC7CBE0, 130 + 120*hvX), fo), 1.6)
    cxx := x + w - 18, cyy := y + 14
    Line(cxx - 5, cyy - 5, cxx + 5, cyy + 5, pn)
    Line(cxx + 5, cyy - 5, cxx - 5, cyy + 5, pn), DelP(pn)

    pn := Pen(FA(Alpha(0xFFFFFF, 20), fo), 1)
    Line(x + 14, y + 38, x + w - 14, y + 38, pn), DelP(pn)

    if (t < 0.85) {
        Pop(st)
        return
    }

    lx := x + 14, ly := y + 48, lw := 192, rowH := 38
    if !SPF.acct.Length {
        by     := ly + ACCT_MAX*rowH + 6
        brwPnd := brwLoginAt && A_TickCount - brwLoginAt < 300000
        brwCol := brwPnd ? 0xFF38BDF8 : acc
        Txt("no accounts saved", x + 16, y + h/2 - 30, w - 32, 20, fBadge
            , FA(Alpha(0xFFE8EAF6, 200), fo), fmtC)
        Txt("click BROWSER LOGIN to sign in on a clean, signed-out window"
            , x + 16, y + h/2 - 8, w - 32, 18, fHint, FA(0x72C7CBE0, fo), fmtC)
        Txt("or paste a .ROBLOSECURITY cookie manually using ADD FROM CLIPBOARD"
            , x + 16, y + h/2 + 14, w - 32, 16, HL.fXs, FA(Alpha(AMBER, 140), fo), fmtC)
        FFMBtn(1038, lx, by, 96, 26, brwPnd ? "SCANNING..." : "BROWSER LOGIN", brwCol, fo, 0)
        Pop(st)
        return
    }
    SPF.acctSel := Clamp(SPF.acctSel, 1, SPF.acct.Length)
    sel := SPF.acct[SPF.acctSel]

    ; ---- master list ----
    slideUp := 0.0
    loop SPF.acct.Length {
        i  := A_Index
        en := SPF.acct[i]
        kt := AcctKillT(i, now)
        ke := Ease3(kt)
        ; rows below the doomed one ride up into the gap as it closes
        ry := ly + (i - 1)*rowH - slideUp*rowH
        if (kt > 0)
            slideUp := ke
        if (ke >= 0.999)
            continue
        on := (i = SPF.acctSel)
        hv := HL.h.Get(1020 + i, 0.0)
        ; the row collapses toward its own centre and fades as it goes
        stR := PushXform(lx + lw/2, ry + (rowH - 4)/2, 1 - 0.12*ke, 0)
        fRow := fo*(1 - ke)
        if (on || hv > 0.01) {
            b := HBrush(lx, ry, lw, rowH - 4
                      , FA(Alpha(on ? acc : 0xFFFFFF, on ? 38 : 14*hv), fo)
                      , FA(Alpha(on ? acc : 0xFFFFFF, on ? 8 : 3*hv), fo))
            FillRR(lx, ry, lw, rowH - 4, 8, b), DelB(b)
        }
        if on {
            b := VBrush(lx, ry + 6, 3, rowH - 16, FA(Alpha(AccHi(acc, 0.4), 240), fo)
                      , FA(Alpha(acc, 160), fo))
            FillRR(lx, ry + 6, 3, rowH - 16, 1.5, b), DelB(b)
            pn := Pen(FA(Alpha(acc, 70), fo), 1)
            StrokeRR(lx, ry, lw, rowH - 4, 8, pn), DelP(pn)
        }
        bxp := lx + 8 + 2*hv
        hd := en.HasOwnProp("id") ? AcctHead(en.id) : 0
        if hd
            BlitFitRR(hd, bxp, ry + 3, 28, 28, 7, fRow)
        else {
            ; placeholder only until the render lands
            b := VBrush(bxp, ry + 3, 28, 28, FA(Alpha(acc, 60), fRow), FA(Alpha(acc, 22), fRow))
            FillRR(bxp, ry + 3, 28, 28, 7, b), DelB(b)
            MicroBackdrop(bxp, ry + 3, 28, 28, 7, acc, fRow, now, 0.7)
            Txt(StrUpper(SubStr(en.nm, 1, 1)), bxp, ry + 7, 28, 20, fBadge
                , FA(Alpha(AccHi(acc, 0.5), 215), fRow), fmtC)
        }
        pn := Pen(FA(Alpha(on ? acc : 0xFFFFFF, on ? 150 : 40), fRow), 1)
        StrokeRR(bxp, ry + 3, 28, 28, 7, pn), DelP(pn)

        Txt(FFMElide(en.nm, fHint, lw - 52), bxp + 36, ry + 2, lw - 52, 16, fHint
            , FA(Alpha(on ? 0xFFE8EAF6 : 0xFFC7CBE0, on ? 240 : 165 + 55*hv), fRow), fmtL)
        pr := SPF.acctProf.Has(en.HasOwnProp("id") ? en.id : "")
            ? SPF.acctProf[en.id] : 0
        sub := pr ? AcctPresName(pr.pres) : "cookie saved"
        scol := pr ? AcctPresCol(pr.pres, acc) : 0xFFC7CBE0
        b := SBrush(FA(Alpha(scol, pr ? 200 : 110), fRow))
        FillEll(bxp + 36, ry + 21, 5, 5, b), DelB(b)
        Txt(sub, bxp + 46, ry + 17, lw - 62, 13, HL.fXs
            , FA(Alpha(pr ? AccHi(scol, 0.2) : 0xFFC7CBE0, pr ? 200 : 140), fRow), fmtL)
        ; a struck-through wash while the row is on its way out
        if (ke > 0.01) {
            ; C_OFF is a status colour: it has to stay red in both themes, and
            ; the strike has to stay visible on paper, so the wash is nudged
            ; darker in light mode rather than left as a pale pink film.
            kc := (thT > 0.5) ? Mix(C_OFF, 0xFF23242B, 0.35) : C_OFF
            b := SBrushP(FA(Alpha(kc, Round(60*Sin(3.14159*ke))), fo))
            FillRR(lx, ry, lw, rowH - 4, 8, b), DelB(b)
            pn := PenP(FA(Alpha(kc, Round(200*(1 - ke))), fo), 1.4)
            Line(lx + 10, ry + (rowH - 4)/2, lx + 10 + (lw - 20)*ke, ry + (rowH - 4)/2, pn), DelP(pn)
        }
        Pop(stR)
    }
    ; motes in the unused part of the column, matching the places library
    fy := ly + SPF.acct.Length*rowH
    if (fy < ly + 300 && !hubLowPerf) {
        loop 5 {
            k := A_Index
            mp := Mod(DecT(now)*0.00014 + k*0.2, 1.0)
            my := fy + (1 - mp)*(ly + 300 - fy)
            mx := lx + 24 + Mod(k*53, lw - 48) + 8*Sin(DecT(now)*0.0011 + k)
            mr := 1.1 + 0.7*Sin(DecT(now)*0.0026 + k*1.7)
            b := SBrush(FA(Alpha(acc, Round(38*Sin(3.14159*mp))), fo))
            FillEll(mx - mr, my - mr, mr*2, mr*2, b), DelB(b)
        }
    }

    by     := ly + ACCT_MAX*rowH + 6
    brwPnd := brwLoginAt && A_TickCount - brwLoginAt < 300000
    brwCol := brwPnd ? 0xFF38BDF8 : acc
    FFMBtn(1032, lx, by, 92, 26, "REMOVE", acc, fo, 0)
    FFMBtn(1038, lx + 96, by, 96, 26, brwPnd ? "SCANNING..." : "BROWSER LOGIN", brwCol, fo, 0)

    ; ---- divider ----
    pn := Pen(FA(Alpha(0xFFFFFF, 16), fo), 1)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
    DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.012, 1000))
    Line(x + 214, ly, x + 214, by + 26, pn), DelP(pn)

    ; ---- detail ----
    dx2 := x + 228, dw := w - 242
    aid := sel.HasOwnProp("id") ? sel.id : ""
    pr  := (aid != "" && SPF.acctProf.Has(aid)) ? SPF.acctProf[aid] : 0
    if (aid != "")
        AcctProfFetch(SPF.acctSel)

    ; rotatable avatar on the left, everything known about the account beside it
    avW := 116, avH := 150
    AcctAvatar(aid, dx2, ly, avW, avH, fo, now, acc)

    ix := dx2 + avW + 14, iw := dw - avW - 14
    Txt(FFMElide(sel.nm, fBadge, iw), ix, ly + 2, iw, 20, fBadge
        , FA(Alpha(0xFFE8EAF6, 245), fo), fmtL)
    if (pr && pr.disp != "" && pr.disp != sel.nm)
        Txt(FFMElide("@" pr.disp, HL.fXs, iw), ix, ly + 22, iw, 14, HL.fXs
            , FA(0x7EC7CBE0, fo), fmtL)

    ; presence pill - the one fact that changes minute to minute
    pt := pr ? Integer(pr.pres) : 0
    pc := AcctPresCol(pt, acc)
    pnm := pr ? AcctPresName(pt) : "checking..."
    pw2 := MeasureW(StrUpper(pnm), HL.fXs) + 26
    py2 := ly + 40
    b := SBrush(FA(Alpha(pc, pr ? 46 : 20), fo))
    FillRR(ix, py2, pw2, 17, 8, b), DelB(b)
    pn := Pen(FA(Alpha(pc, pr ? 120 : 50), fo), 1)
    StrokeRR(ix, py2, pw2, 17, 8, pn), DelP(pn)
    pu2 := (Sin(DecT(now)*0.0032) + 1)/2
    b := SBrush(FA(Alpha(pc, Round((pt ? 170 + 70*pu2 : 110))), fo))
    FillEll(ix + 8, py2 + 6, 5, 5, b), DelB(b)
    Txt(StrUpper(pnm), ix + 18, py2 + 1, pw2 - 22, 14, HL.fXs
        , FA(Alpha(AccHi(pc, 0.3), 230), fo), fmtL)
    if (pr && pr.loc != "" && pt >= 2)
        Txt(FFMElide(pr.loc, HL.fXs, iw - pw2 - 8), ix + pw2 + 8, py2 + 1, iw - pw2 - 8, 14
            , HL.fXs, FA(0x8EC7CBE0, fo), fmtL)

    ; ---- tabbed pane ----
    ; Four faces sharing one band. The panel has a hard ceiling - the launch
    ; target sits at ly+176 and cannot move without pushing LAUNCH off the
    ; card - so the description, the counts and the three lists take turns
    ; rather than stacking. Tabs, not a scroll, because these are unrelated
    ; kinds of thing and scrolling past two of them to reach the third is worse
    ; than picking it.
    tabs2 := ["ABOUT", "GROUPS", "CREATED"]
    tcnt  := [0, pr ? pr.groups.Length : 0, pr ? pr.made.Length : 0]
    tby := ly + 62, tbh := 18
    tbw2 := iw/3
    SPF.acctTabT += (SPF.acctTab - SPF.acctTabT)*EK(0.28)
    ; the indicator slides between tabs rather than jumping
    uxa := ix + (SPF.acctTabT - 1)*tbw2
    b := SBrush(FA(Alpha(acc, 30), fo))
    FillRR(uxa, tby, tbw2, tbh, 6, b), DelB(b)
    b := VBrush(uxa, tby + tbh - 2, tbw2, 2, FA(Alpha(AccHi(acc, 0.5), 235), fo)
              , FA(Alpha(acc, 150), fo))
    FillRR(uxa, tby + tbh - 2, tbw2, 2, 1, b), DelB(b)
    loop 3 {
        k := A_Index
        tx4 := ix + (k - 1)*tbw2
        selT := (SPF.acctTab = k)
        hvT := HL.h.Get(1039 + k, 0.0)
        if (hvT > 0.01 && !selT) {
            b := SBrush(FA(Alpha(0xFFFFFF, Round(14*hvT)), fo))
            FillRR(tx4, tby, tbw2, tbh, 6, b), DelB(b)
        }
        lb := tabs2[k] . (tcnt[k] ? (" " tcnt[k]) : "")
        Txt(lb, tx4, tby + 1, tbw2, 15, HL.fXs
            , FA(Alpha(selT ? AccHi(acc, 0.4) : 0xFFC7CBE0, selT ? 240 : 120 + 70*hvT), fo), fmtC)
    }

    ; pane band, clipped so a long list cannot bleed into the launch controls
    pnY := ly + 82, pnH := 73
    pC2 := RRPath(ix, pnY - 2, iw, pnH + 4, 6)
    svP := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC2, "int", 1)
    rows2 := []
    if (SPF.acctTab = 2)
        rows2 := pr ? pr.groups : []
    else if (SPF.acctTab = 3)
        rows2 := pr ? pr.made : []

    if (SPF.acctTab = 1) {
        ; ---- about: the blurb, then the four figures ----
        dsc2 := pr ? Trim(pr.desc) : ""
        if (dsc2 = "")
            dsc2 := pr ? "no description" : "loading profile..."
        n2 := 0
        for , wl in WrapText(dsc2, fHint, iw, 2) {
            if (n2 >= 2)
                break
            TxtRich(wl, ix, pnY + n2*15, iw, 15, fHint, fHintE, FA(0x9EC7CBE0, fo), fmtL)
            n2++
        }
        cLab := ["FRIENDS", "FOLLOWERS", "FOLLOWING", "GROUPS"]
        cVal := [pr ? pr.fr : "", pr ? pr.fol : "", pr ? pr.fwg : ""
               , pr ? String(pr.groups.Length) : ""]
        cw4 := (iw - 9)/4
        cy4 := pnY + 34
        loop 4 {
            k := A_Index
            cx4 := ix + (k - 1)*(cw4 + 3)
            b := VBrush(cx4, cy4, cw4, 32, FA(Mix(0xFF1B2038, acc, 0.10), fo)
                      , FA(Mix(0xFF12141F, acc, 0.05), fo))
            FillRR(cx4, cy4, cw4, 32, 7, b), DelB(b)
            MiniBackdrop(cx4, cy4, cw4, 32, 7, acc, fo, now, 0.8)
            pn := Pen(FA(Alpha(acc, 46), fo), 1)
            StrokeRR(cx4, cy4, cw4, 32, 7, pn), DelP(pn)
            Txt(cLab[k], cx4, cy4 + 2, cw4, 12, HL.fXs
                , FA(Alpha(0xFFC7CBE0, 130), fo), fmtC)
            Txt(cVal[k] = "" ? "--" : SPFNum(Number(cVal[k])), cx4, cy4 + 13, cw4, 16
                , fBadge, FA(Alpha(AccHi(acc, 0.35), 240), fo), fmtC)
        }
    } else if !rows2.Length {
        ; "empty" and "the request never came back" look identical on screen
        ; unless they are said differently, and they need opposite fixes.
        ; Name the actual failure. 200 with no rows really is an empty list;
        ; anything else is roblox refusing, and the code says which kind - 401
        ; auth, 400 a bad parameter, 404 a path that has moved, -1 no reply at
        ; all, -2 the helper never received the cookie.
        lsI := (SPF.acctTab = 2) ? 1 : 2
        lsA := (pr && pr.ls != "") ? StrSplit(pr.ls, Chr(2)) : []
        lsC := (lsI <= lsA.Length) ? lsA[lsI] : "200"
        eMsg := !pr ? "loading..."
              : (lsC = "200") ? "nothing here"
              : (lsC = "-2")  ? "the helper did not get the cookie"
              : (lsC = "-1" || lsC = "0") ? "no reply from roblox"
              : ("roblox refused this list  ·  http " lsC)
        Txt(eMsg, ix, pnY + 22, iw, 16, fHint
            , FA(Alpha((pr && lsC != "200") ? AMBER : 0xFFC7CBE0, 145), fo), fmtC)
    } else {
        rh2 := 24
        kind2 := (SPF.acctTab = 2) ? "r" : "g"
        SPF.acctPaneT += (SPF.acctPane - SPF.acctPaneT)*EK(0.3)
        loop rows2.Length {
            k := A_Index
            e3 := rows2[k]
            ry2 := pnY + (k - 1)*rh2 - SPF.acctPaneT*rh2
            if (ry2 < pnY - rh2 || ry2 > pnY + pnH)
                continue
            ; staggered entrance, measured from the moment the face changed -
            ; the list reads as arriving rather than being swapped underneath
            en3 := hubLowPerf ? 1.0
                 : Ease3(Clamp((now - SPF.acctTabAt - (k - 1)*45)/260.0, 0.0, 1.0))
            if (en3 <= 0.004)
                continue
            fRw := fo*en3
            sld3 := (1 - en3)*14
            hv3 := HL.h.Get(1044 + k, 0.0)
            rx3 := ix + sld3 + 2*hv3

            b := SBrush(FA(Alpha(0xFFFFFF, Round(8 + 14*hv3)), fRw))
            FillRR(rx3, ry2, iw, rh2 - 3, 5, b), DelB(b)
            if (hv3 > 0.01) {
                pn := Pen(FA(Alpha(acc, Round(90*hv3)), fRw), 1)
                StrokeRR(rx3, ry2, iw, rh2 - 3, 5, pn), DelP(pn)
            }

            ; ---- logo ----
            ico := AcctListIcon(kind2, e3.ic)
            isz := rh2 - 9
            ixp := rx3 + 4
            if ico
                BlitFitRR(ico, ixp, ry2 + 3, isz, isz, 5, fRw)
            else {
                ; placeholder that BREATHES, so a row waiting on its logo looks
                ; pending rather than broken
                shp := hubLowPerf ? 0.5 : 0.5 + 0.5*Sin(DecT(now)*0.004 + k*0.7)
                b := VBrush(ixp, ry2 + 3, isz, isz, FA(Alpha(acc, Round(38 + 26*shp)), fRw)
                          , FA(Alpha(acc, 18), fRw))
                FillRR(ixp, ry2 + 3, isz, isz, 5, b), DelB(b)
                Txt(StrUpper(SubStr(e3.n, 1, 1)), ixp, ry2 + 3, isz, isz - 1, HL.fXs
                    , FA(Alpha(AccHi(acc, 0.4), 205), fRw), fmtC)
            }
            pn := Pen(FA(Alpha(acc, Round(60 + 90*hv3)), fRw), 1)
            StrokeRR(ixp, ry2 + 3, isz, isz, 5, pn), DelP(pn)

            tx5 := ixp + isz + 8
            sw4 := (e3.s != "") ? 62 : 0
            Txt(FFMElide(e3.n, fHint, iw - (tx5 - rx3) - sw4 - 8), tx5, ry2 + 2
                , iw - (tx5 - rx3) - sw4 - 8, 15, fHint
                , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.25*hv3), 225 + 30*hv3), fRw), fmtL)
            if (e3.s != "") {
                ; visits for a game, the role held for a group
                sTxt := (SPF.acctTab = 2) ? e3.s : (SPFNum(Number(e3.s)) " visits")
                Txt(FFMElide(sTxt, HL.fXs, sw4), rx3 + iw - sw4 - 6, ry2 + 3, sw4, 14
                    , HL.fXs, FA(Alpha(AccHi(acc, 0.2), 190), fRw), fmtR)
            }
        }
        ; scrollbar, only when there is more than the band shows
        vis2 := pnH/rh2
        if (rows2.Length > vis2) {
            th4 := Max(14, pnH*(vis2/rows2.Length))
            mx4 := Max(0.0, rows2.Length - vis2)
            ty4 := pnY + (pnH - th4)*(SPF.acctPaneT/Max(0.001, mx4))
            b := SBrush(FA(Alpha(0xFFFFFF, 16), fo))
            FillRR(ix + iw - 3, pnY, 3, pnH, 1.5, b), DelB(b)
            b := VBrush(ix + iw - 3, ty4, 3, th4, FA(Alpha(AccHi(acc, 0.35), 200), fo)
                      , FA(Alpha(acc, 150), fo))
            FillRR(ix + iw - 3, ty4, 3, th4, 1.5, b), DelB(b)
        }
    }
    Pop(svP)
    DllCall("gdiplus\GdipDeletePath", "ptr", pC2)

    ; ---- launch target bar ----
    ty2 := ly + 176
    fon := (SH.focus = 10)
    fhv := HL.h.Get(1035, 0.0)
    Txt("LAUNCH TARGET", dx2, ty2 - 17, 200, 14, HL.fXs
        , FA(Alpha(fon ? acc : 0xFFC7CBE0, fon ? 210 : 130), fo), fmtL)
    b := SBrush(FA(Mix(0xFF141728, 0xFF1B2038, Max(fhv, fon*1.0)), fo))
    FillRR(dx2, ty2, dw, 28, 8, b), DelB(b)
    MicroBackdrop(dx2, ty2, dw, 28, 8, acc, fo, now, 0.75)
    pn := Pen(FA(Alpha(fon ? acc : 0xFFFFFF, fon ? 190 : 30 + 50*fhv), fo), fon ? 1.3 : 1)
    StrokeRR(dx2, ty2, dw, 28, 8, pn), DelP(pn)
    if fon {
        b := SBrush(FA(Alpha(acc, 210), fo))
        FillRR(dx2, ty2 + 7, 2.6, 14, 1.3, b), DelB(b)
    }
    vv := FldWindow(SPF.acctTgt, fon ? SH.fCar : StrLen(SPF.acctTgt), fHint, SPFAcctFldW(), &vo)
    if (fon && SH.fSel >= 0 && SH.fSel != SH.fCar) {
        sa := Max(Min(SH.fSel, SH.fCar) - vo, 0), sb := Min(Max(SH.fSel, SH.fCar) - vo, StrLen(vv))
        if (sb > sa) {
            xa := MeasureW(SubStr(vv, 1, sa), fHint), xb := MeasureW(SubStr(vv, 1, sb), fHint)
            b := SBrush(FA(Alpha(acc, 64), fo))
            FillRR(SPFAcctFldX() + xa, ty2 + 6, xb - xa, 16, 3, b), DelB(b)
        }
    }
    if (vv = "")
        Txt("place id, game link, private server link, or place id + job id"
            , SPFAcctFldX(), ty2 + 6, SPFAcctFldW(), 16, fHint, FA(0x58C7CBE0, fo), fmtL)
    else
        Txt(vv, SPFAcctFldX(), ty2 + 6, SPFAcctFldW(), 16, fHint
            , FA(Alpha(0xFFE8EAF6, 235), fo), fmtL)
    if (fon && Mod(A_TickCount - SH.caretAt, 1060) < 530) {
        cx2 := SPFAcctFldX() + MeasureW(SubStr(vv, 1, SH.fCar - vo), fHint)
        b := SBrush(FA(Alpha(0xFFFFFF, 225), fo))
        FillRR(cx2, ty2 + 6, 1.6, 16, 0.8, b), DelB(b)
    }
    ; what the box was understood to mean - shown before the click, not after.
    ; Derived from the parser itself rather than by sniffing the wording, so a
    ; reworded message can never flip the colour or the button state.
    dsc := AcctTargetDesc(SPF.acctTgt)
    tSrc := Trim(SPF.acctTgt)
    okT := (tSrc = "") ? true
         : (AcctParseTarget(tSrc, &p0, &j0, &c0, &s0) && s0 = "")
    b := SBrush(FA(Alpha(okT ? C_ON : AMBER, 150), fo))
    FillRR(dx2, ty2 + 36, 3, 14, 1.5, b), DelB(b)
    Txt(FFMElide(dsc, fHint, dw - 14), dx2 + 10, ty2 + 34, dw - 14, 18, fHint
        , FA(Alpha(okT ? 0xFFC7CBE0 : AMBER, 205), fo), fmtL)

    ; ---- launch ----
    busy := (SPF.acctAt && now - SPF.acctAt < 20000)
    lby := ty2 + 62
    FFMBtn(1031, dx2, lby, dw, 32
         , busy ? "LAUNCHING..." : ("LAUNCH " StrUpper(FFMElide(sel.nm, fBadge, dw - 120)))
         , acc, fo, (spfMulti && okT) ? 1 : 0)
    ; progress sweep while a ticket is in flight
    if (busy && !hubLowPerf) {
        sw := Mod(now - SPF.acctAt, 1200)/1200.0
        sxp := dx2 + dw*sw
        pC := RRPath(dx2, lby, dw, 32, 6)
        sv := PushG()
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC, "int", 1)
        ; The button face IS the accent in both themes, so the sweep has to
        ; move AWAY from it in whichever direction reads: lighter on the dark
        ; theme, darker on paper. A fixed pale sheen was invisible on one and a
        ; dirty smear on the other. Preserving brushes, because this colour is
        ; already resolved for the current theme.
        shn := (thT > 0.5) ? Mix(acc, 0xFF23242B, 0.55) : AccHi(acc, 0.5)
        b := HBrushP(sxp - 40, lby, 80, 32, FA(Alpha(shn, 0), fo), FA(Alpha(shn, 90), fo))
        FillRR(sxp - 40, lby, 40, 32, 0, b), DelB(b)
        b := HBrushP(sxp, lby, 80, 32, FA(Alpha(shn, 90), fo), FA(Alpha(shn, 0), fo))
        FillRR(sxp, lby, 40, 32, 0, b), DelB(b)
        Pop(sv)
        DllCall("gdiplus\GdipDeletePath", "ptr", pC)
    }
    ; ---- status ----
    ; The panel's own status line sits BEHIND this overlay, so every refusal and
    ; every error the launch reported was invisible while the thing that caused
    ; it was on screen - which is indistinguishable from a dead button. Mirror
    ; it here for as long as it is fresh.
    fresh := (SPF.msgAt && now - SPF.msgAt < 9000)
    if fresh {
        mc := (SPF.msgCol = C_ACC) ? acc : (SPF.msgCol ? SPF.msgCol : 0xFFC7CBE0)
        mf := Clamp(1 - (now - SPF.msgAt - 7000)/2000.0, 0.0, 1.0)
        pu := Max(0.0, Sin(Mod(DecT(now), 1700)/1700.0*6.283))**4
        b := SBrush(FA(Alpha(mc, Round((30 + 40*pu)*mf)), fo))
        FillEll(dx2, lby + 40, 12, 12, b), DelB(b)
        b := SBrush(FA(Alpha(mc, Round(235*mf)), fo))
        FillEll(dx2 + 3, lby + 43, 6, 6, b), DelB(b)
        Txt(FFMElide(SPF.msg, fHint, dw - 24), dx2 + 20, lby + 38, dw - 20, 17, fHint
            , FA(Alpha(AccHi(mc, 0.25), Round(235*mf)), fo), fmtL)
    } else {
        Txt("opens a client already signed in as this account - one per account, all at once"
            , dx2, lby + 38, dw, 16, HL.fXs, FA(0x72C7CBE0, fo), fmtL)
    }
    Txt("a saved cookie signs in with no password - keep this machine yours"
        , dx2, lby + 56, dw, 16, HL.fXs, FA(Alpha(AMBER, 160), fo), fmtL)
    Pop(st)
}

; ---- saved places overlay ----
; Same shell as the flag database: scrim, a card that scales in, a header with
; the matching close cross. Master list on the left, detail on the right.
; Figures roll toward their new values instead of snapping, which is what makes
; an update read as live rather than as a redraw.
SPFSavedView(ff, now, acc, dx := 0, dy2 := 0) {
    e := Ease3(Clamp((now - SPF.viewAt)/300.0, 0.0, 1.0))
    if (SPF.view = "sav")
        t := e
    else if (SPF.viewPrev = "sav")
        t := 1 - e
    else
        return
    if (t <= 0.01)
        return
    fo := ff*t
    x := HL.ctx + dx, y := HL.cty + dy2 + 30, w := HL.ctw, h := 414

    b := SBrush(FA(Alpha(0x06070E, Round(220*t)), ff))
    FillRR(x - 10, HL.cty + dy2 - 6, w + 20, h + 54, 14, b), DelB(b)

    st := PushXform(x + w/2, y + h/2, 0.96 + 0.04*t, 0)
    HubViewChrome(x, y, w, h, fo, now, acc)

    b := SBrush(FA(Alpha(acc, 200), fo))
    FillRR(x, y + 10, 3, 22, 1.5, b), DelB(b)

    ; ---- tabs ----
    ; In the header row rather than on their own: a separate row pushed the stat
    ; tiles 12px past the bottom of the card.
    SPF.tabT += (((SPF.savTab = 2) ? 1.0 : 0.0) - SPF.tabT)*EK(0.26)
    tabs := ["PLACES", "PRIVATE SERVERS"]
    cnts := [SPF.saved.Length, SPF.savedP.Length]
    tbw := []
    loop 2
        tbw.Push(MeasureW(tabs[A_Index], fBadge) + 46)
    tbx := x + 16
    loop 2 {
        i := A_Index
        tw3 := tbw[i]
        hvT := HL.h.Get(1006 + i, 0.0)
        selT := (SPF.savTab = i)
        if (hvT > 0.01 && !selT) {
            b := SBrush(FA(Alpha(0xFFFFFF, Round(16*hvT)), fo))
            FillRR(tbx - 8, y + 8, tw3 + 6, 24, 7, b), DelB(b)
        }
        Txt(tabs[i], tbx, y + 11, tw3 - 30, 18, fBadge
            , FA(Alpha(selT ? 0xFFE8EAF6 : 0xFFC7CBE0, selT ? 240 : 120 + 70*hvT), fo), fmtL)
        b := SBrush(FA(Alpha(cnts[i] ? acc : 0xFFFFFF, cnts[i] ? (selT ? 60 : 34) : 14), fo))
        FillRR(tbx + tw3 - 34, y + 13, 26, 15, 7, b), DelB(b)
        Txt(cnts[i], tbx + tw3 - 34, y + 13, 26, 14, HL.fXs
            , FA(Alpha(cnts[i] ? AccHi(acc, 0.5) : 0xFFC7CBE0, 220), fo), fmtC)
        tbx += tw3 + 18
    }
    ; the indicator slides between them rather than jumping
    ux0 := x + 16, ux1 := x + 16 + tbw[1] + 18
    eT := Ease3(Clamp(SPF.tabT, 0.0, 1.0))
    uxa := ux0 + (ux1 - ux0)*eT
    uwa := tbw[1] + (tbw[2] - tbw[1])*eT
    b := VBrush(uxa - 8, y + 32, uwa + 6, 2, FA(Alpha(AccHi(acc, 0.5), 235), fo)
              , FA(Alpha(acc, 150), fo))
    FillRR(uxa - 8, y + 32, uwa + 6, 2, 1, b), DelB(b)

    ; add whatever place is current, without leaving the library
    hvA := HL.h.Get(1003, 0.0)
    abx2 := x + w - 122, aby2 := y + 8
    b := SBrush(FA(Alpha(acc, Round(22 + 34*hvA)), fo))
    FillRR(abx2, aby2, 88, 22, 7, b), DelB(b)
    MicroBackdrop(abx2, aby2, 88, 22, 7, acc, fo, now, 0.9)
    pn := Pen(FA(Alpha(acc, Round(90 + 90*hvA)), fo), 1)
    StrokeRR(abx2, aby2, 88, 22, 7, pn), DelP(pn)
    b := SBrush(FA(Alpha(AccHi(acc, 0.4), 210 + 45*hvA), fo))
    FillRR(abx2 + 11, aby2 + 10, 10, 2, 1, b)
    FillRR(abx2 + 15, aby2 + 6, 2, 10, 1, b), DelB(b)
    Txt("ADD CURRENT", abx2 + 26, aby2 + 4, 58, 14, HL.fXs
        , FA(Alpha(0xFFE8EAF6, 190 + 60*hvA), fo), fmtL)

    hvX := HL.h.Get(990, 0.0)
    if (hvX > 0.01) {
        b := SBrush(FA(Alpha(acc, Round(40*hvX)), fo))
        FillEll(x + w - 18 - 11, y + 14 - 11, 22, 22, b), DelB(b)
    }
    pn := Pen(FA(Alpha(hvX > 0.2 ? acc : 0xFFC7CBE0, 130 + 120*hvX), fo), 1.6)
    cxx := x + w - 18, cyy := y + 14
    Line(cxx - 5, cyy - 5, cxx + 5, cyy + 5, pn)
    Line(cxx + 5, cyy - 5, cxx - 5, cyy + 5, pn), DelP(pn)

    pn := Pen(FA(Alpha(0xFFFFFF, 20), fo), 1)
    Line(x + 14, y + 38, x + w - 14, y + 38, pn), DelP(pn)

    if (t < 0.85) {
        Pop(st)
        return
    }
    SPFPrefetchArm()                             ; keep resolving while it is open
    lx := x + 14, ly := y + 48, lw := 192
    LST := SPFList()
    priv := (SPF.savTab = 2)        ; captured WITH the list it selected
    if !LST.Length {
        Txt(priv ? "no private servers saved" : "nothing saved yet"
            , x + 16, y + h/2 - 22, w - 32, 20, fBadge, FA(Alpha(0xFFE8EAF6, 200), fo), fmtC)
        Txt(priv ? "use ADD and paste a private server link"
                           : "use ADD to enter a place id"
            , x + 16, y + h/2 + 2, w - 32, 18, fHint, FA(0x72C7CBE0, fo), fmtC)
        ; the sheet must still draw here - an empty library is exactly when the
        ; user needs to add something
        SPFAddSheet(x, y, w, h, fo, now, acc)
        Pop(st)
        return
    }
    ; drawn at the end of this function, after the list it sits over
    SPFSelSet(Clamp(SPFSelIdx(), 1, LST.Length))
    sel := LST[SPFSelIdx()]
    SPFStatsFetch(sel.id)

    ; ---- master list ----
    loop LST.Length {
        i := A_Index
        en := LST[i]
        ry := ly + (i - 1)*38
        on := (i = SPFSelIdx())
        hv := HL.h.Get(990 + i, 0.0)
        if (on || hv > 0.01) {
            b := HBrush(lx, ry, lw, 34, FA(Alpha(on ? acc : 0xFFFFFF, on ? 38 : 14*hv), fo)
                      , FA(Alpha(on ? acc : 0xFFFFFF, on ? 8 : 3*hv), fo))
            FillRR(lx, ry, lw, 34, 8, b), DelB(b)
        }
        if on {
            b := VBrush(lx, ry + 6, 3, 22, FA(Alpha(AccHi(acc, 0.4), 240), fo)
                      , FA(Alpha(acc, 160), fo))
            FillRR(lx, ry + 6, 3, 22, 1.5, b), DelB(b)
            pn := Pen(FA(Alpha(acc, 70), fo), 1)
            StrokeRR(lx, ry, lw, 34, 8, pn), DelP(pn)
        }
        ; square logo, or a lettered placeholder until it arrives
        ico := SPFIco(en.id)
        ixp := lx + 8 + 2*hv
        if ico
            BlitFitRR(ico, ixp, ry + 3, 28, 28, 7, fo)
        else {
            b := VBrush(ixp, ry + 3, 28, 28, FA(Alpha(acc, 60), fo), FA(Alpha(acc, 22), fo))
            FillRR(ixp, ry + 3, 28, 28, 7, b), DelB(b)
            MicroBackdrop(ixp, ry + 3, 28, 28, 7, acc, fo, now, 0.7)
            Txt(SubStr(en.nm != "" ? en.nm : "?", 1, 1), ixp, ry + 7, 28, 20, fBadge
                , FA(Alpha(AccHi(acc, 0.5), 210), fo), fmtC)
        }
        pn := Pen(FA(Alpha(on ? acc : 0xFFFFFF, on ? 150 : 40), fo), 1)
        StrokeRR(ixp, ry + 3, 28, 28, 7, pn), DelP(pn)

        ; Width stops short of the player count on the right instead of running
        ; the full row: the text column starts at ixp + 36 and the count starts
        ; at lx + lw - 66, so anything wider than the gap between them ran
        ; straight through the figure. The count only appears once stats land,
        ; so the column widens again when there is nothing to avoid.
        hasN := SPF.stats.Has(en.id) && SPF.stats[en.id].playing != ""
        tw9  := (hasN ? lx + lw - 72 : lx + lw - 22) - (ixp + 36)
        nm := en.nm != "" ? en.nm : ("place " en.id)
        Txt(FFMElide(nm, fHint, tw9), ixp + 36, ry + 2, tw9, 16, fHint
            , FA(Alpha(on ? 0xFFE8EAF6 : 0xFFC7CBE0, on ? 240 : 165 + 55*hv), fo), fmtL)
        ; Branches on the ENTRY, not on a re-read of SPF.savTab. LST was
        ; captured above; SPFStatsFetch calls Run(), which can let a queued
        ; click through even under Critical, and a SPFTabSet landing there
        ; left the tab saying "private" while LST still held the places
        ; array - whose entries carry no `code` at all.
        sub := !(priv && en.HasOwnProp("code")) ? en.id
             : (en.id = "" ? "place id missing" : ("code " SubStr(en.code, 1, 10)))
        Txt(FFMElide(sub, HL.fXs, tw9), ixp + 36, ry + 17, tw9, 13, HL.fXs, FA(0x5EC7CBE0, fo), fmtL)
        ; live player count on the row, once known
        if (SPF.stats.Has(en.id) && SPF.stats[en.id].playing != "") {
            b := SBrush(FA(Alpha(C_ON, 150 + 60*hv), fo))
            FillEll(lx + lw - 16, ry + 14, 5, 5, b), DelB(b)
            Txt(SPFNum(Number(SPF.stats[en.id].playing)), lx + lw - 66, ry + 10, 44, 14
                , HL.fXs, FA(Alpha(C_ON, 175 + 60*hv), fo), fmtR)
        }
    }
    ; motes drifting in the empty part of the list, so it is never dead space
    fy := ly + LST.Length*38
    if (fy < ly + 300 && !hubLowPerf) {
        loop 5 {
            k := A_Index
            mp := Mod(DecT(now)*0.00014 + k*0.2, 1.0)
            my := fy + (1 - mp)*(ly + 300 - fy)   ; drift up through the gap
            mx := lx + 24 + Mod(k*53, lw - 48) + 8*Sin(DecT(now)*0.0011 + k)
            mr := 1.1 + 0.7*Sin(DecT(now)*0.0026 + k*1.7)
            b := SBrush(FA(Alpha(acc, Round(38*Sin(3.14159*mp))), fo))
            FillEll(mx - mr, my - mr, mr*2, mr*2, b), DelB(b)
        }
    }

    by := ly + 8*38 + 6
    cpFl := (SPF.copyAt && now - SPF.copyAt < 1100)
    FFMBtn(1002, lx, by, 62, 26, cpFl ? "COPIED" : "COPY", acc, fo, cpFl ? 3 : 0)
    FFMBtn(1000, lx + 65, by, 62, 26, "USE", acc, fo, 1)
    FFMBtn(999, lx + 130, by, 62, 26, "REMOVE", acc, fo, 0)
    ; PRIVATE SERVERS only, on its own row under the other three. A saved place
    ; carries the game's real name, resolved from its id - editing that would
    ; only ever make the library disagree with Roblox. Several private servers
    ; of the SAME game is the normal case, though, and three rows reading
    ; "Forsaken" are indistinguishable until you can label them.
    ; by + 28 at height 24, not by + 30 at 26: the list reserves all eight slots
    ; whatever is actually saved, so the button row already sits close to the
    ; bottom of the card and a second full-height row would have landed exactly
    ; on the edge.
    if priv
        FFMBtn(1012, lx, by + 28, 192, 24, "RENAME", acc, fo, 0)

    ; ---- divider ----
    pn := Pen(FA(Alpha(0xFFFFFF, 16), fo), 1)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
    DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.012, 1000))
    Line(x + 214, ly, x + 214, by + 26, pn), DelP(pn)

    ; ---- detail ----
    dx := x + 228, dw := w - 242
    have := SPF.stats.Has(sel.id)
    r := have ? SPF.stats[sel.id] : 0
    ih := Round(dw*9/16)

    ; ---- banner carousel ----
    ; Selection changed under us: start this game's reel from the top rather
    ; than inheriting an index that may not even exist here.
    if (SPF.bnFor != sel.id) {
        SPFBannerDrop(SPF.bnFor)
        SPF.bnFor := sel.id, SPF.bnI := 1, SPF.bnNext := 1
        SPF.bnFadeAt := 0, SPF.bnAt := now
    }
    bnN := SPFThumbN(sel.id)
    if (SPF.bnI > bnN)
        SPF.bnI := 1, SPF.bnNext := 1, SPF.bnFadeAt := 0, SPF.bnAt := now
    if (SPF.bnFadeAt && now - SPF.bnFadeAt >= SPF_BN_FADE)
        SPF.bnI := SPF.bnNext, SPF.bnFadeAt := 0, SPF.bnAt := now
    if (bnN > 1 && !SPF.bnFadeAt && now - SPF.bnAt >= SPF_BN_HOLD)
        SPF.bnNext := Mod(SPF.bnI, bnN) + 1, SPF.bnFadeAt := now
    ; read after the advance above, so the frame a fade starts on is not left
    ; holding a stale 1.0 and snapping the incoming banner straight in
    bnT := SPF.bnFadeAt ? Clamp(Ease3((now - SPF.bnFadeAt)/SPF_BN_FADE), 0.0, 1.0) : 1.0
    th  := SPFThumbAt(sel.id, SPF.bnI)
    thN := (SPF.bnFadeAt && SPF.bnNext != SPF.bnI) ? SPFThumbAt(sel.id, SPF.bnNext) : 0

    b := SBrush(FA(0xFF0C0E17, fo))
    FillRR(dx, ly, dw, ih, 10, b), DelB(b)
    if th {
        ; Ken Burns: the held banner drifts in a hair over its dwell so the
        ; panel never reads as a still, and the incoming one starts slightly
        ; wide so the two are never at the same crop mid-fade.
        held := Clamp((now - SPF.bnAt)/(SPF_BN_HOLD + SPF_BN_FADE + 0.0), 0.0, 1.0)
        BlitFitRR(th, dx, ly, dw, ih, 10, fo
                , 1.0 + 0.06*held, 0.46 + 0.08*held, 0.5)
        if thN
            BlitFitRR(thN, dx, ly, dw, ih, 10, fo*bnT
                    , 1.06 - 0.06*bnT, 0.54 - 0.08*bnT, 0.5)
        ; scan band + bottom scrim, clipped to the image
        pC := RRPath(dx, ly, dw, ih, 10)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC, "int", 0)
        bandY := ly + Mod(DecT(now)*0.05, ih + 60) - 30
        b := VBrush(dx, bandY, dw, 22, Alpha(0xFFFFFF, 0), FA(Alpha(0xFFFFFF, 16), fo))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", dx, "float", bandY, "float", dw, "float", 22), DelB(b)
        ; the fade throws a soft accent wash across the seam
        if (SPF.bnFadeAt && thN) {
            wsh := Sin(3.14159*bnT)
            b := VBrush(dx, ly, dw, ih, FA(Alpha(acc, Round(26*wsh)), fo), Alpha(acc, 0))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", dx, "float", ly, "float", dw, "float", ih), DelB(b)
        }
        b := VBrush(dx, ly + ih - 44, dw, 44, Alpha(0x000000, 0), FA(0xB4000000, fo))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", dx, "float", ly + ih - 44, "float", dw, "float", 44), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", pC)
        SPFBannerDots(dx, ly, dw, ih, bnN, fo, now, acc)
        SPFBannerHover(dx, ly, dw, ih, bnN, fo, now, acc)
    } else {
        ph := (Sin(DecT(now)*0.005) + 1)/2
        Txt(have ? "no image" : "loading image...", dx, ly + ih/2 - 9, dw, 18, fHint
            , FA(Alpha(0xC7CBE0, Round(70 + 60*ph)), fo), fmtC)
        pn := Pen(FA(Alpha(acc, Round(40 + 60*ph)), fo), 1.4)
        aa := Mod(DecT(now)*0.14, 360)
        Arc(dx + dw/2 - 13, ly + ih/2 - 34, 26, 26, aa, 80, pn), DelP(pn)
    }
    pn := Pen(FA(Alpha(acc, 80), fo), 1)
    StrokeRR(dx, ly, dw, ih, 10, pn), DelP(pn)

    ; name sits over the scrim, so it reads on any artwork
    ; The name always sits in the same place - over the scrim on the artwork, or
    ; in the same spot on the placeholder. Drawing it below the box when there
    ; was no image put it straight through the id chip.
    nmTxt := StripEmoji(r ? (r.nm != "" ? r.nm : sel.id) : sel.id)
    Txt(FFMElide(nmTxt, fBadge, dw - 24), dx + 12, ly + ih - 32, dw - 24, 22, fBadge
        , FA(Alpha(th ? 0xFFFFFF : 0xFFE8EAF6, th ? 245 : 205), fo), fmtL)
    ty := ly + ih + 12

    ; id as its own chip, with the live dot beside it instead of on top of it
    if (priv) {
        pw3 := MeasureW("PRIVATE SERVER", HL.fXs) + 20
        b := SBrush(FA(Alpha(acc, 46), fo))
        FillRR(dx + dw - pw3, ty - 26, pw3, 18, 8, b), DelB(b)
        pn := Pen(FA(Alpha(acc, 110), fo), 1)
        StrokeRR(dx + dw - pw3, ty - 26, pw3, 18, 8, pn), DelP(pn)
        Txt("PRIVATE SERVER", dx + dw - pw3, ty - 24, pw3, 14, HL.fXs
            , FA(Alpha(AccHi(acc, 0.45), 225), fo), fmtC)
    }
    idw := MeasureW("ID " sel.id, HL.fXs) + 20
    b := SBrush(FA(Alpha(0xFFFFFF, 12), fo))
    FillRR(dx, ty, idw, 20, 6, b), DelB(b)
    pn := Pen(FA(Alpha(acc, 55), fo), 1)
    StrokeRR(dx, ty, idw, 20, 6, pn), DelP(pn)
    Txt("ID " sel.id, dx, ty + 3, idw, 14, HL.fXs, FA(Alpha(0xFFC7CBE0, 210), fo), fmtC)
    if have {
        age := Clamp((now - r.at)/4000.0, 0.0, 1.0)
        pr := 1 - age
        b := SBrush(FA(Alpha(C_ON, Round(45 + 30*pr)), fo))
        FillEll(dx + idw + 10, ty + 5, 10, 10, b), DelB(b)
        b := SBrush(FA(Alpha(C_ON, Round(150 + 105*pr)), fo))
        FillEll(dx + idw + 12.5, ty + 7.5, 5, 5, b), DelB(b)
        Txt("LIVE", dx + idw + 26, ty + 4, 60, 13, HL.fXs, FA(Alpha(C_ON, 130 + 80*pr), fo), fmtL)
    }

    ; ---- description, wrapped ----
    ; ---- description, wrapped and scrollable ----
    dsc := r ? r.desc : ""
    if (dsc = "")
        dsc := have ? "no description" : "fetching details..."
    dy2 := ty + 28
    dvis := 4, dlh := 16, dh2 := dvis*dlh
    dlines := []
    for para in StrSplit(dsc, "`n", "`r") {
        if (Trim(para) = "") {
            dlines.Push("")
            continue
        }
        for , wl in WrapText(para, fHint, dw - 12, 40)
            dlines.Push(wl)
    }
    SPF.dscrMax := Max(0, dlines.Length - dvis)
    SPF.dscr := Clamp(SPF.dscr, 0, SPF.dscrMax)
    SPF.dscrT += (SPF.dscr - SPF.dscrT)*0.3      ; eased, so the wheel glides
    pD := RRPath(dx, dy2 - 2, dw, dh2 + 4, 6)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pD, "int", 0)
    loop dlines.Length {
        i3 := A_Index
        lyy := dy2 + (i3 - 1)*dlh - SPF.dscrT*dlh
        if (lyy < dy2 - dlh || lyy > dy2 + dh2)
            continue
        ; TxtRich, not Txt: this is the one string in the suite that comes
        ; straight from a Roblox description, emoji and all
        TxtRich(dlines[i3], dx, lyy, dw - 12, 15, fHint, fHintE, FA(0x8EC7CBE0, fo), fmtL)
    }
    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", pD)
    if (SPF.dscrMax > 0) {
        trh := dh2
        thh := Max(18, trh*(dvis/dlines.Length))
        tyy := dy2 + (trh - thh)*(SPF.dscrT/SPF.dscrMax)
        b := SBrush(FA(Alpha(0xFFFFFF, 16), fo))
        FillRR(dx + dw - 4, dy2, 3, trh, 1.5, b), DelB(b)
        b := VBrush(dx + dw - 4, tyy, 3, thh, FA(Alpha(AccHi(acc, 0.35), 200), fo)
                  , FA(Alpha(acc, 150), fo))
        FillRR(dx + dw - 4, tyy, 3, thh, 1.5, b), DelB(b)
        ; a hint that there is more, fading once you have scrolled
        if (SPF.dscrT < 0.3) {
            fadeA := Round(90*(1 - SPF.dscrT/0.3))
            b := VBrush(dx, dy2 + dh2 - 14, dw - 8, 14, Alpha(0x0F1120, 0), FA(Alpha(0x0F1120, fadeA), fo))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", dx, "float", dy2 + dh2 - 14, "float", dw - 8, "float", 14), DelB(b)
        }
    }

    ; ---- stat tiles ----
    if !SPF.shown.Has(sel.id)
        SPF.shown[sel.id] := {playing: 0.0, visits: 0.0, up: 0.0, down: 0.0, favs: 0.0}
    sh := SPF.shown[sel.id]
    tp := r ? Number(r.playing = "" ? 0 : r.playing) : 0
    tv := r ? Number(r.visits  = "" ? 0 : r.visits)  : 0
    tu := r ? Number(r.up      = "" ? 0 : r.up)      : 0
    td := r ? Number(r.down    = "" ? 0 : r.down)    : 0
    sh.playing += (tp - sh.playing)*EK(0.18)
    sh.visits  += (tv - sh.visits)*EK(0.18)
    sh.up      += (tu - sh.up)*EK(0.18)
    sh.down    += (td - sh.down)*EK(0.18)

    labs := ["PLAYING", "VISITS", "LIKES", "DISLIKES"]
    vals := [sh.playing, sh.visits, sh.up, sh.down]
    tgts := [tp, tv, tu, td]
    cols := [C_ON, 0xFFC7CBE0, C_ON, acc]
    tw2 := (dw - 12)/4
    sy2 := dy2 + dh2 + 10
    ratio := (sh.up + sh.down > 1) ? sh.up/(sh.up + sh.down) : 0.0
    loop 4 {
        i := A_Index
        tx2 := dx + (i - 1)*(tw2 + 4)
        mv := Abs(vals[i] - tgts[i]) > 0.5
        cc2 := cols[i]
        ; tinted toward the stat's own colour rather than four identical boxes
        b := VBrush(tx2, sy2, tw2, 50, FA(Mix(0xFF1B2038, cc2, 0.10), fo)
                  , FA(Mix(0xFF12141F, cc2, 0.05), fo))
        FillRR(tx2, sy2, tw2, 50, 8, b), DelB(b)
        ; keyed to the stat's own colour so the four tiles stay distinguishable.
        ; supplies the top sheen these tiles used to draw by hand.
        MiniBackdrop(tx2, sy2, tw2, 50, 8, cc2, fo, now, 0.8)
        pn := Pen(FA(Alpha(mv ? acc : cc2, mv ? 170 : 46), fo), 1)
        StrokeRR(tx2, sy2, tw2, 50, 8, pn), DelP(pn)

        SPFStatGlyph(i, tx2 + 14, sy2 + 12, FA(Alpha(cc2, mv ? 235 : 165), fo))
        Txt(labs[i], tx2 + 24, sy2 + 5, tw2 - 28, 13, HL.fXs
            , FA(Alpha(0xFFC7CBE0, 130), fo), fmtL)
        Txt(SPFNum(vals[i]), tx2, sy2 + 20, tw2, 22, fBadge
            , FA(Alpha(cc2, 245), fo), fmtC)

        ; likes / dislikes carry a share bar, so the split reads at a glance
        if (i >= 3 && (sh.up + sh.down) > 1) {
            frac := (i = 3) ? ratio : 1 - ratio
            b := SBrush(FA(Alpha(0xFFFFFF, 16), fo))
            FillRR(tx2 + 10, sy2 + 42, tw2 - 20, 3, 1.5, b), DelB(b)
            b := VBrush(tx2 + 10, sy2 + 42, (tw2 - 20)*frac, 3
                      , FA(Alpha(AccHi(cc2, 0.4), 220), fo), FA(Alpha(cc2, 170), fo))
            FillRR(tx2 + 10, sy2 + 42, Max(2, (tw2 - 20)*frac), 3, 1.5, b), DelB(b)
        } else if (i = 1 && tgts[1] > 0) {
            ; a live pip that breathes while players are in there
            pp := (Sin(DecT(now)*0.004) + 1)/2
            b := SBrush(FA(Alpha(cc2, Round(80 + 110*pp)), fo))
            FillEll(tx2 + tw2/2 - 2, sy2 + 42, 4, 4, b), DelB(b)
        }
        if mv {
            pr2 := Mod(DecT(now), 900)/900.0
            pn := Pen(FA(Alpha(acc, Round(120*(1 - pr2))), fo), 1.6*(1 - pr2) + 0.3)
            ex2 := pr2*7
            StrokeRR(tx2 - ex2, sy2 - ex2*0.6, tw2 + ex2*2, 50 + ex2*1.2, 8 + ex2*0.3, pn), DelP(pn)
        }
    }
    SPFAddSheet(x, y, w, h, fo, now, acc)
    SPFRenSheet(x, y, w, h, fo, now, acc)
    Pop(st)
}

; A small modal over the library, built on the same bones as SPFAddSheet so the
; two read as one pattern rather than two. One field, because there is exactly
; one thing to change.
SPFRenSheet(x, y, w, h, fo, now, acc) {
    SPF.renT += ((SPF.renOpen ? 1.0 : 0.0) - SPF.renT)*EK(0.3)
    if (!SPF.renOpen && SPF.renT < 0.004)
        SPF.renT := 0.0
    if (SPF.renT <= 0.004)
        return
    e := Ease3(Clamp(SPF.renT, 0.0, 1.0))
    ; Same split as the add sheet: SPFRenGeom is the RESTING position and is
    ; what the hit test uses, while the draw follows the page as it slides.
    SPFRenGeom(&sxG, &syG, &sw, &shh)
    sx := x + w/2 - sw/2
    sy := y + 414/2 - shh/2
    sdy := sy - syG
    fsh := fo*e

    b := SBrush(FA(Alpha(0x06070E, Round(180*e)), fo))
    FillRR(x, y, w, h, 12, b), DelB(b)

    sts := PushXform(sx + sw/2, sy + shh/2, 0.9 + 0.1*e, 0)
    ShadowDraw(sx, sy + 4, sw, shh, 14, 6, 18, 18, fsh, HL.k)
    b := VBrush(sx, sy, sw, shh, FA(0xFF1B2038, fsh), FA(0xFF10121C, fsh))
    FillRR(sx, sy, sw, shh, 12, b), DelB(b)
    MiniBackdrop(sx, sy, sw, shh, 12, acc, fsh, now, 0.85)
    pn := Pen(FA(Alpha(acc, 170), fsh), 1.3)
    StrokeRR(sx, sy, sw, shh, 12, pn), DelP(pn)
    loop 4 {
        k := A_Index - 1
        cxk := (k = 1 || k = 2) ? sx + sw - 20 : sx
        cyk := (k >= 2) ? sy + shh - 20 : sy
        ang := k = 0 ? 195 : k = 1 ? 285 : k = 2 ? 15 : 105
        pn := Pen(FA(Alpha(acc, 90), fsh), 1.4)
        Arc(cxk, cyk, 20, 20, ang, 60, pn), DelP(pn)
    }
    b := SBrush(FA(Alpha(acc, 210), fsh))
    FillRR(sx, sy + 12, 3, 18, 1.5, b), DelB(b)
    Txt("RENAME PRIVATE SERVER", sx + 16, sy + 12, 260, 18
        , fBadge, FA(Alpha(0xFFE8EAF6, 235), fsh), fmtL)
    Txt("your label for this server - the game itself is unchanged"
        , sx + 16, sy + 32, sw - 32, 14, HL.fXs, FA(0x72C7CBE0, fsh), fmtL)

    ; ---- the one field ----
    foc := (SH.focus = 11)
    hvF := HL.h.Get(1013, 0.0)
    fx  := sx + 20, fy := SPFRenFldY() + sdy, fw := sw - 40
    val := SPF.renTxt
    Txt("NAME", fx, fy - 16, fw, 13, HL.fXs, FA(Alpha(0xFFC7CBE0, 140), fsh), fmtL)
    b := SBrush(FA(Mix(0xFF141728, 0xFF1B2038, Max(hvF, foc*1.0)), fsh))
    FillRR(fx, fy, fw, 26, 7, b), DelB(b)
    MicroBackdrop(fx, fy, fw, 26, 7, acc, fsh, now, 0.75)
    pn := Pen(FA(Alpha(SPF.renErr != "" ? C_BAD : (foc ? acc : 0xFFFFFF)
                     , SPF.renErr != "" ? 190 : (foc ? 190 : 30 + 50*hvF)), fsh), 1)
    StrokeRR(fx, fy, fw, 26, 7, pn), DelP(pn)
    if foc {
        b := SBrush(FA(Alpha(acc, 210), fsh))
        FillRR(fx, fy + 6, 2.6, 14, 1.3, b), DelB(b)
    }
    vv := FldWindow(val, foc ? SH.fCar : StrLen(val), fHint, fw - 20, &vo)
    if (foc && SH.fSel >= 0 && SH.fSel != SH.fCar) {
        sa := Max(Min(SH.fSel, SH.fCar) - vo, 0)
        sb := Min(Max(SH.fSel, SH.fCar) - vo, StrLen(vv))
        if (sb > sa) {
            xa := MeasureW(SubStr(vv, 1, sa), fHint)
            xb := MeasureW(SubStr(vv, 1, sb), fHint)
            b := SBrush(FA(Alpha(acc, 64), fsh))
            FillRR(fx + 10 + xa, fy + 5, xb - xa, 16, 3, b), DelB(b)
        }
    }
    if (vv = "")
        Txt("e.g. main server, friends only", fx + 10, fy + 5, fw - 20, 16, fHint
            , FA(0x58C7CBE0, fsh), fmtL)
    else
        Txt(vv, fx + 10, fy + 5, fw - 20, 16, fHint, FA(Alpha(0xFFE8EAF6, 235), fsh), fmtL)
    if (foc && Mod(A_TickCount - SH.caretAt, 1060) < 530) {
        ccx := fx + 10 + MeasureW(SubStr(vv, 1, SH.fCar - vo), fHint)
        b := SBrush(FA(Alpha(0xFFFFFF, 225), fsh))
        FillRR(ccx, fy + 5, 1.6, 16, 0.8, b), DelB(b)
    }
    if (SPF.renErr != "")
        Txt(SPF.renErr, sx + 20, sy + 100, sw - 40, 14, HL.fXs
          , FA(Alpha(C_BAD, 215), fsh), fmtL)

    FFMBtn(1014, sx + 20, sy + shh - 40, 124, 26, "CANCEL", 0xFFC7CBE0, fsh, 0)
    FFMBtn(1015, sx + sw - 144, sy + shh - 40, 124, 26, "SAVE", acc, fsh
         , Trim(SPF.renTxt) != "" ? 1 : 0)
    Pop(sts)
}


; ---- banner hover: SKIP ----
; The carousel advances on its own, so the click is a shortcut rather than the
; only way through - which is why nothing is shown until the pointer is on it.
; A single banner has nothing to skip TO, so it gets no affordance at all
; rather than a control that would do nothing.
SPFBannerHover(dx, ly, dw, ih, n, fo, now, acc) {
    BannerSkipHover(1010, SPF.bnFadeAt, dx, ly, dw, ih, n, fo, now, acc)
}
; ---- the same affordance, wherever a reel is ----
; One drawing for every click-to-skip banner in the suite - the saved place's
; carousel, the community hero, each community game's thumbnail - so a reel
; answers the pointer the same way everywhere. z is the hit zone the hover
; value is read from; pressAt is when the last skip started, which drives the
; press flash and the ring (a click still registers while the crossfade it
; started is running, so the flash is driven off the fade rather than the
; pointer). compact is for a thumbnail: the plate shrinks to the chevrons and
; drops the word, because a 96 px pill on a 124 px picture is the picture.
BannerSkipHover(z, pressAt, dx, ly, dw, ih, n, fo, now, acc, compact := 0) {
    if (n < 2)
        return
    hv := Ease3(HL.h.Get(z, 0.0))
    pr := pressAt ? Clamp(1 - (now - pressAt)/320.0, 0.0, 1.0) : 0.0
    if (hv < 0.004 && pr < 0.004)
        return
    e := Max(hv, pr)
    rad := compact ? 8 : 10
    ; ---- inside the caller's clip, not instead of it ----
    ; This used to REPLACE the clip with the banner's rectangle (mode 0) and
    ; reset it on the way out. On the saved-place panel that was harmless. In
    ; the community panel the banner and the thumbnails scroll inside a body
    ; clip, and a replaced clip let the scrim, the plate and the ring paint
    ; over the part of a half-scrolled banner that the panel had already cut
    ; away - the one thing on that page that did not scroll like the rest.
    ; Intersect (mode 1) keeps the body's cut; the saved state puts it back.
    pC := RRPath(dx, ly, dw, ih, rad)
    stC := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC, "int", 1)
    ; Scrim: theme-PRESERVING. It sits on a Roblox thumbnail, which looks the
    ; same in both themes, and 0x05060C is dark enough that THLight flips it to
    ; near-white - which turned the dimming wash into a brightening one.
    b := SBrushP(ElA(FA(Alpha(0x05060C, Round(120*hv + 60*pr)), fo)))
    FillRR(dx, ly, dw, ih, rad, b), DelB(b)

    cx := dx + dw/2, cy := ly + ih/2 - (compact ? 0 : 6)
    ; the plate scales in from slightly small, and kicks on a press
    sc := 0.88 + 0.12*Ease3(hv) + 0.06*pr
    st := PushXform(cx, cy + (compact ? 0 : 6), sc, 0)
    pw2 := compact ? 46 : 96, ph2 := compact ? 24 : 30
    ; Plate: 0x10131F, not pure black. Black is the one value THLight passes
    ; through untouched, so the plate stayed black on paper while the glyph and
    ; the label - which go through AccHi - correctly darkened, leaving dark ink
    ; on a dark pill. 0x10131F is in the theme map and becomes white.
    b := SBrush(FA(Alpha(0x10131F, Round(150*e)), fo))
    FillRR(cx - pw2/2, cy - ph2/2, pw2, ph2, ph2/2, b), DelB(b)
    pn := Pen(FA(Alpha(acc, Round(150*e)), fo), 1.2)
    StrokeRR(cx - pw2/2, cy - ph2/2, pw2, ph2, ph2/2, pn), DelP(pn)

    ; ---- skip glyph: a double chevron running into a bar ----
    ; The ink has to invert with the plate. On the dark plate AccHi brightens
    ; the accent, which is right; on the white one it only reaches mid-tone
    ; (~2.8:1), and pushing AccHi harder collapses every accent to the same
    ; grey because its target IS a grey. So paper mixes toward near-black
    ; instead, which keeps the hue: 5.2:1 with 54 of chroma still in it.
    ink := (thT > 0.5) ? Mix(acc, 0xFF23242B, 0.55) : AccHi(acc, 0.45)
    gx := compact ? cx - 6 : cx - 30, gy := cy   ; centred alone, or left of the word
    pn := Pen(FA(Alpha(ink, Round(235*e)), fo), compact ? 1.6 : 1.8)
    loop 2 {
        i := A_Index
        ; the two chevrons chase each other rightwards, the second trailing
        ph := Clamp(Sin(DecT(now)*0.005 - (i - 1)*0.7), 0.0, 1.0)
        ox := gx + (i - 1)*6 + ph*2.2
        Line(ox - 3, gy - 5, ox + 2, gy, pn)
        Line(ox + 2, gy, ox - 3, gy + 5, pn)
    }
    Line(gx + 11, gy - 5.5, gx + 11, gy + 5.5, pn), DelP(pn)

    if !compact
        Txt("SKIP", cx - 8, cy - 8, 44, 16, fBadge
            , FA(Alpha(ink, Round(240*e)), fo), fmtL)
    Pop(st)

    ; a ring pushing outward on the press, so the click is acknowledged even
    ; though the picture behind it takes a moment to change
    if (pr > 0.01) {
        ex := (1 - pr)*(compact ? 14 : 26)
        pn := Pen(FA(Alpha(acc, Round(170*pr)), fo), 1.6*pr + 0.3)
        StrokeRR(cx - pw2/2 - ex, cy - ph2/2 - ex*0.6, pw2 + ex*2, ph2 + ex*1.2, ph2/2 + ex*0.3, pn), DelP(pn)
    }
    Pop(stC)
    DllCall("gdiplus\GdipDeletePath", "ptr", pC)
}

; ---- banner position indicator ----
; Sits in the banner's top-right rather than the bottom, where the scrim and
; the game name already live. The active pip stretches into a pill and fills
; as its dwell runs down, so the reel reads as timed rather than random - and
; a single-banner game gets nothing at all instead of one lonely dot.
SPFBannerDots(dx, ly, dw, ih, n, fo, now, acc) {
    if (n < 2)
        return
    n := Min(n, 10)
    dr := 3.0, gp := 7, aw := 16                 ; pip radius, gap, active width
    ; Total is the sum of the pip WIDTHS plus the gaps between them: one pip is
    ; the wide active pill, the rest are dots. Across a crossfade the active
    ; pill hands its width to the incoming pip, so the two always sum to
    ; aw + dr*2 and this total stays fixed - nothing reflows mid-transition.
    tot := aw + (n - 1)*(dr*2 + gp)
    bx0 := dx + dw - 12 - tot
    by0 := ly + 12
    ; a soft plate, so the pips read on a bright banner as well as a dark one
    b := SBrush(FA(Alpha(0x000000, 92), fo))
    FillRR(bx0 - 7, by0 - dr - 5, tot + 14, dr*2 + 10, (dr*2 + 10)/2, b), DelB(b)
    cx0 := bx0
    loop n {
        k := A_Index
        act := (k = SPF.bnI)
        nxt := (SPF.bnFadeAt && k = SPF.bnNext)
        ; the active pip hands its width to the incoming one across the fade,
        ; so nothing jumps at the moment the two swap
        t := SPF.bnFadeAt ? Clamp(Ease3((now - SPF.bnFadeAt)/SPF_BN_FADE), 0.0, 1.0) : 0.0
        gw := act ? (aw*(1 - t) + dr*2*t) : nxt ? (dr*2*(1 - t) + aw*t) : dr*2
        al := act ? (215*(1 - t) + 90*t) : nxt ? (90*(1 - t) + 215*t) : 90
        b := SBrush(FA(Alpha(0xFFFFFF, Round(al*0.42)), fo))
        FillRR(cx0, by0 - dr, gw, dr*2, dr, b), DelB(b)
        if (act || nxt) {
            ; dwell readout: fills left to right over the hold, then holds full
            ; through the crossfade so it never rewinds mid-transition
            pr := act ? (SPF.bnFadeAt ? 1.0 : Clamp((now - SPF.bnAt)/(SPF_BN_HOLD + 0.0), 0.0, 1.0)) : t
            if (pr > 0.01) {
                b := SBrush(FA(Alpha(AccHi(acc, 0.45), Round(al)), fo))
                FillRR(cx0, by0 - dr, Max(gw*pr, dr*2), dr*2, dr, b), DelB(b)
            }
        }
        cx0 += gw + gp
    }
}

; ---- stat glyphs ----
SPFStatGlyph(kind, cx, cy, col) {
    pn := Pen(col, 1.4)
    if (kind = 1) {                              ; player
        Ell(cx - 3, cy - 6, 6, 6, pn)
        Arc(cx - 5, cy - 1, 10, 10, 200, 140, pn)
    } else if (kind = 2) {                       ; eye
        Arc(cx - 6, cy - 5, 12, 10, 200, 140, pn)
        Arc(cx - 6, cy - 5, 12, 10, 20, 140, pn)
        b := SBrush(col)
        FillEll(cx - 1.6, cy - 1.6, 3.2, 3.2, b), DelB(b)
    } else {                                     ; thumb up / down
        up := (kind = 3)
        sy3 := up ? 1 : -1
        Line(cx - 5, cy + 5*sy3, cx - 5, cy - 1*sy3, pn)
        Line(cx - 5, cy - 1*sy3, cx - 1, cy - 1*sy3, pn)
        Line(cx - 1, cy - 1*sy3, cx - 1, cy - 6*sy3, pn)
        Line(cx - 1, cy - 6*sy3, cx + 2, cy - 6*sy3, pn)
        Line(cx + 2, cy - 6*sy3, cx + 5, cy - 1*sy3, pn)
        Line(cx + 5, cy - 1*sy3, cx + 5, cy + 5*sy3, pn)
        Line(cx + 5, cy + 5*sy3, cx - 5, cy + 5*sy3, pn)
    }
    DelP(pn)
}

; ---- add-by-id sheet ----
; Geometry lives here so the renderer, the hit test and the ScrFld* helpers
; cannot drift. They had: the helpers put the text origin 15px right of where
; it was drawn and the window 30px narrower, so every click and drag landed on
; the wrong character.
SPFAddGeom(&sx, &sy, &sw, &shh) {
    ; Vertical budget, all relative to sy. Text is centred in its rect
    ; (LineAlign = 1), so what matters is centre-to-centre, not rect edges.
    ;    12  title            rect h18, centre 21
    ;    32  subtitle         rect h14, centre 39
    ;    48  field 1 label    rect h13, centre 54   <- 15 clear of the subtitle
    ;    64  field 1 box      h26, ends 90
    ;   100  field 2 label    rect h13            (private tab only)
    ;   116  field 2 box      h26, ends 142
    ;    94 / 146  error line
    ;   shh-40  buttons       h26, 14 of padding under them
    ; The first label used to sit at 38, six pixels into the subtitle's ink.
    ; Everything below it moved down to keep its own clearance, which is why
    ; both heights grew with it.
    sw := 310, shh := (SPF.savTab = 2) ? 210 : 156
    sx := HL.ctx + HL.ctw/2 - sw/2
    sy := (HL.cty + 30) + 414/2 - shh/2
}
SPFAddFldY(which) {
    SPFAddGeom(&sx, &sy, &sw, &shh)
    return (which = 2) ? sy + 116 : sy + 64
}
SPFAddFldX() {
    SPFAddGeom(&sx, &sy, &sw, &shh)
    return sx + 30                               ; box at sx+20, text inset 10
}
SPFAddFldW() {
    SPFAddGeom(&sx, &sy, &sw, &shh)
    return sw - 60                               ; box width sw-40, less inset
}
; A small modal over the library. Eased in on its own curve so it reads as
; landing on top of the view rather than being part of it.
SPFAddSheet(x, y, w, h, fo, now, acc) {
    SPF.addT += ((SPF.addOpen ? 1.0 : 0.0) - SPF.addT)*EK(0.3)
    if (!SPF.addOpen && SPF.addT < 0.004)
        SPF.addT := 0.0
    if (SPF.addT <= 0.004)
        return
    e := Ease3(Clamp(SPF.addT, 0.0, 1.0))
    ; Centred on the rect the caller handed us, not on SPFAddGeom's resting
    ; numbers. SPFAddGeom is built from HL.ctx/HL.cty and stays where the page
    ; sits at rest, which is right for hit-testing and wrong for drawing: the
    ; sheet would hang still while the view underneath it slid.
    SPFAddGeom(&sxG, &syG, &sw, &shh)
    sx := x + w/2 - sw/2
    sy := y + 414/2 - shh/2
    sdy := sy - syG                       ; how far this frame is off the resting spot
    fsh := fo*e                                 ; NOT 'fa' - AHK names are
                                                 ; case-insensitive and FA() is a function

    b := SBrush(FA(Alpha(0x06070E, Round(180*e)), fo))
    FillRR(x, y, w, h, 12, b), DelB(b)

    sts := PushXform(sx + sw/2, sy + shh/2, 0.9 + 0.1*e, 0)
    ShadowDraw(sx, sy + 4, sw, shh, 14, 6, 18, 18, fsh, HL.k)
    b := VBrush(sx, sy, sw, shh, FA(0xFF1B2038, fsh), FA(0xFF10121C, fsh))
    FillRR(sx, sy, sw, shh, 12, b), DelB(b)
    MiniBackdrop(sx, sy, sw, shh, 12, acc, fsh, now, 0.85)
    pn := Pen(FA(Alpha(acc, 170), fsh), 1.3)
    StrokeRR(sx, sy, sw, shh, 12, pn), DelP(pn)
    ; corner ticks
    loop 4 {
        k := A_Index - 1
        cxk := (k = 1 || k = 2) ? sx + sw - 20 : sx
        cyk := (k >= 2) ? sy + shh - 20 : sy
        ang := k = 0 ? 195 : k = 1 ? 285 : k = 2 ? 15 : 105
        pn := Pen(FA(Alpha(acc, 90), fsh), 1.4)
        Arc(cxk, cyk, 20, 20, ang, 60, pn), DelP(pn)
    }
    b := SBrush(FA(Alpha(acc, 210), fsh))
    FillRR(sx, sy + 12, 3, 18, 1.5, b), DelB(b)
    Txt(SPF.savTab = 2 ? "ADD A PRIVATE SERVER" : "ADD A PLACE", sx + 16, sy + 12, 240, 18
        , fBadge, FA(Alpha(0xFFE8EAF6, 235), fsh), fmtL)
    Txt(SPF.savTab = 2 ? "the place id lets it resolve the game" : "paste a game link or type the place id"
        , sx + 16, sy + 32, sw - 32, 14, HL.fXs
        , FA(0x72C7CBE0, fsh), fmtL)

    ; ---- fields ----
    ; Private servers need the place id as well as the link. Asking for it is
    ; the only reliable way: a share link contains no place id, so without it
    ; the entry can never resolve a name, icon or stats.
    two := (SPF.savTab = 2)
    loop (two ? 2 : 1) {
        fi  := A_Index
        fcs := (fi = 1) ? 8 : 9
        foc := (SH.focus = fcs)
        hvF := HL.h.Get(fi = 1 ? 1006 : 1009, 0.0)
        ; SPFAddFldY is the resting y, so shift it by the same amount the
        ; sheet itself moved this frame
        fx  := sx + 20, fy := SPFAddFldY(fi) + sdy, fw := sw - 40
        val := (fi = 1) ? SPF.addTxt : SPF.addLink
        Txt(fi = 1 ? "PLACE ID" : "PRIVATE SERVER LINK", fx, fy - 16, fw, 13, HL.fXs
            , FA(Alpha(0xFFC7CBE0, 140), fsh), fmtL)
        b := SBrush(FA(Mix(0xFF141728, 0xFF1B2038, Max(hvF, foc*1.0)), fsh))
        FillRR(fx, fy, fw, 26, 7, b), DelB(b)
        MicroBackdrop(fx, fy, fw, 26, 7, acc, fsh, now, 0.75)
        pn := Pen(FA(Alpha(SPF.addErr != "" ? C_BAD : (foc ? acc : 0xFFFFFF)
                         , SPF.addErr != "" ? 190 : (foc ? 190 : 30 + 50*hvF)), fsh), 1)
        StrokeRR(fx, fy, fw, 26, 7, pn), DelP(pn)
        if foc {
            b := SBrush(FA(Alpha(acc, 210), fsh))
            FillRR(fx, fy + 6, 2.6, 14, 1.3, b), DelB(b)
        }
        vv := FldWindow(val, foc ? SH.fCar : StrLen(val), fHint, fw - 20, &vo)
        if (foc && SH.fSel >= 0 && SH.fSel != SH.fCar) {
            sa := Max(Min(SH.fSel, SH.fCar) - vo, 0)
            sb := Min(Max(SH.fSel, SH.fCar) - vo, StrLen(vv))
            if (sb > sa) {
                xa := MeasureW(SubStr(vv, 1, sa), fHint)
                xb := MeasureW(SubStr(vv, 1, sb), fHint)
                b := SBrush(FA(Alpha(acc, 64), fsh))
                FillRR(fx + 10 + xa, fy + 5, xb - xa, 16, 3, b), DelB(b)
            }
        }
        if (vv = "")
            Txt(fi = 1 ? "e.g. 5938036553" : "paste the link or share link"
                , fx + 10, fy + 5, fw - 20, 16, fHint, FA(0x58C7CBE0, fsh), fmtL)
        else
            Txt(vv, fx + 10, fy + 5, fw - 20, 16, fHint, FA(Alpha(0xFFE8EAF6, 235), fsh), fmtL)
        if (foc && Mod(A_TickCount - SH.caretAt, 1060) < 530) {
            ccx := fx + 10 + MeasureW(SubStr(vv, 1, SH.fCar - vo), fHint)
            b := SBrush(FA(Alpha(0xFFFFFF, 225), fsh))
            FillRR(ccx, fy + 5, 1.6, 16, 0.8, b), DelB(b)
        }
    }
    if (SPF.addErr != "")
        Txt(SPF.addErr, sx + 20, sy + (two ? 146 : 94), sw - 40, 14, HL.fXs
          , FA(Alpha(C_BAD, 215), fsh), fmtL)

    FFMBtn(1005, sx + 20, sy + shh - 40, 124, 26, "CANCEL", 0xFFC7CBE0, fsh, 0)
    FFMBtn(1004, sx + sw - 144, sy + shh - 40, 124, 26, "ADD", acc, fsh
         , (RegExMatch(SPF.addTxt, "\d{5,}")
         && (SPF.savTab != 2 || SPF.addLink != "")) ? 1 : 0)
    Pop(sts)
}

SPFSavZone(ux, uy) {
    x := HL.ctx, y := HL.cty + 30, w := HL.ctw, h := 414
    ; Tested before the add sheet and before the list: a modal owns every pixel
    ; until it closes, the same contract SPFAddSheet has.
    if (SPF.renOpen) {
        SPFRenGeom(&sx, &sy, &sw, &shh)
        if (ux >= sx + 20 && ux <= sx + sw - 20
            && uy >= SPFRenFldY() && uy <= SPFRenFldY() + 26)
            return 1013
        if (uy >= sy + shh - 40 && uy <= sy + shh - 14) {
            if (ux >= sx + 20 && ux <= sx + 20 + 124)
                return 1014
            if (ux >= sx + sw - 144 && ux <= sx + sw - 20)
                return 1015
        }
        return 1016                              ; the sheet swallows the rest
    }
    if (SPF.addOpen) {
        SPFAddGeom(&sx, &sy, &sw, &shh)
        if (ux >= sx + 20 && ux <= sx + sw - 20) {
            if (uy >= SPFAddFldY(1) && uy <= SPFAddFldY(1) + 26)
                return 1006
            if (SPF.savTab = 2 && uy >= SPFAddFldY(2) && uy <= SPFAddFldY(2) + 26)
                return 1009
        }
        if (uy >= sy + shh - 40 && uy <= sy + shh - 14) {
            if (ux >= sx + 20 && ux <= sx + 20 + 124)
                return 1005
            if (ux >= sx + sw - 144 && ux <= sx + sw - 20)
                return 1004
        }
        return 1001                              ; the sheet swallows the rest
    }
    if (ux >= x + w - 32 && ux <= x + w && uy >= y && uy <= y + 28)
        return 990
    if (uy >= y + 8 && uy <= y + 32) {
        tbw := [MeasureW("PLACES", fBadge) + 46, MeasureW("PRIVATE SERVERS", fBadge) + 46]
        tbx := x + 16
        loop 2 {
            if (ux >= tbx - 8 && ux <= tbx + tbw[A_Index])
                return 1006 + A_Index
            tbx += tbw[A_Index] + 18
        }
    }
    if (ux >= x + w - 122 && ux <= x + w - 34 && uy >= y + 8 && uy <= y + 30)
        return 1003
    lx := x + 14, ly := y + 48, lw := 192
    if (ux >= lx && ux <= lx + lw) {
        loop SPFList().Length {
            i := A_Index
            ry := ly + (i - 1)*38
            if (uy >= ry && uy <= ry + 34)
                return 990 + i
        }
        by := ly + 8*38 + 6
        if (uy >= by && uy <= by + 26) {
            if (ux <= lx + 62)
                return 1002
            if (ux >= lx + 65 && ux <= lx + 127)
                return 1000
            if (ux >= lx + 130)
                return 999
        }
        ; private servers only - mirrors the button, which is only drawn there
        if (SPF.savTab = 2 && uy >= by + 28 && uy <= by + 52)
            return 1012
    }
    ; the banner itself advances the carousel - geometry mirrors the renderer
    dxz := x + 228, dwz := w - 242, ihz := Round(dwz*9/16)
    if (ux >= dxz && ux <= dxz + dwz && uy >= ly && uy <= ly + ihz)
        return 1010
    ; inert catch-all so the overlay is not click-through
    if (ux >= x && ux <= x + w && uy >= y && uy <= y + h)
        return 1001
    return 0
}

; ---- live status strip -----------------------------------------------------
; Everything below the systems panel: what Roblox is doing, where the server
; is, and whether Discord actually took the presence. Each field animates in
; on the same stagger as the rows above so the block reads top-down.
SPFLive(px, py, pw, ff, now, acc, mt) {
    global spfDiscord, spfRegion, spfMatch, spfOdds
    cg := Clamp((mt - 0.52)/0.4, 0.0, 1.0)
    if (cg <= 0.01)
        return
    fb := ff*cg
    ; 112, not 124: at 18px rows the strip ended 6px from the card edge and
    ; read as touching it, the corner radius alone being 12.
    ; 96, not 104: the panel above needs the height so its last field is not
    ; sitting on the rounded border, and the strip still has to clear the
    ; version stamp in the card's bottom corner.
    ph := 96
    sld := (1 - cg)*12

    b := VBrush(px, py, pw, ph, FA(Mix(0xFF141728, 0xFF1B2038, 0.5), fb), FA(0xFF10121C, fb))
    FillRR(px, py, pw, ph, 12, b), DelB(b)
    MiniBackdrop(px, py, pw, ph, 12, acc, fb, now, 0.85)
    pn := Pen(FA(Alpha(acc, 60 + 40*mt), fb), 1.2)
    StrokeRR(px, py, pw, ph, 12, pn), DelP(pn)

    pClip := RRPath(px, py, pw, ph, 12)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pClip, "int", 0)

    ; a slow scan band, and a ripple whenever the state actually changed
    live := (spfDiscord || spfRegion || spfOdds)
    if live {
        by := py + Mod(DecT(now)*0.035, ph + 40) - 20
        b := VBrush(px, by, pw, 16, Alpha(0xFFFFFF, 0), FA(Alpha(acc, 20), fb))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", px, "float", by, "float", pw, "float", 16), DelB(b)
    }
    if (SPF.pulse && now - SPF.pulse < 900) {
        e := (now - SPF.pulse)/900.0
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(150*(1 - e))), fb), 2.0*(1 - e) + 0.3)
        ex := 2 + e*26
        StrokeRR(px - ex, py - ex, pw + ex*2, ph + ex*2, 12 + ex*0.4, pn), DelP(pn)
    }

    Txt("LIVE", px + 16 + sld, py + 8, 80, 14, fBadge, FA(0x72C7CBE0, fb), fmtL)
    ; a breathing dot: green in a game, amber armed but waiting, grey when off
    dCol := (!live || SPFMultiBlock()) ? 0xFF6E7590 : SPF.inGame ? C_ON : AMBER
    dPh  := (Sin(DecT(now)*0.0038) + 1)/2
    b := SBrush(FA(Alpha(dCol, Round(120 + 110*dPh)), fb))
    FillEll(px + 52 + sld, py + 13, 6, 6, b), DelB(b)

    ; ---- game ----
    ; Several clients open means the log folder cannot be attributed to any one
    ; of them, so the panel says so rather than guessing.
    multi := SPFMultiBlock()
    gTxt := multi ? "off - several roblox clients open"
          : SPF.inGame ? (SPF.gameNm != "" ? SPF.gameNm
                         : SPF.place != "" ? "place " SPF.place
                                           : "in a game - resolving...")
                       : (live ? "no roblox game detected" : "features are off")
    Txt("GAME", px + 16 + sld, py + 26, 70, 13, HL.fXs, FA(0x62C7CBE0, fb), fmtL)
    gw2 := pw - 180
    Txt(FFMElide(gTxt, fHint, gw2 - 96), px + 84 + sld, py + 26, gw2 - 96, 14, fHint
        , FA(Alpha(SPF.inGame ? 0xFFE8EAF6 : 0xFF9AA8C0, 215), fb), fmtL)
    ; the id rides the same line - dropping a whole row is what keeps the strip
    ; clear of the version stamp in the card's bottom corner
    iTxt := SPF.place != "" ? ("id " SPF.place) : ""
    if (iTxt != "")
        Txt(iTxt, px + 84 + sld + gw2 - 92, py + 26, 92, 14, HL.fXs
            , FA(Alpha(0xFFC7CBE0, 150), fb), fmtR)

    ; ---- region ----
    rTxt := SPFRegionWhy()
    Txt("REGION", px + 16 + sld, py + 42, 70, 13, HL.fXs, FA(0x62C7CBE0, fb), fmtL)
    known := (spfRegion && SPF.region != "")
    Txt(FFMElide(rTxt, fHint, pw - 180), px + 84 + sld, py + 42, pw - 180, 14, fHint
        , FA(Alpha(known ? AccHi(acc, 0.45) : 0xFF9AA8C0, known ? 235 : 190), fb), fmtL)
    if (spfRegion && SPF.inGame && SPF.region = "") {
        ; three dots chasing while the lookup is out
        loop 3 {
            k := A_Index
            a3 := Max(0.0, Sin(DecT(now)*0.006 - k*0.7))
            b := SBrush(FA(Alpha(acc, Round(60 + 150*a3)), fb))
            FillEll(px + 152 + sld + k*8, py + 48, 3.4, 3.4, b), DelB(b)
        }
    }

    ; ---- discord link ----
    dTxt := !spfDiscord    ? "off"
          : SPF.dc = 2     ? "linked"
          : SPF.dc = 3     ? (SPF.dcErr != "" ? SPF.dcErr : "unavailable")
          : "connecting..."
    dcCol := !spfDiscord ? 0xFF9AA8C0 : SPF.dc = 2 ? C_ON : SPF.dc = 3 ? AMBER : 0xFFC7CBE0
    ; ---- home region / matchmaking ----
    hTxt := (!spfMatch && !spfOdds) ? "off"
          : SPF.homeRegion = ""     ? "locating you..."
          : SPF.mmNote != ""        ? (SPF.homeRegion "  -  " SPF.mmNote)
                                    : SPF.homeRegion
    Txt("HOME", px + 16 + sld, py + 58, 70, 13, HL.fXs, FA(0x62C7CBE0, fb), fmtL)
    mmc := (!spfMatch && !spfOdds) ? 0xFF9AA8C0 : SPFMatchOK() ? C_ON
         : (SPF.mmTries ? AMBER : 0xFFC7CBE0)
    Txt(FFMElide(hTxt, fHint, pw - 180), px + 84 + sld, py + 58, pw - 180, 14, fHint
        , FA(Alpha(mmc, 215), fb), fmtL)

    Txt("DISCORD", px + 16 + sld, py + 74, 70, 13, HL.fXs, FA(0x62C7CBE0, fb), fmtL)
    ; the RPC pill is the only thing to the right of this line, so give the
    ; error text everything up to it - a truncated diagnostic is useless
    dcw := (SPF.dc = 2 || !spfDiscord) ? pw - 180 : pw - 108
    Txt(FFMElide(dTxt, fHint, dcw), px + 84 + sld, py + 74, dcw, 14, fHint
        , FA(Alpha(dcCol, 220), fb), fmtL)

    ; right edge: a small link pill that fills as the state firms up
    lx := px + pw - 92 + sld, ly := py + 69
    lf := (SPF.dc = 2) ? 1.0 : (SPF.dc = 3) ? 0.0 : 0.5
    b := SBrush(FA(Alpha(0xFFFFFF, 12), fb))
    FillRR(lx, ly, 76, 18, 9, b), DelB(b)
    MicroBackdrop(lx, ly, 76, 18, 9, acc, fb, now, 0.8)
    if (lf > 0.01) {
        b := VBrush(lx, ly, 76*lf, 18, FA(Alpha(AccHi(dcCol, 0.3), 130), fb)
                  , FA(Alpha(dcCol, 90), fb))
        FillRR(lx, ly, 76*lf, 18, 9, b), DelB(b)
    }
    pn := Pen(FA(Alpha(dcCol, 120), fb), 1)
    StrokeRR(lx, ly, 76, 18, 9, pn), DelP(pn)
    Txt(spfDiscord ? (SPF.dc = 2 ? "RPC LINKED" : SPF.dc = 3 ? "NO LINK" : "LINKING") : "IDLE"
        , lx, ly + 2, 76, 14, HL.fXs, FA(Alpha(dcCol, 225), fb), fmtC)

    ; module message line, same convention as the cursor module's
    if (SPF.msgAt && now - SPF.msgAt < 4200) {
        mf := 1 - Clamp((now - SPF.msgAt - 3200)/1000.0, 0.0, 1.0)
        Txt(SPF.msg, px + pw - 300 + sld, py + 8, 288, 16, HL.fXs
            , FA(Alpha((SPF.msgCol = C_ACC) ? acc : SPF.msgCol, 215), fb*mf), fmtR)
    }

    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", pClip)
}

; ============================================================================
;  CLIENT SETTINGS  -  built-in module 4
;  A front end over the two places Roblox keeps client configuration:
;
;    Fast Flags  ->  staged through the FAST FLAG MANAGER's own store, so the
;                    writer, the injector and the ClientAppSettings file are
;                    all the existing ones. Nothing here writes flags itself.
;    GlobalBasicSettings_13.xml -> the client's own settings file, edited in
;                    place. Only values that ALREADY exist in the file are
;                    touched; nothing is invented, so a build that renamed or
;                    dropped a property just shows that row as unavailable
;                    instead of corrupting the file.
;
;  One master switch applies or reverts the whole module. Applying stages the
;  flags and rewrites the XML (after copying the original aside once);
;  reverting unstages exactly the flags this module added and restores the XML
;  from that copy, so it can never strand a value the user did not choose.
;
;  Roblox has allowlisted which Fast Flags a local ClientAppSettings.json may
;  set (Sept 2025). Anything outside the allowlist still lands through the
;  FAST FLAG MANAGER's live injection, which writes process memory instead.
; ============================================================================
global RSET := {}
RSET.on      := 0                  ; master switch state
RSET.msg     := "NOT APPLIED", RSET.msgCol := 0xFFC7CBE0, RSET.msgAt := 0
RSET.scr     := 0.0, RSET.scrT := 0.0
RSET.pick    := Map()              ; option key -> chosen index
RSET.flashAt := Map()              ; option key -> tick of last change
RSET.onT     := 0.0                ; eased master-switch state
RSET.applyAt := 0
; ---- what APPLY pushed into the RUNNING client, so REVERT can take it back --
; APPLY writes the framerate cap into process memory as well as into the file
; (see RSetFpsLive). Nothing recorded what the client held beforehand, so
; REVERT cleaned the file and left the live client running on the cap it had
; just reported as gone. fpsWas is that record, keyed by the pid it came from.
RSET.fpsWas  := Map()              ; flag name -> value the client held before us
RSET.fpsWasP := 0                  ; the pid that snapshot belongs to
; ---- which files APPLY actually overwrote - see RSetBakLog ----
RSET.bakLog  := Map()              ; backup path -> {kind, orig}
RSET.xmlPath := "", RSET.xmlAt := 0
RSET.dd      := 0, RSET.ddT := 0.0, RSET.ddAt := 0, RSET.ddPrev := 0
RSET.ddTop   := 0                  ; first visible entry when a list is clipped
RSET.sld     := 0                  ; slider row being dragged
RSET.font    := "", RSET.pickPid := 0
RSET.logo    := ""                         ; user's replacement logo image
; The scan walks the whole texture tree, so the LIST is cached, not just its
; length - the row hint, the preview and the detail sheet all want it and all
; three run per frame.
; one cache per app - Player and Studio install into separate version folders
RSET.logoTg  := 0, RSET.logoTgS := 0, RSET.logoAt := 0
; ---- the raw flag layer ----
; The 21 preset rows own 24 flag names between them and there was no way to
; write anything else into ClientAppSettings.json from the hub. RSET.extra is
; that layer: a plain name -> value map merged into RSetFlags LAST, so a row and
; an extra naming the same flag resolve in the user's favour rather than fighting
; over the key. Presets stay presets; this is the escape hatch beside them.
RSET.extra   := Map()
RSET.fx      := 0                  ; 1 while the editor page is up
RSET.fxT     := 0.0                ; eased, so the page cross-fades with the rows
RSET.fxAt    := 0                  ; when it opened or closed, for the entrance
RSET.fxScr   := 0.0                ; the page has its OWN scroll - returning to
RSET.fxScrT  := 0.0                ; the rows must not land somewhere new
RSET.fxSel   := ""                 ; the extra being edited, by name
RSET.fxName  := ""                 ; the add field's pending name
RSET.fxVal   := ""                 ; the add field's pending value
RSET.fxAddAt := 0, RSET.fxDelAt := 0, RSET.fxFlash := Map()
; Bumped by anything that changes what the flag list would contain - an extra
; added, removed or edited, and any row pick, since a picked row is what puts
; preset pairs in the list. RSetFxList's memo watches it. See RSetFxBump.
RSET.fxVer   := 0
; ---- the whitelist database, the page's second body ----
; Same shape as the FAST FLAG MANAGER's: a search field over a scrolling list of
; names. The difference is the source. FFM pulls every flag name Roblox has ever
; shipped off a tracker repo; this one lists only the names this module knows
; Roblox will actually honour out of ClientAppSettings.json, which is the set
; worth typing into a file that Roblox filters.
RSET.db      := 0                  ; 1 while the database body is up
RSET.dbAt    := 0                  ; when it opened or closed, for the crossfade
RSET.dbScr   := 0.0, RSET.dbScrT := 0.0
RSET.dbIns   := Map()              ; flag name -> tick it was taken
RSET.landAt  := 0                  ; when a database name landed in the field
RSET.dbQ     := ""                 ; the filter
RSET.dbCacheQ := "`f", RSET.dbCache := 0
; name -> {at, v, own} for rows that have been removed and are still collapsing.
; Held here rather than left in RSET.extra so the store and the ini are correct
; the instant the X is pressed; only the DRAWING lags.
RSET.fxGone  := Map()
; ---- which field has the caret, and which one just lost it ----
; One field can be focused at a time, so one eased clock covers both halves of
; the change: the arriving field rides it up, the leaving field rides it down.
; Keyed by IDENTITY, not by zone - a row's zone is its position in the list, and
; taking a row over adds several overrides at once, which moves everything.
RSET.focKey  := ""                 ; "rfn" / "rfv" / "rfd", or the flag's name
RSET.focOut  := ""                 ; the one fading out
RSET.focAt   := 0
; ---- FLAG SOURCE ----
; srcOn is the row's switch: 0 merges both halves (the default and the old
; behaviour), 1 hands the file to one of them. srcPick says which - 1 the client
; systems rows, 2 the EDIT FAST FLAGS overrides. Both persist.
RSET.srcT    := 0.0                ; eased switch
RSET.srcSelT := 1.0                ; eased segment position
RSET.srcAt   := 0
; The file the user pointed at, stored RELATIVE to content\textures so it
; applies to every installed version and to the Bloxstrap mirror. "" means fall
; back to the name pattern.
RSET.logoSub := "", RSET.logoSubS := ""
RSET.icoOrig := Map()                      ; .lnk path -> its previous IconLocation
RSET.logoBmp := 0, RSET.logoBw := 0, RSET.logoBh := 0   ; decoded preview - player
RSET.logoS   := ""                         ; studio's own replacement image
RSET.logoSBmp := 0, RSET.logoSBw := 0, RSET.logoSBh := 0
; Roblox's OWN logo for each app, so an empty slot shows what is actually there
; now rather than a blank square. Same idea as the cursor tiles' dbmp: a backup
; where one is held is the untouched original, otherwise the live file.
RSET.logoDef  := [0, 0], RSET.logoDefW := [0, 0], RSET.logoDefH := [0, 0]
RSET.logoDefP := ["", ""]                  ; path each was decoded from
; Both of these walk the filesystem and both are read from the row renderer,
; which runs every frame - so they are cached. RSetLnkTargets in particular
; recurses the desktop, both Start menus and the taskbar pins, and doing that
; sixty times a second would have been the most expensive thing in the hub.
RSET.appExe  := ["", ""], RSET.appExeAt := 0
RSET.lnkTg   := [0, 0],   RSET.lnkTgAt  := 0
RSET.preset  := 0, RSET.presetAt := 0      ; last preset pressed, for the flash
RSET.xmlHave := Map()              ; xml property -> current value in the file
RSET.wrCut   := 0                  ; names the last REVERT removed from the client files
RSET.paths   := [], RSET.pathsAt := 0   ; RSetAppSettingsPaths, memoised for the state card

global RSET_SEPH  := 26            ; gap opened wherever the row group changes

; ---------------------------------------------------------------------------
;  Option table. `f` holds one flag Map per choice (an empty Map means "leave
;  Roblox alone"), `x` one XML value per choice. grp 1 = rendering (flags),
;  grp 2 = client file (xml). Order here IS the row order.
; ---------------------------------------------------------------------------
; ---------------------------------------------------------------------------
;  Option table. `f` holds one flag Map per choice (an empty Map means "leave
;  Roblox alone"), `x` one XML value per choice; index 1 is always the
;  leave-alone choice. `ui` picks the control: "drop" is a dropdown, "slider"
;  a track, "file" a file picker. Sliders are generated below rather than
;  spelled out - a 31-step array by hand is unreadable, and every step still
;  lands in the same v/f/x shape the apply path already understands.
;  grp 1 = client files (flags + fonts), grp 2 = the client's settings XML.
;  Order here IS the row order.
; ---------------------------------------------------------------------------
RSetOptions() {
    o := []
    ; The header button is easy to miss, so the two things that actually reach
    ; Roblox get their own rows at the very top of the list, where the user is
    ; already looking. grp 0 keeps them out of the flag and XML passes.
    o.Push({k: "apply", n: "APPLY SETTINGS", h: "close roblox first - the client file is only writable then"
          , grp: 0, ui: "action", al: 1, v: ["APPLY"], f: [Map()]})
    o.Push({k: "revert", n: "REVERT SETTINGS", h: "put every setting back to the roblox default"
          , grp: 0, ui: "action", al: 1, v: ["REVERT"], f: [Map()]})
    ; Three chips rather than a dropdown: a preset is a shortcut, and a shortcut
    ; that takes two clicks and a popup is not one. `ui: "preset"` is its own
    ; control type - it sets the rows BELOW it rather than carrying a value of
    ; its own, so RSetIdx/RSetChosen never see it as a chosen row.
    o.Push({k: "preset", n: "QUALITY PRESET", h: "set every graphics row at once"
          , grp: 0, ui: "preset", al: 1, v: ["HIGH", "MEDIUM", "LOW"], f: [Map()]})

    ; Matches Fishstrap's rendering-mode table. Vulkan and OpenGL are NOT
    ; enough on their own: Windows clients prefer D3D11, so the preference flag
    ; is ignored unless FFlagDebugGraphicsDisableDirect3D11 turns D3D11 off as
    ; well. Leaving that out is why "Vulkan" appears to do nothing.
    o.Push({k: "render", n: "RENDERING MODE", h: "which graphics api the client asks for", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "D3D11", "VULKAN", "OPENGL"]
        , f: [ Map()
             , Map("FFlagDebugGraphicsPreferD3D11", "True")
             , Map("FFlagDebugGraphicsPreferVulkan", "True"
                 , "FFlagDebugGraphicsDisableDirect3D11", "True")
             , Map("FFlagDebugGraphicsPreferOpenGL", "True"
                 , "FFlagDebugGraphicsDisableDirect3D11", "True") ]})

    ; None of the lighting overrides survived the Sept 2025 allowlist, so the
    ; client ignores them in ClientAppSettings. Left in place because the row
    ; costs nothing and the allowlist moves, but the hint says so, and the
    ; FAST FLAG MANAGER's live injection is the path that still lands them.
    o.Push({k: "light", n: "LIGHTING TECHNOLOGY", h: "voxel is cheapest, future is prettiest", grp: 1, ui: "drop", al: 0
        , v: ["AUTO", "VOXEL", "SHADOWMAP", "FUTURE"]
        , f: [ Map()
             , Map("DFFlagDebugRenderForceTechnologyVoxel", "True")
             , Map("FFlagDebugForceFutureIsBrightPhase2", "True")
             , Map("FFlagDebugForceFutureIsBrightPhase3", "True") ]})

    ; FRM QUALITY - AUTO, then the engine's own 1..21 ladder
    fr := {k: "frm", n: "FRM QUALITY", h: "the engine's own quality ladder, 1 to 21", grp: 1, ui: "slider", al: 1
         , v: ["AUTO"], f: [Map()]}
    loop 21 {
        fr.v.Push(String(A_Index))
        fr.f.Push(Map("DFIntDebugFRMQualityLevelOverride", String(A_Index)))
    }
    o.Push(fr)

    o.Push({k: "tex", n: "TEXTURE QUALITY", h: "0 is flat colour, 3 keeps full detail", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "0", "1", "2", "3"]
        , f: [ Map()
             , Map("DFFlagTextureQualityOverrideEnabled", "True", "DFIntTextureQualityOverride", "0")
             , Map("DFFlagTextureQualityOverrideEnabled", "True", "DFIntTextureQualityOverride", "1")
             , Map("DFFlagTextureQualityOverrideEnabled", "True", "DFIntTextureQualityOverride", "2")
             , Map("DFFlagTextureQualityOverrideEnabled", "True", "DFIntTextureQualityOverride", "3") ]})

    ; ---- MESH QUALITY ----
    ; These four flags are DISTANCES in studs, not quality levels: each is the
    ; range at which meshes and unions drop to the next-lower LOD, in the order
    ; base -> L12 -> L23 -> L34 (L34 the coarsest). The engine reads bigger
    ; numbers as "stay detailed further out", so quality goes UP with distance.
    ;
    ; The earlier build had this exactly backwards - it wrote the menu level
    ; (0..3) straight into the distance flags, so every setting switched meshes
    ; to their lowest LOD within a few studs of the camera, and a higher pick
    ; made it worse. It also wrote *Static, which is not a real flag. That is
    ; the muddy-mesh look; it was the control, not the client.
    ;
    ; The ladder: OFF collapses every distance to 0 (lowest LOD everywhere, the
    ; standard fps trick); AUTO clears the keys so the engine uses its own
    ; ~250/500/750/1000 defaults; the named tiers push the pop-distance further
    ; out, ULTRA far enough that the switch lands in the fog on most maps.
    mq := {k: "mesh", n: "MESH QUALITY", h: "distance meshes keep full detail before dropping LOD", grp: 1, ui: "drop", al: 1
         , v: ["AUTO", "OFF", "LOW", "MEDIUM", "HIGH", "ULTRA"], f: [Map()]}
    ; d0 is the base (high->medium) distance; each further band is offset out,
    ; matching the shape of Roblox's own defaults rather than a flat multiple.
    for d0 in [0, 500, 1000, 2000, 4000] {
        if (d0 = 0)
            mq.f.Push(Map("DFIntCSGLevelOfDetailSwitchingDistance",    "0"
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL12", "0"
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL23", "0"
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL34", "0"))
        else
            mq.f.Push(Map("DFIntCSGLevelOfDetailSwitchingDistance",    String(d0)
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL12", String(d0 + Round(d0*0.5))
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL23", String(d0*2)
                        , "DFIntCSGLevelOfDetailSwitchingDistanceL34", String(d0*3)))
    }
    o.Push(mq)

    ; the sample counts Fishstrap exposes - x1 is "no multisampling", and 8 is
    ; not offered because the client does not honour it
    o.Push({k: "msaa", n: "ANTI-ALIASING", h: "msaa samples - smoother edges, more gpu", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "x1", "x2", "x4"]
        , f: [ Map()
             , Map("FIntDebugForceMSAASamples", "1")
             , Map("FIntDebugForceMSAASamples", "2")
             , Map("FIntDebugForceMSAASamples", "4") ]})

    ; Three things gate the frame rate, and missing any one of them pins you:
    ;   FramerateCap in GlobalBasicSettings is the cap the client actually
    ;     honours - Fishstrap drives it as "Rendering.FramerateCap"
    ;   FFlagGameBasicSettingsFramerateCap5 is what makes the client read that
    ;     field at all; without it the cap is ignored and you sit at 240
    ;   FFlagTaskSchedulerLimitTargetFpsTo2402 clamps the scheduler to 240
    ;     regardless of the target, so it has to be turned off as well
    ; This row therefore carries both an `f` (flags) and an `xml` value, which
    ; is why the write passes key off those fields rather than off `grp`.
    ; A slider in steps of 10, AUTO at the bottom and MAX at the top. 10 to 360
    ; is the useful span - below 10 the client is unusable and above 360 there
    ; is no display to feed - which lands on 38 stops across a 132px track,
    ; about 3.5px each. That is fine to drag because it SNAPS and the readout
    ; names the value the whole time.
    ;
    ; MAX rather than UNCAPPED, because the readout is 46px wide and sits 6px
    ; from the end of the track: an eight-character word overflows leftward
    ; straight into it.
    ;
    ; Note the cost of a fixed 10-step: 144 is not on it. 144Hz panels have to
    ; take 140 or 150. That is inherent to the interval, not an oversight.
    fpsV := ["AUTO"], fpsN := [""]
    loop 36 {
        t2 := String(A_Index*10)
        fpsV.Push(t2), fpsN.Push(t2)
    }
    fpsV.Push("MAX"), fpsN.Push("9999")
    fp2 := {k: "fps", n: "FRAMERATE CAP", h: "the frame rate the client aims for"
          , grp: 1, ui: "slider", al: 1, xml: "FramerateCap", xt: "int", v: fpsV, x: fpsN, f: [Map()]}
    loop fpsN.Length - 1 {
        t2 := fpsN[A_Index + 1]
        fp2.f.Push(Map("DFIntTaskSchedulerTargetFps", t2
                     , "FFlagGameBasicSettingsFramerateCap5", "True"
                     , "FFlagTaskSchedulerLimitTargetFpsTo2402", "False"
                     , "FFlagDebugForce60FpsThrottle", "False"))
    }
    o.Push(fp2)

    o.Push({k: "dpi", n: "DISPLAY SCALING", h: "keep full render quality above 100% scaling", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "PRESERVE"]
        , f: [ Map(), Map("DFFlagDisableDPIScale", "True") ]})

    ; ================= the rest of the graphics stack =================
    ; Everything below is standard in Bloxstrap and Fishstrap and was simply
    ; absent here: the panel could set the renderer, the lighting technology and
    ; the quality ladder, but not shadows, post-processing, grass or wind - the
    ; four things people actually reach for. AUTO is first on every one of them
    ; and writes nothing at all, so a row left alone cannot change the client.

    ; SHADOWS. Two different systems, which is why one row is not enough on its
    ; own: FIntRenderShadowIntensity is the real-time shadow strength, and
    ; DFFlagDebugPauseVoxelizer freezes the voxel lighting that bakes the rest.
    ; OFF does both, which is what "no shadows" means in every strap's preset.
    o.Push({k: "shadow", n: "SHADOWS", h: "real-time and baked shadow rendering", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "SOFTER", "OFF"]
        , f: [ Map()
             , Map("FIntRenderShadowIntensity", "50")
             , Map("FIntRenderShadowIntensity", "0"
                 , "DFFlagDebugPauseVoxelizer", "True") ]})

    ; SHADOW DETAIL. The atlas the shadow map is rendered into. 4096 sharpens
    ; every shadow edge for a few percent of frame time; 1024 is the cheap end.
    o.Push({k: "shmap", n: "SHADOW DETAIL", h: "shadow map resolution - sharper edges cost gpu", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "1024", "2048", "4096"]
        , f: [ Map()
             , Map("FIntRenderShadowmapResolution", "1024")
             , Map("FIntRenderShadowmapResolution", "2048")
             , Map("FIntRenderShadowmapResolution", "4096") ]})

    ; POST-PROCESSING. Bloom, blur, colour correction, depth of field - the
    ; whole post stack in one switch. The single biggest free frame-rate win on
    ; a weak GPU, and the thing most likely to be missed if it is turned off by
    ; a preset without the user realising, so it gets its own row.
    o.Push({k: "postfx", n: "POST-PROCESSING", h: "bloom, blur, depth of field and colour correction", grp: 1, ui: "drop", al: 1
        , v: ["AUTO", "ON", "OFF"]
        , f: [ Map()
             , Map("FFlagDisablePostFx", "False")
             , Map("FFlagDisablePostFx", "True") ]})

    ; ROBLOX FONT - not a flag and not an XML value: the client reads its
    ; typefaces out of content\fonts, so this one swaps the files themselves.
    o.Push({k: "font", n: "ROBLOX FONT", h: "swap the client's typeface for a ttf of your own"
          , grp: 1, ui: "file", al: 1, v: ["DEFAULT", "CUSTOM"], f: [Map(), Map()]})

    ; ROBLOX LOGO - same idea as the font row, same machinery, different assets.
    ; One image, two destinations: the logo art inside the client, and the
    ; desktop / taskbar / Start icon. They were briefly two rows, which was
    ; wrong - the second had no image of its own and silently borrowed this
    ; one's, so it was never really a separate setting.
    o.Push({k: "logo", n: "ROBLOX LOGO", h: "client logo art and the desktop icon"
          , grp: 1, ui: "file", al: 1, v: ["DEFAULT", "CUSTOM"], f: [Map(), Map()]})
    ; Studio is its own install with its own textures and its own shortcut, so
    ; it gets its own image. One row driving both meant Studio silently wore
    ; the Player's logo.
    o.Push({k: "logos", n: "ROBLOX STUDIO LOGO", h: "studio's logo art and its desktop icon"
          , grp: 1, ui: "file", al: 1, v: ["DEFAULT", "CUSTOM"], f: [Map(), Map()]})
    ; Its own restore, so putting the logos back does not drag every other
    ; client setting back with them.
    o.Push({k: "logorst", n: "RESTORE LOGOS", h: "put both apps' original logos and icons back"
          , grp: 1, ui: "action", al: 1, v: ["RESTORE"], f: [Map()]})


    ; ---- client settings file ----
    ; SavedQualityLevel is Enum.SavedQualitySetting: 0 is Automatic, 1..10 are
    ; the ten notches of the in-client slider
    gq := {k: "gfx", n: "GRAPHICS QUALITY", h: "the in-client quality slider, 1 to 10"
         , grp: 2, ui: "slider", al: 1, xml: "SavedQualityLevel", xt: "token", v: ["KEEP", "AUTO"], x: ["", "0"]}
    loop 10 {
        gq.v.Push(String(A_Index))
        gq.x.Push(String(A_Index))
    }
    o.Push(gq)

    ; MASTER VOLUME - the file stores 0..1, the slider shows percent
    mv := {k: "vol", n: "MASTER VOLUME", h: "the client's own volume slider"
         , grp: 2, ui: "slider", al: 1, xml: "MasterVolume", xt: "float", v: ["KEEP"], x: [""]}
    loop 21 {
        pc := (A_Index - 1)*5
        mv.v.Push(pc "%")
        mv.x.Push(Format("{:.2f}", pc/100.0))
    }
    o.Push(mv)

    ; MOUSE SENSITIVITY - 0.1 .. 3.0 in tenths, 1.0 is the Roblox default
    ms := {k: "sens", n: "MOUSE SENSITIVITY", h: "camera speed - 1.0 is the roblox default"
         , grp: 2, ui: "slider", al: 1, xml: "MouseSensitivity", xt: "float", v: ["KEEP"], x: [""]}
    loop 30 {
        sv := Format("{:.1f}", A_Index/10.0)
        ms.v.Push(sv)
        ms.x.Push(sv)
    }
    o.Push(ms)

    ; ---- the raw layer, last in the list ----
    ; grp 3 rather than joining CLIENT SETTINGS FILE: the rows above it are all
    ; presets that pick from a fixed ladder, and this one is the way past them.
    ; A group of its own keeps that distinction visible instead of hiding an
    ; editor at the bottom of a list of dropdowns.
    ;
    ; No `f` field, so RSetFlags skips it - it does not write a flag itself, it
    ; opens the page that edits the ones that do.
    o.Push({k: "fxedit", n: "EDIT FAST FLAGS", h: "add or override the flags this module writes"
        , grp: 3, ui: "action", al: 1, v: ["EDIT"]})
    ; ---- which of the two halves actually reaches the file ----
    ; The rows above and the page behind EDIT FAST FLAGS both produce flags, and
    ; by default they MERGE - a hand-typed override beating the row that owns
    ; the same name. That is the right default and it stays the default, because
    ; a mix is what most people want.
    ;
    ; But a merge is not always what you want to debug. This row turns the merge
    ; off and hands the file to exactly one of them, so "is it my override or the
    ; row?" is one click to answer instead of an afternoon. Its switch is the ON
    ; and OFF of the whole idea: off is the merge, on is one source only.
    ;
    ; No `f`, so it writes no flag itself - it decides which flags get written.
    o.Push({k: "src", n: "FLAG SOURCE", h: "which half of this module reaches the client file"
        , grp: 3, ui: "source", al: 1, v: ["MIX", "CLIENT SYSTEMS", "EDIT FAST FLAGS"]})
    return o
}
global RSET_OPTS := RSetOptions()
; ---- the table's `al` field is DERIVED, not typed ----
; It used to be a hand-written guess per row and it had drifted five rows out of
; date. Overwritten here, once, from Roblox's published allowlist, so the row
; hints and the status pips cannot disagree with each other or with the file the
; module writes. `alp` is the partial case - see RSetRowAl.
for o in RSET_OPTS {
    v := RSetRowAl(o)
    o.al := (v = 1) ? 1 : 0
    o.alp := (v = 2) ? 1 : 0
}

global RSET_SYSN := RSET_OPTS.Length

; A labelled gap opens wherever the group changes, so adding a row or moving
; one between groups cannot leave the layout and the hit test disagreeing.
RSetRowY(i) {
    y := 12 + (i - 1)*HL.rsrg
    loop (i - 1) {
        j := A_Index + 1
        if (RSET_OPTS[j].grp != RSET_OPTS[j - 1].grp)
            y += RSET_SEPH
    }
    return y
}
RSetTotal() => RSetRowY(RSET_SYSN) + HL.rsrg - 12

; label on the break that introduces each group
RSetGrpName(g) => g = 0 ? "ACTIONS" : g = 1 ? "CLIENT FILES" : g = 2 ? "CLIENT SETTINGS FILE" : "FAST FLAGS"
RSetIdx(o)  => RSET.pick.Has(o.k) ? Clamp(RSET.pick[o.k], 1, o.v.Length) : 1
; ---- the row's CONTROL zone ----
; 1300 + i, not 900 + i, and the reason is a collision that had already
; happened. The fixed zones in this module start at 920 - scrollbar, master
; switch, ALL AUTO, OPEN FILE, font browse, the preset chips, the logo buttons -
; and the row zones counted UP into them as the option list grew. At 22 rows the
; last three landed on 920, 921 and 922 exactly: hovering EDIT FAST FLAGS lit
; ALL AUTO because they shared a hover key, and clicking it RAN ALL AUTO because
; RSetClick tests z = 922 before it tests the row range.
;
; A base with room, tested for nothing else in the file, and derived in one
; place so the next row added cannot walk into anything.
RSetRowZ(i)  => 1300 + i
; ---- the slider knob, as its own target ----
; A second zone per slider row, because the knob has to answer to being under
; the pointer rather than to the pointer being somewhere in the same column.
; 1330 is clear of the row band above (1300 + 22 rows) with room for the list to
; keep growing.
global RSET_KNOBZ := 1330
RSetKnobZ(i) => RSET_KNOBZ + i
; ---- which of this module's zones are TEXT BOXES ----
; Double-click-to-select-a-word and the copy/cut/paste menu are both routed off
; a list of field zones, and this module's four were in neither list - so the
; boxes took a caret and nothing else. One predicate, used by both, so a field
; added later cannot end up in one list and not the other.
RSetIsFldZone(z) => (z = 1601 || z = 1602 || z = 1606
                  || (z > RSET_FXZVAL && z <= RSET_FXZVAL + RSET_FXZMAX))
; where along its track a slider row currently sits, 0..1 - the hit test needs
; the knob's centre and the renderer needs the same number, so it lives here
; rather than being worked out twice
RSetSlideFrac(i) {
    o := RSET_OPTS[i]
    n := o.v.Length
    return (n > 1) ? (RSetIdx(o) - 1)/(n - 1) : 0.0
}
; row lookup by key - nothing should depend on a literal row number
RSetBy(k) {
    for o in RSET_OPTS {
        if (o.k = k)
            return o
    }
    return 0
}

; ---- the extras survive a restart ----
; One ini value, name=value pairs joined by a vertical bar. Not JSON: the module
; already carries its own flat parser for the client's file and a second format
; here would be a second thing to get wrong. The bar cannot appear in a flag
; name (RSetFlagNameOK) and is stripped from values on the way in.
RSetExtraSave() {
    ; Every path that adds, edits or removes an extra ends here - RSetFxAdd,
    ; RSetFxDel, RSetFxEdit and FFMEndEdit's "rfe" commit - so this is the one
    ; place the flag list's memo has to be told, and no future mutator can
    ; forget to do it without also forgetting to persist.
    RSetFxBump()
    blob := ""
    for k, v in RSET.extra
        blob .= (blob = "" ? "" : "|") k "=" v
    try IniWrite(blob, iniPath, "rset", "extra")
}
RSetExtraLoad() {
    raw := ""
    try raw := IniRead(iniPath, "rset", "extra", "")
    if (raw = "")
        return
    for part in StrSplit(raw, "|") {
        p := InStr(part, "=")
        if !p
            continue
        k := Trim(SubStr(part, 1, p - 1)), v := Trim(SubStr(part, p + 1))
        if (RSetFlagNameOK(k) && v != "")
            RSET.extra[k] := v
    }
    RSetFxBump()                   ; locks and the flag list both read off this
}

RSetSay(msg, col := 0) {
    RSET.msg := msg
    RSET.msgCol := col ? col : C_ON
    RSET.msgAt := A_TickCount
    HubPoke()
}

; ---------------- live framerate cap ----------------
; Everything else in this module is written to a file and read at launch. The
; framerate cap does not have to be, and the reason is in the flag's own name:
; DFIntTaskSchedulerTargetFps is a D-prefixed value. In Roblox's flag system
; the D means DYNAMIC - the class of value Roblox can push to a client that is
; already running, without a restart. So the task scheduler reads it as it
; runs rather than caching it at init, and a write into the live process takes
; effect on the next frame.
;
; Nothing new is invented here: the Fast Flag Manager already locates the flag
; table and writes into it. This just routes one value down that path as well
; as into the file, so the cap survives a restart AND applies immediately.
;
; The two companion flags are plain FFlags, not DFFlags - static, read once at
; startup. FFlagGameBasicSettingsFramerateCap5 enables the feature and
; FFlagTaskSchedulerLimitTargetFpsTo2402 lifts the 240 ceiling. Those still
; need one restart, once ever; the number itself is live from then on.
RSetFpsSet() {
    o := RSetBy("fps")
    if !o
        return 0
    i := RSetIdx(o)
    if (i <= 1 || i > o.f.Length)
        return 0                             ; AUTO - nothing to force
    return o.f[i]
}
RSetFpsTarget() {
    m := RSetFpsSet()
    return (m && m.Has("DFIntTaskSchedulerTargetFps")) ? m["DFIntTaskSchedulerTargetFps"] : ""
}

; Read the live value of one flag by name. "" when it cannot be resolved or
; read - deliberately distinct from 0, which is a real value here.
RSetFlagPeek(idx, name) {
    bare := FFMBareOf(name)
    vpr  := idx.Has(bare) ? idx[bare] : 0
    if !vpr
        return ""
    vp := MemIO.ReadU64(vpr + 0xC0)
    return vp ? MemIO.ReadI32Chk(vp) : ""
}

; Every flag that gates the frame rate, as the running client currently holds
; them. Logged before AND after a live write, because the interesting question
; is not what we wrote - it is what the value was beforehand. A clamp that
; reads back as already ON before we touch anything means something re-armed
; it after launch, and that is a different problem from a write not landing.
RSetFpsProbe(idx, tag) {
    names := ["DFIntTaskSchedulerTargetFps"
            , "FFlagTaskSchedulerLimitTargetFpsTo2402"
            , "FFlagGameBasicSettingsFramerateCap5"]
    out := ""
    for nm in names {
        v := RSetFlagPeek(idx, nm)
        out .= (out = "" ? "" : "  ") FFMBareOf(nm) "=" (v = "" ? "?" : v)
    }
    FFMLog("FpsProbe", tag, out)
    return out
}

; Result codes, because "it did not work" has three different causes here and
; they need three different things from the user:
;    1  written and verified against the running client
;    2  target took; above 240, and the clamp write landed but cannot be
;       proven to be honoured by the engine
;    3  target took; above 240, and the clamp write did not land at all
;    0  nothing to write - the row is on AUTO
;   -1  a client is attached but the value did not take
;   -2  no client attached to write into
RSetFpsLive() {
    tgt := RSetFpsTarget()
    if (tgt = "")
        return 0
    ; Only ever the instance the manager is already attached to. Attaching to
    ; one on purpose would mean FFMUseInstance, which resets the selected tab,
    ; the scroll and any in-progress edit - far too much collateral for a
    ; convenience write. FFMPoll attaches on its own within about a second of a
    ; client appearing, so in practice this is almost always available.
    if (!FFM.pid || !MemIO.hProcess || !MemIO.IsAlive())
        return -2
    if FFM.busy
        return -2
    FFM.busy := 1
    try {
        hp0 := MemIO.hProcess, pid0 := FFM.pid
        hdr := FlagSingleton.Header(!ffUseSingleton)
        if (!hdr || !hdr.list || !hdr.mask)
            return -1
        idx := FlagSingleton.Index(hdr)
        RSetFpsProbe(idx, "before")
        RSetFpsSnap(idx, pid0)
        ; EVERY flag the row carries, not just the target. Writing the target
        ; alone was the bug behind "MAX only works if I set it before
        ; launching": the scheduler is clamped to 240 by
        ; FFlagTaskSchedulerLimitTargetFpsTo2402, which is read at startup as
        ; its default. Set 9999 without clearing that and the scheduler pins
        ; you at 240 - which looks like nothing happened, while 60/120/144/240
        ; all appeared to work because they were under the clamp anyway.
        okT := false, okClamp := false
        for nm, val in RSetFpsSet() {
            bare := FFMBareOf(nm)
            vpr  := idx.Has(bare) ? idx[bare] : 0
            if !vpr
                continue
            if !FFlags.SetVia(vpr, val)
                continue
            if !FFMSameProc(hp0, pid0)
                return -1                    ; client swapped mid-write
            ; Read back. A successful WriteProcessMemory says the bytes landed,
            ; not that the engine is reading them - an FFlag cached into a local
            ; at init accepts the write and ignores it, and this is the only
            ; thing that would notice.
            vp   := MemIO.ReadU64(vpr + 0xC0)
            back := vp ? MemIO.ReadI32Chk(vp) : ""
            if (back = "" || back != FFlags.Coerce(val))
                continue
            FFMLog("Inject", nm, "live -> " val)
            if (nm = "DFIntTaskSchedulerTargetFps")
                okT := true
            else if (nm = "FFlagTaskSchedulerLimitTargetFpsTo2402")
                okClamp := true
        }
        RSetFpsProbe(idx, "after")
        if !okT
            return -1
        ; The clamp only matters above 240 - below it the ceiling is
        ; irrelevant and a warning would be noise.
        ;
        ; Above it, be careful about what the read-back actually proves. It
        ; proves our value is IN the flag's memory. It does not prove the
        ; engine still reads that memory: an FFlag folded into a local at
        ; startup accepts the write, reads back correctly, and is ignored -
        ; and nothing outside the process can tell the difference. So a
        ; verified clamp write is reported as "may need a restart" rather than
        ; as success, and a failed one as a definite hold at 240.
        if (Integer(tgt) > 240)
            return okClamp ? 2 : 3
        return 1
    } finally {
        FFM.busy := 0
    }
}

; The values the running client held BEFORE this module wrote its cap into it.
; Captured once per client: a second capture after our own write would record
; OUR value as the original, which is the same trap RSetWriteAppSettings guards
; against with its `f sentinel.
;
; Deliberately NOT persisted. These are process memory, not a file - a snapshot
; taken from a client that has since exited describes an address space that no
; longer exists, and the client that replaced it read its startup values from
; ClientAppSettings.json, which REVERT has already cleaned. So the snapshot
; dies with the pid it came from, and RSetFpsLiveRevert checks that pid before
; writing anything.
RSetFpsSnap(idx, pid) {
    if (RSET.fpsWasP = pid && RSET.fpsWas.Count)
        return
    RSET.fpsWas := Map(), RSET.fpsWasP := 0
    for nm, val in RSetFpsSet() {
        v := RSetFlagPeek(idx, nm)
        if (v = "")
            continue                         ; unreadable - do not invent one
        RSET.fpsWas[nm] := v
    }
    if RSET.fpsWas.Count
        RSET.fpsWasP := pid
}

; The counterpart of RSetFpsLive, and the reason it exists: the cap is the one
; row that reaches a RUNNING client, so it is the one row a file-only revert
; cannot undo. Without this, REVERT deleted the cap from ClientAppSettings,
; said REVERTED, and the client carried on at the capped rate until it was
; restarted - the module's most visible setting outliving its own switch.
;
; Codes:
;    n>0  that many flags put back and verified against the client
;    0    nothing owed - we never wrote live, or the client we wrote into is
;         gone, in which case its replacement already starts from the file
;   -1    the client is attached but the values would not take
;   -2    the manager is busy; the write is not attempted rather than raced
RSetFpsLiveRevert() {
    if !RSET.fpsWas.Count
        return 0
    ; A different process, or none at all, means whatever we wrote died with
    ; the client that held it. Drop the snapshot: replaying it into a client we
    ; never touched would be this module writing a value nobody asked for.
    if (!FFM.pid || !MemIO.hProcess || !MemIO.IsAlive() || RSET.fpsWasP != FFM.pid) {
        RSET.fpsWas := Map(), RSET.fpsWasP := 0
        return 0
    }
    if FFM.busy
        return -2
    FFM.busy := 1
    try {
        hp0 := MemIO.hProcess, pid0 := FFM.pid
        hdr := FlagSingleton.Header(!ffUseSingleton)
        if (!hdr || !hdr.list || !hdr.mask)
            return -1
        idx := FlagSingleton.Index(hdr)
        RSetFpsProbe(idx, "revert-before")
        n := 0
        for nm, val in RSET.fpsWas {
            bare := FFMBareOf(nm)
            vpr  := idx.Has(bare) ? idx[bare] : 0
            if !vpr
                continue
            if !FFlags.SetVia(vpr, val)
                continue
            if !FFMSameProc(hp0, pid0)
                return -1                    ; client swapped mid-write
            ; Same read-back as the apply path, for the same reason: a
            ; successful write says the bytes landed, not that the engine is
            ; still reading them.
            vp   := MemIO.ReadU64(vpr + 0xC0)
            back := vp ? MemIO.ReadI32Chk(vp) : ""
            if (back = "" || back != FFlags.Coerce(val))
                continue
            FFMLog("Revert", nm, "live -> " val)
            n++
        }
        RSetFpsProbe(idx, "revert-after")
        if !n
            return -1
        ; Only forget the snapshot once it has actually been put back. A failed
        ; revert stays revertable, which is the same rule the group half of
        ; DEVICE OPTIMIZATIONS follows.
        RSET.fpsWas := Map(), RSET.fpsWasP := 0
        return n
    } finally {
        FFM.busy := 0
    }
}

; ---------------- quality presets ----------------
; HIGH / MEDIUM / LOW stage every GRAPHICS row in one go. Three things this
; deliberately does not touch:
;   font   a file the user chose - a preset has no business replacing it
;   vol    audio, not quality
;   sens   input, not quality
; A preset that silently reset someone's mouse sensitivity would be a bug that
; reads as a corrupted config, and none of the three is what "quality" means.
;
; Values are looked up by NAME rather than written as raw indices: the option
; arrays are generated (FRM is a 21-step loop, GRAPHICS QUALITY an 11-step one),
; so a hard-coded index silently points somewhere else the moment a step is
; added. RSetPresetIdx returns 1 - the leave-alone choice - when a name is not
; found, which is the safe direction to fail in.
RSetPresetIdx(o, name) {
    for i, v in o.v {
        if (v = name)
            return i
    }
    return 1
}

; key -> value name, per preset. LOW uncaps the frame rate on purpose: the
; point of the lowest graphics tier is the highest frame rate, so capping it
; would undo the reason for choosing it.
RSetPresetTable(which) {
    if (which = 1)                                   ; HIGH
        return Map("render", "AUTO",  "light", "FUTURE",    "frm", "21"
                 , "tex",    "3",     "mesh",  "ULTRA",     "msaa", "x4"
                 , "fps",    "240",   "dpi",   "PRESERVE",  "gfx",  "10"
                 , "shadow", "AUTO",  "shmap", "4096",      "postfx", "ON")
    if (which = 2)                                   ; MEDIUM
        return Map("render", "AUTO",  "light", "SHADOWMAP", "frm", "10"
                 , "tex",    "2",     "mesh",  "MEDIUM",    "msaa", "x2"
                 , "fps",    "120",   "dpi",   "AUTO",      "gfx",  "5"
                 , "shadow", "SOFTER", "shmap", "2048",     "postfx", "AUTO")
    return Map("render", "AUTO",      "light", "VOXEL",     "frm", "1"
             , "tex",    "0",         "mesh",  "OFF",       "msaa", "x1"
             , "fps",    "MAX",       "dpi",   "AUTO",      "gfx",  "1"
             , "shadow", "OFF",       "shmap", "1024",      "postfx", "OFF")
}

; ---- the FLAG SOURCE controls ----
RSetSrcToggle() {
    global rsetSrcOn
    rsetSrcOn := rsetSrcOn ? 0 : 1
    RSET.srcAt := A_TickCount
    ; the 360 ms ripple every other control in this panel plays when its value
    ; changes - the source row was the only one not registering it
    RSET.flashAt["src"] := A_TickCount
    try IniWrite(rsetSrcOn, iniPath, "rset", "srcon")
    RSetFxBump()                   ; the row locks read off this
    RSetSay(rsetSrcOn
        ? ((rsetSrcSel = 1 ? "CLIENT SYSTEMS" : "EDIT FAST FLAGS") " ONLY - THE OTHER HALF IS IGNORED")
        : "MIXING BOTH - OVERRIDES WIN ON A SHARED NAME"
        , RSET.on ? AMBER : 0)
    HubPoke()
}
RSetSrcSelect(which) {
    global rsetSrcSel, rsetSrcOn
    if (which < 1 || which > 2)
        return
    if (rsetSrcSel = which && rsetSrcOn)
        return
    rsetSrcSel := which
    ; picking a side turns the choice ON - reaching for one of two names and
    ; having nothing happen because a switch beside it was off is a control
    ; arguing with itself
    rsetSrcOn := 1
    RSET.srcAt := A_TickCount
    RSET.flashAt["src"] := A_TickCount
    try IniWrite(rsetSrcSel, iniPath, "rset", "srcpick")
    try IniWrite(rsetSrcOn, iniPath, "rset", "srcon")
    RSetFxBump()
    RSetSay((which = 1 ? "CLIENT SYSTEMS" : "EDIT FAST FLAGS") " ONLY - THE OTHER HALF IS IGNORED"
          , RSET.on ? AMBER : 0)
    HubPoke()
}

RSetPreset(which) {
    nm  := (which = 1) ? "HIGH" : (which = 2) ? "MEDIUM" : "LOW"
    tbl := RSetPresetTable(which)
    n := 0
    skipped := 0
    for k, want in tbl {
        o := RSetBy(k)
        if !o
            continue                                 ; row was removed - skip, do not throw
        ; a preset drives the rows below it, and a row that has been taken over
        ; is no longer one of them. Setting it anyway would move a control the
        ; panel is drawing as dead and change nothing that reaches Roblox.
        if RSetRowLocked(o) {
            skipped++
            continue
        }
        idx := RSetPresetIdx(o, want)
        if (idx = RSetIdx(o))
            continue                                 ; already there, so do not flash it
        RSET.pick[k] := idx
        RSET.flashAt[k] := A_TickCount
        try IniWrite(idx, iniPath, "rset", k)
        n++
    }
    RSET.preset := which
    RSET.presetAt := A_TickCount
    ; Staged, exactly like every other row here - a preset that wrote straight
    ; to the client would be the one control in this panel that skips APPLY.
    tail := skipped ? ("  ·  " skipped " TAKEN OVER, SKIPPED") : ""
    if RSET.on
        RSetSay(nm " PRESET STAGED - PRESS APPLY AGAIN TO WRITE IT" tail, AMBER)
    else
        RSetSay(nm " PRESET STAGED  ·  " n " ROW(S) CHANGED" tail "  -  PRESS APPLY", C_ON)
    HubPoke()
}

; Which preset the current picks correspond to, or 0 when they match none of
; them. Derived rather than stored, so changing one row by hand drops the
; preset marker on its own instead of leaving a stale chip lit.
RSetPresetActive() {
    loop 3 {
        w := A_Index
        hit := 1
        for k, want in RSetPresetTable(w) {
            o := RSetBy(k)
            if !o
                continue
            if RSetRowLocked(o)
                continue           ; not this preset's to match any more
            if (RSetIdx(o) != RSetPresetIdx(o, want)) {
                hit := 0
                break
            }
        }
        if hit
            return w
    }
    return 0
}

; how many rows are actually set to something other than the leave-alone choice
RSetChosen() {
    n := 0
    for o in RSET_OPTS {
        ; neither an action, a preset nor the source switch carries a value of
        ; its own - counting them would make the dial read a row or two set on a
        ; fresh config
        if (o.ui = "action" || o.ui = "preset" || o.ui = "source")
            continue
        if (RSetIdx(o) > 1)
            n++
    }
    ; A raw flag is as much a thing to write as a row is. Without this, adding
    ; only custom flags and touching no preset left APPLY drawn inert and the
    ; whole page unable to reach the file it edits.
    n += RSET.extra.Count
    return n
}

; ---------------- the client settings file ----------------
; Roblox bumps the number on this file between major settings revisions, so it
; is globbed rather than hard-coded, newest name last.
RSetXml(force := false) {
    if (!force && RSET.xmlAt && A_TickCount - RSET.xmlAt < 4000)
        return RSET.xmlPath
    RSET.xmlAt := A_TickCount
    RSET.xmlPath := ""
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return ""
    best := "", bestN := -1
    loop Files, lad "\Roblox\GlobalBasicSettings_*.xml" {
        n := 0
        if RegExMatch(A_LoopFileName, "_(\d+)\.xml$", &m)
            n := Integer(m[1])
        if (n >= bestN)
            bestN := n, best := A_LoopFileFullPath
    }
    RSET.xmlPath := best
    RSetReadXml()
    return best
}

; Pull the current value of every property we know how to drive. A property
; that is not in the file simply never lands in the map, and its row goes grey.
RSetReadXml() {
    RSET.xmlHave := Map()
    if (RSET.xmlPath = "" || !FileExist(RSET.xmlPath))
        return
    body := ""
    try body := FileRead(RSET.xmlPath, "UTF-8")
    if (body = "")
        return
    for o in RSET_OPTS {
        if !o.HasOwnProp("xml")
            continue
        if RegExMatch(body, "s)<\w+\s+name=`"" o.xml "`"\s*>(.*?)</\w+>", &m)
            RSET.xmlHave[o.xml] := Trim(m[1])
    }
}

RSetXmlBak() => YURI_RSB "\GlobalBasicSettings.bak.xml"

RSetEnsureDirs() {
    if !DirExist(YURI_RSB)
        try DirCreate(YURI_RSB)
    if !DirExist(YURI_RSB "\fonts")
        try DirCreate(YURI_RSB "\fonts")
}

; Replace the text of an existing element without touching its tag or type -
; the file mixes <int>, <float> and <token> and guessing wrong breaks parsing.
; Set an existing element's text, or CREATE the element when the file has
; never carried it. That second case is why the framerate cap did nothing: a
; client whose in-game FPS setting has never been touched has no
; <int name="FramerateCap"> element at all, and the old writer silently
; matched nothing and reported success. `tag` is the element type to create.
RSetXmlSet(&body, prop, val, tag := "int") {
    pat := "s)(<\w+\s+name=`"" prop "`"\s*>)(.*?)(</\w+>)"
    if RegExMatch(body, pat, &m) {
        ; composites like Vector2 and Color3 nest their own elements - the lazy
        ; capture would grab only the first child and mangle the rest, so
        ; anything that is not a bare scalar is left alone
        if InStr(m[2], "<")
            return false
        body := SubStr(body, 1, m.Pos - 1) . m[1] . val . m[3] . SubStr(body, m.Pos + m.Len)
        return true
    }
    ; not there - insert it at the top of the settings item's property list
    if !RegExMatch(body, "s)<Item\s+class=`"UserGameSettings`"[^>]*>\s*<Properties>", &mi)
        if !RegExMatch(body, "s)<Properties>", &mi)
            return false
    ins := "`n`t`t<" tag " name=`"" prop "`">" val "</" tag ">"
    body := SubStr(body, 1, mi.Pos + mi.Len - 1) . ins . SubStr(body, mi.Pos + mi.Len)
    return true
}

; Read a single property straight back out of the file on disk. APPLY uses this
; to confirm what it wrote actually landed instead of assuming it did.
RSetXmlRead(path, prop) {
    body := ""
    try body := FileRead(path, "UTF-8")
    if (body = "")
        return ""
    if RegExMatch(body, "s)<\w+\s+name=`"" prop "`"\s*>(.*?)</\w+>", &m)
        return Trim(m[1])
    return ""
}

; Set an element that ALREADY exists, and refuse to create one. RSetXmlSet's
; create path is right for a row Roblox is known to carry; this is for the
; companion below, where inventing a property Roblox does not have would put
; a bogus element in the user's settings file forever.
RSetXmlSetExisting(&body, prop, val) {
    pat := "s)(<\w+\s+name=`"" prop "`"\s*>)(.*?)(</\w+>)"
    if !RegExMatch(body, pat, &m)
        return false
    if InStr(m[2], "<")
        return false
    body := SubStr(body, 1, m.Pos - 1) . m[1] . val . m[3] . SubStr(body, m.Pos + m.Len)
    return true
}

; Remove an element outright, with the line it sits on. Deleting is what
; "back to the Roblox default" actually means for this file: UserGameSettings
; is a normal instance with built-in defaults, so a property that is not in the
; XML is the property at its shipped value, and the client writes the element
; back itself the next time it saves. Restoring a NUMBER would mean this suite
; deciding what Roblox's default is and being wrong the day Roblox changes it.
RSetXmlDel(&body, prop) {
    pat := "s)(\r?\n)?[ \t]*(<\w+\s+name=`"" prop "`"\s*>)(.*?)(</\w+>)"
    if !RegExMatch(body, pat, &m)
        return false
    ; composites nest their own children - the lazy capture would cut one open
    ; and leave the file unparseable. Same guard, same reason, as RSetXmlSet.
    if InStr(m[3], "<")
        return false
    body := SubStr(body, 1, m.Pos - 1) . SubStr(body, m.Pos + m.Len)
    return true
}

; SavedQualityLevel has a raw twin in the same file. SavedQualityLevel is the
; enum the slider stores (0 = Automatic, 1..10 the notches); GraphicsQualityLevel
; is the level the renderer actually runs at. Writing one and not the other is
; why GRAPHICS QUALITY could read as set and change nothing, and - on the way
; back out - why a client could come out of REVERT pinned at whatever level was
; last written. It is not a row of its own: it has no independent meaning, so it
; rides the row it belongs to. Modify-only on the way in, delete on the way out.
RSetXmlTwin(o) => (o.HasOwnProp("xml") && o.xml = "SavedQualityLevel") ? "GraphicsQualityLevel" : ""

; Every property this module is able to put in the file, twins included. This
; is the set REVERT clears, so it is derived from the option table rather than
; listed by hand - a row added above is reverted without anything else changing.
RSetXmlProps() {
    out := Map()
    for o in RSET_OPTS {
        if !o.HasOwnProp("xml")
            continue
        out[o.xml] := o.HasOwnProp("xt") ? o.xt : "int"
        if ((tw := RSetXmlTwin(o)) != "")
            out[tw] := "int"
    }
    return out
}

; ---- the record of what APPLY put in the file ----
; The old REVERT copied a whole-file backup back over the settings file. That
; backup is captured on the first APPLY that finds none, and there was a path
; that made the capture record THIS MODULE'S OWN OUTPUT as the original: revert
; under a running client "restored" the file, deleted the backup, and the client
; then wrote its in-memory copy - the applied values - back over the file on
; exit. The next APPLY captured that, so every REVERT afterwards faithfully
; restored the applied settings. With the HIGH preset that is a client stuck at
; GRAPHICS QUALITY 10 no matter how many times REVERT is pressed.
;
; So REVERT no longer replays a snapshot. It clears the properties this module
; can write and lets Roblox supply its own defaults, and this record says which
; ones are outstanding. A snapshot cannot be trusted to hold the default; an
; absent property is the default by definition.
RSetXmlOwnPath() => YURI_RSB "\xml_owned.json"

RSetXmlOwned() {
    out := Map()
    if !FileExist(RSetXmlOwnPath())
        return out
    body := ""
    try body := FileRead(RSetXmlOwnPath(), "UTF-8")
    if (body != "")
        out := RSetParseJson(body)
    return out
}

RSetXmlOwnSave(m) {
    RSetEnsureDirs()
    if !m.Count {
        try FileDelete(RSetXmlOwnPath())
        return
    }
    try {
        fh := FileOpen(RSetXmlOwnPath(), "w", "UTF-8")
        fh.Write(RSetDumpJson(m))
        fh.Close()
    }
}

; Is the file half still owed anything? The record is the answer for anything
; this build wrote; the whole-file backup is the answer for anything an older
; build wrote before the record existed.
RSetXmlOwes() => (RSetXmlOwned().Count > 0) || FileExist(RSetXmlBak())


; ---------------- delivery: ClientSettings\ClientAppSettings.json ----------------
; Staging a flag in the FAST FLAG MANAGER does NOT hand it to Roblox - that
; store is YURI's own, and the manager's only delivery path is INJECT LIVE,
; which needs a running client and dies with it. For a setting that has to
; survive a relaunch the client reads
;     <version>\ClientSettings\ClientAppSettings.json
; at startup, so this module writes there too.
;
; The file is MERGED, never replaced: other tools and the user's own flags stay
; put, APPLY only adds this module's keys. REVERT then REMOVES every name this
; module knows - see RSetKnownKeys and the note on RSetWriteAppSettings - so
; the client is on Roblox's own default for each of them, whatever any tool
; had set before.
; Cached for four seconds, the way RSetAppExe and RSetLnkTargets are: the
; state card asks for this EVERY FRAME to print a count, and the answer walks
; the version folders and now snapshots the process list as well. The two
; writers ask with `force` and always get a fresh look.
RSetAppSettingsPaths(force := false) {
    if (!force && RSET.pathsAt && A_TickCount - RSET.pathsAt < 4000)
        return RSET.paths
    RSET.pathsAt := A_TickCount
    RSET.paths := (out := [])
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return out
    loop Files, lad "\Roblox\Versions\version-*", "D" {
        ; a version folder without the player exe is a Studio or stale install
        if !FileExist(A_LoopFileFullPath "\RobloxPlayerBeta.exe")
            continue
        out.Push(A_LoopFileFullPath "\ClientSettings")
    }
    ; Fishstrap and Bloxstrap keep the master copy under their own
    ; Modifications tree and stamp it over the version folder on every launch.
    ; Writing only the version folder means the next launch through either
    ; launcher throws our flags away, so their copy gets written too.
    for b in ["Fishstrap", "Bloxstrap", "Voidstrap"] {
        if !DirExist(lad "\" b)
            continue
        out.Push(lad "\" b "\Modifications\ClientSettings")
        ; ... and the client the launcher actually runs. Since Bloxstrap 2.5
        ; the launchers install Roblox under their OWN folder, not Roblox's, so
        ; the version folder above never saw them at all. The stamp at launch
        ; overwrites this copy anyway; writing it too covers a client started
        ; from the exe directly, and a REVERT that must not wait for a launch.
        loop Files, lad "\" b "\Versions\version-*", "D" {
            if FileExist(A_LoopFileFullPath "\RobloxPlayerBeta.exe")
                out.Push(A_LoopFileFullPath "\ClientSettings")
        }
    }
    ; ---- and wherever a client is actually running from ----
    ; A custom install path, or a launcher this list has never heard of, is
    ; still a client reading a ClientAppSettings.json beside its exe. Each
    ; running process is asked for its own image path rather than guessed at.
    for pid in FFMProcList() {
        exe := ""
        try exe := ProcessGetPath(pid)
        if (exe = "")
            continue
        SplitPath(exe, , &vdir)
        d := vdir "\ClientSettings"
        dup := 0
        for x in out {
            if (x = d) {
                dup := 1
                break
            }
        }
        if !dup
            out.Push(d)
    }
    return out
}

RSetPrevPath() => YURI_RSB "\appsettings_prev.json"

; Flat "key": "value" parse. ClientAppSettings is always one level deep and
; every value is a string, which is why the presets everyone passes around are
; written that way - no general JSON parser is needed or wanted here.
RSetParseJson(body) {
    m := Map(), pos := 1
    while (pos := RegExMatch(body, '"([A-Za-z0-9_]+)"\s*:\s*"([^"]*)"', &mt, pos)) {
        m[mt[1]] := mt[2]
        pos += mt.Len
    }
    pos := 1
    while (pos := RegExMatch(body, '"([A-Za-z0-9_]+)"\s*:\s*(true|false|-?\d+(?:\.\d+)?)', &mt, pos)) {
        if !m.Has(mt[1])
            m[mt[1]] := mt[2]
        pos += mt.Len
    }
    return m
}

RSetDumpJson(m) {
    out := "{", n := 0
    for k, v in m {
        out .= (n ? "," : "") '`n    "' FFMEsc(k) '": "' FFMEsc(v) '"'
        n++
    }
    return out "`n}"
}

; write := the flags to set; when write is 0 every name this module knows is
; REMOVED from every file - not restored to a recorded previous value.
;
; It used to restore. The record captured what a key held before APPLY, and
; REVERT put that back - which is faithful to "undo APPLY" and wrong for
; "back to the Roblox default", because the value it faithfully restored was
; whatever a launcher preset, an older build of this module or a hand edit had
; put there first. DFIntDebugFRMQualityLevelOverride 21 captured that way came
; back on every REVERT, and the client sat at maximum quality with a slider
; that only moved the render distance, however many times REVERT was pressed.
; A flag the client is not given is that flag at its default, so REVERT
; deletes. The record is still written by APPLY: it is how REVERT knows about
; a name that is no longer in the table or the overrides.
; RSET.wrCut says how many distinct names actually came out.
RSetWriteAppSettings(write) {
    dirs := RSetAppSettingsPaths(true)
    if !dirs.Length
        return 0
    RSetEnsureDirs()
    prev := Map()
    if FileExist(RSetPrevPath()) {
        body := ""
        try body := FileRead(RSetPrevPath(), "UTF-8")
        if (body != "")
            prev := RSetParseJson(body)
    }

    if write {
        ; Record every key we are about to own, with the value it held before -
        ; or the sentinel when it held nothing. REVERT no longer restores those
        ; values (see the note above), but the record is still the one list of
        ; names this module has written that survives a pick changing or an
        ; override being deleted between APPLY and REVERT, so it is kept.
        for k, v in RSetFlags() {
            if !prev.Has(k)
                prev[k] := "`f"
        }
    }

    known := write ? 0 : RSetKnownKeys()
    cut := Map()
    ok := 0
    for d in dirs {
        p := d "\ClientAppSettings.json"
        if (!write && !FileExist(p))
            continue                         ; nothing to take out of a file that is not there
        if !DirExist(d)
            try DirCreate(d)
        curM := Map()
        if FileExist(p) {
            body := ""
            try body := FileRead(p, "UTF-8")
            if (body != "")
                curM := RSetParseJson(body)
        }
        if write {
            mine := RSetFlags()
            for k, v in prev {
                ; capture the untouched original once, never again - a second
                ; capture would record our own value as the "original"
                if (v = "`f" && curM.Has(k))
                    prev[k] := curM[k]
            }
            for k, v in mine
                curM[k] := v
        } else {
            ; absent already is fine - something else may have rewritten the
            ; file in between. Same throw, same guard as the ones in
            ; FFMReApplyTick.
            for k, v in known {
                if curM.Has(k)
                    curM.Delete(k), cut[k] := 1
            }
        }
        try {
            fh := FileOpen(p, "w", "UTF-8")
            fh.Write(RSetDumpJson(curM))
            fh.Close()
            ok++
        }
    }
    if write {
        try {
            fh := FileOpen(RSetPrevPath(), "w", "UTF-8")
            fh.Write(RSetDumpJson(prev))
            fh.Close()
        }
    } else {
        try FileDelete(RSetPrevPath())
        RSET.wrCut := cut.Count
    }
    return ok
}

; Every flag name this module could have put in the file: each choice of every
; row (not only the chosen one - the pick may have moved since APPLY), the
; overrides typed into EDIT FAST FLAGS, and whatever the record says APPLY
; wrote (an override deleted from the list since is still in there). This is
; what REVERT removes. It contains nothing the FAST FLAG MANAGER owns: that
; module never writes this file, and this one never reads its list.
RSetKnownKeys() {
    out := Map()
    for o in RSET_OPTS {
        if !o.HasOwnProp("f")
            continue
        for fm in o.f
            for k, v in fm
                out[k] := 1
    }
    for k, v in RSET.extra
        out[k] := 1
    if FileExist(RSetPrevPath()) {
        body := ""
        try body := FileRead(RSetPrevPath(), "UTF-8")
        if (body != "")
            for k, v in RSetParseJson(body)
                out[k] := 1
    }
    return out
}
; Exactly the keys this module put into ClientAppSettings, taken from the
; record rather than from the current picks.
RSetOwnedKeys() {
    out := Map()
    if FileExist(RSetPrevPath()) {
        body := ""
        try body := FileRead(RSetPrevPath(), "UTF-8")
        if (body != "") {
            for k, v in RSetParseJson(body)
                out[k] := 1
            if out.Count
                return out
        }
    }
    for k, v in RSetFlags()
        out[k] := 1
    return out
}

; ---------------- the flag set this module owns ----------------
; Union of every chosen option's flags. Also the exact set REVERT removes, so
; a flag the user staged by hand in the FAST FLAG MANAGER is never touched
; unless this module put it there.
; The preset half on its own. The page needs to tell a pair that came from a
; row apart from one the user typed, and it cannot do that once they are merged.
RSetPresetFlags() {
    out := Map()
    for o in RSET_OPTS {
        ; `grp` is display grouping only - what a row writes is decided by the
        ; fields it carries, so a row can drive flags AND the settings file
        if !o.HasOwnProp("f")
            continue
        i := RSetIdx(o)
        if (i <= 1 || i > o.f.Length)
            continue
        for k, v in o.f[i]
            out[k] := v
    }
    return out
}
; ---- everything this module will write, and from where ----
; The FLAG SOURCE row decides. With its switch off the two halves MERGE, which
; is the default and what this always did. With it on, exactly one half reaches
; the file and the other is disregarded entirely - not merged at lower priority,
; not written and overwritten: not written.
;
; Every path that produces flags comes through here - the writer, the count on
; the state card, the APPLY button's live test - so the choice cannot apply in
; one place and not another.
RSetFlags() {
    if (rsetSrcOn && rsetSrcSel = 2) {
        ; the overrides alone. A copy, because callers mutate what they get back
        ; and RSET.extra is the store.
        out := Map()
        for k, v in RSET.extra
            out[k] := v
        return out
    }
    out := RSetPresetFlags()
    if (rsetSrcOn && rsetSrcSel = 1)
        return out                 ; the rows alone
    ; LAST, deliberately. An extra naming a flag a preset also writes is the
    ; user contradicting the row on purpose, and the thing they typed by hand is
    ; the more specific instruction. Merging the other way would let a row the
    ; user never touched silently win.
    for k, v in RSET.extra
        out[k] := v
    return out
}
; whether each half is live right now - the row hints, the greying and the
; EDIT FAST FLAGS page's own note all read off these rather than re-deriving the
; same condition four times
RSetSrcRows()  => !(rsetSrcOn && rsetSrcSel = 2)
RSetSrcExtra() => !(rsetSrcOn && rsetSrcSel = 1)

; ---- what the module can and cannot vouch for ----
; Roblox allowlists which flags a local ClientAppSettings.json may set, and that
; list is Roblox's - it is not in this file and it moves. What IS in this file is
; `al` on each preset row, which records whether THAT row's flags still land.
; So: every name a row with al:1 writes is known good, every name from an al:0
; row is known dead, and a flag the user typed is neither - it is unknown, and
; the editor says unknown rather than inventing a tick it cannot back.
;
;   1  on the allowlist      2  off it, will be ignored      0  not known
; ---- Roblox's Fast Flag Allowlist, as published ----
; Announced 29 September 2025 on the Roblox DevForum ("Allowlist for local
; client configuration via Fast Flags"). Only these names are read out of
; ClientAppSettings.json; everything else the client silently ignores. Studio is
; not affected, and using a name that is not here carries no penalty - it simply
; does nothing.
;
; Roblox reserve the right to change this without warning, so this is a SNAPSHOT
; and the panel says so rather than presenting it as permanent truth. The flag
; manager's live injection writes process memory instead of the file and is not
; bound by it, which is where every off-list row here is pointed.
;
; This replaced a per-ROW guess. The table carried an `al` field set by hand and
; it was wrong about five things - FRAMERATE CAP's four flags, SHADOW DETAIL,
; POST-PROCESSING, half of SHADOWS and the D3D11-disable that RENDERING MODE
; needs were all marked allowed and none of them are. The allowlist is per FLAG,
; so the answer has to be looked up per flag.
RSetAllowSet() {
    static al := 0
    if al
        return al
    al := Map()
    for n in ["DFIntCSGLevelOfDetailSwitchingDistance"
            , "DFIntCSGLevelOfDetailSwitchingDistanceL12"
            , "DFIntCSGLevelOfDetailSwitchingDistanceL23"
            , "DFIntCSGLevelOfDetailSwitchingDistanceL34"
            , "FFlagHandleAltEnterFullscreenManually"
            , "DFFlagTextureQualityOverrideEnabled"
            , "DFIntTextureQualityOverride"
            , "FIntDebugForceMSAASamples"
            , "DFFlagDisableDPIScale"
            , "FFlagDebugGraphicsPreferD3D11"
            , "FFlagDebugSkyGray"
            , "DFFlagDebugPauseVoxelizer"
            , "DFIntDebugFRMQualityLevelOverride"
            , "FIntFRMMaxGrassDistance"
            , "FIntFRMMinGrassDistance"
            , "FFlagDebugGraphicsPreferVulkan"
            , "FFlagDebugGraphicsPreferOpenGL"
            , "FIntGrassMovementReducedMotionFactor"]
        al[n] := 1
    return al
}
; 1 the client will read it, 2 the client will ignore it. There is no third
; state any more: the allowlist is explicit, so a name that is not on it is not
; "unknown", it is ignored - and saying so is the whole point of the pip.
RSetFlagStatus(name) => RSetAllowSet().Has(name) ? 1 : 2

; ---- the row's standing, DERIVED ----
; 1 every flag the row can write is allowed, 0 none of them are, 2 some are and
; some are not. A row in the third state is the interesting one: SHADOWS' OFF
; writes one flag the client honours and one it drops, so the setting half
; works, and a row hint that said either "fine" or "off the list" would be
; lying in one direction or the other.
RSetRowAl(o) {
    if !o.HasOwnProp("f")
        return 1
    yes := 0, no := 0
    for m in o.f {
        for k, v in m
            RSetAllowSet().Has(k) ? yes++ : no++
    }
    if !no
        return 1
    return yes ? 2 : 0
}
; ---- the row a name BELONGS to, whatever that row is set to ----
; RSetFlagOwner below only finds a row that is writing the flag RIGHT NOW, which
; is no use once the row has been switched off: taking a flag over disables its
; row, and the list still has to be able to say where the flag came from. This
; one searches every CHOICE of every row, so the answer survives the row being
; set back to AUTO.
RSetFlagRowOf(name) {
    static memo := 0
    if !memo {
        memo := Map()
        for o in RSET_OPTS {
            if !o.HasOwnProp("f")
                continue
            for m in o.f {
                for k, v in m {
                    if !memo.Has(k)
                        memo[k] := o
                }
            }
        }
    }
    return memo.Has(name) ? memo[name] : 0
}
RSetFlagRowName(name) {
    o := RSetFlagRowOf(name)
    return o ? o.n : ""
}

; ---- rows whose flags have been taken over ----
; A row is LOCKED when any flag it could write is sitting in RSET.extra. Setting
; it back to AUTO was not enough on its own: nothing stopped the user picking a
; value again, and if they did, the row would write its flags AND the overrides
; would still win in RSetFlags - a control that visibly moves and changes
; nothing. So a locked row is drawn out and refuses the pointer, and the way to
; get it back is to remove the override that took it, which is where the flag
; now lives.
;
; Memoised on the same counter the flag list watches, because this is read once
; per row per frame and walking every choice of every row to answer it would be
; the third time this module made that mistake.
RSetLockedRows() {
    static sig := -1, memo := 0
    ; ---- nothing to lock when nothing is contested ----
    ; The lock exists so one flag cannot have two writers. With FLAG SOURCE set
    ; to CLIENT SYSTEMS the overrides are not written at all, so there is no
    ; second writer and no reason to hold the rows down - they are the only
    ; thing reaching the file and they had better be usable.
    if !RSetSrcExtra()
        return Map()
    if (memo && sig = RSET.fxVer)
        return memo
    m := Map()
    for k, v in RSET.extra {
        o := RSetFlagRowOf(k)
        if o
            m[o.k] := 1
    }
    sig := RSET.fxVer, memo := m
    return m
}
RSetRowLocked(o) => RSetLockedRows().Has(o.k)

; ---- taking a row over ----
; Editing or adding a flag that a row writes hands the WHOLE row to the user:
; every flag that row is currently writing becomes an override at its present
; value, and the row itself drops to its leave-alone choice. Two reasons it is
; the whole row rather than the one flag you touched.
;
; A row is one SETTING, not one flag. MESH QUALITY writes four switching
; distances that only mean anything together; RENDERING MODE's Vulkan choice is
; a preference flag plus the D3D11 disable that makes the preference take. Move
; one and leave the rest to a control that is about to be switched off and you
; have half a setting, silently.
;
; And it keeps ONE writer per flag. Before this, an override and the row that
; owned it could both be live, with the merge order in RSetFlags quietly
; deciding the winner - two controls for one value, one of them lying.
RSetTakeRow(o) {
    if (!o || !o.HasOwnProp("f"))
        return 0
    i := RSetIdx(o)
    if (i <= 1 || i > o.f.Length)
        return 0                   ; the row is already leaving Roblox alone
    n := 0
    for k, v in o.f[i] {
        if !RSET.extra.Has(k) {
            RSET.extra[k] := v
            RSET.fxFlash[k] := A_TickCount
            n++
        }
    }
    RSET.pick[o.k] := 1
    RSET.flashAt[o.k] := A_TickCount
    try IniWrite(1, iniPath, "rset", o.k)
    RSetExtraSave()
    return n
}

; Which preset row a derived pair came from, so the editor can say why a flag is
; there and which control owns it.
RSetFlagOwner(name) {
    for o in RSET_OPTS {
        if !o.HasOwnProp("f")
            continue
        i := RSetIdx(o)
        if (i <= 1 || i > o.f.Length)
            continue
        if o.f[i].Has(name)
            return o.n
    }
    return ""
}
; A flag name has to look like one. Roblox's are prefix + CamelCase and nothing
; else, and a name with a space or a quote in it would corrupt the JSON the
; module writes rather than simply not working.
RSetFlagNameOK(n) {
    n := Trim(n)
    if (StrLen(n) < 4 || StrLen(n) > 96)
        return 0
    if !RegExMatch(n, "^[A-Za-z][A-Za-z0-9_]*$")
        return 0
    return 1
}

RSetApply() {
    ; This module deliberately does NOT stage into the FAST FLAG MANAGER. The
    ; two systems own different things: the manager owns a hand-curated set it
    ; injects into a running client, this owns a small set it writes to
    ; ClientAppSettings.json for the next launch. Sharing the staged list meant
    ; CLEAR ALL or loading a preset silently wiped these, and applying these
    ; silently grew the user's staged list.
    ;
    ; ONE exception, below: the framerate cap is also pushed into a running
    ; client. It is a dynamic flag, so it does not need a restart to take -
    ; and a cap that only applies next launch is the single most irritating
    ; thing in this panel. It still writes to the file as well, so the setting
    ; survives a restart either way.
    nf  := RSetFlags().Count
    ncs := RSetWriteAppSettings(1)

    ; Roblox holds this file open, keeps its values in memory and rewrites it
    ; on exit. Writing under a running client is therefore pointless at best
    ; and lost at worst, which is exactly how a launcher behaves - Fishstrap
    ; only ever touches it while Roblox is closed. So do the same, and say so
    ; instead of writing into the void.
    nx := 0, xerr := 0, xmiss := 0, xbusy := 0
    if ProcessExist("RobloxPlayerBeta.exe")
        xbusy := 1
    path := xbusy ? "" : RSetXml(true)
    if (path != "") {
        RSetEnsureDirs()
        try FileSetAttrib("-R", path)
        if !FileExist(RSetXmlBak())
            try FileCopy(path, RSetXmlBak(), 0)
        body := ""
        try body := FileRead(path, "UTF-8")
        if (body = "")
            xerr++
        else {
            want := Map()
            for o in RSET_OPTS {
                if !o.HasOwnProp("xml")
                    continue
                i := RSetIdx(o)
                if (i <= 1 || i > o.x.Length || o.x[i] = "")
                    continue
                if RSetXmlSet(&body, o.xml, o.x[i], o.HasOwnProp("xt") ? o.xt : "int")
                    want[o.xml] := o.x[i]
                else
                    xerr++
                ; the raw twin, where the file has one - see RSetXmlTwin. AUTO
                ; (x = "0") means "let the client decide", so the twin is
                ; removed rather than pinned to a number.
                if ((tw := RSetXmlTwin(o)) != "") {
                    if (o.x[i] = "0") {
                        if RSetXmlDel(&body, tw)
                            want[tw] := ""
                    } else if RSetXmlSetExisting(&body, tw, o.x[i])
                        want[tw] := o.x[i]
                }
            }
            if want.Count {
                ok := 0
                try {
                    fh := FileOpen(path, "w", "UTF-8")
                    fh.Write(body)
                    fh.Close()
                    ok := 1
                }
                if ok {
                    ; read it straight back - the only honest way to know the
                    ; write landed, and what told us the framerate cap was
                    ; never actually reaching the file
                    own := RSetXmlOwned()
                    for k, v in want {
                        if (RSetXmlRead(path, k) = v) {
                            nx++
                            ; record only what verified. REVERT clears this set,
                            ; so a property we did not manage to write must not
                            ; end up on the list of things we owe an undo for.
                            own[k] := (v = "") ? "`f" : v
                        }
                        else
                            xmiss++
                    }
                    RSetXmlOwnSave(own)
                    ; the lock is what stops the client putting its own values
                    ; back the moment it closes
                    if nx
                        try FileSetAttrib("+R", path)
                } else
                    xerr += want.Count
            }
        }
        RSetReadXml()
    }

    fo  := RSetBy("font")
    nfo := (fo && RSetIdx(fo) > 1) ? RSetFontApply() : 0
    lg  := RSetBy("logo")
    nlg := (lg && RSetIdx(lg) > 1) ? RSetLogoApply(1) : 0
    ; A logo staged against a client with no matching file writes nothing and
    ; used to report success anyway - which is exactly what "I changed it and
    ; nothing happened" looks like from the outside.
    lgs := RSetBy("logos")
    nlg += (lgs && RSetIdx(lgs) > 1) ? RSetLogoApply(2) : 0
    ; live cap - see RSetFpsLive for what each code means
    lfp := RSetFpsLive()
    lgWanted := (lg  && RSetIdx(lg)  > 1 && RSET.logo  != "")
             || (lgs && RSetIdx(lgs) > 1 && RSET.logoS != "")
    ; The shortcut icon is not a separate feature - it is the same image
    ; reaching the one place a content file cannot, so it rides the same rows.
    nai := 0
    if (lg  && RSetIdx(lg)  > 1)
        nai += RSetIconApply(1)
    if (lgs && RSetIdx(lgs) > 1)
        nai += RSetIconApply(2)


    RSET.on := 1
    RSET.applyAt := A_TickCount
    try IniWrite(1, iniPath, "rset", "on")
    rbx := ProcessExist("RobloxPlayerBeta.exe") ? "  -  RESTART ROBLOX" : ""
    fs  := nfo ? (", " nfo " FONT FILE(S)") : ""
    fs  .= nlg ? (", " nlg " LOGO FILE(S)") : ""
    fs  .= nai ? (", " nai " SHORTCUT ICON(S)") : ""
    ; The cap is the one row that can report on the RUNNING client, so it says
    ; whether the change is already in effect or still waiting on a restart.
    fs  .= (lfp = 1)  ? ", FPS CAP LIVE NOW"
         : (lfp = 2 || lfp = 3) ? ", FPS CAP SAVED - RESTART ROBLOX TO GO ABOVE 240"
         : (lfp = -1) ? ", FPS CAP NEEDS A RESTART"
                      : ""
    ; Only claim nothing happened when NEITHER half did anything. The icon
    ; reaching the shortcuts while no texture matched is a partial success, and
    ; reporting that as a flat failure would send you looking for a fault that
    ; is not there.
    if (lgWanted && !nlg && !nai)
        fs .= ", LOGO MATCHED NOTHING"
    xw := 0
    for o in RSET_OPTS {
        if (o.HasOwnProp("xml") && RSetIdx(o) > 1)
            xw++
    }
    if (xbusy && xw)
        RSetSay(nf " FLAG(S) WRITTEN  -  CLOSE ROBLOX, THEN APPLY AGAIN FOR THE REST", AMBER)
    else if (xmiss || xerr)
        RSetSay("WROTE " nx " OF " xw " VALUE(S) - THE REST WOULD NOT STICK", C_OFF)
    else if (ncs || nx || nfo)
        RSetSay("APPLIED  " nf " FLAG(S) TO " ncs " CLIENT(S), " nx " VALUE(S)" fs rbx, C_ON)
    else if (nf && !ncs)
        RSetSay("NO ROBLOX INSTALL FOUND TO WRITE TO", C_OFF)
    else
        RSetSay("NOTHING TO APPLY - EVERY ROW IS ON AUTO", AMBER)
    HubPoke()
}

; ---- the client settings file half of REVERT, on its own ----
; Pulled out of RSetRevert so the watcher below can run the same thing later.
; It edits the live file in place and DELETES the properties this module can
; write. UserGameSettings is an ordinary instance with built-in defaults, so a
; property that is not in the XML is that property at its shipped Roblox value,
; and the client writes the element back itself the next time it saves. That
; is "back to the Roblox default" without this suite having to hold an opinion
; about what the default is - and it is the one form of the undo a poisoned
; baseline cannot corrupt (RSetXmlOwnPath explains the whole-file backup that
; used to replay the applied settings). Properties this module never writes
; are not touched at all.
;
; It refuses while a client is up, for the reason APPLY refuses: Roblox holds
; the file open, keeps its values in memory and rewrites it from that copy on
; exit, so an edit underneath it is discarded. Refusing here does not mean a
; second press any more - RSetXmlPendTick finishes it when the client closes.
;
; Returns {nx, pend}: how many properties came out, and whether the file half
; is still owed - by a running client, an unreadable file or a failed write. A
; file that cannot be FOUND is not owed: there is nothing to put back, so the
; records are cleared rather than left to keep a watcher alive for nothing.
RSetXmlRevertFile() {
    r := {nx: 0, pend: 0}
    if !RSetXmlOwes()
        return r
    if ProcessExist("RobloxPlayerBeta.exe") {
        r.pend := 1
        return r
    }
    bak := RSetXmlBak()
    path := RSetXml(true)
    if (path = "") {
        RSetXmlOwnSave(Map())
        try FileDelete(bak)
        return r
    }
    ; drop the read-only lock first or nothing below can touch the file, and
    ; leave it dropped so the client owns its settings again
    try FileSetAttrib("-R", path)
    body := ""
    try body := FileRead(path, "UTF-8")
    if (body = "") {
        r.pend := 1
        return r
    }
    cut := 0
    for prop, tg in RSetXmlProps() {
        if RSetXmlDel(&body, prop)
            cut++
    }
    ok := 1
    if cut {
        ok := 0
        try {
            fh := FileOpen(path, "w", "UTF-8")
            fh.Write(body)
            fh.Close()
            ok := 1
        }
    }
    if !ok {
        r.pend := 1                          ; a failed write stays revertable
        RSetReadXml()
        return r
    }
    ; verified the same way APPLY verifies its writes: read the file back and
    ; see that nothing of ours is left in it
    left := 0
    for prop, tg in RSetXmlProps() {
        if (RSetXmlRead(path, prop) != "")
            left++
    }
    if left
        r.pend := 1
    else {
        r.nx := cut
        ; the record and the old whole-file backup have both done their job;
        ; the next APPLY captures a clean one
        RSetXmlOwnSave(Map())
        try FileDelete(bak)
    }
    RSetReadXml()
    return r
}

; ---- and the watcher that finishes it ----
; REVERT under a running client used to end with "close Roblox, then revert
; again", and the second press was the one thing nobody did: the panel read
; REVERTED, the file still carried GRAPHICS QUALITY 10, and the next launch
; picked it up. Now the module is switched off at the first press and this
; waits for the client to leave, then clears the file. Armed by REVERT and by
; RSetBoot (a revert left pending by a previous session survives in the
; records, since the switch is off and the file half is still owed). It stops
; itself the moment there is nothing owed, or APPLY puts the module back on.
RSetXmlPendArm() {
    if (!RSET.on && RSetXmlOwes())
        SetTimer(RSetXmlPendTick, 2000)
}
RSetXmlPendTick() {
    if (RSET.on || !RSetXmlOwes()) {
        SetTimer(RSetXmlPendTick, 0)
        return
    }
    if ProcessExist("RobloxPlayerBeta.exe")
        return
    r := RSetXmlRevertFile()
    if r.pend
        return                               ; unreadable or unwritable right now - try again in 2 s
    SetTimer(RSetXmlPendTick, 0)
    RSetSay((r.nx ? (r.nx " CLIENT SETTING(S) BACK TO ROBLOX DEFAULT") : "CLIENT SETTINGS FILE CLEAN")
          . "  -  REVERT FINISHED", C_ON)
    HubPoke()
}

RSetRevert() {
    ; nothing to unstage - see RSetApply, this module never put anything in
    ; the flag manager. Every name it knows comes out of the client files
    ; (RSetWriteAppSettings, RSetKnownKeys); nf is what was actually there.
    RSET.wrCut := 0
    ncs := RSetWriteAppSettings(0)
    nf := RSET.wrCut

    ; the client settings file half - see RSetXmlRevertFile; under a running
    ; client it is owed, and RSetXmlPendTick pays it when the client closes
    xr := RSetXmlRevertFile()
    nx := xr.nx, xpend := xr.pend

    nfo := RSetFontRevert()
    nlg := RSetLogoRevert()
    nai := RSetIconRevert()
    ; the half of the framerate cap that lives in the running client rather
    ; than in a file - see RSetFpsLiveRevert
    lfp := RSetFpsLiveRevert()

    ; ---- the hub's half, unconditionally ----
    ; The rows, the flag overrides, the flag source and the staged files all go
    ; back to their defaults here, whatever the client file is still owed. They
    ; used to wait on the file half - the argument was that a default-looking
    ; panel over a client not yet on the defaults is a lie - but the file half
    ; now finishes on its own, and what the wait actually produced was the
    ; report that started this: REVERT pressed with Roblox open, every row
    ; still showing what was applied, and no visible reason why. The undo does
    ; not run off the picks (RSetXmlOwned, RSetPrevPath and RSET.bakLog carry
    ; it), so clearing them cannot strand anything still owed.
    nr := RSetHubToDefault()

    ; Off, whatever is still owed: the module is no longer applying anything,
    ; and RSetXmlPendTick reads this to know the pending file half is a revert
    ; and not an apply it should leave alone.
    RSET.on := 0
    RSET.applyAt := A_TickCount
    try IniWrite(0, iniPath, "rset", "on")
    if xpend
        RSetXmlPendArm()
    rbx := ProcessExist("RobloxPlayerBeta.exe") ? "  -  RESTART ROBLOX" : ""
    xs  := nx ? (", " nx " CLIENT SETTING(S) BACK TO ROBLOX DEFAULT") : ""
    fs  := nfo ? (", " nfo " FONT FILE(S)") : ""
    fs  .= nlg ? (", " nlg " LOGO FILE(S)") : ""
    fs  .= nai ? (", " nai " SHORTCUT ICON(S)") : ""
    ; The cap is the one row that can report on the RUNNING client, on the way
    ; back out as much as on the way in.
    fs  .= (lfp > 0)  ? ", FPS CAP LIFTED LIVE"
         : (lfp = -1) ? ", FPS CAP NEEDS A RESTART"
                      : ""
    fs  .= nr ? (", " nr " SETTING(S) BACK TO DEFAULT") : ""
    if xpend
        RSetSay("REVERTED " nf " FLAG(S)" fs "  -  THE CLIENT SETTINGS FILE GOES BACK WHEN ROBLOX CLOSES", AMBER)
    else
        RSetSay("REVERTED  " nf " FLAG(S) FROM " ncs " CLIENT(S)" xs fs rbx, C_ON)
    HubPoke()
}

; ---- every setting the hub holds for this module, back to its default ----
; RSetRowsToDefault covers the rows. REVERT also owes the rest of what the
; panel keeps: the flags typed into EDIT FAST FLAGS, the FLAG SOURCE choice,
; and the font and logo files picked for their rows - all of which the next
; APPLY would otherwise put straight back. Deliberately NOT the FAST FLAG
; MANAGER's staged list: that module owns its own set, and this one never
; touches it (see RSetApply). Returns how many things actually changed.
RSetHubToDefault() {
    global rsetSrcOn, rsetSrcSel
    ; the EDIT FAST FLAGS page can be up - the header's REVERT reaches past it -
    ; and its list is about to be emptied. A field left live would keep a caret
    ; on a row that no longer exists, so the edit is dropped (not committed:
    ; whatever was typed is being reverted too) and the page steps out.
    if RSET.fx {
        try FFMEndEdit(false)
        RSetFxClose()
    }
    n := RSetRowsToDefault()
    ; EDIT FAST FLAGS: the overrides, and the page's own state around them
    if RSET.extra.Count {
        n += RSET.extra.Count
        RSET.extra := Map()
        RSET.fxGone := Map()
        RSET.fxSel := "", RSET.fxName := "", RSET.fxVal := ""
        RSET.fxScr := 0.0, RSET.fxScrT := 0.0
        RSetExtraSave()                      ; persists, and bumps the flag list's memo
    }
    ; FLAG SOURCE: back to MIX
    if (rsetSrcOn || rsetSrcSel != 1) {
        n++
        rsetSrcOn := 0, rsetSrcSel := 1
        RSET.srcAt := A_TickCount
        RSET.flashAt["src"] := A_TickCount
        try IniWrite(0, iniPath, "rset", "srcon")
        try IniWrite(1, iniPath, "rset", "srcpick")
        RSetFxBump()                         ; the row locks read off this
    }
    ; the staged files: rows are already on KEEP, this forgets what they held
    if (RSET.font != "") {
        n++
        RSET.font := ""
        try IniWrite("", iniPath, "rset", "fontfile")
    }
    if (RSET.logo != "" || RSET.logoS != "" || RSET.logoSub != "" || RSET.logoSubS != "") {
        n++
        RSET.logo := "", RSET.logoS := ""
        RSET.logoSub := "", RSET.logoSubS := ""
        try IniWrite("", iniPath, "rset", "logofile")
        try IniWrite("", iniPath, "rset", "logofileS")
        try IniWrite("", iniPath, "rset", "logosub")
        try IniWrite("", iniPath, "rset", "logosubS")
        RSetLogoLoad()                       ; drops both staged previews
        RSetLogoScan(1, true)
    }
    return n
}

RSetToggle() {
    ; NOT `RSET.on ? A() : B()` - a statement that opens with a member access
    ; is parsed as a method call, so AHK read it as RSET.on(? A() : B()).
    ; A bare variable in that position is fine (see AbToggleFromHub); a
    ; property is not.
    if RSET.on
        RSetRevert()
    else
        RSetApply()
}

; Every row back to its leave-alone choice. Index 1 is that choice on every
; control in the table by construction - "AUTO", "KEEP" or "DEFAULT" depending
; on the row - and it is the one index that makes this module write nothing at
; all. So it is also the picture that matches a client running Roblox's own
; settings, which is why REVERT ends here as well as RESET.
;
; Note it is NOT the same as picking AUTO on a row that has one: GRAPHICS
; QUALITY index 1 is KEEP (write nothing) and index 2 is AUTO (write
; SavedQualityLevel 0). Sending the row to AUTO would leave the next APPLY with
; something to write, which is the opposite of reverted.
;
; Returns how many rows actually moved, so a caller can report a change instead
; of claiming one that did not happen.
RSetRowsToDefault() {
    RSetDDClose()
    n := 0
    for o in RSET_OPTS {
        if (RSetIdx(o) != 1) {
            RSET.flashAt[o.k] := A_TickCount
            n++
        }
        RSET.pick[o.k] := 1
        try IniWrite(1, iniPath, "rset", o.k)
    }
    ; the preset chips light from RSetPresetActive, which is derived from the
    ; picks - so they clear themselves. This is only the flash marker.
    RSET.preset := 0
    return n
}

RSetReset() {
    RSetRowsToDefault()
    RSetSay("ALL ROWS BACK TO AUTO", 0)
    HubPoke()
}

RSetOpenXml() {
    p := RSetXml(true)
    if (p = "") {
        RSetSay("NO CLIENT SETTINGS FILE FOUND", C_OFF)
        return
    }
    try Run('explorer.exe /select,"' p '"')
    RSetSay("OPENED THE CLIENT SETTINGS FILE", 0)
}

RSetBoot() {
    ; rsetSrcOn and rsetSrcSel are ASSIGNED below, restoring FLAG SOURCE from the
    ; ini. Without this they would be locals and the restore would land nowhere -
    ; which is the same shape as the write-but-never-read bug it is fixing.
    global rsetSrcOn, rsetSrcSel
    RSetEnsureDirs()
    ; one-time reset of a stored MESH QUALITY pick. Its option list changed
    ; shape when the distance-ladder fix landed, so an index saved by an older
    ; build points at a different tier now - and every one of those old tiers
    ; was the broken near-zero-distance mapping. Sending it back to AUTO once
    ; makes the fix visible rather than restoring a look the user reported as
    ; wrong. Guarded by a version stamp so it happens exactly once.
    meshFix := 0
    try meshFix := Integer(IniRead(iniPath, "rset", "meshladder", "0"))
    if !meshFix {
        try IniDelete(iniPath, "rset", "mesh")
        try IniWrite(1, iniPath, "rset", "meshladder")
    }
    for o in RSET_OPTS {
        v := 1
        try v := Integer(IniRead(iniPath, "rset", o.k, "1"))
        RSET.pick[o.k] := Clamp(v, 1, o.v.Length)
    }
    RSetExtraLoad()                    ; the raw flag layer - see RSET.extra
    try RSET.font := IniRead(iniPath, "rset", "fontfile", "")
    if (RSET.font != "" && !FileExist(RSET.font))
        RSET.font := ""
    try RSET.logo := IniRead(iniPath, "rset", "logofile", "")
    if (RSET.logo != "" && !FileExist(RSET.logo))
        RSET.logo := ""
    RSetLogoLoad()
    try RSET.logoS := IniRead(iniPath, "rset", "logofileS", "")
    if (RSET.logoS != "" && !FileExist(RSET.logoS))
        RSET.logoS := ""
    RSetIcoLoad()
    RSetBakLoad()                      ; what APPLY overwrote - see RSetBakLog
    try RSET.logoSub  := IniRead(iniPath, "rset", "logosub", "")
    try RSET.logoSubS := IniRead(iniPath, "rset", "logosubS", "")
    if (RSET.font = "")
        RSET.pick["font"] := 1
    try rsetSrcOn := Integer(IniRead(iniPath, "rset", "srcon", "0"))
    try rsetSrcSel := Clamp(Integer(IniRead(iniPath, "rset", "srcpick", "1")), 1, 2)
    RSET.srcT := rsetSrcOn ? 1.0 : 0.0
    RSET.srcSelT := rsetSrcSel + 0.0
    try RSET.on := Integer(IniRead(iniPath, "rset", "on", "0"))
    RSET.onT := RSET.on ? 1.0 : 0.0
    RSetXml(true)
    RSET.msg := RSET.on ? "APPLIED" : "NOT APPLIED"
    RSET.msgCol := RSET.on ? C_ON : 0xFFC7CBE0
    ; a REVERT that could not reach the client settings file last session -
    ; Roblox was up - is still owed; the watcher finishes it once it is not
    RSetXmlPendArm()
}

; ---------------- CLIENT SETTINGS: geometry ----------------
; Slider track and dropdown both hang off the same right-hand column, so the
; two live here rather than being spelled out in the zone test and the renderer
; separately - they were never allowed to disagree.
; RESTING positions, for hit-testing only. Both are built from HL.abx, which is
; where the panel sits when nothing is animating - they do NOT carry the page
; slide (dx) or the row slide (sld). The renderer must derive these from the
; origin it was handed instead, or the track and the chip stay put while the
; rest of their row slides in. That was the bug behind the graphics-quality
; slider and the D3D11 / VOXEL chips hanging back during a tab change.
; QUALITY PRESET's three chips start here, measured from the row origin. The hit
; test and the renderer each worked this out for themselves, and the hint width
; did not know about it at all - which is how the description came to run four
; pixels under the first chip.
RSetPresetChipW() => 60
RSetPresetChipG() => 6
RSetPresetChipX() => HL.abw - 16 - RSetPresetChipW()*3 - RSetPresetChipG()*2
; FLAG SOURCE's three targets. Derived here for the same reason the track and
; the chip are: the renderer and the hit test must not each own a copy.
RSetSrcSwX() => HL.abw - 202       ; switch, relative to the row origin
RSetSrcSwW() => 34
RSetSrcSgX() => HL.abw - 158       ; the first segment
RSetSrcSgW() => 71                 ; each, side by side with no gap
RSetTrackX() => HL.abx + HL.abw - 200
RSetTrackW() => 132
RSetChipX()  => HL.abx + HL.abw - 118
RSetChipW()  => 102
; ---- entries that cannot take effect without a restart ----
; Only the framerate row has any, and only above 240: the flag that lifts that
; ceiling is read once at process start, so a value picked while Roblox is
; already running is saved but inert until next launch. Marking those entries
; in the list is the only place the warning arrives BEFORE the choice rather
; than after it.
RSetDDWarn(o, it) {
    if (o.k != "fps" || !o.HasOwnProp("x") || it < 1 || it > o.x.Length)
        return false
    v := o.x[it]
    return (v != "" && IsInteger(v) && Integer(v) > 240)
}
RSetDDNote(o) => (o.k = "fps") ? "marked entries only work if set before roblox opens" : ""
; The note needs room the chip-width popup does not have, so a list that
; carries one grows LEFTWARD - it stays anchored to the chip on the right.
RSetDDPad(o)  => (RSetDDNote(o) != "") ? 116 : 0
RSetDDH(o)    => Min(o.v.Length, 7)*23 + 8 + (RSetDDNote(o) != "" ? 24 : 0)

; Where the popup sits RIGHT NOW. Recomputed on every hit test and every frame
; from the row's live position, because the row moves when the panel scrolls -
; anchoring once at open time left the popup behind while its own chip slid
; away, and the flip-up decision went stale with it.
RSetDDGeom(i, &dy, &up) {
    ry := HL.aby + RSetRowY(i) - RSET.scr
    h  := RSetDDH(RSET_OPTS[i])
    up := 0
    dy := ry + 30
    if (dy + h > HL.pd + HL.ch - 14)
        dy := ry + 6 - h, up := 1
    dy := Clamp(dy, HL.pd + 8, HL.pd + HL.ch - h - 8)
}

; the popup only lives while the row it belongs to is still in the panel
RSetDDVisible(i) {
    if (i < 1 || i > RSET_OPTS.Length)
        return false
    ry := HL.aby + RSetRowY(i) - RSET.scr
    return (ry + HL.rsrh >= HL.aby + 4 && ry <= HL.aby + HL.ffh - 4)
}

; screen X -> step index for a slider row
RSetSlideSet(i, sx) {
    o := RSET_OPTS[i]
    k := HL.pw/HL.bw
    ux := (sx - HL.px)/k
    fr := Clamp((ux - RSetTrackX())/RSetTrackW(), 0.0, 1.0)
    nv := 1 + Round(fr*(o.v.Length - 1))
    if (RSetIdx(o) != nv) {
        RSET.pick[o.k] := nv
        RSET.flashAt[o.k] := A_TickCount
        try IniWrite(nv, iniPath, "rset", o.k)
        if RSET.on
            RSetSay("CHANGED - PRESS APPLY AGAIN TO WRITE IT", AMBER)
    }
    HubPoke()
}

; ---------------- CLIENT SETTINGS: hit zones ----------------
; 901..914 row bodies / sliders / action buttons, 920 scrollbar,
; 921 master switch, 922 reset, 923 open file, 924 font browse,
; 930 inert card background, 939 dropdown backdrop, 940+ dropdown items
; Mirrors RSetFxPage exactly. Every rectangle here is the one the renderer
; draws, computed the same way from the same constants - a hit test that
; re-derives its own geometry is a hit test that drifts the first time the
; layout moves.
RSetFxZone(ux, uy) {
    ax := HL.abx, ay := HL.aby
    hy := ay + 10
    if (ux >= ax + HL.abw - 88 && ux <= ax + HL.abw - 16
        && uy >= hy - 3 && uy <= hy + 19)
        return 1600                          ; BACK
    if (ux >= ax + HL.abw - 172 && ux <= ax + HL.abw - 96
        && uy >= hy - 3 && uy <= hy + 19)
        return 1604                          ; DATABASE / LIST
    ay2  := hy + 48
    lTop := ay2 + 36
    lBot := ay + RSetFxH() - 8
    ; ---- the database body owns the panel below the header ----
    ; Keyed on RSET.db, the INTENT, not on the eased dbT - the same distinction
    ; the page itself is keyed on. Mid-crossfade the other body is still faintly
    ; drawn underneath, and a click landing on a control the user can barely see
    ; is exactly what this ordering exists to prevent.
    if RSET.db {
        if (ux >= ax + 16 && ux <= ax + HL.abw - 16 && uy >= ay2 && uy <= ay2 + 26)
            return 1606                      ; the filter field
        dl := RSetDbList()
        if (dl.Length*RSET_DBRH > lBot - lTop
            && ux >= ax + HL.abw - 22 && ux <= ax + HL.abw - 8
            && uy >= lTop && uy <= lBot)
            return 1607                      ; scrollbar
        if (uy >= lTop && uy <= lBot) {
            ; the renderer's own arithmetic, run backwards: slot k, not the
            ; absolute row, so the band is a fixed size however long the list is
            ry0 := lTop + 4 - Mod(RSET.dbScr, RSET_DBRH)
            k := Floor((uy - ry0)/RSET_DBRH) + 1
            idx := Floor(RSET.dbScr/RSET_DBRH) + k
            if (k >= 1 && k <= RSET_DBSLOTS && idx >= 1 && idx <= dl.Length)
                return RSET_FXZDB + k
        }
        return 1608                          ; page background - swallows it
    }
    nw  := Round((HL.abw - 32)*0.52), vw := HL.abw - 32 - nw - 76
    if (uy >= ay2 && uy <= ay2 + 26) {
        if (ux >= ax + 16 && ux <= ax + 16 + nw)
            return 1601                      ; name field
        if (ux >= ax + 16 + nw + 8 && ux <= ax + 16 + nw + 8 + vw)
            return 1602                      ; value field
    }
    if (ux >= ax + HL.abw - 76 && ux <= ax + HL.abw - 16
        && uy >= ay2 + 1 && uy <= ay2 + 25)
        return 1603                          ; ADD
    lTop := ay2 + 36, lBot := ay + RSetFxH() - 8
    ; ONE build, reused. This asked RSetFxTotal() for the scrollbar test and
    ; then RSetFxList() again for the rows, and RSetFxTotal is nothing but a
    ; length taken off its own call to RSetFxList - so every hit test rebuilt
    ; and re-sorted the whole list twice. The hit test runs from WM_NCHITTEST,
    ; from WM_SETCURSOR and once more per frame out of HubRender, which made it
    ; several full rebuilds per mouse move. The list is a local; take it once.
    rows := RSetFxList()
    nw9 := A_TickCount
    if (RSetFxTotalOf(rows, nw9) > lBot - lTop
        && ux >= ax + HL.abw - 22 && ux <= ax + HL.abw - 8
        && uy >= lTop && uy <= lBot)
        return 1699                          ; scrollbar
    if (uy >= lTop && uy <= lBot) {
        yacc := lTop + 6 - RSET.fxScr
        for i2, e in rows {
            ; past the band's capacity there is no id left that means this row
            ; and nothing else, so it stops being clickable rather than
            ; borrowing an id that belongs to a different row's delete
            if (i2 > RSET_FXZMAX)
                break
            ry := yacc
            yacc += RSetFxRowPitch(e, nw9)
            ; a row on its way out answers nothing - it is a picture of where a
            ; row used to be, and the live rows have already closed over it
            if e.HasOwnProp("gone")
                continue
            if (uy < ry || uy > ry + RSET_FXRH - 4)
                continue
            ; ---- the same eased geometry the renderer uses ----
            ; The remove control is only on the row holding the caret, and the
            ; value box slides over to make room for it, so both rectangles move
            ; with the focus. Derived from the same call rather than from a copy
            ; of the number, because a hit test that re-derives its own geometry
            ; is a hit test that drifts the first time the layout moves.
            fc := RSetFocOf(e.n)
            if (e.ext && fc > 0.35
                && ux >= ax + HL.abw - 46 && ux <= ax + HL.abw - 20)
                return RSET_FXZDEL + i2      ; delete
            vwid := 150
            vx := ax + HL.abw - 20 - vwid - (e.ext ? 34*fc : 0)
            if (ux >= vx && ux <= vx + vwid)
                return RSET_FXZVAL + i2      ; the value field
            return 1609
        }
    }
    return 1608                              ; page background - swallows the click
}

RSetZone(ux, uy) {
    ax := HL.abx, ay := HL.aby
    ; an open dropdown owns every pixel until it closes
    if RSET.dd {
        o := RSET_OPTS[RSET.dd]
        n := Min(o.v.Length, 7)
        ; must match the renderer exactly - a list that carries a note grows
        ; leftward, and hit-testing the old width would leave the extra strip
        ; dead while still swallowing the click
        pad := RSetDDPad(o)
        dx := RSetChipX() - 4 - pad, dw := RSetChipW() + 8 + pad
        RSetDDGeom(RSET.dd, &ddy, &ddup)
        if (ux >= dx && ux <= dx + dw && uy >= ddy + 4 && uy <= ddy + 4 + n*23) {
            it := Floor((uy - ddy - 4)/23) + 1
            if (it >= 1 && it <= n)
                return 939 + it
        }
        return 939
    }
    ; ---- the page owns the panel whenever it is up ----
    ; Tested before anything else inside the panel: the rows are still being
    ; drawn underneath during the cross-fade, and a hit test that reached them
    ; would let a click land on a control the user can barely see. Keyed on
    ; RSET.fx, the INTENT, not on the eased fxT - the same distinction
    ; HubBodyLive exists for.
    ; RSetFxH(), not HL.ffh: the page now extends over the STATE card's band, so
    ; a hit test stopping at the panel height would leave the bottom third of
    ; the list unclickable while it is plainly on screen.
    if (RSET.fx && uy >= ay && uy <= ay + RSetFxH() && ux >= ax && ux <= ax + HL.abw)
        return RSetFxZone(ux, uy)
    if (ux >= ax + HL.abw - 96 && ux <= ax + HL.abw
        && uy >= HL.cty + 30 && uy <= HL.cty + 52)
        return 921
    ; 920, not 907 - the row bodies occupy 901..912 and 907 is one of them
    if (RSetTotal() > HL.ffh - 20
        && ux >= ax + HL.abw - 12 && ux <= ax + HL.abw
        && uy >= ay + 10 && uy <= ay + HL.ffh - 10)
        return 920
    if (uy >= ay + 6 && uy <= ay + HL.ffh - 6 && ux >= ax && ux <= ax + HL.abw) {
        loop RSET_SYSN {
            i := A_Index
            ry := ay + RSetRowY(i) - RSET.scr
            if (uy >= ry && uy <= ry + HL.rsrh) {
                ; Three separate targets in one row - tested before the
                ; control-column catch-all below, which would otherwise swallow
                ; all three into the row zone.
                if (RSET_OPTS[i].ui = "source") {
                    if (ux >= ax + RSetSrcSwX() && ux <= ax + RSetSrcSwX() + RSetSrcSwW()
                        && uy >= ry + 8 && uy <= ry + 30)
                        return 933                   ; the switch
                    loop 2 {
                        q2 := A_Index
                        sx2 := ax + RSetSrcSgX() + (q2 - 1)*RSetSrcSgW()
                        if (ux >= sx2 && ux <= sx2 + RSetSrcSgW()
                            && uy >= ry + 8 && uy <= ry + 32)
                            return 933 + q2          ; 934 / 935
                    }
                    return 1080 + i                  ; the rest of the row explains
                }
                if (RSET_OPTS[i].ui = "preset") {
                    pw3 := RSetPresetChipW(), pg3 := RSetPresetChipG()
                    px3 := ax + RSetPresetChipX()
                    loop 3 {
                        q := A_Index
                        bx3 := px3 + (q - 1)*(pw3 + pg3)
                        if (ux >= bx3 && ux <= bx3 + pw3 && uy >= ry + 6 && uy <= ry + 36)
                            return 924 + q           ; 925 / 926 / 927
                    }
                    return 1080 + i                  ; the rest of the row explains
                }
                if (RSET_OPTS[i].ui = "file") {
                    kZ := (RSET_OPTS[i].k = "logo") ? 1
                        : (RSET_OPTS[i].k = "logos") ? 2 : 0
                    if kZ {
                        if (ux >= ax + HL.abw - 144 && ux <= ax + HL.abw - 80)
                            return 927 + kZ          ; BROWSE
                        ; No zone at all while the slot is on the Roblox
                        ; default - the button draws inert and must BEHAVE
                        ; inert. Falling through to the row body means a click
                        ; opens the explanation instead of doing nothing.
                        if (ux >= ax + HL.abw - 76 && ux <= ax + HL.abw - 16
                            && RSetLogoOf(kZ) != "")
                            return 930 + kZ          ; APPLY
                    }
                    else if (ux >= ax + HL.abw - 108 && ux <= ax + HL.abw - 16)
                        return 924
                }
                ; ---- the control's OWN rect, not the column it sits in ----
                ; This was a blanket `ux >= ax + HL.abw - 210`: two hundred and
                ; ten pixels wide and the full row tall, handed to the button as
                ; its hover zone. So RESTORE and EDIT lit up from a hundred
                ; pixels away and from above and below themselves, and the
                ; slider knob did the same. A control's hover has to be the
                ; control, or it is announcing a target that is not there.
                ;
                ; The rectangles below are the ones the renderer draws, derived
                ; the same way from the same constants. Anything else in the
                ; column falls through to the row body, which explains - which
                ; is what the column comment said it did all along.
                o9 := RSET_OPTS[i]
                ; a locked row has no working control, so none of its control
                ; rectangles answer - the whole row goes to the explanation,
                ; which is where the reason is written
                if RSetRowLocked(o9)
                    return 1080 + i
                if (o9.ui = "action" || (o9.ui = "file" && o9.k = "font")) {
                    if (ux >= ax + HL.abw - 108 && ux <= ax + HL.abw - 16
                        && uy >= ry && uy <= ry + 26)
                        return RSetRowZ(i)
                }
                else if (o9.ui = "drop") {
                    if (ux >= ax + HL.abw - 118 && ux <= ax + HL.abw - 16
                        && uy >= ry && uy <= ry + 26)
                        return RSetRowZ(i)
                }
                else if (o9.ui = "slider") {
                    ; The knob is its own target, tested first: it sits ON the
                    ; track, so the track would swallow it. A disc rather than a
                    ; box, because the knob is drawn as one.
                    tx9 := ax + HL.abw - 200, ty9 := ry + 13
                    kx9 := tx9 + RSetTrackW()*RSetSlideFrac(i)
                    if ((ux - kx9)**2 + (uy - ty9)**2 <= 121)
                        return RSetKnobZ(i)
                    ; the track, with a grab margin - a 5px bar is not something
                    ; anyone can be asked to hit exactly
                    if (ux >= tx9 - 6 && ux <= tx9 + RSetTrackW() + 6
                        && uy >= ty9 - 10 && uy <= ty9 + 10)
                        return RSetRowZ(i)
                }
                return 1080 + i
            }
        }
    }
    px := ax, py := HL.ffby, pw := HL.abw
    if (ux >= px && ux <= px + pw && uy >= py && uy <= py + RSETCH) {
        if (uy >= py + RSETCH - 38 && uy <= py + RSETCH - 12) {
            if (ux >= px + pw - 116 && ux <= px + pw - 16)
                return 923
            if (ux >= px + pw - 224 && ux <= px + pw - 124)
                return 922
        }
        return 930
    }
    return 0
}

RSetDDOpen(i) {
    o := RSET_OPTS[i]
    ; no position is stored - RSetDDGeom resolves it live, so the popup tracks
    ; its row through a scroll instead of drifting off it
    RSET.dd := i
    RSET.ddAt := A_TickCount, RSET.ddPrev := i
    ; scroll the list so the chosen row is the one the popup points at
    RSET.ddTop := Max(0, Min(RSetIdx(o) - Min(o.v.Length, 7), o.v.Length - Min(o.v.Length, 7)))
    HubPoke()
}

RSetDDClose() {
    if !RSET.dd
        return
    RSET.dd := 0, RSET.ddAt := A_TickCount
    HubPoke()
}

RSetDDPick(it) {
    if !RSET.dd
        return
    o := RSET_OPTS[RSET.dd]
    idx := RSET.ddTop + it
    if (idx >= 1 && idx <= o.v.Length && idx != RSetIdx(o)) {
        RSET.pick[o.k] := idx
        RSET.flashAt[o.k] := A_TickCount
        try IniWrite(idx, iniPath, "rset", o.k)
        if RSET.on
            RSetSay("CHANGED - PRESS APPLY AGAIN TO WRITE IT", AMBER)
    }
    RSetDDClose()
}

RSetFxClick(z, sx := 0) {
    if (z = 1600) {
        FFM.clickAt[1600] := A_TickCount
        ; BACK steps out one level: out of the database first if it is up, and
        ; only then out of the page. Anything else would throw away the list the
        ; user was halfway through filtering.
        if RSET.db
            RSetDbOpen(0)
        else
            RSetFxClose()
        return
    }
    if (z = 1604) {
        FFM.clickAt[1604] := A_TickCount
        RSetDbOpen(!RSET.db)
        return
    }
    if (z = 1606) {
        if (FFM.edit != "rfd")
            FFMBeginEdit("rfd", 0)
        FFMFldMouse(sx)
        return
    }
    if (z > RSET_FXZDB && z <= RSET_FXZDB + RSET_DBSLOTS) {
        ; the slot is turned back into a row the same way the renderer turns a
        ; row into a slot, and against the list AS IT IS NOW - the filter can
        ; have moved under a click that was hit-tested a frame earlier
        dl := RSetDbList()
        idx := Floor(RSET.dbScr/RSET_DBRH) + (z - RSET_FXZDB)
        if (idx >= 1 && idx <= dl.Length)
            RSetDbPick(dl[idx].n)
        return
    }
    ; ---- clicking a field you are ALREADY in ----
    ; FFMBeginEdit re-reads the buffer from the store every time it runs, and
    ; these two only write back to the store on blur - so clicking into a box you
    ; were already typing in threw away everything since the caret landed. The
    ; flag manager's own boxes hide this because FFMSyncBuf mirrors them into the
    ; store on every keystroke; these cannot, because the store for an override
    ; is the ini. So the entry is skipped when the field is already live, and the
    ; click does what a click in a live field should do: move the caret.
    if (z = 1601) {
        if (FFM.edit != "rfn")
            FFMBeginEdit("rfn", 0)
        FFMFldMouse(sx)
        return
    }
    if (z = 1602) {
        if (FFM.edit != "rfv")
            FFMBeginEdit("rfv", 0)
        FFMFldMouse(sx)
        return
    }
    if (z = 1603) {
        FFM.clickAt[1603] := A_TickCount
        RSetFxAdd()
        return
    }
    ; Both of these index the SAME list the renderer and the hit test used, and
    ; index it again rather than trusting a stored row number: a delete or an
    ; edit reorders nothing, but an add does, and a stale index would act on a
    ; different flag than the one under the pointer.
    rows := RSetFxList()
    if (z > RSET_FXZDEL && z <= RSET_FXZDEL + RSET_FXZMAX) {
        i := z - RSET_FXZDEL
        ; recorded as well as dispatched, so the press dip and the ripple play
        ; whatever the handler goes on to do
        FFM.clickAt[z] := A_TickCount
        if (i >= 1 && i <= rows.Length && rows[i].ext)
            RSetFxDel(rows[i].n)
        return
    }
    if (z > RSET_FXZVAL && z <= RSET_FXZVAL + RSET_FXZMAX) {
        i := z - RSET_FXZVAL
        if (i >= 1 && i <= rows.Length) {
            ; already editing THIS row's value - place the caret, do not re-enter
            if !(FFM.edit = "rfe" && RSET.fxSel = rows[i].n)
                RSetFxEdit(rows[i].n)   ; takes the owning row on the way in
            FFMFldMouse(sx)
        }
        return
    }
    ; 1608 background, 1609 a preset row - both land here and do nothing but
    ; swallow the click, which is what stops it reaching the rows underneath.
}

; Scroll, sharing the systems panel's feel: the page clamps to its own content
; and keeps its own position, so BACK returns the rows exactly where they were.
; Same contract as RSetDragScroll / FFMDragScroll / CurDragScroll: raw screen y
; in, base coordinates derived here, FFMScrollFromY doing the thumb arithmetic
; so every scrollbar in the suite grabs and tracks identically.
RSetFxTop()  => HL.aby + 10 + 48 + 36
RSetFxVis()  => (HL.aby + RSetFxH() - 8) - RSetFxTop()
RSetFxDragScroll(sy) {
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    vis := RSetFxVis(), tot := RSetFxTotal()
    thmb := Max(22, (vis - 8)*(vis/Max(1, tot)))
    RSET.fxScrT := FFMScrollFromY(uy, RSetFxTop() + 4, vis - 8, tot, vis, thmb, RSET.fxScr)
    RSET.fxScr := RSET.fxScrT
    HubPoke()
}

RSetClick(z) {
    if (z >= 940 && z <= 959) {
        RSetDDPick(z - 939)
        FFM.clickAt[z] := A_TickCount
        HubPoke()
        return
    }
    if (z = 939) {
        RSetDDClose()
        return
    }
    if (z = 921)
        RSetToggle()
    else if (z = 922)
        RSetReset()
    else if (z = 923)
        RSetOpenXml()
    else if (z = 924)
        RSetPickFont()
    else if (z = 928)
        RSetPickLogo(1)
    else if (z = 929)
        RSetPickLogo(2)
    else if (z = 931)
        RSetLogoApplyOne(1)
    else if (z = 932)
        RSetLogoApplyOne(2)
    else if (z = 933)
        RSetSrcToggle()
    else if (z = 934 || z = 935)
        RSetSrcSelect(z - 933)
    else if (z >= 925 && z <= 927)
        RSetPreset(z - 924)
    else if (z > RSET_KNOBZ && z <= RSET_KNOBZ + RSET_SYSN) {
        ; the knob and its track start the same drag - they are one control,
        ; split into two zones only so the knob can light up on its own
        i := z - RSET_KNOBZ
        HL.drag := 15, HL.dragZone := z, RSET.sld := i
        DllCall("SetCapture", "ptr", HL.gui.Hwnd)
        CursorXY(&mxk, &myk)
        RSetSlideSet(i, mxk)
    }
    else if (z >= 1301 && z <= 1300 + RSET_SYSN) {
        i := z - 1300
        o := RSET_OPTS[i]
        if (o.ui = "preset") {
            ; the chips are their own zones - the row body only explains
        }
        else if (o.ui = "action") {
            if (o.k = "apply")
                RSetApply()
            else if (o.k = "logorst")
                RSetLogoRestore()
            else if (o.k = "fxedit")
                RSetFxOpen()
            else
                RSetRevert()
        }
        else if (o.ui = "drop")
            RSetDDOpen(i)
        else if (o.ui = "file")
            (o.k = "logo") ? RSetPickLogo(1)
          : (o.k = "logos") ? RSetPickLogo(2) : RSetPickFont()
        else if (o.ui = "slider") {
            HL.drag := 15, HL.dragZone := z, RSET.sld := i
            DllCall("SetCapture", "ptr", HL.gui.Hwnd)
            CursorXY(&mx5, &my5)
            RSetSlideSet(i, mx5)
        }
    }
    if (z > 0)
        FFM.clickAt[z] := A_TickCount
    HubPoke()
}

RSetDragScroll(sy) {
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    vis := HL.ffh - 20, tot := RSetTotal()
    thmb := Max(22, vis*(vis/Max(1, tot)))
    RSET.scrT := FFMScrollFromY(uy, HL.aby + 10, vis, tot, vis, thmb, RSET.scr)
    RSET.scr := RSET.scrT
    HubPoke()
}

; ---------------- CLIENT SETTINGS: the client's font files ----------------
; Roblox reads its typefaces straight out of content\fonts. Every ttf/otf that
; is actually there is a target - the family names change between builds, so
; they are discovered rather than hard-coded. Bloxstrap's Modifications tree
; gets the same names, because a font there survives a client update.
RSetFontTargets() {
    out := [], names := Map()
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return out
    loop Files, lad "\Roblox\Versions\version-*", "D" {
        d := A_LoopFileFullPath "\content\fonts"
        if !DirExist(d)
            continue
        loop Files, d "\*.*" {
            if !RegExMatch(A_LoopFileName, "i)\.(ttf|otf)$")
                continue
            names[A_LoopFileName] := 1
            out.Push({path: A_LoopFileFullPath, dir: d, name: A_LoopFileName, mk: 0})
        }
    }
    if (names.Count && DirExist(lad "\Bloxstrap")) {
        bd := lad "\Bloxstrap\Modifications\content\fonts"
        for nm, v in names
            out.Push({path: bd "\" nm, dir: bd, name: nm, mk: 1})
    }
    return out
}

; ---------------- ROBLOX LOGO ----------------
; Roblox does not publish the name of its logo asset and it has moved between
; builds, so this does NOT hard-code one. It DISCOVERS them: every PNG under
; the client's texture tree whose filename says it is a logo. That is the same
; approach the font row already takes - RSetFontTargets globs content\fonts
; rather than listing typefaces - and it means a Roblox rename costs nothing.
;
; Matching on the name is deliberately the whole test. A logo is the one asset
; class Roblox has always named plainly, and anything caught by mistake is
; backed up first and put back by REVERT, so a false positive is recoverable
; rather than destructive.
global RSET_LOGO_PAT := "i)logo.*\.png$"
; kind 1 = Roblox Player, 2 = Roblox Studio. They install into the SAME
; Versions folder and are told apart only by which executable is inside, which
; is why one scan used to hit both and apply the Player's image to Studio too.
RSetLogoOf(kind)     => (kind = 2) ? RSET.logoS    : RSET.logo
RSetLogoSubOf(kind)  => (kind = 2) ? RSET.logoSubS : RSET.logoSub
RSetLogoExe(kind)    => (kind = 2) ? "RobloxStudioBeta.exe" : "RobloxPlayerBeta.exe"
RSetLogoName(kind)   => (kind = 2) ? "STUDIO" : "PLAYER"

RSetLogoTargets(kind := 1) {
    out := [], rel := Map()
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return out
    exe := RSetLogoExe(kind)
    loop Files, lad "\Roblox\Versions\version-*", "D" {
        ; the executable is the only thing that says which app this folder is
        if !FileExist(A_LoopFileFullPath "\" exe)
            continue
        root := A_LoopFileFullPath "\content\textures"
        if !DirExist(root)
            continue
        rl := StrLen(root) + 2                   ; +2 to step past the separator
        ; An explicit target beats the name pattern outright. The pattern is a
        ; convenience for the common case; this is the escape hatch for a build
        ; that names its logo something no pattern could have guessed, and it
        ; is why this feature cannot simply fail to find anything any more.
        sub0 := RSetLogoSubOf(kind)
        if (sub0 != "") {
            fp := root "\" sub0
            if FileExist(fp) {
                SplitPath(fp, &tn, &td)
                rel[sub0] := 1
                out.Push({path: fp, dir: td, name: tn, sub: sub0, mk: 0})
            }
            continue
        }
        loop Files, root "\*.png", "R" {
            if !RegExMatch(A_LoopFileName, RSET_LOGO_PAT)
                continue
            ; the path BELOW content\textures, so the same asset can be
            ; mirrored into Bloxstrap at the folder Roblox reads it from
            sub := SubStr(A_LoopFileFullPath, rl)
            rel[sub] := 1
            out.Push({path: A_LoopFileFullPath, dir: A_LoopFileDir
                    , name: A_LoopFileName, sub: sub, mk: 0})
        }
    }
    if (kind = 1 && rel.Count && DirExist(lad "\Bloxstrap")) {
        bd := lad "\Bloxstrap\Modifications\content\textures"
        for sub, v in rel {
            fp := bd "\" sub
            SplitPath(fp, &bn, &bdir)
            out.Push({path: fp, dir: bdir, name: bn, sub: sub, mk: 1})
        }
    }
    return out
}
; Cached list, not a cached count. Rescans on demand or every 20s.
RSetLogoScan(kind := 1, force := false) {
    if (force || !RSET.logoTg || !RSET.logoTgS || A_TickCount - RSET.logoAt > 20000) {
        RSET.logoTg  := RSetLogoTargets(1)
        RSET.logoTgS := RSetLogoTargets(2)
        RSET.logoAt  := A_TickCount
    }
    return (kind = 2) ? RSET.logoTgS : RSET.logoTg
}
RSetLogoCount(kind := 1, force := false) => RSetLogoScan(kind, force).Length

; What to show in an empty slot. This used to take the first file the name
; search matched, which was arbitrary: with dozens of matches from a loose
; pattern, "first" was some unrelated icon, and both rows ended up showing the
; same wrong picture.
;
; The app's OWN executable icon is the real default and needs no guessing - it
; is literally the icon Windows draws for Roblox, which is also the thing the
; shortcut half of this row replaces. Player and Studio differ naturally
; because they are different executables.
RSetAppExe(kind) {
    if (!RSET.appExeAt || A_TickCount - RSET.appExeAt > 30000) {
        RSET.appExeAt := A_TickCount
        lad := ""
        try lad := EnvGet("LOCALAPPDATA")
        loop 2 {
            k := A_Index, best := ""
            if (lad != "") {
                exe := RSetLogoExe(k)
                loop Files, lad "\Roblox\Versions\version-*", "D" {
                    fp := A_LoopFileFullPath "\" exe
                    if FileExist(fp)
                        best := fp           ; newest wins - the loop ends on it
                }
            }
            RSET.appExe[k] := best
        }
    }
    return RSET.appExe[kind]
}
RSetLogoDefPath(kind) => RSetAppExe(kind)
; Re-decoded only when the resolved path changes, so this can be called every
; frame without paying for it.
RSetLogoDefLoad(kind := 0) {
    if (kind = 0) {
        RSetLogoDefLoad(1), RSetLogoDefLoad(2)
        return
    }
    pth := RSetLogoDefPath(kind)
    if (pth = RSET.logoDefP[kind])
        return
    RSET.logoDefP[kind] := pth
    if RSET.logoDef[kind] {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", RSET.logoDef[kind])
        RSET.logoDef[kind] := 0
    }
    RSET.logoDefW[kind] := 0, RSET.logoDefH[kind] := 0
    if (pth = "")
        return
    ; large icon only; the small one is asked for and immediately freed because
    ; ExtractIconEx will happily hand back a handle we would otherwise leak
    hL := 0, hS := 0
    try DllCall("shell32\ExtractIconExW", "wstr", pth, "int", 0
              , "ptr*", &hL := 0, "ptr*", &hS := 0, "uint", 1)
    if hS
        try DllCall("DestroyIcon", "ptr", hS)
    if !hL
        return
    if (!DllCall("gdiplus\GdipCreateBitmapFromHICON", "ptr", hL, "ptr*", &b := 0) && b) {
        DllCall("gdiplus\GdipGetImageWidth",  "ptr", b, "uint*", &w := 0)
        DllCall("gdiplus\GdipGetImageHeight", "ptr", b, "uint*", &h := 0)
        RSET.logoDef[kind] := b, RSET.logoDefW[kind] := w, RSET.logoDefH[kind] := h
    }
    try DllCall("DestroyIcon", "ptr", hL)
}

; ---- preview ----
; Decoded once per pick rather than per frame. Kept as a GDI+ bitmap so the row
; can draw the actual image the user chose - a filename alone does not tell you
; whether you picked the right file, which is the entire job of a preview.
RSetLogoLoad(kind := 0) {
    if (kind = 0) {
        RSetLogoLoad(1), RSetLogoLoad(2)
        return
    }
    if (kind = 2) {
        if RSET.logoSBmp {
            try DllCall("gdiplus\GdipDisposeImage", "ptr", RSET.logoSBmp)
            RSET.logoSBmp := 0
        }
        RSET.logoSBw := 0, RSET.logoSBh := 0
    } else {
        if RSET.logoBmp {
            try DllCall("gdiplus\GdipDisposeImage", "ptr", RSET.logoBmp)
            RSET.logoBmp := 0
        }
        RSET.logoBw := 0, RSET.logoBh := 0
    }
    src := RSetLogoOf(kind)
    if (src = "" || !FileExist(src))
        return
    if (!DllCall("gdiplus\GdipCreateBitmapFromFile", "wstr", src, "ptr*", &b := 0) && b) {
        DllCall("gdiplus\GdipGetImageWidth",  "ptr", b, "uint*", &w := 0)
        DllCall("gdiplus\GdipGetImageHeight", "ptr", b, "uint*", &h := 0)
        if (kind = 2)
            RSET.logoSBmp := b, RSET.logoSBw := w, RSET.logoSBh := h
        else
            RSET.logoBmp := b, RSET.logoBw := w, RSET.logoBh := h
    }
}

; The little image the row draws. Same hatch-behind-transparency trick the
; cursor tiles use, so an image with an alpha channel reads as one.
RSetLogoTile(tx, ty, sz, fb, acc, now, kind := 1) {
    bmp := (kind = 2) ? RSET.logoSBmp : RSET.logoBmp
    bw  := (kind = 2) ? RSET.logoSBw  : RSET.logoBw
    bh  := (kind = 2) ? RSET.logoSBh  : RSET.logoBh
    ; Nothing staged: show what Roblox is using right now, dimmed so it still
    ; reads as "not yours yet" rather than as a set slot.
    own := (bmp && bw && bh)
    if !own {
        RSetLogoDefLoad(kind)
        bmp := RSET.logoDef[kind], bw := RSET.logoDefW[kind], bh := RSET.logoDefH[kind]
    }
    b := SBrush(FA(0xFF0B0D16, fb))
    FillRR(tx, ty, sz, sz, 5, b), DelB(b)
    cp := RRPath(tx, ty, sz, sz, 5)
    sv := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", cp, "int", 1)
    pn := Pen(FA(Alpha(0xFFFFFF, 10), fb), 1)
    k := -sz
    while (k < sz) {
        Line(tx + k, ty + sz, tx + k + sz, ty, pn)
        k += 7
    }
    DelP(pn)
    if (bmp && bw && bh) {
        fit := Min((sz - 6)/bw, (sz - 6)/bh)
        iw := bw*fit, ih := bh*fit
        SetImgAlpha(fb*(own ? 1.0 : 0.6))
        DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
            , "float", tx + (sz - iw)/2, "float", ty + (sz - ih)/2, "float", iw, "float", ih
            , "float", 0, "float", 0, "float", bw, "float", bh
            , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    } else {
        pn := Pen(FA(Alpha(0xFFC7CBE0, 60), fb), 1.2)
        Line(tx + sz/2 - 4, ty + sz/2, tx + sz/2 + 4, ty + sz/2, pn), DelP(pn)
    }
    Pop(sv)
    DllCall("gdiplus\GdipDeletePath", "ptr", cp)
    n := RSetLogoCount(kind) + RSetLnkScan(kind).Length
    pn := Pen(FA(Alpha(own ? (n ? acc : AMBER) : 0xFF6E7590, own ? 150 : 90), fb), 1.2)
    StrokeRR(tx, ty, sz, sz, 5, pn), DelP(pn)
}
; ---------------- ROBLOX APP ICON ----------------
; The icon you see on the desktop, the taskbar and in Start is NOT the texture
; the logo row deals with, and it is not the icon compiled into the exe either
; - it is the SHORTCUT's icon. A .lnk carries its own IconLocation, and setting
; that changes the icon everywhere the shortcut is pinned without touching a
; single Roblox file. That is the method the Roblox DevForum settles on, and
; the reason it is safe: nothing inside the install is modified, so Roblox's
; own integrity checks have nothing to notice.
;
; Two consequences worth knowing:
;   - Windows shortcuts want an .ico, not a .png, so the picked image is
;     converted (see RSetIcoWrite).
;   - A Roblox update rewrites its shortcuts and the icon reverts. Pressing
;     APPLY again puts it back; there is nothing to repair.

; PNG -> ICO. Vista and later accept a PNG payload inside an .ico wholesale, so
; the whole file is a 6-byte header, one 16-byte directory entry and the PNG.
; No bitmap/mask encoding, no palette - which is why this is short.
RSetIcoWrite(srcPath, outPath) {
    if (srcPath = "" || !FileExist(srcPath))
        return 0
    if (DllCall("gdiplus\GdipCreateBitmapFromFile", "wstr", srcPath, "ptr*", &src := 0) || !src)
        return 0
    DllCall("gdiplus\GdipGetImageWidth",  "ptr", src, "uint*", &w := 0)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", src, "uint*", &h := 0)
    if (!w || !h) {
        DllCall("gdiplus\GdipDisposeImage", "ptr", src)
        return 0
    }
    ; 256 square, aspect kept, transparent padding - the same fit the cursor
    ; slots use. 256 is the largest an .ico entry can describe and Windows
    ; downscales it for every smaller slot itself.
    SZ := 256
    sc := Min(SZ/w, SZ/h)
    dw := Max(1, Round(w*sc)), dh := Max(1, Round(h*sc))
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SZ, "int", SZ
        , "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &nb := 0)
    if !nb {
        DllCall("gdiplus\GdipDisposeImage", "ptr", src)
        return 0
    }
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", nb, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", g2, "int", 2)
    DllCall("gdiplus\GdipDrawImageRectRectI", "ptr", g2, "ptr", src
        , "int", (SZ - dw)//2, "int", (SZ - dh)//2, "int", dw, "int", dh
        , "int", 0, "int", 0, "int", w, "int", h
        , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g2)
    DllCall("gdiplus\GdipDisposeImage", "ptr", src)

    tmp := A_Temp "\yuri_icon_src.png"
    try FileDelete(tmp)
    SaveAvatarPng(nb, tmp)
    DllCall("gdiplus\GdipDisposeImage", "ptr", nb)
    if !FileExist(tmp)
        return 0
    png := 0
    try png := FileRead(tmp, "RAW")
    try FileDelete(tmp)
    if (!IsObject(png) || !png.Size)
        return 0

    ico := Buffer(22 + png.Size, 0)
    NumPut("ushort", 0, ico, 0)                  ; reserved
    NumPut("ushort", 1, ico, 2)                  ; type 1 = icon
    NumPut("ushort", 1, ico, 4)                  ; one image
    ; width/height of 0 is how an .ico says 256 - it is a single byte field
    NumPut("uchar", 0, ico, 6), NumPut("uchar", 0, ico, 7)
    NumPut("uchar", 0, ico, 8), NumPut("uchar", 0, ico, 9)
    NumPut("ushort", 1,  ico, 10)                ; colour planes
    NumPut("ushort", 32, ico, 12)                ; bits per pixel
    NumPut("uint", png.Size, ico, 14)            ; bytes of image data
    NumPut("uint", 22, ico, 18)                  ; offset to it
    DllCall("RtlMoveMemory", "ptr", ico.Ptr + 22, "ptr", png.Ptr, "uptr", png.Size)
    try FileDelete(outPath)
    try {
        f := FileOpen(outPath, "w")
        f.RawWrite(ico, ico.Size)
        f.Close()
    }
    return FileExist(outPath) ? 1 : 0
}

; Every Roblox shortcut worth retargeting: both desktops, both Start menus, the
; taskbar pins, and Bloxstrap's own if it is installed.
; Cached wrapper - this is what callers should use.
RSetLnkScan(kind := 1, force := false) {
    if (force || !RSET.lnkTg[1] || !RSET.lnkTg[2] || A_TickCount - RSET.lnkTgAt > 30000) {
        RSET.lnkTg[1] := RSetLnkTargets(1)
        RSET.lnkTg[2] := RSetLnkTargets(2)
        RSET.lnkTgAt  := A_TickCount
    }
    return RSET.lnkTg[kind]
}
RSetLnkTargets(kind := 1) {
    out := [], seen := Map()
    roots := [A_Desktop, A_DesktopCommon
            , A_StartMenu "\Programs", A_StartMenuCommon "\Programs"
            , A_AppData "\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar"]
    for r in roots {
        if (r = "" || !DirExist(r))
            continue
        loop Files, r "\*.lnk", "R" {
            ; name test only - reading every shortcut on the desktop to see
            ; where it points would be slower and no more accurate
            if !RegExMatch(A_LoopFileName, "i)^(roblox|bloxstrap|fishstrap)")
                continue
            ; "Roblox Studio.lnk" also starts with "roblox", so the two apps
            ; are separated on whether STUDIO appears - without this the
            ; Player's icon landed on Studio's shortcut as well
            isS := RegExMatch(A_LoopFileName, "i)studio") > 0
            if (isS != (kind = 2))
                continue
            k := StrLower(A_LoopFileFullPath)
            if seen.Has(k)
                continue
            seen[k] := 1
            out.Push({path: A_LoopFileFullPath, name: A_LoopFileName})
        }
    }
    return out
}

RSetIcoPath(kind := 1) => YURI_RSB "\logo\appicon" (kind = 2 ? "_studio" : "") ".ico"
RSetIcoLog() => YURI_RSB "\logo\icons.dat"

; What each shortcut pointed at before we touched it, kept ON DISK. Held only
; in memory it did not survive closing the hub, and RESTORE then had nothing to
; put back - which is the difference between an undo and a dead end.
RSetIcoSave() {
    if !DirExist(YURI_RSB "\logo")
        try DirCreate(YURI_RSB "\logo")
    txt := ""
    for pth, was in RSET.icoOrig
        txt .= pth "|" was "`n"
    try FileDelete(RSetIcoLog())
    if (txt != "")
        try FileAppend(txt, RSetIcoLog(), "UTF-8")
}
RSetIcoLoad() {
    RSET.icoOrig := Map()
    if !FileExist(RSetIcoLog())
        return
    body := ""
    try body := FileRead(RSetIcoLog(), "UTF-8")
    for ln in StrSplit(RTrim(body, "`r`n"), "`n") {
        ln := RTrim(ln, "`r")
        ; split on the FIRST separator only - an IconLocation is "path,index"
        q := InStr(ln, "|")
        if q
            RSET.icoOrig[SubStr(ln, 1, q - 1)] := SubStr(ln, q + 1)
    }
}

RSetIconApply(kind := 1) {
    src := RSetLogoOf(kind)
    if (src = "" || !FileExist(src))
        return 0
    if !DirExist(YURI_RSB "\logo")
        try DirCreate(YURI_RSB "\logo")
    ico := RSetIcoPath(kind)
    if !RSetIcoWrite(src, ico)
        return 0
    lst := RSetLnkTargets(kind)
    if !lst.Length
        return 0
    sh := ""
    try sh := ComObject("WScript.Shell")
    if !IsObject(sh)
        return 0
    n := 0
    for t in lst {
        try {
            lnk := sh.CreateShortcut(t.path)
            ; remember what it pointed at, so REVERT is exact rather than a
            ; guess at what Roblox's default was
            if !RSET.icoOrig.Has(t.path)
                RSET.icoOrig[t.path] := lnk.IconLocation
            lnk.IconLocation := ico ",0"
            lnk.Save()
            n++
        }
    }
    if n {
        RSetIcoSave()                        ; so RESTORE still works next session
        RSetIconRefresh()
    }
    return n
}

; Puts the default icon back, and does NOT depend on having remembered
; anything. Two tests over the same set:
;   - a shortcut we have a record for goes back to exactly that value
;   - a shortcut still pointing at one of OUR .ico files is reset to the app's
;     own executable, which is where a stock Roblox shortcut points anyway
; The second is what makes this work after the record has been lost, and it is
; why nothing we never touched is disturbed: an untouched shortcut matches
; neither test.
RSetIconRevert() {
    sh := ""
    try sh := ComObject("WScript.Shell")
    if !IsObject(sh)
        return 0
    mine := Map()
    mine[StrLower(RSetIcoPath(1))] := 1
    mine[StrLower(RSetIcoPath(2))] := 1
    n := 0
    loop 2 {
        kind := A_Index
        exe  := RSetAppExe(kind)
        for t in RSetLnkScan(kind, true) {
            if !FileExist(t.path)
                continue
            want := ""
            if RSET.icoOrig.Has(t.path)
                want := RSET.icoOrig[t.path]
            else {
                cur := ""
                try {
                    lnk := sh.CreateShortcut(t.path)
                    cur := lnk.IconLocation
                }
                ; "C:\...\appicon.ico,0" - compare on the path half only
                cp := StrLower(Trim(RegExReplace(cur, ",\s*-?\d+\s*$", "")))
                if (cp != "" && mine.Has(cp) && exe != "")
                    want := exe ",0"
            }
            if (want = "")
                continue
            try {
                lnk := sh.CreateShortcut(t.path)
                lnk.IconLocation := want
                lnk.Save()
                n++
            }
        }
    }
    RSET.icoOrig := Map()
    try FileDelete(RSetIcoLog())
    if n
        RSetIconRefresh()
    return n
}

; Explorer caches icons aggressively; without this the change does not show
; until a reboot, which reads exactly like it did not work.
; The row's own REVERT, so putting the logos back does not mean reverting every
; other client setting with them. Backups are keyed to the file they came from,
; so this is exact rather than a guess at Roblox's defaults.
; Apply just this row. The global APPLY SETTINGS still does everything; this
; exists so changing a logo does not mean writing every staged flag and XML
; value at the same time.
RSetLogoApplyOne(kind) {
    src := RSetLogoOf(kind)
    if (src = "" || !FileExist(src)) {
        RSetSay("PICK AN IMAGE FIRST - PRESS BROWSE", 0xFFFBBF24)
        return
    }
    nt := RSetLogoApply(kind)
    ni := RSetIconApply(kind)
    RSET.pick[kind = 2 ? "logos" : "logo"] := 2
    RSET.flashAt[kind = 2 ? "logos" : "logo"] := A_TickCount
    RSetLogoScan(1, true)
    nm := RSetLogoName(kind)
    if (nt || ni)
        RSetSay(nm " LOGO APPLIED  -  " nt " FILE(S), " ni " SHORTCUT(S)"
              . (ProcessExist(RSetLogoExe(kind)) ? "  -  RESTART IT TO SEE IT" : ""), C_ON)
    else
        RSetSay(nm " LOGO MATCHED NOTHING - BROWSE AGAIN TO PICK THE TARGET", C_ACC)
    HubPoke()
}

RSetLogoRestore() {
    nt := RSetLogoRevert(0)
    ni := RSetIconRevert()
    ; Clear the staged images too. Restoring the files but leaving the picks
    ; set would show two tiles still holding the user's art over a client that
    ; no longer uses it, and the next APPLY would silently put it all back.
    RSET.logo := "", RSET.logoS := ""
    RSET.pick["logo"] := 1, RSET.pick["logos"] := 1
    RSET.flashAt["logo"] := A_TickCount, RSET.flashAt["logos"] := A_TickCount
    try IniWrite("", iniPath, "rset", "logofile")
    try IniWrite("", iniPath, "rset", "logofileS")
    try IniWrite(1, iniPath, "rset", "logo")
    try IniWrite(1, iniPath, "rset", "logos")
    RSetLogoLoad()                           ; drops both staged bitmaps
    RSetLogoScan(1, true)
    if (nt || ni) {
        RSetSay("DEFAULT LOGOS RESTORED  -  " nt " FILE(S), " ni " SHORTCUT(S)"
              . (ProcessExist("RobloxPlayerBeta.exe") ? "  -  RESTART ROBLOX" : ""), C_ON)
    } else
        RSetSay("NOTHING TO RESTORE - ALREADY ON THE ROBLOX DEFAULTS", 0xFFFBBF24)
    HubPoke()
}

RSetIconRefresh() {
    ; SHCNE_ASSOCCHANGED, SHCNF_IDLIST
    try DllCall("shell32\SHChangeNotify", "int", 0x08000000, "uint", 0x0000, "ptr", 0, "ptr", 0)
}

RSetLogoBak(t) => YURI_RSB "\logo\" CurKey(t.path) "_" t.name

; ---------------- what APPLY actually overwrote ----------------
; RSetFontRevert and RSetLogoRevert used to walk RSetFontTargets /
; RSetLogoTargets and look for a backup beside each entry - that is, they asked
; "what would APPLY write NOW" and restored only that. Both lists are computed
; from live state: the logo list follows RSET.logoSub, the target the user
; picked, and both follow whichever version-* folders exist at this moment.
; Change the target between APPLY and REVERT, or let a Roblox update rename the
; file, and the list no longer names the files that were actually overwritten -
; so their backups sit on disk untouched, the client keeps the replacement art,
; and the module reports itself fully reverted.
;
; This is the same failure the ClientAppSettings half already solves with
; appsettings_prev.json and the shortcut half with icons.dat: record what was
; written, and drive the undo off the record instead of off a guess. The backup
; FILENAME cannot carry it - CurKey is a hash, so the original path is not
; recoverable from it.
RSetBakLog() => YURI_RSB "\backups.dat"

RSetBakLoad() {
    RSET.bakLog := Map()
    if !FileExist(RSetBakLog())
        return
    body := ""
    try body := FileRead(RSetBakLog(), "UTF-8")
    for ln in StrSplit(RTrim(body, "`r`n"), "`n") {
        ln := RTrim(ln, "`r")
        ; kind|backup|original, split into three so a path keeps any later
        ; separators. A short line is a truncated write, not half a record.
        p := StrSplit(ln, "|", , 3)
        if (p.Length = 3 && p[2] != "" && p[3] != "")
            RSET.bakLog[p[2]] := {kind: p[1], orig: p[3]}
    }
}

RSetBakSave() {
    RSetEnsureDirs()
    txt := ""
    for bak, e in RSET.bakLog
        txt .= e.kind "|" bak "|" e.orig "`n"
    try FileDelete(RSetBakLog())
    if (txt != "")
        try FileAppend(txt, RSetBakLog(), "UTF-8")
}

; Returns 1 when the record changed, so a caller writing dozens of files can
; save the log once at the end instead of once per file.
RSetBakNote(kind, bak, orig) {
    if RSET.bakLog.Has(bak)
        return 0
    RSET.bakLog[bak] := {kind: kind, orig: orig}
    return 1
}

; Every recorded backup of the given kinds that is still on disk, put back at
; the path it came from. Runs AFTER the target-driven pass, so anything that
; pass already handled has been dropped from the record and is not touched
; twice. `kinds` is a Map used as a set.
RSetBakSweep(kinds) {
    n := 0, dirty := 0
    for bak, e in RSET.bakLog.Clone() {
        if !kinds.Has(e.kind)
            continue
        if !FileExist(bak) {
            RSET.bakLog.Delete(bak), dirty := 1
            continue
        }
        ; A version folder Roblox has since deleted has nothing to restore
        ; into. Drop the orphan rather than recreating a dead install.
        SplitPath(e.orig, , &od)
        if (od = "" || !DirExist(od)) {
            try FileDelete(bak)
            RSET.bakLog.Delete(bak), dirty := 1
            continue
        }
        ok := 0
        try {
            FileCopy(bak, e.orig, 1)
            FileDelete(bak)
            ok := 1
        }
        ; A copy that threw leaves both the file and the record in place - the
        ; client holds content files open while it runs, and a retry after it
        ; closes has to still find something to retry with.
        if ok {
            RSET.bakLog.Delete(bak), dirty := 1
            n++
        }
    }
    if dirty
        RSetBakSave()
    return n
}

; Newest install's textures folder - where the target dialog should open.
RSetTexRoot(kind := 1) {
    lad := "", best := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return ""
    exe := RSetLogoExe(kind)
    loop Files, lad "\Roblox\Versions\version-*", "D" {
        if !FileExist(A_LoopFileFullPath "\" exe)
            continue
        d := A_LoopFileFullPath "\content\textures"
        if DirExist(d)
            best := d
    }
    return best
}

RSetPickLogoTarget(kind := 1) {
    if (RSET.pickPid && ProcessExist(RSET.pickPid))
        return
    rt := RSetTexRoot(kind)
    if (rt = "") {
        RSetSay("NO ROBLOX INSTALL FOUND", C_OFF)
        return
    }
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" logotgt ' ui.Hwnd ' "' rt '" ' kind
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" logotgt ' ui.Hwnd ' "' rt '" ' kind
    pid := 0
    try Run(cmd, , , &pid)
    HubPickWatch(pid)   ; raise the hub again when the dialog closes
    RSET.pickPid := pid
}

; Full path in, relative subpath out. Computed from the marker rather than by
; trusting the seed folder, so a user who browses to a DIFFERENT version folder
; still produces a subpath that applies to all of them.
RSetSetLogoTarget(msg) {
    kind := 1, path := msg
    if RegExMatch(msg, "^([12])\|(.*)$", &m)
        kind := Integer(m[1]), path := m[2]
    if (path = "" || !FileExist(path)) {
        RSetSay("FILE NOT FOUND", C_OFF)
        return
    }
    mk := "\content\textures\"
    ipos := InStr(path, mk, false, -1)
    if !ipos {
        RSetSay("THAT FILE IS NOT INSIDE THE ROBLOX TEXTURES FOLDER", C_OFF)
        return
    }
    sub := SubStr(path, ipos + StrLen(mk))
    if (kind = 2)
        RSET.logoSubS := sub
    else
        RSET.logoSub := sub
    try IniWrite(sub, iniPath, "rset", kind = 2 ? "logosubS" : "logosub")
    n := RSetLogoCount(kind, true)
    RSetSay(RSetLogoName(kind) " TARGET SET - " sub "  ·  " n " FILE(S)  -  PRESS APPLY"
          , n ? C_ON : C_ACC)
    HubPoke()
}

RSetLogoApply(kind := 1) {
    src := RSetLogoOf(kind)
    if (src = "" || !FileExist(src))
        return 0
    tg := RSetLogoTargets(kind)
    if !tg.Length
        return 0
    if !DirExist(YURI_RSB "\logo")
        try DirCreate(YURI_RSB "\logo")
    ok := 0, dirty := 0
    for t in tg {
        if (t.mk && !DirExist(t.dir))
            try DirCreate(t.dir)
        bak := RSetLogoBak(t)
        if (!FileExist(bak) && FileExist(t.path))
            try FileCopy(t.path, bak, 0)
        try {
            FileCopy(src, t.path, 1)
            ok++
            ; Recorded only once the overwrite landed. A note for a file we
            ; failed to touch would send REVERT to copy a backup over an
            ; original that was never modified.
            if FileExist(bak)
                dirty |= RSetBakNote("logo" kind, bak, t.path)
        }
    }
    if dirty
        RSetBakSave()
    return ok
}

RSetLogoRevert(kind := 0) {
    if (kind = 0)
        return RSetLogoRevert(1) + RSetLogoRevert(2)
    n := 0, dirty := 0
    for t in RSetLogoTargets(kind) {
        bak := RSetLogoBak(t)
        if !FileExist(bak)
            continue
        try {
            FileCopy(bak, t.path, 1)
            FileDelete(bak)
            n++
            if RSET.bakLog.Has(bak)
                RSET.bakLog.Delete(bak), dirty := 1
        }
    }
    if dirty
        RSetBakSave()
    ; Whatever APPLY overwrote that the CURRENT target list no longer names -
    ; a retargeted logo row, a renamed file, an older install still on disk.
    n += RSetBakSweep(Map("logo" kind, 1))
    return n
}

RSetFontBak(t) => YURI_RSB "\fonts\" CurKey(t.path) "_" t.name

RSetFontApply() {
    if (RSET.font = "" || !FileExist(RSET.font))
        return 0
    tg := RSetFontTargets()
    if !tg.Length
        return 0
    if !DirExist(YURI_RSB "\fonts")
        try DirCreate(YURI_RSB "\fonts")
    ok := 0, dirty := 0
    for t in tg {
        if (t.mk && !DirExist(t.dir))
            try DirCreate(t.dir)
        bak := RSetFontBak(t)
        if (!FileExist(bak) && FileExist(t.path))
            try FileCopy(t.path, bak, 0)
        try {
            FileCopy(RSET.font, t.path, 1)
            ok++
            if FileExist(bak)
                dirty |= RSetBakNote("font", bak, t.path)
        }
    }
    if dirty
        RSetBakSave()
    return ok
}

RSetFontRevert() {
    n := 0, dirty := 0
    for t in RSetFontTargets() {
        bak := RSetFontBak(t)
        if !FileExist(bak)
            continue
        try {
            FileCopy(bak, t.path, 1)
            FileDelete(bak)
            n++
            if RSET.bakLog.Has(bak)
                RSET.bakLog.Delete(bak), dirty := 1
        }
    }
    if dirty
        RSetBakSave()
    ; typefaces that are no longer in content\fonts under any current install,
    ; but were when APPLY overwrote them
    n += RSetBakSweep(Map("font", 1))
    return n
}

RSetPickFont() {
    if (RSET.pickPid && ProcessExist(RSET.pickPid))
        return
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" fontpick ' ui.Hwnd
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" fontpick ' ui.Hwnd
    pid := 0
    try Run(cmd, , , &pid)
    HubPickWatch(pid)   ; raise the hub again when the dialog closes
    RSET.pickPid := pid
}

RSetPickLogo(kind := 1) {
    if (RSET.pickPid && ProcessExist(RSET.pickPid))
        return
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" logopick ' ui.Hwnd ' ' kind
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" logopick ' ui.Hwnd ' ' kind
    pid := 0
    try Run(cmd, , , &pid)
    HubPickWatch(pid)   ; raise the hub again when the dialog closes
    RSET.pickPid := pid
}

RSetSetLogo(msg) {
    kind := 1, path := msg
    if RegExMatch(msg, "^([12])\|(.*)$", &m)
        kind := Integer(m[1]), path := m[2]
    if (path = "" || !FileExist(path)) {
        RSetSay("LOGO FILE NOT FOUND", C_OFF)
        return
    }
    key := (kind = 2) ? "logos" : "logo"
    if (kind = 2)
        RSET.logoS := path
    else
        RSET.logo := path
    RSetLogoLoad(kind)
    RSET.pick[key] := 2
    RSET.flashAt[key] := A_TickCount
    try IniWrite(path, iniPath, "rset", kind = 2 ? "logofileS" : "logofile")
    try IniWrite(2, iniPath, "rset", key)
    n := RSetLogoCount(kind, true) + RSetLnkScan(kind, true).Length
    if n {
        RSetSay(RSetLogoName(kind) " LOGO READY - " CurBaseName(path)
              . "  -  " n " TARGET(S)  -  PRESS APPLY", C_ON)
        return
    }
    ; Nothing matched, so stop guessing and ask. Opening the picker straight
    ; away is the whole fix: the old behaviour was to report "ready", write no
    ; files on APPLY, and leave you with no way to find out why.
    RSetSay("NO " RSetLogoName(kind) " FILE MATCHED - PICK THE FILE TO REPLACE", AMBER)
    RSetPickLogoTarget(kind)
}

RSetSetFont(path) {
    if (path = "" || !FileExist(path)) {
        RSetSay("FONT FILE NOT FOUND", C_OFF)
        return
    }
    RSET.font := path
    RSET.pick["font"] := 2
    RSET.flashAt["font"] := A_TickCount
    try IniWrite(path, iniPath, "rset", "fontfile")
    try IniWrite(2, iniPath, "rset", "font")
    RSetSay("FONT READY - " CurBaseName(path), C_ON)
}

; ---------------- CLIENT SETTINGS: glyphs ----------------
RSetIcon(i, cx, cy, col, live, now) {
    ; LOW PERFORMANCE MODE: no glyphs. The row still has its name and its
    ; switch, which is everything the row actually means.
    if hubLowPerf
        return
    pn := Pen(col, 1.5)
    k := RSET_OPTS[i].k
    if (k = "apply") {                             ; arrow dropping into a tray
        ay_ := live ? cy + 1 + Sin(DecT(now)*0.005)*1.4 : cy + 1
        Line(cx, cy - 8, cx, ay_, pn)
        Line(cx - 3.5, ay_ - 3.5, cx, ay_, pn)
        Line(cx + 3.5, ay_ - 3.5, cx, ay_, pn)
        Line(cx - 8, cy + 4, cx - 8, cy + 8, pn)
        Line(cx - 8, cy + 8, cx + 8, cy + 8, pn)
        Line(cx + 8, cy + 8, cx + 8, cy + 4, pn)
    } else if (k = "revert") {                     ; counter arrow
        Arc(cx - 7, cy - 7, 14, 14, 110, 250, pn)
        Line(cx - 6.6, cy - 1.5, cx - 6.6, cy - 6.5, pn)
        Line(cx - 6.6, cy - 1.5, cx - 2, cy - 3.5, pn)
    } else if (k = "logos") {                      ; framed picture, blueprint inside
        ; Studio is the editor, so its mark is a layout rather than a solid
        ; badge - and it has to be tellable from the Player row's glyph at a
        ; glance, which was the whole problem with them sharing one.
        StrokeRR(cx - 9, cy - 7, 18, 14, 3, pn)
        pn2 := Pen(FA(col, live ? 0.85 : 0.45), 1.1)
        Line(cx - 2.5, cy - 4, cx - 2.5, cy + 4, pn2)      ; the divider
        Line(cx - 0.5, cy - 2.2, cx + 5.5, cy - 2.2, pn2)
        Line(cx - 0.5, cy + 0.4, cx + 5.5, cy + 0.4, pn2)
        Line(cx - 0.5, cy + 3.0, cx + 3.0, cy + 3.0, pn2), DelP(pn2)
        b2 := SBrush(FA(col, live ? 0.9 : 0.5))
        FillRR(cx - 7, cy - 4, 3, 8, 1, b2), DelB(b2)
    } else if (k = "logorst") {                    ; a frame being put back
        ; The plain counter-arrow already belongs to REVERT SETTINGS, so this
        ; wraps one around a picture frame - undo, but specifically of art.
        StrokeRR(cx - 5.5, cy - 4, 11, 9, 2, pn)
        b2 := SBrush(FA(col, live ? 0.85 : 0.45))
        FillRR(cx - 3, cy - 1.5, 6, 4, 1, b2), DelB(b2)
        pn2 := Pen(FA(col, live ? 0.9 : 0.5), 1.4)
        Arc(cx - 9, cy - 8.5, 18, 17, 128, 250, pn2)
        Line(cx - 8.4, cy - 2.6, cx - 8.4, cy - 7.4, pn2)
        Line(cx - 8.4, cy - 2.6, cx - 3.8, cy - 4.6, pn2), DelP(pn2)
    } else if (k = "logo") {                       ; framed picture with a mark
        StrokeRR(cx - 9, cy - 7, 18, 14, 3, pn)
        ; a bold slab inside the frame - a logo reads as a shape, not a letter,
        ; so this stays a mark rather than trying to spell anything
        b2 := SBrush(FA(col, live ? 0.9 : 0.5))
        FillRR(cx - 5, cy - 3.5, 4.5, 7, 1, b2)
        FillRR(cx + 0.8, cy - 3.5, 4.2, 3, 1, b2), DelB(b2)
        pn2 := Pen(FA(col, live ? 0.75 : 0.4), 1.2)
        Line(cx + 0.8, cy + 1.4, cx + 5, cy + 3.5, pn2), DelP(pn2)
    } else if (k = "preset") {                     ; three rising steps
        ; The glyph states the row: three tiers, and the one in force lit. Which
        ; step is lit is read back from the picks, so it tracks the chips.
        ap := RSetPresetActive()
        loop 3 {
            j  := A_Index
            sxq := cx - 9 + (j - 1)*6.4
            shq := 4 + (j - 1)*4.4
            ; step 1 is LOW and sits leftmost, so the tier lit is 4 - ap
            lit := (ap && j = 4 - ap)
            if lit {
                b2 := SBrush(col)
                FillRR(sxq, cy + 7 - shq, 5, shq, 1.4, b2), DelB(b2)
            } else {
                pq := Pen(FA(col, ap ? 0.5 : 0.85), 1.3)
                StrokeRR(sxq, cy + 7 - shq, 5, shq, 1.4, pq), DelP(pq)
            }
        }
    } else if (k = "render") {                            ; gpu die
        StrokeRR(cx - 6, cy - 6, 12, 12, 2, pn)
        loop 3 {
            j := A_Index - 2
            Line(cx + j*4, cy - 9, cx + j*4, cy - 6, pn)
            Line(cx + j*4, cy + 6, cx + j*4, cy + 9, pn)
            Line(cx - 9, cy + j*4, cx - 6, cy + j*4, pn)
            Line(cx + 6, cy + j*4, cx + 9, cy + j*4, pn)
        }
    } else if (k = "light") {                      ; sun with rays
        Ell(cx - 4, cy - 4, 8, 8, pn)
        loop 8 {
            a_ := (A_Index - 1)*0.7854 + (live ? Mod(DecT(now)*0.0006, 6.283) : 0)
            Line(cx + 6.5*Cos(a_), cy + 6.5*Sin(a_), cx + 9.5*Cos(a_), cy + 9.5*Sin(a_), pn)
        }
    } else if (k = "frm") {                        ; rising ladder
        loop 4 {
            j := A_Index
            Line(cx - 8 + (j - 1)*4.6, cy + 7, cx - 8 + (j - 1)*4.6, cy + 7 - j*3.4, pn)
        }
    } else if (k = "tex") {                        ; checker swatch
        StrokeRR(cx - 8, cy - 7, 16, 14, 2, pn)
        b2 := SBrush(col)
        FillRR(cx - 8, cy - 7, 8, 7, 1, b2)
        FillRR(cx, cy, 8, 7, 1, b2), DelB(b2)
    } else if (k = "mesh") {                       ; wireframe cube
        Line(cx - 7, cy - 3, cx, cy - 8, pn)
        Line(cx, cy - 8, cx + 7, cy - 3, pn)
        Line(cx + 7, cy - 3, cx + 7, cy + 5, pn)
        Line(cx + 7, cy + 5, cx, cy + 9, pn)
        Line(cx, cy + 9, cx - 7, cy + 5, pn)
        Line(cx - 7, cy + 5, cx - 7, cy - 3, pn)
        Line(cx - 7, cy - 3, cx, cy + 1, pn)
        Line(cx + 7, cy - 3, cx, cy + 1, pn)
        Line(cx, cy + 1, cx, cy + 9, pn)
    } else if (k = "msaa") {                       ; stair edge, smoothed
        Line(cx - 8, cy + 6, cx - 3, cy + 6, pn)
        Line(cx - 3, cy + 6, cx - 3, cy + 1, pn)
        Line(cx - 3, cy + 1, cx + 2, cy + 1, pn)
        Line(cx + 2, cy + 1, cx + 2, cy - 4, pn)
        Line(cx + 2, cy - 4, cx + 7, cy - 4, pn)
        pn2 := Pen(col, 1)
        Line(cx - 8, cy + 8.5, cx + 8, cy - 6.5, pn2), DelP(pn2)
    } else if (k = "fps") {                        ; speedometer
        Arc(cx - 8, cy - 7, 16, 16, 180, 180, pn)
        a_ := live ? (200 + 140*(0.5 + 0.5*Sin(DecT(now)*0.0022))) : 250
        ar := a_*0.0174533
        Line(cx, cy + 1, cx + 7*Cos(ar), cy + 1 + 7*Sin(ar), pn)
        b2 := SBrush(col)
        FillEll(cx - 1.6, cy - 0.6, 3.2, 3.2, b2), DelB(b2)
    } else if (k = "dpi") {                        ; monitor with a scale mark
        StrokeRR(cx - 8, cy - 7, 16, 11, 2, pn)
        Line(cx - 4, cy + 7, cx + 4, cy + 7, pn)
        Line(cx, cy + 4, cx, cy + 7, pn)
        Line(cx - 4, cy - 3, cx + 4, cy - 3, pn)
    } else if (k = "gfx") {                        ; quality bars
        loop 3 {
            j := A_Index
            b2 := SBrush(col)
            FillRR(cx - 8 + (j - 1)*6, cy + 6 - j*3.6, 4, j*3.6, 1.2, b2), DelB(b2)
        }
    } else if (k = "vol") {                        ; speaker + waves
        Line(cx - 7, cy - 3, cx - 4, cy - 3, pn)
        Line(cx - 4, cy - 3, cx, cy - 7, pn)
        Line(cx, cy - 7, cx, cy + 7, pn)
        Line(cx, cy + 7, cx - 4, cy + 3, pn)
        Line(cx - 4, cy + 3, cx - 7, cy + 3, pn)
        Line(cx - 7, cy + 3, cx - 7, cy - 3, pn)
        loop 2 {
            r_ := 3.5 + A_Index*3
            Arc(cx + 1 - r_ + 2, cy - r_, r_*2, r_*2, -55, 110, pn)
        }
    } else if (k = "sens") {                       ; mouse
        StrokeRR(cx - 5.5, cy - 8, 11, 16, 5.5, pn)
        Line(cx, cy - 6, cx, cy - 2, pn)
        pn2 := Pen(col, 1)
        Line(cx + 8, cy - 2, cx + 11, cy - 2, pn2)
        Line(cx - 11, cy - 2, cx - 8, cy - 2, pn2), DelP(pn2)
    } else if (k = "shadow") {                     ; a post and the shadow it throws
        b2 := SBrush(col)
        FillEll(cx - 7, cy - 8, 5.5, 5.5, b2), DelB(b2)     ; the light
        Line(cx + 1, cy - 4, cx + 1, cy + 5, pn)            ; the post
        ; the cast shadow stretches and settles while the row is live, which is
        ; the one thing a shadow row can show rather than merely state
        sl := live ? 6 + 2.5*(0.5 + 0.5*Sin(DecT(now)*0.0021)) : 7
        pn2 := Pen(col, 1)
        Line(cx + 1, cy + 5, cx + 1 + sl, cy + 8, pn2)
        Line(cx + 1, cy + 5, cx + 1 + sl*0.55, cy + 8, pn2), DelP(pn2)
        Line(cx - 6, cy + 8, cx + 8, cy + 8, pn)            ; the ground
    } else if (k = "shmap") {                      ; a grid, finer toward one side
        StrokeRR(cx - 8, cy - 8, 16, 16, 2, pn)
        pn2 := Pen(col, 0.9)
        Line(cx, cy - 8, cx, cy + 8, pn2)
        Line(cx - 8, cy, cx + 8, cy, pn2)
        ; the right half subdivides again - more cells, more resolution
        Line(cx + 4, cy - 8, cx + 4, cy + 8, pn2)
        Line(cx, cy - 4, cx + 8, cy - 4, pn2)
        Line(cx, cy + 4, cx + 8, cy + 4, pn2), DelP(pn2)
    } else if (k = "postfx") {                     ; a lens with a bloom off it
        Ell(cx - 7, cy - 7, 14, 14, pn)
        b2 := SBrush(col)
        FillEll(cx - 2.6, cy - 2.6, 5.2, 5.2, b2), DelB(b2)
        ; the flare pulses while live - post-processing IS the glow
        fl := live ? 0.5 + 0.5*Sin(DecT(now)*0.0028) : 1.0
        pn2 := Pen(FA(Alpha(0xFFFFFF, Round(60 + 120*fl)), 1.0), 1)
        Line(cx + 5, cy - 5, cx + 9, cy - 9, pn2)
        Line(cx + 7, cy, cx + 11, cy, pn2)
        Line(cx + 5, cy + 5, cx + 9, cy + 9, pn2), DelP(pn2)
    } else if (k = "src") {
        ; ---- a junction: two feeds, one outlet ----
        ; Nothing else in this panel is a routing mark, which is the point - it
        ; is the only row that decides where something GOES rather than what it
        ; is. Two lines come in from the left at different heights, meet at a
        ; node, and one line leaves to the right. The node is filled while the
        ; switch is on, hollow while both feeds are merging.
        Line(cx - 9, cy - 5, cx - 3, cy - 5, pn)          ; upper feed
        Line(cx - 9, cy + 5, cx - 3, cy + 5, pn)          ; lower feed
        Line(cx - 3, cy - 5, cx, cy, pn)                  ; ... bending in
        Line(cx - 3, cy + 5, cx, cy, pn)
        Line(cx + 2.6, cy, cx + 9, cy, pn)                ; the single outlet
        ; the node is a DIAMOND, not a disc - a disc of this size is already the
        ; pupil of the POST-PROCESSING lens, and two rows sharing a primitive at
        ; the same radius is how the two logo rows ended up indistinguishable
        stD := PushXform(cx, cy, 1, 45)
        if live {
            b2 := SBrush(col)
            FillRR(cx - 3.1, cy - 3.1, 6.2, 6.2, 1, b2), DelB(b2)
        } else
            StrokeRR(cx - 3.1, cy - 3.1, 6.2, 6.2, 1, pn)
        Pop(stD)
        ; a tick beside the feed that is winning, so the row reads without
        ; looking at its control
        if live {
            yy2 := (rsetSrcSel = 1) ? cy - 5 : cy + 5
            pn2 := Pen(FA(col, 0.9), 2.1)
            Line(cx - 11, yy2, cx - 9.5, yy2, pn2), DelP(pn2)
        }
    } else if (k = "fxedit") {                     ; a flag on a pole
        ; Not the letter A. This row is the only one in the module that does not
        ; set a value, and the fallback glyph belongs to ROBLOX FONT - two rows
        ; wearing the same mark is exactly the complaint the Studio logo row
        ; already had.
        Line(cx - 6, cy - 9, cx - 6, cy + 9, pn)                  ; the pole
        ; the sheet ripples while there is something custom to write, and hangs
        ; still when there is not - the same live/idle distinction every other
        ; glyph here draws
        wv := live ? Sin(DecT(now)*0.004)*1.6 : 0.0
        b2 := SBrush(FA(col, live ? 0.95 : 0.5))
        pth := 0
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &pth := 0)
        DllCall("gdiplus\GdipAddPathLine", "ptr", pth, "float", cx - 6, "float", cy - 8
              , "float", cx + 9, "float", cy - 6 + wv)
        DllCall("gdiplus\GdipAddPathLine", "ptr", pth, "float", cx + 9, "float", cy - 6 + wv
              , "float", cx + 9, "float", cy + 1 + wv)
        DllCall("gdiplus\GdipAddPathLine", "ptr", pth, "float", cx + 9, "float", cy + 1 + wv
              , "float", cx - 6, "float", cy - 1)
        DllCall("gdiplus\GdipClosePathFigure", "ptr", pth)
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b2, "ptr", pth)
        DllCall("gdiplus\GdipDeletePath", "ptr", pth)
        DelB(b2)
        b2 := SBrush(FA(col, live ? 0.9 : 0.45))
        FillEll(cx - 8, cy + 8, 4, 4, b2), DelB(b2)               ; the base
    } else {                                       ; font: letter A
        Line(cx - 6, cy + 7, cx, cy - 8, pn)
        Line(cx, cy - 8, cx + 6, cy + 7, pn)
        Line(cx - 3.4, cy + 1, cx + 3.4, cy + 1, pn)
    }
    DelP(pn)
}

; ---------------- CLIENT SETTINGS: controls ----------------
; The chip is the closed face of a dropdown. It lifts on hover, pops when the
; value changes, and its caret rotates as the list opens.
RSetChip(z, cx2, cy2, w, h, label, chosen, acc, ff, flashAt, now, openT := 0.0) {
    hv  := HL.h.Get(z, 0.0)
    hvE := Ease3(hv)
    fl  := (flashAt && now - flashAt < 420) ? 1 - Clamp((now - flashAt)/420.0, 0.0, 1.0) : 0.0
    st  := PushXform(cx2 + w/2, cy2 + h/2, 1 + 0.05*hvE + 0.07*fl, 0)

    if (fl > 0.01) {
        ex := (1 - fl)*12
        pn := Pen(FA(Alpha(acc, Round(190*fl)), ff), 1.6*fl + 0.3)
        StrokeRR(cx2 - ex, cy2 - ex*0.6, w + ex*2, h + ex*1.2, 6 + ex*0.3, pn), DelP(pn)
    }
    lit := Max(hvE, openT)
    bc := chosen ? Alpha(acc, Round(36 + 34*lit + 40*fl)) : Alpha(0xFFFFFF, Round(14 + 20*lit))
    b := SBrush(FA(bc, ff))
    FillRR(cx2, cy2, w, h, 6, b), DelB(b)
    MicroBackdrop(cx2, cy2, w, h, 6, acc, ff, now, 0.85)
    pn := Pen(FA(Alpha(chosen ? acc : 0xFF9AA8C0, Round(chosen ? 150 + 80*lit : 55 + 60*lit)), ff), 1.1)
    StrokeRR(cx2, cy2, w, h, 6, pn), DelP(pn)
    tc := chosen ? AccHi(acc, 0.45) : 0xFFC7CBE0
    Txt(label, cx2, cy2 - 1, w - 10, h, HL.fXs
        , FA(Alpha(tc, Round(chosen ? 235 : 165 + 50*lit)), ff), fmtC)
    ; caret spins 90 degrees as the list opens
    ccx := cx2 + w - 10, ccy := cy2 + h/2
    stC := PushXform(ccx, ccy, 1, -90*openT)
    pn := Pen(FA(Alpha(chosen ? acc : 0xFF9AA8C0, Round(90 + 120*lit)), ff), 1.2)
    Line(ccx - 3, ccy - 1.6, ccx, ccy + 1.6, pn)
    Line(ccx, ccy + 1.6, ccx + 3, ccy - 1.6, pn), DelP(pn)
    Pop(stC)
    Pop(st)
}

; A track with a knob, ticks and a live readout. Index 1 is the leave-alone
; end, so the knob sitting hard left means "don't touch this".
RSetSlider(z, i, ry, ax, acc, ff, now) {
    o    := RSET_OPTS[i]
    idx  := RSetIdx(o)
    n    := o.v.Length
    fr   := (n > 1) ? (idx - 1)/(n - 1) : 0.0
    set  := (idx > 1)
    drag := (HL.drag = 15 && RSET.sld = i)
    ; ---- two hovers, one control ----
    ; hvT is the track, hvK the knob's own disc. Ticks and the readout follow
    ; either, because both belong to the row's control; the knob follows only
    ; itself, so it stops growing when the pointer is merely near it.
    hvT  := Max(HL.h.Get(z, 0.0), drag ? 1.0 : 0.0)
    hvK  := Max(HL.h.Get(RSetKnobZ(i), 0.0), drag ? 1.0 : 0.0)
    hvE  := Ease3(Max(hvT, hvK))
    hkE  := Ease3(hvK)
    fl   := (RSET.flashAt.Has(o.k) && now - RSET.flashAt[o.k] < 360)
          ? 1 - Clamp((now - RSET.flashAt[o.k])/360.0, 0.0, 1.0) : 0.0

    ; ax is the row origin the caller handed us - it already carries both the
    ; page slide and the row slide. RSetTrackX() is the RESTING position and
    ; carries neither, so deriving the track from it is what pinned this bar
    ; in place while its row moved.
    tx := ax + HL.abw - 200, tw := RSetTrackW(), ty := ry + 13

    b := SBrush(FA(0x22FFFFFF, ff))
    FillRR(tx, ty - 2.5, tw, 5, 2.5, b), DelB(b)
    if (fr > 0.001) {
        b := VBrush(tx, ty - 2.5, tw*fr + 1, 5, FA(Alpha(AccHi(acc, 0.25), 235), ff)
                  , FA(Alpha(acc, 150), ff))
        FillRR(tx, ty - 2.5, tw*fr + 1, 5, 2.5, b), DelB(b)
    }
    ; ticks - one per step when there are few, otherwise five evenly spaced
    nt := (n <= 8) ? n : 6
    loop nt {
        k := A_Index - 1
        tkx := tx + k*(tw/(nt - 1))
        pn := Pen(FA(Alpha(0xFFFFFF, Round(22 + 22*hvE)), ff), 1)
        Line(tkx, ty + 5, tkx, ty + 8, pn), DelP(pn)
    }

    knx := tx + tw*fr
    if (hkE > 0.01 || fl > 0.01) {
        b := SBrush(FA(Alpha(acc, Round(40 + 55*hkE + 60*fl)), ff))
        r_ := 9 + 3*hkE + 3*fl
        FillEll(knx - r_, ty - r_, r_*2, r_*2, b), DelB(b)
    }
    ; ---- the knob answers too ----
    ; Only the halo behind it moved, so with the halo's zone unregistered there
    ; was nothing at all: the white disc sat inert under the pointer while every
    ; other control in the panel lifted. It carries the press now as well - a
    ; grab is the one time the thing under your finger should be the thing that
    ; reacts - and grows by the same fraction FFMBtn uses so the two feel alike.
    kr  := 5.5 + 1.1*hkE + 0.8*fl
    kdp := drag ? 0.6 : 0.0                  ; a held knob settles back down
    b := SBrush(FA(Alpha(0x000000, 90), ff))
    FillEll(knx - kr, ty - kr + 1.5, kr*2, kr*2, b), DelB(b)
    b := SBrush(FA(Alpha(0xFEFEFE, 250), ff))
    FillEll(knx - kr + kdp*0.5, ty - kr + kdp*0.5, (kr - kdp*0.5)*2, (kr - kdp*0.5)*2, b), DelB(b)
    ; a faint rim, brightening with the lift, so the growth reads as a lift
    ; rather than the disc merely getting fatter
    if (hkE > 0.01) {
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(140*hkE)), ff), 1.1)
        Ell(knx - kr - 0.6, ty - kr - 0.6, (kr + 0.6)*2, (kr + 0.6)*2, pn), DelP(pn)
    }
    b := SBrush(FA(Alpha(set ? acc : 0xFF9AA8C0, set ? 240 : 150), ff))
    kc := 2.2 + 0.5*hkE
    FillEll(knx - kc, ty - kc, kc*2, kc*2, b), DelB(b)

    ; readout, nudged up a hair on change so the eye follows the value
    vc := set ? AccHi(acc, 0.4) : 0xFF9AA8C0
    Txt(o.v[idx], ax + HL.abw - 62, ry + 5 - 2*fl, 46, 16, fBadge
        , FA(Alpha(vc, Round(set ? 235 : 160)), ff), fmtR)
}
; ---------------- CLIENT SETTINGS: the raw flag page ----------------
; A sub-page of the systems panel rather than a sheet: it is the same panel,
; showing a different thing, so it uses the panel's own frame, clip, scrollbar
; and entrance rather than floating a second surface over the hub. DetailOpen
; was the alternative and it is read-only by construction - there is nowhere in
; it to put a field.
;
; RSET.fxT is derived from the clock rather than integrated per frame. An eased
; value that is stepped by the renderer drifts whenever a frame is late, and
; this one gates a cross-fade between two full panels where drift shows as both
; halves being faintly visible at rest.
global RSET_FXMS := 260            ; the cross-fade, in ms
global RSET_FXRH := 34             ; a flag row
global RSET_FXGONE := 380          ; a removed row's whole exit, slide and collapse
global RSET_FXSLIDE := 0.45        ; the fraction of it the slide-out takes
global RSET_FOCMS := 190           ; a field taking or losing the caret
global rsetSrcOn := 0              ; FLAG SOURCE: 0 merge both, 1 one source only
; Named apart from RSetSrcSelect() ON PURPOSE. AHK identifiers are
; case-insensitive, so a global called rsetSrcSelect and the function
; RSetSrcSelect would be the same name - and a function name is a read-only
; global, so the setter's own assignment would fail with "This Func cannot be
; used as an output variable". That is the same collision the `txt` parameter
; caused in RSetFxField, in its other form.
global rsetSrcSel := 1             ; 1 client systems, 2 edit fast flags
; ---- the list's two zone bands ----
; They were 1610 and 1650, forty apart, and the list they index has no bound:
; extras are whatever the user typed plus every flag the picked rows write. At
; forty listed flags the value band walked straight into the delete band, so
; clicking the value box on row 41 resolved to 1651 - delete row 1 - and took a
; flag away instead of editing one. A destructive collision, and one that only
; appears once someone's list is long enough.
;
; 1700 and 1800 with a hundred rows each. 1700..1999 is free zone space (the
; highest id anything else uses is 1699, the page's own scrollbar), the two
; bands cannot meet, and RSetFxZone refuses to address a row past the cap
; rather than wrapping into the next band.
global RSET_FXZVAL := 1700         ; value field  -> RSET_FXZVAL + row
global RSET_FXZDEL := 1800         ; delete       -> RSET_FXZDEL + row
global RSET_FXZMAX := 99           ; rows either band can carry
; The database body's row band. Fixed size: it addresses the visible SLOT, not
; the absolute row, so however long the list grows the band does not.
global RSET_FXZDB  := 1900         ; database row -> RSET_FXZDB + slot
; The height the page takes when it fully owns the module: the systems panel
; plus the gap plus the whole band the STATE card was using. That card describes
; the ROW LIST - flags counted, file written, ALL AUTO - so it does not belong
; behind this page, and the room it was taking is room the flag list wanted.
RSetFxH() => (HL.ffby + RSETCH) - HL.aby
RSetFxT() {
    e := Ease3(Clamp((A_TickCount - RSET.fxAt)/(RSET_FXMS + 0.0), 0.0, 1.0))
    return RSET.fx ? e : 1 - e
}
RSetFxOpen() {
    try FFMEndEdit(false)
    RSET.fx := 1, RSET.fxAt := A_TickCount
    ; the page opens on its LIST every time - a database left up from last time
    ; would hide the thing the button says it opens
    RSET.db := 0, RSET.dbAt := 0, RSET.dbQ := "", RSET.dbCacheQ := "`f"
    RSET.dbScr := 0.0, RSET.dbScrT := 0.0
    RSET.fxScr := 0.0, RSET.fxScrT := 0.0, RSET.fxSel := ""
    RSetDDClose()                  ; a dropdown belongs to the page underneath
    HubPoke()
}
RSetFxClose() {
    if !RSET.fx
        return
    try FFMEndEdit(true)           ; a field left open commits, it does not vanish
    RSetFocSet("")                 ; and the focus ring goes with it
    RSET.fx := 0, RSET.fxAt := A_TickCount
    RSET.fxSel := ""
    HubPoke()
}

; ---- what the page lists ----
; Extras first, because they are the editable half and the reason to be here.
; Both halves sorted by name so the list does not reshuffle when a Map rehashes -
; AHK's Map enumeration order is not promised, and a list that reorders itself
; between frames is unusable.
; ---- built when it CHANGES, not when it is asked for ----
; This is not cheap: RSetPresetFlags walks all 22 rows, RSetFlagOwner walks
; them AGAIN for every flag it finds, and two insertion sorts run on top. It was
; being called four or five times a frame - twice from the hit test, twice from
; the renderer - and the hit test itself runs from WM_NCHITTEST, WM_SETCURSOR
; and HubRender, so a single mouse move over the page rebuilt and re-sorted the
; whole list a dozen times.
;
; The key is a VERSION, not a clock. A tick-bounded memo still rebuilt on every
; new millisecond, which at sixty frames a second is most of them - it removed
; the duplicate builds inside a frame and left one per frame standing. This
; removes that one as well: the list is rebuilt only when something that could
; change it has changed.
;
; Two things can. Extras go through RSetExtraSave, which bumps RSET.fxVer, and
; every path that touches RSET.extra already calls it. Row picks have ten
; assignment sites and no single funnel, so instead of bumping from each - the
; hand-maintained list that put HL.hz where it was - they are folded into a
; SIGNATURE: twenty-two integers, built in a loop that costs a fraction of what
; the rebuild it guards costs, and which cannot go stale because it is derived
; from the picks themselves rather than from remembering to announce them.
RSetFxBump() {
    RSET.fxVer := RSET.fxVer + 1
}
RSetFxSig() {
    s := RSET.fxVer "/" RSET.fxGone.Count
    for o in RSET_OPTS
        s .= "." (RSET.pick.Has(o.k) ? RSET.pick[o.k] : 1)
    return s
}
RSetFxList() {
    static sig := "", memo := 0
    sg := RSetFxSig()
    if (memo && sig = sg)
        return memo
    ; ---- ONE list, sorted by name ----
    ; Extras used to be pushed ahead of the preset pairs as a block, and that
    ; made editing violent: touching a preset's value promotes it to an extra
    ; (see RSetFxEdit), so the row you clicked jumped from wherever it was
    ; straight to the top of the list, under your cursor, mid-click. Sorting the
    ; two together by name means promotion changes what a row IS without moving
    ; where it sits. Nothing is lost - `ext` still says which is which, and the
    ; name, the pip and the subtitle all still read off it.
    pf := RSetPresetFlags()
    out := []
    for k, v in RSET.extra
        out.Push({n: k, v: v, ext: 1, own: RSetFlagRowName(k)})
    for k, v in pf {
        if RSET.extra.Has(k)
            continue               ; the extra overrides it and is already listed
        out.Push({n: k, v: v, ext: 0, own: RSetFlagOwner(k)})
    }
    ; rows on their way out, held at their own place until the collapse finishes
    for k, g in RSET.fxGone {
        if (RSET.extra.Has(k) || pf.Has(k))
            continue
        out.Push({n: k, v: g.v, ext: 1, own: g.own, gone: g.at})   ; on its way out
    }
    RSetFxSort(out)
    sig := sg, memo := out
    return out
}
RSetFxSort(a) {
    i := 2
    while (i <= a.Length) {
        j := i
        while (j > 1 && StrCompare(a[j - 1].n, a[j].n) > 0) {
            t := a[j - 1], a[j - 1] := a[j], a[j] := t
            j--
        }
        i++
    }
}
; ---- a row's pitch, and the totals built from it ----
; A row being removed does not vanish between two frames. It collapses: its
; pitch eases to nothing while it fades and slides out, and the rows under it
; close the gap because they are laid out by ACCUMULATING pitches rather than
; multiplying a constant. The renderer and the hit test both walk the same
; accumulator, so what you can click is always what you can see.
; ---- two phases, in this order ----
; The row LEAVES first - sliding off to the left and fading as it goes - and only
; then does the gap it was in close up. Doing both at once read as the row being
; squashed out of existence rather than taken out of the list; separating them
; means you see the thing go, and then you see the list heal.
RSetFxGoneP(e, now) => Clamp((now - e.gone)/RSET_FXGONE, 0.0, 1.0)
RSetFxRowPitch(e, now) {
    if !e.HasOwnProp("gone")
        return RSET_FXRH
    ; nothing collapses until the slide is done - RSET_FXSLIDE of the way through
    c := Clamp((RSetFxGoneP(e, now) - RSET_FXSLIDE)/(1 - RSET_FXSLIDE), 0.0, 1.0)
    return RSET_FXRH*(1 - Ease3(c))
}
RSetFxTotalOf(rows, now) {
    h := 20
    for e in rows
        h += RSetFxRowPitch(e, now)
    return h
}
RSetFxTotal() => RSetFxTotalOf(RSetFxList(), A_TickCount)

; ---- add ----
RSetFxAdd() {
    try FFMEndEdit(true)           ; whatever is in the fields, take it first
    n := Trim(RSET.fxName), v := Trim(RSET.fxVal)
    if !RSetFlagNameOK(n) {
        RSetSay("THAT IS NOT A FLAG NAME", C_OFF)
        return 0
    }
    if (v = "") {
        RSetSay("GIVE IT A VALUE", C_OFF)
        return 0
    }
    ; The bar is the field separator in the ini blob and would split one flag
    ; into two on the next launch. Stripped rather than refused: it cannot
    ; appear in a value Roblox would accept anyway.
    v := StrReplace(v, "|", "")
    ; adding a name a row is writing is the same act as editing one, so it has
    ; the same consequence: the row hands over and switches off
    o9 := RSetFlagRowOf(n)
    took := (o9 && RSetPresetFlags().Has(n)) ? RSetTakeRow(o9) : 0
    had := RSET.extra.Has(n)
    RSET.extra[n] := v
    RSET.fxFlash[n] := A_TickCount
    RSET.fxAddAt := A_TickCount
    RSET.fxName := "", RSET.fxVal := ""
    RSetExtraSave()
    RSetSay(took ? (StrUpper(o9.n) " IS NOW YOURS - THE ROW IS OFF")
          : (had ? "UPDATED" : "ADDED") (RSET.on ? " - PRESS APPLY AGAIN TO WRITE IT" : ""), RSET.on ? AMBER : 0)
    HubPoke()
    return 1
}
; ---- two different things wear the same X ----
; Pressing it on a flag you typed REMOVES it. Pressing it on a preset pair you
; edited only drops your override - the row that owns the flag goes on writing
; it, at its own value. Both were reported as "REMOVED" and only the first one
; visibly did anything, which is why the button read as broken: half the time
; the row it was pressed on was still sitting there afterwards.
;
; They are told apart here, said apart, and animated apart. A real removal
; leaves a ghost behind that collapses out of the list; a revert flashes the row
; it just handed back.
; ---- removed means removed ----
; It used to hand the flag back to the row that owned it, which is why the X
; read as broken: half the time the row it was pressed on was still sitting
; there afterwards, having quietly reverted rather than gone. Now the flag
; LEAVES. If some row is still writing it - which only happens if that row was
; switched back on from CLIENT SETTINGS after the flag was taken over - that row
; hands over and switches off too, so there is nothing left to put it back.
;
; Getting it back is the client settings row's job, which is the point: one
; place turns a setting on, one place edits it by hand, and they cannot both
; claim the same flag at once.
RSetFxDel(name) {
    if !RSET.extra.Has(name)
        return
    val := RSET.extra[name], own := RSetFlagRowName(name)
    RSET.extra.Delete(name)
    RSET.fxDelAt := A_TickCount
    if (RSET.fxSel = name) {
        try FFMEndEdit(false)
        RSET.fxSel := ""
    }
    ; a row still writing it would put it straight back on the next frame
    also := 0
    if RSetPresetFlags().Has(name) {
        o := RSetFlagRowOf(name)
        if o {
            also := RSetTakeRow(o)
            ; RSetTakeRow re-added it, unless the row it found was not the one
            ; writing it and was already on its leave-alone choice - two rows
            ; can name the same flag - in which case there is nothing to remove
            ; and Map.Delete on a missing key would throw out of a click
            if RSET.extra.Has(name)
                RSET.extra.Delete(name)   ; it is going
        }
    }
    RSET.fxGone[name] := {at: A_TickCount, v: val, own: own}
    RSetExtraSave()               ; carries the version bump the list memo reads
    RSetSay(also ? ("REMOVED - " StrUpper(own) " IS OFF, TURN IT BACK ON IN CLIENT SETTINGS")
          : RSET.on ? "REMOVED - PRESS APPLY AGAIN TO WRITE IT" : "REMOVED"
          , RSET.on ? AMBER : 0)
    HubPoke()
}
; Editing a PRESET pair promotes it: the value it currently has becomes an
; extra, and the extra is what gets edited. Nothing is lost - the row keeps its
; pick and keeps writing, the override just wins from now on, and deleting the
; override hands the flag straight back to the row. That is a good deal cleaner
; than letting a text field reach into a dropdown's chosen index and try to find
; a matching entry, which for a free-typed value usually does not exist.
RSetFxEdit(name) {
    ; ---- same mode, different row, still a different field ----
    ; Every row on this page edits under the one "rfe" mode and is told apart by
    ; RSET.fxSel, so FFMBeginEdit's `FFM.edit != mode` test could not see the
    ; difference: clicking straight from one row's value box into another's
    ; skipped the commit and threw away whatever had been typed into the first.
    ; Committed here, before fxSel moves and the comparison stops being possible.
    if (FFM.edit = "rfe" && RSET.fxSel != "" && RSET.fxSel != name)
        FFMEndEdit(true)
    if !RSET.extra.Has(name) {
        base := RSetPresetFlags()
        if !base.Has(name)
            return
        ; the whole row comes across, and the row switches itself off - see
        ; RSetTakeRow. Nothing is lost and nothing is written twice.
        o := RSetFlagRowOf(name)
        if (o && RSetTakeRow(o)) {
            RSetSay(StrUpper(o.n) " IS NOW YOURS - THE ROW IS OFF", RSET.on ? AMBER : 0)
        } else {
            RSET.extra[name] := base[name]
            RSetExtraSave()
        }
        if !RSET.extra.Has(name)   ; belt and braces: never open an editor on nothing
            return
    }
    RSET.fxSel := name
    FFMBeginEdit("rfe", 0)
}

; ---- the page ----
RSetFxPage(ax, ay, pah, ff, now, acc) {
    if (ff <= 0.01)
        return
    ; ---- borrow the clip, hand it back ----
    ; Every exit from here used to finish on GdipResetClip, which does not pop
    ; one level - it drops the clip entirely. Mid-crossfade this function is
    ; called from INSIDE the systems panel's own clip, so the rows drawn after
    ; it painted straight over the panel chrome and out past its rounded
    ; corners. Save the state on the way in, restore it on the way out.
    stP := PushG()
    ; ---- ONE slide, applied to everything ----
    ; The page slides in from the right as the rows slide out to the left, and
    ; `sl` used to be added to the left-anchored items only: the title, the note
    ; and the two add fields moved while BACK, ADD, the fade line, every row's
    ; name, pip, value box and delete cross, and the scrollbar all sat still and
    ; simply faded. Half a page arriving and half a page appearing is not one
    ; animation. `cx` carries it for the whole of the CONTENT; the frame and the
    ; clip stay at `ax`, because they are the panel's shape rather than the
    ; page's contents - which is exactly what makes the content look like it is
    ; sliding in behind them.
    sl := (1 - ff)*22
    cx := ax + sl
    ; ---- its own frame, always ----
    ; It used to be conditional on the page already being taller than the panel,
    ; which meant the frame appeared halfway through the transition. The panel
    ; behind is fading out over the same interval (see fPan in RSetSystems), so
    ; drawing this one throughout is what makes the two read as one crossfade.
    b := VBrush(ax, ay, HL.abw, pah, FA(0xFF181C34, ff), FA(0xFF12141F, ff))
    FillRR(ax, ay, HL.abw, pah, 12, b), DelB(b)
    MiniBackdrop(ax, ay, HL.abw, pah, 12, acc, ff, now, 0.9)
    pn := Pen(FA(Alpha(acc, 160), ff), 1.2)
    StrokeRR(ax, ay, HL.abw, pah, 12, pn), DelP(pn)
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), 200), ff), 1.6)
    Line(ax + 14, ay + 0.6, ax + 54, ay + 0.6, pn)
    Line(ax + HL.abw - 54, ay + pah - 0.6, ax + HL.abw - 14, ay + pah - 0.6, pn), DelP(pn)
    pC := RRPath(ax, ay, HL.abw, pah, 12)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC, "int", 1)
    DllCall("gdiplus\GdipDeletePath", "ptr", pC)

    hy := ay + 10
    ; MEASURED, not a fixed box. A 160-wide box around a 70-wide title is 90
    ; pixels of invisible label sitting on the count beside it.
    tw0 := MeasureW("FAST FLAGS", fBadge)
    Txt("FAST FLAGS", cx + 16, hy, tw0 + 4, 18, fBadge
        , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.2), 240), ff), fmtL)
    nx := RSET.extra.Count
    Txt(nx ? (nx " custom") : "none yet", cx + 16 + tw0 + 12, hy + 2, 120, 14, HL.fXs
        , FA(Alpha(acc, 170), ff), fmtL)
    ; DATABASE sits beside BACK and swaps the page's body for the whitelist.
    ; Labelled for what pressing it does, so it reads as one control with two
    ; states rather than two controls that happen to share a spot.
    dbT := RSetDbT()
    FFMBtn(1604, cx + HL.abw - 172, hy - 3, 76, 22
         , RSET.db ? "LIST" : "DATABASE", acc, ff, RSET.db ? 2 : 0)
    FFMBtn(1600, cx + HL.abw - 88, hy - 3, 72, 22, "BACK", acc, ff, 2)
    ; ---- the note, or the last thing that happened ----
    ; RSetSay is where this page reports ADDED, REMOVED, "THAT IS NOT A FLAG
    ; NAME" and a failed save, and the STATE card is the only other thing that
    ; renders RSET.msg - and the card sits behind this page. So the page carries
    ; its own line and hands it back to the note once the message has aged out.
    fresh := (RSET.msgAt && now - RSET.msgAt < 4000)
    ; No "unknown" any more. The allowlist is explicit and this module carries
    ; it, so every name here is either read or ignored and the line says which.
    note := !RSetSrcExtra() ? "FLAG SOURCE is CLIENT SYSTEMS - nothing on this page is being written"
          : RSET.db ? "everything this module writes  ·  green is on roblox's allowlist  ·  click one to add it"
                    : "green is on roblox's allowlist  ·  red is written but ignored  ·  the list can change"
    Txt(FFMElide(fresh ? RSET.msg : note, HL.fXs, HL.abw - 200)
      , cx + 16, hy + 20, HL.abw - 200, 14, HL.fXs
      , FA(Alpha(fresh ? RSET.msgCol : 0xFFC7CBE0, fresh ? 235 : 110), ff), fmtL)
    FadeLine(cx + 14, cx + HL.abw - 14, hy + 40, 0x30FFFFFF, ff)

    ay2  := hy + 48
    lTop := ay2 + 36
    lBot := ay + pah - 8           ; follows the page height as it grows
    if (lBot - lTop < 30) {
        Pop(stP)
        return
    }
    ; ---- the page's two bodies ----
    ; Same crossfade shape as the panel's, one level down: the add row and the
    ; written-flag list slide out to the left as the database slides in from the
    ; right. The header above is shared and does not move.
    ; `sl` is the PAGE's slide and `dbT`'s term is the body swap's - a body has
    ; to carry both. Splitting the body out of this function dropped the first
    ; one on the floor, so the header slid in and the add row, the list and the
    ; database all stood still and merely faded. Two animations for one page.
    if (dbT < 0.996)
        RSetFxBody(ax, ay, ay2, lTop, lBot, ff*(1 - dbT), sl - dbT*26, now, acc)
    if (dbT > 0.004)
        RSetDbBody(ax, ay, ay2, lTop, lBot, ff*dbT, sl + (1 - dbT)*26, now, acc)

    Pop(stP)
}

; ---- body one: the add row and everything being written ----
RSetFxBody(ax, ay, ay2, lTop, lBot, ff, sld, now, acc) {
    cx := ax + sld
    edN := (FFM.edit = "rfn"), edV := (FFM.edit = "rfv")
    nw  := Round((HL.abw - 32)*0.52), vw := HL.abw - 32 - nw - 76
    nfx := cx + 16, vfx := cx + 16 + nw + 8
    vN  := edN ? FFM.buf : RSET.fxName
    vV  := edV ? FFM.buf : RSET.fxVal
    fcN := RSetFocOf("rfn"), fcV := RSetFocOf("rfv")
    RSetFxField(1601, nfx, ay2, nw, 26, vN, fcN, acc, ff, now)
    RSetFxField(1602, vfx, ay2, vw, 26, vV, fcV, acc, ff, now)
    ; the other half of RSetDbPick's acknowledgement - drawn between the field
    ; and its text so the name reads on top of the wash rather than under it
    if RSET.landAt {
        lt := (now - RSET.landAt)/FFM_INSMS
        FFMInsPulse(nfx, ay2, nw, 26, 7, lt, ff)
        if (lt >= 1)
            RSET.landAt := 0
    }
    RSetFxText(nfx, ay2, nw, 26, vN, "flag name", edN, fcN, acc, ff, now)
    RSetFxText(vfx, ay2, vw, 26, vV, "value", edV, fcV, acc, ff, now)
    okAdd := RSetFlagNameOK(vN) && Trim(vV) != ""
    FFMBtn(1603, cx + HL.abw - 76, ay2 + 1, 60, 24, "ADD", acc, ff, okAdd ? 1 : 4)

    ; cx, not ax. The clip is the list's own window and belongs to the body, not
    ; to the page frame - left at ax it held still while everything inside it
    ; slid, which is the whole list block refusing to join the animation.
    pL := RRPath(cx + 8, lTop, HL.abw - 16, lBot - lTop, 8)
    st := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pL, "int", 1)
    rows := RSetFxList()
    if !rows.Length
        Txt("nothing is being written yet - pick some presets, or add a flag above"
          , cx + 16, lTop + 16, HL.abw - 32, 16, HL.fXs, FA(0x62C7CBE0, ff), fmtC)
    ; once, not once per row: RSetPresetFlags walks all 22 rows and their flag
    ; maps, and the delete button below needs to know whether the flag would
    ; still be written after the override goes
    pfB := RSetPresetFlags()
    ; ACCUMULATED, not multiplied: a row on its way out has a shrinking pitch and
    ; the rows under it have to close the gap. See RSetFxRowPitch.
    yacc := lTop + 6 - RSET.fxScr
    for i2, e in rows {
        ; the hit test stops here too - a row drawn past the band would carry a
        ; zone id that already belongs to another row, so it would light up and
        ; act as that other row rather than as itself
        if (i2 > RSET_FXZMAX)
            break
        ry   := yacc
        pitch := RSetFxRowPitch(e, now)
        yacc += pitch
        if (ry + RSET_FXRH < lTop || ry > lBot)
            continue
        ; the per-row entrance is staggered off the page fade, the way the
        ; systems rows stagger off the panel opening
        cg := Clamp((ff - 0.25 - Min(i2, 5)*0.05)/0.5, 0.0, 1.0)
        if (cg <= 0.01)
            continue
        ; ---- on the way out ----
        ; Phase one: the row travels off the left edge and fades. Its pitch is
        ; untouched, so the rows under it hold their places and watch it go.
        ; Phase two is the pitch collapsing - see RSetFxRowPitch - by which time
        ; this row is already invisible and what you see is the gap closing.
        gs := e.HasOwnProp("gone")
            ? Ease3(Clamp(RSetFxGoneP(e, now)/RSET_FXSLIDE, 0.0, 1.0)) : 0.0
        fb := cg*(1 - gs)
        if (fb <= 0.01)
            continue
        rx := cx - gs*(HL.abw + 24)
        gp := gs
        ; the row lights with its own field: focus is a row-level fact, and a
        ; lit plate is what says WHICH row the caret is in when the list is long
        hv := Max(HL.h.Get(RSET_FXZVAL + i2, 0.0), HL.h.Get(RSET_FXZDEL + i2, 0.0)
                , RSetFocOf(e.n)*0.85)
        if gp
            hv := 0.0
        fl := RSET.fxFlash.Has(e.n) ? RSET.fxFlash[e.n] : 0
        gl := (fl && now - fl < 900) ? 1 - (now - fl)/900.0 : 0.0
        if (hv > 0.01 || gl > 0.01) {
            b := HBrush(rx + 12, ry, HL.abw - 24, RSET_FXRH - 4
                      , FA(Alpha(gl > 0.01 ? acc : 0xFFFFFF, (gl > 0.01 ? 26*gl : 14*hv)), fb)
                      , FA(Alpha(0xFFFFFF, 3*hv), fb))
            FillRR(rx + 12, ry, HL.abw - 24, RSET_FXRH - 4, 7, b), DelB(b)
        }
        ; status pip: on the list / off it / not known
        st2 := RSetFlagStatus(e.n)
        pc  := (st2 = 1) ? C_ON : (st2 = 2) ? C_OFF : AMBER
        b := SBrush(FA(Alpha(pc, e.ext ? 210 : 150), fb))
        FillEll(rx + 20, ry + RSET_FXRH/2 - 6, 5, 5, b), DelB(b)
        ; name, then the value on the right
        edThis := (FFM.edit = "rfe" && RSET.fxSel = e.n)
        ; a row on its way out cannot hold the caret, whatever the clock says
        fcR := gp ? 0.0 : RSetFocOf(e.n)
        ; ---- one edge, derived from the other, and the gap follows the focus ----
        ; nwid comes FROM vx: computed independently they disagreed by 2 px and
        ; the name box ran under the value box on every row.
        ;
        ; And vx carries the focus. A permanent 34px notch for a button that is
        ; only there sometimes reads as a hole, so the value box slides left to
        ; open the space as the X arrives and slides back when it goes - there is
        ; never a gap with nothing in it. The hit test derives its rectangles the
        ; same way from the same eased number, so what answers is what is drawn.
        vwid := 150
        vx   := rx + HL.abw - 20 - vwid - (e.ext ? 34*fcR : 0)
        nwid := vx - (rx + 34) - 10
        Txt(FFMElide(e.n, fBadge, nwid), rx + 34, ry + 3, nwid, 15, fBadge
            , FA(Alpha(e.ext ? Mix(0xFFE8EAF6, acc, 0.2) : 0xFFC7CBE0, e.ext ? 235 : 170), fb), fmtL)
        ; ---- where it came from, and whether roblox will read it ----
        ; A taken-over flag has no CURRENT owner - taking it switched that row
        ; off - so the row name is looked up against every choice rather than
        ; against what is live, and the line says the row is off rather than
        ; pretending the flag arrived from nowhere.
        ; "is off" only while it is. A row switched back on from CLIENT
        ; SETTINGS after the take-over writes the flag again, and this override
        ; wins the merge (see RSetFlags) - which is what the line says then.
        if !e.ext
            sub := (e.own != "") ? ("from " e.own) : "from a preset"
        else if (st2 != 1)
            sub := "off roblox's list - ignored in the file"
        else if (e.own != "")
            sub := pfB.Has(e.n) ? ("yours  ·  overrides " e.own) : ("yours  ·  " e.own " is off")
        else
            sub := "yours  ·  on roblox's list"
        Txt(FFMElide(sub, HL.fXs, nwid), rx + 34, ry + 17, nwid, 13, HL.fXs
            , FA(Alpha((st2 = 2) ? C_OFF : 0xFFC7CBE0, 130), fb), fmtL)
        ; every row is a field - a preset's value is editable and promotes
        ; itself to an override the moment it is touched
        vRow := edThis ? FFM.buf : e.v
        RSetFxField(RSET_FXZVAL + i2, vx, ry + 3, vwid, 24, vRow, fcR, acc, fb, now)
        RSetFxText(vx, ry + 3, vwid, 24, vRow, "value", edThis, fcR, acc, fb, now)
        if (e.ext && !gp)
            RSetFxDelBtn(RSET_FXZDEL + i2, rx + HL.abw - 46, ry + 3, 26, 24, acc, fb, now
                       , pfB.Has(e.n) ? 2 : 1, fcR)
    }
    ; scrollbar, matching the systems panel's own. `rows` is already in hand -
    ; asking RSetFxTotal() would rebuild and re-sort the same list a second time.
    tot := RSetFxTotalOf(rows, now), vis := lBot - lTop
    if (tot > vis) {
        sbS := Max(HL.h.Get(1699, 0.0), (HL.drag = 21) ? 1.0 : 0.0)
        sw2 := 3 + 3*sbS
        sxs := cx + HL.abw - 14 - 3*sbS
        b := SBrush(FA(Alpha(0xFFFFFF, 18 + 26*sbS), ff))
        FillRR(sxs, lTop + 4, sw2, vis - 8, sw2/2, b), DelB(b)
        th2 := Max(22, (vis - 8)*(vis/tot))
        ty2 := lTop + 4 + (vis - 8 - th2)*(RSET.fxScr/Max(1, tot - vis))
        b := VBrush(sxs, ty2, sw2, th2, FA(Alpha(AccHi(acc, 0.35), 190 + 65*sbS), ff)
                  , FA(Alpha(acc, 170 + 60*sbS), ff))
        FillRR(sxs, ty2, sw2, th2, sw2/2, b), DelB(b)
    }
    Pop(st)
    DllCall("gdiplus\GdipDeletePath", "ptr", pL)
}

; ============================================================================
;  THE WHITELIST DATABASE  -  the page's second body
;  Built like the FAST FLAG MANAGER's database and deliberately so: same header
;  rail, same search field with its magnifier, same clipped list with a hover
;  rail per row, same scrollbar, same footer line. What differs is the source
;  and what a click does.
;
;  SOURCE. Roblox allowlisted which Fast Flags a local ClientAppSettings.json
;  may set (Sept 2025), and this module already records which of its own rows
;  survived that - the `al` field on every entry in RSET_OPTS. So the list here
;  is every flag name carried by an allowlisted row, with the row that writes
;  it. It is honest about its size rather than padded: a name that is not in
;  here is not one this module can vouch for.
;
;  A CLICK fills the ADD row's name and puts the caret in the value box, rather
;  than staging with a default the way FFM does. A fast flag's value is the
;  whole point of setting it, and "true" is wrong for most of these.
; ============================================================================
global RSET_DBRH := 26             ; one database row
global RSET_DBSLOTS := 14          ; visible slots, and the size of the zone band

RSetDbT() {
    e := Ease3(Clamp((A_TickCount - RSET.dbAt)/(RSET_FXMS + 0.0), 0.0, 1.0))
    return RSET.db ? e : 1 - e
}
RSetDbOpen(on) {
    if (RSET.db = (on ? 1 : 0))
        return
    try FFMEndEdit(true)
    RSET.db := on ? 1 : 0, RSET.dbAt := A_TickCount
    RSET.dbScr := 0.0, RSET.dbScrT := 0.0
    HubPoke()
}

; ---- EVERY flag name the option table carries ----
; It was filtered to `al` rows only, which dropped the three LIGHTING TECHNOLOGY
; names entirely - so the database was missing flags the written list two
; keystrokes away was happily showing and marking red. A database you have to
; leave to look something up is not one.
;
; So the filter is gone and the STATUS comes with each name instead: green for
; the ones Roblox honours out of ClientAppSettings.json, red for the ones that
; did not survive the Sept 2025 allowlist and need the flag manager's live
; injection. Sorted, built once - the option table is a literal and cannot
; change while the script runs.
;
; The honest limit, and it is stated on the page rather than hidden: this is
; every name THIS MODULE knows. Roblox publishes no allowlist and nothing here
; fetches one, so a flag no row of this module writes is not in here.
RSetDbAll() {
    static all := 0
    if all
        return all
    seen := Map(), out := []
    for o in RSET_OPTS {
        if !o.HasOwnProp("f")
            continue
        for m in o.f {
            for k, v in m {
                if seen.Has(k)
                    continue
                seen[k] := 1
                out.Push({n: k, own: o.n, st: RSetFlagStatus(k)})
            }
        }
    }
    RSetFxSort(out)                ; same insertion sort the written list uses
    all := out
    return all
}
; Filtered, and cached against the filter text - the renderer and the hit test
; both want it, and both run more than once a frame.
RSetDbList() {
    q := Trim(RSET.dbQ)
    if (RSET.dbCache && RSET.dbCacheQ = q)
        return RSET.dbCache
    out := []
    for e in RSetDbAll() {
        if (q = "" || InStr(e.n, q))
            out.Push(e)
    }
    RSET.dbCacheQ := q, RSET.dbCache := out
    return out
}
; A name already written by this module - typed as an extra, or carried by a row
; the user has set. `pf` is passed in rather than fetched: RSetPresetFlags walks
; all 22 rows and their flag maps, and calling it once per visible row per frame
; is the same mistake the written list was making before it was memoised.
RSetDbHave(nm, pf) {
    if RSET.extra.Has(nm)
        return 2
    return pf.Has(nm) ? 1 : 0
}
RSetDbPick(nm) {
    ; Two stamps, because this manager's panel CLOSES on the pick. The row
    ; pulse only gets the first frames of the close slide, so the field the
    ; name lands in carries the rest of the acknowledgement - otherwise the
    ; database blinks shut and the name appears with nothing connecting them.
    RSET.dbIns[StrLower(nm)] := A_TickCount
    RSET.landAt := A_TickCount
    RSET.fxName := nm
    RSetDbOpen(0)
    FFMBeginEdit("rfv", 0)         ; name filled, caret straight into the value
    RSetSay("NAME SET - GIVE IT A VALUE", 0)
}
RSetDbDragScroll(sy) {
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    lTop := HL.aby + 10 + 48 + 36, lBot := HL.aby + RSetFxH() - 8
    vis := lBot - lTop, tot := RSetDbList().Length*RSET_DBRH
    thmb := Max(22, (vis - 8)*(vis/Max(1, tot)))
    RSET.dbScrT := FFMScrollFromY(uy, lTop + 4, vis - 8, tot, vis, thmb, RSET.dbScr)
    RSET.dbScr := RSET.dbScrT
    HubPoke()
}

; ---- body two: the database ----
RSetDbBody(ax, ay, ay2, lTop, lBot, ff, sld, now, acc) {
    cx := ax + sld
    ; ---- search field ----
    ; Sits exactly where the add row's boxes sit, so the two bodies swap without
    ; anything jumping vertically. Construction is FFM's: plate, micro backdrop,
    ; border that goes accent while focused, magnifier on the left.
    ed := (FFM.edit = "rfd"), hvq := HL.h.Get(1606, 0.0)
    fcD := RSetFocOf("rfd")        ; eased, so this box arrives like the others
    sy := ay2
    b := SBrush(FA(0xFF0C0E17, ff))
    FillRR(cx + 16, sy, HL.abw - 32, 26, 7, b), DelB(b)
    MicroBackdrop(cx + 16, sy, HL.abw - 32, 26, 7, acc, ff, now, 0.75)
    if (fcD > 0.01 && fcD < 0.995 && !hubLowPerf) {
        pr := Sin(fcD*3.14159265)
        ex := (1 - fcD)*11
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(190*pr)), ff), 1.4*pr + 0.2)
        StrokeRR(cx + 16 - ex, sy - ex*0.55, HL.abw - 32 + ex*2, 26 + ex*1.1, 7 + ex*0.35, pn), DelP(pn)
    }
    pn := Pen(FA(Alpha(THMix(0xFFFFFF, acc, fcD)
                     , Round((26 + 30*hvq) + (170 - (26 + 30*hvq))*fcD)), ff), 1.2 + 0.1*fcD)
    StrokeRR(cx + 16, sy, HL.abw - 32, 26, 7, pn), DelP(pn)
    pn := Pen(FA(Alpha(THMix(0xFF9AA8C0, acc, fcD)
                     , Round((115 + 60*hvq) + (190 - (115 + 60*hvq))*fcD)), ff), 1.4)
    Ell(cx + 26, sy + 7, 11, 11, pn)
    Line(cx + 36, sy + 17, cx + 40, sy + 21, pn), DelP(pn)

    lst := RSetDbList()
    qMax := HL.abw - 150
    qTxt := ed ? FFM.buf : RSET.dbQ
    if (qTxt = "")
        Txt("type to filter  ·  ENTER takes the first match", cx + 48, sy, qMax, 26
          , fHint, FA(0x5EC7CBE0, ff), fmtL)
    else
        Txt(RSetFxFit(qTxt, qMax), cx + 48, sy, qMax, 26, HL.fM
          , FA(Alpha(0xFFE8EAF6, 235), ff), fmtL)
    if ed {
        qv := RSetFxFit(qTxt, qMax)
        FFMFldPaint(cx + 48, sy, 26, qv, StrLen(qTxt) - StrLen(qv), acc, ff, now)
    }
    Txt(lst.Length " of " RSetDbAll().Length, cx + HL.abw - 122, sy, 100, 26, HL.fS
      , FA(0x66C7CBE0, ff), fmtR)
    ; the hover rail's own left edge, so the pip column reads as part of the row

    ; ---- the list ----
    pL := RRPath(cx + 8, lTop, HL.abw - 16, lBot - lTop, 8)
    st := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pL, "int", 1)
    if !lst.Length
        Txt("nothing matches that", cx + 16, lTop + 16, HL.abw - 32, 16, HL.fXs
          , FA(0x62C7CBE0, ff), fmtC)
    pf    := RSetPresetFlags()     ; once, not once per row - see RSetDbHave
    ry0   := lTop + 4 - Mod(RSET.dbScr, RSET_DBRH)
    first := Floor(RSET.dbScr/RSET_DBRH) + 1
    loop RSET_DBSLOTS {
        k   := A_Index
        idx := first + k - 1
        if (idx < 1 || idx > lst.Length)
            continue
        e  := lst[idx]
        ry := ry0 + (k - 1)*RSET_DBRH
        if (ry > lBot || ry + RSET_DBRH < lTop)
            continue
        ; staggered off the body's own fade, the way the written list is
        cg := Clamp((ff - 0.25 - Min(k, 5)*0.05)/0.5, 0.0, 1.0)
        if (cg <= 0.01)
            continue
        fb := cg
        hv := HL.h.Get(RSET_FXZDB + k, 0.0)
        if (hv > 0.01) {
            b := HBrush(cx + 12, ry, HL.abw - 30, RSET_DBRH - 2
                      , FA(Alpha(0xFFFFFF, 17*hv), fb), FA(Alpha(0xFFFFFF, 3*hv), fb))
            FillRR(cx + 12, ry, HL.abw - 30, RSET_DBRH - 2, 6, b), DelB(b)
            b := SBrush(FA(Alpha(acc, 200*hv), fb))
            FillRR(cx + 18, ry + 6, 2.5, RSET_DBRH - 14, 1.2, b), DelB(b)
        }
        FFMInsPulse(cx + 12, ry, HL.abw - 30, RSET_DBRH - 2, 6
                  , FFMInsT(RSET.dbIns, e.n, now), fb)
        have := RSetDbHave(e.n, pf)
        ; the same pip the written list uses, saying the same thing - on
        ; roblox's list, off it, or not known
        pc := (e.st = 1) ? C_ON : (e.st = 2) ? C_OFF : AMBER
        b := SBrush(FA(Alpha(pc, 190), fb))
        FillEll(cx + 20, ry + RSET_DBRH/2 - 2.5, 5, 5, b), DelB(b)
        nw2  := (HL.abw - 150) - 42
        Txt(FFMElide(e.n, HL.fM, nw2), cx + 32, ry, nw2, RSET_DBRH - 2, HL.fM
          , FA(Alpha(have ? 0xFF6E7590 : 0xFFE8EAF6, 200 + 45*hv), fb), fmtL)
        ; what is already writing it, or nothing - the same fact the written
        ; list's subtitle carries, said in the space a row here has
        tag := (have = 2) ? "custom" : (have = 1) ? "set" : ""
        if (tag != "")
            Txt(tag, cx + HL.abw - 122, ry, 46, RSET_DBRH - 2, HL.fS
              , FA(Alpha(have = 2 ? acc : C_ON, 190), fb), fmtR)
        Txt(FFMElide(e.own, HL.fXs, 66), cx + HL.abw - 72, ry, 56, RSET_DBRH - 2, HL.fXs
          , FA(0x62C7CBE0, fb), fmtR)
    }
    Pop(st)
    DllCall("gdiplus\GdipDeletePath", "ptr", pL)

    tot := lst.Length*RSET_DBRH, vis := lBot - lTop
    if (tot > vis) {
        sbS := Max(HL.h.Get(1607, 0.0), (HL.drag = 22) ? 1.0 : 0.0)
        sw2 := 3 + 3*sbS
        sxs := cx + HL.abw - 14 - 3*sbS
        b := SBrush(FA(Alpha(0xFFFFFF, 18 + 26*sbS), ff))
        FillRR(sxs, lTop + 4, sw2, vis - 8, sw2/2, b), DelB(b)
        th2 := Max(22, (vis - 8)*(vis/tot))
        ty2 := lTop + 4 + (vis - 8 - th2)*(RSET.dbScr/Max(1, tot - vis))
        b := VBrush(sxs, ty2, sw2, th2, FA(Alpha(AccHi(acc, 0.35), 190 + 65*sbS), ff)
                  , FA(Alpha(acc, 170 + 60*sbS), ff))
        FillRR(sxs, ty2, sw2, th2, sw2/2, b), DelB(b)
    }
}

; ---- the remove control ----
; It was a flat plate with two hairlines on it - no press, no ripple, no colour,
; the only control on the page that did not answer being used. Built like the
; suite's other glyph buttons instead: the plate warms toward the OFF colour on
; hover, a ring picks it out, the cross grows and turns a few degrees, and a
; press dips it and throws a ripple the way FFMBtn does. `kind` 1 is a real
; removal, 2 is dropping an override - the second is a softer action and says so
; by staying accent-coloured rather than going red.
RSetFxDelBtn(z, bx, by, bw, bh, acc, ff, now, kind, ap := 1.0) {
    ; `ap` is the row's focus, eased. The remove control belongs to the row that
    ; has the caret and to no other, so it arrives and leaves with the focus
    ; rather than sitting on every override the list happens to hold.
    if (ap <= 0.01)
        return
    ff  := ff*ap
    bx  += (1 - ap)*16             ; slides in from the right edge it lives on
    hv  := HL.h.Get(z, 0.0)
    hvE := Ease3(hv)
    col := (kind = 1) ? C_OFF : acc
    press := 0.0, ripple := 0.0
    if FFM.clickAt.Has(z) {
        el := now - FFM.clickAt[z]
        if (el < 420) {
            press  := el < 90 ? (el/90.0) : Max(0.0, 1 - EBackOut(Clamp((el - 90)/330.0, 0.0, 1.0), 1.7))
            ripple := Clamp(el/420.0, 0.0, 1.0)
        }
    }
    cxb := bx + bw/2, cyb := by + bh/2
    st := PushXform(cxb, cyb
        , hubLowPerf ? 1 : (0.62 + 0.38*ap)*(1 + 0.06*hvE - 0.07*press), 0)
    if (ripple > 0.01 && ripple < 1.0 && !hubLowPerf) {
        rr := ripple**0.55
        pn := Pen(FA(Alpha(col, Round(190*(1 - ripple)**1.6)), ff), 1.4*(1 - ripple) + 0.3)
        StrokeRR(bx - 12*rr, by - 8*rr, bw + 24*rr, bh + 16*rr, 7 + 6*rr, pn), DelP(pn)
    }
    b := SBrush(FA(Alpha(hvE > 0.01 ? col : 0xFFFFFF, Round(8 + 44*hvE)), ff))
    FillRR(bx, by, bw, bh, 7, b), DelB(b)
    if (hvE > 0.01) {
        pn := Pen(FA(Alpha(col, Round(180*hvE)), ff), 1.1)
        StrokeRR(bx, by, bw, bh, 7, pn), DelP(pn)
    }
    ; the cross, on its own transform so it can turn without dragging the plate
    stC := PushXform(cxb, cyb, 1 + 0.12*hvE, hubLowPerf ? 0 : 12*hvE)
    pn := Pen(FA(Alpha(hvE > 0.01 ? AccHi(col, 0.35) : 0xFF9AA8C0, Round(160 + 90*hvE)), ff), 1.7)
    r2 := 4.2
    Line(cxb - r2, cyb - r2, cxb + r2, cyb + r2, pn)
    Line(cxb + r2, cyb - r2, cxb - r2, cyb + r2, pn), DelP(pn)
    Pop(stC)
    Pop(st)
}

; ---- one text field: the CHROME only ----
; The plate, the border and the caret. The text itself is drawn by the caller,
; and that is not a style choice.
;
; This function's sixth parameter used to be named `txt` - and AHK variable
; names are case-insensitive, so inside this function `txt` and the global
; drawing routine `Txt` are THE SAME NAME. Every `Txt(...)` in here was resolving
; against a local string instead of the function, which is why the plate and the
; border drew perfectly and not one character ever appeared: values, typed text
; and placeholders alike. Two rounds of replacing the string, the font, the
; colour and the rectangle changed nothing, because none of those were ever the
; problem.
;
; A sweep of all 995 functions in this file found exactly one collision of this
; shape, and it was this one. The parameter is renamed, and the text draw is
; moved out to RSetFxPage where `Txt` is unambiguous and demonstrably works -
; the row names and subtitles beside these fields are drawn by the same call
; three lines away and have always rendered.
RSetFxField(z, fx, fy, fw, fh, val, foc, acc, ff, now) {
    hv := HL.h.Get(z, 0.0)
    ; ---- taking the caret is a MOVEMENT, not a state ----
    ; The border used to jump from grey to accent and the fill from 10 to 20 on
    ; the frame the field was clicked - the one control on the page that changed
    ; without travelling. `foc` is the eased 0..1 from RSetFocOf, so both ends
    ; interpolate and the field that is losing focus plays the same thing
    ; backwards at the same time.
    st := PushXform(fx + fw/2, fy + fh/2, hubLowPerf ? 1 : (1 + 0.014*foc), 0)
    ; the ring, once, on the way in - the same expanding-edge language the chips
    ; and the buttons flash with, so a field arriving reads like the rest of the
    ; suite rather than like a different app
    if (foc > 0.01 && foc < 0.995 && !hubLowPerf) {
        pr := Sin(foc*3.14159265)              ; 0 -> 1 -> 0 across the change
        ex := (1 - foc)*11
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(190*pr)), ff), 1.4*pr + 0.2)
        StrokeRR(fx - ex, fy - ex*0.55, fw + ex*2, fh + ex*1.1, 7 + ex*0.35, pn), DelP(pn)
    }
    b := SBrush(FA(Alpha(0xFFFFFF, Round((10 + 8*hv) + (20 - (10 + 8*hv))*foc)), ff))
    FillRR(fx, fy, fw, fh, 7, b), DelB(b)
    pn := Pen(FA(Alpha(THMix(acc, AccHi(acc, 0.4), foc)
                     , Round((60 + 60*hv) + (190 - (60 + 60*hv))*foc)), ff), 1 + 0.4*foc)
    StrokeRR(fx, fy, fw, fh, 7, pn), DelP(pn)
    ; a rail down the caret edge, growing out of the middle as focus lands
    if (foc > 0.01) {
        rh := (fh - 10)*foc
        b := SBrush(FA(Alpha(AccHi(acc, 0.45), Round(210*foc)), ff))
        FillRR(fx + 2.5, fy + fh/2 - rh/2, 2, rh, 1, b), DelB(b)
    }
    Pop(st)
    ; the caret and the selection are FFMFldPaint's, drawn by the caller right
    ; after the text - see RSetFxText. A field that draws its own caret cannot
    ; show a selection, which is half of what a text box is for.
}

; ---- text, selection and caret for one of the page's fields ----
; One place, three call sites, and it is what gives these boxes the same
; behaviour every other field in the suite has: click to place the caret,
; drag or double-click to select, and a highlight behind the selection.
RSetFxText(fx, fy, fw, fh, val, hint, active, foc, acc, ff, now) {
    tx := fx + 9, tw := fw - 18
    if (val = "") {
        ; the placeholder yields AS the caret arrives rather than the instant it
        ; does - it used to pop out and back in on either side of a click
        if (hint != "" && foc < 0.995)
            Txt(hint, tx, fy, tw, fh, fHint, FA(0x55C7CBE0, ff*(1 - foc)), fmtL)
    }
    else {
        vis := RSetFxFit(val, tw)
        Txt(vis, tx, fy, tw, fh, HL.fM, FA(Alpha(0xFFE8EAF6, 235), ff), fmtL)
    }
    if active {
        vis := RSetFxFit(val, tw)
        FFMFldPaint(tx, fy, fh, vis, StrLen(val) - StrLen(vis), acc, ff, now)
    }
}

; The visible window of a field's text: wound back from the LEFT until the end
; fits, because the end is where the caret is and that is the part you are
; typing. Returns a string and draws nothing, so it is safe anywhere.
; ---- focus, as an eased 0..1 per field ----
; RSetFocSet is called from FFMBeginEdit and FFMEndEdit, so every route into and
; out of a field goes through it: a click, TAB, ENTER, ESC, clicking away, the
; hub losing the foreground, the page closing.
;
; The `focKey != ""` guard is what makes a SWAP read as one movement. Leaving a
; field clears focKey and remembers it in focOut; arriving at the next one does
; not overwrite focOut, because there is nothing left to remember. Both halves
; then share the same focAt, so the old ring falls as the new one rises instead
; of the old one snapping off.
RSetFocSet(key) {
    if (RSET.focKey = key)
        return
    if (RSET.focKey != "")
        RSET.focOut := RSET.focKey
    RSET.focKey := key
    RSET.focAt := A_TickCount
    HubPoke()
}
RSetFocOf(key) {
    if (key = "")
        return 0.0
    t := Ease3(Clamp((A_TickCount - RSET.focAt)/(RSET_FOCMS + 0.0), 0.0, 1.0))
    if (RSET.focKey = key)
        return t
    if (RSET.focOut = key)
        return 1 - t
    return 0.0
}

RSetFxFit(s, wmax) {
    if (s = "")
        return ""
    while (StrLen(s) > 1 && MeasureW(s, HL.fM) > wmax)
        s := SubStr(s, 2)
    return s
}

; ---------------- CLIENT SETTINGS: systems panel ----------------
RSetSystems(ax, ay, x0, y0, dx, dy2, ff, now, acc) {
    mt := HL.modT
    chosen := RSetChosen()

    Txt("SYSTEMS", ax, y0 + 36, 120, 14, fBadge, FA(0x62C7CBE0, ff), fmtL)
    Txt(mt > 0.5 ? (RSET_SYSN " listed") : "0 listed", ax + 66, y0 + 36, 80, 14, HL.fS
        , FA(Alpha(acc, 60 + 120*mt), ff), fmtL)
    if (mt > 0.4) {
        fh := ff*Clamp((mt - 0.4)/0.4, 0.0, 1.0)
        FFMBtn(921, ax + HL.abw - 96, y0 + 30, 96, 22
            , RSET.on ? "REVERT" : "APPLY", acc, fh, RSET.on ? 2 : (chosen ? 1 : 0))
    }

    pah := 26 + (HL.ffh - 26)*mt

    ; ---- the two faces of this panel ----
    ; The rows and the raw flag page cross-fade in place: same frame, same clip,
    ; same scrollbar geometry, one sliding out left as the other slides in from
    ; the right. That is the transition DrawTab uses between hub tabs, and doing
    ; it here rather than floating a sheet is what keeps the page feeling like
    ; part of the module instead of a dialog on top of it.
    ;
    ; ---- and the page GROWS into its height ----
    ; At rest the page is taller than the panel, and the height used to arrive by
    ; jumping: drawn at the panel's height for the whole 260 ms crossfade and
    ; then snapped to its own on the frame fxT crossed 0.99. Interpolated here
    ; instead, so the shape that arrives is the shape that stays.
    ;
    ; The two alphas below are the whole transition. fPan carries the rows face
    ; out - plate, backdrop, chrome, rows, scrollbar, state card, dropdown - and
    ; fPag carries the page in. Neither half is drawn once its alpha is spent,
    ; which is also what stops the panel painting a full MiniBackdrop under a
    ; page that completely covers it.
    fxT   := RSetFxT()
    pageH := pah + (RSetFxH() - pah)*fxT
    fPan  := ff*(1 - fxT)
    fPag  := ff*fxT

    if (fPan > 0.004) {
        b := VBrush(ax, ay, HL.abw, pah, FA(Mix(0xFF141728, 0xFF181C34, mt), fPan), FA(0xFF12141F, fPan))
        FillRR(ax, ay, HL.abw, pah, 12, b), DelB(b)
        MiniBackdrop(ax, ay, HL.abw, pah, 12, acc, fPan, now, 0.9)
        HubEmptyGhost(ax, ay, pah, fPan)    ; the collapsed state, fading back in
        pn := Pen(FA(Alpha(acc, 70 + 90*mt), fPan), 1.2)
        StrokeRR(ax, ay, HL.abw, pah, 12, pn), DelP(pn)
        gl := 40*mt
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), 200*mt), fPan), 1.6)
        Line(ax + 14, ay + 0.6, ax + 14 + gl, ay + 0.6, pn)
        Line(ax + HL.abw - 14 - gl, ay + pah - 0.6, ax + HL.abw - 14, ay + pah - 0.6, pn), DelP(pn)
    }
    ; the module ring is a halo that overhangs the panel edge, so it belongs to
    ; the module rather than to either face and keeps the undimmed alpha
    ModRing(ax, ay, HL.abw, pah, 12, acc, ff, HL.modAt, now, 700, 18, hubMod != 0)
    if (mt < 0.02)
        return

    ; ---- the rows face ----
    if (fPan > 0.004) {
        pClip := RRPath(ax, ay, HL.abw, pah, 12)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pClip, "int", 0)

        ff := fPan                     ; everything below fades with the page's rise
        rowSl := fxT*26                ; ... and slides out from under it

        RSetDivider(ax, ay, ff, mt, now, acc, rowSl)

        loop RSET_SYSN {
            i := A_Index
            cg := Clamp((mt - 0.30 - Min(i, 4)*0.07)/0.38, 0.0, 1.0)
            if (cg <= 0.01)
                continue
            fb := ff*cg
            ry := ay + RSetRowY(i) - RSET.scr
            if (ry + HL.rsrh < ay + 4 || ry > ay + pah - 4)
                continue
            o    := RSET_OPTS[i]
            idx  := RSetIdx(o)
            set  := (idx > 1)
            ; the row is three zones now - the control, the knob, and the rest - so
            ; the highlight takes whichever the pointer is over
            hv   := Max(HL.h.Get(RSetRowZ(i), 0.0), HL.h.Get(1080 + i, 0.0)
                      , HL.h.Get(RSetKnobZ(i), 0.0))
            sld  := (1 - cg)*10 - rowSl          ; entrance slide, minus the page pushing it left
            axs  := ax + sld                     ; row CONTENT rides both; panel chrome does not
            ; A grp 2 row is real as long as there IS a client settings file.
            ; It used to require the PROPERTY to be present too, from back when
            ; the writer could only overwrite an existing element. It can create
            ; one now (see RSetXmlSet), and REVERT deliberately removes these
            ; elements so Roblox re-supplies its own defaults - so an absent
            ; property is the normal state after a revert, not a dead row.
            avail := !o.HasOwnProp("xml") || o.HasOwnProp("f") || RSET.xmlPath != ""
            ; ---- taken over, and it has to LOOK it ----
            ; A locked row reads exactly like an unavailable one, because that is
            ; what it is: this control no longer decides anything. Its title and
            ; hint recede, its marker and icon go inert, and its own control is
            ; drawn at a fraction of the alpha with no hover to answer - the hit
            ; test hands the whole row to the explanation instead. See
            ; RSetLockedRows.
            lock  := RSetRowLocked(o)
            ; ---- and rows the FLAG SOURCE is ignoring ----
            ; Not locked: a row you cannot set up because a switch two rows down
            ; is pointed elsewhere is a trap, and the pick still matters the
            ; moment the switch comes back. So it stays usable and is drawn as
            ; what it is - configured, and not currently reaching the file.
            ; Only rows that actually carry flags: the client settings FILE rows
            ; below write XML, which this switch has nothing to do with.
            skip  := o.HasOwnProp("f") && !RSetSrcRows()
            avail := avail && !lock
            fbc   := lock ? fb*0.34 : (skip ? fb*0.55 : fb)   ; the control's own alpha
            if (o.ui = "action")
                live := (o.k = "apply")   ? (chosen > 0)
                      : (o.k = "fxedit")  ? (RSET.extra.Count > 0)
                      : (o.k = "logorst") ? (RSET.icoOrig.Count > 0
                                             || RSET.logo != "" || RSET.logoS != ""
                                             || CurBakCount() > 0)
                                          : (RSET.on > 0)
            else if (o.ui = "preset")
                live := (RSetPresetActive() > 0)
            else if (o.ui = "source")
                ; It fell through to the branch below and was therefore never
                ; live: `set` is `RSetIdx(o) > 1`, which reads RSET.pick - and
                ; the source row is the one control in the panel that does not
                ; store its state there. It keeps it in rsetSrcOn, so the accent
                ; bar and the icon stayed grey however the switch was thrown.
                live := (rsetSrcOn > 0)
            else
                live := set && avail

            if (hv > 0.01) {
                b := HBrush(ax + 6, ry, HL.abw - 12, HL.rsrh, FA(Alpha(0xFFFFFF, 15*hv), fb), FA(Alpha(0xFFFFFF, 3*hv), fb))
                FillRR(ax + 6, ry, HL.abw - 12, HL.rsrh, 8, b), DelB(b)
            }
            b := VBrush(axs + 14, ry + 8, 3, 20, FA(Alpha(live ? AccHi(acc, 0.35) : 0xFFC7CBE0, live ? 235 : 60), fb)
                      , FA(Alpha(live ? acc : 0xFFC7CBE0, live ? 150 : 40), fb))
            FillRR(axs + 14, ry + 8, 3, 20, 1.5, b), DelB(b)

            RSetIcon(i, axs + 36, ry + 16, FA(Alpha(live ? acc : 0xFF9AA8C0, live ? 220 : 110), fb), live, now)
            if lock {
                ; a shackle over the row's own icon - the state has to be
                ; readable at a glance, not only by reading the hint
                pn := Pen(FA(Alpha(0xFF9AA8C0, 150), fb), 1.3)
                Arc(axs + 32, ry + 4, 9, 9, 180, 180, pn), DelP(pn)
                b := SBrush(FA(Alpha(0xFF9AA8C0, 160), fb))
                FillRR(axs + 30.5, ry + 8.5, 12, 8, 2, b), DelB(b)
            }

            ; ---- how far the text may run before it meets the control ----
            ; FLAG SOURCE carries the widest control on the panel - a switch AND
            ; a two-segment picker - and it had no case here, so it fell to the
            ; default and its description ran straight under the switch. Derived
            ; from the control's own left edge rather than written as another
            ; literal, so moving the switch moves the text limit with it.
            tw := (o.ui = "slider" ? HL.abw - 208
                 : o.ui = "preset" ? HL.abw - 258
                 : o.ui = "source" ? RSetSrcSwX() - 10 : HL.abw - 132) - 54
            Txt(o.n, axs + 54, ry + 4, tw, 16, fBadge
                , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.18)
                         , avail ? (skip ? 165 : 235) : 120), fb), fmtL)
            if (o.k = "fxedit") {
                nx := RSET.extra.Count
                hint := !RSetSrcExtra() ? ((nx ? nx " custom flag" (nx = 1 ? "" : "s") : "nothing custom")
                                           "  ·  not written - FLAG SOURCE is CLIENT SYSTEMS")
                      : nx ? (nx " custom flag" (nx = 1 ? "" : "s") "  ·  " o.h) : o.h
            }
            else if (o.ui = "action")
                hint := o.h
            else if (o.ui = "source")
                hint := !rsetSrcOn ? (o.h "  ·  MIXING both, an override wins a shared name")
                      : (rsetSrcSel = 1) ? (o.h "  ·  CLIENT SYSTEMS only, overrides ignored")
                                          : (o.h "  ·  EDIT FAST FLAGS only, the rows above ignored")
            else if (o.ui = "preset") {
                ap := RSetPresetActive()
                hint := ap ? (o.h "  ·  now " o.v[ap]) : (o.h "  ·  quality only, not volume or sensitivity")
            }
            else if lock
                hint := "taken over in EDIT FAST FLAGS  ·  remove the override there to get this back"
            else if skip
                hint := o.h "  ·  not written - FLAG SOURCE is EDIT FAST FLAGS"
            else if !avail
                hint := "not present in your client settings file"
            else if (o.HasOwnProp("xml") && RSET.xmlHave.Has(o.xml))
                hint := o.h "  ·  now " RSET.xmlHave[o.xml]
            else if (o.ui = "file" && (o.k = "logo" || o.k = "logos")) {
                kH   := (o.k = "logos") ? 2 : 1
                srcH := RSetLogoOf(kH)
                nlg2 := RSetLogoCount(kH)
                nsc2 := RSetLnkScan(kH).Length
                subH := RSetLogoSubOf(kH)
                dest := (nlg2 ? (subH != "" ? subH : nlg2 " file(s)") : "")
                      . ((nlg2 && nsc2) ? "  ·  " : "")
                      . (nsc2 ? (nsc2 " shortcut(s)") : "")
                hint := (srcH = "") ? o.h
                      : dest != "" ? (CurBaseName(srcH) "  ->  " dest)
                      : (CurBaseName(srcH) "  ·  NOTHING MATCHED - BROWSE AGAIN TO PICK THE TARGET")
            }
            else if (o.k = "fps" && RSetIdx(o) > 1) {
                ; The only row whose effect depends on something outside this
                ; panel, so it says which it will be BEFORE you press anything.
                ; Above 240 is the case that may not go live: the clamp holding
                ; the scheduler there is a plain FFlag read at startup, so
                ; whether it can be lifted in a running client is build-dependent.
                tg9  := RSetFpsTarget()
                hiFp := (tg9 != "" && Integer(tg9) > 240)
                ; Not "may need a restart" any more - it does, and saying otherwise
                ; sent someone chasing a setting that was never going to take.
                hint := hiFp ? (o.h "  ·  above 240 needs a restart to take")
                      : (FFM.pid && MemIO.hProcess)
                            ? (o.h "  ·  applies live to the attached client")
                            : (o.h "  ·  applies next launch")
            }
            else if (o.ui = "file" && o.k = "font" && RSET.font != "")
                hint := CurBaseName(RSET.font)
            else if !o.al
                hint := o.alp ? (o.h "  ·  partly off the allowlist - the rest needs the flag manager")
                              : (o.h "  ·  off the allowlist, use the flag manager")
            else
                hint := o.h
            ; Description sits directly under the title and runs up to whatever
            ; control this row carries - wider than the title, which also has to
            ; clear the small status label sitting above the control.
            hw := (o.ui = "slider")                  ? HL.abw - 264
                : (o.ui = "preset")                  ? RSetPresetChipX() - 64  ; clears the chips
                : (o.ui = "source")                  ? RSetSrcSwX() - 64  ; clears the switch
                : (o.ui = "file" && o.k != "font")   ? HL.abw - 240   ; clears tile + two buttons
                : (o.ui = "action" || o.ui = "file") ? HL.abw - 172
                                                     : HL.abw - 182
            Txt(FFMElide(hint, fHint, hw), axs + 54, ry + 20, hw, 13
                , fHint, FA(avail ? 0x7EC7CBE0 : Alpha(acc, 102), fb), fmtL)

            if (o.ui = "preset") {
                ; Three chips filling the same column the other rows put one
                ; control in, so the row still reads as one row. The active preset
                ; is derived from the picks, so editing any graphics row by hand
                ; unlights it without anything having to notice.
                actP := RSetPresetActive()
                pw3  := RSetPresetChipW(), pg3 := RSetPresetChipG()
                px3  := axs + RSetPresetChipX()
                loop 3 {
                    q  := A_Index
                    zq := 924 + q                        ; 925 / 926 / 927
                    hq := HL.h.Get(zq, 0.0)
                    onq := (actP = q)
                    fl3 := (RSET.presetAt && RSET.preset = q && now - RSET.presetAt < 620)
                         ? 1 - Clamp((now - RSET.presetAt)/620.0, 0.0, 1.0) : 0.0
                    bx3 := px3 + (q - 1)*(pw3 + pg3)
                    by3 := ry + 8 - 1.5*hq
                    b := VBrush(bx3, by3, pw3, 26
                              , FA(Alpha(acc, (onq ? 74 : 26) + 46*hq + 60*fl3), fb)
                              , FA(Alpha(acc, (onq ? 34 : 10) + 22*hq + 30*fl3), fb))
                    FillRR(bx3, by3, pw3, 26, 8, b), DelB(b)
                    MicroBackdrop(bx3, by3, pw3, 26, 8, acc, fb, now, 0.85)
                    pn := Pen(FA(Alpha(acc, (onq ? 200 : 96) + 100*hq), fb), 1.1)
                    StrokeRR(bx3, by3, pw3, 26, 8, pn), DelP(pn)
                    ; a lit rail under the active chip, matching the row markers
                    if onq {
                        b := SBrush(FA(Alpha(AccHi(acc, 0.45), 225), fb))
                        FillRR(bx3 + 12, by3 + 21.5, pw3 - 24, 2.4, 1.2, b), DelB(b)
                    }
                    Txt(o.v[q], bx3, by3 + 5.5, pw3, 15, HL.fXs
                        , FA(Alpha(onq ? AccHi(acc, 0.4) : 0xFFE8EAF6, onq ? 245 : 165 + 60*hq), fb), fmtC)
                    if (fl3 > 0.01) {
                        e3 := 1 - fl3
                        ex3 := e3*12
                        pn := Pen(FA(Alpha(acc, Round(190*fl3)), fb), 2*fl3 + 0.3)
                        StrokeRR(bx3 - ex3, by3 - ex3*0.6, pw3 + ex3*2, 26 + ex3*1.2, 8, pn), DelP(pn)
                    }
                }
            }
            else if (o.ui = "action") {
                ; the whole row is the target, so the button shares its zone and
                ; lights with it - there is no smaller thing to aim at
                if (o.k = "apply" && FFM.rbx)
                    Txt("close rbx", axs + HL.abw - 182, ry + 7, 68, 14, HL.fXs
                        , FA(Alpha(AMBER, 210), fb), fmtR)
                else if (o.k = "apply" && RSET.on)
                    Txt("live", axs + HL.abw - 176, ry + 7, 62, 14, HL.fXs
                        , FA(Alpha(C_ON, 200), fb), fmtR)
                FFMBtn(RSetRowZ(i), axs + HL.abw - 108, ry + 1, 92, 24, o.v[1], acc, fbc
                     , lock ? 4
                     : (o.k = "apply")  ? (chosen ? 1 : 0)
                     : (o.k = "fxedit") ? (RSET.extra.Count ? 1 : 0) : 2)
            }
            else if (o.ui = "source") {
                ; ---- one switch, two names ----
                ; The switch is the whole idea's ON and OFF: off, both halves
                ; merge and both segments read as inactive because neither is
                ; being singled out. On, the chosen one lights and the other
                ; visibly stands down - which is the point of the row.
                swx := axs + RSetSrcSwX(), swy := ry + 12
                hvs := HL.h.Get(933, 0.0)
                ; ---- the change ripple ----
                ; Every other control in this panel answers RSET.flashAt when
                ; its value changes - the chip does, the slider does, the
                ; dropdown does. This row registered nothing and drew nothing,
                ; so throwing the switch was the one state change in the module
                ; that happened silently. A ring off the switch, on the same
                ; 360 ms clock the rest of them use.
                flS := (RSET.flashAt.Has("src") && now - RSET.flashAt["src"] < 360)
                     ? 1 - Clamp((now - RSET.flashAt["src"])/360.0, 0.0, 1.0) : 0.0
                if (flS > 0.01) {
                    rr := 10 + 16*(1 - flS)
                    pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(150*flS)), fb), 1.4*flS + 0.4)
                    Ell(swx + RSetSrcSwW()/2 - rr, swy + 8 - rr, rr*2, rr*2, pn), DelP(pn)
                }
                FFMTogDraw(swx, swy, RSetSrcSwW(), 16, RSET.srcT, acc, hvs, fb)
                ; the two segments, with a lit rail travelling between them
                sgx := axs + RSetSrcSgX(), sgw := RSetSrcSgW()
                b := SBrush(FA(Alpha(0xFFFFFF, 12), fb))
                FillRR(sgx, ry + 9, sgw*2, 22, 7, b), DelB(b)
                ; the marker slides rather than jumping, and fades out with the
                ; switch so an OFF row is not claiming one of the two
                mkx := sgx + (RSET.srcSelT - 1)*sgw
                if (RSET.srcT > 0.01) {
                    b := VBrush(mkx + 2, ry + 11, sgw - 4, 18
                              , FA(Alpha(AccHi(acc, 0.3), Round(78*RSET.srcT)), fb)
                              , FA(Alpha(acc, Round(40*RSET.srcT)), fb))
                    FillRR(mkx + 2, ry + 11, sgw - 4, 18, 6, b), DelB(b)
                    pn := Pen(FA(Alpha(acc, Round(180*RSET.srcT)), fb), 1.1)
                    StrokeRR(mkx + 2, ry + 11, sgw - 4, 18, 6, pn), DelP(pn)
                }
                pn := Pen(FA(Alpha(acc, 60), fb), 1)
                StrokeRR(sgx, ry + 9, sgw*2, 22, 7, pn), DelP(pn)
                loop 2 {
                    q3  := A_Index
                    hq3 := HL.h.Get(933 + q3, 0.0)
                    onq3 := RSET.srcT*Clamp(1 - Abs(RSET.srcSelT - q3), 0.0, 1.0)
                    Txt(q3 = 1 ? "SYSTEMS" : "FLAGS", sgx + (q3 - 1)*sgw, ry + 14, sgw, 14, HL.fXs
                        , FA(Alpha(THMix(0xFFC7CBE0, AccHi(acc, 0.4), onq3)
                                 , Round(140 + 60*hq3 + 55*onq3)), fb), fmtC)
                }
            }
            else if (o.ui = "slider")
                RSetSlider(RSetRowZ(i), i, ry, axs, acc, fbc, now)
            else if (o.ui = "file") {
                ; braces are load-bearing: two statements under an unbraced
                ; `else if` end the chain after the first, which orphans the
                ; `else` below it
                lgK := (o.k = "logo") ? 1 : (o.k = "logos") ? 2 : 0
                if (lgK) {
                    if !hubLowPerf
                        RSetLogoTile(axs + HL.abw - 176, ry + 5, 26, fb, acc, now, lgK)
                    hasI := RSetLogoOf(lgK) != ""
                    FFMBtn(927 + lgK, axs + HL.abw - 144, ry + 1, 64, 24, "BROWSE", acc, fbc, hasI ? 0 : 1)
                    ; its own APPLY - inert until there is something to write
                    FFMBtn(930 + lgK, axs + HL.abw - 76, ry + 1, 60, 24, "APPLY", acc, fb, hasI ? 1 : 4)
                } else
                    FFMBtn(924, axs + HL.abw - 108, ry + 1, 92, 24, "BROWSE", acc, fbc
                         , RSET.font != "" ? 0 : 1)
            }
            else {
                ot := (RSET.dd = i) ? RSET.ddT : 0.0
                ; derived from axs, not RSetChipX(): the helper is the resting
                ; position and carries neither the page slide nor the row slide
                RSetChip(RSetRowZ(i), axs + HL.abw - 118, ry + 2, RSetChipW(), 22, o.v[idx], set && avail
                       , acc, fbc, RSET.flashAt.Has(o.k) ? RSET.flashAt[o.k] : 0, now, ot)
            }
        }

        sysTot := RSetTotal(), sysVis := HL.ffh - 20
        if (sysTot > sysVis) {
            sbS := Max(HL.h.Get(920, 0.0), (HL.drag = 14) ? 1.0 : 0.0)
            sw2 := 3 + 3*sbS
            sxs := ax + HL.abw - 6 - 3*sbS
            b := SBrush(FA(Alpha(0xFFFFFF, 18 + 26*sbS), ff*mt))
            FillRR(sxs, ay + 10, sw2, sysVis, sw2/2, b), DelB(b)
            th2 := Max(22, sysVis*(sysVis/sysTot))
            ty2 := ay + 10 + (sysVis - th2)*(RSET.scr/Max(1, sysTot - sysVis))
            b := VBrush(sxs, ty2, sw2, th2, FA(Alpha(AccHi(acc, 0.35), 190 + 65*sbS), ff*mt)
                      , FA(Alpha(acc, 170 + 60*sbS), ff*mt))
            FillRR(sxs, ty2, sw2, th2, sw2/2, b), DelB(b)
        }

        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", pClip)

        RSetCard(ax, ff, now, acc, mt, chosen)
        ; the popup is drawn last and outside the panel clip so it can overhang
        RSetDropdown(ff, now, acc)
    }

    ; ---- the page face ----
    ; LAST, and outside the panel's clip: at rest it is taller than the panel
    ; and must not be cut to it. It is also what should sit on top - the rows
    ; are sliding out from under it, not over it.
    if (fPag > 0.004)
        RSetFxPage(ax, ay, pageH, fPag, now, acc)
}

; ---------------- CLIENT SETTINGS: dropdown popup ----------------
; Grows out of its chip: the body scales from the anchored edge while the rows
; stagger in behind it, and the whole thing plays in reverse on close.
RSetDropdown(ff, now, acc) {
    t := RSET.ddT
    if (t <= 0.004)
        return
    i := RSET.dd ? RSET.dd : RSET.ddPrev
    if (i < 1 || i > RSET_OPTS.Length)
        return
    o  := RSET_OPTS[i]
    n  := Min(o.v.Length, 7)
    pad := RSetDDPad(o)
    dx := RSetChipX() - 4 - pad, dw := RSetChipW() + 8 + pad
    RSetDDGeom(i, &dy, &up)
    dh := RSetDDH(o)
    note := RSetDDNote(o)
    e  := Ease3(t)

    ShadowDraw(dx, dy, dw, dh, 9, 8, 16, 16, ff*e)
    ; grows out of the edge it is anchored to: same translate/scale/translate
    ; shape as PushXform, but the scale is vertical only
    axD := dx + dw/2, ayD := dy + (up ? dh : 0)
    stD := PushG()
    DllCall("gdiplus\GdipTranslateWorldTransform", "ptr", G, "float", axD, "float", ayD, "int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G, "float", 1, "float", 0.55 + 0.45*e, "int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "ptr", G, "float", -axD, "float", -ayD, "int", 0)

    b := VBrush(dx, dy, dw, dh, FA(Alpha(AccHi(0xFF1B2038, 0.03), Round(252*e)), ff)
              , FA(Alpha(0xFF141728, Round(252*e)), ff))
    FillRR(dx, dy, dw, dh, 9, b), DelB(b)
    MiniBackdrop(dx, dy, dw, dh, 9, acc, ff*e, now, 0.8)
    pn := Pen(FA(Alpha(acc, Round(150*e)), ff), 1.2)
    StrokeRR(dx, dy, dw, dh, 9, pn), DelP(pn)

    curIdx := RSetIdx(o)
    loop n {
        j  := A_Index
        it := RSET.ddTop + j
        if (it < 1 || it > o.v.Length)
            continue
        rt := Clamp((t - 0.08*(j - 1))/0.55, 0.0, 1.0)
        if (rt <= 0.01)
            continue
        iy := dy + 4 + (j - 1)*23
        hv := HL.h.Get(939 + j, 0.0)
        on := (it = curIdx)
        if (hv > 0.01) {
            b := HBrush(dx + 3, iy, dw - 6, 22, FA(Alpha(0xFFFFFF, Round(20*hv*rt)), ff)
                      , FA(Alpha(0xFFFFFF, Round(5*hv*rt)), ff))
            FillRR(dx + 3, iy, dw - 6, 22, 6, b), DelB(b)
        }
        if on {
            b := SBrush(FA(Alpha(acc, Round(200*rt)), ff))
            FillRR(dx + 5, iy + 5, 2.5, 12, 1.2, b), DelB(b)
        }
        Txt(o.v[it], dx + 14 + 2*hv, iy - 1 + (1 - rt)*4, dw - (note != "" ? 46 : 34), 22, HL.fXs
            , FA(Alpha(on ? AccHi(acc, 0.45) : 0xFFE8EAF6, Round((on ? 240 : 175 + 60*hv)*rt)), ff), fmtL)
        ; the mark: a small amber exclamation, left of where the tick sits so
        ; the two never collide on the selected entry
        if RSetDDWarn(o, it) {
            wx := dx + dw - 26
            b := SBrush(FA(Alpha(AMBER, Round(225*rt)), ff))
            FillRR(wx - 1, iy + 5.5, 2, 6.5, 1, b)
            FillEll(wx - 1, iy + 14, 2, 2, b), DelB(b)
        }
        if on {
            pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(235*rt)), ff), 1.5)
            tkx := dx + dw - 15
            Line(tkx - 3.5, iy + 11, tkx - 1, iy + 14, pn)
            Line(tkx - 1, iy + 14, tkx + 3.5, iy + 7.5, pn), DelP(pn)
        }
    }
    if (note != "") {
        ny := dy + 4 + n*23
        FadeLine(dx + 10, dx + dw - 10, ny + 1, 0x18FFFFFF, ff*e)
        ; the same mark again, so the line and the entries are unmistakably
        ; about each other
        b := SBrush(FA(Alpha(AMBER, Round(215*e)), ff))
        FillRR(dx + 12, ny + 7, 2, 6.5, 1, b)
        FillEll(dx + 12, ny + 15.5, 2, 2, b), DelB(b)
        Txt(note, dx + 20, ny + 5, dw - 30, 16, HL.fXs
            , FA(Alpha(AMBER, Round(200*e)), ff), fmtL)
    }
    ; more entries than fit: a hairline marks that the list is clipped
    if (o.v.Length > n) {
        b := SBrush(FA(Alpha(0xFFFFFF, Round(50*e)), ff))
        FillRR(dx + dw/2 - 9, dy + dh - 4, 18, 1.6, 0.8, b), DelB(b)
    }
    Pop(stD)
}

; One break per group change, labelled for the group it introduces. Loops the
; option list rather than assuming a single hardcoded row, so the breaks follow
; the table if rows are added or reordered.
; `rowSl` is the same push the rows get while the page slides in over them. The
; dividers sat still through the whole transition because they never received
; it - three labelled hairlines holding their ground while every row around them
; slid out from under the page.
RSetDivider(ax, ay, ff, mt, now, acc, rowSl := 0) {
    cg := Clamp((mt - 0.58)/0.34, 0.0, 1.0)
    if (cg <= 0.01)
        return
    fd := ff*cg
    loop RSET_SYSN - 1 {
        i := A_Index + 1
        if (RSET_OPTS[i].grp = RSET_OPTS[i - 1].grp)
            continue
        dy := ay + RSetRowY(i) - RSET_SEPH/2 - 3 - RSET.scr
        if (dy < ay - 10 || dy > ay + HL.ffh + 10)
            continue
        sld := (1 - cg)*14 - rowSl
        lx  := ax + 14 + sld
        lbl := RSetGrpName(RSET_OPTS[i].grp)
        lw  := MeasureW(lbl, HL.fXs)
        pn := Pen(FA(Alpha(acc, 150 + 70*cg), fd), 1.4)
        Line(lx, dy - 3, lx + 3.5, dy + 0.5, pn)
        Line(lx + 3.5, dy + 0.5, lx, dy + 4, pn), DelP(pn)
        Txt(lbl, lx + 10, dy - 7, lw + 8, 14, HL.fXs
            , FA(Alpha(Mix(0xFFC7CBE0, acc, 0.42), 150 + 70*cg), fd), fmtL)
        GroupLine(lx + 24 + lw, ax + HL.abw - 16 + sld, dy, acc, fd, now)
    }
}

; ---------------- CLIENT SETTINGS: status card ----------------
RSetCard(ax, ff, now, acc, mt, chosen) {
    cp := Clamp((mt - 0.60)/0.34, 0.0, 1.0)
    if (cp <= 0.01)
        return
    fp := ff*cp
    px := ax, pw := HL.abw
    py := HL.ffby + (1 - cp)*10

    b := VBrush(px, py, pw, RSETCH, FA(Mix(0xFF141728, 0xFF181C34, cp), fp), FA(0xFF11131F, fp))
    FillRR(px, py, pw, RSETCH, 12, b), DelB(b)
    MiniBackdrop(px, py, pw, RSETCH, 12, acc, fp, now, 0.9)
    pn := Pen(FA(Alpha(acc, 60 + 70*cp), fp), 1.2)
    StrokeRR(px, py, pw, RSETCH, 12, pn), DelP(pn)
    b := SBrush(FA(Alpha(acc, 200*cp), fp))
    FillRR(px, py + 10, 3, 20, 1.5, b), DelB(b)
    Txt("STATE", px + 16, py + 9, 120, 16, fBadge, FA(Alpha(0xFFE8EAF6, 225), fp), fmtL)

    on := RSET.on
    pc := on ? C_ON : 0xFF9AA8C0
    b := SBrush(FA(Alpha(pc, on ? 40 : 22), fp))
    FillRR(px + pw - 116, py + 9, 100, 17, 5, b), DelB(b)
    b := SBrush(FA(Alpha(pc, on ? 180 + 60*Abs(Sin(DecT(now)*0.0026)) : 90), fp))
    FillEll(px + pw - 108, py + 15, 5, 5, b), DelB(b)
    Txt(on ? "APPLIED" : "NOT APPLIED", px + pw - 100, py + 9, 84, 17, HL.fXs
        , FA(Alpha(AccHi(pc, 0.25), on ? 235 : 150), fp), fmtL)

    ; ---- master dial: a ring that fills as the module goes live ----
    dcx := px + 14 + 39, dcy := py + 34 + 39
    dscl := 1.0                        ; not `pop` - that name shadows Pop()
    if (RSET.applyAt && now - RSET.applyAt < 520)
        dscl := 0.88 + 0.12*EBackOut(Clamp((now - RSET.applyAt)/520.0, 0.0, 1.0), 2.0)
    stD := PushXform(dcx, dcy, dscl, 0)
    b := SBrush(FA(0xFF0B0D16, fp))
    FillEll(dcx - 34, dcy - 34, 68, 68, b), DelB(b)
    pn := Pen(FA(Alpha(0xFFFFFF, 26), fp), 3)
    Ell(dcx - 28, dcy - 28, 56, 56, pn), DelP(pn)
    if (RSET.onT > 0.004) {
        pn := Pen(FA(Alpha(AccHi(acc, 0.25), 235), fp), 3)
        Arc(dcx - 28, dcy - 28, 56, 56, -90, 359.9*RSET.onT, pn), DelP(pn)
    }
    ; the chosen-row count sits in the middle, with a soft pulse when live
    Txt(String(chosen), dcx - 30, dcy - 16, 60, 26, HL.fV
        , FA(Alpha(on ? AccHi(acc, 0.3) : 0xFFE8EAF6, on ? 245 : 175), fp), fmtC)
    Txt(chosen = 1 ? "row set" : "rows set", dcx - 40, dcy + 10, 80, 14, HL.fXs
        , FA(0x72C7CBE0, fp), fmtC)
    if (RSET.applyAt && now - RSET.applyAt < 620) {
        e := Ease3((now - RSET.applyAt)/620.0)
        pn := Pen(FA(Alpha(acc, Round(180*(1 - e))), fp), 2.2*(1 - e) + 0.3)
        r_ := 34 + e*16
        Ell(dcx - r_, dcy - r_, r_*2, r_*2, pn), DelP(pn)
    }
    Pop(stD)

    cx2 := px + 14 + 78 + 16
    cw2 := px + pw - 16 - cx2
    nf := RSetFlags().Count
    CurRow(cx2, py + 36, cw2, "FLAGS", nf ? (nf " flag(s)  ·  not shared with the manager")
                                          : "none - every row on auto"
         , nf ? 0xFFC7CBE0 : 0xFF9AA8C0, fp)
    xp := RSetXml()
    lk := (xp != "" && InStr(FileExist(xp), "R")) ? "  ·  locked" : ""
    CurRow(cx2, py + 58, cw2, "FILE", xp != "" ? (CurBaseName(xp) lk) : "no client settings file found"
         , xp != "" ? 0xFFC7CBE0 : acc, fp)
    hasBak := FileExist(RSetXmlBak()) ? 1 : 0
    CurRow(cx2, py + 80, cw2, "BACKUP", hasBak ? "original file held" : "none held yet"
