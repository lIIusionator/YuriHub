; ================= script hub =================
ScrDir() => YURI_SCR
SavedDir() => ScrDir() "\saved"
ProfSave() {
    try {
        IniWrite(profName, iniPath, "profile", "name")
        IniWrite(profBio, iniPath, "profile", "bio")
        IniWrite(profRing, iniPath, "profile", "ring")
        IniWrite(profFontI, iniPath, "profile", "font")
        ProfPicSave()
    }
}
; Written separately as well as from ProfSave, because the picture is chosen
; from the gallery/cropper, which never touches the EDIT PROFILE modal and so
; never reaches ProfSave's other callers.
ProfPicSave() {
    try IniWrite(profPicSet ? SelKey(selFadeAt ? selNext : selCur) : ""
               , iniPath, "profile", "pic")
}
ProfFontApply() {
    global famP, fP, fPs
    if fP {
        DllCall("gdiplus\GdipDeleteFont", "ptr", fP)
        DllCall("gdiplus\GdipDeleteFont", "ptr", fPs)
        DllCall("gdiplus\GdipDeleteFontFamily", "ptr", famP)
    }
    MeasureW("", 0)
    famP := 0
    if DllCall("gdiplus\GdipCreateFontFamilyFromName", "wstr", PFONTS[profFontI], "ptr", 0, "ptr*", &famP)
        DllCall("gdiplus\GdipCreateFontFamilyFromName", "wstr", "Segoe UI", "ptr", 0, "ptr*", &famP)
    DllCall("gdiplus\GdipCreateFont", "ptr", famP, "float", 10.5, "int", 1, "int", 2, "ptr*", &fP := 0)
    DllCall("gdiplus\GdipCreateFont", "ptr", famP, "float", 8.5, "int", 0, "int", 2, "ptr*", &fPs := 0)
}
; ---- portrait ring styles (EDIT PROFILE > RING) ----
; Called at r = 19 (bio popup), 22 (sidebar), 26.5 (overlay) and 36 (profile
; modal), so every decoration is offset by k rather than a fixed pixel count -
; the old fixed +3 made the orbit graze the portrait at 36 and float at 19.
; `col` arrives already armed-aware from the caller; this only shapes it.
RingDraw(cxr, cyr, r, col, f, hv := 0.0) {
    global profRing
    now2 := A_TickCount
    k   := r/22.0                                ; decoration scale
    ph  := (Sin(now2*0.0022) + 1)/2              ; shared breathe
    lit := AccHi(col, 0.5)

    ; Soft seat under every style: mostly hover, a trace of it at rest, so the
    ; portrait sits on the ring instead of just being outlined by it. Stroked
    ; rather than filled - RingDraw runs after DrawAvatar at every call site, so
    ; a filled disc here would wash a tint straight over the portrait.
    loop 2 {
        hk := A_Index
        rh := r + hk*2.4*k
        pn := Pen(FA(Alpha(col, Round((9 - hk*3)*(1 + 2.6*hv) + 3*ph*hv)), f), 2.6*k)
        Ell(cxr - rh, cyr - rh, rh*2, rh*2, pn), DelP(pn)
    }

    if profRing = 2 {
        ; DASH - two dashed rings turning against each other
        pn := Pen(FA(Alpha(col, 170 + 60*hv), f), 1.8)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(now2*0.02, 1000))
        Ell(cxr - r, cyr - r, r*2, r*2, pn), DelP(pn)
        ro := r + 3.6*k                          ; outside the portrait, not over it
        pn := Pen(FA(Alpha(AccHi(col, 0.4), Round(60 + 80*hv)), f), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", 1000 - Mod(now2*0.031, 1000))
        Ell(cxr - ro, cyr - ro, ro*2, ro*2, pn), DelP(pn)

    } else if profRing = 3 {
        ; DUAL - two opposed comet arcs over a faint base, plus a slower
        ; counter-turning pair further out for depth
        pn := Pen(FA(Alpha(col, Round(80 + 50*hv)), f), 1.4)
        Ell(cxr - r, cyr - r, r*2, r*2, pn), DelP(pn)
        ro := r + 3*k
        a0 := Mod(now2*0.04, 360)
        loop 2 {
            ab := a0 + (A_Index - 1)*180
            loop 3 {
                sg := A_Index                     ; nested sweeps taper the tail
                pn := Pen(FA(Alpha(lit, Round(Min(235, (48 + 46*sg)*(1 + 0.4*hv)))), f), 0.8 + 0.4*sg)
                Arc(cxr - ro, cyr - ro, ro*2, ro*2, ab, 130 - sg*38, pn), DelP(pn)
            }
        }
        rq := r + 7.5*k
        a1 := 360 - Mod(now2*0.022, 360)
        loop 2 {
            pn := Pen(FA(Alpha(col, Round((38 + 42*hv)*(0.6 + 0.4*ph))), f), 1)
            Arc(cxr - rq, cyr - rq, rq*2, rq*2, a1 + (A_Index - 1)*180, 54, pn), DelP(pn)
        }

    } else if profRing = 4 {
        ; ORBIT - three paths, alternating direction and speed. The innermost
        ; carries the comet; the outer two are progressively smaller and fainter
        ; so the set reads as depth rather than three equal rings.
        pn := Pen(FA(Alpha(col, 160 + 60*hv), f), 1.8)
        Ell(cxr - r, cyr - r, r*2, r*2, pn), DelP(pn)
        loop 3 {
            ok := A_Index
            rp := r + (3.5*ok)*k
            pn := Pen(FA(Alpha(col, Round((30 - ok*6) + (30 - ok*7)*hv)), f), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            Ell(cxr - rp, cyr - rp, rp*2, rp*2, pn), DelP(pn)
            ; odd paths run clockwise, even anticlockwise
            spd := (ok = 1) ? 0.0024 : (ok = 2) ? -0.0016 : 0.0011
            oa3 := now2*spd + ok*2.1
            if (ok = 1) {
                loop 5 {
                    tk := A_Index - 1
                    aa := oa3 - tk*0.10
                    ta := (1 - tk/5.0)**2
                    if (tk = 0) {
                        b := SBrush(FA(Alpha(col, Round(60 + 50*hv)), f))
                        FillEll(cxr + rp*Cos(aa) - 5*k, cyr + rp*Sin(aa) - 5*k, 10*k, 10*k, b), DelB(b)
                        b := SBrush(FA(Alpha(lit, 230), f))
                        FillEll(cxr + rp*Cos(aa) - 2.2*k, cyr + rp*Sin(aa) - 2.2*k, 4.4*k, 4.4*k, b), DelB(b)
                    } else {
                        rr2 := (1.6*ta + 0.35)*k
