        HubTabSet(z - 30)
    else if z = 42 || z = 46 {
        HL.drag := z = 42 ? 3 : 4, HL.dragZone := z
        DllCall("SetCapture", "ptr", HL.gui.Hwnd)
        HubSlideSet(x, z = 42 ? 1 : 2)
    } else if z = 5
        AbToggleFromHub()
    else if z = 7
        GalleryPick()
    else if z = 10
        RebindClick(1)
    else if z = 1201
        RebindClick(2)
    else if z = 1202
        RebindClick(3)
