    SPF.sysScr += (SPF.sysScrT - SPF.sysScr)*EK(0.3)
    if Abs(SPF.sysScr - SPF.sysScrT) < 0.4
        SPF.sysScr := SPF.sysScrT
    SPF.t4 += ((spfOdds ? 1.0 : 0.0) - SPF.t4)*EK(0.22)
    SPF.t1 += ((spfDiscord ? 1.0 : 0.0) - SPF.t1)*EK(0.22)
    SPF.t2 += ((spfRegion  ? 1.0 : 0.0) - SPF.t2)*EK(0.22)
    SPF.t3 += ((spfMatch   ? 1.0 : 0.0) - SPF.t3)*EK(0.22)
    SPF.t5 += ((spfMulti   ? 1.0 : 0.0) - SPF.t5)*EK(0.22)
    SPF.t6 += ((spfFps     ? 1.0 : 0.0) - SPF.t6)*EK(0.22)
    SPF.u1 += ((spfDcAcct  ? 1.0 : 0.0) - SPF.u1)*EK(0.22)
    SPF.u2 += ((spfDcJoin  ? 1.0 : 0.0) - SPF.u2)*EK(0.22)
    SPF.u3 += ((spfDcFocus ? 1.0 : 0.0) - SPF.u3)*EK(0.22)
    SPF.q1 += ((spfFpsGpu   ? 1.0 : 0.0) - SPF.q1)*EK(0.22)
    SPF.q2 += ((spfFpsQuiet ? 1.0 : 0.0) - SPF.q2)*EK(0.22)
    SPF.q3 += ((spfFpsSys   ? 1.0 : 0.0) - SPF.q3)*EK(0.22)
    CSR.farT  += ((curFar  ? 1.0 : 0.0) - CSR.farT)*EK(0.22)
    CSR.autoT += ((curAuto ? 1.0 : 0.0) - CSR.autoT)*EK(0.22)
    FFM.sglT += ((ffUseSingleton ? 1.0 : 0.0) - FFM.sglT)*EK(0.22)
    FFM.repT += ((ffReApply      ? 1.0 : 0.0) - FFM.repT)*EK(0.22)
    FFM.aijT += ((ffAutoInject   ? 1.0 : 0.0) - FFM.aijT)*EK(0.22)
    ; expire flash highlights whose row is scrolled out of view - the draw loop
    ; only clears visible ones, so without this the map stays populated and the
    ; redraw predicate keeps the hub rendering forever
    if (FFM.flash.Count && now - FFM.flashSweep > 700) {
        FFM.flashSweep := now
        for fi, ft in FFM.flash.Clone() {
            if (now - ft >= 620)
                FFM.flash.Delete(fi)
        }
    }
    PuzClashExpire()               ; retires a dismissed warning once its exit lands
    ; expire click-pop entries whose button is no longer being drawn
    if FFM.clickAt.Count {
        for cz, ct in FFM.clickAt.Clone() {
