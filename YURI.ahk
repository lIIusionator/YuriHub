; ---- architecture guard -----------------------------------------------------
; The flag engine reads 64-bit pointers out of Roblox with ReadProcessMemory,
; and Roblox is a 64-bit process. A 32-bit build cannot address that memory, so
; every injection would fail with no visible cause and the singleton would look
; permanently "not found". Fail loudly at startup instead. Children never reach
; this - they ExitApp above - so it only ever fires once, on the real instance.
if (A_PtrSize != 8) {
    MsgBox("YURI must run as 64-bit.`n`n"
         . "Compile with Ahk2Exe against the AutoHotkey v2 64-bit base file, "
         . "or run the script with the 64-bit interpreter."
         , "YURI - wrong architecture", "Iconx")
    ExitApp
}

