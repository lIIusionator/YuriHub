                          : "FOCUS STATE OFF", spfDcFocus ? C_ON : 0xFFC7CBE0)
        SPFSave("dcfocus", spfDcFocus ? 1 : 0)
    }
    SPF.flashAt[10 + i] := A_TickCount
    SPF.dcSent := 0                              ; force the card to be re-sent
    SPF.dcPushAt := 0                            ; and do not make it wait
}
SPFDragScroll(sy) {
    ; Same contract as FFMDragScroll / CurDragScroll / RSetDragScroll: the mouse
    ; handlers hand these a SCREEN y. This one used its argument as if it were
    ; already panel-space, so the thumb tracked the pointer with the window's
    ; screen offset baked in and the magnification unapplied.
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    vis := SPFSysVis(), tot := SPFSysTotal()
    if (tot <= vis)
        return
    thmb := Max(22, vis*(vis/tot))
    SPF.sysScrT := FFMScrollFromY(uy, HL.aby + 10, vis, tot, vis, thmb, SPF.sysScr)
    SPF.sysScr  := SPF.sysScrT                  ; dragging follows the pointer
    HubPoke()
}
SPFClick(z, x := 0) {
