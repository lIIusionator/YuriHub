; ================= autoblock feature switch =================
AbEnable() {
    global abOn, abFlashAt, closing, introStart, enabled, stateT, animStart
    global minT, minFrom, minTo, minStart
    if abOn
        return
    if ((ck := PuzClashOn(1)) != "") {
        PuzClashRaise("EXTERNAL BLOCK REBIND", "PUZZLE AI", ck)
        return
    }
    abOn := 1, abFlashAt := A_TickCount
    closing := 0
    enabled := false, stateT := 0.0, animStart := 0
    minT := 0.0, minFrom := 0.0, minTo := 0.0, minStart := 0
    introStart := A_TickCount
    try ui.Show("NA")
    RendTim(TICK_A)
    HubPoke()
}
AbDisable() {
    global abOn, abFlashAt
    if !abOn
        return
    abOn := 0, abFlashAt := A_TickCount
    StartClose()                                     ; overlay plays its close anim, then hides
    HubPoke()
}
AbToggleFromHub() {
    abOn ? AbDisable() : AbEnable()
}
AbFinishHide() {
    global abOn, closing, enabled, stateT, animStart, minT, minFrom, minTo, minStart
    RendTim(0)
    abOn := 0, closing := 0
    if enabled {
        enabled := false
        if GetKeyState("q")
            SendInput "{Blind}{q up}"
    }
    stateT := 0.0, animStart := 0
    minT := 0.0, minFrom := 0.0, minTo := 0.0, minStart := 0
    try ui.Hide()
    HubPoke()
}
global PZ := {}
PZ.msg := "idle", PZ.msgOk := 0, PZ.msgAt := 0, PZ.lines := 0, PZ.runAt := 0
; ---- where the time actually went, per board ----
; Added because a report of "it freezes" cannot be told apart from "it is slow"
; without it, and the two want opposite fixes. Every stage of a board is timed
; and the breakdown rides the status line, so the next slow board answers the
; question itself instead of being reasoned about from the outside.
PZ.tScan := 0, PZ.tPair := 0, PZ.tSolve := 0, PZ.tOpt := 0, PZ.tDraw := 0
; The stage in progress RIGHT NOW, as against the five above which are only
; readable once it is over. Every long stage yields to the hub now, so this is
; live on the status line while a board runs: a stall shows the stage it is
; stuck in rather than showing nothing, which from the outside is the whole
; difference between a slow board and a hang.
PZ.stage := ""

PuzEnable() {
    ; PZ_ancGen is ASSIGNED below, so it has to be declared: an assignment to an
    ; undeclared name creates a local no matter that a super-global of that name
    ; exists, and the watch would then be armed against a generation nobody else
    ; can see and never fire.
    global puzOn, puzFlashAt, PZ_ancGen, PZ_sess, PZ_sessAt, PZ_boardDy, PZ_dyPin, PZ_retryMul
    if puzOn
        return
    if ((ck := PuzClashOn(2)) != "") {
        ; refused, not warned - see PuzClashOn
        PuzClashRaise("PUZZLE AI", "EXTERNAL BLOCK REBIND", ck)
        return
    }
    puzOn := 1, puzFlashAt := A_TickCount
    ; a fresh arm is a fresh generator: board 1 again, banner expected again
    PZ_retryMul := 1.0
    PZ_sess := 0, PZ_sessAt := A_TickCount
    PZ_boardDy := 0, PZ_dyPin := 0  ; nothing measured yet this session
    PuzSpeedApply()                    ; the slider owns the frame budget
    ; Arming is not an OUTCOME. Setting a message here made the status line
    ; render it through the failure branch ("FAILED - ready"); clearing the
    ; timestamp lets the line fall through to the armed state instead.
    PZ.msgAt := 0
    PuzHotkeys(1)
    PuzOvOpen()
    ; The markers were never brought back on arm - PuzDisable tore them down and
    ; nothing restored them - so whether the grid was on screen depended on
    ; whether you had happened to press the markers key since the last disarm.
    ; That is the "not the same every time you activate it". The preference is
    ; persisted now and applied here.
    PuzMarkersApply()
    ; ---- NO WATCHES ----
    ; Two timers used to be armed here: the anchor search and the client
    ; follow. Both could move the grid, so both are gone. Arming this module
    ; observes the board; it does not adjust anything about where the board is
    ; believed to be.
    PZ_ancGen++
    HubPoke()
}
PuzDisable() {
    global puzOn, puzFlashAt, PZ_ancGen, PZ_sess, PZ_sessAt, PZ_boardDy, PZ_dyPin, PZ_retryMul
    if !puzOn
        return
    ; a session in flight reads puzOn every board, so clearing it below is what
    ; stops the loop - it will not start another one
    if (rebindOn && (rebindTgt = 2 || rebindTgt = 3))
        RebindCancel()          ; its rows just went inert
    puzOn := 0, puzFlashAt := A_TickCount
    ; cleared on the way OUT as well as the way in, so the panel does not sit
    ; showing a finished session's count while the module is off
    PZ_retryMul := 1.0
    PZ_sess := 0, PZ_sessAt := 0
    PZ_boardDy := 0, PZ_dyPin := 0
    PZ.msgAt := 0
    PuzHotkeys(0)
    ; the card plays its implosion and tears itself down when it lands, exactly
    ; as AbDisable hands off to StartClose - a hard PuzOvClose() here would make
    ; the one overlay in the suite that vanishes without an exit animation
    PuzOvStartClose()
    PuzCalCancel()                     ; a setup in flight does not survive disarming
    PZ_ancGen++                        ; retire the anchor watch immediately
    PuzMarkersApply()                  ; !puzOn hides them, and remembers
    HubPoke()
}
; ---- the module's two hotkeys ----
; Each is created under its OWN HotIf context. That matters: Hotkey() with no
; context replaces the existing registration for that key, so putting PUZZLE AI
; on XButton2 without one would have quietly destroyed AUTOBLOCK's hotkey (and
; vice versa on the next rebind). With contexts they are separate variants of
; the same key - the one whose condition holds fires, and when PUZZLE AI is
; disarmed the press falls through to AUTOBLOCK exactly as before.
;
; PZ_hkS / PZ_hkM remember which key each variant was created under, because
; turning one off after a rebind has to name the OLD key, not the new one.
; keybinds survive a restart
; slider -> frame budget. Applied immediately so the next solve uses it.
PuzSpeedApply() {
    global PZ_FrameMs, PZ_paceMul, PZ_paceOk
    PZ_FrameMs := PZ_FrameSlow + (PZ_FrameFast - PZ_FrameSlow)*Clamp(PZ_SpeedT, 0.0, 1.0)
    ; A new slider position is a new assumption, so what was learned about the
    ; old one no longer applies. Not reset per BOARD - within a hold the thing
    ; it measures is the machine and the game, and neither changes between
    ; boards - but PuzSolve does reset it per PRESS; see the note there.
    PZ_paceMul := 1.0, PZ_paceOk := 0
}
PuzSlideSet(sx) {
    global PZ_SpeedT
    k := HL.pw/HL.bw
    ux := (sx - HL.px)/k
    PZ_SpeedT := Clamp((ux - (HL.abx + PZ_SLX))/PZ_SLW, 0.0, 1.0)
    PuzSpeedApply()
    HubPoke()
}
; The reading on the card. Taken straight from the slider position, so the ends
; are exactly 0% and 100% rather than a ratio that never reaches either.
PuzSpeedPct() => Round(100*Clamp(PZ_SpeedT, 0.0, 1.0))
; The frame rate that percentage is assuming, for the caveat line underneath.
PuzSpeedFps() => Round(1000/PZ_FrameMs)
PuzSaveKeys() {
    try IniWrite(bindKey, iniPath, "keys", "block")
    try IniWrite(puzKey,  iniPath, "keys", "solve")
    try IniWrite(mkKey,   iniPath, "keys", "markers")
}
; ---- keybind conflict ----
; EXTERNAL BLOCK REBIND and PUZZLE AI can legitimately sit on the same key while
; only one of them is armed - they are registered under different HotIf contexts,
; so the press falls through to whichever one is live. Arm BOTH on that key and
; that stops being true: PUZZLE AI's context wins every time and the block toggle
; never sees the key again. Nothing about that is visible from either card, which
; is why it gets said out loud.
; Returns "" when there is no clash, otherwise the key label they are fighting over.
; Would arming `which` take a key something already armed is listening on?
; which: 1 = EXTERNAL BLOCK REBIND, 2 = PUZZLE AI. Returns the key label, or "".
;
; The two can share a key while only ONE is armed - they sit in different HotIf
; contexts, so the press falls through to whichever is live. Arm both and that
; stops being true: PUZZLE AI's context wins and the block toggle never sees the
; key again. Rather than let that happen and describe it afterwards, the arm that
; would cause it is refused.
PuzClashOn(which) {
    if (which = 2) {
        if (abOn && bindKey != "" && (bindKey = puzKey || bindKey = mkKey))
            return bindLabel
    } else {
        if (puzOn && bindKey != "" && (bindKey = puzKey || bindKey = mkKey))
            return bindLabel
    }
    return ""
}
; ---- the warning card's geometry, in ONE place ----
; Panel-local: x/y relative to HL.abx / HL.aby, which is what the hit test works
; in. The renderer shifts by its own origin. The two used to carry their own
; copies and had already drifted - the hit rectangle was 78 tall against a card
; drawn at 82, so the bottom four pixels of a modal card were not modal.
; Sized to the DIMMED COLUMN rather than centred in the two panels. The dim
; already covers the header, both cards, every keybind row, the footer strip and
; the bars - that is what the modal owns - and a card floating in the middle of
; it left most of the inert area looking like ordinary panel. Derived from the
; same layout fields the dim is, so the two cannot disagree.
HubClashGeom(&wx, &wy, &ww, &wh) {
    dTop := HL.cty + 28 - HL.aby              ; the dim's top,  panel-local
    ; CLAMPED to the card's body. The bottom was derived from the keybind rows
    ; alone, so growing the PUZZLE AI panel pushed it 8 px past the body - the
    ; dim itself would have been clipped and looked fine, but this same
    ; rectangle is the clash card's HIT TEST, and a hit zone outside the panel
    ; is a click that lands on nothing.
    dBot := Min(HL.kby2 + 128, HL.pd + HL.ch - 16) - HL.aby
    wx := 12, ww := HL.abw - 24
    wy := dTop + 48
    wh := (dBot - 36) - wy
}
; GOT IT, off the card rather than off a pair of magic numbers repeated in two
; files' worth of code. The card grew from 88 to 164 and the button moved to its
; own row at the foot; a hand-kept copy in the hit test would have been left
; pointing at the middle of the body text.
HubClashBtn(wx, wy, ww, wh, &bx, &by, &bw, &bh) {
    bw := 110, bh := 30
    bx := wx + ww - 20 - bw
    by := wy + wh - 16 - bh
}
PuzClashUp() => PZ_clashKey != ""
PuzClashRaise(who, own, keyLbl) {
    global PZ_clashKey, PZ_clashWho, PZ_clashOwn, PZ_clashAt, PZ_clashOut
    PZ_clashKey := keyLbl, PZ_clashWho := who, PZ_clashOwn := own
    PZ_clashAt := A_TickCount
    PZ_clashOut := 0                 ; a new clash cancels a dismissal in flight
    ; The card offers ESC, so ESC has to work. Safe to take the key outright:
    ; grid setup is the only other owner of it, the hub is hidden while that
    ; runs so no rebind can start, and the panel is modal while this is up so
    ; setup cannot start either. The two can never be live together.
    try Hotkey("*Escape", PuzClashEsc, "On")
    HubPoke()
}
; Dismissal lives here rather than in HubClick, which is a function like any
; other: assigning the state there without a `global` made a LOCAL, so GOT IT
; set a variable that died with the call and the card returned on the next frame.
; Starts the exit rather than clearing on the spot - the card has to be still
; drawable while it plays, so the state survives until PuzClashExpire retires it.
PuzClashDismiss() {
    global PZ_clashOut
    if (PZ_clashKey = "" || PZ_clashOut)
        return
    PZ_clashOut := A_TickCount
    HubPoke()
}
; Retired on a clock, not by the renderer. The card is only drawn while the
; FORSAKEN panel is open past 0.9 - dismiss it and switch tabs and nothing would
; ever have reached the line that clears it, leaving a warning that reappears
; mid-exit the next time the panel opens.
PuzClashEsc(*) {
    if (PuzClashUp() && !PZ_clashOut)
        PuzClashDismiss()
}
PuzClashExpire() {
    global PZ_clashKey, PZ_clashWho, PZ_clashOwn, PZ_clashAt, PZ_clashOut
    if (!PZ_clashOut || A_TickCount - PZ_clashOut < 300)
        return
    if !PZ_cal                       ; never take the key back from grid setup
        try Hotkey("*Escape", "Off")
    PZ_clashKey := "", PZ_clashWho := "", PZ_clashOwn := "", PZ_clashAt := 0
    PZ_clashOut := 0
}
PuzCtxSolve(*) => puzOn && WinActive("ahk_exe RobloxPlayerBeta.exe")
PuzCtxMark(*)  => puzOn
PuzHotkeys(on) {
    global PZ_hkS, PZ_hkM
    HotIf(PuzCtxSolve)
    if (PZ_hkS != "") {
        try Hotkey("*" PZ_hkS, "Off")
        PZ_hkS := ""
    }
    if (on && puzKey != "") {
        try {
            Hotkey("*" puzKey, PuzSolveHK, "On")
            PZ_hkS := puzKey
        }
    }
    HotIf(PuzCtxMark)
    if (PZ_hkM != "") {
        try Hotkey("*" PZ_hkM, "Off")
        PZ_hkM := ""
    }
    if (on && mkKey != "") {
        try {
            Hotkey("*" mkKey, PuzMarkersHK, "On")
            PZ_hkM := mkKey
        }
    }
    HotIf()                        ; back to no context for anything after this
}
PuzSolveHK(*) {
    global PZ_cancel
    ; If a second thread does get through - the hotkey is free to launch one
    ; whenever the walk is between lines - it cancels rather than queueing a
    ; second session behind the first. PuzSolve's own PZ_solving guard would
    ; have made it a silent no-op.
    if PZ_solving {
        PZ_cancel := 1
        return
    }
    PuzSolve()                     ; the context already proved armed + focused
}

; True once a second press has happened. Cheap enough to sit in the walk's
; per-cell loop: one GetKeyState, and it short-circuits once it has fired.
PuzCancelPoll() {
    global PZ_cancel, PZ_cancelUp
    if PZ_cancel
        return 1
    if (puzKey = "")
        return 0
    if !GetKeyState(puzKey, "P") {
        PZ_cancelUp := 1
        return 0
    }
    if PZ_cancelUp
        PZ_cancel := 1
    return PZ_cancel
}
PuzMarkersHK(*) {
    ; Toggles the markers and NOTHING else. This used to re-anchor on the way
    ; in, as a convenience - but that made a key whose whole job is to show you
    ; where the grid is into a key that could also move it, silently, off a
    ; capture taken with the pointer wherever the user happened to leave it. A
    ; key that reports state should not change it.
    PuzMarkers(-1)
}
; From the hub: arm it, or - if it is already armed with the card minimised -
; bring the card back rather than disarming something that is working.
PuzToggleFromHub() {
    if (puzOn && PZO.gui = "") {
        PuzOvOpen()
        return
    }
    puzOn ? PuzDisable() : PuzEnable()
}
; ================= shared UI + drawing helpers =================
; ---- the 6-dot drag grip, one implementation for every draggable window ----
; The hub, the cropper and the gallery all use this. cx/cy is the centre of the
; grip, `a` is 0..1 for idle -> hovered-or-dragging, `f` is the surface fade and
; `pw` the hover pill width (the hub's header has less room than the two modal
; cards). Dot pitch, radius, colour ramp, the 10% pop and the left-to-right
; ripple all live here so the handles cannot drift apart again.
global GRIP_PX := 11, GRIP_PY := 8, GRIP_H := 22
GripDots(cx, cy, a, acc, now, f := 1.0, pw := 48) {
    st := PushXform(cx, cy, 1 + 0.10*a, 0)
    if (a > 0.01) {
        b := SBrush(FA(Alpha(acc, Round(26*a)), f))
        FillRR(cx - pw/2, cy - GRIP_H/2, pw, GRIP_H, 8, b), DelB(b)
        pn := Pen(FA(Alpha(acc, Round(70*a)), f), 1)
        StrokeRR(cx - pw/2, cy - GRIP_H/2, pw, GRIP_H, 8, pn), DelP(pn)
    }
    loop 6 {
        k  := A_Index
        gc := Mod(k - 1, 3), gr := (k - 1) // 3
        gx := cx - GRIP_PX + gc*GRIP_PX
        gy := cy - GRIP_PY/2 + gr*GRIP_PY
        wv := 0.5 + 0.5*Sin(DecT(now)*0.005 - gc*0.9)          ; ripples left to right
        r6 := 1.6 + 0.5*a
        b := SBrush(FA(Alpha(Mix(0xFFC7CBE0, acc, a), Round(90 + 60*a + 70*a*wv)), f))
        FillEll(gx - r6, gy - r6, r6*2, r6*2, b), DelB(b)
    }
    Pop(st)
}

; ---- the CLEAR control on a keybind row ----
; One source for the renderer and the hit test. The button's x depends on the
; BADGE's width, which changes with whichever key is bound, so two hand-kept
; copies of this drift the moment somebody binds a wider label - the same trap
; PuzOvKeyGeom exists to avoid on the overlay card.
global HUB_KBCW := 24                        ; clear button, square-ish
HubKeyClearX(kbw) => 56 + kbw + 7            ; relative to the row's ax
HubKeyBound(kr)   => (kr = 1 ? bindKey : kr = 2 ? puzKey : mkKey) != ""
; Nothing to clear when nothing is bound, and not while THIS row is the one
; being captured - the badge already reads "???" then, and a button that undoes
; a binding that does not exist yet is a promise about nothing.
HubKeyClearOn(kr) => HubKeyBound(kr) && !(rebindOn && rebindTgt = kr)

; ---- the empty state, ghosting back in as a module retracts ----
; Every systems panel draws the same plate - 26 tall collapsed, its own height
; open - and this is the dashed edge and the "select a module" line that belong
; to the collapsed one. It has to be drawn ON that plate, not before it: the
; sheets fill their plate opaquely, so anything painted underneath is simply
; gone.
;
; FORSAKEN had this inline and was the only module that did, which is why it was
; the only close that ended with the text fading in rather than snapping on at
; full strength once modT hit zero. One definition, called from all five, so
; every module closes the same way.
HubEmptyGhost(ax, ay, pah, ff) {
    ef := 1 - Min(HL.modT*1.6, 1.0)
    if (ef <= 0.01)
        return
    pn := Pen(FA(Alpha(0xFFFFFF, 26*ef), ff), 1)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
    StrokeRR(ax, ay, HL.abw, pah, 12, pn), DelP(pn)
    Txt("select a module to list its systems", ax, ay + pah/2 - 8, HL.abw, 16, fHint
        , FA(Alpha(0xC7CBE0, 84*ef), ff), fmtC)
}

; ---- one keybind row in the FORSAKEN systems panel ----
; `kr` is the binding: 1 AUTOBLOCK, 2 PUZZLE AI solve, 3 PUZZLE AI markers.
; Rows are drawn beneath the card they belong to rather than pooled at the
; bottom, so this takes its own y instead of deriving one from an index.
HubKeyRow(kr, ax, ky, f, now, acc, rbp) {
    mine := (rebindOn && rebindTgt = kr)
    klab := kr = 1 ? bindLabel : kr = 2 ? puzLabel : mkLabel
    kbw  := mine ? qqqBW : (kr = 1 ? bindBW : kr = 2 ? puzBW : mkBW)
    kzn  := kr = 1 ? 10 : kr = 2 ? 1201 : 1202
    kfl  := kr = 1 ? bindFlashAt : kr = 2 ? puzBindFlashAt : mkFlashAt
    knm  := kr = 1 ? "block" : kr = 2 ? "solve" : "markers"
    khv  := HL.h.Get(kzn, 0.0)
    hk_  := Max(khv, mine ? rbp : 0)
    ; A row is only live while the module it drives is armed - its key is not
    ; registered otherwise, so a bright badge would be claiming something
    ; untrue. Dimmed rows are also inert: HubZone refuses them, so they cannot
    ; be clicked into a rebind either.
    live := (kr = 1) ? abOn : puzOn
    kf   := f*(live ? 1 : 0.45)
    Txt(knm, ax, ky, 52, 22, fHint, FA(0x62C7CBE0, kf), fmtL)
    b := SBrush(FA(Mix(0xFF171A30, 0xFF232744, hk_), kf))
    FillRR(ax + 56, ky, kbw, 22, 6, b), DelB(b)
    MicroBackdrop(ax + 56, ky, kbw, 22, 6, acc, kf, now, 0.9)
    pn := Pen(FA(Alpha(acc, 120 + 110*hk_), kf), 1)
    StrokeRR(ax + 56, ky, kbw, 22, 6, pn), DelP(pn)
    Txt(mine ? "???" : klab, ax + 56, ky - 1, kbw, 22, fBadge
        , FA(Alpha(acc, mine ? 150 + 100*rbp : 225 + 30*khv), kf), fmtC)
    if kfl && now - kfl < 520 {
        e := Ease3((now - kfl)/520.0)
        ex := e*9
        pn := Pen(Alpha(acc, 160*(1 - e)), 1.8*(1 - e) + 0.3)
        StrokeRR(ax + 56 - ex, ky - ex*0.5, kbw + ex*2, 22 + ex, 6 + ex*0.4, pn), DelP(pn)
    }
    ; ---- clear ----
    ; FFMBtn rather than a bespoke square: press dip, back-out overshoot, ripple
    ; ring, hover lift and the shine sweep all come with it, so this behaves like
    ; every other control in the suite instead of being a second invention at a
    ; smaller size. Only drawn when there is a binding to remove, so the row is
    ; not carrying a dead control most of the time.
    cbOn := live && HubKeyClearOn(kr)
    if cbOn
        ; U+00D7, not one of the Dingbats crosses: GdipDrawString does not fall
        ; back for a glyph the face lacks, it draws a box, and this face is
        ; whatever the system UI font happens to be
        FFMBtn(1210 + kr, ax + HubKeyClearX(kbw), ky, HUB_KBCW, 22, "×", acc, kf, 0)
    hint := mine ? "press any key - ESC cancels"
          : kr = 1 ? "arms / disarms the block in game"
          : kr = 2 ? "solves the board on screen"
          :          "show or hide the grid markers"
    if !live
        hint := "arm the system above to set a key"
    ; the hint takes whatever the badge and the button leave, and is elided
    ; rather than allowed to run past the panel edge
    hx := ax + (cbOn ? HubKeyClearX(kbw) + HUB_KBCW + 8 : 64 + kbw)
    hw := Max(60, HL.abw - (hx - ax) - 6)
    Txt(FFMElide(hint, fHint, hw), hx, ky, hw, 22, fHint
        , FA(Alpha(mine ? 0x9AA8C0 : 0x62C7CBE0, mine ? 130 + 80*rbp : 150), kf), fmtL)
}

; ---- module open / close ring ----
; The highlight that punches outward when a module opens and collapses back
; inward when it closes. `grow` picks the direction; both fade out over `dur`.
; Every module card and every systems panel goes through this, so opening and
; closing are always mirror images of each other.
ModRing(x, y, w, h, r, acc, f, at, now, dur, amt, grow) {
    ; LOW PERFORMANCE MODE: no ambient ring
    if hubLowPerf
        return
    if (!at || now - at >= dur)
        return
    e  := Ease3((now - at)/dur)
    ex := (grow ? e : 1 - e)*amt
    pn := Pen(FA(Alpha(acc, Round(165*(1 - e))), f), 2.2*(1 - e) + 0.4)
    StrokeRR(x - ex, y - ex*0.6, w + ex*2, h + ex*1.2, r + ex*0.35, pn), DelP(pn)
}

; ---- module card selection strength ----
; The open card rides the shared HL.modT ease. The card that just lost
; selection has nothing to ride: on a straight close HL.modT falls to 0 with
; it, but when selection MOVES to another module HL.modT stays pinned at 1, so
; the outgoing card needs its own decay. That one is timed off HL.modAt over
; the same window as ModRing, so the accent bar retracts in step with the ring
; flourish. `out` is HL.modOut = this card's id.
ModSelT(sel, out, at, now, dur := 620) {
    if sel
        return HL.modT
    if !out
        return 0.0
    if !hubMod                                   ; closing outright
        return HL.modT                           ; card and panel retract together
    if (!at || now - at >= dur)                  ; switching to another module
        return 0.0
    return 1 - Ease3((now - at)/dur)
}
; Fades at both ends, a highlight travels it once every ~3.4 s, and the end cap
; breathes. Shared by the systems panel's PRESETS break and the modules
; column's ROBLOX / MACRO break so the two read as the same device.
GroupLine(x1, x2, y, acc, f, now) {
    if (x2 - x1 <= 24)
        return
    FadeLine(x1, x2, y, Alpha(0xFFFFFF, 52), f)
    phz := Mod(DecT(now), 3400)/3400.0
    if (phz < 0.42) {
        t2 := phz/0.42
        hx := x1 + (x2 - x1)*Ease3(t2)
        ha := Sin(3.14159*t2)
        b := HBrush(hx - 22, y - 1, 22, 2, FA(Alpha(acc, 0), f), FA(Alpha(acc, Round(165*ha)), f))
        FillRR(hx - 22, y, 22, 1, 0.5, b), DelB(b)
        b := HBrush(hx, y - 1, 22, 2, FA(Alpha(acc, Round(165*ha)), f), FA(Alpha(acc, 0), f))
        FillRR(hx, y, 22, 1, 0.5, b), DelB(b)
        b := SBrush(FA(Alpha(AccHi(acc, 0.4), Round(210*ha)), f))
        FillEll(hx - 1.6, y - 1.6, 3.2, 3.2, b), DelB(b)
    }
    b := SBrush(FA(Alpha(acc, 90 + 60*Abs(Sin(DecT(now)*0.0022))), f))
    FillEll(x2 - 2, y - 2, 4, 4, b), DelB(b)
}

HubPoke() {
    ; Not while a solve is running. PuzSay pokes once per finished board, and
    ; each poke drives the hub to 60 fps - a full panel frame competing with the
    ; grid scan, the DFS and the next-deal polling, all of which sit outside the
    ; Critical window PuzDrawPath holds. Solving requires Roblox to be FOCUSED,
    ; so the hub is behind it and nobody is reading the status line at 60 fps
    ; anyway; the renderer is STOPPED for the session (HubTim refuses every
    ; non-zero period while PZ_solving - see the note there), and the finally
    ; below pokes again when the session ends, so the hub catches up in one
    ; frame.
    ;
    ; IsSet: this is reached from HubOpen and from background timers, and
    ; PZ_solving is not assigned until the puzzle module's globals run, which is
    ; after HubOpen in the auto-execute order.
    if (IsSet(PZ_solving) && PZ_solving)
        return
    if hubLive && !hubHidden && !galOpen && !cropUIOn
        HubTim(TICK_A)
}
FmtUp(ms) {
    t := ms // 1000
    return t >= 3600 ? Format("{}:{:02}:{:02}", t // 3600, Mod(t // 60, 60), Mod(t, 60))
                     : Format("{:02}:{:02}", t // 60, Mod(t, 60))
}
MiniHeart(x, y, ms, argb) {
    ; LOW PERFORMANCE MODE: no hearts. Each one is two ellipses plus a
    ; three-line path - built, filled and freed - and they are drawn in
    ; flocks. Pure decoration, so the whole family goes at the source
    ; rather than at each of the nine call sites.
    if hubLowPerf
        return
    b := 0
    DllCall("gdiplus\GdipCreateSolidFill", "uint", argb, "ptr*", &b)
    FillEll(x - ms*0.95, y - ms*0.72, ms, ms, b)
    FillEll(x - ms*0.05, y - ms*0.72, ms, ms, b)
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &tp6 := 0)
    DllCall("gdiplus\GdipAddPathLine", "ptr", tp6, "float", x - ms*0.92, "float", y - ms*0.10, "float", x + ms*0.92, "float", y - ms*0.10)
    DllCall("gdiplus\GdipAddPathLine", "ptr", tp6, "float", x + ms*0.92, "float", y - ms*0.10, "float", x, "float", y + ms*0.95)
    DllCall("gdiplus\GdipClosePathFigure", "ptr", tp6)
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", tp6)
    DllCall("gdiplus\GdipDeletePath", "ptr", tp6)
    DelB(b)
}
CornerFlourish(x, y, w, h, col, f2 := 1.0) {
    now2 := A_TickCount
    loop 4 {
        k := A_Index
        cxr := (k = 1 || k = 3) ? x + 4 : x + w - 4
        cyr := (k <= 2) ? y + 4 : y + h - 4
        qa := k = 1 ? 0 : k = 2 ? 90 : k = 4 ? 180 : 270
        a0 := qa + 12 + 8*Sin(now2*0.0021 + k*1.6)
        swp := 58 + 12*Sin(now2*0.0033 + k)
        pn := Pen(Alpha(col, Round((110 + 60*Sin(now2*0.003 + k))*f2)), 1.5)
        Arc(cxr - 15, cyr - 15, 30, 30, a0, swp, pn), DelP(pn)
        pn := Pen(Alpha(col, Round(66*f2)), 1)
        Arc(cxr - 10, cyr - 10, 20, 20, a0 + 12, swp*0.7, pn), DelP(pn)
        da := (a0 + swp*(0.5 + 0.5*Sin(now2*0.0026 + k*1.3)))*0.0174533
        b := SBrush(Alpha(AccHi(col, 0.5), Round(200*f2)))
        FillEll(cxr + 15*Cos(da) - 1.6, cyr + 15*Sin(da) - 1.6, 3.2, 3.2, b), DelB(b)
    }
}
; Returns the substring that fits `maxw`, keeping `car` in view, and reports
; how many characters were scrolled off the left in `off`.
FldWindow(val, car, font, maxw, &off) {
    off := 0
    if (MeasureW(val, font) <= maxw)
        return val
    ; keep the caret inside the window
    lo := car
    while (lo > 0 && MeasureW(SubStr(val, lo + 1, car - lo), font) < maxw)
        lo -= 1
    lo := Max(lo, 0)
    vis := SubStr(val, lo + 1)
    while (MeasureW(vis, font) > maxw && StrLen(vis) > 1)
        vis := SubStr(vis, 1, -1)
    off := lo
    return vis
}

ScrFldBox(fx, fdy, fw, j, f, zid) {
    foc := SH.focus = (j + 1)
    hv := HL.h.Get(zid, 0.0)
    b := SBrush(FA(Mix(0xFF141728, 0xFF1B2038, Max(hv, foc*1.0)), f))
    FillRR(fx, fdy, fw, HL.fdh, 7, b), DelB(b)
    MicroBackdrop(fx, fdy, fw, HL.fdh, 7, hubCur, f, A_TickCount, 0.75)
    pn := Pen(FA(Alpha(foc ? hubCur : 0xFFFFFF, foc ? 190 : 26 + 40*hv), f), 1)
    StrokeRR(fx, fdy, fw, HL.fdh, 7, pn), DelP(pn)
    val := j = 1 ? SH.name : SH.desc
    ph := j = 1 ? "script name" : "short description"
    fwv := fw - 20
    vis := FldWindow(val, SH.fCar, fHint, fwv, &voff)
    if foc && SH.fSel >= 0 && SH.fSel != SH.fCar {
        a := Max(Min(SH.fSel, SH.fCar) - voff, 0), b2 := Max(SH.fSel, SH.fCar) - voff
        b2 := Min(b2, StrLen(vis))
        if (b2 > a) {
            x1 := MeasureW(SubStr(vis, 1, a), fHint), x2 := MeasureW(SubStr(vis, 1, b2), fHint)
            b := SBrush(FA(Alpha(hubCur, 64), f))
            FillRR(fx + 10 + x1, fdy + 4, Max(x2 - x1, 3), HL.fdh - 8, 3, b), DelB(b)
        }
    }
    Txt(val = "" ? ph : vis, fx + 10, fdy, fwv, HL.fdh, fHint
        , FA(Alpha(val = "" ? 0x9AA8C0 : 0xE8EAF6, val = "" ? 110 : 225), f), fmtL)
    if foc && Mod(A_TickCount - SH.caretAt, 1000) < 550 {
        cwd := MeasureW(SubStr(vis, 1, Max(SH.fCar - voff, 0)), fHint)
        pn := Pen(FA(Alpha(hubCur, 235), f), 1.4)
        Line(fx + 10 + cwd + 1, fdy + 5, fx + 10 + cwd + 1, fdy + HL.fdh - 5, pn), DelP(pn)
    }
}
; chip with press feedback and a ring pulse when its action fires
ScrCeBtn(zid, x, y, w, h, label, base, f, now) {
    hv := HL.h.Get(zid, 0.0)
    pr := (HL.drag && HL.dragZone = zid) ? 1 : 0
    fl := (SH.ceBtnAt && SH.ceBtnZ = zid && now - SH.ceBtnAt < 520)
        ? 1 - Ease3((now - SH.ceBtnAt)/520.0) : 0
    st := PushXform(x + w/2, y + h/2, (1 + 0.05*hv - 0.04*pr)*(1 + 0.06*fl), 0)
    ChipDraw(x, y, w, h, label, hv, base, f)
    Pop(st)
    if (fl > 0.01) {
        pn := Pen(FA(Alpha(base, Round(200*fl)), f), 2.2*fl + 0.4)
        ex := (1 - fl)*14
        StrokeRR(x - ex, y - ex*0.6, w + ex*2, h + ex*1.2, 7 + ex*0.3, pn), DelP(pn)
    }
}

ChipDraw(x, y, w, h, label, hv, base, f) {
    st := PushXform(x + w/2, y + h/2, 1 + 0.05*hv, 0)
    b := VBrush(x, y, w, h, FA(Mix(0xFF31344C, 0xFF41466A, hv), f), FA(Mix(0xFF20223A, 0xFF262A45, hv), f))
    FillRR(x, y, w, h, 7, b), DelB(b)
    MicroBackdrop(x, y, w, h, 7, base, f, A_TickCount, 0.9)
    pn := Pen(FA(Alpha(base, 110 + 90*hv), f), 1)
    StrokeRR(x, y, w, h, 7, pn), DelP(pn)
    Txt(label, x, y - 1, w, h, fBadge, FA(Alpha(AccHi(base, 0.35), 215 + 40*hv), f), fmtC)
    Pop(st)
}

; ================= loading screen =================
LoadingScreen() {
    global G
    CWl := 440, CHl := 190, PDl := 26
    BWl := CWl + PDl*2, BHl := CHl + PDl*2
    LWp := Round(BWl*scaleF), LHp := Round(BHl*scaleF)
    cx := PDl, cy := PDl
    pbx := cx + 26, pby := cy + 122, pbw := CWl - 52, pbh := 10
    SCRSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&"
    savN  := SPF.saved.Length + SPF.savedP.Length
    acctN := SPF.acct.Length
    ; The fourth caption named saved places only, which is what the queue used
    ; to hold. It holds the saved accounts too now, and a boot that pauses there
    ; should say which of the two it is waiting on.
    ldSay := (savN && acctN) ? ("resolving " savN " place(s), " acctN " account(s)")
           : savN            ? ("resolving saved places [" savN "]")
           : acctN           ? ("signing in saved accounts [" acctN "]")
           :                   "arming hotkey matrix"
    steps := [[0, "verifying credentials"], [360, "decrypting asset pool"]
        , [800, "mounting avatar pool [" selN "]"]
        , [1260, ldSay]
        , [1720, "fetching community flags"]
        , [2180, "syncing interface"]]
    ; `tgt` is gone. It held one bar position per caption, which is what made
    ; the bar move in five decelerating lurches; the captions are driven by the
    ; timings in `steps` and never needed it. See the pacing block in LRender.
    ;
    ; How long the scripted fill takes when nothing is waiting on the network.
    ; The bar crosses 0 -> 100% linearly over this, so it is also the floor on
    ; how briefly the loading screen can be on screen.
    LD_SCRIPT_MS := 2620
    ; How much of the bar the clock may fill on its own while work is still
    ; outstanding, and the highest it may reach before that work is done. The
    ; gap between them is what the queue and the creep share.
    LD_BODY := 0.72
    LD_CEIL := 0.99
    ; Floor on how far the bar may move per frame while catching up to its
    ; target. Above the clock's own rate, so it tracks rather than trails.
    LD_RATE := 0.010
    ; The screen used to end on a fixed 2.6s timeline whatever the queue was
    ; doing, so a saved place whose name and stats had not come back yet landed
    ; in the hub as "loading game details...". It now holds at 97% until the
    ; work is actually done. LOAD_MAX_MS is the escape hatch - a dead network
    ; must not mean a hub that never opens, and SPFPrefetchArm already keeps
    ; draining whatever is left in the background.
    LOAD_MAX_MS := 12000
    ; ---- what the bar is actually measuring ----
    ; This was `savN + 1`, which counted the saved places and the flag database
    ; and nothing else - so every asset the hub decodes on first draw was
    ; invisible to it, and the community game was not even queued. Taken from the
    ; live queues instead, so adding work to either is automatically reflected
    ; here rather than silently making the bar lie.
    ;
    ; It is a HIGH-WATER MARK, not a fixed total: a "bmp" warm job expands into
    ; one job per bitmap once its stats land, so the queue legitimately grows
    ; mid-load. Held fixed, the ratio below would go negative, clamp to zero, and
    ; park the bar at LD_BODY for the rest of the load.
    BootWarmStart()
    ; ---- the community flags, from here on ----
    ; They were fetched only when the panel opened, so the first open of a
    ; session drew last session's sets and then swapped them out under the
    ; cursor. The sync child is launched here with the rest of the boot work
    ; and counted with it: `ui` and the WM_COPYDATA handler both exist by this
    ; line, so its answer lands during the load exactly as it would in the hub,
    ; and FFMCommSyncing is the pending test, with the 60 s escape it already
    ; has. When it lands, FFMCommQueueGames puts every game it named into the
    ; two queues this screen is already draining, so their details and artwork
    ; load here too - ldPend0 is a high-water mark for exactly that reason.
    ; LOAD_MAX_MS still caps the whole load, so a slow repository delays the
    ; hub by at most that, and the panel picks up whatever is left.
    FFMCommSync()
    ldPend0 := SPFPrefetchLeft() + BootWarmLeft() + 1 + (FFMCommSyncing() ? 1 : 0)   ; +1 for the flag database

    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", LWp, bi, 4), NumPut("int", -LHp, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    hbmL := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0, "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    hdcL := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", hdcL, "ptr", hbmL, "ptr")
    mainG := G
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", hdcL, "ptr*", &GL := 0)
    G := GL
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", G, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", G, "int", 2)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G, "float", LWp/BWl, "float", LHp/BHl, "int", 0)
    fLT := NewFont(22, 1)
    scrInit := BuildScr("INITIALIZING", fLT), scrReady := BuildScr("READY", fLT)

    lw := Gui("-Caption +E0x80000 +E0x8000000 +AlwaysOnTop +ToolWindow -DPIScale", "YURILOAD")
    lw.Show("NA x0 y0 w" LWp " h" LHp)
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    lbx := mL + ((mR - mL) - LWp)//2
    lby := mT + ((mB - mT) - LHp)//2

    lIntro := A_TickCount
    prog := 0.0, doneAt := 0, ldDone := 0, stepIdx := 1, stepAt := lIntro
    ; ---- the bar must not go backwards ----
    ; Both inputs to it could fall, and did:
    ;
    ;  - ldW is finished/total, and total is a HIGH-WATER mark. A "bmp" warm job
    ;    expands into one job per bitmap the moment its stats land, so pending
    ;    and total jump in the same frame and the ratio collapses to zero.
    ;  - prog then followed it down, because the tracker's else branch assigned
    ;    ldWant outright instead of easing toward it. The bar visibly snapped
    ;    back to LD_BODY and set off again, which is what this looked like.
    ;
    ; ldWMax remembers the most work that has ever been finished, so a queue
    ; that grows can only slow the bar down, never rewind it.
    ldWMax := 0.0
    ldDoneN := 0            ; and the caption's count, for the same reason
    SetTimer(LRender, TICK_A)
    while !ldDone
        Sleep 25
    return

    LFinish() {
        global G
        SetTimer(LRender, 0)
        DllCall("gdiplus\GdipDeleteFont", "ptr", fLT)
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", GL)
        DllCall("gdi32\DeleteDC", "ptr", hdcL)
        DllCall("gdi32\DeleteObject", "ptr", hbmL)
        lw.Destroy()
        G := mainG
        ldDone := 1
    }
    LRender() {
        now := A_TickCount
        ThemeTick()
        el := now - lIntro
        it := Min(el/INTRO_MS, 1.0)
        ei := 1 - (1 - it)**3
        winA := Round(255*Min(it*1.7, 1.0))
        yO := Round((1 - ei)*26*scaleF)
        SPFPrefetchTick()                        ; warm the saved library
        BootWarmTick()                           ; ... and decode what it draws with
        ; Everything the hub needs before it is worth showing: the lookup queue
        ; (names, icons, banners, stats for every id the player added AND for the
        ; community game), the artwork every panel decodes on first draw, the
        ; fast-flag database, and the community sets. All four report progress,
        ; so the bar can track real work instead of a stopwatch.
        ldPend := SPFPrefetchLeft() + BootWarmLeft() + (FFM.loading ? 1 : 0) + (FFMCommSyncing() ? 1 : 0)
        if (ldPend > ldPend0)                    ; see the note at ldPend0
            ldPend0 := ldPend
        ldOpen := (ldPend = 0) || (el >= LOAD_MAX_MS)
        ; ---- pacing ----
        ; Three things were making the bar back-heavy, and they compounded:
        ;
        ;  1. The scripted targets decelerated. 0.16/0.40/0.63/0.85/0.97 across
        ;     0/430/980/1560/2140 ms is 0.56 of the bar per second in the first
        ;     segment and 0.06 in the last - a ninefold slowdown built into the
        ;     numbers, before anything else happened.
        ;  2. `prog += (want - prog)*0.085` is an exponential approach, and an
        ;     exponential spends most of its life in the last few percent: from
        ;     0.97 it needed about forty frames, 0.6 s, just to be called done.
        ;  3. It then parked on 0.97 for as long as real work took - up to
        ;     LOAD_MAX_MS. The comment claimed the bar "keeps creeping" there,
        ;     but easing onto a fixed target stops dead on it, so it did not.
        ;     Meanwhile the caption below was already reporting honest counts
        ;     ("resolving · 2 / 6"), so the two openly disagreed.
        ;
        ; Replaced with one rule: the bar tracks the CLOCK, linearly, and real
        ; work can only hold it BACK. Equal time is equal distance by
        ; construction, and the point it is held at rises as work actually
        ; lands instead of always being 97%.
        ldT := Clamp(el/LD_SCRIPT_MS, 0.0, 1.0)                  ; the clock
        ; one share per item that has genuinely landed
        ldW := (ldPend0 > 0) ? Clamp(1.0 - ldPend/ldPend0, 0.0, 1.0) : 1.0
        ldWMax := Max(ldWMax, ldW)               ; a floor, never a reading
        ldDoneN := Max(ldDoneN, ldPend0 - ldPend)
        ; and a slow walk toward the ceiling over whatever budget is left, so a
        ; stalled network reads as slow rather than as frozen - this is the
        ; creep the old comment described and the old code never did
        ; It starts where the CLOCK hands off, not at LD_SCRIPT_MS. Those are
        ; 1886 ms and 2620 ms apart, and in between the clock was already capped
        ; at LD_BODY while the creep had not begun - three quarters of a second
        ; of a bar that did not move at all, on exactly the dead-network load
        ; where a frozen bar is least welcome.
        ldC := Clamp((el - LD_BODY*LD_SCRIPT_MS)/Max(1, LOAD_MAX_MS - LD_BODY*LD_SCRIPT_MS)
                   , 0.0, 1.0)
        ldCeil := ldOpen ? 1.0
                : Min(LD_BODY + (LD_CEIL - LD_BODY)*Max(ldWMax, ldC), LD_CEIL)
        ldWant := Min(ldT, ldCeil)
        ; Exponential for smoothness, but never slower than LD_RATE. Without a
        ; floor the bar sits a fixed distance behind its target forever and the
        ; tail crawls; with one it tracks the linear clock exactly, which is the
        ; whole point.
        ldD := ldWant - prog
        if (ldD > 0)
            prog := Min(prog + Max(ldD*EK(0.085), LD_RATE), ldWant)
        ; and no else. A target below the bar means the ceiling came down or the
        ; queue grew; the bar holds there until the target catches up again.
        if prog > 0.999 && ldOpen
            prog := 1.0
        ; ---- the captions follow the BAR, not the clock ----
        ; They ran off el, so on a slow load the narration marched through all
        ; five stages and the counter read 05 / 05 while the bar was still held
        ; at 72%. On an unblocked load prog tracks the clock exactly, so the
        ; timings below play out as written; when work holds the bar back, the
        ; narration now holds with it instead of claiming stages that have not
        ; started.
        ldClock := prog*LD_SCRIPT_MS
        si := 1
        loop steps.Length
            if ldClock >= steps[A_Index][1]
                si := A_Index
        if si != stepIdx
            stepIdx := si, stepAt := now
        if prog >= 1.0 && !doneAt
            doneAt := now
        scl := 1 + 0.004*Sin(DecT(now)*0.0012)
        if doneAt {
            if now - doneAt > 480 {
                ft := Min((now - doneAt - 480)/330.0, 1.0)
                winA := Round(winA*(1 - ft)), scl := scl*(1 - 0.06*ft)
                yO += Round(10*ft*scaleF)
                if ft >= 1 {
                    LFinish()
                    return
                }
            } else
                scl := scl*(1 + 0.02*Sin(3.14159*Min((now - doneAt)/260.0, 1.0)))
        }
        ; ramp from the CHOSEN accent, not from C_OFF - which is the default
        ; accent, so the loading screen ignored the setting entirely
        curL := AccSat(Mix(hubAccent, C_ON, prog))
        embG := (Sin(DecT(now)*0.0016) + 1)/2
        emb2G := (Sin(DecT(now)*0.004) + 1)/2

        ResetSurface(G, LWp/BWl, LHp/BHl)
        DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
        st0 := PushXform(cx + CWl/2, cy + CHl/2, scl, 0)
        ShadowDraw(cx, cy + 3, CWl, CHl, 16, 10, 8, 8, 1.0)
        b := BgV(cx, cy, CWl, CHl, 0xF2222438, 0xF8121423)
        FillRR(cx, cy, CWl, CHl, 16, b), DelB(b)
        p := RRPath(cx, cy, CWl, CHl, 16)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 0)
        PanelBackdrop(cx, cy, CWl, CHl, hubAccent, 1.0, now, 0.95)
        rcD := Buffer(16), NumPut("float", cx - 1, "float", cy - 1, "float", CWl + 2, "float", CHl + 2, rcD)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcD, "uint", 0x0EFFFFFF, "uint", 0x00FFFFFF, "int", 2, "int", 3, "ptr*", &db := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", db, "float", cx, "float", cy, "float", CWl, "float", CHl), DelB(db)
        loop 10 {
            k := A_Index
            cyc := 5200 + k*337
            prt := Mod(now + k*997, cyc)/cyc
            mx_ := cx + 34 + Mod(k*167, CWl - 68) + 9*Sin(DecT(now)*0.0009 + k*1.7)
            my_ := cy + CHl - 10 - prt*(CHl - 20)
            b := SBrush(Alpha(AccHi(curL, 0.35), 44*Sin(3.14159*prt)))
            mr_ := 0.9 + Mod(k, 3)*0.5
            FillEll(mx_ - mr_, my_ - mr_, mr_*2, mr_*2, b), DelB(b)
        }
        swp := Mod(DecT(now), 3400)/3400.0
        swx := cx - 26 + (CWl + 52)*swp
        c0s := curL & 0xFFFFFF
        c1s := Alpha(c0s, 16 + 22*prog)
        rcS := Buffer(16), NumPut("float", swx - 25, "float", cy - 2, "float", 26, "float", CHl + 4, rcS)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS, "uint", c0s, "uint", c1s, "int", 0, "int", 3, "ptr*", &sbA := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbA, "float", swx - 24, "float", cy, "float", 24, "float", CHl), DelB(sbA)
        rcS2 := Buffer(16), NumPut("float", swx - 1, "float", cy - 2, "float", 26, "float", CHl + 4, rcS2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS2, "uint", c1s, "uint", c0s, "int", 0, "int", 3, "ptr*", &sbB := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbB, "float", swx, "float", cy, "float", 24, "float", CHl), DelB(sbB)
        b := SBrush(Alpha(curL, Min(255, 46 + 16*embG + 60*prog)))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 14, "float", CHl), DelB(b)
        b := VBrush(cx, cy, 4.5, CHl, Alpha(curL, 245), Alpha(curL, 110 + 40*embG))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 4.5, "float", CHl), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", p)
        pn := Pen(0x28FFFFFF, 1)
        StrokeRR(cx, cy, CWl, CHl, 16, pn), DelP(pn)
        pn := Pen(0x16FFFFFF, 1)
        Line(cx + 18, cy + 1.5, cx + CWl - 18, cy + 1.5, pn), DelP(pn)
        pn := Pen(Alpha(curL, 20 + 10*emb2G), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
        StrokeRR(cx + 6, cy + 6, CWl - 12, CHl - 12, 12, pn), DelP(pn)
        CornerFlourish(cx, cy, CWl, CHl, curL)
        Txt(Format("{:02} / {:02}", stepIdx, steps.Length), cx + CWl - 140, cy + 30, 96, 12, fBadge, Alpha(0x9AA8C0, 130), fmtR)

        Txt(APPNAME, cx + 26, cy + 12, 90, 20, fBrand, 0xCFE8EAF6, fmtL)
        hb := Mod(DecT(now), 2200)
        blink := (hb < 140 || (hb > 300 && hb < 440)) ? 1 : 0
        b := SBrush(Alpha(curL, Min(255, 150 + 35*emb2G + 48*blink)))
        FillEll(cx + 26 + wZeal + 6, cy + 19.5, 5, 5, b), DelB(b)
        ckx := cx + CWl - 44
        pn := Pen(Alpha(curL, 170), 1.6)
        Arc(ckx - 86, cy + 15, 10, 10, Mod(DecT(now)*0.22, 360), 100, pn)
        Arc(ckx - 86, cy + 15, 10, 10, Mod(DecT(now)*0.22, 360) + 180, 40, pn), DelP(pn)
        Txt(ClockStr(), ckx - 70, cy + 13, 70, 14, fBadge, 0x86C7CBE0, fmtR)

        scr := doneAt ? scrReady : scrInit
        scrAt := doneAt ? doneAt : lIntro
        ty := cy + 46
        if now < scrAt + 130 + scr.chs.Length*42 {
            loop scr.chs.Length {
                i := A_Index
                if now < scrAt + 90 + i*42 {
                    ch := SubStr(SCRSET, Random(1, StrLen(SCRSET)), 1)
                    cc := Alpha(Mix(curL, 0xFFE8EAF6, 0.55), 205)
                } else {
                    ch := scr.chs[i]
                    cc := Alpha(curL, 245)
                }
                Txt(ch, cx + 26 + scr.xs[i], ty, 46, 30, fLT, cc, fmtL)
            }
        } else
            Txt(doneAt ? "READY" : "INITIALIZING", cx + 26, ty, 290, 30, fLT, Alpha(curL, 245), fmtL)
        ulw := Mod(DecT(now)*0.09, 180) - 30
        sxu := Max(cx + 26, cx + 26 + ulw)
        sxv := Min(cx + 176, cx + 26 + ulw + 30)
        if sxv > sxu + 1 {
            b := SBrush(Alpha(AccHi(curL, 0.35), 175))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", sxu, "float", ty + 30, "float", sxv - sxu, "float", 2), DelB(b)
        }
        b := SBrush(Alpha(curL, 40))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx + 26, "float", ty + 30, "float", 150, "float", 1), DelB(b)
        loop 3 {
            k := A_Index - 1
            x0 := cx + 26 + scr.w + 12 + k*7
            ca := 50 + 85*Max(0.0, Sin(DecT(now)*0.0025 - k*0.9))**3
            pn := Pen(Alpha(Mix(0xFFE8EAF6, curL, 0.35), Min(255, ca)), 1.8)
            Line(x0, ty + 15 - 3.8, x0 + 3.6, ty + 15, pn)
            Line(x0 + 3.6, ty + 15, x0, ty + 15 + 3.8, pn)
            DelP(pn)
        }

        stf := Ease3((now - stepAt)/240.0)
        sly := pby - 22 + (1 - stf)*5
        pn := Pen(Alpha(curL, 190*stf), 1.6)
        Line(pbx, sly + 6, pbx + 4, sly + 9.5, pn)
        Line(pbx + 4, sly + 9.5, pbx, sly + 13, pn), DelP(pn)
        ; Once the timeline has run out but work has not, the caption stops
        ; narrating and starts reporting - a bar sitting at 97% with no
        ; explanation is what reads as a hang.
        ldLbl := doneAt ? "handshake complete"
               : (el >= LD_SCRIPT_MS && ldPend) ? ("resolving  ·  " ldDoneN " / " ldPend0)
               : steps[stepIdx][2]
        Txt(ldLbl, pbx + 12, sly, pbw - 120, 18, fHint, Alpha(0xC7CBE0, 90 + 130*stf), fmtL)
        Txt(Round(prog*100) "%", pbx, sly, pbw, 18, fBadge, Alpha(curL, 235), fmtR)

        b := SBrush(0xFF171A30)
        FillRR(pbx, pby, pbw, pbh, 5, b), DelB(b)
        ; the empty track, not the fill - the fill is clipped and drawn over
        ; this a few lines down, so the texture only shows where it has not
        ; reached yet, which is what makes the bar read as travelling over it
        MicroBackdrop(pbx, pby, pbw, pbh, 5, curL, 1.0, now, 0.9)
        pn := Pen(0x30FFFFFF, 1)
