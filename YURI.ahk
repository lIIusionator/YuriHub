                whr3.Open("GET", "https://thumbnails.roblox.com/v1/places/gameicons?placeIds="
                                 A_Args[3] "&size=512x512&format=Png&isCircular=false", false)
                whr3.SetRequestHeader("User-Agent", "YURI")
                whr3.Send()
                if (whr3.Status = 200 && RegExMatch(whr3.ResponseText, '"imageUrl"\s*:\s*"([^"]*)"', &m3))
