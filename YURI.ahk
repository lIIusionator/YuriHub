    else if (RSET.dd && RSET.ddT > 0.996)
        RSET.ddT := 1.0
    RSET.onT += ((RSET.on ? 1.0 : 0.0) - RSET.onT)*EK(0.14)
    if (!RSET.on && RSET.onT < 0.004)
