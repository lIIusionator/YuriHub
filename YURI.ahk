Lerp(a, b, t) => a + (b - a)*t
Clamp(v, lo, hi) => v < lo ? lo : v > hi ? hi : v

; ---- keeping a draggable window reachable -----------------------------------
; Every layered window in the suite is moved by ONE small handle and by nothing
; else: the 6-dot grip while it is open, the pill while it is collapsed. The
; card itself is deliberately not a drag surface - three of these files say so
; in a comment beside their hit test.
;
; So the invariant that keeps a window usable is not "some of the window is on
; screen", which is what every clamp here used to enforce, but "the handle that
; is live right now is on screen". Those are different rules, and the gap
; between them is where a window could be parked somewhere it could never be
; picked up again:
;
;   - the hub collapsed while sitting to the right or below centre put the pill
;     (which lives at the BOTTOM-RIGHT of a 832x572 canvas) clean off the
;     screen, and the pill is the only hit zone a collapsed hub has;
;   - the hub restored from a pill that had been dragged to an edge expanded
;     around that pill, throwing the grip - top-LEFT of the same canvas - up to
;     540 px past the screen edge. That is the state in the report: a strip of
;     the hub's foot visible along the top of the display and no way to drag it
;     back down;
;   - both overlays had the first fault for the same reason.
;
; Given the handle rectangle in the window's own unscaled canvas coordinates,
; this returns the range the window ORIGIN may occupy for that rectangle to
; stay fully on the virtual desktop.
; ---- the resolution half of the UI scale - see scaleF ----
; SM_CXSCREEN / SM_CYSCREEN, which are the PRIMARY screen in the virtualised
; space this process works in, so a DPI-scaled display reports the same numbers
; the rest of the suite's coordinates are already in and the two factors do not
; multiply each other by accident.
UiResScale() {
    ; rw/rh, not sw/sh: `sh` is the SCRIPT HUB's state object case-insensitively,
    ; and while an undeclared assignment only makes a local, a name that collides
    ; with a super-global is exactly the thing this file has been bitten by
    ; before and exactly what makes a real collision hard to spot in an audit.
    rw := DllCall("GetSystemMetrics", "int", 0)
    rh := DllCall("GetSystemMetrics", "int", 1)
    if (rw < 320 || rh < 240)              ; a mode mid-switch reports nonsense
        return 1.0
    ; ---- DAMPED, and heavily ----
    ; Straight min(w/1920, h/1080) grew the interface in step with the screen,
    ; which is too much for two reasons. A bigger display is normally further
    ; away or simply carrying more at once, so chrome that grows one-for-one
    ; reads as oversized - and on the hub it compounds, because hubMag (1.2 by
    ; default) multiplies on top of this.
    ;
    ; The exponent is the whole control. 1.0 is proportional, 0 is fixed-size;
    ; this has come down 1.0 -> 0.5 -> 0.25 across two rounds of "still too big",
    ; and 0.25 is a quarter-power curve: clearly bigger on a bigger screen, but
    ; nowhere near proportionally. 1440p lands at 1.07 rather than 1.33, and 4K
    ; at 1.19 rather than 2.0. Exactly 1.0 at the 1920x1080 the layout was drawn
    ; for, which is the one point that must not move.
    ;
    ; It also lifts the small end - 0.90 at 720p instead of 0.67 - which is where
    ; the 7.5pt faces stop being readable, so the floor rarely binds now.
    ;
    ; This is also the only lever on the hub's frame COST that scales. Every
    ; surface is drawn in base units through a world transform, so the number of
    ; fills, strokes and strings per frame is identical at any size; what grows
    ; is the area they rasterise into. 1.19 at 4K is 1.4x the pixels of a 1080p
    ; frame where proportional scaling was 4x.
    return Clamp((Min(rw/1920.0, rh/1080.0))**0.25, 0.85, 1.25)
}
HandleBounds(hx0, hy0, hx1, hy1, k, &lox, &hix, &loy, &hiy) {
    vx := SysGet(76), vy := SysGet(77), vw := SysGet(78), vh := SysGet(79)
    pad := Round(8*scaleF)
    lox := vx + pad - Round(hx0*k), hix := vx + vw - pad - Round(hx1*k)
    loy := vy + pad - Round(hy0*k), hiy := vy + vh - pad - Round(hy1*k)
    ; A handle larger than the display inverts the range, and Clamp answers `lo`
    ; for every input when lo > hi - which would pin the window hard against one
    ; edge. Collapse an inverted range onto its midpoint instead, which centres
    ; the handle rather than banishing it.
    if (hix < lox)
        lox := hix := (lox + hix)//2
    if (hiy < loy)
        loy := hiy := (loy + hiy)//2
}
; The work area of the monitor a point sits on, falling back to the primary when
; the point is off every display. MonitorGetPrimary() was being used as a stand-in
; for this in places that anchor to another window, which is only ever right on a
; single-monitor machine.
MonWorkAreaAt(x, y, &mL, &mT, &mR, &mB) {
    loop MonitorGetCount() {
        MonitorGet(A_Index, &l, &t, &r, &b)
        if (x >= l && x < r && y >= t && y < b) {
            MonitorGetWorkArea(A_Index, &mL, &mT, &mR, &mB)
            return
        }
    }
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
}
; One eased step from `from` toward `to`, in whole pixels and never stalling
; short of the target. These positions are handed to UpdateLayeredWindow through
; NumPut "int", so they have to stay integers; a plain `x += d*0.24` would both
; feed it a float and creep to a halt once the step rounded to zero.
StepTo(from, to, k) {
    d := to - from
    if (d = 0)
        return from
    s := Round(d*k)
    return from + (s ? s : (d > 0 ? 1 : -1))
}
; brief pull-back, then accelerate through the middle and settle into the orb
MinIn(t) {
    if (t < 0.20)
        return -0.06*Sin(t/0.20*3.14159)
    u := (t - 0.20)/0.80
    return u*u*(3 - 2*u)
}
EBackOut(t, c1) => 1 + (c1 + 1)*(t - 1)**3 + c1*(t - 1)**2
Ease3(t) => t <= 0 ? 0.0 : t >= 1 ? 1.0 : 1 - (1 - t)**3
; progress whose eased value is `y` - used to resume a reversed crossfade
Ease3Inv(y) => y <= 0 ? 0.0 : y >= 1 ? 1.0 : 1 - (1 - y)**(1/3)
Alpha(c, a) => ((Round(a) & 0xFF) << 24) | (c & 0xFFFFFF)
FA(c, f) => f >= 0.996 ? c : ((Round(((c >> 24) & 0xFF) * f) & 0xFF) << 24) | (c & 0xFFFFFF)
Mix(c1, c2, t) {
    a := Round(Lerp((c1 >> 24) & 0xFF, (c2 >> 24) & 0xFF, t))
    r := Round(Lerp((c1 >> 16) & 0xFF, (c2 >> 16) & 0xFF, t))
    g := Round(Lerp((c1 >> 8)  & 0xFF, (c2 >> 8)  & 0xFF, t))
    b := Round(Lerp( c1        & 0xFF,  c2        & 0xFF, t))
    return (a << 24) | (r << 16) | (g << 8) | b
}
FadeLine(x1, x2, y, argb, f) {
    argb := ElA(TH(argb))
    ; LOW PERFORMANCE MODE: one flat hairline. A divider only has to separate
    ; two things - the fade to nothing at each end is decoration, and it costs
    ; two gradient brushes per call across nearly thirty call sites.
    if hubLowPerf {
        b := SBrushP(FA(argb, f*0.7))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
              , "float", x1, "float", y, "float", x2 - x1, "float", 1), DelB(b)
        return
    }
    c1 := FA(argb, f), c0 := argb & 0xFFFFFF
    mid := (x1 + x2)/2
    static rc := Buffer(16)
    NumPut("float", x1 - 1, "float", y - 2, "float", mid - x1 + 2, "float", 4, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c0, "uint", c1, "int", 0, "int", 3, "ptr*", &b := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", x1, "float", y, "float", mid - x1, "float", 1), DelB(b)
    rc2 := Buffer(16), NumPut("float", mid - 1, "float", y - 2, "float", x2 - mid + 2, "float", 4, rc2)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc2, "uint", c1, "uint", c0, "int", 0, "int", 3, "ptr*", &b2 := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b2, "float", mid, "float", y, "float", x2 - mid, "float", 1), DelB(b2)
}
ShieldPath(x, y, w, h) {
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &p := 0)
    DllCall("gdiplus\GdipAddPathLine", "ptr", p, "float", x, "float", y, "float", x + w, "float", y)
    DllCall("gdiplus\GdipAddPathLine", "ptr", p, "float", x + w, "float", y, "float", x + w, "float", y + h*0.5)
    DllCall("gdiplus\GdipAddPathBezier", "ptr", p, "float", x + w, "float", y + h*0.5, "float", x + w, "float", y + h*0.8, "float", x + w*0.72, "float", y + h*0.92, "float", x + w/2, "float", y + h)
    DllCall("gdiplus\GdipAddPathBezier", "ptr", p, "float", x + w/2, "float", y + h, "float", x + w*0.28, "float", y + h*0.92, "float", x, "float", y + h*0.8, "float", x, "float", y + h*0.5)
    DllCall("gdiplus\GdipClosePathFigure", "ptr", p)
    return p
}
NewFont(sz, style) {
    DllCall("gdiplus\GdipCreateFont", "ptr", fam, "float", sz, "int", style, "int", 2, "ptr*", &f := 0)
    return f
}
NewFmt(align) {
    DllCall("gdiplus\GdipCreateStringFormat", "int", 0x5000, "int", 0, "ptr*", &f := 0)
    DllCall("gdiplus\GdipSetStringFormatAlign", "ptr", f, "int", align)
    DllCall("gdiplus\GdipSetStringFormatLineAlign", "ptr", f, "int", 1)
    return f
}
; ---- the ceiling, and why it is where it is ----
; It was 600, and 600 was far too low for what actually asks. Fifty-odd call
; sites elide, BuildScr mints one key per character of every scrambling string,
; and the client-settings flag page alone measures two elided strings for each
; of its visible rows. The cap was being blown inside a SINGLE frame, and the
; overflow is a full Clear - so the whole hub's text metrics were thrown away
; and re-measured from cold, several times over, every frame. That is the
; "extremely low FPS on EDIT FAST FLAGS" fault: not the page's own drawing, but
; the page tipping a shared cache into permanent thrash.
;
; 4000 short strings is a rounding error of memory and puts steady-state use an
; order of magnitude under the ceiling, so the Clear becomes the rare event it
; was written to be rather than a per-frame one.
MeasureW(s, font) {
    static mc := Map()
    if !font {
        mc.Clear()
        FFMElideMemo(0)          ; elided results are widths too - see FFMElide
        return 0
    }
    k := font "|" s
    if mc.Has(k)
        return mc[k]
    if mc.Count > 4000
        mc.Clear()
    return mc[k] := MeasureWRaw(s, font)
}
; ---- the layout rect is a CEILING, not scratch space ----
; This was 500 x 100, and GdipMeasureString clamps its result to the rect it is
; given: every string wider than 500 px measured as exactly 500. Nothing noticed
; for a long time because every column in the suite was narrower than that, so
; the clamp was never reached - until the community description asked to wrap at
; 504, one wider than the ceiling. MeasureW then answered "<= 504" for every
; string it was ever handed, WrapText never found a line too long, and whole
; paragraphs came back as single lines that ran off the card and were truncated
; mid-word by the draw.
;
; FFMElide binary-searches on this too, so it had the same blind spot above
; 500 px. 16384 is past any string this interface can produce and still well
; inside float precision.
MeasureWRaw(s, font) {
    lay := Buffer(16, 0), NumPut("float", 0, "float", 0, "float", 16384, "float", 4096, lay)
    out := Buffer(16, 0)
    DllCall("gdiplus\GdipMeasureString", "ptr", G, "wstr", s, "int", -1, "ptr", font, "ptr", lay, "ptr", fmtL, "ptr", out, "ptr", 0, "ptr", 0)
    return NumGet(out, 8, "float")
}
; per-character layout for the scramble/decode animation (prefix widths keep kerning exact)
BuildScr(text, font) {
    chs := [], xs := []
    loop Parse text {
        chs.Push(A_LoopField)
        xs.Push(A_Index = 1 ? 0.0 : MeasureW(SubStr(text, 1, A_Index - 1), font))
    }
    return {chs: chs, xs: xs, w: MeasureW(text, font)}
}
ElA(c) => hubOpacity >= 0.996 ? c : ((Round(((c >> 24) & 0xFF)*hubOpacity) & 0xFF) << 24) | (c & 0xFFFFFF)
VBrush(x, y, w, h, c1, c2) {
    ; LOW PERFORMANCE MODE: a flat fill. Safe to hand back a CACHED brush here
    ; because DelB only frees ones it does not own, so the caller's DelB is a
    ; no-op rather than a double free.
    if hubLowPerf
        return SBrush(c1)
    c1 := ElA(TH(c1)), c2 := ElA(TH(c2))
    if !((c1 | c2) & 0xFF000000)       ; both stops invisible - see PenP
        return 0
    static rc := Buffer(16)
    NumPut("float", x, "float", y - 1, "float", w, "float", h + 2, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c1, "uint", c2, "int", 1, "int", 3, "ptr*", &b := 0)
    if b
        brTemp[b] := 1
    return b
}
HBrush(x, y, w, h, c1, c2) {
    if hubLowPerf
        return SBrush(c1)
    c1 := ElA(TH(c1)), c2 := ElA(TH(c2))
    if !((c1 | c2) & 0xFF000000)       ; both stops invisible - see PenP
        return 0
    static rc := Buffer(16)
    NumPut("float", x - 1, "float", y, "float", w + 2, "float", h, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c1, "uint", c2, "int", 0, "int", 3, "ptr*", &b := 0)
    if b
        brTemp[b] := 1
    return b
}
; ---- inner panel texture ----
; The small surfaces - credits card, systems panels, dashboard tiles, module
; cards, preview panels - are all flat two-stop fills, which reads as dead
; space once the big backgrounds around them have depth.
;
; Deliberately lighter than PanelBackdrop and it clips ITSELF: these callers
; draw straight onto the card with no clip of their own, and a dozen of them
; render per frame, so there is no dot lattice and the hatch is coarse.
; ============================================================================
;  BACKDROPS - two designs, one per theme
; ----------------------------------------------------------------------------
;  The dark surfaces are lit FROM WITHIN: a dot lattice, a travelling diagonal
;  hatch, contour arcs and accent blooms, all built from low-alpha white. That
;  vocabulary cannot survive a light theme. THLight maps a low-alpha white to a
;  solid grey-blue at nearly three times the alpha, so every one of those
;  elements turns into a grey smear on a white face - and a glow means nothing
;  on paper anyway.
;
;  So light mode gets its OWN design rather than an inversion: engineering
;  paper. An orthogonal ruled grid with a heavier major rule every fourth line,
;  drawn in ink rather than light; corner tints and a drifting band in the
;  accent, which reads as a wash on white where a bloom would read as a smudge;
;  and soft edge shading instead of vignettes. The grid itself does not move -
;  print does not - so the motion lives in the accent instead.
;
;  Pure black is the one colour THLight passes through untouched, which is what
;  makes an ink-based vocabulary safe here. Accent colours survive it too.
;
;  Each pair is crossfaded on thT, so the theme animation carries the backdrop
;  across with it instead of cutting.
; ============================================================================
PanelBackdropLight(x, y, w, h, acc, f, now, k) {
    ; --- ruled grid: minor rules, with every fourth drawn heavier ---
    gp := 44
    pnMin := Pen(FA(Alpha(0x000000, Round(13*k)), f), 1)
    pnMaj := Pen(FA(Alpha(0x000000, Round(24*k)), f), 1)
    i := 0
    xx := x + gp/2
    while (xx < x + w) {
        Line(xx, y, xx, y + h, Mod(i, 4) ? pnMin : pnMaj)
        xx += gp, i += 1
    }
    i := 0
    yy := y + gp/2
    while (yy < y + h) {
        Line(x, yy, x + w, yy, Mod(i, 4) ? pnMin : pnMaj)
        yy += gp, i += 1
    }
    DelP(pnMin), DelP(pnMaj)

    ; --- registration ticks where the major rules cross ---
    ; the printed equivalent of the dark surface's lattice: something to read
    ; before you notice it, and the thing that stops the grid being just lines
    b := SBrush(FA(Alpha(0x000000, Round(30*k)), f))
    yy := y + gp/2
    while (yy < y + h) {
        xx := x + gp/2
        while (xx < x + w) {
            FillRR(xx - 2.6, yy - 0.5, 5.2, 1, 0.5, b)
            FillRR(xx - 0.5, yy - 2.6, 1, 5.2, 0.5, b)
            xx += gp*4
        }
        yy += gp*4
    }
    DelB(b)

    ; --- margin rule ---
    ; The single most recognisable thing about ruled paper, and the element
    ; that stops the grid reading as a spreadsheet. Doubled, in the accent
    ; rather than ink, so it belongs to the theme rather than to the grid.
    mgx := x + gp*1.5
    pn := Pen(FA(Alpha(acc, Round(70*k)), f), 1)
    Line(mgx, y, mgx, y + h, pn)
    Line(mgx + 3, y, mgx + 3, y + h, pn), DelP(pn)

    ; --- laid lines ---
    ; Real paper carries the mould's wire marks: fine lines close together
    ; across the sheet, much finer than the ruling and running the other way.
    ; This is what stops the grid reading as a screen and starts it reading as
    ; a page - it costs one pen and is the strongest single tell in the theme.
    lp := 6
    pn := Pen(FA(Alpha(0x000000, Round(5*k)), f), 1)
    yy := y + lp/2
    while (yy < y + h) {
        Line(x, yy, x + w, yy, pn)
        yy += lp
    }
    DelP(pn)

    ; --- deckle shading down the leading edge ---
    ; a sheet is never perfectly flat against what is under it
    b := HBrush(x, y, 26, h, FA(Alpha(0x000000, Round(26*k)), f), Alpha(0x000000, 0))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y, "float", 26, "float", h), DelB(b)
    b := VBrush(x, y, w, 18, FA(Alpha(0xFFFFFF, Round(70*k)), f), Alpha(0xFFFFFF, 0))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y, "float", w, "float", 18), DelB(b)

    ; --- crop marks ---
    ; Printer's registration, set in from the corners the way they sit outside
    ; a trimmed page. Ink, short, and quiet enough to find rather than notice.
    cm := 14, ins := 22
    pn := Pen(FA(Alpha(0x000000, Round(46*k)), f), 1)
    loop 4 {
        i  := A_Index
        cx := (i = 1 || i = 3) ? x + ins : x + w - ins
        cy := (i <= 2) ? y + ins : y + h - ins
        Line(cx - cm/2, cy, cx + cm/2, cy, pn)
        Line(cx, cy - cm/2, cx, cy + cm/2, pn)
    }
    DelP(pn)

    ; --- accent tints in opposite corners, breathing out of phase ---
    loop 3 {
        i := A_Index
        rB := 260 + i*110
        aB := (Sin(DecT(now)*0.00072 + i*0.9) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((15 - i*3)*k*(0.55 + 0.45*aB))), f))
        FillEll(x - rB*0.30, y - rB*0.42, rB, rB, b), DelB(b)
    }
    loop 2 {
        i := A_Index
        rB := 230 + i*100
        aB := (Sin(DecT(now)*0.00061 + 2.1 + i*0.9) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((13 - i*3)*k*(0.55 + 0.45*aB))), f))
        FillEll(x + w - rB*0.68, y + h - rB*0.56, rB, rB, b), DelB(b)
    }

    ; --- contour arcs, in ink so they read as drawn rather than lit ---
    loop 3 {
        i := A_Index
        rr := 190 + i*150
        ph := (Sin(DecT(now)*0.00055 + i*0.7) + 1)/2
        pn := Pen(FA(Alpha(acc, Round((26 - i*5)*k*(0.5 + 0.5*ph))), f), 1.2)
        Arc(x - rr*0.45, y - rr*0.5, rr*2, rr*2, 8, 74, pn), DelP(pn)
    }

    ; --- one slow band of accent drifting across, the only moving element ---
    dw2 := Sin(DecT(now)*0.00043)
    rcW := Buffer(16)
    NumPut("float", x - 120 + dw2*90, "float", y - 40, "float", w + 240, "float", h + 80, rcW)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcW
        , "uint", FA(Alpha(acc, 0), f), "uint", FA(Alpha(acc, Round(20*k)), f)
        , "int", 2, "int", 3, "ptr*", &wb := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", wb
        , "float", x, "float", y, "float", w, "float", h), DelB(wb)

    ; --- edge shading: far softer than the dark vignettes. Paper does not go
    ;     dark at its edges, it just stops catching the light. ---
    vw := Min(150, w*0.22)
    b := HBrush(x, y, vw, h, FA(Alpha(0x000000, Round(15*k)), f), Alpha(0x000000, 0))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y, "float", vw, "float", h), DelB(b)
    b := HBrush(x + w - vw, y, vw, h, Alpha(0x000000, 0), FA(Alpha(0x000000, Round(18*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x + w - vw, "float", y, "float", vw, "float", h), DelB(b)
    vh := Min(90, h*0.22)
    b := VBrush(x, y + h - vh, w, vh, Alpha(0x000000, 0), FA(Alpha(0x000000, Round(16*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h - vh, "float", w, "float", vh), DelB(b)
}
; ---- dispatchers ----
; k carries the theme weight, so a caller that dials the effect back gets it
; dialled back in both designs, and neither runs while it is invisible.
PanelBackdrop(x, y, w, h, acc, f, now, k := 1.0) {
    if hubLowPerf
        return                               ; LOW PERFORMANCE MODE: flat surfaces
    if ((dk := k*(1 - thT)) > 0.004)
        PanelBackdropDark(x, y, w, h, acc, f, now, dk)
    if ((lt := k*thT) > 0.004)
        PanelBackdropLight(x, y, w, h, acc, f, now, lt)
}
MiniBackdropLight(x, y, w, h, r, acc, f, now, k) {
    pM := RRPath(x, y, w, h, r)
    ; same contract as MiniBackdropDark: never disturb the caller's clip
    svM := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pM, "int", 1)

    ; finer rules than the panel: same paper, smaller sheet
    gp := 22
    pn := Pen(FA(Alpha(0x000000, Round(9*k)), f), 1)
    xx := x + gp/2
    while (xx < x + w) {
        Line(xx, y, xx, y + h, pn)
        xx += gp
    }
    yy := y + gp/2
    while (yy < y + h) {
        Line(x, yy, x + w, yy, pn)
        yy += gp
    }
    DelP(pn)

    ; a single accent tint in the top-left, breathing
    loop 2 {
        i := A_Index
        rB := Max(w, h)*(0.55 + i*0.28)
        aB := (Sin(DecT(now)*0.00078 + i*1.1) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((14 - i*5)*k*(0.5 + 0.5*aB))), f))
        FillEll(x - rB*0.22, y - rB*0.34, rB, rB, b), DelB(b)
    }
    ; hairline along the top edge and soft shading at the foot, so the card
    ; still reads as a raised sheet rather than a printed rectangle
    pn := Pen(FA(Alpha(0x000000, Round(22*k)), f), 1)
    Line(x + r, y + 0.5, x + w - r, y + 0.5, pn), DelP(pn)
    vg := Min(h*0.42, 30)
    b := VBrush(x, y + h - vg, w, vg, Alpha(0x000000, 0), FA(Alpha(0x000000, Round(20*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h - vg, "float", w, "float", vg), DelB(b)
    ; one contour tick, matching the dark card's
    rA := Max(w, h)*0.9
    ph := (Sin(DecT(now)*0.0006) + 1)/2
    pn := Pen(FA(Alpha(acc, Round(22*k*(0.5 + 0.5*ph))), f), 1.2)
    Arc(x - rA*0.35, y - rA*0.42, rA*2, rA*2, 10, 66, pn), DelP(pn)

    Pop(svM)
    DllCall("gdiplus\GdipDeletePath", "ptr", pM)
}
MiniBackdrop(x, y, w, h, r, acc, f, now, k := 1.0) {
    if hubLowPerf
        return                               ; LOW PERFORMANCE MODE: flat surfaces
    if (w < 24 || h < 16)
        return
    if ((dk := k*(1 - thT)) > 0.004)
        MiniBackdropDark(x, y, w, h, r, acc, f, now, dk)
    if ((lt := k*thT) > 0.004)
        MiniBackdropLight(x, y, w, h, r, acc, f, now, lt)
}
MiniBackdropDark(x, y, w, h, r, acc, f, now, k) {
    pM := RRPath(x, y, w, h, r)
    ; This runs INSIDE whatever clip the caller has already set - a scrolling
    ; list, a panel, a modal. It used to REPLACE that clip with its own box and
    ; then ResetClip, which wiped the caller's clip for the whole rest of the
    ; frame: every card in the placed list painted its title, avatar and chips
    ; straight over the panel chrome. Intersect and restore instead. (This is
    ; also why the bug vanished in performance mode - the whole function is
    ; skipped there, so the caller's clip survived.)
    svM := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pM, "int", 1)

    ; travelling hatch
    off := Mod(DecT(now)*0.005, 28)
    pn := Pen(FA(Alpha(0xFFFFFF, Round(9*k)), f), 1)
    kk := -Ceil(h/28)
    while (kk < Ceil(w/28) + 1) {
        gx := x + kk*28 + off
        Line(gx, y, gx + h, y + h, pn)
        kk += 1
    }
    DelP(pn)

    ; a single accent bloom in the top-left, breathing
    loop 2 {
        i := A_Index
        rB := Max(w, h)*(0.55 + i*0.28)
        aB := (Sin(DecT(now)*0.00078 + i*1.1) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((17 - i*6)*k*(0.5 + 0.5*aB))), f))
        FillEll(x - rB*0.22, y - rB*0.34, rB, rB, b), DelB(b)
    }
    ; and a cool counterweight in the far corner so it is lit from one side
    b := SBrush(FA(Alpha(acc, Round(7*k)), f))
    rC := Max(w, h)*0.7
    FillEll(x + w - rC*0.62, y + h - rC*0.55, rC, rC, b), DelB(b)

    ; top sheen and a floor shadow
    sh := Min(h*0.45, 26)
    b := VBrush(x, y, w, sh, FA(Alpha(0xFFFFFF, Round(16*k)), f), Alpha(0xFFFFFF, 0))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y, "float", w, "float", sh), DelB(b)
    vg := Min(h*0.42, 30)
    b := VBrush(x, y + h - vg, w, vg, Alpha(0x000000, 0), FA(Alpha(0x000000, Round(44*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h - vg, "float", w, "float", vg), DelB(b)

    ; one contour tick sweeping out of the corner
    rA := Max(w, h)*0.9
    ph := (Sin(DecT(now)*0.0006) + 1)/2
    pn := Pen(FA(Alpha(acc, Round(13*k*(0.5 + 0.5*ph))), f), 1.2)
    Arc(x - rA*0.35, y - rA*0.42, rA*2, rA*2, 10, 66, pn), DelP(pn)

    Pop(svM)
    DllCall("gdiplus\GdipDeletePath", "ptr", pM)
}

; ---- control-scale texture ----
; Third tier, under PanelBackdrop and MiniBackdrop. Same family - travelling
; hatch, one breathing bloom, a lit top edge - at roughly a third of the ops,
; because the things that use it are small and there are a lot of them: every
; button, field and bar in the suite draws one per frame. No dot lattice and no
; contour arc; at 24px neither resolves into anything, they only cost.
;
; Clips by INTERSECT inside a saved graphics state rather than
; SetClipPath/ResetClip. Fields and buttons are routinely drawn inside a
; panel's clip, and resetting would wipe it - letting the control and
; everything after it spill outside the panel. This is the same reason FFMBtn's
; shine sweep saves and restores, and it is what makes this safe to drop into
; shared primitives whose callers it cannot see.
MicroBackdrop(x, y, w, h, r, acc, f, now, k := 1.0) {
    if hubLowPerf
        return                               ; LOW PERFORMANCE MODE: flat surfaces
    if (w < 20 || h < 8 || f <= 0.02)
        return
    p := RRPath(x, y, w, h, r)
    sv := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 1)

    ; Pitch follows the height so a 10px bar still gets more than a couple of
    ; strokes across it, with a floor so a wide short control is not filled
    ; edge to edge with near-vertical lines.
    ; The white elements fade out in light mode. THLight maps a low-alpha white
    ; to a solid grey-blue (0x9BA3B4, alpha x2.7), so leaving them in paints a
    ; dirty hatch across every light-theme control - the same reason FFMBtn's
    ; gloss band and top-edge shimmer are scaled by (1 - thT). The accent bloom
    ; and the floor shadow stay: an accent is a real colour, and pure black is
    ; the one value THLight passes through untouched.
    dk := k*(1 - thT)                            ; lit from within
    lt := k*thT                                  ; printed
    ; DARK: a travelling diagonal hatch in light. Pitch follows the height so a
    ; 10px bar still gets more than a couple of strokes across it, with a floor
    ; so a wide short control is not filled edge to edge with near-vertical
    ; lines. None of this can carry into the light theme - THLight maps a
    ; low-alpha white to a solid grey-blue at nearly three times the alpha, so
    ; it would read as dirt on every light-theme control.
    if (Round(8*dk) >= 1) {
        gp := Max(12, Min(18, h*0.8))
        off := Mod(DecT(now)*0.004, gp)
        pn := Pen(FA(Alpha(0xFFFFFF, Round(8*dk)), f), 1)
        ; The hatch is fifteen to twenty DrawLine calls per control and there
        ; are sixty-three of these on a full panel. Pen() answers 0 once the
        ; fade has taken the colour below one unit of alpha, and the loop is
        ; then twenty calls that draw nothing - so ask first.
        kk := pn ? -Ceil(h/gp) : Ceil(w/gp) + 1
        while (kk < Ceil(w/gp) + 1) {
            gx := x + kk*gp + off
            Line(gx, y, gx + h, y + h, pn)
            kk += 1
        }
        DelP(pn)
    }
    ; LIGHT: static vertical rules in ink, the panel's engineering paper cut
    ; down to control scale. Upright rather than diagonal, and still rather
    ; than travelling - the same distinction the big surfaces draw.
    if (Round(7*lt) >= 1) {
        gp2 := Max(14, Min(22, w/5))
        pn := Pen(FA(Alpha(0x000000, Round(7*lt)), f), 1)
        xx := pn ? x + gp2/2 : x + w
        while (xx < x + w) {
            Line(xx, y, xx, y + h, pn)
            xx += gp2
        }
        DelP(pn)
    }

    ; the accent tint belongs to both: a bloom on a dark face, a wash on paper
    rB := Max(w, h)*0.8
    aB := (Sin(DecT(now)*0.0009) + 1)/2
    b := SBrush(FA(Alpha(acc, Round(14*k*(0.5 + 0.5*aB))), f))
    FillEll(x - rB*0.20, y - rB*0.35, rB, rB, b), DelB(b)

    sh := Min(h*0.5, 12)
    if (Round(14*dk) >= 1) {
        b := VBrush(x, y, w, sh, FA(Alpha(0xFFFFFF, Round(14*dk)), f), Alpha(0xFFFFFF, 0))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
            , "float", x, "float", y, "float", w, "float", sh), DelB(b)
    }
    ; on paper the top edge is a drawn hairline, not a sheen
    if (Round(20*lt) >= 1) {
        pn := Pen(FA(Alpha(0x000000, Round(20*lt)), f), 1)
        Line(x + r, y + 0.5, x + w - r, y + 0.5, pn), DelP(pn)
    }
    ; black is the one value THLight passes through untouched, so the floor
    ; shading is the one element both designs share verbatim
    vg := Min(h*0.45, 12)
    b := VBrush(x, y + h - vg, w, vg, Alpha(0x000000, 0)
              , FA(Alpha(0x000000, Round(34*dk + 18*lt)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h - vg, "float", w, "float", vg), DelB(b)

    DllCall("gdiplus\GdipRestoreGraphics", "ptr", G, "uint", sv)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)
}

; ---- shared panel backdrop ----
; Every big surface in the suite - the hub card, the three overlays, the gate,
; the loading card and the gallery - sits on the same BgV gradient, which on
; its own reads as empty space. This layers depth onto it from ONE place so
; they cannot drift apart, and so raising the intensity raises it everywhere.
;
; The caller must already have clipped to its own rounded rect: everything here
; deliberately overhangs so you see falloff rather than shapes.
;   k scales the whole effect - smaller panels want it dialled back.
PanelBackdropDark(x, y, w, h, acc, f, now, k) {
    ; --- dot lattice: a technical surface you read before you notice ---
    ; One brush for the whole grid. Per-dot brushes would be ~300 GDI+
    ; create/delete pairs a frame; size is free, so the wave rides that.
    gp := 44
    wv := now*0.0016
    b := SBrush(FA(Alpha(0xFFFFFF, Round(22*k)), f))
    yy := y + gp/2
    while (yy < y + h) {
        xx := x + gp/2
        while (xx < x + w) {
            dr := 0.85 + 0.75*(Sin(wv + (xx - x)*0.012 + (yy - y)*0.017) + 1)/2
            FillEll(xx - dr, yy - dr, dr*2, dr*2, b)
            xx += gp
        }
        yy += gp
    }
    DelB(b)

    ; --- twin hatch: one travelling, one static and finer, giving a weave ---
    off := Mod(DecT(now)*0.007, 38)
    pn := Pen(FA(Alpha(0xFFFFFF, Round(11*k)), f), 1)
    kk := -Ceil(h/38)
    while (kk < Ceil(w/38) + 1) {
        gx := x + kk*38 + off
        Line(gx, y, gx + h, y + h, pn)
        kk += 1
    }
    DelP(pn)
    pn := Pen(FA(Alpha(acc, Round(9*k)), f), 1)
    kk := -Ceil(h/76)
    while (kk < Ceil(w/76) + 1) {
        gx := x + kk*76 - off*0.6
        Line(gx + h, y, gx, y + h, pn)          ; opposite diagonal
        kk += 1
    }
    DelP(pn)

    ; --- contour arcs sweeping out of the top-left ---
    loop 4 {
        i := A_Index
        rr := 150 + i*130
        ph := (Sin(DecT(now)*0.00055 + i*0.7) + 1)/2
        pn := Pen(FA(Alpha(acc, Round((16 - i*2)*k*(0.5 + 0.5*ph))), f), 1.3)
        Arc(x - rr*0.45, y - rr*0.5, rr*2, rr*2, 8, 74, pn), DelP(pn)
    }

    ; --- accent blooms, breathing out of phase so it never pulses in time ---
    loop 3 {
        i := A_Index
        rB := 230 + i*100
        aB := (Sin(DecT(now)*0.00072 + i*0.9) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((20 - i*4)*k*(0.55 + 0.45*aB))), f))
        FillEll(x - rB*0.26, y - rB*0.40, rB, rB, b), DelB(b)
    }
    loop 3 {
        i := A_Index
        rB := 210 + i*90
        aB := (Sin(DecT(now)*0.00061 + 2.1 + i*0.9) + 1)/2
        b := SBrush(FA(Alpha(acc, Round((17 - i*4)*k*(0.55 + 0.45*aB))), f))
        FillEll(x + w - rB*0.70, y + h - rB*0.58, rB, rB, b), DelB(b)
    }

    ; --- accent wash drifting along the diagonal ---
    dw2 := Sin(DecT(now)*0.00043)
    rcW := Buffer(16)
    NumPut("float", x - 120 + dw2*90, "float", y - 40, "float", w + 240, "float", h + 80, rcW)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcW
        , "uint", FA(Alpha(acc, 0), f), "uint", FA(Alpha(acc, Round(26*k)), f)
        , "int", 2, "int", 3, "ptr*", &wb := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", wb
        , "float", x, "float", y, "float", w, "float", h), DelB(wb)

    ; --- edge vignettes so the fill stops reading as a flat rectangle ---
    vw := Min(150, w*0.22)
    b := HBrush(x, y, vw, h, FA(Alpha(0x000000, Round(46*k)), f), Alpha(0x000000, 0))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y, "float", vw, "float", h), DelB(b)
    b := HBrush(x + w - vw, y, vw, h, Alpha(0x000000, 0), FA(Alpha(0x000000, Round(52*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x + w - vw, "float", y, "float", vw, "float", h), DelB(b)
    b := VBrush(x, y + h - Min(90, h*0.22), w, Min(90, h*0.22)
              , Alpha(0x000000, 0), FA(Alpha(0x000000, Round(40*k)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
        , "float", x, "float", y + h - Min(90, h*0.22), "float", w, "float", Min(90, h*0.22)), DelB(b)
}

; ---- is anything being dragged? ----
; The one class of work the UI thread cannot make cheap is the work that
; blocks it for tens of milliseconds at a stretch: creating a child process
; (CreateProcess of the interpreter, longer with real-time antivirus on it)
; and decoding an image from disk (a 768x432 thumbnail is 10-40 ms; a slow
; disk or a scanner doubles it). Under a drag every one of those is the card
; stopping under the pointer and then leaping to wherever the pointer went -
; the "teleport" that shows on the launch gate, because that is the window on
; screen while the boot queues (place stats, icons, every game's thumbnail
; reel) are still draining. The pumps ask this before each spawn or decode
; and wait a tick when it says so; nothing they fetch is needed mid-drag.
DragBusy() => gateDrag || (IsObject(HL) && HL.drag) || dragOn
           || (IsObject(PZO) && PZO.HasOwnProp("dragOn") && PZO.dragOn)

; ---- a soft radial glow ----
; GDI+ path gradients are expensive to build every frame; n rings of the same
; colour at a_total/n each, shrinking toward the centre, read as a radial
; glow from arm's length and cost n ellipse fills. The centre reaches a_total.
; LOW PERFORMANCE MODE: no glows - six fills a piece, pure decoration.
SoftGlow(cx, cy, rx, ry, col, a_total, f := 1.0, n := 6) {
    if hubLowPerf
        return
    loop n {
        sc := 1 - (A_Index - 1)/n
        b := SBrush(FA(Alpha(col, Round(a_total/n)), f))
        FillEll(cx - rx*sc, cy - ry*sc, rx*sc*2, ry*sc*2, b), DelB(b)
    }
}
BgV(x, y, w, h, c1, c2) {
    ; every card background goes through here - flat in low-perf like the rest
    if hubLowPerf
        return SBrushP(ElA(TH(BgScale(c1))))
    c1 := TH(BgScale(c1)), c2 := TH(BgScale(c2))
    static rc := Buffer(16)
    NumPut("float", x, "float", y - 1, "float", w, "float", h + 2, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c1, "uint", c2, "int", 1, "int", 3, "ptr*", &b := 0)
    return b
}
; ---- solid brush cache ----
; SBrush is the hottest primitive in the renderer (416 call sites, several
; inside per-frame loops) and every call used to be a GdipCreateSolidFill plus
; a GdipDeleteBrush - two DllCalls and two GDI+ heap operations for one fill.
; Solid brushes are immutable here: nothing in the file calls
; GdipSetSolidFillColor, so a handle can be handed out repeatedly. Keyed on the
; FINAL colour, after TH() and ElA(), so theme and opacity still apply normally.
; Pens ARE cached, and the objection that stopped it before is answered rather
; than ignored: 41 sites mutate a pen after creation, and every mutation in the
; file sets one of exactly two things - GdipSetPenDashStyle and
; GdipSetPenDashOffset. Nothing touches caps, joins, alignment or width. So a
; cached pen carries one piece of state forward and PenP clears it on fetch:
; two property sets against a GDI+ object ALLOCATION plus a free, which is not
; a close contest. Around five hundred create/delete pairs a frame become five
; hundred map lookups.
; brCache/brOwn are declared up top with shadowCache: top-level assignments run
; in source order, and PasswordGate/LoadingScreen draw long before this point.
SBrush(c) => SBrushP(TH(c))
; ---- theme-preserving gradients and pens ----
; Twins of VBrush / HBrush / Pen that skip TH. The community banner is artwork,
; not chrome: it is gold on black in both themes, and running it through the
; light mapping would turn the black plate white and the gold to ink. Opacity
; still applies, so the panel fades with everything else.
VBrushP(x, y, w, h, c1, c2) {
    c1 := ElA(c1), c2 := ElA(c2)
    static rc := Buffer(16)
    NumPut("float", x, "float", y - 1, "float", w, "float", h + 2, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c1, "uint", c2, "int", 1, "int", 3, "ptr*", &b := 0)
    if b
        brTemp[b] := 1
    return b
}
HBrushP(x, y, w, h, c1, c2) {
    c1 := ElA(c1), c2 := ElA(c2)
    static rc := Buffer(16)
    NumPut("float", x - 1, "float", y, "float", w + 2, "float", h, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c1, "uint", c2, "int", 0, "int", 3, "ptr*", &b := 0)
    if b
        brTemp[b] := 1
    return b
}
PenP(c, w) {
    global penCache, penOwn
    k := ElA(c)
    ; Nothing invisible reaches the rasteriser. A pen at zero alpha still walks
    ; its geometry and still costs the whole call - and during a fade EVERY
    ; element sits at zero for a frame or two. Handing back 0 and letting the
    ; draw primitives skip it is the difference between a transition costing a
    ; full frame and costing nothing.
    if !(k & 0xFF000000)
        return 0
    ; Colour is 32 bits and width is small, so pack them. A string key would be
    ; an allocation per fetch, which is the thing this exists to remove.
    ky := k*4096 + Round(w*64)
    if penCache.Has(ky) {
        p := penCache[ky]
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", p, "int", 0)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", p, "float", 0)
        return p
    }
    DllCall("gdiplus\GdipCreatePen1", "uint", k, "float", w, "int", 2, "ptr*", &p := 0)
    penCache[ky] := p, penOwn[p] := 1
    return p
}
SBrushP(c) {
    global brCache, brOwn
    k := ElA(c)
    if !(k & 0xFF000000)               ; fully transparent - see PenP
        return 0
    if brCache.Has(k)
        return brCache[k]
    DllCall("gdiplus\GdipCreateSolidFill", "uint", k, "ptr*", &b := 0)
    ; A creation that failed used to be cached as 0, and 0 is what every
    ; later caller got for that colour - a colour that never drew again for
    ; the life of the process. Not cached: the next caller tries again.
    if !b
        return 0
    brCache[k] := b, brOwn[b] := 1
    return b
}
; Alpha ramps and theme crossfades mint new colours every frame, so the cache is
; bounded rather than allowed to grow for the life of the process. Called only
; at the top of a render pass: flushing mid-frame could free a handle a caller
; is still holding between its SBrush and its DelB.
BrushCacheTick() {
    global brCache, brOwn, brDead
    if brCache.Count < 4096
        return
    prevC := A_IsCritical
    Critical "On"                      ; not interleaved with another window's frame - see brTemp
    dead := Map()
    for k, b in brCache {
        DllCall("gdiplus\GdipDeleteBrush", "ptr", b)
        dead[b] := 1
    }
    brCache := Map(), brOwn := Map(), brDead := dead
    Critical prevC
}
; Gradient brushes are still per-use and must still be freed; cached solid
; brushes must not be.
DelB(b) {
    global brTemp, brOwn, brDead
    if !b
        return
    if brTemp.Has(b) {                 ; a registered gradient: the caller's to free
        brTemp.Delete(b)
        DllCall("gdiplus\GdipDeleteBrush", "ptr", b)
        return
    }
    ; a gradient made directly at its site (the sweeps, the sheens): free it
    ; unless it is a cached brush, or a handle the last flush already freed
    if (!brOwn.Has(b) && !brDead.Has(b))
        DllCall("gdiplus\GdipDeleteBrush", "ptr", b)
}
Pen(c, w) => PenP(TH(c), w)
; Cached pens must not be freed, and 0 is not a handle.
DelP(p) {
    global penOwn
    if (p && !penOwn.Has(p))
        DllCall("gdiplus\GdipDeletePen", "ptr", p)
}
; Same bound as the brushes, and for the same reason: alpha ramps and theme
; crossfades mint new colours every frame. Called only where BrushCacheTick is.
PenCacheTick() {
    global penCache, penOwn
    if penCache.Count < 2048
        return
    for k, p in penCache
        DllCall("gdiplus\GdipDeletePen", "ptr", p)
    penCache := Map(), penOwn := Map()
}
; ---- LOW PERFORMANCE MODE: a frozen clock for decoration ----
; Every ambient movement in this file is a phase built from the frame clock -
; Sin(DecT(now)*k + off), Mod(DecT(now)*k, 360), Mod(DecT(now), cycle). Feeding those a constant
; freezes all of them at once, in one place, instead of guarding a hundred and
; thirty draw sites by hand. The real `now` is untouched, so timeouts, elapsed
; checks and "flash for 400 ms" logic keep working exactly as before - only the
; things that were merely wobbling stop.
DecT(t) => hubLowPerf ? 0 : t

; ---- LOW PERFORMANCE MODE: transitions arrive instead of gliding ----
; Every eased value in the hub is x += (target - x)*k. Forcing k to 1 lands
; it on its target in a single frame: the panel still opens, the toggle
; still flips, the scroll still moves - they simply do not travel to get
; there. This also lets the busy predicate settle immediately, which is
; what actually drops the renderer to its idle rate.
; LOW PERFORMANCE MODE: eased values snap to their target in one step instead
; of easing, so no transition holds the renderer at the fast tier to finish.
EK(k) => hubLowPerf ? 1.0 : k


RRPath(x, y, w, h, r) {
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &p := 0)
    return RRInto(p, x, y, w, h, r)
}
; The geometry, split out so it can be added to a path somebody else owns.
RRInto(p, x, y, w, h, r) {
    ; A radius wider than half the box puts the BOTTOM arcs above the TOP ones,
    ; producing a self-crossing figure. Filled it just looks wrong; used as a
    ; CLIP it is unusable, and GdipSetClipPath then fails and silently leaves
    ; the previous clip in place - which is how a short list panel ended up
    ; painting its cards over the rest of the hub. Clamp rather than trust.
    w := Max(w, 0.0), h := Max(h, 0.0)
    ; clips still need a path, but a rectangle one is a single call instead
    ; of four arcs - and nothing is rounded in this mode anyway
    r := hubLowPerf ? 0.0 : Min(r, w/2, h/2)
    if (r <= 0.01) {
        DllCall("gdiplus\GdipAddPathRectangle", "ptr", p, "float", x, "float", y, "float", w, "float", h)
        return p
    }
    d := r*2
    DllCall("gdiplus\GdipAddPathArc", "ptr", p, "float", x, "float", y, "float", d, "float", d, "float", 180, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", p, "float", x + w - d, "float", y, "float", d, "float", d, "float", 270, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", p, "float", x + w - d, "float", y + h - d, "float", d, "float", d, "float", 0, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", p, "float", x, "float", y + h - d, "float", d, "float", d, "float", 90, "float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "ptr", p)
    return p
}
; LOW PERFORMANCE MODE: square corners.
; A rounded rect is not one draw call - it builds a path, adds four arcs,
; fills it and frees it: five GDI+ round trips and an allocation for every
; box on screen, hundreds of them per frame. Squared corners collapse each
; one to a single GdipFillRectangle with no allocation at all. It is the
; least subtle thing in this mode and the biggest single saving in it.
; ---- ONE path, reused ----
; These two are the highest-volume calls in the renderer by a wide margin, and
; each was creating a GDI+ path object, adding four arcs, drawing it and freeing
; it again: an allocate/free pair per box, hundreds of boxes a frame. A single
; scratch path, reset in place, removes both halves of that pair.
;
; Safe as ONE object rather than a pool because neither can be re-entered: each
; builds, draws and is finished before it returns, and nothing it calls draws a
; rounded rect. The 60 clip paths elsewhere still create and free their own -
; those are held across other drawing, which is precisely the case a shared
; scratch could not survive.
RRScratch(x, y, w, h, r) {
    global rrScratchP
    if !rrScratchP
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &rrScratchP := 0)
    else
        DllCall("gdiplus\GdipResetPath", "ptr", rrScratchP)
    return RRInto(rrScratchP, x, y, w, h, r)
}
FillRR(x, y, w, h, r, brush) {
    if !brush                          ; invisible - see PenP
        return
    if hubLowPerf {
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", brush
              , "float", x, "float", y, "float", w, "float", h)
        return
    }
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", brush, "ptr", RRScratch(x, y, w, h, r))
}
StrokeRR(x, y, w, h, r, pen) {
    if !pen
        return
    if hubLowPerf {
        DllCall("gdiplus\GdipDrawRectangle", "ptr", G, "ptr", pen
              , "float", x, "float", y, "float", w, "float", h)
        return
    }
    DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pen, "ptr", RRScratch(x, y, w, h, r))
}
FillEll(x, y, w, h, brush) => brush ? DllCall("gdiplus\GdipFillEllipse", "ptr", G, "ptr", brush, "float", x, "float", y, "float", w, "float", h) : 0
; ---- point at normalised position t along a rect's perimeter ----
; Shared by the minimised orb's glint head, its comet trail and the counter-
; travelling spark, so they all ride the exact same path. t wraps, and negative
; values are normalised so a trail can lag behind the head across the seam.
RectPerim(t, x0, y0, w, h, &px, &py) {
    d := Mod(Mod(t, 1.0) + 1.0, 1.0)*2*(w + h)
    if (d < w)
        px := x0 + d, py := y0
    else if (d < w + h)
        px := x0 + w, py := y0 + (d - w)
    else if (d < 2*w + h)
        px := x0 + w - (d - w - h), py := y0 + h
    else
        px := x0, py := y0 + h - (d - 2*w - h)
}
Ell(x, y, w, h, pen) => pen ? DllCall("gdiplus\GdipDrawEllipse", "ptr", G, "ptr", pen, "float", x, "float", y, "float", w, "float", h) : 0
Arc(x, y, w, h, a1, a2, pen) => pen ? DllCall("gdiplus\GdipDrawArc", "ptr", G, "ptr", pen, "float", x, "float", y, "float", w, "float", h, "float", a1, "float", a2) : 0
Line(x1, y1, x2, y2, pen) => pen ? DllCall("gdiplus\GdipDrawLine", "ptr", G, "ptr", pen, "float", x1, "float", y1, "float", x2, "float", y2) : 0
; Text is the most expensive single thing GDI+ does in this renderer, and this
; was paying for an allocation on every call just to describe a rectangle. One
; static buffer instead - safe because the DllCall completes before the function
; returns, so nothing can be looking at it in between. The two early exits are
; worth more than they look: an empty string still goes through layout, and a
; glyph run at zero alpha still rasterises every glyph before discarding it.
Txt(s, x, y, w, h, font, c, fmt) {
    static rc := Buffer(16)
    global brCache, brOwn
    if (s = "")
        return
    if !(b := SBrush(c))
        return
    NumPut("float", x, "float", y, "float", w, "float", h, rc)
    st := DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", s, "int", -1, "ptr", font, "ptr", rc, "ptr", fmt, "ptr", b)
    if (st) {
        ; ---- the draw was refused ----
        ; The one repairable cause is a cached brush handle that is no longer
        ; a brush: the cache entry for this colour is dropped and the string
        ; drawn once more with a fresh one.
        k := ElA(TH(c))
        if (brCache.Has(k) && brCache[k] = b) {
            brCache.Delete(k)
            if brOwn.Has(b)
                brOwn.Delete(b)
            if (b2 := SBrush(c))
                DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", s, "int", -1, "ptr", font, "ptr", rc, "ptr", fmt, "ptr", b2)
        }
        return
    }
    DelB(b)
}

; ============================================================================
;  PUZZLE AI  -  7x7 connect-the-dots auto-solver (module)
; ----------------------------------------------------------------------------
;  Ported from dots_solver.ahk. Every identifier carries a Puz / PZ_ prefix so
;  nothing collides with the suite (IniPath in particular already exists here,
;  and AHK identifiers are case-insensitive).
;
;  One straight pass per press: read the board, solve it in memory, then draw
;  every line. No verification, no retries, no repairs - the timing constants
;  below are what make it reliable, and they are expressed in GAME FRAMES so
;  PZ_FrameMs is the single speed knob.
;
;  The grid is four stored numbers, defaulting to the measured 1920x1080 board
;  and re-set by the card's SET GRID button (two clicks on opposite corners of
;  the board). Solve speed comes from the card's slider: it sets the assumed
;  frame budget, and every dwell in the module derives from that one number.
; ============================================================================
; ---- the grid's SIZE, now a setting ----
; This was a function over a literal, carrying a note saying nothing could ever
; write it. That was the right shape while there was one board to solve; the
; card picks between four now.
;
; The guarantee that note was protecting is kept where it actually matters. The
; size is still not a loose global any line can assign - it is an INDEX into a
; fixed list, moved only by PuzGridNSet, which is also the one place that bumps
; PZ_gridGen. That pairing is not cosmetic: PZ_gridGen is what PuzPX and PuzPY
; key their cached column tables on, so a size changed without the bump is a
; board still being read at the old pitch, silently. Setter and bump cannot be
; separated because they are the same function.
global PZ_SIZES  := [6, 7, 10, 25]
global PZ_gridNi := 2                    ; index into PZ_SIZES; 2 = 7x7, the default
PZ_GridN() => PZ_SIZES[PZ_gridNi]
PZ_GridLabel() => PZ_GridN() "x" PZ_GridN()
global PZ_SampleOffset := 0.22   ; fraction of a cell sampled off-center (clears the digit)
global PZ_BrightThresh := 70     ; max(R,G,B) above this = a dot is present
global PZ_PairTol := 60          ; RGB distance under this = same pair colour

; --- drawing pace ---
; THE MODEL, as four experiments established it. The game observes the cursor
; ONCE PER RENDERED FRAME - Windows coalesces WM_MOUSEMOVE to one per message
; pump and the client pumps once per frame, taking the latest position. On each
; observation, if the cursor sits in a cell ORTHOGONALLY ADJACENT to the current
; tip, the tip extends one cell. Otherwise nothing happens, and nothing ever
; recovers it.
;
; What proved it:
;   slider to 0%          failures vanish        -> it is a time budget
;   client capped 60 FPS  sharply worse          -> observation is frame-driven
;   tail frames zeroed    no worse               -> standing still does NOTHING
;   PZ_CellFrames 1.0->2  failures drop          -> cells were being skipped
;
; The third result is the important one. Thirty-odd ms of stationary hold is
; seven to eighteen frames at 200-500 FPS; if the tip chased a remembered cursor
; position it would close any gap in two. It closed nothing, so the tip is not
; chasing - it is waiting to be handed an adjacency it can no longer be handed,
; because a cursor two cells ahead is not adjacent to anything.
;
; Two consequences run through every number below. Time spent NOT MOVING buys no
; observation, so the drag never stops between the press and the end dot - it
; crosses each cell over that cell's whole budget (see PuzCellGlide). And a cell
; that goes unobserved is lost permanently, so every cell gets its own budget
; rather than a share of one cumulative schedule (see PuzDrawPath).
global PZ_FrameMs := 17          ; assumed game frame (60 FPS) - the unit for everything below
global PZ_CellFrames := 1.5      ; budget per cell of the walk. This is an ASSUMED frame count
                                 ; against an ASSUMED frame period, so 1.0 - one assumed frame
                                 ; for one cell - carried no margin at all for the assumption
                                 ; being wrong, and it is wrong constantly: 200-500 FPS is a
                                 ; 2.5x swing in the real period, and drawing is itself a
                                 ; frame-cost spike in the client. 1.5 is the headroom.
global PZ_StartFrames := 1.1     ; in-cell time on the start dot before pressing
global PZ_PressFrames := 1.0     ; hold on the start dot after pressing, before moving
global PZ_CornerFrames := 2.0    ; budget in a corner cell, so the turn is observed in the
                                 ; corner itself. Must stay above PZ_CellFrames or a corner
                                 ; is the cheapest cell on the path instead of the dearest.
global PZ_EndFrames := 0.75      ; hold on the end dot before releasing.
global PZ_SlackFrames := 0.25    ; margin on that hold. One frame between the two, and that
                                 ; is all this needs: the end cell already got a full
                                 ; PZ_CellFrames crossing inside the walk, so what is left to
                                 ; buy here is the LAST extension being observed before the
                                 ; button lifts - one frame, by definition. It was 3.3 frames
                                 ; of sleep originally, on the theory that a short line could
                                 ; be pulled home by waiting; it cannot, and that theory is
                                 ; what the fourth experiment killed.
global PZ_LagFrames := 1.0       ; frames the game takes to REGISTER the grab before the line
                                 ; starts growing. Paid at the PRESS, not at the release: a
                                 ; debt incurred before the first cell was being settled after
                                 ; the last one, which is both too late to help and in a
                                 ; currency (elapsed time) the game does not accept.
                                 ;
                                 ; The 2.0 this inherited was never measured - it came from the
                                 ; old tail, where it demonstrably did nothing, so nothing
                                 ; about it was ever tested at the press either. 1.0 is the
                                 ; smallest value that still means anything under the
                                 ; observation model: one frame for the client to see the
                                 ; button down before the cursor leaves the start cell. If
                                 ; whole lines start going missing again rather than finishing
                                 ; short, this is the number that did it.
global PZ_CellDwell := 0.0       ; fraction of each cell's budget spent STATIONARY at the
                                 ; centre; the rest is spent travelling. 0 means the cursor
                                 ; never stops between the press and the end dot.
                                 ;
                                 ; The observation model does not ask for a stop. It asks that
                                 ; no cell be crossed entirely between two consecutive frames.
                                 ; Moving through a cell over its whole budget satisfies that
                                 ; as well as parking in the middle of it does - the cursor is
                                 ; SOMEWHERE in that cell for the same length of time either
                                 ; way - and it removes the hop-stop-hop march, which is
                                 ; visible, unpleasant, and bought nothing.
                                 ;
                                 ; Raise this only if the client turns out to hit-test a
                                 ; smaller box around the cell centre rather than the whole
                                 ; cell. 0.3 would put a third of each cell's time on the
                                 ; centre pixel and still travel the rest.
global PZ_TailBackCells := 0     ; how far the tail walk retreats back down the path before
                                 ; returning to the end dot, re-feeding adjacency to a tip
                                 ; that stalled short (see PuzTailRecover).
                                 ;
                                 ; OFF by default, and it should stay off unless failures come
                                 ; back. It is a repair that has to run on every line to catch
                                 ; the few that need it: the cursor visibly reverses and the
                                 ; last cells of a finished line are retracted and redrawn, on
                                 ; every pair, for a fault the per-cell budget above already
                                 ; prevents. Wrong trade at 100% incidence. 2 covers every
                                 ; shortfall observed so far if it is ever needed again.
global PZ_ApproachSpeed := 160.0 ; px/ms travelling BETWEEN lines. Nothing is drawn there and
                                 ; the button is up, so no cell has to be observed and no
                                 ; budget applies - this leg is pure overhead and the only
                                 ; reason it was ever slow is that it shared a helper with the
                                 ; drag. PuzApproachDot still settles and jiggles on arrival,
                                 ; so hover on the start dot is re-established before the press
                                 ; regardless of how fast the cursor got there.
global PZ_JigglePx := 2          ; in-cell nudge that forces the game to recompute hover
global PZ_JiggleDwell := 5       ; ms between the nudge and the return to centre
global PZ_BetweenPaths := 0      ; travel + start hover already separate release from press
global PZ_FrameInterval := 1     ; ms between injected cursor positions
; ---- keeping the SCRIPT answerable while the walk runs ----
; Windows ghosts a top-level window whose owning thread has not touched its
; message queue for about five seconds. See PuzAlive and PuzUiBreath: one keeps
; the queue touched, the other lets the hub actually draw. Both are clocks, so a
; small board pays nothing.
global PZ_AliveMs  := 250        ; how often the walk touches the message queue
global PZ_BreathMs := 200        ; how often a real yield is taken between lines
; ---- our own input, marked as ours ----
; AutoHotkey stamps everything IT sends with this value in dwExtraInfo and its
; hooks skip anything carrying it. PuzSendMouseInput bypasses Send entirely - it
; is a raw SendInput - so without the stamp our own drag arrives at our own mouse
; hook looking exactly like a real click, and AUTOBLOCK's `*LButton::` (no ~, so
; it CONSUMES) is a live candidate for it: Roblox is focused by PuzCtxSolve's own
; requirement and a cursor on the board is not a hit zone. That is the press of
; every line being eaten, plus a {q down} fired into the game per pair.
;
; Worse, PuzDrawPath holds Critical, so the hook cannot get the #HotIf criterion
; evaluated at all - the stall PuzCalStart already documents - and past the hook
; timeout the press instead lands late by an unbounded amount, on the one event
; PZ_LagFrames budgets in single-figure milliseconds.
;
; Stamped, none of that happens: the hook drops the event before it looks for a
; hotkey, so there is no evaluation, no suppression and no stall. This is an
; AutoHotkey internal constant rather than a documented API - stable across v1
; and v2, but if a future build changes it the !PZ_solving guard on the hotkey
; context is the second line of defence and the symptom is lines going missing.
global PZ_SelfMark := 0xFFC3D44F
; ---- settle times ----
; A window told to hide does not leave the COMPOSITED desktop in the frame
; ShowWindow returns, and BitBlt reads that composite - so a capture taken
; immediately after hiding something still contains it. Both of these are
; display frames, deliberately not derived from PZ_FrameMs: that number is a
; claim about the CLIENT's frame rate and is 5 ms at the top of the slider,
; which is under one compositor frame at any refresh rate.
global PZ_SettleMs := 40         ; after hiding our own windows, once per session
global PZ_ScanSettle := 24       ; after parking the cursor, before a scan - the
                                 ; hover highlight it leaves behind needs to clear

; ---- board geometry ----
global PZ_caps   := Map()        ; cached capture DIBs, keyed by region size
global PZ_CapsMax := 24          ; and never more than this many - see PuzCaptureRegion
global PZ_iter   := 0            ; DFS node budget guard
; The ceiling is a RUNAWAY guard, not a working limit - PuzRemainingReachable
; prunes hard enough that a solvable board finishes far under it. It still has
; to move with the grid: 2,000,000 was chosen against 36 cells, and 49 cells is
; a wider tree at every depth, so a flat ceiling would start failing 7x7 boards
; that are merely large rather than unsolvable. Scaled by cell count, so the
; ratio that was tuned is the ratio that carries over.
;
; Resolved once per solve into PZ_iterCap rather than called per node. PuzDFS
; recurses once per cell of every path it tries and this is its first line;
; the hoisting note on `n` just below it applies here for the same reason.
PZ_IterMax() => 2000000 * PZ_GridN()**2 // 36
global PZ_iterCap := 0           ; PZ_IterMax() for the solve in flight
; ---- and a WALL CLOCK, because the node cap is not a time bound ----
; A node budget scaled to 34 million says nothing about how long 34 million
; interpreted nodes take. Measured on generated 25x25 boards, four in five solve
; inside a couple of thousand nodes and the fifth runs past three million - so
; the tail is not rare, and at 25x25 the node cap alone would sit on the hub for
; minutes before admitting defeat. PuzSolveOne holds the UI thread throughout,
; so that is not a slow solve, it is a frozen suite.
;
; Checked every 1024 nodes rather than every node: A_TickCount is a call, the
; test is on the hottest line in the module, and 1024 nodes is far below the
; resolution that matters here.
global PZ_SolveMs := 4000        ; wall-clock ceiling for the SEARCH, at 10x10 and under
; ---- and it has to grow with the board ----
; Four seconds was set when the grid was 6x6 and 7x7, and stayed a constant
; while the grid became a setting. A 25x25 has thirty-five times the cells and
; the search scales with the CELLS, not with the clock: measured on 25x25 boards
; at the density the panel actually deals - around 120 to 140 pairs - the search
; costs 550,000 to 900,000 nodes where a 10x10 costs 60,000. At roughly 150,000
; nodes a second interpreted, four seconds was never going to be enough, and the
; board would come back "out of time" having been perfectly solvable.
;
; PZ_iterCap already scales on n squared. This is the same curve, clamped: a
; 10x10 keeps its four seconds exactly, a 25x25 gets sixteen. The clamp is
; because n squared alone would hand 25x25 sixty-nine seconds, and nobody is
; waiting that long for a board that a cancel would end anyway.
PZ_SolveMax() => Round(PZ_SolveMs * Clamp(PZ_GridN()**2 / 100.0, 1.0, 4.0))
; ---- and a ceiling on the whole board, not just the search ----
; Every bound in this module so far has been on one stage: the search gets four
; seconds, the next-deal poll gets 2.5, a line gets its cell budgets. None of
; that bounds a PRESS. Scan, pairing, optimise and the walk had no ceiling at
; all, and a board that goes wrong in any of them is indistinguishable from a
; hang to whoever is looking at it.
;
; So one number bounds the lot. It is checked at every stage boundary and before
; every line, and a press that reaches it stops and says which stage it was in.
; That does not fix a slow stage - it converts it from a freeze into a report,
; which is the difference between something to debug and something to guess at.
; ---- press again to stop ----
; A HOLD is already the "keep going" gesture, so the key cannot cancel on level
; alone - the two would be the same input. What separates them is a RELEASE in
; between, so this tracks the transition: once the key has been seen up, the
; next time it is seen down is a second press and the session ends.
;
; Polled rather than delivered. While a line is being drawn PuzDrawPath holds
; Critical, which is exactly what stops a second hotkey thread from launching -
; so waiting to be told would mean the cancel only lands in the gaps, which are
; the moments it is least needed. Every loop that can run long asks instead.
global PZ_cancel   := 0          ; a second press has been seen this session
global PZ_cancelUp := 0          ; the key has been released since it started
global PZ_BoardMs  := 12000      ; opening ceiling, before the board is known
; Once the pairs are counted the ceiling is re-derived from the WORK, because a
; flat number cannot be right at both ends of the speed slider: 12 s is eight
; times what a 100% board costs and barely twice a 10% one. So a stall at full
; speed sat inside the budget and still looked like a hang.
;
; One line is settle + press + the walk + the release, all in PZ_FrameMs, and
; the whole board is that times the pairs. Times three for verify redraws and
; ordinary jitter, with a floor so a small board is never squeezed.
PuzDrawBudget(np) {
    perLine := PZ_FrameMs * (PZ_StartFrames + PZ_PressFrames + PZ_LagFrames
                           + PZ_EndFrames + PZ_SlackFrames + PZ_CellFrames*PZ_GridN())
    ; Times the learned pace as well as the 3x for redraws: a board drawn at a
    ; slowed pace legitimately takes longer, and a budget that did not know that
    ; would cut it off partway through for doing the right thing.
    return Max(3000, Round(3 * np * perLine * PZ_paceMul))
}
global PZ_boardEnd := 0          ; A_TickCount that press must finish by
global PZ_boardOut := ""         ; the stage it was in when it ran out
global PZ_solveEnd := 0          ; A_TickCount the solve in flight must finish by
global PZ_solveOut := 0          ; 1 when the last solve stopped on a limit
; ---- and the stop has to LATCH ----
; Declared here with the rest of the in-flight state rather than beside
; PuzSolveStop, for the same reason RN_gui is: everything that reads it is armed
; long before control reaches that part of the file.
global PZ_stop := 0              ; a limit has fired; unwind, do not resume
; ---- recursion depth ----
; PuzDFS recurses once per CELL of the path it is building, and it reaches the
; next pair through PuzRoutePair from inside itself - so the stack holds every
; cell of every path placed so far, not just the current one. At 7x7 the deepest
; that can get is about 60 frames. At 25x25 it is 625 cells plus a frame per
; pair, and AHK's call stack does not have room for that: it is a crash, not an
; exception, and a crash mid-solve looks exactly like "solving does not work".
;
; So the depth is counted and refused before the stack runs out. 480 is well
; inside what AHK survives and far past what any real board needs - a solution
; here does not have to fill the grid, it only has to join the pairs.
global PZ_DepthMax := 480
global PZ_solving := 0           ; a solve session is running
; ---- two counters, and they are not the same number ----
; PZ_runs is the SESSION count: PuzSolve zeroes it on entry, the status line
; reads it as "board N" and PZ_MaxRuns uses it to stop a physically stuck key.
; It is correct as a session count and wrong as anything else - a tap solves one
; board and ends, so it reads 1, and the next tap zeroes it and reads 1 again.
; The card's "puzzles solved" was showing that, which is why it never passed 1
; unless the key was held.
;
; PZ_total is the running total. Nothing resets it, and it is written to
; zeal.ini at the END of a session rather than per board - the loop is timing
; sensitive and a file write between two boards is the last thing it needs.
; ---- the ARM session ----
; A "session" was per keypress-hold, which is not the unit the game works in.
; The banner that shifts the board down 54 px is up for the FIRST puzzle of a
; generator and gone for the rest, and a generator run maps to arming the module
; and disarming it again - not to how many times the key was pressed inside it.
;
; So this counts boards from arm to disarm. It is INFORMATION, not control: the
; offset still comes from reading the frame, because a measurement beats an
; assumption and a session that started mid-generator would make the assumption
; wrong. What the count gives is a cross-check - board 1 with no banner, or
; board 4 with one, is worth seeing.
global PZ_sess   := 0            ; boards finished since the module was armed
global PZ_sessAt := 0            ; when that arm happened
global PZ_runs := 0              ; boards finished in THIS hold
global PZ_total := 0             ; boards finished ever - what the card shows
global PZ_MaxRuns := 300         ; a physically stuck key still has to stop somewhere
global PZ_RepairMax := 2         ; consecutive re-solves of a board that is not changing
; ---- the audit ----
; MEASUREMENT ONLY. It never retries, repairs, re-draws or slows the drag; the
; solve is the same single straight pass it has always been. All it does is look
; at what got drawn and count what did not, because four rounds of tuning against
; screenshots is not a way to tell a 2% regression from a 20% one.
;
; One capture per pair, taken straight after that pair's release, reusing the
; same cached DIB PuzScanGrid already allocates - about a millisecond, spent
; between lines rather than during one.
;
; The LAST pair of a board is deliberately not audited. Completing a board makes
; the game deal a new one, so a capture taken after the final release may be
; looking at a different puzzle entirely - and the reading would be inverted,
; clean on failure and catastrophic on success. Six pairs out of seven is an
; instrument, not a proof, and an instrument is what is missing.
;
; Results go to the tray tooltip and to zeal.ini. Nothing is drawn on screen.
global PZ_Audit := 0             ; 1 enables the capture and the counting
                                 ; OFF by default, and the reason is cost: this takes a
                                 ; full-board BitBlt - the 474x436 region, ~207,000 pixels
                                 ; read back off the GPU - after EVERY pair but the last.
                                 ; Five of those per board, for something that only counts
                                 ; and never changes a single thing that gets drawn. It is
                                 ; the instrument you turn ON to tune PZ_CellFrames and
                                 ; PZ_CornerFrames against, not something to carry while
                                 ; solving. It also runs outside PuzDrawPath's Critical, so
                                 ; each call is one more place the renderer can cut in.
global PZ_auPairs := 0           ; pairs audited this session
global PZ_auShort := 0           ; of those, how many came up short
global PZ_auCells := 0           ; total cells missing across them
global PZ_NextPoll := 15         ; ms between looks for the next deal. A deal is
                                 ; accepted on two matching reads, so this sets the
                                 ; floor on how quickly one can be picked up - 2 * this,
                                 ; plus two scans, is dead time between boards on a held
                                 ; key. What actually rejects a half-drawn deal is the
                                 ; even-count and exactly-two-per-colour checks, not the
                                 ; length of this interval, so it can be short. Raise it
                                 ; if a board ever gets picked up mid-deal-animation.
global PZ_NextTimeout := 2500    ; how long to watch for a new deal before giving the
                                 ; board on screen another go (see PuzSolve - a timeout
                                 ; is a retry now, not the end of the session)
global PZ_MaxFails := 6          ; consecutive unreadable boards before really stopping
global PZ_RetryWait := 120       ; ms between those retries

; ---- speed ----
; Every timing in this module is expressed in GAME FRAMES and derived from
; PZ_FrameMs, so ONE number scales the whole solve coherently. The slider drives
; that number: t = 1 is the fastest the module has ever run (17 ms/frame, the
; 60 FPS assumption), t = 0 assumes a much slower client and widens every dwell
; and the drag budget to match. Nothing else has to know about the slider.
global PZ_FrameFast := 5         ; frame budget at full speed, in ms. This is the ASSUMED
                                 ; frame PERIOD of the client, and every timing in the module
                                 ; is denominated in it, so it scales the whole solve.
                                 ;
                                 ; ---- how to pick this number ----
                                 ; It is not a speed setting. It is a claim about the client:
                                 ; "no frame of this game takes longer than PZ_FrameFast ms."
                                 ; The safety of every cell budget follows from it - a cell is
                                 ; observed as long as the real frame period is shorter than
                                 ; PZ_CellFrames * PZ_FrameFast, so at 1.5 * 5 = 7.5 ms this
                                 ; holds while the client stays above ~133 FPS instantaneous,
                                 ; and a corner holds above ~100.
                                 ;
                                 ; So the right value is the client's WORST-CASE period, not
                                 ; its average. 5 ms is 200 FPS - the bottom of the measured
                                 ; range rather than a margin under it, which is the reason
                                 ; PZ_Audit exists: this is now a number to be CHECKED against
                                 ; the short count, not argued about.
                                 ;
                                 ; 8 was a guess made while the failure model was still wrong,
                                 ; and 17 before that. 4 bets on 250 FPS. The failure it
                                 ; produces is distinctive - lines finishing SHORT by a cell
                                 ; or two, the original symptom - and the audit counts it.
global PZ_FrameSlow := 42        ; frame budget at the slow end
global PZ_SpeedT := 1.0          ; slider position, 0..1
global PZ_SLX := 100, PZ_SLW := 150, PZ_SLY := 54   ; speed track, relative to the card
; ---- the size row ----
; Four chips, one per entry in PZ_SIZES, sharing the speed row's left edge so
; the two controls line up under one label column. FFMBtn draws them - it is the
; hub's own button and already draws SET GRID and RESET on this card, so the
; alternative was inventing a second chip that would drift out of step with
; every other control in the suite.
global PZ_SZY := 84, PZ_SZX := 100, PZ_SZW := 48, PZ_SZG := 8
PZ_SZBX(i) => PZ_SZX + (i - 1)*(PZ_SZW + PZ_SZG)
global PZ_BTY := 110                                ; grid button row, foot of the card
global PZ_BTX := 56, PZ_BTW := 84                   ; SET GRID
global PZ_B2X := 146, PZ_B2W := 60                  ; RESET
; The status used to share the button row, which left it 166 px - and the
; strings it has to show need 230 to 290. Every one of them clipped mid-word
; ("hold t"), and no amount of eliding makes a 41-character sentence readable in
; 23 characters of space. It gets a full-width row instead, and the session pill
; moves up beside the buttons where there is room for it.
global PZ_STY := 136                                ; status, full width, its own row
global PZ_NTY := 158                                ; the note under it

; ---- the default, from MEASURED references rather than a guessed law ----
; Two resolutions have now been captured and measured the same way, and they
; killed the single-law idea outright:
;
;                        1920x1080   1024x768    ratio
;     cell pitch             86.20      42.70   0.4954
;     origin from centre    216.00     107.30   0.4968
;     banner shift           54.00      39.00   0.7222
;
;     width  W/1920 = 0.5333      height H/1080 = 0.7111
;
; The BOARD scales 0.495, which is neither axis - it is an aspect-constrained
; panel, so its size is bounded by whichever dimension binds and by a fixed
; border that does not scale at all. The BANNER scales 0.722, which IS height,
; because it is text and text is sized off the viewport height. One law was
; never going to fit both, and the law I had fitted neither.
;
; So this is a TABLE of things actually measured, not a formula. On a resolution
; that is in it the numbers are exact. Off it, they are interpolated on width
; between the two nearest entries, which is a guess - but a guess anchored to
; two real measurements instead of one, and the per-resolution calibration below
; makes it exact anywhere the user has run SET GRID once.
;
; Adding a resolution is one line: measure the pitch and the origin, add an
; entry, keep the list sorted by width.
; A third resolution broke the last assumption standing. At 800x600 the board is
; NOT centred in the viewport - its centre sits at 407.5, 318.5 against a
; viewport centre of 400, 300, so +7.5 across and +18.5 down. At 1024x768 and
; 1920x1080 it is centred to within half a pixel. Whatever the game does at the
; low end - a minimum panel size, a different anchor, chrome it is avoiding - it
; is not something derivable from the other two.
;
; So the x and y offsets are stored SEPARATELY and measured, not computed from
; "it is centred". That assumption held twice and then did not.
; ---- the table, in the two facts that do NOT depend on the cell count ----
; It used to store cell pitch and the offset to the FIRST dot, both of which
; are answers for one particular N - so every time the board's cell count moved,
; every number in it was wrong and had to be rederived. With four sizes to pick
; from that stops being a one-off edit and becomes a table that cannot be right.
;
; What was actually measured, and what does not move when N does, is the board's
; outer BOX and where its CENTRE sits relative to the viewport centre. Those are
; stored; pitch and origin are derived from them per N in PuzRefDerive:
;
;     p  = box / N
;     ox = (N-1)/2 * p - cx            (cx positive = board sits right of centre)
;
; The numbers below are the same measurements as before, re-expressed:
; box is 6 x the measured 6-wide pitch, and cx / cy fall out as +7.5 / +18.5 at
; 800x600 and within half a pixel of centred at the other two - which is exactly
; what was measured and written up above, and is the check that this is the
; right decomposition rather than a convenient one.
global PZ_REF := [ {w:  800, h:  600, box: 196.80, cx:  7.50, cy: 18.50, ban: 31}
                 , {w: 1024, h:  768, box: 256.20, cx: -0.55, cy: -0.55, ban: 39}
                 , {w: 1920, h: 1080, box: 517.20, cx: -0.50, cy: -0.50, ban: 54} ]
global PZ_RefExact := 0          ; 1 when the current screen is IN the table

; Resolved once per screen change rather than per call - PuzPX asks for it on
; every cache rebuild and the inspector on every frame.
; box + centre in, pitch + origin out. This is where the cell count enters the
; default grid, and the only place it does.
;
; `ox` is the distance from the viewport centre to the FIRST dot, which is the
; half-span of the dot grid measured back from the board's own centre. The
; centre is the fact that survives a size change; ox is rebuilt around it every
; time N moves. Scaling a stored ox directly would slide the whole board
; sideways by half the change in span, which is the trap this decomposition
; exists to avoid.
PuzRefDerive(box, cx, cy, ban) {
    n := PZ_GridN()
    p := box / n
    return {p: p, box: box, cx: cx, cy: cy
          , ox: (n - 1)/2 * p - cx
          , oy: (n - 1)/2 * p - cy
          , ban: ban}
}

PuzDefRef() {
    ; N is part of the cache key now, not just the screen. Everything this
    ; returns except `box` and the banner is derived through the cell count, so
    ; a size change with the old entry still cached is a board read at the old
    ; pitch - the same staleness the screen key was added to stop.
    static c := 0, cw := -1, ch := -1, cn := -1
    global PZ_RefExact
    if (PZ_vw < 1)
        PuzScreenSync()
    if (c && cw = PZ_vw && ch = PZ_vh && cn = PZ_GridN())
        return c
    cw := PZ_vw, ch := PZ_vh, cn := PZ_GridN()
    for e in PZ_REF {
        if (e.w = PZ_vw && e.h = PZ_vh) {
            PZ_RefExact := 1
            return c := PuzRefDerive(e.box, e.cx, e.cy, e.ban)
        }
    }
    PZ_RefExact := 0
    n := PZ_REF.Length
    if (n = 1)
        return c := PuzRefDerive(PZ_REF[1].box, PZ_REF[1].cx, PZ_REF[1].cy, PZ_REF[1].ban)
    ; the bracketing pair by width, or the nearest pair when outside the table
    lo := 1, hi := n
    loop n - 1 {
        if (PZ_vw >= PZ_REF[A_Index].w && PZ_vw <= PZ_REF[A_Index + 1].w) {
            lo := A_Index, hi := A_Index + 1
            break
        }
    }
    if (PZ_vw < PZ_REF[1].w)
        lo := 1, hi := 2
    else if (PZ_vw > PZ_REF[n].w)
        lo := n - 1, hi := n
    A := PZ_REF[lo], B := PZ_REF[hi]
    t := (B.w = A.w) ? 0 : (PZ_vw - A.w)/(B.w - A.w)
    ; the banner is TEXT and tracks height, so it interpolates on height even
    ; though everything else here interpolates on width
    tb := (B.h = A.h) ? 0 : (PZ_vh - A.h)/(B.h - A.h)
    return c := PuzRefDerive(A.box + (B.box - A.box)*t
                           , A.cx  + (B.cx  - A.cx )*t
                           , A.cy  + (B.cy  - A.cy )*t
                           , A.ban + (B.ban - A.ban)*tb)
}
PZ_DefX0() => Round((PZ_vx + PZ_vw/2) - PuzDefRef().ox, 2)
PZ_DefY0() => Round((PZ_vy + PZ_vh/2) - PuzDefRef().oy, 2)
PZ_DefSX() => Round(PuzDefRef().p, 4)
PZ_DefSY() => Round(PuzDefRef().p, 4)
; The BOARD's scale against the 1920x1080 reference, not the cell's. It used to
; divide the pitch by 86.2 - the 1920 pitch at six cells - which turned into a
; reading of the grid SIZE the moment the size became a setting: 25x25 on a
; 1080p screen would have reported 0.24 scale on a board that had not moved.
; Display only, either way.
PuzDefScale() => Round(PuzDefRef().box / 517.20, 4)

; ---- THE DEFAULT STAYS UNTOUCHABLE. The OVERRIDE is what SET GRID writes ----
; The four above keep every guarantee they had: functions, no variable to
; assign, a load-time error for anything that tries. Nothing can change what the
; default IS.
;
; What SET GRID produces is a separate thing - an override that SITS IN FRONT of
; the default without replacing it. PZ_Grid is 0 when there is none, so:
;
;   * a broken or rejected calibration can only ever fall back to a good
;     measured grid, never to nothing
;   * RESET is `PZ_Grid := 0` - the default is still there to return to,
;     because it was never overwritten
;   * the default cannot drift. Every earlier version stored ONE set of numbers
;     and let the load path write into it, which is exactly how a bad load used
;     to destroy the fallback as well
;
; PZ_Grid is a variable, necessarily - it is the one thing here meant to change.
; Two writers, both reached only from a button the user pressed.
; ---- the override is the BOX, not the cells inside it ----
; This used to store the first dot and the pitch, both worked out by dividing
; the two clicked corners by whatever N was in force at the time. That was fine
; while N was a constant and fatal the moment it became a setting: a grid
; calibrated at 7x7 and then switched to 10x10 would keep the 7-wide pitch and
; walk straight off the board.
;
; So the override stores what the user actually clicked - the board's outer box -
; and the cells are divided out of it on read, exactly as the default is. The
; box does not move when the cell count does, which is the whole point: SET GRID
; is measured once per screen and survives every size after it.
global PZ_Grid := 0              ; 0, or {bx, by, bw, bh} - the board's OUTER box
global PZ_gridGen := 0           ; bumped on every change - see PuzPX
; The screen the grid was last RESOLVED for. Not a cache key - a receipt. It is
; how any entry point can ask "has the world moved since the grid was worked
; out?" without trusting that a notification arrived or that a static was
; invalidated somewhere else.
global PZ_gridFor := ""

; The first dot sits half a cell in from the box's edge - the same relation
; PuzCalCommit used to bake in at calibration time, moved to the read so it is
; recomputed against the current N.
PZ_SX() => PZ_Grid ? Round(PZ_Grid.bw / PZ_GridN(), 4) : PZ_DefSX()
PZ_SY() => PZ_Grid ? Round(PZ_Grid.bh / PZ_GridN(), 4) : PZ_DefSY()
PZ_X0() => PZ_Grid ? Round(PZ_Grid.bx + PZ_SX()/2, 2) : PZ_DefX0()
PZ_Y0() => PZ_Grid ? Round(PZ_Grid.by + PZ_SY()/2, 2) : PZ_DefY0()
PZ_Custom() => PZ_Grid ? 1 : 0

; ---- the only two writers ----
; State and generation, and nothing else. The teardown a grid change also needs
; - capture buffers, marker surface - is deliberately NOT in here: PuzGridLoad
; calls PuzGridSet during the BOOT sequence, and PuzMarkersKill reads five PZ_mk*
; globals declared a thousand lines further down which are unset at that moment.
; Reading an unset variable throws, PuzGridLoad's body is inside a try, and the
; throw would be swallowed and the saved calibration silently dropped on every
; launch. That is the exact bug, in the exact shape, this module started with.
PuzGridSet(bx, by, bw, bh) {
    global PZ_Grid, PZ_gridGen, PZ_gridFor
    PZ_Grid := {bx: bx, by: by, bw: bw, bh: bh}
    PZ_gridGen += 1
    PZ_gridFor := PZ_vw "x" PZ_vh
}

; The third writer, and it is one for the same reason the other two are: state
; and generation together, teardown left to the caller. PuzGridNLoad runs during
; boot and must not reach PuzMarkersKill - see the note above PuzGridSet.
; Returns 1 when the size actually moved.
PuzGridNSet(i) {
    global PZ_gridNi, PZ_gridGen
    i := Clamp(Round(i), 1, PZ_SIZES.Length)
    if (i = PZ_gridNi)
        return 0
    PZ_gridNi := i
    PZ_gridGen += 1
    return 1
}
PuzGridClear() {
    global PZ_Grid, PZ_gridGen, PZ_gridFor
    PZ_Grid := 0
    PZ_gridGen += 1
    PZ_gridFor := PZ_vw "x" PZ_vh
}
PuzGridInvalidate() {
    PuzFreeCaps()                ; DIBs are keyed on region size
    PuzMarkersKill()             ; the surface is drawn for one grid only
}
; A pitch two clicks could actually have produced. Says nothing about the SCREEN:
; a grid that does not fit the current display is still the grid the user set,
; and that question belongs to PuzGridOnScreen, which declines to solve and
; never edits anything.
; A BOX two clicks could actually have produced, tested at the size it will be
; read at. The old form tested the pitch directly; the box has to be divided
; first, and the floor matters more now than it did - at 25x25 a cell is a
; twenty-fifth of the board, so a box that was comfortable at 6 wide can put
; the pitch under the 4 px sampling needs.
PuzGridSane(bx, by, bw, bh) {
    sx := bw / PZ_GridN(), sy := bh / PZ_GridN()
    return (sx > 4 && sy > 4 && sx < 400 && sy < 400)
}
global PZ_mkWant := 1           ; the PREFERENCE - persisted, survives disarm

; restored here, not up with the other ini reads: those run before this block
; and the declaration above would overwrite whatever they loaded
try PZ_SpeedT := Clamp(IniRead(iniPath, "puzzle", "speed", "1") + 0, 0.0, 1.0)
try PZ_total := Max(0, Integer(IniRead(iniPath, "puzzle", "solved", "0")))
try PZ_mkWant := Integer(IniRead(iniPath, "puzzle", "markers", "1")) ? 1 : 0
; ---- virtual screen metrics ----
; Declared HERE rather than down beside PuzScreenSync, and synced before the
; grid is loaded. Two things were wrong. The hub never called PuzScreenSync at
; startup at all - the bench file does, and the port brought the functions
; across without the boot line - so these stayed 0 for the whole session unless
; a display change happened to fire. And the declaration sat below this block,
; so anything up here that read them got an unset variable, which throws; inside
; PuzGridLoad's try that would have been swallowed and the saved calibration
; silently discarded on every launch.
global PZ_vx := 0, PZ_vy := 0, PZ_vw := 0, PZ_vh := 0
PuzScreenSync()
PuzSpeedApply()
; Before PuzGridLoad, and that order is load-bearing: PuzGridSane divides the
; saved box by the current size, so a size restored afterwards would test the
; box against the wrong N and could throw a good calibration away.
PuzGridNLoad()
; ONE call, here, and nowhere else. Everything it writes - PZ_Grid, PZ_gridGen -
; is declared above this line, which is the trap this block already carries a
; note about. It is also the only load in the module: no reload on a display
; change, no reload after a failed scan.
PuzGridLoad()

; ---- calibration ----
; Reads the four numbers written by the standalone solver. The values baked in
; above are the current calibration, so a missing ini simply keeps working.
; ============================================================================
;  PUZZLE AI overlay
; ----------------------------------------------------------------------------
;  A CLONE of the EXTERNAL BLOCK REBIND overlay, not a second design. Same
;  geometry (PAD/CW/CH/BW/BH, so the same PW x PH surface), same chrome, same
;  animation state machine, same hit zones, same bubble. The block overlay had
;  been given four years of detail this one never got - staged intro, the
;  minimise-to-bubble arc with its anticipation and scatter, the drag tilt off
;  real window velocity, the close implosion, the toggle sweep, the 24-segment
;  bubble ring - and a hand-built second card was never going to catch up. So
;  this does not try: Render/DrawCard/DrawBubble are mirrored function for
;  function, and only the CONTENT differs.
;
;  What differs, and nothing else:
;    - the caption reads "puzzle ai"
;    - the keycap and the badge carry PUZZLE AI's own binding (puzKey/puzLabel)
;      and the badge rebinds through target 2
;    - closing disarms PUZZLE AI rather than AUTOBLOCK
;
;  Every piece of state is namespaced under PZO so the two overlays animate
;  independently - the block card's globals (stateT, minT, dragT, hovT, ...)
;  are its own and are never touched here.
;
;  NO MODULE FUNCTIONS ARE WIRED INTO THIS CARD. It draws, animates, drags,
;  minimises and closes; it does not solve, calibrate or place markers.
;  PuzOvToggleBind() is the single entry point that flips the card's
;  ENABLED/DISABLED state, and it is deliberately left unbound.
; ============================================================================
; One object rather than thirty loose globals. Field for field it is the block
; overlay's own state:
;   bx/by/px/py      placement, mirroring baseX/baseY/winPX/winPY
;   enabled/stateT   the ENABLED/DISABLED state and its eased transition
;   minT/min*        card <-> bubble
;   ripple/intro/burst/closing/lastClick/tog*/scatAt   the one-shot effects
;   drag*/grab*/tiltS/prevBX                          dragging
;   hovT/h1T..h6T/hgT                                 eased hover, one per zone
;   sld/runsSeen/pokeAt   slider drag, the count the ripple last fired on, and
;                         the last moment the pointer touched anything
;   cur/pulse/emb/emb2                                per-frame, set by PuzRender
global PZO := { gui: "", dc: 0, bm: 0, g: 0, lastQ: -1
              , bx: 0, by: 0, px: 0, py: 0, placed: 0
              , enabled: false, stateT: 0.0
              , animFrom: 0.0, animTo: 0.0, animStart: 0
              , minT: 0.0, minFrom: 0.0, minTo: 0.0, minStart: 0
              , rippleStart: 0, introStart: 0, burstAt: 0, closing: 0, lastClick: 0
              , togAt: 0, togDir: 0, scatAt: 0
              , dragOn: 0, dragZone: 0, dragDownAt: 0
              , grabX: 0, grabY: 0, grabBX: 0, grabBY: 0
              , dragT: 0.0, tiltS: 0.0, prevBX: 0
              , hovT: 0.0, h1T: 0.0, h2T: 0.0, h3T: 0.0, h4T: 0.0, hgT: 0.0
              , h5T: 0.0, h6T: 0.0, sld: 0, runsSeen: -1, pokeAt: 0
              , cur: C_OFF, pulse: 0.0, emb: 0.0, emb2: 0.0
              , rendP: -1 }
; kept for compatibility with anything still testing the old handle
global PZ_ov := ""

; ---- surface + window ----
; Created on arm and torn down on disarm, the way the old card was: the block
; overlay keeps its window for the life of the session because the loader posts
; to it, and this one has no such duty.
PuzOvOpen() {
    global PZ_ov
    if (PZO.gui != "") {
        ; re-arming while the close animation is still running: cancel it and
        ; replay the intro rather than letting the card finish dying
        PZO.closing := 0
        PZO.introStart := A_TickCount
        PuzRendTim(TICK_A)
        return
    }
    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", PW, bi, 4), NumPut("int", -PH, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    PZO.bm := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0
                    , "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    PZO.dc := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", PZO.dc, "ptr", PZO.bm)
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", PZO.dc, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", g2, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", 4)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", g2, "int", 2)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", g2, "float", PW/BW, "float", PH/BH, "int", 0)
    PZO.g := g2, PZO.lastQ := -1
    ; First arm: one card width to the LEFT of where the block overlay sits, so
    ; both can be open at once without one covering the other. After that the
    ; card keeps wherever it was dragged to.
    if !PZO.placed {
        MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
        PZO.bx := mR - PW - Round((CW + 18)*scaleF) + Round((PAD - 14)*scaleF)
        PZO.by := mB - PH + Round((PAD - 14)*scaleF)
        PZO.placed := 1
    }
    PZO.prevBX := PZO.bx
    PZO.closing := 0
    PZO.enabled := false, PZO.stateT := 0.0, PZO.animStart := 0
    PZO.minT := 0.0, PZO.minFrom := 0.0, PZO.minTo := 0.0, PZO.minStart := 0
    PZO.dragOn := 0, PZO.dragZone := 0, PZO.dragT := 0.0, PZO.tiltS := 0.0
    PZO.hovT := 0.0, PZO.h1T := 0.0, PZO.h2T := 0.0
    PZO.h3T := 0.0, PZO.h4T := 0.0, PZO.hgT := 0.0
    PZO.h5T := 0.0, PZO.h6T := 0.0, PZO.sld := 0
    PZO.runsSeen := PZ_total, PZO.pokeAt := A_TickCount
    PZO.rippleStart := 0, PZO.burstAt := 0, PZO.scatAt := 0, PZO.lastClick := 0
    PZO.togAt := 0, PZO.togDir := 0
    PZO.introStart := A_TickCount
    PZO.gui := Gui("-Caption +E0x80000 +E0x8000000 " (hubTop ? "+AlwaysOnTop " : "") "+ToolWindow -DPIScale", "YURIPUZZLE")
    PZO.gui.Show("NA x0 y0 w" PW " h" PH)
    PZ_ov := PZO.gui
    OnMessage(0x84,  PuzOvHitTest)
    OnMessage(0x201, PuzOvClick)
    OnMessage(0x202, PuzOvLUp)
    OnMessage(0x200, PuzOvMMove)
    OnMessage(0x204, PuzOvRClick)
    OnMessage(0x20,  PuzOvSetCur)
    PuzRendTim(TICK_A)
    PuzRender()
}
PuzOvClose() {
    global PZ_ov
    if (PZO.gui = "")
        return
    PuzRendTim(0)
    try OnMessage(0x84,  PuzOvHitTest, 0)
    try OnMessage(0x201, PuzOvClick, 0)
    try OnMessage(0x202, PuzOvLUp, 0)
    try OnMessage(0x200, PuzOvMMove, 0)
    try OnMessage(0x204, PuzOvRClick, 0)
    try OnMessage(0x20,  PuzOvSetCur, 0)
    if (PZO.dragOn || PZO.sld) {
        try DllCall("ReleaseCapture")
        PZO.dragOn := 0, PZO.sld := 0
    }
    try PZO.gui.Destroy()
    PZO.gui := "", PZ_ov := ""
    if PZO.g
        try DllCall("gdiplus\GdipDeleteGraphics", "ptr", PZO.g)
    if PZO.dc
        try DllCall("gdi32\DeleteDC", "ptr", PZO.dc)
    if PZO.bm
        try DllCall("gdi32\DeleteObject", "ptr", PZO.bm)
    PZO.g := 0, PZO.dc := 0, PZO.bm := 0
    PZO.closing := 0
}
; The card plays its implosion first and PuzOvFinishHide tears it down when the
; animation lands - exactly the AbDisable -> StartClose -> AbFinishHide path.
PuzOvStartClose() {
    if (PZO.gui = "" || PZO.closing)
        return
    PZO.closing := A_TickCount
    PuzRendTim(TICK_A)
}
PuzOvFinishHide() {
    PZO.enabled := false, PZO.stateT := 0.0, PZO.animStart := 0
    PZO.minT := 0.0, PZO.minFrom := 0.0, PZO.minTo := 0.0, PZO.minStart := 0
    PuzOvClose()
    HubPoke()
}
; ---- the card's own ENABLED/DISABLED flip ----
; Deliberately UNBOUND. Everything the state drives - the sweep across the
; plate, the pill ripple, the keycap lift, the bubble igniting segment by
; segment - is built and waiting; hooking it to the module is the next step,
; not this one.
PuzOvToggleBind(*) {
    if (PZO.gui = "" || PZO.closing)
        return
    PZO.enabled := !PZO.enabled
    PZO.animFrom := PZO.stateT, PZO.animTo := PZO.enabled ? 1.0 : 0.0
    PZO.animStart := A_TickCount, PZO.rippleStart := PZO.animStart
    PZO.togAt := PZO.animStart, PZO.togDir := PZO.enabled ? 1 : -1
    PuzRendTim(TICK_A)
    HubPoke()
}

; ---- timer wrapper, same contract as RendTim ----
PuzRendTim(p) {
    if hubLowPerf
        p := (p <= TICK_A) ? 40 : 220
    if (p != PZO.rendP)
        PZO.rendP := p, SetTimer(PuzRender, p, -10)
}

; ---- geometry ----
; One source for the renderer and the hit test, the lesson SPFAddGeom records:
; the second badge's x depends on the first badge's WIDTH, which changes with
; whichever key is bound, so two hand-kept copies of this drift the moment
; somebody rebinds to a wider label.
PuzOvSlideX() => PAD + 88
PuzOvSlideW() => CW - 108
PuzOvSlideY() => PAD + 90
PuzOvKeyGeom(&b1x, &b1w, &l1x, &b2x, &b2w, &l2x) {
    b1x := PAD + 24
    b1w := (rebindOn && rebindTgt = 2) ? qqqBW : puzBW
    l1x := b1x + b1w + 9
    b2x := l1x + MeasureW("solve", fHint) + 16
    b2w := (rebindOn && rebindTgt = 3) ? qqqBW : mkBW
    l2x := b2x + b2w + 9
}
; Screen x -> slider position. The hub's PuzSlideSet is the same function
; against the hub's own origin; both land on PZ_SpeedT, which is why the two
; sliders need no syncing code at all.
PuzOvSlideSet(sx) {
    global PZ_SpeedT
    k := PW/BW
    ux := (sx - PZO.px)/k
    PZ_SpeedT := Clamp((ux - PuzOvSlideX())/PuzOvSlideW(), 0.0, 1.0)
    PuzSpeedApply()
    HubPoke()                                   ; the hub card is showing the same number
}

; ================= interaction =================
; Zone numbering matches the block overlay's so the two read the same, then
; carries on where PUZZLE AI has more to offer:
;   1 minimise  2 close  3 bubble  4 grip  5 avatar
;   6 solve keybind   7 grid keybind   8 speed slider
PuzOvHitZone(sx, sy) {
    if !puzOn
        return 0
    if (PZO.gui = "" || PZO.closing)
        return 0
    if galOpen || cropUIOn
        return 0
    k := PW/BW
    ux := (sx - PZO.px)/k, uy := (sy - PZO.py)/k
    if PZO.minT < 0.5 {
        if (ux - BMX)**2 + (uy - BTY)**2 <= 81
            return 1
        if (ux - BCX)**2 + (uy - BTY)**2 <= 81
            return 2
        if (ux - AVX)**2 + (uy - AVY)**2 <= 676
            return 5
        ; the track is grabbable a little past each end and well above and below
        ; it - a 3px bar with a 12px knob is not a hit box
        if (ux >= PuzOvSlideX() - 8 && ux <= PuzOvSlideX() + PuzOvSlideW() + 8
            && uy >= PuzOvSlideY() - 11 && uy <= PuzOvSlideY() + 11)
            return 8
        PuzOvKeyGeom(&b1x, &b1w, &l1x, &b2x, &b2w, &l2x)
        if (uy >= PAD + 106 && uy <= PAD + 126) {
            if (ux >= b1x && ux <= b1x + b1w)
                return 6
            if (ux >= b2x && ux <= b2x + b2w)
                return 7
        }
        if ux >= PAD + CW/2 - 16 && ux <= PAD + CW/2 + 16 && uy >= PAD + 4 && uy <= PAD + 28
            return 4
    } else if (ux - BBX)**2 + (uy - BBY)**2 <= 1024
        return 3
    return 0
}
PuzOvHitZoneAtCursor() {
    CursorXY(&x, &y)
    return PuzOvHitZone(x, y)
}
PuzOvHitTest(wParam, lParam, msg, hwnd) {
    if (PZO.gui = "" || hwnd != PZO.gui.Hwnd)
        return
    LpXY(lParam, &x, &y)
    return PuzOvHitZone(x, y) ? 1 : -1
}
PuzOvClick(wParam, lParam, msg, hwnd) {
    if (PZO.gui = "" || hwnd != PZO.gui.Hwnd)
        return
    CursorXY(&x, &y)
    zone := PuzOvHitZone(x, y)
    if zone = 1
        PuzOvStartMin(1.0)
    else if zone = 2
        PuzDisable()
    else if zone = 3 || zone = 4
        PuzOvDragBegin(zone, x, y)
    else if zone = 5
        GalleryPick()
    else if zone = 6
        RebindClick(2)
    else if zone = 7
        RebindClick(3)
    else if zone = 8 {
        PZO.sld := 1
        DllCall("SetCapture", "ptr", PZO.gui.Hwnd)
        PuzOvSlideSet(x)
        PuzRendTim(TICK_A)
    }
    return 0
}
PuzOvLUp(wParam, lParam, msg, hwnd) {
    if PZO.sld {
        DllCall("ReleaseCapture")
        PZO.sld := 0
        ; persisted on RELEASE, not on every pixel of the drag - the hub's own
        ; slider does exactly this, and writing an ini file per mouse move is
        ; the difference between a smooth control and a stuttering one
        try IniWrite(Round(PZ_SpeedT, 3), iniPath, "puzzle", "speed")
        HubPoke()
        return 0
    }
    if !PZO.dragOn
        return
    wasClick := (PZO.dragOn = 1), z := PZO.dragZone
    PZO.dragOn := 0                              ; cleared before the release - see HubBtnUp
    DllCall("ReleaseCapture")
    if wasClick && z = 3
        PuzOvStartMin(0.0)
    return 0
}
PuzOvMMove(wParam, lParam, msg, hwnd) {
    if (PZO.gui = "" || hwnd != PZO.gui.Hwnd)
        return
    ; a drag or a slide whose button is up is over - see HubMove
    if ((PZO.sld || PZO.dragOn) && !GetKeyState("LButton", "P") && !GetKeyState("RButton", "P")) {
        PuzOvLUp(wParam, lParam, 0x202, hwnd)
        return 0
    }
    ; Record the touch and let the render loop choose the rate. The block
    ; overlay calls RendTim(TICK_S) here, which fights the TICK_A the renderer
    ; picks a frame later whenever the pointer is over the card: the period
    ; flips 16/33/16/33 on every mouse move, and SetTimer RESTARTS the
    ; countdown each time it changes - so the card renders at neither rate and
    ; the pointer stutters. One writer for the period, and this is not it.
    PZO.pokeAt := A_TickCount
    if PZO.sld {
        CursorXY(&sx2, &sy2)
        PuzOvSlideSet(sx2)
        return 0
    }
    if !PZO.dragOn
        return
    CursorXY(&x, &y)
    if PZO.dragOn = 1 && (x - PZO.grabX)**2 + (y - PZO.grabY)**2 > 16
        PZO.dragOn := 2
    if PZO.dragOn = 2 {
        PZO.bx := PZO.grabBX + (x - PZO.grabX)
        PZO.by := PZO.grabBY + (y - PZO.grabY)
        PuzOvClampPos()
    }
    return 0
}
PuzOvRClick(wParam, lParam, msg, hwnd) {
    if (PZO.gui = "" || hwnd != PZO.gui.Hwnd)
        return
    CursorXY(&x, &y)
    if PuzOvHitZone(x, y) = 3
        PuzDisable()
    return 0
}
PuzOvSetCur(wParam, lParam, msg, hwnd) {
    if (PZO.gui != "" && hwnd = PZO.gui.Hwnd) {
        id := (PZO.dragOn || PuzOvHitZoneAtCursor() = 4) ? 32646 : 32649
        DllCall("SetCursor", "ptr", DllCall("LoadCursor", "ptr", 0, "ptr", id, "ptr"))
        return 1
    }
}
PuzOvDragBegin(zone, x, y) {
    PZO.dragOn := 1, PZO.dragZone := zone, PZO.dragDownAt := A_TickCount
    PZO.grabX := x, PZO.grabY := y, PZO.grabBX := PZO.bx, PZO.grabBY := PZO.by
    DllCall("SetCapture", "ptr", PZO.gui.Hwnd)
    PuzRendTim(TICK_A)
}
; This card borrows the block overlay's canvas and its zone numbering, so it
; borrowed the same defect - see OvClampBounds.
PuzOvClampBounds(&lox, &hix, &loy, &hiy) {
    k := PW/BW
    if (PZO.minTo = 1.0)                                  ; collapsed: the orb
        HandleBounds(BBX - 32, BBY - 32, BBX + 32, BBY + 32, k, &lox, &hix, &loy, &hiy)
    else                                                  ; open: the 6-dot grip
        HandleBounds(PAD + CW/2 - 16, PAD + 4
                   , PAD + CW/2 + 16, PAD + 28, k, &lox, &hix, &loy, &hiy)
}
PuzOvClampPos() {
    PuzOvClampBounds(&lox, &hix, &loy, &hiy)
    PZO.bx := Clamp(PZO.bx, lox, hix), PZO.by := Clamp(PZO.by, loy, hiy)
}
PuzOvClampTick() {
    PuzOvClampBounds(&lox, &hix, &loy, &hiy)
    tx := Clamp(PZO.bx, lox, hix), ty := Clamp(PZO.by, loy, hiy)
    if (PZO.dragOn = 2 || (Abs(tx - PZO.bx) <= 1 && Abs(ty - PZO.by) <= 1)) {
        PZO.bx := tx, PZO.by := ty
        return 0
    }
    PZO.bx := StepTo(PZO.bx, tx, EK(0.24)), PZO.by := StepTo(PZO.by, ty, EK(0.24))
    return 1
}
PuzOvStartMin(target) {
    PZO.minFrom := PZO.minT, PZO.minTo := target, PZO.minStart := A_TickCount
    PZO.burstAt := target ? PZO.minStart + Round(MIN_MS*0.45) : 0
    PZO.scatAt  := target ? 0 : PZO.minStart
    PuzRendTim(TICK_A)
}

; ================= render =================
PuzRender() {
    global G
    if (PZO.gui = "" || !PZO.g)
        return
    Critical "On"
    g0 := G
    G := PZO.g
    if (hubLowPerf != PZO.lastQ) {
        PZO.lastQ := hubLowPerf
        DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", G, "int", hubLowPerf ? 3 : 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G, "int", hubLowPerf ? 1 : 4)
        DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G, "int", hubLowPerf ? 5 : 7)
        DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", G, "int", hubLowPerf ? 1 : 2)
    }
    now := A_TickCount
    ThemeTick()

    it := Min((now - PZO.introStart)/INTRO_MS, 1.0)
    ei := 1 - (1 - it)**3
    winA := Round(255 * Min(it*1.7, 1.0))
    yOff := Round((1 - ei) * 30 * scaleF)

    SelTick(now)
    if PZO.animStart {
        t := Min((now - PZO.animStart)/ANIM_MS, 1.0)
        PZO.stateT := Lerp(PZO.animFrom, PZO.animTo, 1 - (1 - t)**3)
        if t >= 1
            PZO.animStart := 0, PZO.stateT := PZO.animTo
    }
    if PZO.minStart {
        t := Min((now - PZO.minStart)/MIN_MS, 1.0)
        PZO.minT := Lerp(PZO.minFrom, PZO.minTo, 1 - (1 - t)**3)
        if t >= 1
            PZO.minStart := 0, PZO.minT := PZO.minTo
    }
    closeS := 1.0, closeRot := 0.0, ct := 0.0
    if PZO.closing {
        ct := Min((now - PZO.closing)/CLOSE_MS, 1.0)
        if ct >= 1 {
            G := g0
            Critical "Off"
            PuzOvFinishHide()
            return
        }
        if ct < 0.16
            closeS := 1 + 0.05*Sin(3.14159*ct/0.16)
        else {
            cb := (ct - 0.16)/0.84
            e := cb*cb
            closeS := 1 - 0.97*e
            closeRot := -14*e
            winA := Round(winA * (1 - Max(0.0, cb - 0.35)/0.65))
            yOff += Round(12 * e * scaleF)
        }
    }
    dtgt := (PZO.dragOn = 2 || (PZO.dragOn = 1 && now - PZO.dragDownAt > 130)) ? 1.0 : 0.0
    PZO.dragT += (dtgt - PZO.dragT)*EK(0.16)
    if !PZO.dragOn && PZO.dragT < 0.004
        PZO.dragT := 0.0
    ; before the velocity sample, so a correction is not leaned into as a throw
    posFix := PuzOvClampTick()
    vxd := PZO.bx - PZO.prevBX
    PZO.prevBX := PZO.bx
    PZO.tiltS += ((PZO.dragOn = 2 ? Clamp(vxd*0.35, -6.0, 6.0) : 0.0) - PZO.tiltS)*EK(0.18)
    if !PZO.dragOn && Abs(PZO.tiltS) < 0.03
        PZO.tiltS := 0.0
    hz := (PZO.closing || PZO.dragOn) ? 0 : PuzOvHitZoneAtCursor()
    PZO.hovT += (((hz = 5) ? 1.0 : 0.0) - PZO.hovT)*EK(0.2)
    PZO.h1T  += (((hz = 1) ? 1.0 : 0.0) - PZO.h1T)*EK(0.2)
    PZO.h2T  += (((hz = 2) ? 1.0 : 0.0) - PZO.h2T)*EK(0.2)
    PZO.h3T  += (((hz = 3) ? 1.0 : 0.0) - PZO.h3T)*EK(0.2)
    PZO.h4T  += (((hz = 6) ? 1.0 : 0.0) - PZO.h4T)*EK(0.2)
    PZO.h6T  += (((hz = 7) ? 1.0 : 0.0) - PZO.h6T)*EK(0.2)
    PZO.h5T  += ((((hz = 8) || PZO.sld) ? 1.0 : 0.0) - PZO.h5T)*EK(0.2)
    PZO.hgT  += (((hz = 4) ? 1.0 : 0.0) - PZO.hgT)*EK(0.2)
    PZO.hgT  := PZO.hgT  < 0.004 && hz != 4 ? 0.0 : PZO.hgT
    PZO.hovT := PZO.hovT < 0.004 && hz != 5 ? 0.0 : PZO.hovT
    PZO.h1T  := PZO.h1T  < 0.004 && hz != 1 ? 0.0 : PZO.h1T
    PZO.h2T  := PZO.h2T  < 0.004 && hz != 2 ? 0.0 : PZO.h2T
    PZO.h3T  := PZO.h3T  < 0.004 && hz != 3 ? 0.0 : PZO.h3T
    PZO.h4T  := PZO.h4T  < 0.004 && hz != 6 ? 0.0 : PZO.h4T
    PZO.h6T  := PZO.h6T  < 0.004 && hz != 7 ? 0.0 : PZO.h6T
    PZO.h5T  := PZO.h5T  < 0.004 && hz != 8 && !PZO.sld ? 0.0 : PZO.h5T
    ; a finished board is the one thing on this card worth announcing, and the
    ; pill already knows how to announce something - so the count borrows the
    ; ripple the state change used to fire
    if (PZ_total != PZO.runsSeen) {
        if (PZO.runsSeen >= 0)
            PZO.rippleStart := now
        PZO.runsSeen := PZ_total
    }
    ; Both of these are cleared by the draw that consumes them - the ripple by
    ; PuzOvDrawCard, the burst by PuzOvDrawBubble - and each is a term in
    ; `settled` below. Minimise while a ripple is running and the card stops
    ; being drawn with the flag still set, so nothing ever clears it and the
    ; rate can never step back down. Age them out here, where the frame always
    ; reaches, rather than in a draw path that may not run.
    if (PZO.rippleStart && now - PZO.rippleStart >= RIPPLE_MS)
        PZO.rippleStart := 0
    if (PZO.burstAt && now - PZO.burstAt >= 450)
        PZO.burstAt := 0

    PZO.pulse := PZO.enabled ? (Sin(now * 0.00417) + 1)/2 : 0
    PZO.emb   := (Sin(now * 0.0016) + 1)/2
    PZO.emb2  := (Sin(now * 0.004) + 1)/2
    PZO.cur   := Mix(hubAccent, C_ON, PZO.stateT)
    tg := PZO.togAt ? Min((now - PZO.togAt)/TOG_MS, 1.0) : 1.0
    togActive := PZO.togAt && tg < 1

    BrushCacheTick(), PenCacheTick()
    ResetSurface(G, PW/BW, PH/BH)
    DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)

    oAX := PZO.minT < 0.5 ? PAD + CW/2 : BBX
    oAY := PZO.minT < 0.5 ? PAD + CH/2 : BBY
    stO := PushXform(oAX, oAY, (1 + 0.035*PZO.dragT)*closeS, PZO.tiltS + closeRot)

    cf := 1 - Min(PZO.minT*1.7, 1.0)
    if PZO.minStart && cf > 0.004 {
        loop 2 {
            lag := Clamp(PZO.minT + (PZO.minTo = 1 ? -0.09 : 0.09) * A_Index, 0.0, 1.0)
            stG := PushXform(BBX, BBY, 1 - 0.16*lag, 8*lag)
            pn := Pen(Alpha(PZO.cur, 80 - A_Index*32), 1.4)
            StrokeRR(PAD, PAD, CW, CH, 16, pn), DelP(pn)
            Pop(stG)
        }
    }
    if cf > 0.004 {
        antic := (PZO.minStart && PZO.minTo = 1.0 && PZO.minT < 0.18) ? 1 + 0.05*Sin(PZO.minT/0.18 * 3.14159) : 1
        cardPop := (togActive && PZO.togDir = 1) ? 1 + 0.018*Sin(3.14159*Min(tg*1.5, 1.0)) : 1
        st := PushXform(BBX, BBY, (1 - 0.16*PZO.minT) * antic * cardPop, 8*PZO.minT)
        PuzOvDrawCard(cf, now)
        Pop(st)
    }
    bt_ := Max(0.0, (PZO.minT - 0.45)/0.55)
    if bt_ > 0.004 {
        eb := 1 + 2.3*((bt_ - 1)**3) + 1.3*((bt_ - 1)**2)
        popB := (togActive && PZO.togDir = 1) ? 1 + 0.14*Sin(tg*7.85)*(1 - tg)**1.5 : 1
        sqB  := (togActive && PZO.togDir = -1) ? 1 - 0.05*Sin(3.14159*tg) : 1
        prsB := (PZO.scatAt && now - PZO.scatAt < 120) ? 1 - 0.06*(1 - (now - PZO.scatAt)/120.0) : 1
        bsc := (0.55 + 0.45*eb) * popB * sqB * prsB * (1 + 0.05*PZO.h3T) * (PZO.enabled ? 1 + 0.02*(PZO.pulse - 0.5) : 1)
        rotKick := (togActive && PZO.togDir = 1) ? 10*Sin(tg*6.9)*(1 - tg)**2 : 0
        rotB := -35 * (1 - Clamp(bt_, 0.0, 1.0))**2 + rotKick
        dipY := (togActive && PZO.togDir = -1) ? 7*Sin(3.14159*Min(tg*1.15, 1.0))*(1 - 0.35*tg) : 0
        stS := PushShift(0, dipY)
        st := PushXform(BBX, BBY, bsc, rotB)
        PuzOvDrawBubble(Min(bt_*1.6, 1.0), now)
        Pop(st), Pop(stS)
    }
    Pop(stO)

    if PZO.closing && ct > 0.30 {
        p2 := (ct - 0.30)/0.70
        e2 := 1 - (1 - p2)**3
        loop 8 {
            a_ := (A_Index*45 + 25*e2) * 0.0174533
            rr_ := 10 + e2*38
            srad := 2.6*(1 - e2) + 0.5
            b := SBrush(Alpha(PZO.cur, 210*(1 - e2)))
            FillEll(oAX + rr_*Cos(a_) - srad, oAY + rr_*Sin(a_) - srad, srad*2, srad*2, b), DelB(b)
        }
    }

    pt0 := Buffer(8, 0)
    sz  := Buffer(8), NumPut("int", PW, "int", PH, sz)
    PZO.px := PZO.bx, PZO.py := PZO.by + yOff
    ptd := Buffer(8), NumPut("int", PZO.px, "int", PZO.py, ptd)
    bf  := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
    DllCall("user32\UpdateLayeredWindow", "ptr", PZO.gui.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz
          , "ptr", PZO.dc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)

    G := g0
    Critical "Off"

    ; ---- how hard to run ----
    ; Three tiers, the same three the hub uses and for the same reason. This
    ; card is a third software-composited layered surface sitting on top of a
    ; game, and its render holds Critical for the whole frame - so every frame
    ; it does not need is a frame of input latency it does not cost.
    ;
    ;   TICK_A  something is actually moving, or the pointer is on the card
    ;   TICK_S  open and idle
    ;   TICK_Z  open, idle, and untouched for HUB_DEEP_MS - the card sitting
    ;           beside a game while somebody plays. Only slow sine motion is
    ;           left at that point and 20 fps carries it, at a third of the
    ;           frames. Any pointer contact is one frame away from TICK_A.
    settled := (it >= 1 && !PZO.animStart && !PZO.rippleStart && !PZO.minStart
             && !PZO.burstAt && !PZO.closing && !PZO.dragOn && !PZO.sld
             && PZO.dragT = 0 && PZO.tiltS = 0 && !togActive
             && !(PZO.scatAt && now - PZO.scatAt < 400))
    hmax := Max(PZO.hovT, PZO.h1T, PZO.h2T, PZO.h3T
              , Max(PZO.h4T, PZO.h5T, PZO.h6T, PZO.hgT))
    if (hz || hmax > 0.004 || rebindOn || PZO.sld || PZO.dragOn || PZ_solving)
        PZO.pokeAt := now
    if settled {
        keep := (thAt || hz || hmax > 0.004 || rebindOn || selFadeAt || PZ_solving || posFix
              || (puzBindFlashAt && now - puzBindFlashAt < 520)
              || (mkFlashAt && now - mkFlashAt < 520))
        deep := (!keep && !PZO.enabled && PZO.minStart = 0
              && PZO.pokeAt && now - PZO.pokeAt > HUB_DEEP_MS)
        PuzRendTim((PZO.enabled || keep) ? TICK_A : (deep ? TICK_Z : TICK_S))
    }
}

PuzOvDrawCard(f, now) {
    cx := PAD, cy := PAD
    cur := PZO.cur, pulse := PZO.pulse, emb := PZO.emb, emb2 := PZO.emb2
    stateT := PZO.stateT
    tp := PZO.togAt ? Min((now - PZO.togAt)/TOG_MS, 1.0) : 1.0
    dm := (1 - stateT)                       ; dormant weight
    hb := Mod(DecT(now), 2200)
    blink := (hb < 140 || (hb > 300 && hb < 440)) ? 1 : 0   ; standby double-blink

    ims := now - PZO.introStart
    stg := ims < 700
    s1 := stg ? Ease3((ims - 60)/340.0)  : 1.0
    s2 := stg ? Ease3((ims - 140)/340.0) : 1.0
    s3 := stg ? Ease3((ims - 220)/340.0) : 1.0
    s4 := stg ? Ease3((ims - 300)/340.0) : 1.0
    hdy := -(1 - s1)*6, ady := (1 - s2)*10, rdy := (1 - s3)*10, fdy := (1 - s4)*8

    ShadowDraw(cx, cy + 3, CW, CH, 16, 10, 7, 7 + 4*PZO.dragT, f)
    b := BgV(cx, cy, CW, CH, FA(0xF2222438, f), FA(0xF8121423, f))
    FillRR(cx, cy, CW, CH, 16, b), DelB(b)

    ab := PZO.rippleStart ? (1 - Min((now - PZO.rippleStart)/RIPPLE_MS, 1.0)) : 0
    p := RRPath(cx, cy, CW, CH, 16)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 0)
    PanelBackdrop(cx, cy, CW, CH, cur, f, now, 0.95)
    rcD := Buffer(16), NumPut("float", cx - 1, "float", cy - 1, "float", CW + 2, "float", CH + 2, rcD)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcD, "uint", FA(0x0EFFFFFF, f), "uint", 0x00FFFFFF, "int", 2, "int", 3, "ptr*", &db := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", db, "float", cx, "float", cy, "float", CW, "float", CH), DelB(db)
    if true {
        ; looping scan band: brisk emerald-white sweep armed, faint rose drift dormant
        per := PZO.enabled ? 3000.0 : 4600.0
        swp := Mod(DecT(now), per)/per
        swx := cx - 26 + (CW + 52)*swp
        c0s := (PZO.enabled ? AccHi(cur, 0.3) : cur) & 0xFFFFFF
        c1s := FA(Alpha(c0s, 16*dm + 34*stateT), f)
        rcS := Buffer(16), NumPut("float", swx - 25, "float", cy - 2, "float", 26, "float", CH + 4, rcS)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS, "uint", c0s, "uint", c1s, "int", 0, "int", 3, "ptr*", &sbA := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbA, "float", swx - 24, "float", cy, "float", 24, "float", CH), DelB(sbA)
        rcS2 := Buffer(16), NumPut("float", swx - 1, "float", cy - 2, "float", 26, "float", CH + 4, rcS2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS2, "uint", c1s, "uint", c0s, "int", 0, "int", 3, "ptr*", &sbB := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbB, "float", swx, "float", cy, "float", 24, "float", CH), DelB(sbB)
    }
    loop 2 {
        rg := 66 + A_Index*24
        b := SBrush(FA(Alpha(cur, 9 + 5*pulse + 5*emb2*dm), f*s2))
        FillEll(cx + 46 - rg, cy + 65 + ady - rg, rg*2, rg*2, b), DelB(b)
    }
    b := SBrush(FA(Alpha(cur, Min(255, 46 + 24*pulse + 16*emb*dm + 60*ab)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 14, "float", CH), DelB(b)
    b := VBrush(cx, cy, 4.5, CH, FA(Alpha(cur, Min(255, 245 + 10*ab)), f), FA(Alpha(cur, 110 + 40*emb*dm), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 4.5, "float", CH), DelB(b)
    if tp < 1 {
        e := Ease3(tp)
        bcx_ := cx + CW * (PZO.togDir = 1 ? e : 1 - e)
        sc := PZO.togDir = 1 ? 0xFFFFFF : (cur & 0xFFFFFF)
        c1 := FA(Alpha(sc, 64*(1 - tp)), f), c0 := sc & 0xFFFFFF
        rc := Buffer(16), NumPut("float", bcx_ - 29, "float", cy - 2, "float", 30, "float", CH + 4, rc)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c0, "uint", c1, "int", 0, "int", 3, "ptr*", &sb := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sb, "float", bcx_ - 28, "float", cy, "float", 28, "float", CH), DelB(sb)
        rc2 := Buffer(16), NumPut("float", bcx_ - 1, "float", cy - 2, "float", 30, "float", CH + 4, rc2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc2, "uint", c1, "uint", c0, "int", 0, "int", 3, "ptr*", &sb2 := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sb2, "float", bcx_, "float", cy, "float", 28, "float", CH), DelB(sb2)
    }
    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)

    pn := Pen(FA(0x28FFFFFF, f), 1)
    StrokeRR(cx, cy, CW, CH, 16, pn), DelP(pn)
    pn := Pen(FA(0x16FFFFFF, f), 1)
    Line(cx + 18, cy + 1.5, cx + CW - 18, cy + 1.5, pn), DelP(pn)
    pn := Pen(FA(0x30000000, f), 1)
    Line(cx + 18, cy + CH - 1.5, cx + CW - 18, cy + CH - 1.5, pn), DelP(pn)
    ; corner glints twinkle in sequence
    loop 4 {
        k := A_Index - 1
        shim := (Sin(DecT(now)*(PZO.enabled ? 0.006 : 0.003) + k*1.5708) + 1)/2
        ga := Min(255, 105 + 40*pulse*stateT + 38*shim*dm + 58*shim*stateT + 100*(1 - tp))
        xk := (k = 1 || k = 2) ? cx + CW - 31.5 : cx + 0.5
        yk := (k >= 2) ? cy + CH - 31.5 : cy + 0.5
        ang := k = 0 ? 195 : k = 1 ? 285 : k = 2 ? 15 : 105
        pn := Pen(FA(Alpha(cur, ga), f), 2)
        Arc(xk, yk, 31, 31, ang, 60, pn), DelP(pn)
    }
    FadeLine(cx + 20, cx + CW - 20, cy + 30, 0x30FFFFFF, f)
    FadeLine(cx + 20, cx + CW - 20, cy + 100, 0x30FFFFFF, f)

    Txt(APPNAME, cx + 36, cy + 6 + hdy, 90, 20, fBrand, FA(0xCFE8EAF6, f*s1), fmtL)
    b := SBrush(FA(Alpha(cur, PZO.enabled ? 200 + 55*pulse : Min(255, 150 + 35*emb2 + 48*blink)), f*s1))
    FillEll(cx + 36 + wZeal + 6, cy + 13.5 + hdy, 5, 5, b), DelB(b)
    if (PZO.hgT > 0.01 || PZO.dragT > 0.01) {
        gg := Max(PZO.hgT, PZO.dragT)
        b := SBrush(FA(Alpha(cur, Round(30*gg)), f*s1))
        FillRR(cx + CW/2 - 17, cy + 7 + hdy, 34, 17, 7, b), DelB(b)
        pn := Pen(FA(Alpha(cur, Round(90*gg)), f*s1), 1)
        StrokeRR(cx + CW/2 - 17, cy + 7 + hdy, 34, 17, 7, pn), DelP(pn)
    }
    gLift := 0.9*PZO.hgT
    gDot := 2.4 + 0.8*PZO.hgT
    gOff := (gDot - 2.4)/2
    b := SBrush(FA(Alpha(Mix(0xFFFFFF, cur, 0.6*PZO.hgT), Round(46 + 105*PZO.hgT)), f*s1))
    loop 6 {
        gc := Mod(A_Index - 1, 3), gr := (A_Index - 1) // 3
        gwv := PZO.hgT*1.1*Sin(DecT(now)*0.006 - gc*0.9)
        FillEll(cx + CW/2 - 8.2 + gc*7 - gOff, cy + 11.8 + gr*5.6 + hdy - gOff - gLift + gwv, gDot, gDot, b)
    }
    DelB(b)
    em := 1 + 0.28*PZO.h1T, ec := 1 + 0.28*PZO.h2T
    bmx_ := BMX - 3*PZO.h2T, bcx_ := BCX + 3*PZO.h1T
    ym := BTY + hdy - 1.2*PZO.h1T, yc := BTY + hdy - 1.2*PZO.h2T
    b := SBrush(FA(Alpha(0xFFFFFF, 22 + 34*PZO.h1T), f*s1))
    FillEll(bmx_ - 7*em, ym - 7*em, 14*em, 14*em, b), DelB(b)
    pn := Pen(FA(Alpha(0xFFFFFF, 42 + 60*PZO.h1T), f*s1), 1)
    Ell(bmx_ - 7*em, ym - 7*em, 14*em, 14*em, pn), DelP(pn)
    pn := Pen(FA(Alpha(0xE8EAF6, 168 + 87*PZO.h1T), f*s1), 1.5)
    Line(bmx_ - 3.5*em, ym, bmx_ + 3.5*em, ym, pn), DelP(pn)
    b := SBrush(FA(Alpha(hubAccent, 36 + 60*PZO.h2T), f*s1))
    FillEll(bcx_ - 7*ec, yc - 7*ec, 14*ec, 14*ec, b), DelB(b)
    pn := Pen(FA(Alpha(hubAccent, 100 + 80*PZO.h2T), f*s1), 1)
    Ell(bcx_ - 7*ec, yc - 7*ec, 14*ec, 14*ec, pn), DelP(pn)
    pn := Pen(FA(Alpha(AccHi(hubAccent, 0.4), 210 + 45*PZO.h2T), f*s1), 1.5)
    Line(bcx_ - 3.2*ec, yc - 3.2*ec, bcx_ + 3.2*ec, yc + 3.2*ec, pn)
    Line(bcx_ - 3.2*ec, yc + 3.2*ec, bcx_ + 3.2*ec, yc - 3.2*ec, pn), DelP(pn)

    ax := cx + 46, ay := cy + 65 + ady
    if PZO.enabled {
        loop 3 {
            r_ := 27 + A_Index * (2.0 + 1.8*pulse)
            b := SBrush(FA(Alpha(cur, 20 - A_Index*5), f*s2))
            FillEll(ax - r_, ay - r_, r_*2, r_*2, b), DelB(b)
        }
    }
    DrawAvatar(ax, ay, 26, f*s2)
    if PZO.hovT > 0.01 {
        he := PZO.hovT
        ep := 0
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
        DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", ax - 26, "float", ay - 26, "float", 52, "float", 52)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 0)
        b := SBrush(FA(Alpha(0x05060C, 158*he), f*s2))
        FillEll(ax - 26, ay - 26, 52, 52, b), DelB(b)
        gy := ay - 13 + (1 - he)*7
        pn := Pen(FA(Alpha(0xFFFFFF, 210*he), f*s2), 1.2)
        StrokeRR(ax - 7, gy, 14, 10, 2, pn)
        Line(ax - 4.5, gy + 7.5, ax - 1.5, gy + 3.5, pn)
        Line(ax - 1.5, gy + 3.5, ax + 2, gy + 7.5, pn)
        Line(ax + 2, gy + 7.5, ax + 4.5, gy + 5, pn), DelP(pn)
        b := SBrush(FA(Alpha(0xFFFFFF, 220*he), f*s2))
        FillEll(ax + 2.2, gy + 1.6, 2.2, 2.2, b), DelB(b)
        Txt("CHANGE", ax - 26, ay + 2 + (1 - he)*7, 52, 14, fBadge, FA(Alpha(0xFFFFFF, 245*he), f*s2), fmtC)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", ep)
    }
    pn := Pen(FA(0x50000000, f*s2), 1)
    Ell(ax - 25, ay - 25, 50, 50, pn), DelP(pn)
    RingDraw(ax, ay, 26.5, AccHi(cur, 0.5*PZO.hovT), f*s2, PZO.hovT)
    if PZO.enabled {
        sa := Mod(now * 0.09, 360)
        cc := AccHi(cur, 0.4)
        pn := Pen(FA(Alpha(cc, 80), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa, 64, pn), DelP(pn)
        pn := Pen(FA(Alpha(cc, 160), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa + 24, 40, pn), DelP(pn)
        pn := Pen(FA(Alpha(cc, 245), f*s2), 2.7)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa + 44, 20, pn), DelP(pn)
        sb2_ := 360 - Mod(DecT(now)*0.06, 360)
        pn := Pen(FA(Alpha(cur, 90), f*s2), 1.8)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sb2_, 40, pn), DelP(pn)
    } else {
        ; dormant scanner: soft tapered comet circling the avatar ring
        da := Mod(DecT(now)*0.055, 360)
        pn := Pen(FA(Alpha(cur, 55), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, da, 50, pn), DelP(pn)
        pn := Pen(FA(Alpha(cur, Min(255, 120 + 45*emb2)), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, da + 30, 20, pn), DelP(pn)
    }

    ; ========================================================================
    ;  CONTENTS
    ;  Everything above this line is the block card's chrome, unchanged. From
    ;  here down it is PUZZLE AI's own four facts:
    ;      1  boards solved
    ;      2  the SOLVE keybind
    ;      3  the GRID keybind
    ;      4  the speed slider, on the same PZ_SpeedT the hub card drives
    ;  The block card's mouse-and-Q glyph, its ENABLED/DISABLED pill and its
    ;  shield are gone with the meaning they carried. Their construction is
    ;  reused rather than reinvented - the count sits in the pill the state used
    ;  to, and the badges are the block keybind badge twice.
    ; ========================================================================
    bw0 := CW - 108                          ; content column width, clear of the avatar

    ; ---- boards solved ----
    ; The pill the block card gives its state. A count is what this module has
    ; instead, and it is the one number worth reading from across the room, so
    ; it gets the same weight - and the same ripple when it changes.
    rowY := cy + 48 + rdy
    b := SBrush(FA(Alpha(cur, Min(255, (120 + 120*(Sin(DecT(now)*0.006) + 1)/2)*Max(stateT, 0.35) + 50*blink*dm)), f*s3))
    FillEll(cx + 89, rowY - 2, 4, 4, b), DelB(b)
    Txt("puzzles solved", cx + 98, rowY - 8, 120, 16, fHint, FA(0x62C7CBE0, f*s3), fmtL)

    cnt := String(PZ_total)
    pw_ := Max(78, MeasureW(cnt, fStatus) + 46)
    px1 := cx + CW - 20 - pw_
    ps := tp < 1 ? 1 + 0.07*Sin(3.14159*Min(tp*1.5, 1.0)) : 1
    stP := PushXform(px1 + pw_/2, rowY, ps, 0)
    b := VBrush(px1, rowY - 14, pw_, 28, FA(Alpha(cur, 58), f*s3), FA(Alpha(cur, 26), f*s3))
    FillRR(px1, rowY - 14, pw_, 28, 14, b), DelB(b)
    MicroBackdrop(px1, rowY - 14, pw_, 28, 14, cur, f*s3, now, 0.85)
    pn := Pen(FA(Alpha(cur, 105), f*s3), 1)
    StrokeRR(px1, rowY - 14, pw_, 28, 14, pn), DelP(pn)
    dx := px1 + 15, dy := rowY
    if PZ_solving {
        loop 3 {
            r_ := 5 + A_Index * (2.6 + 2.2*pulse)
            b := SBrush(FA(Alpha(cur, 26 - A_Index*6), f*s3))
            FillEll(dx - r_, dy - r_, r_*2, r_*2, b), DelB(b)
        }
    }
    b := SBrush(FA(Alpha(cur, PZ_solving ? 250 : Min(255, 165 + 30*emb2 + 50*blink)), f*s3))
    FillEll(dx - 4, dy - 4, 8, 8, b), DelB(b)
    b := SBrush(FA(0x8CFFFFFF, f*s3))
    FillEll(dx - 2.4, dy - 2.6, 1.8, 1.8, b), DelB(b)
    if PZ_solving {
        oa := now*0.0042
        b := SBrush(FA(Alpha(AccHi(cur, 0.5), 220), f*s3))
        FillEll(dx + 7.5*Cos(oa) - 1.3, dy + 7.5*Sin(oa) - 1.3, 2.6, 2.6, b), DelB(b)
    }
    Txt(cnt, dx + 10, rowY - 12, pw_ - 34, 24, fStatus, FA(Alpha(cur, 245), f*s3), fmtL)
    if PZO.rippleStart {
        rt := (now - PZO.rippleStart)/RIPPLE_MS
        if rt >= 1
            PZO.rippleStart := 0
        else {
            e := 1 - (1 - rt)**3
            pn := Pen(FA(Alpha(cur, 150*(1 - e)), f*s3), 2.4*(1 - e) + 0.4)
            r_ := 5 + e*24
            Ell(dx - r_, dy - r_, r_*2, r_*2, pn), DelP(pn)
        }
    }
    Pop(stP)

    ; ---- speed ----
    ; The SAME number as the hub card's slider, not a copy of it: both read and
    ; write PZ_SpeedT and both call PuzSpeedApply, so there is nothing to keep
    ; in step. Moving either one repaints the other on its next frame.
    ; Built the way the hub's is - track, end ticks, shadowed knob with an
    ; accent core - so the two are recognisably one control in two places.
    slx := PuzOvSlideX(), slw := PuzOvSlideW(), sly := PuzOvSlideY() + rdy
    fsl := f*s3
    hvS := PZO.h5T
    Txt("speed", cx + 88, sly - 25, 44, 16, fHint, FA(0x62C7CBE0, fsl), fmtL)
    ; the percentage is the control; the frame rate it implies is what you can
    ; check against your client, so it rides alongside rather than underneath -
    ; this card has no spare row for a caveat line
    Txt(PuzSpeedPct() "%  ·  " PuzSpeedFps() " fps", cx + 140, sly - 24, bw0 - 52, 14
        , HL.fXs, FA(Alpha(PZ_SpeedT > 0.72 ? AMBER : 0xFFC7CBE0, 190), fsl), fmtR)
    b := SBrush(FA(Alpha(0xFFFFFF, 26), fsl))
    FillRR(slx, sly - 1.5, slw, 3, 1.5, b), DelB(b)
    b := SBrush(FA(Alpha(cur, 190), fsl))
    FillRR(slx, sly - 1.5, slw*PZ_SpeedT, 3, 1.5, b), DelB(b)
    loop 2 {
        b := SBrush(FA(Alpha(0xFFFFFF, 40), fsl))
        FillRR(slx + (A_Index - 1)*slw, sly - 5, 1, 10, 0.5, b), DelB(b)
    }
    knx := slx + slw*PZ_SpeedT
    kr2 := 6 + 1.6*hvS + (PZO.sld ? 1.4 : 0)
    b := SBrush(FA(Alpha(0x000000, 90), fsl))
    FillEll(knx - kr2, sly - kr2 + 1.5, kr2*2, kr2*2, b), DelB(b)
    b := SBrush(FA(Alpha(0xFEFEFE, 245), fsl))
    FillEll(knx - kr2, sly - kr2, kr2*2, kr2*2, b), DelB(b)
    b := SBrush(FA(Alpha(cur, 215), fsl))
    FillEll(knx - 2.2, sly - 2.2, 4.4, 4.4, b), DelB(b)

    ; ---- the two keybinds ----
    ; The block card's badge, twice. Geometry comes from PuzOvKeyGeom so the
    ; renderer and the hit test cannot drift - the second badge's x depends on
    ; the first badge's width, which changes with the key that is bound.
    ; "???" is shown only on the badge actually being captured: the rebind flow
    ; is shared three ways, so a capture aimed at AUTOBLOCK or at the other row
    ; must leave this one reading its own key.
    hy := cy + 116 + fdy
    capOn := (rebindOn && (rebindTgt = 2 || rebindTgt = 3))
    PuzOvKeyGeom(&b1x, &b1w, &l1x, &b2x, &b2w, &l2x)
    loop 2 {
        kk  := A_Index
        tgt := kk + 1                                   ; 2 = solve, 3 = grid
        mine := (rebindOn && rebindTgt = tgt)
        kbx := (kk = 1) ? b1x : b2x
        kbw := (kk = 1) ? b1w : b2w
        klx := (kk = 1) ? l1x : l2x
        lbl := mine ? "???" : ((kk = 1) ? puzLabel : mkLabel)
        cap := (kk = 1) ? "solve" : "grid"
        hvK := (kk = 1) ? PZO.h4T : PZO.h6T
        fla := (kk = 1) ? puzBindFlashAt : mkFlashAt
        rbp := mine ? (Sin(DecT(now)*0.01) + 1)/2 : 0.0
        fl  := fla ? Clamp(1 - (now - fla)/520.0, 0.0, 1.0) : 0.0
        hk_ := Max(hvK, rbp)
        by_ := hy - 10 - 0.9*hvK
        stK := PushXform(kbx + kbw/2, hy, 1 + 0.05*hvK + 0.03*rbp, 0)
        if hk_ > 0.01 || fl > 0 {
            b := SBrush(FA(Alpha(cur, 24*hvK + 30*rbp + 55*fl), f*s4))
            FillRR(kbx - 4, by_ - 4, kbw + 8, 28, 9, b), DelB(b)
        }
        b := VBrush(kbx, by_, kbw, 20, FA(Mix(0xFF343752, 0xFF41466A, hk_), f*s4), FA(Mix(0xFF1C1E33, 0xFF262A45, hk_), f*s4))
        FillRR(kbx, by_, kbw, 20, 6, b), DelB(b)
        MicroBackdrop(kbx, by_, kbw, 20, 6, cur, f*s4, now, 0.9)
        pn := Pen(FA(Mix(0x26FFFFFF, Alpha(cur, 190), Max(hk_, fl)), f*s4), 1)
        StrokeRR(kbx, by_, kbw, 20, 6, pn), DelP(pn)
        tc := mine ? TH(Alpha(cur, 205 + 50*rbp)) : THMix(0x96E8EAF6, 0xF0FFFFFF, Max(hvK, fl))
        TxtP(lbl, kbx, by_, kbw, 20, fBadge, FA(tc, f*s4), fmtC)
        if mine {
            prt := Mod(now - rebindAt, 900)/900.0
            ex := prt*9
            pn := Pen(FA(Alpha(cur, 130*(1 - prt)), f*s4), 1.8*(1 - prt) + 0.3)
            StrokeRR(kbx - ex, by_ - ex*0.6, kbw + ex*2, 20 + ex*1.2, 6 + ex*0.4, pn), DelP(pn)
        } else if fl > 0 {
            ex := (1 - fl)*10
            pn := Pen(FA(Alpha(cur, 170*fl), f*s4), 2.2*fl + 0.3)
            StrokeRR(kbx - ex, by_ - ex*0.6, kbw + ex*2, 20 + ex*1.2, 6 + ex*0.4, pn), DelP(pn)
        }
        Pop(stK)
        ; The caption sits in the gap its own badge leaves. It gives way while a
        ; capture is running: "press any key" is wider than that gap and would
        ; have run straight under the other badge, so the prompt is drawn ONCE
        ; below, for whichever of the two is being captured.
        if !capOn
            Txt(cap, klx, hy - 10, (kk = 1) ? (b2x - klx - 8) : (cx + CW - 20 - klx), 20
                , fHint, FA(0x6EC7CBE0, f*s4), fmtL)
    }
    if capOn {
        cpp := (Sin(DecT(now)*0.01) + 1)/2
        Txt("press any key", cx + CW - 130, hy - 10, 110, 20, fHint
            , FA(Alpha(cur, 150 + 55*cpp), f*s4), fmtR)
    }

    if PZO.dragT > 0.01 {
        d := PZO.dragT
        b := SBrush(FA(Alpha(0x0B0C14, 122*d), f))
        FillRR(cx, cy, CW, CH, 16, b), DelB(b)
        pn := Pen(FA(Alpha(cur, 205*d), f), 1.6)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
        StrokeRR(cx + 3, cy + 3, CW - 6, CH - 6, 13, pn), DelP(pn)
        mcx := cx + CW/2, mcy := cy + CH/2 - 7
        pn := Pen(FA(Alpha(0xFFFFFF, 225*d), f), 1.8)
        loop 4 {
            a_ := (A_Index - 1) * 1.5708
            x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
            Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
        }
        DelP(pn)
        Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, FA(Alpha(0xFFFFFF, 235*d), f), fmtC)
    }
}

PuzOvDrawBubble(f, now) {
    cur := PZO.cur, pulse := PZO.pulse, emb := PZO.emb
    tp := PZO.togAt ? Min((now - PZO.togAt)/TOG_MS, 1.0) : 1.0
    sct := (PZO.scatAt && now - PZO.scatAt < 380) ? (now - PZO.scatAt)/380.0 : -1
    hx := PZO.h3T
    bcol := PZO.enabled ? cur : AccHi(cur, 0.14)   ; lifted dormant rose
    if PZO.enabled {
        loop 3 {
            r_ := 31 + A_Index * (2.4 + 2.2*pulse) + 3*hx
            b := SBrush(FA(Alpha(cur, 22 - A_Index*6 + 8*hx), f))
            FillEll(BBX - r_, BBY - r_, r_*2, r_*2, b), DelB(b)
        }
    } else if hx > 0.01 {
        b := SBrush(FA(Alpha(cur, 26*hx), f))
        FillEll(BBX - 36, BBY - 36, 72, 72, b), DelB(b)
    }
    loop 5 {
        b := SBrush(FA(Alpha(0x000000, 9 + 4*PZO.dragT), f))
        FillEll(BBX - 30 - A_Index, BBY - 28 - A_Index, 60 + A_Index*2, 60 + A_Index*2, b), DelB(b)
    }
    crA := PZO.enabled ? 15 : Mod(DecT(now)*0.02, 360)
    pn := Pen(FA(Alpha(bcol, PZO.enabled ? 55 + 30*pulse : 62 + 30*emb), f), 5)
    Arc(BBX - 33, BBY - 33, 66, 66, crA, 120, pn), DelP(pn)
    DrawAvatar(BBX, BBY, 30, f)
    ; hover: darken the portrait, OPEN slides in
    if hx > 0.01 {
        ep := 0
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
        DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", BBX - 30, "float", BBY - 30, "float", 60, "float", 60)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 0)
        b := SBrush(FA(Alpha(0x05060C, 152*hx), f))
        FillEll(BBX - 30, BBY - 30, 60, 60, b), DelB(b)
        gy := BBY - 12 + (1 - hx)*7
        pn := Pen(FA(Alpha(0xFFFFFF, 215*hx), f), 1.6)
        Line(BBX - 5, gy + 4, BBX, gy - 1, pn)
        Line(BBX, gy - 1, BBX + 5, gy + 4, pn)
        Line(BBX - 5, gy + 10, BBX, gy + 5, pn)
        Line(BBX, gy + 5, BBX + 5, gy + 10, pn), DelP(pn)
        Txt("OPEN", BBX - 26, BBY + 3 + (1 - hx)*7, 52, 14, fBadge, FA(Alpha(0xFFFFFF, 245*hx), f), fmtC)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", ep)
    }
    pn := Pen(FA(0x2EFFFFFF, f), 1)
    Ell(BBX - 26, BBY - 26, 52, 52, pn), DelP(pn)
    pn := Pen(FA(0x50000000, f), 1)
    Ell(BBX - 29, BBY - 29, 58, 58, pn), DelP(pn)
    pn := Pen(FA(0x66000000, f), 1)
    Ell(BBX - 32, BBY - 32, 64, 64, pn), DelP(pn)
    if PZO.enabled {
        aa := Mod(DecT(now)*0.05, 360)
        flash := (PZO.togDir = 1 && tp < 1) ? (1 - tp)*0.6 : 0
        cc := AccHi(cur, flash)
        loop 2 {
            base := aa + (A_Index - 1)*180
            pn := Pen(FA(Alpha(cc, 78), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base, 104, pn), DelP(pn)
            pn := Pen(FA(Alpha(cc, 160), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base + 40, 64, pn), DelP(pn)
            pn := Pen(FA(Alpha(cc, 245), f), 2.8)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base + 76, 28, pn), DelP(pn)
        }
        ; counter-rotating faint arcs one ring inward
        ba2 := Mod(-now*0.07, 360)
        pn := Pen(FA(Alpha(cur, 70), f), 1.6)
        Arc(BBX - 33.2, BBY - 33.2, 66.4, 66.4, ba2, 58, pn)
        Arc(BBX - 33.2, BBY - 33.2, 66.4, 66.4, ba2 + 180, 58, pn), DelP(pn)
    } else {
        flick := (PZO.togDir = -1 && tp < 1) ? 0.55 + 0.45*Abs(Sin(DecT(now)*0.045)) : 1
        loop 4 {
            emb_ := 150 + 85*(Sin(DecT(now)*0.0022 + (A_Index - 1)*1.5708) + 1)/2
            pn := Pen(FA(Alpha(bcol, Min(255, emb_)*flick), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, (A_Index - 1)*90 + 25 + 6*Sin(DecT(now)*0.0011), 40, pn)
            DelP(pn)
        }
    }
    pn := Pen(FA(Alpha(bcol, (PZO.enabled ? 24 : 32) + 20*hx), f), 1)
    Ell(BBX - 35.2 - 2.5*hx, BBY - 35.2 - 2.5*hx, 70.4 + 5*hx, 70.4 + 5*hx, pn), DelP(pn)
    head := Mod(DecT(now)*0.18, 360)
    head2 := 360 - Mod(DecT(now)*0.11, 360)
    drift := Mod(DecT(now)*0.008, 360)
    glint := Mod(DecT(now)*0.055, 360)
    igniteA := (PZO.togDir = 1 && tp < 1) ? 360*Ease3(tp) : -1
    extingA := (PZO.togDir = -1 && tp < 1) ? 360*Ease3(tp) : -1
    loop 24 {
        segA := (A_Index - 1)*15
        boost := 0.0
        if PZO.enabled {
            d_ := Mod(segA - head + 540, 360) - 180
            boost := Max(0.0, Cos(d_*0.017453))**7
            d2 := Mod(segA - head2 + 540, 360) - 180
            al := Min(255, 34 + 210*boost + 95*Max(0.0, Cos(d2*0.017453))**5)
            colr := cur
            segD := segA
            if igniteA >= 0
                al := segA <= igniteA ? 255 : 22, colr := segA <= igniteA ? AccHi(cur, 0.5*(1 - tp)) : cur
        } else {
            segD := segA + drift
            g_ := Mod(segD - glint + 540, 360) - 180
            al := (Mod(A_Index, 2) ? 85 : 44) + 110*Max(0.0, Cos(g_*0.017453))**5
            colr := bcol
            if extingA >= 0 && segA <= extingA
                al := 16
        }
        rr_ := (Mod(A_Index, 2) ? 34.0 : 36.2) + 2.5*hx
        if sct >= 0 {
            e := Ease3(sct)
            rr_ += 16*e
            al *= (1 - e)
        }
        sw := 6 + 5*boost
        pn := Pen(FA(Alpha(colr, al), f), 2.2)
        Arc(BBX - rr_ - 0.5, BBY - rr_ - 0.5, rr_*2 + 1, rr_*2 + 1, (PZO.enabled ? segA : segD) + (15 - sw)/2, sw, pn), DelP(pn)
    }
    ; dotted counter-march ring + outer twinkle ticks
    pn := Pen(FA(Alpha(bcol, PZO.enabled ? 70 : 55 + 20*emb), f), 1.3)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
    DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", 1000 - Mod(DecT(now)*0.02, 1000))
    Ell(BBX - 38.8, BBY - 38.8, 77.6, 77.6, pn), DelP(pn)
    tb := -now*0.012
    loop 12 {
        a_ := (tb + A_Index*30)*0.017453
        tw := (Sin(DecT(now)*0.002 + A_Index*0.52) + 1)/2
        al := PZO.enabled ? 45 + 70*tw : 38 + 42*tw
        pn := Pen(FA(Alpha(bcol, al), f), 1.3)
        Line(BBX + 40*Cos(a_), BBY + 40*Sin(a_), BBX + 42.6*Cos(a_), BBY + 42.6*Sin(a_), pn), DelP(pn)
    }
    if PZO.enabled {
        ha := head*0.017453
        b := SBrush(FA(Alpha(AccHi(cur, 0.6), 255), f))
        FillEll(BBX + 35.1*Cos(ha) - 2.2, BBY + 35.1*Sin(ha) - 2.2, 4.4, 4.4, b), DelB(b)
        loop 3 {
            k := A_Index - 1
            twA := (k*120 + now*0.02)*0.017453
            twI := Max(0.0, Sin(DecT(now)*0.003 + k*2.1))**9
            b := SBrush(FA(Alpha(0xFFFFFF, 200*twI), f))
            FillEll(BBX + 35*Cos(twA) - 1.4, BBY + 35*Sin(twA) - 1.4, 2.8, 2.8, b), DelB(b)
        }
    }
    if hx > 0.01 {
        prt := Mod(DecT(now), 950)/950.0
        pn := Pen(FA(Alpha(cur, 130*hx*(1 - prt)), f), 2.2*(1 - prt) + 0.4)
        r_ := 31 + prt*11
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if sct >= 0 {
        e := Ease3(sct)
        pn := Pen(FA(Alpha(0xFFFFFF, 190*(1 - e)), f), 2.6*(1 - e) + 0.4)
        r_ := 30 + e*12
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if PZO.togDir = 1 && tp > 0.5 && tp < 1 {
        e := (tp - 0.5)/0.5
        pn := Pen(FA(Alpha(cur, 150*(1 - e)), f), 2.4*(1 - e) + 0.4)
        r_ := 30 + e*22
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if PZO.burstAt && now >= PZO.burstAt {
        btm := (now - PZO.burstAt)/450.0
        if btm >= 1
            PZO.burstAt := 0
        else {
            e := 1 - (1 - btm)**3
            pn := Pen(FA(Alpha(cur, 170*(1 - e)), f), 2.6*(1 - e) + 0.4)
            r_ := 30 + e*18
            Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
        }
    }
    qx := BBX + 12, qy := BBY + 12
    b := SBrush(FA(0x59000000, f))
    FillEll(qx + 1, qy + 2.5, 20, 19, b), DelB(b)
    b := VBrush(qx, qy, 20, 20, FA(0xFF3A3D58, f), FA(0xFF20223A, f))
    FillRR(qx, qy, 20, 20, 6, b), DelB(b)
    MicroBackdrop(qx, qy, 20, 20, 6, cur, f, now, 0.8)
    pn := Pen(FA(Alpha(cur, 150 + 70*(PZO.enabled ? pulse : emb)), f), 1)
    StrokeRR(qx, qy, 20, 20, 6, pn), DelP(pn)
    ; the block bubble stamps a "Q" here; this one stamps whatever PUZZLE AI is
    ; bound to. fBadge rather than HL.fXs for the wide case - HL is the integer 0
    ; until the hub has been opened once, and a 20px cap has no room for fBrand
    ; past a single character anyway.
    bcap := (puzKey = "") ? "?" : puzLabel
    Txt(bcap, qx, qy, 20, 20, StrLen(bcap) <= 1 ? fBrand : fBadge, FA(Alpha(cur, 240), f), fmtC)

    if PZO.dragT > 0.01 {
        d := PZO.dragT
        b := SBrush(FA(Alpha(0x0B0C14, 118*d), f))
        FillEll(BBX - 30, BBY - 30, 60, 60, b), DelB(b)
        pn := Pen(FA(Alpha(cur, 200*d), f), 1.6)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
        Ell(BBX - 36, BBY - 36, 72, 72, pn), DelP(pn)
    }
}

; ---- cell-centre markers ----
; The grid of ticks the solver will actually click, drawn over the board so
; the calibration can be checked by looking at it.
;
; This was the last surface in the suite that was not DRAWN: one Text control per cell
; with BackgroundSilver on a TransColor key, in the only Gui in the file created
; without -DPIScale. That omission is not cosmetic. Without it AHK multiplies
; every coordinate handed to Show() and Add() by A_ScreenDPI/96, while the
; solver drives the mouse in raw pixels through SendInput - so on any display
; above 100% the markers were drawn somewhere the solver was never going to
; click, drifting further out the further they got from the origin, and the one
; thing they exist to verify was the one thing they could not be trusted about.
; A layered surface addressed in screen pixels cannot have that bug.
;
; Drawn ONCE per show, with no timer. Every other overlay here animates; this
; one is a reference mark that is meant to be up permanently while solving, and
; a third Critical renderer competing with the walk is exactly what the pacing
; work spent its time removing.
global PZ_mk := ""              ; the marker window, or "" when it does not exist
global PZ_mkDc := 0, PZ_mkBm := 0, PZ_mkG := 0
global PZ_mkX := 0, PZ_mkY := 0, PZ_mkW := 0, PZ_mkH := 0
; ---- DEBUG READOUT ----
; A raw dump of the numbers the grid is actually made of, drawn beside the
; markers. Deliberately undesigned: monospace, flat backing, no animation, no
; accent, no easing. It exists to be READ against the board, and anything that
; makes it prettier makes it slower to check a coordinate against.
;
; 0 turns it off and the surface goes back to exactly the board's extent.
; ---- THE BOARD MOVES. THE GRID DOES NOT. ----
; Measured off two full-screen captures of the same client: with the three-line
; banner above it ("Completing four puzzles will fix the generator") the board's
; own white frame sits at y=324 and every dot row is 54 px lower; without it the
; frame is at y=270 and every row lands on the calibration to within half a
; pixel. Columns are identical either way. Same 54 px in three independent
; measurements taken weeks apart.
;
; The distinction that matters: this does NOT touch the grid. PZ_X0 and friends
; are still constants and still unassignable; PZ_boardDy is a separate,
; QUANTISED offset with exactly two legal values, re-read from the screen before
; each board and never written to disk. It is not a search and it is not a fit -
; it is one boolean question with two known answers, and the debug panel shows
; which one it got so it can never be invisible.
global PZ_BannerFix := 1         ; 0 pins the offset at 0 and ignores the banner
; From the reference table, not from the board's scale - measured at 39 px on a
; 1024x768 client against 54 on 1080p, a ratio of 0.722 that tracks viewport
; HEIGHT while the board tracks something else entirely. Scaling it with the
; board would have put it at 27.
PZ_BannerDy() => Round(PuzDefRef().ban)
global PZ_boardDy   := 0         ; the live offset: 0 or PZ_BannerDy()
global PZ_dyPin     := 0         ; 1 once a button has been pressed this session
global PZ_MkDbg  := 1
global PZ_MKDBGW := 286         ; the column, in screen pixels
global PZ_MKDBGH := 500         ; ... and the floor its content needs
; PZ_mkWant - the persisted PREFERENCE - is declared up with the boot sequence,
; ahead of the ini read that restores it. It was declared here, which ran after
; that read and put it back to 1 on every launch; see the note there.
global PZ_mkHid := 0            ; suspended for a solve or for grid setup
global PZ_mkKey := ""           ; the grid the current surface was drawn for

; Is a set of grid numbers usable? Bounds as well as sanity: a grid calibrated
; on a monitor that has since been unplugged, or at a resolution that is no
; longer current, describes a board that is not on screen - and the solver would
; happily drag the mouse across empty desktop rather than say so.
; ---- SANITY ONLY. Never the screen. ----
; This used to check that the far corner of the grid landed inside the CURRENT
; virtual screen, and both the load and the save were gated on it. That single
; test is the reason a calibration could vanish: PZ_vw/PZ_vh are whatever the
; last GetSystemMetrics read said, and a client going fullscreen, a monitor
; asleep, a second display not attached yet at launch, or a mode change caught
; mid-transition all shrink it for a moment. In that moment the user's own
; numbers stopped being "valid" - so PuzGridLoad refused to load them and used
; the default instead, and PuzGridSave refused to write them at all. From the
; outside that is exactly "my grid did not save" and "the grid moved by itself",
; and it is driven by resolution and by what else is open, which is the one
; thing the grid must never depend on.
;
; So the screen is out of it entirely.
;
; PuzGridValid and PuzGridOK lived here and are gone with the rest. They asked
; whether the four numbers were sane - a question that could only fail on a
; value that arrived from somewhere, and nothing arrives any more. A literal
; cannot be corrupt. When the setting system returns and the numbers can come
; from a file again, so does the check.
; ---- separate question, and it never feeds back ----
; "Is the grid on the screen that is in front of me right now" is worth
; ASKING before a solve - dragging the cursor across empty desktop helps
; nobody - but the answer must never change the grid, reject it on load or
; stop it being saved. It is a reason to decline to act, and nothing else.
; That separation is the whole point: what the grid IS and what the screen
; currently looks like are now two facts that never touch.
PuzGridOnScreen() {
    if (PZ_vw < 1)
        PuzScreenSync()
    lx := PZ_X0() + (PZ_GridN() - 1)*PZ_SX()
    ly := PZ_Y0() + (PZ_GridN() - 1)*PZ_SY()
    return (PZ_X0() > PZ_vx - 2 && PZ_Y0() > PZ_vy - 2
         && lx < PZ_vx + PZ_vw + 2 && ly < PZ_vy + PZ_vh + 2)
}

; The user-facing toggle. This is the ONLY entry point that writes the
; preference - everything internal goes through Suspend or Apply, because a
; module disarm, a grid setup, a display change and script exit all used to call
; PuzMarkers(0) and would each have silently turned the preference off.
PuzMarkers(mode := -1) {
    global PZ_mkWant
    PZ_mkWant := (mode = -1) ? !PZ_mkWant : (mode ? 1 : 0)
    try IniWrite(PZ_mkWant, iniPath, "puzzle", "markers")
    PuzMarkersApply()
}
; Hide without forgetting. Used while a solve runs and while grid setup runs.
PuzMarkersSuspend(on) {
    global PZ_mkHid
    PZ_mkHid := on ? 1 : 0
    PuzMarkersApply()
}
; Make the window agree with the state. Idempotent, so anything may call it.
PuzMarkersApply() {
    global PZ_mk
    ; Same guard as the solve. The markers are the only thing that SHOWS the
    ; grid, so markers drawn from a stale table are the symptom being debugged
    ; rather than a way of debugging it. Skipped while solving - PuzSolve has
    ; already guarded, and re-entering it mid-board would rebuild the surface
    ; underneath a drag.
    if (PZ_mkWant && puzOn && !PZ_mkHid && !PZ_solving) {
        PuzScreenGuard()
        PuzBoardApply()
    }
    show := (PZ_mkWant && puzOn && !PZ_mkHid)
    if !show {
        if (PZ_mk != "")
            try DllCall("ShowWindow", "ptr", PZ_mk.Hwnd, "int", 0)     ; SW_HIDE
        PuzDbgApply()
        return
    }
    PuzMarkersBuild()                  ; the grid may have moved since last time
    ; SW_SHOWNA rather than Gui.Show for the same reason the creation above does
    ; not use it: this must not move the window, only reveal it.
    if (PZ_mk != "")
        try DllCall("ShowWindow", "ptr", PZ_mk.Hwnd, "int", 8)
    PuzDbgApply()                      ; the inspector follows the markers
}
PuzMarkersKill() {
    global PZ_mk, PZ_mkDc, PZ_mkBm, PZ_mkG, PZ_mkKey
    if (PZ_mk != "") {
        try PZ_mk.Destroy()
        PZ_mk := ""
    }
    if PZ_mkG
        try DllCall("gdiplus\GdipDeleteGraphics", "ptr", PZ_mkG)
    if PZ_mkDc
        try DllCall("gdi32\DeleteDC", "ptr", PZ_mkDc)
    if PZ_mkBm
        try DllCall("gdi32\DeleteObject", "ptr", PZ_mkBm)
    PZ_mkG := 0, PZ_mkDc := 0, PZ_mkBm := 0
    PZ_mkKey := ""          ; or the next Build would skip itself as already correct
}

; ---- the debug dump ----
; Every number the grid is made of, plus the ones derived from it that are worth
; checking against the board by eye: where the corners land, what region gets
; captured, where the scan samples. Monospace so the columns line up and a value
; can be compared down the list.
;
; No design on purpose. Flat backing at enough alpha to read over a bright
; board, one colour, no accent, no animation, no rounded anything.
; 86.2 stored as a double is 86.20000000000000284..., and AHK prints a float at
; enough precision to round-trip it - so the literal came out as
; "86.20000000000003" and made the two numbers hardest to read the two that
; matter most. Trimmed to four decimals, which is finer than a pair of clicks
; can resolve and still shows a calibrated 86.3333 exactly.
PuzNum(v) {
    t := Format("{:.4f}", v)
    t := RTrim(t, "0")
    return RTrim(t, ".")
}
; ---- THE BOARD MOVES ON THE FIRST PUZZLE. NOTHING IS DETECTED. ----
; Measured off two full-screen captures: with the three-line banner above it the
; board's frame sits 54 px lower and every dot row with it; columns are
; identical either way. The banner is up for the FIRST puzzle after the module
; is armed and gone for every puzzle after, so the rule is a rule and not a
; question - board 1 of a session is UP, everything after it is DOWN.
;
; That is why there is no pixel detector here any more. A scan can be fooled by
; a bright frame in the wrong place, costs a capture before every board, and
; answers a question whose answer is already known from the session counter.
;
; The offset is a TRANSLATION, so it is independent of the calibration: it works
; on the built-in default and on a grid the user set, because the board's shift
; is a property of the game's layout and not of where the board happens to be.
;
; PZ_dyPin is the manual override - the DOWN BOARD / UP BOARD buttons. Once
; either is pressed the automatic rule stops touching the offset for the rest of
; the session, because the user saying which state it is beats the module
; assuming. Cleared by arming or disarming, like everything else about a session.
PuzBoardApply() {
    global PZ_boardDy
    if PZ_dyPin
        return PZ_boardDy               ; the user has taken the wheel
    PZ_boardDy := (PZ_sess = 0 && PZ_BannerFix) ? PZ_BannerDy() : 0
    return PZ_boardDy
}
PuzBoardSet(dy, pin := 1) {
    global PZ_boardDy, PZ_dyPin
    if (PZ_boardDy = dy && PZ_dyPin = pin)
        return
    PZ_boardDy := dy, PZ_dyPin := pin
    PuzMarkersKill()                    ; the markers are drawn for one offset
    PuzMarkersApply()
    HubPoke()
}
; ============================================================================
;  GRID INSPECTOR
; ----------------------------------------------------------------------------
;  Every number the grid is made of, and the ones derived from it that are worth
;  checking against the board by eye. It sits beside the markers because that is
;  where it gets used - a value here and the dot it describes are in the same
;  glance.
;
;  Designed to the suite's language rather than styled for its own sake: the
;  panel plate, accent hairline and micro-backdrop the hub cards use, section
;  rules instead of blank lines, labels in the small face and values in the
;  MONOSPACE one so the digits form a column that can be scanned downward.
;  Colour is used only where it carries meaning - accent for the identity of the
;  grid, amber when something is off nominal, red when a solve would refuse.
; ============================================================================
global PZ_DBG_LH  := 18          ; a value row
global PZ_DBG_SH  := 11          ; the gap a section rule opens
; ============================================================================
;  the inspector's own window
; ----------------------------------------------------------------------------
;  Separate from the markers because the markers are WS_EX_TRANSPARENT - the
;  game has to keep receiving clicks through them - and a click-through button
;  is not a button. This one is not transparent and not activatable, so it takes
;  the click without ever stealing focus from the game.
; ============================================================================
global PZ_dbg := "", PZ_dbgDc := 0, PZ_dbgBm := 0, PZ_dbgG := 0
global PZ_dbgX := 0, PZ_dbgY := 0
global PZ_dbgTimer := 0

PuzDbgKill() {
    ; the last three ASSIGN below, so they have to be declared - without them the
    ; hover and press state was reset into locals and the inspector came back
    ; still believing the pointer was on a button
    global PZ_dbg, PZ_dbgDc, PZ_dbgBm, PZ_dbgG, PZ_dbgH, PZ_dbgHot, PZ_dbgDown
    PuzDbgTim(0)
    if PZ_dbgG
        try DllCall("gdiplus\GdipDeleteGraphics", "ptr", PZ_dbgG)
    if PZ_dbgDc
        try DllCall("gdi32\DeleteDC", "ptr", PZ_dbgDc)
    if PZ_dbgBm
        try DllCall("gdi32\DeleteObject", "ptr", PZ_dbgBm)
    PZ_dbgG := 0, PZ_dbgDc := 0, PZ_dbgBm := 0
    if (PZ_dbg != "") {
        try OnMessage(0x201, PuzDbgClick, 0)
        try OnMessage(0x202, PuzDbgUp, 0)
        try OnMessage(0x200, PuzDbgMove, 0)
        try PZ_dbg.Destroy()
        PZ_dbg := ""
    }
    PZ_dbgH := Map(), PZ_dbgHot := 0, PZ_dbgDown := 0
}
PuzDbgTim(ms) {
    global PZ_dbgTimer
    if (PZ_dbgTimer = ms)
        return
    PZ_dbgTimer := ms
    SetTimer(PuzDbgRender, ms)
}
; Shown exactly when the markers are: the inspector describes the grid the
; markers draw, and one without the other is half an answer.
PuzDbgApply() {
    global PZ_dbg
    want := (PZ_MkDbg && PZ_mkWant && puzOn && !PZ_mkHid)
    if !want {
        if (PZ_dbg != "")
            try DllCall("ShowWindow", "ptr", PZ_dbg.Hwnd, "int", 0)
        PuzDbgTim(0)
        return
    }
    PuzDbgRender()
    if (PZ_dbg != "")
        try DllCall("ShowWindow", "ptr", PZ_dbg.Hwnd, "int", 8)   ; SW_SHOWNA
}
PuzDbgRender() {
    global G, PZ_dbg, PZ_dbgDc, PZ_dbgBm, PZ_dbgG, PZ_dbgX, PZ_dbgY, PZ_dbgH
    if !(PZ_MkDbg && PZ_mkWant && puzOn && !PZ_mkHid) {
        PuzDbgTim(0)
        return
    }
    ; ---- sized with the rest of the interface ----
    ; This was the one surface left in fixed pixels: PZ_MKDBGW/H are base units
    ; like every other panel's, but the inspector never applied scaleF, so it
    ; stayed 286 px wide on a display where the hub beside it had grown by half.
    ; PuzDbgPaint draws in base units, so the transform below carries it.
    w := Round(PZ_MKDBGW*scaleF), h := Round(PZ_MKDBGH*scaleF)
    if !PZ_dbgG {
        bi := Buffer(40, 0)
        NumPut("uint", 40, bi, 0), NumPut("int", w, bi, 4), NumPut("int", -h, bi, 8)
        NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
        PZ_dbgBm := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0
                          , "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
        PZ_dbgDc := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
        DllCall("gdi32\SelectObject", "ptr", PZ_dbgDc, "ptr", PZ_dbgBm)
        DllCall("gdiplus\GdipCreateFromHDC", "ptr", PZ_dbgDc, "ptr*", &g2 := 0)
        DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", g2, "int", 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", 4)
        DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", g2, "int", 2)
        PZ_dbgG := g2
    }
    ; ---- ease the hover, and decide whether another frame is owed ----
    live := 0
    for z in [PZ_DBGZ_DOWN, PZ_DBGZ_UP] {
        cur := PZ_dbgH.Has(z) ? PZ_dbgH[z] : 0.0
        tgt := (PZ_dbgHot = z) ? 1.0 : 0.0
        nxt := cur + (tgt - cur)*0.28
        if (Abs(tgt - nxt) < 0.004)
            nxt := tgt
        PZ_dbgH[z] := nxt
        if (nxt != tgt || nxt > 0.004)
            live := 1
    }
    if PZ_dbgDown
        live := 1
    Critical "On"
    g0 := G
    G := PZ_dbgG
    ResetSurface(G, w/PZ_MKDBGW, h/PZ_MKDBGH)
    DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
    PuzDbgPaint(0, 0, PZ_MKDBGW, PZ_MKDBGH)
    G := g0
    Critical "Off"
    ; sits just right of the marker surface, tops aligned
    PZ_dbgX := PZ_mkX + PZ_mkW + 10, PZ_dbgY := PZ_mkY
    if (PZ_dbg = "") {
        ; No +E0x20 here, unlike the markers - this one has to RECEIVE the click.
        ; +E0x8000000 (WS_EX_NOACTIVATE) is what stops taking it from the game.
        ; .Show() for the same reason the resolution notice needs it: an AHK v2
        ; Gui is created hidden and 0 x 0, so UpdateLayeredWindow below was
        ; writing into a window that had never been realised.
        PZ_dbg := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x80000 +E0x8000000"
                    , "YURIGRIDDEBUG")
        PZ_dbg.Show(Format("NA x{} y{} w{} h{}", PZ_dbgX, PZ_dbgY, w, h))
        OnMessage(0x201, PuzDbgClick)
        OnMessage(0x202, PuzDbgUp)
        OnMessage(0x200, PuzDbgMove)
    }
    pt0 := Buffer(8, 0)
    sz  := Buffer(8), NumPut("int", w, "int", h, sz)
    ptd := Buffer(8), NumPut("int", PZ_dbgX, "int", PZ_dbgY, ptd)
    bf  := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", 255, "uchar", 1, bf)
    DllCall("user32\UpdateLayeredWindow", "ptr", PZ_dbg.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz
          , "ptr", PZ_dbgDc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
    PuzDbgTim(live ? TICK_S : 0)
}
; ---- input ----
; Every rectangle comes from PZ_dbgHitR, which PuzDbgBtn fills as it draws, so
; the hit test cannot drift from the layout the way a second copy of the
; geometry would.
PuzDbgZone(sx, sy) {
    if (PZ_dbg = "")
        return 0
    ; PZ_dbgHitR is filled by PuzDbgPaint in BASE units, and the surface is now
    ; drawn through a scale transform - so the pointer offset has to come back
    ; through the same factor. Without this the rectangles sit at 1:1 while the
    ; buttons are drawn at scaleF, and every zone below the first is unclickable.
    k := scaleF ? scaleF : 1.0
    x := (sx - PZ_dbgX)/k, y := (sy - PZ_dbgY)/k
    for z, r in PZ_dbgHitR {
        if (x >= r[1] && x < r[1] + r[3] && y >= r[2] && y < r[2] + r[4])
            return z
    }
    return 0
}
PuzDbgMove(wParam, lParam, msg, hwnd) {
    global PZ_dbgHot
    if (PZ_dbg = "" || hwnd != PZ_dbg.Hwnd)
        return
    CursorXY(&x, &y)
    z := PuzDbgZone(x, y)
    if (z != PZ_dbgHot) {
        PZ_dbgHot := z
        PuzDbgTim(TICK_S)
    }
    return 0
}
PuzDbgClick(wParam, lParam, msg, hwnd) {
    global PZ_dbgDown
    if (PZ_dbg = "" || hwnd != PZ_dbg.Hwnd)
        return
    CursorXY(&x, &y)
    PZ_dbgDown := PuzDbgZone(x, y)
    if PZ_dbgDown
        PuzDbgTim(TICK_A)
    return 0
}
PuzDbgUp(wParam, lParam, msg, hwnd) {
    global PZ_dbgDown, PZ_dbgHot
    if (PZ_dbg = "" || hwnd != PZ_dbg.Hwnd)
        return
    CursorXY(&x, &y)
    z := PuzDbgZone(x, y)
    ; only fires when the release lands on the same control as the press, which
    ; is what lets a mis-click be dragged off and cancelled
    if (PZ_dbgDown && z = PZ_dbgDown) {
        if (z = PZ_DBGZ_DOWN)
            PuzBoardSet(0, 1)
        else if (z = PZ_DBGZ_UP)
            PuzBoardSet(PZ_BannerDy(), 1)
    }
    PZ_dbgDown := 0, PZ_dbgHot := z
    PuzDbgTim(TICK_S)
    return 0
}

; ---- an inspector button ----
; Its own widget rather than FFMBtn, because FFMBtn reads HL.h and lives on the
; hub's surface; this one is on the inspector's window with its own hover map.
; Same behaviour though: hover lift, press dip, ripple on release, and an ACTIVE
; state - the offset currently in force is filled, the other is an outline.
global PZ_DBGZ_DOWN := 1, PZ_DBGZ_UP := 2
global PZ_dbgH := Map()          ; zone -> eased hover, 0..1
global PZ_dbgHot := 0            ; zone under the pointer, 0 for none
global PZ_dbgDown := 0           ; zone being pressed
global PZ_dbgHitR := Map()       ; zone -> [x, y, w, h] in surface pixels
PuzDbgBtn(z, bx, by, bw, bh, label, active, acc, now) {
    PZ_dbgHitR[z] := [bx, by, bw, bh]
    hv := PZ_dbgH.Has(z) ? PZ_dbgH[z] : 0.0
    pr := (PZ_dbgDown = z) ? 1.0 : 0.0
    ; press dips and shrinks; hover lifts a pixel. Both eased, both small - a
    ; control this size reads as broken if it moves more than it is tall.
    lift := -1.5*hv + 2.0*pr
    sc   := 1 - 0.02*pr
    cxm  := bx + bw/2, cym := by + bh/2 + lift
    st := PushXform(cxm, cym, sc, 0)
    x0 := cxm - bw/2, y0 := cym - bh/2
    if active {
        b := VBrush(x0, y0, bw, bh, Alpha(AccHi(acc, 0.45), 170 + 40*hv)
                                  , Alpha(acc, 120 + 40*hv))
        FillRR(x0, y0, bw, bh, 7, b), DelB(b)
        pn := Pen(Alpha(AccHi(acc, 0.5), 220), 1.2)
        StrokeRR(x0, y0, bw, bh, 7, pn), DelP(pn)
    } else {
        b := SBrush(Alpha(0xFFFFFF, Round(8 + 16*hv)))
        FillRR(x0, y0, bw, bh, 7, b), DelB(b)
        pn := Pen(Alpha(acc, Round(70 + 70*hv)), 1)
        StrokeRR(x0, y0, bw, bh, 7, pn), DelP(pn)
    }
    Txt(label, x0, y0 + bh/2 - 9, bw, 18, fBadge
      , Alpha(active ? 0xFFFFFFFF : Mix(0xFFC7CBE0, AccHi(acc, 0.4), hv)
            , active ? 250 : Round(170 + 70*hv)), fmtC)
    Pop(st)
}
; fHint for the label and the 9.5 pt mono for the value. HL.fXs is 6.5 pt and
; HL.fMs is 8 - they are badge and pip faces, and I had a whole panel of running
; text set in them. The values stay MONOSPACE because the point of this column
; is scanning digits downward; only the size changed.
PuzDbgRow(x, y, w, label, val, col, f) {
    Txt(label, x, y + 1, 60, PZ_DBG_LH, fHint, FA(0x8AC7CBE0, f), fmtL)
    Txt(val, x + 66, y, w - 66, PZ_DBG_LH, HL.fM, FA(col, f), fmtL)
}
PuzDbgRule(x, y, w, acc, f) {
    b := VBrush(x, y, w, 1, FA(Alpha(acc, 60), f), FA(Alpha(acc, 6), f))
    FillRR(x, y, w, 1, 0.5, b), DelB(b)
}
PuzDbgPaint(dx, dy, dw, dh) {
    acc := hubAccent
    now := A_TickCount
    ; The inspector's whole job is to say what the grid is. If it reports the
    ; old screen's numbers after a mode change it is actively misleading, so it
    ; guards like the two paths that use the grid rather than merely reading it.
    if !PZ_solving
        PuzScreenGuard()
    ; ---- the plate ----
    ; Same construction as a hub card: gradient body, micro-backdrop, one accent
    ; hairline down the leading edge so it reads as part of the suite rather
    ; than a console someone taped on.
    b := VBrush(dx, dy, dw, dh, 0xF20E1020, 0xF2080A14)
    FillRR(dx, dy, dw, dh, 10, b), DelB(b)
    MicroBackdrop(dx, dy, dw, dh, 10, acc, 1.0, now, 0.85)
    pn := Pen(Alpha(acc, 70), 1)
    StrokeRR(dx, dy, dw, dh, 10, pn), DelP(pn)
    b := VBrush(dx + 1, dy + 10, 2, dh - 20, Alpha(AccHi(acc, 0.45), 210), Alpha(acc, 40))
    FillRR(dx + 1, dy + 10, 2, dh - 20, 1, b), DelB(b)

    n    := PZ_GridN()
    off  := Round(PZ_SampleOffset * PZ_SX())
    PuzBoardRect(&cbx, &cby, &cbw, &cbh)
    cust := PZ_Custom()
    fits := PuzGridOnScreen()
    x := dx + 14, w := dw - 26, y := dy + 12

    ; ---- header ----
    Txt("GRID", x, y, 60, 18, fBrand, FA(Alpha(Mix(0xFFE8EAF6, acc, 0.25), 245), 1), fmtL)
    Txt(cust ? "CUSTOM" : "BUILT IN", x + 46, y + 2, w - 46, 16, fBadge
      , FA(Alpha(cust ? AccHi(acc, 0.4) : 0xFFC7CBE0, cust ? 240 : 165), 1), fmtL)
    ; this screen's entry, so "saved none" means none FOR THIS RESOLUTION rather
    ; than none at all - which is the question you are asking when the markers
    ; are in the wrong place after a mode change
    sv := ""
    try sv := IniRead(iniPath, "puzzle", PuzGridKey("gx0"), "")
    Txt("gen " PZ_gridGen "  ·  saved " (sv = "" ? "none" : PuzNum(sv + 0))
      , x, y + 20, w, 15, fHint, FA(0x7AC7CBE0, 1), fmtL)
    y += 40
    PuzDbgRule(x, y, w, acc, 1), y += PZ_DBG_SH

    ; ---- the calibration ----
    PuzDbgRow(x, y, w, "origin", PuzNum(PZ_X0()) ", " PuzNum(PZ_Y0()), 0xFFE8EAF6, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "pitch",  PuzNum(PZ_SX()) " x " PuzNum(PZ_SY()), 0xFFE8EAF6, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "cells",  n " x " n, 0xFF9AA8C0, 1), y += PZ_DBG_LH
    y += 3
    PuzDbgRule(x, y, w, acc, 1), y += PZ_DBG_SH

    ; ---- where the board is believed to be ----
    PuzDbgRow(x, y, w, "1,1",  PuzPX(1) ", " PuzPY(1), 0xFFC7CBE0, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "6,6",  PuzPX(n) ", " PuzPY(n), 0xFFC7CBE0, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "span", (PuzPX(n) - PuzPX(1)) " x " (PuzPY(n) - PuzPY(1))
            , 0xFF9AA8C0, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "box",  Round(PZ_X0() - PZ_SX()/2) ", "
                             . Round(PZ_Y0() - PZ_SY()/2 + PZ_boardDy) "  "
                             . Round(PZ_SX()*n) " x " Round(PZ_SY()*n), 0xFF9AA8C0, 1)
    y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "mid",  Round(PZ_X0() + (n/2 - 0.5)*PZ_SX()) ", "
                             . Round(PZ_Y0() + (n/2 - 0.5)*PZ_SY() + PZ_boardDy)
            , 0xFF9AA8C0, 1), y += PZ_DBG_LH
    y += 3
    PuzDbgRule(x, y, w, acc, 1), y += PZ_DBG_SH

    ; ---- the board offset, given its own block ----
    ; It is the one line here that changes while you watch, and the one that
    ; explains a solve going wrong, so it gets the colour and the space.
    shifted := (PZ_boardDy != 0)
    PuzDbgRow(x, y, w, "board"
            , shifted ? ("UP    +" PZ_boardDy " px") : "DOWN   on the grid"
            , shifted ? AMBER : C_ON, 1), y += PZ_DBG_LH
    ; trimmed to the column rather than left to overflow it - the section
    ; heading already says this is about the board, so "of session" was the
    ; only word here not carrying its width
    PuzDbgRow(x, y, w, "from", PZ_dyPin ? "you (button)"
                             : !puzOn   ? "module off"
                             : PZ_sess  ? "rule · past board 1"
                                        : "rule · board 1"
            , PZ_dyPin ? AccHi(acc, 0.35) : 0xFF6E7590, 1), y += PZ_DBG_LH
    ; ---- the two buttons ----
    ; They sit in the block they act on, so the state and the control that
    ; changes it are read in one glance. The active one is filled and lit; the
    ; other is an outline waiting to be pressed.
    bw2 := (w - 8)/2
    PuzDbgBtn(PZ_DBGZ_DOWN, x, y + 3, bw2, 27, "DOWN BOARD", !shifted, acc, now)
    PuzDbgBtn(PZ_DBGZ_UP, x + bw2 + 8, y + 3, bw2, 27, "UP BOARD", shifted, acc, now)
    y += 36
    y += 3
    PuzDbgRule(x, y, w, acc, 1), y += PZ_DBG_SH

    ; ---- what the scanner will do with it ----
    PuzDbgRow(x, y, w, "read", cbx ", " cby "  " cbw " x " cbh, 0xFF9AA8C0, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "probe", off " px off  ·  thr " PZ_BrightThresh, 0xFF6E7590, 1)
    y += PZ_DBG_LH
    ; The walk's budget, and the frame rate that budget assumes. It is stated
    ; because a correct grid that still will not solve is almost always the
    ; drawing rather than the geometry, and this is the number that decides it.
    ps := PuzPitchScale()
    ; PZ_FrameMs is the FRAME budget; a cell is PZ_CellFrames of them. Printing
    ; the frame value under a "ms/cell" label under-reported the real budget by
    ; 35% - on the one row whose whole job is to expose the drag timing.
    cellMs := PZ_CellFrames*PZ_FrameMs*ps
    PuzDbgRow(x, y, w, "walk", Round(cellMs) " ms/cell  ·  "
                             . Round(PZ_SX()/Max(1, cellMs), 1) " px/ms"
            , 0xFF6E7590, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "retry", !PZ_Verify ? "off"
                              : PZ_auShort ? ("verifying  ·  " PZ_auShort " redrawn")
                              : "verifying each line"
            , PZ_auShort ? AMBER : 0xFF6E7590, 1), y += PZ_DBG_LH
    y += 3
    PuzDbgRule(x, y, w, acc, 1), y += PZ_DBG_SH

    ; ---- the screen, and whether a solve would run ----
    PuzDbgRow(x, y, w, "screen", PZ_vw " x " PZ_vh, 0xFF6E7590, 1), y += PZ_DBG_LH
    ; The default is derived from this; a saved grid ignores it entirely. Worth
    ; showing either way, because a factor that is not 1.00 on a screen you
    ; think is 1080p is the fastest way to spot a scaling surprise.
    sc := PuzDefScale()
    ; EXACT means this resolution is in the measured table, so the default is a
    ; real measurement rather than an interpolation. That is the difference
    ; between "this should be right" and "this is a reasonable guess", and it is
    ; the first thing worth knowing when the markers are off.
    PuzDbgRow(x, y, w, "ref", cust ? "saved grid  ·  fixed"
                            : (Format("{:.3f}", sc) "  ·  "
                               (PZ_RefExact ? "measured" : "interpolated"))
            , cust ? 0xFF6E7590 : PZ_RefExact ? C_ON : AMBER, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "solve", fits ? "ready" : "REFUSED - off screen"
            , fits ? C_ON : C_OFF, 1), y += PZ_DBG_LH
    PuzDbgRow(x, y, w, "layer", PZ_mkX ", " PZ_mkY "  " PZ_mkW " x " PZ_mkH, 0xFF4E5470, 1)
}

PuzMarkersBuild() {
    global G, PZ_mk, PZ_mkDc, PZ_mkBm, PZ_mkG, PZ_mkX, PZ_mkY, PZ_mkW, PZ_mkH, PZ_mkKey
    ; The surface has to contain everything drawn on it, and the board outline
    ; runs half a cell OUTSIDE cell 1's centre. A flat 18 was less than half a
    ; cell at any real pitch, so the outline and all four corner brackets were
    ; being clipped away - which is why no board box appears around the markers.
    pad := Round(Max(PZ_SX(), PZ_SY())/2) + 16
    ox := Round(PuzPX(1)) - pad, oy := Round(PuzPY(1)) - pad
    w  := Round(PuzPX(PZ_GridN())) - Round(PuzPX(1)) + 2*pad
    h  := Round(PuzPY(PZ_GridN())) - Round(PuzPY(1)) + 2*pad
    ; The inspector used to hang off this surface, which could not work once it
    ; grew buttons: this window is WS_EX_TRANSPARENT so the game still receives
    ; clicks through it, and a click-through button is not a button. It has its
    ; own window now - see PuzDbgApply - and this surface is back to being
    ; exactly the board's extent.
    if (w < 8 || h < 8)
        return
    ; the surface is sized in SCREEN PIXELS and never scaled - that is what keeps
    ; it honest about where the solver will click, at any DPI
    ;
    ; Keyed on the GRID, not on the surface size. Two different grids can round
    ; to the same width - a re-anchor moves the origin and does not change the
    ; size at all - and keying on size alone meant the old drawing was kept and
    ; only the window moved, so the markers showed the previous calibration.
    ; PZ_gridGen and the debug flag join the key: the readout reports things the
    ; four numbers alone do not pin down - the virtual screen, whether the grid
    ; is custom - and a cached surface would keep showing the old dump.
    key := PZ_X0() "|" PZ_Y0() "|" PZ_SX() "|" PZ_SY() "|" hubAccent
         . "|" PZ_gridGen "|" PZ_MkDbg "|" PZ_vx "," PZ_vy "," PZ_vw "," PZ_vh
         . "|" PZ_boardDy                      ; the board moved - so must the markers
    if (PZ_mkG && key = PZ_mkKey && w = PZ_mkW && h = PZ_mkH && PZ_mkX = ox && PZ_mkY = oy)
        return                         ; already correct, nothing to redraw
    if (PZ_mkG && (w != PZ_mkW || h != PZ_mkH))
        PuzMarkersKill()
    PZ_mkKey := key
    if !PZ_mkG {
        bi := Buffer(40, 0)
        NumPut("uint", 40, bi, 0), NumPut("int", w, bi, 4), NumPut("int", -h, bi, 8)
        NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
        PZ_mkBm := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0
                         , "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
        PZ_mkDc := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
        DllCall("gdi32\SelectObject", "ptr", PZ_mkDc, "ptr", PZ_mkBm)
        DllCall("gdiplus\GdipCreateFromHDC", "ptr", PZ_mkDc, "ptr*", &g2 := 0)
        DllCall("gdiplus\GdipSetSmoothingMode", "ptr", g2, "int", 4)
        DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", g2, "int", 2)
        PZ_mkG := g2
    }
    PZ_mkX := ox, PZ_mkY := oy, PZ_mkW := w, PZ_mkH := h

    Critical "On"
    g0 := G
    G := PZ_mkG
    acc := hubAccent
    ResetSurface(G, 1, 1)
    DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)

    ; the board's extent, faint - enough to see the calibration is square
    bx := PuzPX(1) - PZ_SX()/2 - ox, by := PuzPY(1) - PZ_SY()/2 - oy
    bw := PZ_SX()*PZ_GridN(), bh := PZ_SY()*PZ_GridN()
    pn := Pen(Alpha(acc, 42), 1)
    StrokeRR(bx, by, bw, bh, 6, pn), DelP(pn)
    ; corner brackets, so the extent reads at a glance without a heavy border
    arm := Min(16, Min(bw, bh)/5)
    pn := Pen(Alpha(AccHi(acc, 0.35), 190), 1.6)
    loop 4 {
        k  := A_Index - 1
        cx := (k = 1 || k = 2) ? bx + bw : bx
        cy := (k >= 2) ? by + bh : by
        sx := (k = 1 || k = 2) ? -1 : 1
        sy := (k >= 2) ? -1 : 1
        Line(cx, cy, cx + sx*arm, cy, pn)
        Line(cx, cy, cx, cy + sy*arm, pn)
    }
    DelP(pn)

    ; the points the solver actually clicks: halo, dot, and a white core so
    ; they stay visible over a dark board and over a bright drawn line alike
    loop PZ_GridN() {
        r := A_Index
        loop PZ_GridN() {
            px := PuzPX(A_Index) - ox, py := PuzPY(r) - oy
            b := SBrushP(Alpha(acc, 26))
            FillEll(px - 6, py - 6, 12, 12, b), DelB(b)
            b := SBrushP(Alpha(AccHi(acc, 0.3), 225))
            FillEll(px - 2.4, py - 2.4, 4.8, 4.8, b), DelB(b)
            b := SBrushP(Alpha(0xFFFFFF, 200))
            FillEll(px - 0.9, py - 0.9, 1.8, 1.8, b), DelB(b)
        }
    }
    G := g0
    Critical "Off"

    if (PZ_mk = "") {
        ; -DPIScale is the whole point (see the note above); E0x20 is
        ; click-through, E0x8000000 keeps it from ever taking focus.
        ; Deliberately NOT shown through Gui.Show: position and size come from
        ; UpdateLayeredWindow below and nowhere else. Gui.Show keeps its own idea
        ; of where the window belongs and reasserts it, so a surface that was
        ; reused across a grid change could be moved by UpdateLayeredWindow and
        ; then snapped straight back to the coordinates it was first created at -
        ; the markers showing one calibration while the numbers held another.
        PZ_mk := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x80000 +E0x20 +E0x8000000"
                   , "YURIGRIDMARKS")
    }
    pt0 := Buffer(8, 0)
    sz  := Buffer(8), NumPut("int", w, "int", h, sz)
    ptd := Buffer(8), NumPut("int", ox, "int", oy, ptd)
    bf  := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", 255, "uchar", 1, bf)
    DllCall("user32\UpdateLayeredWindow", "ptr", PZ_mk.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz
          , "ptr", PZ_mkDc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
    ; a new topmost window can push the hub down its own band - put it back
    try HubRaise()
}


; ---- the grid ----
; Four numbers, stored: the centre of cell 1 and the cell pitch. The defaults
; are the measured 1920x1080 fullscreen board, so that resolution works out of
; the box; anything else is one SET GRID away, and RESET puts these back.
;
; This replaced an attempt to derive the board from the client size, and then an
; attempt to find it by scanning for the dots. Both worked at 1080p and neither
; survived contact with other resolutions, because both were guessing at a
; layout the game never promised. Two clicks from the person who can actually
; see the board beat any amount of inference.
; The six numbers are DECLARED UP WITH THE BOOT SEQUENCE, ahead of the ini
; reads and PuzGridLoad() - not here. Assigning them here ran AFTER the load
; and silently discarded every saved calibration; see the note there. RESET
; still restores PZ_Def* through PuzGridReset below, which is a call and runs
; when it is called, not at load.
; setup state: 0 idle, 1 waiting for the top-left corner, 2 waiting for
; bottom-right. Four things OUTSIDE this module read it - the AUTOBLOCK hotkey
; context, the hub's busy predicate, PuzClashExpire, and the panel's own status
; line and button label.
global PZ_cal := 0
; ---- refused-arm state ----
; A clash can no longer EXIST at rest: the arm that would create one is refused
; instead, so these describe the refusal rather than an ongoing conflict.
global PZ_clashKey := ""         ; the contested key, as a label
global PZ_clashWho := ""         ; the system that was refused
global PZ_clashOwn := ""         ; the system already holding the key
global PZ_clashAt := 0           ; when it was raised, for the entrance
global PZ_clashOut := 0          ; when it was dismissed, for the exit

; ============================================================================
;  GRID SETTING
; ----------------------------------------------------------------------------
;  Two clicks on the board's OUTER corners. The span is divided by PZ_GridN()
;  to get the pitch, and the first cell centre sits half a cell in from the
;  first click - so the clicks bound the whole board box, they are NOT the corner dots.
;  Clicking dot-to-dot gives a five-cell span read as six and a pitch 17% short.
;
;  Everything here is reached from a button. Nothing runs on a timer, nothing
;  fires on a display change, nothing corrects itself after a failed scan. The
;  grid moves when the user moves it and at no other time.
; ============================================================================

; ---- persistence ----
; Returns 1 only when the numbers are PROVABLY on disk. IniWrite fails silently
; - a read-only folder, a script under Program Files, a sync client holding the
; file - and a `try` around it with a "grid set" message either way is what "it
; is not saving" looks like from the outside.
PuzGridSave() {
    if !PZ_Grid
        return 0
    if (PZ_vw < 1)
        PuzScreenSync()
    ok := 0
    try {
        IniWrite(Round(PZ_Grid.bx, 4), iniPath, "puzzle", PuzGridKey("gbx"))
        IniWrite(Round(PZ_Grid.by, 4), iniPath, "puzzle", PuzGridKey("gby"))
        IniWrite(Round(PZ_Grid.bw, 4), iniPath, "puzzle", PuzGridKey("gbw"))
        IniWrite(Round(PZ_Grid.bh, 4), iniPath, "puzzle", PuzGridKey("gbh"))
        ok := (Abs((IniRead(iniPath, "puzzle", PuzGridKey("gbx"), "") + 0) - Round(PZ_Grid.bx, 4)) < 0.001
            && Abs((IniRead(iniPath, "puzzle", PuzGridKey("gbw"), "") + 0) - Round(PZ_Grid.bw, 4)) < 0.001)
    }
    return ok ? 1 : 0
}
; ---- one saved grid PER RESOLUTION ----
; The board's size depends on the viewport, so a calibration only means anything
; at the resolution it was taken on. Keying the entry by screen size means a
; resolution change loads THAT resolution's grid rather than misapplying
; another's - and it makes the scaling law above stop mattering the moment a
; resolution has been calibrated once.
;
; The unsuffixed keys are still read as a fallback, so a grid saved before this
; existed is not lost.
PuzGridKey(n) => n "_" PZ_vw "x" PZ_vh
PuzGridForget() {
    for k in ["gbx", "gby", "gbw", "gbh", "gx0", "gy0", "gsx", "gsy"] {
        try IniDelete(iniPath, "puzzle", PuzGridKey(k))
        try IniDelete(iniPath, "puzzle", k)          ; and the pre-split entry
    }
}
; Called ONCE, from the boot sequence. Not from a display handler, not from a
; retry - a reload is a way for the grid to change without the user asking.
PuzGridLoad() {
    if (PZ_vw < 1)
        PuzScreenSync()
    try {
        ; this screen's box first; the unsuffixed pre-split entry as a fallback
        bx := IniRead(iniPath, "puzzle", PuzGridKey("gbx"), IniRead(iniPath, "puzzle", "gbx", "")) + 0
        by := IniRead(iniPath, "puzzle", PuzGridKey("gby"), IniRead(iniPath, "puzzle", "gby", "")) + 0
        bw := IniRead(iniPath, "puzzle", PuzGridKey("gbw"), IniRead(iniPath, "puzzle", "gbw", "")) + 0
        bh := IniRead(iniPath, "puzzle", PuzGridKey("gbh"), IniRead(iniPath, "puzzle", "gbh", "")) + 0
        ; No screen test. A saved grid loads as written or not at all, and the
        ; only thing that can reject it is a pitch no pair of clicks could have
        ; produced. A grid that does not fit the CURRENT display is still the
        ; user's grid - it comes back the moment the display does.
        if PuzGridSane(bx, by, bw, bh)
            PuzGridSet(bx, by, bw, bh)
    }
    ; ---- the pre-box calibration ----
    ; Older builds wrote the first dot and the pitch, worked out against a grid
    ; that was six wide and could not be anything else. That is enough to
    ; rebuild the box, and rebuilding it is worth doing: the alternative is
    ; silently dropping a calibration the user did on purpose and sending them
    ; back to the interpolated default without saying so.
    if !PZ_Grid {
        try {
            x0 := IniRead(iniPath, "puzzle", PuzGridKey("gx0"), IniRead(iniPath, "puzzle", "gx0", "")) + 0
            y0 := IniRead(iniPath, "puzzle", PuzGridKey("gy0"), IniRead(iniPath, "puzzle", "gy0", "")) + 0
            sx := IniRead(iniPath, "puzzle", PuzGridKey("gsx"), IniRead(iniPath, "puzzle", "gsx", "")) + 0
            sy := IniRead(iniPath, "puzzle", PuzGridKey("gsy"), IniRead(iniPath, "puzzle", "gsy", "")) + 0
            ; 6 is not a guess about the user - it is the only size those keys
            ; could ever have been written at.
            if (sx > 4 && sy > 4 && sx < 400 && sy < 400)
                PuzGridSet(x0 - sx/2, y0 - sy/2, sx*6, sy*6)
        }
    }
}

; ---- setup session ----
global PZ_calX := 0.0, PZ_calY := 0.0     ; the first corner, once taken


; to commit to before you commit to it.
;
; WS_EX_TRANSPARENT: the card sits near the top of the screen and the board is
; centred, but a corner click must never be able to land ON the instructions.
; Click-through costs nothing here - nothing on this card is clickable.
global PZ_calHub := 0, PZ_calGui := ""
global PZ_calDc := 0, PZ_calBm := 0, PZ_calG := 0
; 200, not 162: the banner disclaimer below the divider needs its own band. It
; is the difference between a calibration that is right and one that is 54 px
; out on every board, so it gets a row of its own rather than a clause tacked
; onto a line that is already saying something else.
global PZ_calW := 470, PZ_calH := 218
; Bleed for the drop shadow. ShadowDraw overhangs by rings + 2 and the surface
; is exactly as big as it is told to be, so without this the shadow is sliced
; off square at all four edges - the same margin PAD gives the two overlays.
global PZ_calPad := 22
global PZ_calPX := 0, PZ_calPY := 0
; Which of two slots the card occupies. It starts at the top because the board
; is centred; if a corner click lands under it, it moves to the other one - see
; PuzCalNudge.
global PZ_calSlot := 1
global PZ_calWarn := "", PZ_calWarnAt := 0
global PZ_calOpenAt := 0, PZ_calStepAt := 0, PZ_calStep := 0
global PZ_calCX := 0, PZ_calCY := 0            ; cursor, sampled by the render

PuzCalWinW() => Round((PZ_calW + PZ_calPad*2)*scaleF)
PuzCalWinH() => Round((PZ_calH + PZ_calPad*2)*scaleF)
; Resolved on demand rather than stored, so a resolution or monitor change
; between one setup and the next cannot strand the card off screen.
PuzCalSlotY(slot) {
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    off := Round((42 - PZ_calPad)*scaleF)
    return (slot = 2) ? (mB - PuzCalWinH() - off) : (mT + off)
}
; Move to the other slot and replay the entrance, so the relocation reads as
; the card getting out of the way rather than as the card glitching. Only the
; position changes - the window is not rebuilt, so nothing flickers.
PuzCalNudge() {
    global PZ_calSlot, PZ_calPY, PZ_calOpenAt
    if (PZ_calGui = "")
        return
    PZ_calSlot := (PZ_calSlot = 1) ? 2 : 1
    PZ_calPY := PuzCalSlotY(PZ_calSlot)
    PZ_calOpenAt := A_TickCount
    PuzCalCard("that corner was under this card - it has moved, click it again")
}

PuzCalCard(warn := "") {
    global PZ_calGui, PZ_calDc, PZ_calBm, PZ_calG, PZ_calPX, PZ_calPY
    global PZ_calWarn, PZ_calWarnAt, PZ_calOpenAt, PZ_calStepAt, PZ_calStep
    if !PZ_cal {
        PuzCalCardKill()
        return
    }
    PZ_calWarn := warn
    if (warn != "")
        PZ_calWarnAt := A_TickCount
    ; A step change is a state change, not a new card. Rebuilding the window
    ; here would replay the entrance every time you clicked a corner, which is
    ; the flicker the old one had - it destroyed and recreated itself per step.
    if (PZ_cal != PZ_calStep) {
        PZ_calStep := PZ_cal
        PZ_calStepAt := A_TickCount
    }
    if (PZ_calGui != "") {
        PuzCalDraw()
        return
    }
    w := PuzCalWinW(), h := PuzCalWinH()
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    ; the CARD is centred and 42 in from its edge; the window is card plus bleed
    PZ_calPX := mL + ((mR - mL) - w)//2
    PZ_calPY := PuzCalSlotY(PZ_calSlot)
    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", w, bi, 4), NumPut("int", -h, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    PZ_calBm := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0
                      , "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    PZ_calDc := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", PZ_calDc, "ptr", PZ_calBm)
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", PZ_calDc, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", g2, "int", hubLowPerf ? 3 : 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", hubLowPerf ? 1 : 4)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", hubLowPerf ? 5 : 7)
    DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", g2, "int", hubLowPerf ? 1 : 2)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", g2
          , "float", w/(PZ_calW + PZ_calPad*2), "float", h/(PZ_calH + PZ_calPad*2), "int", 0)
    PZ_calG := g2
    PZ_calOpenAt := A_TickCount, PZ_calStepAt := PZ_calOpenAt, PZ_calStep := PZ_cal
    ; E0x20 is WS_EX_TRANSPARENT - see the note above.
    PZ_calGui := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x80000 +E0x8000000 +E0x20", "YURIGRIDSETUP")
    PZ_calGui.Show(Format("NA x{} y{} w{} h{}", PZ_calPX, PZ_calPY, w, h))
    SetTimer(PuzCalDraw, TICK_S)
    PuzCalDraw()
}
PuzCalCardKill() {
    global PZ_calGui, PZ_calDc, PZ_calBm, PZ_calG, PZ_calStep, PZ_calWarn
    if (PZ_calGui = "")
        return
    SetTimer(PuzCalDraw, 0)
    try PZ_calGui.Destroy()
    PZ_calGui := ""
    if PZ_calG
        try DllCall("gdiplus\GdipDeleteGraphics", "ptr", PZ_calG)
    if PZ_calDc
        try DllCall("gdi32\DeleteDC", "ptr", PZ_calDc)
    if PZ_calBm
        try DllCall("gdi32\DeleteObject", "ptr", PZ_calBm)
    PZ_calG := 0, PZ_calDc := 0, PZ_calBm := 0
    PZ_calStep := 0, PZ_calWarn := ""
}

; ---- the corner reticle ----
; Draws the corner the card is ASKING for, at the size and orientation it will
; be clicked at: a bracket, a crosshair inside it, and a dashed rectangle
; running off toward where the rest of the board is. On step two the corner
; already given is marked with a filled pip on the opposite diagonal, so the
; two clicks read as one gesture rather than two unrelated instructions.
PuzCalReticle(cx, cy, r, acc, f, now, step, kick) {
    ; the board, as a dashed box centred on the glyph
    r2 := r*1.24
    bx := cx - r2/2, by := cy - r2/2
    pn := Pen(FA(Alpha(acc, 60), f), 1.1)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
    DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
    StrokeRR(bx, by, r2, r2, 3, pn), DelP(pn)
    ; the corner being asked for, and the arms running INTO the box from it
    ax  := (step = 1) ? bx : bx + r2
    ay  := (step = 1) ? by : by + r2
    sgn := (step = 1) ? 1 : -1
    ; the corner already given, on the opposite diagonal - only once it exists
    if (step = 2) {
        b := SBrush(FA(Alpha(acc, 150), f))
        FillEll(bx - 3, by - 3, 6, 6, b), DelB(b)
    }
    br := 1 + 0.06*(Sin(DecT(now)*0.004) + 1)/2 + 0.10*kick
    L := r*0.72*br
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), 240), f), 2.6)
    Line(ax, ay, ax + sgn*L, ay, pn)
    Line(ax, ay, ax, ay + sgn*L, pn), DelP(pn)
    ; crosshair on the exact point being asked for
    pn := Pen(FA(Alpha(AccHi(acc, 0.5), 200), f), 1.2)
    Line(ax - 7, ay, ax + 7, ay, pn)
    Line(ax, ay - 7, ax, ay + 7, pn), DelP(pn)
    b := SBrush(FA(Alpha(AccHi(acc, 0.55), 245), f))
    FillEll(ax - 2.4, ay - 2.4, 4.8, 4.8, b), DelB(b)
    ; a ring leaving the point - slow while waiting, a hard one on a step change
    if !hubLowPerf {
        loop 2 {
            k := A_Index - 1
            pr := Mod(DecT(now) + k*700, 1400)/1400.0
            pn := Pen(FA(Alpha(acc, Round(120*(1 - pr))), f), 1.6*(1 - pr) + 0.3)
            rr := 5 + pr*(r*0.9)
            Ell(ax - rr, ay - rr, rr*2, rr*2, pn), DelP(pn)
        }
    }
    if (kick > 0.01) {
        e := 1 - kick
        pn := Pen(FA(Alpha(AccHi(acc, 0.45), Round(220*kick)), f), 2.4*kick + 0.3)
        rr := 6 + e*(r*1.1)
        Ell(ax - rr, ay - rr, rr*2, rr*2, pn), DelP(pn)
    }
}

PuzCalDraw() {
    global G, PZ_calCX, PZ_calCY
    if (PZ_calGui = "" || !PZ_calG)
        return
    if !PZ_cal {
        PuzCalCardKill()
        return
    }
    Critical "On"
    g0 := G
    G := PZ_calG
    now := A_TickCount
    W := PZ_calW, H := PZ_calH
    acc := hubAccent
    PuzCursorPos(&mcx, &mcy)
    PZ_calCX := mcx, PZ_calCY := mcy

    it := Min((now - PZ_calOpenAt)/420.0, 1.0)
    ei := 1 - (1 - it)**3
    f  := Min(it*1.7, 1.0)
    winA := Round(255*f)
    yOff := Round((1 - ei)*22*scaleF)
    ims := now - PZ_calOpenAt
    stg := ims < 800
    s1 := stg ? Ease3((ims - 40)/360.0)  : 1.0
    s2 := stg ? Ease3((ims - 130)/360.0) : 1.0
    s3 := stg ? Ease3((ims - 220)/360.0) : 1.0
    s4 := stg ? Ease3((ims - 310)/360.0) : 1.0
    pulse := (Sin(DecT(now)*0.005) + 1)/2
    ; a step change re-plays the middle of the card rather than the whole thing
    kick := (PZ_calStepAt && now - PZ_calStepAt < 520)
          ? 1 - Ease3((now - PZ_calStepAt)/520.0) : 0.0
    warnT := (PZ_calWarn != "" && PZ_calWarnAt && now - PZ_calWarnAt < 4000)
           ? Clamp(1 - (now - PZ_calWarnAt - 3200)/800.0, 0.0, 1.0) : 0.0
    edge := warnT > 0.01 ? AMBER : acc

    ResetSurface(G, PuzCalWinW()/(PZ_calW + PZ_calPad*2), PuzCalWinH()/(PZ_calH + PZ_calPad*2))
    DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)

    ; every coordinate below is CARD-relative; the bleed is applied once here
    stPad := PushShift(PZ_calPad, PZ_calPad)
    stC := PushXform(W/2, H/2, 0.955 + 0.045*ei, 0)

    ShadowDraw(0, 3, W, H, 16, 10, 8, 8, f)
    b := BgV(0, 0, W, H, FA(0xF2222438, f), FA(0xF8121423, f))
    FillRR(0, 0, W, H, 16, b), DelB(b)

    p := RRPath(0, 0, W, H, 16)
    svC := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 1)
    PanelBackdrop(0, 0, W, H, acc, f, now, 0.95)
    rcD := Buffer(16), NumPut("float", -1, "float", -1, "float", W + 2, "float", H + 2, rcD)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcD, "uint", FA(0x0EFFFFFF, f)
          , "uint", 0x00FFFFFF, "int", 2, "int", 3, "ptr*", &db := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", db, "float", 0, "float", 0, "float", W, "float", H), DelB(db)
    ; travelling scan band - brisk, because this card is waiting on you
    per := 2600.0
    swx := -26 + (W + 52)*(Mod(DecT(now), per)/per)
    c0s := AccHi(acc, 0.3) & 0xFFFFFF
    c1s := FA(Alpha(c0s, 38), f)
    rcS := Buffer(16), NumPut("float", swx - 25, "float", -2, "float", 26, "float", H + 4, rcS)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS, "uint", c0s, "uint", c1s, "int", 0, "int", 3, "ptr*", &sbA := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbA, "float", swx - 24, "float", 0, "float", 24, "float", H), DelB(sbA)
    rcS2 := Buffer(16), NumPut("float", swx - 1, "float", -2, "float", 26, "float", H + 4, rcS2)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS2, "uint", c1s, "uint", c0s, "int", 0, "int", 3, "ptr*", &sbB := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbB, "float", swx, "float", 0, "float", 24, "float", H), DelB(sbB)
    ; accent rail
    b := SBrush(FA(Alpha(edge, Min(255, 46 + 24*pulse + 70*warnT)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", 0, "float", 0, "float", 14, "float", H), DelB(b)
    b := VBrush(0, 0, 4.5, H, FA(Alpha(edge, 245), f), FA(Alpha(edge, 120), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", 0, "float", 0, "float", 4.5, "float", H), DelB(b)
    Pop(svC)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)

    pn := Pen(FA(0x28FFFFFF, f), 1)
    StrokeRR(0, 0, W, H, 16, pn), DelP(pn)
    if (warnT > 0.01) {
        pn := Pen(FA(Alpha(AMBER, Round(200*warnT)), f), 1.5)
        StrokeRR(0.8, 0.8, W - 1.6, H - 1.6, 15, pn), DelP(pn)
    }
    pn := Pen(FA(0x16FFFFFF, f), 1)
    Line(18, 1.5, W - 18, 1.5, pn), DelP(pn)
    pn := Pen(FA(0x30000000, f), 1)
    Line(18, H - 1.5, W - 18, H - 1.5, pn), DelP(pn)
    loop 4 {
        k := A_Index - 1
        shim := (Sin(DecT(now)*0.006 + k*1.5708) + 1)/2
        ga := Min(255, 120 + 40*pulse + 58*shim + 90*kick)
        xk := (k = 1 || k = 2) ? W - 31.5 : 0.5
        yk := (k >= 2) ? H - 31.5 : 0.5
        ang := k = 0 ? 195 : k = 1 ? 285 : k = 2 ? 15 : 105
        pn := Pen(FA(Alpha(edge, ga), f), 2)
        Arc(xk, yk, 31, 31, ang, 60, pn), DelP(pn)
    }

    ; ---- header ----
    hdy := -(1 - s1)*6
    Txt(APPNAME, 36, 8 + hdy, 90, 20, fBrand, FA(0xCFE8EAF6, f*s1), fmtL)
    b := SBrush(FA(Alpha(acc, Round(160 + 90*pulse)), f*s1))
    FillEll(36 + wZeal + 6, 15.5 + hdy, 5, 5, b), DelB(b)
    Txt("GRID SETUP", 36, 24 + hdy, 200, 16, fBadge
        , FA(Alpha(AccHi(acc, 0.4), 215), f*s1), fmtL)
    ; ESC chip
    ew := 92, ex := W - 20 - ew, ey := 12 + hdy
    b := SBrush(FA(Alpha(0xFFFFFF, 12), f*s1))
    FillRR(ex, ey, ew, 20, 7, b), DelB(b)
    MicroBackdrop(ex, ey, ew, 20, 7, acc, f*s1, now, 0.8)
    pn := Pen(FA(Alpha(acc, 90), f*s1), 1)
    StrokeRR(ex, ey, ew, 20, 7, pn), DelP(pn)
    b := VBrush(ex + 7, ey + 4, 26, 12, FA(0xFF343752, f*s1), FA(0xFF1C1E33, f*s1))
    FillRR(ex + 7, ey + 4, 26, 12, 3, b), DelB(b)
    pn := Pen(FA(Alpha(acc, 130), f*s1), 1)
    StrokeRR(ex + 7, ey + 4, 26, 12, 3, pn), DelP(pn)
    TxtP("ESC", ex + 7, ey + 2, 26, 15, fBadge, FA(0xE0E8EAF6, f*s1), fmtC)
    Txt("cancels", ex + 39, ey + 2, ew - 44, 16, fHint, FA(0x9AC7CBE0, f*s1), fmtL)
    FadeLine(20, W - 20, 48, 0x30FFFFFF, f*s1)

    ; ---- reticle ----
    PuzCalReticle(56, 92 + (1 - s2)*8, 26, acc, f*s2, now, PZ_cal, kick)

    ; ---- instruction ----
    tx := 104 + (1 - s3)*10, tw := W - 124
    ttl := (PZ_cal = 1) ? "Click the TOP-LEFT corner of the board"
                        : "Now click the BOTTOM-RIGHT corner"
    Txt(FFMElide(ttl, HL.fV, tw), tx, 56, tw, 26, HL.fV
        , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.18), 245), f*s3), fmtL)
    sub := (PZ_calWarn != "" && warnT > 0.01) ? PZ_calWarn
         : (PZ_cal = 1) ? "The outer corner of the whole grid, not the first circle."
                        : "The opposite outer corner, diagonally across from the first."
    scl := (warnT > 0.01) ? AMBER : 0xFFC7CBE0
    if (warnT > 0.01) {
        ; caution triangle, drawn rather than fonted so it takes the fade
        wx := tx + 5, wy := 92
        pn := Pen(FA(Alpha(AccHi(AMBER, 0.35), 235), f*s3), 1.3)
        Line(wx, wy - 5, wx + 5, wy + 4, pn)
        Line(wx + 5, wy + 4, wx - 5, wy + 4, pn)
        Line(wx - 5, wy + 4, wx, wy - 5, pn), DelP(pn)
    }
    Txt(FFMElide(sub, fHint, tw - (warnT > 0.01 ? 18 : 0))
        , tx + (warnT > 0.01 ? 18 : 0), 84, tw, 18, fHint
        , FA(Alpha(scl, warnT > 0.01 ? 235 : 165), f*s3), fmtL)

    ; ---- live readout ----
    ; The second click is the one that decides the cell pitch, so show the pitch
    ; it would produce BEFORE it is committed. A grid you can check on screen
    ; beats a number you find out about afterwards.
    ro := "cursor  " mcx ", " mcy
    if (PZ_cal = 2) {
        dxp := mcx - PZ_calX, dyp := mcy - PZ_calY
        ro .= (dxp > 60 && dyp > 60)
            ? ("      cells  " Round(dxp/PZ_GridN()) " × " Round(dyp/PZ_GridN()) " px")
            : "      keep going down and right"
    }
    b := SBrush(FA(Alpha(acc, Round(120 + 100*pulse)), f*s4))
    FillEll(tx, 111, 4, 4, b), DelB(b)
    ; fHint, not HL.fXs. HL.fXs is 6.5 pt - it exists for badges and pips, and
    ; on a 470 px card it is a squint. This line carries the live pitch the
    ; second click is about to commit, so it is the last thing on the card that
    ; should be hard to read.
    Txt(FFMElide(ro, fHint, tw - 12), tx + 10, 103, tw - 12, 18, fHint
        , FA(0xB4C7CBE0, f*s4), fmtL)

    FadeLine(20, W - 20, 126, 0x26FFFFFF, f*s4)

    ; ---- the one thing that can invalidate this calibration ----
    ; The three-line banner Roblox puts above the board on the FIRST puzzle of a
    ; generator pushes the whole board down 54 px. Calibrate against that state
    ; and every later board is 54 px out; calibrate without it and the module's
    ; own first-board offset handles the banner for you. So it is said here,
    ; while the corners are being clicked, rather than in a note somewhere that
    ; gets read afterwards.
    dbY := 134, dbH := 48
    b := VBrush(20, dbY, W - 40, dbH, FA(Alpha(AMBER, 22), f*s4), FA(Alpha(AMBER, 9), f*s4))
    FillRR(20, dbY, W - 40, dbH, 8, b), DelB(b)
    pn := Pen(FA(Alpha(AMBER, 55), f*s4), 1)
    StrokeRR(20, dbY, W - 40, dbH, 8, pn), DelP(pn)
    ; the same drawn caution mark the warning line uses, so the two read as one
    ; family rather than two conventions
    wx2 := 38, wy2 := dbY + dbH/2
    pn := Pen(FA(Alpha(AccHi(AMBER, 0.35), 225), f*s4), 1.5)
    Line(wx2, wy2 - 7, wx2 + 7, wy2 + 6, pn)
    Line(wx2 + 7, wy2 + 6, wx2 - 7, wy2 + 6, pn)
    Line(wx2 - 7, wy2 + 6, wx2, wy2 - 7, pn), DelP(pn)
    dbW := W - 40 - 46
    Txt(FFMElide("SET THE GRID WITH NO BANNER ABOVE THE BOARD", fBadge, dbW)
      , 56, dbY + 7, dbW, 16, fBadge, FA(Alpha(AMBER, 240), f*s4), fmtL)
    ; Single-quoted, so the quotes around the game's own wording are literal.
    ; A backslash escapes NOTHING in an AHK v2 string: a backslash-quote just
    ; ends the string there and leaves the rest of the line as an illegal
    ; expression, which is exactly what it did. The escape for a quote inside a
    ; double-quoted string is a doubled quote; a single-quoted string is
    ; cleaner when the text is mostly quotes.
    ; shortened to FIT rather than left to elide - a warning that trails off in
    ; an ellipsis is a warning half read
    Txt(FFMElide('"Connect all of the dots below..." pushes the board down 54 px'
               , fHint, dbW)
      , 56, dbY + 26, dbW, 17, fHint, FA(Alpha(0xFFC7CBE0, 185), f*s4), fmtL)

    ; ---- step pips ----
    ; The connector fills as you advance, so the flow is legible before the
    ; first click rather than only in hindsight.
    py := 196
    fillE := (PZ_cal = 2) ? Ease3(Clamp((now - PZ_calStepAt)/420.0, 0.0, 1.0)) : 0.0
    p1x := 36, p2x := 150
    ; ---- the rail starts AFTER the first label, not at the first pip ----
    ; It ran p1x+9 .. p2x-9, which is 45..141, while the label beside pip one sat
    ; at 47..143 in a fixed 96-wide box. Same strip of the card, so the rail was
    ; drawn straight through the word and "top-left" appeared struck out. Label
    ; two had it at the other end: 161..257 against a hint that begins at 250.
    ;
    ; Both measured now rather than assumed. MeasureW caches, so this costs a map
    ; lookup per frame and the layout survives a font or DPI change.
    lw1 := MeasureW("top-left", fBadge)
    lw2 := MeasureW("bottom-right", fBadge)
    l1x := p1x + 11, l2x := p2x + 11
    rx0 := l1x + lw1 + 10                  ; clear of the first label
    rx1 := p2x - 9                         ; short of the second pip
    if (rx1 - rx0 > 4) {
        b := SBrush(FA(Alpha(0xFFFFFF, 26), f*s4))
        FillRR(rx0, py - 1, rx1 - rx0, 2, 1, b), DelB(b)
        if (fillE > 0.004) {
            b := VBrush(rx0, py - 1, (rx1 - rx0)*fillE, 2
                      , FA(Alpha(AccHi(acc, 0.4), 235), f*s4), FA(Alpha(acc, 170), f*s4))
            FillRR(rx0, py - 1, Max(2, (rx1 - rx0)*fillE), 2, 1, b), DelB(b)
        }
    }
    loop 2 {
        k := A_Index
        pxk := (k = 1) ? p1x : p2x
        done := (PZ_cal > k)
        actv := (PZ_cal = k)
        col := (done || actv) ? acc : 0xFF6E7590
        if actv {
            loop 2 {
                r_ := 7 + A_Index*(2.2 + 2.0*pulse)
                b := SBrush(FA(Alpha(acc, 22 - A_Index*7), f*s4))
                FillEll(pxk - r_, py - r_, r_*2, r_*2, b), DelB(b)
            }
        }
        b := SBrush(FA(Alpha(col, done ? 220 : (actv ? Round(190 + 65*pulse) : 70)), f*s4))
        FillEll(pxk - 5, py - 5, 10, 10, b), DelB(b)
        if done {
            pn := Pen(FA(Alpha(0x05060C, 245), f*s4), 1.6)
            Line(pxk - 2.4, py + 0.2, pxk - 0.6, py + 2.2, pn)
            Line(pxk - 0.6, py + 2.2, pxk + 2.6, py - 2.2, pn), DelP(pn)
        } else if actv {
            b := SBrush(FA(Alpha(0x05060C, 235), f*s4))
            FillEll(pxk - 1.8, py - 1.8, 3.6, 3.6, b), DelB(b)
        }
        ; boxed to the MEASURED width - a 96-wide box for a 42-wide word is 54
        ; pixels of invisible label sitting on top of whatever comes next
        Txt(k = 1 ? "top-left" : "bottom-right", (k = 1) ? l1x : l2x, py - 9
            , ((k = 1) ? lw1 : lw2) + 4, 18, fBadge
            , FA(Alpha((done || actv) ? AccHi(acc, 0.35) : 0xFFC7CBE0, (done || actv) ? 225 : 120), f*s4), fmtL)
    }
    ; the hint takes whatever is left to the right of the second label, and is
    ; dropped rather than overlapped when that is not enough room
    hx := l2x + lw2 + 18
    if (W - 16 - hx >= 130)
        Txt("the hub is hidden until this finishes", hx, py - 9, W - 16 - hx, 18, fHint
            , FA(0x72C7CBE0, f*s4), fmtR)

    Pop(stC)
    Pop(stPad)

    G := g0
    w2 := PuzCalWinW(), h2 := PuzCalWinH()
    pt0 := Buffer(8, 0)
    sz := Buffer(8), NumPut("int", w2, "int", h2, sz)
    ptd := Buffer(8), NumPut("int", PZ_calPX, "int", PZ_calPY + yOff, ptd)
    bf := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
    DllCall("user32\UpdateLayeredWindow", "ptr", PZ_calGui.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz
          , "ptr", PZ_calDc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
    Critical "Off"
}

PuzCalStart() {
    global PZ_cal, PZ_calHub, PZ_calSlot
    ; Never on top of a running solve. The walk reads PuzPX per cell, so a
    ; calibration landing mid-board would move the board out from under a drag
    ; already in flight - and this also hides the hub and suspends the markers,
    ; both of which the solver is relying on.
    if PZ_solving {
        PuzSay("busy solving - try again in a moment", 0)
        return
    }
    if PZ_cal {                            ; the button reads CANCEL in this state
        PuzCalCancel()
        return
    }
    ; Slot 1 = the top of the screen. The board is centred, so the card starts
    ; clear of it and only moves if a corner click proves otherwise.
    PZ_cal := 1, PZ_calSlot := 1
    PuzMarkersSuspend(1)                   ; they sit exactly where you must click
    ; The hub is 832x572 and centred, and the board is centred too - at 1080p
    ; the board is entirely inside it. Remembered, so only what we hid comes
    ; back: a hub the user had already put away stays away.
    PZ_calHub := 0
    if (hubLive && !hubHidden) {
        PZ_calHub := 1
        HubHide()
    }
    ; NO #HotIf on these. A criterion has to be evaluated on the main thread
    ; while the hook holds the click, the card's renderer takes Critical, and
    ; past the hook's timeout the hotkey is treated as not matching - so a
    ; fraction of the corner clicks would fall through unhandled. The handler
    ; tests PZ_cal itself, in one line, instead.
    try Hotkey("~*LButton", PuzCalClick, "On")
    try Hotkey("*Escape", PuzCalEsc, "On")
    PuzCalCard()
    HubPoke()
}

PuzCalCancel() {
    global PZ_cal, PZ_calHub
    if !PZ_cal
        return
    PZ_cal := 0
    try Hotkey("~*LButton", "Off")
    ; only if this session turned it on - PuzClashExpire owns Escape otherwise
    if !PuzClashUp()
        try Hotkey("*Escape", "Off")
    PuzCalCardKill()
    PuzMarkersSuspend(0)
    if PZ_calHub {
        PZ_calHub := 0
        HubShow()                          ; setup was started FROM the hub
    }
    HubPoke()
}
PuzCalEsc(*) {
    if PZ_cal
        PuzCalCancel()
}

PuzCalClick(*) {
    global PZ_cal, PZ_calX, PZ_calY
    if !PZ_cal
        return
    PuzCursorPos(&x, &y)
    ; The card is click-THROUGH (WS_EX_TRANSPARENT), so the click reaches here
    ; even when it landed on the instructions - but a corner underneath them is
    ; one the user cannot see to aim at. PuzCalNudge owns the slot, the position
    ; and the entrance replay; do not reach past it.
    if (PZ_calGui != "" && x >= PZ_calPX && x < PZ_calPX + PuzCalWinW()
                        && y >= PZ_calPY && y < PZ_calPY + PuzCalWinH()) {
        PuzCalNudge()
        return
    }
    if (PZ_cal = 1) {
        PZ_calX := x, PZ_calY := y
        PZ_cal := 2
        PuzCalCard()
        HubPoke()
        return
    }
    ; ---- second corner ----
    ; NORMALISED rather than ordered. Refusing anything but top-left first made
    ; the user start over; min/max accepts either diagonal and needs no error.
    ax := Min(PZ_calX, x), ay := Min(PZ_calY, y)
    bx := Max(PZ_calX, x), by := Max(PZ_calY, y)
    n  := PZ_GridN()
    if (bx - ax < n*5 || by - ay < n*5) {  ; under 5 px a cell is not a board
        PuzCalCard("too small - click OPPOSITE corners of the " n "x" n " box")
        return
    }
    ; The BOX is what gets stored - see PZ_Grid. The division into cells happens
    ; on read, so this same calibration answers for every grid size.
    if !PuzGridSane(ax, ay, bx - ax, by - ay) {
        PuzCalCard("that is not a board - try again, or ESC")
        return
    }
    sx := (bx - ax)/n, sy := (by - ay)/n
    PuzGridSet(ax, ay, bx - ax, by - ay)
    PuzGridInvalidate()
    PuzCalCancel()                         ; card down, hub back, markers back
    saved := PuzGridSave()
    ; The markers are NOT forced on here. They are a saved preference, and a
    ; calibration is no reason to overwrite a setting the user chose - the old
    ; flow turned them on and WROTE that, so running SET GRID once left them on
    ; forever. If they are off, say how to look instead.
    PuzSay(!saved     ? "grid set - BUT NOT SAVED, zeal.ini is not writable"
         : PZ_mkWant  ? ("grid set - " Round(sx) " px cells")
                      : ("grid set - " Round(sx) " px cells (markers off - press "
                         (mkKey = "" ? "the markers key" : mkLabel) " to check)"), saved)
}

; RESET. Back to the compiled-in default, which is a real measured grid rather
; than a placeholder - so this is far less destructive than it reads. The saved
; keys go too, or the next launch would load the calibration straight back.
; ---- the size, saved and restored ----
; Stored as the SIZE, not the index, so reordering or extending PZ_SIZES cannot
; turn someone's saved 10x10 into a 25x25. An unknown or absent value keeps the
; 7x7 default rather than failing.
PuzGridNLoad() {
    global PZ_gridNi
    try {
        want := Integer(IniRead(iniPath, "puzzle", "gridn", "0"))
        for i, v in PZ_SIZES {
            if (v = want) {
                PZ_gridNi := i
                break
            }
        }
    }
}

PuzGridNSave() {
    try IniWrite(PZ_GridN(), iniPath, "puzzle", "gridn")
}

; The card's handler. Same shape as PuzGridReset below it: refuse mid-solve,
; drop the calibration card, move the state, then tear down everything keyed to
; the old grid. The capture DIBs are keyed on region size and the marker surface
; is drawn for one grid only, so both have to go - a 25x25 board read through a
; 7x7 capture buffer is the failure this exists to prevent.
PuzGridNPick(i) {
    if PZ_solving {
        PuzSay("busy solving - try again in a moment", 0)
        return
    }
    if PZ_cal
        PuzCalCancel()
    if !PuzGridNSet(i) {
        PuzSay("already on " PZ_GridLabel(), 1)
        return
    }
    PuzGridInvalidate()
    PuzGridNSave()
    PuzMarkersApply()
    ; A calibration is the BOX, so it carries over and the cells are just
    ; redivided. Say which case the user is in - the numbers differ and the
    ; reason they differ is not visible from the card.
    PuzSay(PZ_Custom()
         ? ("grid " PZ_GridLabel() "  -  " Round(PZ_SX()) " px cells from your SET GRID box")
         : ("grid " PZ_GridLabel() "  -  " Round(PZ_SX()) " px cells (built-in default)"), 1)
}

PuzGridReset() {
    if PZ_solving {
        PuzSay("busy solving - try again in a moment", 0)
        return
    }
    PuzCalCancel()
    had := PZ_Custom()
    PuzGridClear()
    PuzGridInvalidate()
    PuzGridForget()
    PuzMarkersApply()
    PuzSay(had ? "grid reset to the built-in default" : "already on the built-in default", 1)
}

; ============================================================================

; ---- solve: read -> solve -> draw, in one straight pass ----
; Everything is decided before the mouse moves. PZ.msg carries the outcome to
; the PUZZLE AI panel's status line instead of a tooltip - the suite never puts
; text on screen outside its own windows.
; ---- solve: one board, or as many as the key is held for ----
; A tap solves the board on screen. HOLDING keeps going: when a board is
; finished the next deal is picked up as soon as it appears, and releasing stops
; after the board in progress - never mid-line, which would leave half a puzzle
; drawn. Losing focus on Roblox stops it too, so alt-tabbing out is a way out.
PuzSolve() {
    ; PZ_total belongs here for the same reason as the other three: this
    ; function ASSIGNS to it, and an assignment to an undeclared name creates a
    ; local no matter that a super-global of that name exists - the count would
    ; rise inside this call and be thrown away when it returned.
    global PZ_solving, PZ_runs, PZ_total, PZ_sess
    global PZ_paceMul, PZ_paceOk
    global PZ_auPairs, PZ_auShort, PZ_auCells
    global PZ_cancel, PZ_cancelUp
    if (PZ_solving || !puzOn)
        return
    ; Re-read the virtual screen: four GetSystemMetrics calls, and it means a
    ; reading taken mid-transition cannot strand the module. This is for
    ; PuzMoveTo, which normalises every injected coordinate against it - not for
    ; the grid, which no longer knows that a screen exists.
    ; NOT just PuzScreenSync. The screen metrics being fresh was never the
    ; problem - PuzPX's table, the capture buffers and the marker surface were
    ; all built for the old one, and nothing here had any way to know. This
    ; rebuilds them if and only if the screen has moved since the grid was
    ; resolved, so a resolution change mid-session costs one extra pass and a
    ; session that never changes resolution costs four GetSystemMetrics calls.
    PuzScreenGuard()
    ; Declines, and leaves the numbers exactly where they are. The grid comes
    ; back the moment the screen it was measured on does.
    if !PuzGridOnScreen() {
        PuzSay("the grid is not on this screen - it has not been changed", 0)
        return
    }
    ; The key is DOWN right now - that is what got us here - so cancelUp starts
    ; false and a hold can never cancel itself.
    PZ_cancel := 0, PZ_cancelUp := 0
    PZ_solving := 1, PZ_runs := 0
    ; The learned pace starts over on every PRESS. It carries board to board
    ; WITHIN a hold, where the game state is continuous and what it learned is
    ; still true - but a new press is a new attempt at the speed the slider
    ; asked for, and the slowdown it inherited from a stutter three sessions
    ; ago is noise, not a measurement of the machine. Held over presses, a
    ; single missed line cost 30% of the pace until fifteen clean lines had
    ; paid it back, and the only way to get the slider's own speed again was
    ; to press until enough of them accumulated. If the game genuinely needs
    ; the slower pace, line one of the next press rediscovers it in one miss.
    PZ_paceMul := 1.0, PZ_paceOk := 0
    ; The hub renderer goes quiet for the session - see the guard in HubTim for
    ; why stopped rather than slowed. AFTER PZ_solving is raised, so the guard
    ; is already holding the door when this asks for 0; the finally's HubPoke
    ; brings it back once PZ_solving is down again.
    HubTim(0)
    ; per SESSION, like PZ_runs - the point is comparing one tuning setting
    ; against another, and a lifetime total cannot do that
    PZ_auPairs := 0, PZ_auShort := 0, PZ_auCells := 0
    ; The markers sit ON the cell centres, and PuzAuditPath reads the cell
    ; centre - so with them up the audit was sampling its own overlay and
    ; scoring every drawn cell as missing. PuzScanGrid escaped it only because
    ; it samples PZ_SampleOffset off-centre. Out of the picture for the session,
    ; once, rather than per board.
    PuzMarkersSuspend(1)
    ; ---- and our own windows, if any of them is standing on the board ----
    hid := PuzWinsClear()
    ; Hiding is not instant on the screen BitBlt reads - see PZ_SettleMs. Paid
    ; once per session rather than per board, and only when something was
    ; actually taken off the screen.
    if (hid || PZ_mkWant)
        Sleep PZ_SettleMs
    PZ.runAt := A_TickCount
    HubPoke()
    try {
        prev := "", ready := "", fails := 0
        ; ---- three counters, not one ----
        ; PZ_runs used to be all three at once: the loop guard, the "boards
        ; solved" figure and the thing PZ_MaxRuns capped. The repair path below
        ; re-solves the board already on screen, so every one of those passes
        ; was counted and reported as another board solved - and PZ_total is
        ; the LIFETIME figure written to zeal.ini, so it inflated permanently.
        ;
        ;   iters   every pass, and the only thing PZ_MaxRuns caps. A stuck key
        ;           still terminates whatever the passes were doing.
        ;   PZ_runs / PZ_total  genuinely NEW boards only - a signature this
        ;           session has not already solved.
        ;   repair  consecutive repair passes, capped separately below.
        iters := 0, repair := 0, lastSig := ""
        loop {
            iters += 1
            sig := ""
            ; An exception in here used to end the session outright. A bad scan
            ; is not a reason to stop holding.
            try
                sig := PuzSolveOne(ready)
            catch as e
                PuzSay("error: " e.Message, 0)
            ready := ""
            if PZ_cancel {
                PuzSay("cancelled" (PZ_runs ? " after " PZ_runs " board" (PZ_runs = 1 ? "" : "s") : ""), 0)
                break
            }
            if (sig = "") {
                ; Nothing solvable THIS time: a scan can catch a deal mid-deal,
                ; a colour can read as three dots for a frame. That is a reason
                ; to look again, not to stop - the key is still down.
                ; A search that hit a limit is not a board that read badly, and
                ; retrying it runs the SAME expensive search on the SAME board up
                ; to PZ_MaxFails times - six passes of the thing that was already
                ; too slow once. PuzSolveBoard already says which case this is;
                ; the retry loop just never asked.
                if PZ_solveOut
                    break                      ; PuzSolveOne has said what stopped it
                if !PuzHeld()
                    break
                if (++fails >= PZ_MaxFails) {
                    PuzSay("stopped - board unreadable", 0)
                    break
                }
                ; ---- the only place the grid may move ----
                ; Two failures in a row, and only once for the whole session.
                ;
                ; The second failure is what separates "the board has MOVED"
                ; from "the board was mid-deal": a deal resolves on the next
                ; look, a moved board never does. Anchoring on the first miss
                ; meant every transient got the grid dragged somewhere.
                ;
                ; Once per session because the offset is applied with +=, so a
                ; second one adds to the first rather than replacing it - six
                ; retries could walk the grid a long way from a calibration that
                ; was right to begin with. It cannot happen now.
                ;
                ; And the cursor is parked by the attempt that just failed, so
                ; the capture sees the same screen the scan does.
                ; A re-anchor used to fire here after two failed scans. Removed:
                ; a board that will not read is a reason to say so, never a
                ; reason to move the grid out from under the user.
                Sleep PZ_RetryWait
                continue
            }
            fails := 0
            prev := sig
            ; A board that reads the same as the one just solved is the SAME
            ; board redrawn, not a new one. It still counts as work done - the
            ; loop guard sees it - but not as a board solved.
            if (sig != lastSig) {
                lastSig := sig, repair := 0
                PZ_runs += 1
                PZ_total += 1
                PZ_sess += 1
            }
            PuzSay((PZ_runs > 1 ? PZ_runs " boards solved" : PZ.lines " lines drawn")
                 . "  ·  " PuzStageMs(), 1)
            PuzAuditTip()                      ; tray tooltip, not the screen
            ; A tap ends here. Only a held key goes looking for the next deal.
            if !PuzHeld()
                break
            if (iters >= PZ_MaxRuns) {         ; a stuck key cannot run forever
                PuzSay("stopped after " PZ_runs " boards", 1)
                break
            }
            ; Park BEFORE watching, not inside the next solve: the cursor
            ; finishes a board sitting on the last dot, and a hover glow there
            ; would land in every poll's scan.
            PuzParkCursor()
            PZ.stage := "waiting for the next deal"
            ready := PuzWaitNextBoard(prev)
            if !IsObject(ready) {
                if !PuzHeld()
                    break
                ; No new deal arrived, but the key is still down. Waiting longer
                ; is the one thing that cannot help: either a line came up short
                ; and the board is unfinished, or the game is sitting on the same
                ; board. Solving what is on screen covers both - and re-drawing a
                ; finished line is harmless, so this repairs an incomplete board
                ; instead of quietly ending the session, which is what it used to do.
                ;
                ; BOUNDED, though. A repair that did not take will not take on the
                ; third attempt either, and the state that produces it - a solved
                ; board still on screen with nothing new coming, because the player
                ; walked away from the generator with the key down - used to grind
                ; all the way to PZ_MaxRuns. That is 300 passes of a full solve plus
                ; a 2.5 s timeout: a quarter of an hour redrawing lines that are
                ; already there. Two attempts is as much as the case is worth.
                if (++repair > PZ_RepairMax) {
                    PuzSay("stopped - no new board", 1)
                    break
                }
                prev := ""
                continue
            }
        }
    } finally {
        PZ_solving := 0, PZ.stage := ""
        PuzMarkersSuspend(0)
        PuzWinsRestore()               ; only what this session took off the screen
        ; once per session, not once per board - see the note on PZ_total
        try IniWrite(PZ_total, iniPath, "puzzle", "solved")
        ; the last session's audit, so two tuning runs can be compared after the
        ; fact rather than from memory
        if PZ_Audit {
            PuzAuditTip()
            try IniWrite(PZ_auPairs " pairs, " PZ_auShort " short, " PZ_auCells " cells"
                       , iniPath, "puzzle", "lastaudit")
        }
        HubPoke()
    }
}

; Still holding, and still pointed at the game.
; True when this press has run out of time. `stage` is recorded rather than
; passed back, so whichever call site notices first, the message names the stage
; that actually overran instead of the one that happened to check.
PuzBoardOver(stage) {
    global PZ_boardOut
    if (A_TickCount <= PZ_boardEnd)
        return 0
    if (PZ_boardOut = "")
        PZ_boardOut := stage
    return 1
}

; The per-stage breakdown, compact enough to sit on the status line. Stages
; under 5 ms are dropped - naming them costs more room than the number is worth.
PuzStageMs() {
    out := ""
    for nm, v in Map("scan", PZ.tScan, "pair", PZ.tPair, "solve", PZ.tSolve
                   , "opt", PZ.tOpt, "draw", PZ.tDraw) {
        if (v >= 5)
            out .= (out = "" ? "" : " ") nm " " v
    }
    return out = "" ? "under 5ms" : out "ms"
}

PuzHeld() {
    if (puzKey = "" || !puzOn)
        return 0
    if !GetKeyState(puzKey, "P")          ; the key itself is the user's intent
        return 0
    if WinActive("ahk_exe RobloxPlayerBeta.exe")
        return 1
    ; One unfocused read is not proof. The hub repaints, the markers overlay is
    ; created, a tray balloon appears - any of them can hold the foreground for
    ; a frame, and ending a held session on that looked exactly like the module
    ; stopping on its own. Confirm before believing it.
    Sleep 90
    return WinActive("ahk_exe RobloxPlayerBeta.exe") ? 1 : 0
}

; What is on the board right now, in a form that can be compared. Solving does
; NOT clear the dots, so "are there dots?" cannot answer "has a new board been
; dealt?" - only "is this a different arrangement than the one just solved?" can.
; Called on every scan, and every POLL while waiting for the next deal - so at
; 15 ms intervals for as long as that runs. Format() was costing twelve calls a
; poll to produce a zero-padded hex string that nothing reads: this is compared
; against another signature and never displayed. Plain concatenation is exactly
; as unique and does not parse a format specifier twelve times.
; ---- is this a DEAL, or the board we just drew on? ----
; PuzBoardSig is built from every dot's position and colour. After a board is
; drawn, every cell a line passes through reads as a dot in that line's colour -
; PZ_SampleOffset moves the sample off the digit, not off the line - so the
; finished board's signature is nothing like the signature of the deal it came
; from. `sig != prev` is therefore TRUE for the board that was just solved,
; PuzWaitNextBoard accepts it as a new deal, and PuzSolveOne is handed a hundred
; "dots" on a ten by ten board. They pair into nonsense, the nonsense has no
; solution, and the solver runs all the way to its deadline before saying so.
;
; It is a race with the generator, which is why it does not happen every time:
; the poll has to catch the finished board before the next deal replaces it.
; A couple of boards in is exactly where you would expect to lose that race for
; the first time, and it gets likelier the longer the key is held.
;
; The test is the fact the pairing already relies on: in a deal every colour
; appears EXACTLY twice. A line puts its colour in every cell it crosses, so a
; colour seen three times means a line is drawn in it. One is allowed, because a
; board may legitimately reuse a colour for two distant pairs and PuzMatchBucket
; handles that; two is a drawn board.
;
; That threshold rejects a PARTLY drawn board too, and it should. The repair
; path exists to re-solve a board whose lines came up short - but it re-solves
; from a fresh scan, and a scan of a board with any lines on it reads those
; lines as dots and pairs them into something that was never the puzzle. Short
; lines are already handled where they can be handled correctly: PuzVerifyLine
; checks each line the moment it is drawn, before the next one covers anything.
; The board-level repair had no sound version of itself left, so it now reports
; instead of grinding.
; ---- REVERTED to the frequency test, because the adjacency one was wrong ----
; I replaced this with a test that counted how many dots have an orthogonal
; neighbour of the same colour, on the reasoning that a drawn line is a
; connected run of one colour while a deal's endpoints are isolated. That
; reasoning assumes a SPARSE board - Flow-style, a handful of endpoints in a
; field of empty cells. This board is dense: PuzScanGrid pushes a dot for every
; cell that clears PZ_BrightThresh, so on a full grid every dot has four
; neighbours and two endpoints of one pair landing side by side is ordinary,
; not evidence of anything. The allowance was three. Real boards blew past it
; immediately and every grid stopped solving.
;
; This is the version that was working at 6x6 and 7x7, restored unchanged.
;
; KNOWN LIMITATION, and it is the one that sent me down this road: `over >= 2`
; is a claim about the game's PALETTE, not the board. It holds while a board has
; fewer pairs than there are distinguishable colours - true at 6x6 and 7x7 - and
; fails on 10x10 and 25x25, where reuse is guaranteed and the board is thrown
; out as "already drawn on". Fixing that properly needs the colour histogram of
; a real 10x10 deal, not another guess at a threshold.
PuzLooksLikeDeal(dots) {
    if (dots.Length < 4)
        return 0
    seen := Map(), over := 0
    for d in dots {
        c := d.col
        seen[c] := seen.Has(c) ? seen[c] + 1 : 1
        if (seen[c] = 3)                       ; counted once, on the third sighting
            over++
        ; Two over-full colours is a drawn board. ONE over-full colour that is
        ; very over-full is a different failure with the same cost: a cell
        ; background bright enough to clear PZ_BrightThresh reads as a dot in
        ; every cell it shows through, so the whole board arrives as one colour
        ; seen fifty times. That passed a test that only counted how MANY
        ; colours were over-full, and the fifty "pairs" it produced were the
        ; unsolvable board the search then spent its whole budget on.
        if (over >= 2 || seen[c] > 4)
            return 0
    }
    return 1
}

PuzBoardSig(dots) {
    sig := ""
    for d in dots
        sig .= d.r "," d.c "," d.col ";"
    return sig
}

; Wait for the NEXT deal. It has to differ from the board just solved, group
; into clean pairs, and hold still for two consecutive reads - otherwise a deal
; caught half-drawn gets solved as though it were complete.
PuzWaitNextBoard(prev) {
    t0 := A_TickCount
    seen := "", nSame := 0
    ; Look FIRST, then sleep. The old order spent a poll interval before the
    ; first capture every time, and the board that is on screen at entry is the
    ; finished one - so that first look costs nothing and catches a fast deal
    ; 15 ms sooner.
    first := true
    while (A_TickCount - t0 < PZ_NextTimeout) {
        if (!PuzHeld() || PuzCancelPoll())
            return ""
        if !first
            Sleep PZ_NextPoll
        first := false
        dots := PuzScanGrid()
        if (dots.Length < 4 || Mod(dots.Length, 2))
            continue                           ; empty, or mid-deal
        if !PuzLooksLikeDeal(dots)
            continue                           ; the board we just drew on
        sig := PuzBoardSig(dots)
        if (sig = prev)
            continue                           ; still the finished board
        if (sig = seen) {
            if (++nSame >= 1)
                ; The dots go back with it. The caller would otherwise park,
                ; wait a frame and capture the very same board again before it
                ; could start - a whole extra scan per board, purely to
                ; re-learn what this poll already knows.
                return dots
        } else
            seen := sig, nSame := 0
    }
    return ""
}

; One board: read, solve, draw. Returns the signature of what it drew, or "" if
; there was nothing it could do - having already said why.
PuzSolveOne(dots := "") {
    ; No re-anchoring here. It used to run whenever dots was blank, on the
    ; theory that only a first board arrives that way - but PuzSolve blanks
    ; `ready` after EVERY call, so every retry came back through this line too.
    ; A board that failed to read got the grid moved under it up to PZ_MaxFails
    ; times, each one adding to the last, and the capture was taken BEFORE
    ; PuzParkCursor below - so the anchor was reading a screen with the cursor
    ; still on the board, which is the exact picture the parking exists to
    ; avoid. Whether the grid moved came down to where the pointer happened to
    ; be sitting. It lives in PuzSolve's failure path now, once per session.
    global PZ_solveOut, PZ_boardEnd, PZ_boardOut
    ; Cleared here, not only in PuzSolveBoard: a scan or a pairing that fails
    ; never reaches the solver, and a stale code from the previous board would
    ; make PuzSolve treat a bad read as a stopped search.
    PZ_solveOut := 0
    ; The board's ceiling has to leave room for the search's, or the Min() in
    ; PuzSolveBoard would hand the extra time straight back.
    PZ_boardEnd := A_TickCount + PZ_BoardMs + Max(0, PZ_SolveMax() - PZ_SolveMs)
    PZ_boardOut := ""
    PZ.tScan := 0, PZ.tPair := 0, PZ.tSolve := 0, PZ.tOpt := 0, PZ.tDraw := 0
    t0 := A_TickCount
    if !IsObject(dots) {
        PuzParkCursor()                        ; off the board: no hover glow in the scan
        ; ---- settle for FRAMES, not for a fixed 24 ms ----
        ; What this waits for is the client rendering one more frame with the
        ; cursor off the board, so the hover glow is gone before the capture.
        ; That is a frame count, and every other budget in this module is
        ; already expressed in PZ_FrameMs - this was the one wall-clock constant
        ; left, sized for 60 fps. Two assumed frames, and never longer than the
        ; 24 ms it used to take, so the slow end of the slider is unchanged and
        ; only the fast end gains: 12 ms per board at full speed.
        Sleep Min(PZ_ScanSettle, Max(10, Round(2*PZ_FrameMs)))
        ; Per board, from the session counter - see PuzBoardApply. Nothing is
        ; scanned; board 1 is up, the rest are down, and a button overrides both.
        PZ.stage := "scanning"
        PuzBoardApply()
        dots := PuzScanGrid()
    }
    ; The line that ties the two halves together: the numbers the scan was
    ; taken with, and what came back at them. A grid pointing at the wrong place
    ; reads 0 dots or an odd count, and it does it with the client rect on the
    ; same line - so a board that moved and a grid that moved are finally
    ; distinguishable after the fact.
    if (dots.Length = 0) {
        PuzSay("no dots detected", 0)
        return ""
    }
    ; Checked here as well as in PuzWaitNextBoard: the repair path enters this
    ; function directly, and solving a completed board is the expensive mistake
    ; whichever door it came through.
    if !PuzLooksLikeDeal(dots) {
        PuzSay("that board is already drawn on - waiting for a new deal", 0)
        return ""
    }
    PZ.tScan := A_TickCount - t0
    sig := PuzBoardSig(dots)
    t0 := A_TickCount
    PZ.stage := "pairing"
    pairs := PuzGroupPairs(dots)
    PZ.tPair := A_TickCount - t0
    if (pairs = "")
        return ""                              ; GroupPairs reported the detail
    if PuzBoardOver("pairing") {
        PuzSay("gave up in " PZ_boardOut " - " PuzStageMs(), 0)
        return ""
    }
    t0 := A_TickCount
    PZ.stage := "solving"
    paths := PuzSolveBoard(pairs)
    PZ.tSolve := A_TickCount - t0
    if (paths = "") {
        ; "no solution" was the only thing this could ever say, and on a big
        ; board it is usually the wrong thing: the search was stopped, not
        ; finished. Saying which one it was is the difference between "your grid
        ; is off" and "this board is too big for the solver", and those need
        ; opposite things from the user.
        PuzSay(PZ_solveOut = 1 ? ("gave up after " PZ_iterCap " steps - " PZ_GridLabel() " board, " pairs.Length " pairs")
             : PZ_solveOut = 2 ? ("path got too long for the solver - " PZ_GridLabel() " is at the limit")
             : PZ_solveOut = 3 ? ("out of time after " Round(PZ_SolveMs/1000, 1) "s - " pairs.Length " pairs on a " PZ_GridLabel() " board")
             : PZ_solveOut = 4 ? "cancelled"
                               : "no solution - check the grid", 0)
        return ""
    }
    t0 := A_TickCount
    PZ.stage := "optimising"
    PuzOptimizePaths(paths)                    ; fewer corners, shorter routes
    PZ.tOpt := A_TickCount - t0
    PZ.lines := pairs.Length
    t0 := A_TickCount
    ; The reading, pairing and solving are done; from here the ceiling is the
    ; drawing's own, sized to this board at this speed rather than to the worst
    ; case of both.
    PZ_boardEnd := A_TickCount + PuzDrawBudget(pairs.Length)
    if PuzBoardOver("optimise") {
        PuzSay("gave up in " PZ_boardOut " - " PuzStageMs(), 0)
        return ""
    }
    loop pairs.Length {
        k := A_Index
        ; ---- FOCUS, between lines ----
        ; A board takes ~440 ms to draw and nothing in here used to look at
        ; where the input was going. Alt-tab mid-board and the remaining lines
        ; were still pressed, dragged and released - into whatever window had
        ; come to the front. On a browser that is a text selection or a tab
        ; being torn out of the window; on a file manager it is a drag-and-drop.
        ; The session-level check in PuzSolve only runs BETWEEN boards, so it
        ; could not catch this.
        ;
        ; Between lines is the only safe place to stop: PuzDrawPath presses,
        ; walks and releases as one unit, so the button is always up here and
        ; there is no half-drawn line to unwind. The partial board is left as
        ; it is - PuzSolve treats the empty return as a failed pass, PuzHeld
        ; then agrees that focus is gone, and the session ends.
        if !WinActive("ahk_exe RobloxPlayerBeta.exe") {
            PuzSay("stopped - focus left the game mid-board", 0)
            return ""
        }
        ; Between lines, where PuzDrawPath has already released the button - the
        ; same reason the focus check above sits here rather than inside the walk.
        if PuzCancelPoll() {
            PZ.tDraw := A_TickCount - t0
            PuzSay("cancelled after " (k - 1) " of " pairs.Length " lines", 0)
            return ""
        }
        if PuzBoardOver("drawing") {
            PZ.tDraw := A_TickCount - t0
            PuzSay("gave up in " PZ_boardOut " after " (k - 1) " of " pairs.Length
                 . " lines - " PuzStageMs(), 0)
            return ""
        }
        PZ.stage := "drawing " k "/" pairs.Length
        PuzDrawPath(paths[k])
        ; Verified on every line but the last - the last has nothing after it to
        ; benefit from what is learned, and the board is about to be re-scanned
        ; anyway. PZ_Audit still works as the pure counter it was.
        if (k < pairs.Length)
            PuzVerifyLine(pairs, k, paths[k])
        else if PZ_Audit
            PuzAuditPath(pairs, k, paths[k])
        ; GUARDED, and this is the single largest saving in the module.
        ; PZ_BetweenPaths is 0 and `Sleep 0` is not a no-op: it yields the
        ; timeslice AND lets every other AHK thread run. A line costs ~73 ms at
        ; full speed and the hub wants a frame every 33, so there was a render
        ; pending at essentially every pair boundary - 10 to 25 ms each, six
        ; times a board, on a board that should take 438. PuzDrawPath holds
        ; Critical for the whole line, so this was the one door and it was
        ; being opened deliberately.
        ;
        ; Set PZ_BetweenPaths above 0 and the Sleep happens exactly as before.
        if PZ_BetweenPaths
            Sleep PZ_BetweenPaths
        else
            PuzUiBreath()        ; the clocked version of the same door
    }
    PZ.tDraw := A_TickCount - t0
    return sig
}
PuzAuditPath(pairs, k, path) {
    global PZ_auPairs, PZ_auShort, PZ_auCells
    PZ_auPairs += 1
    n := path.Length
    if (n < 3)                                 ; adjacent pair: no line body to check
        return
    ; ---- capture the PATH, not the board ----
    ; This took a full board-sized BitBlt and then read a handful of pixels out
    ; of it, once per line - about fifteen full-board captures per board to
    ; inspect cells that between them never span more than a fraction of it.
    ; BitBlt cost is proportional to area, so the box is now the path's own
    ; extent. Exactly the same pixels are read and the same answer comes back;
    ; there is simply far less of the screen copied to reach them. Clamped to
    ; the board rect so it can never ask for pixels outside it, and padded by a
    ; cell so the edge samples are never on the boundary.
    PuzBoardRect(&bx0, &by0, &bw0, &bh0)
    lox := hix := PuzPX(path[2][2]), loy := hiy := PuzPY(path[2][1])
    i := 2
    while (i < n) {
        px := PuzPX(path[i][2]), py := PuzPY(path[i][1])
        lox := Min(lox, px), hix := Max(hix, px)
        loy := Min(loy, py), hiy := Max(hiy, py)
        i += 1
    }
    ; `apad`, not `pad`: PAD is the overlay card's padding super-global and AHK
    ; identifiers are case-insensitive. A local wins, but a name that collides
    ; is the exact thing that makes a real collision invisible in an audit.
    apad := 4
    x0 := Max(bx0, lox - apad), y0 := Max(by0, loy - apad)
    x1 := Min(bx0 + bw0, hix + apad + 1), y1 := Min(by0 + bh0, hiy + apad + 1)
    w0 := x1 - x0, h0 := y1 - y0
    if (w0 < 1 || h0 < 1)
        return
    cap := PuzCaptureRegion(x0, y0, w0, h0)
    col  := pairs[k].a.col
    miss := 0
    i := 2
    while (i < n) {
        got := PuzReadPx(cap, PuzPX(path[i][2]) - x0, PuzPY(path[i][1]) - y0)
        if (PuzColorDist(got, col) >= PZ_PairTol)
            miss += 1
        i += 1
    }
    if miss
        PZ_auShort += 1, PZ_auCells += miss
    return miss
}

; ---- VERIFY AND RETRY ----
; The grid at 2880x1620 measures exact - markers land within 1.5 px of every dot
; on a 132.8 px pitch - and the board still does not solve. So the geometry is
; finished and what is left is the drag, and the drag depends on something this
; module cannot see: how often the CLIENT samples the cursor. That is its frame
; rate, and it falls as the resolution rises, which is why the same settings
; that work at 1080p miss cells at 2880 however carefully the pixel speed is
; matched.
;
; Guessing it is what the speed slider does and it has been wrong twice. So this
; measures the result instead: draw the line, read the board back, and if the
; line is not there, draw it again slower. The slowdown is kept for the rest of
; the session, so a client that needs 2x pays the discovery cost once on line
; one and runs correctly from then on.
;
; It costs one capture per line - what PZ_Audit already spent to count - and
; unlike the slider it cannot be set wrong.
global PZ_Verify := 1            ; 0 goes back to drawing blind
; ---- the retry is careful; the SESSION is not punished for it ----
; This was PZ_slowT, a multiplier that ratcheted up every time a line came back
; short and then applied to every cell of every line for the rest of the
; session, compounding to a cap of 6x. One bad line early on and the whole
; session crawled - which is what "slowed x1.80" on the inspector was reporting,
; and it never came back down because nothing ever lowered it.
;
; The redraw itself still gets the slower pace, because a line that just failed
; is exactly the one worth spending time on. It is simply scoped to that redraw
; and cleared afterwards, so the next line starts at full speed again.
global PZ_retryMul := 1.0        ; transient - non-1.0 ONLY inside a verify redraw
global PZ_SlowStep := 1.8        ; how much slower a failed line is redrawn
; ---- and the pace LEARNS, instead of assuming ----
; PZ_FrameMs is an ASSUMED game frame period - the file says so at the top - and
; the slider sets it between 42 ms and 5 ms. Five is an assumption of 200 FPS.
; When the game is actually running slower than the assumption the walk outruns
; it, cells get skipped, the line comes up short, PuzVerifyLine catches it and
; redraws that one line 1.8x slower.
;
; Which is where the inconsistency comes from, and it is not the solver at all:
; how MANY lines fail depends on the game's instantaneous frame rate, so the
; same board drawn twice costs a different number of slow redraws. Nothing about
; the code changed between the fast run and the slow one - Roblox did.
;
; The retry was per-line and forgotten immediately, so every line paid the same
; discovery cost over and over. This carries it: a failure slows the REST of the
; board, and a run of clean lines gives a little back. The pace converges on the
; fastest one this machine and this game actually sustain, usually within a line
; or two, and holds for the rest of the hold. It does NOT hold across presses -
; PuzSolve starts each one at the slider's speed - because carrying it that far
; turned out to carry the stutters too, and "reset it a few times until it goes
; fast" was the user doing by hand what the reset now does.
global PZ_paceMul  := 1.0        ; learned pace, 1.0 = the slider's own speed
global PZ_paceOk   := 0          ; lines in a row that landed first time
global PZ_PACE_UP   := 1.30      ; a failure slows what is left by this
; The give-back was 0.94 per THREE clean lines: fifteen clean lines to undo one
; miss, forty-eight to come down from the cap, and every miss on the way reset
; the count. On a seven-by-seven that is boards, not lines, and it is what made
; one stutter linger for the rest of a hold. 0.90 per two lines undoes a miss
; in six and the cap in eighteen - still slower than the slowdown, so a pace
; that is genuinely needed is not thrown away on a single clean line and then
; missed again, but no longer a tax that outlives the board that levied it.
global PZ_PACE_DOWN := 0.90      ; a clean run hands some back, more gently
global PZ_PACE_MAX  := 2.60      ; ceiling, so one bad board cannot crawl
global PZ_PACE_RUN  := 2         ; clean lines needed before easing back
PuzVerifyLine(pairs, k, path) {
    global PZ_retryMul, PZ_paceMul, PZ_paceOk
    if (!PZ_Verify || path.Length < 3)
        return
    if !PuzAuditPath(pairs, k, path) {
        ; It landed. A run of clean lines says the pace is not what is hurting,
        ; so give a little of it back and keep probing for faster.
        if (++PZ_paceOk >= PZ_PACE_RUN) {
            PZ_paceOk := 0
            PZ_paceMul := Max(1.0, PZ_paceMul * PZ_PACE_DOWN)
        }
        return                       ; the line is on the board - nothing to do
    }
    ; It did not. The next line is about to be drawn into the same conditions,
    ; so slow those too rather than rediscovering this one line at a time.
    PZ_paceOk := 0
    PZ_paceMul := Min(PZ_paceMul * PZ_PACE_UP, PZ_PACE_MAX)
    ; It did not take. Redraw THIS line, and only this line, at the slower pace.
    ; Redrawing a line that partly landed is safe: the game treats a fresh drag
    ; from the same dot as a replacement.
    ;
    ; In a `finally`, because PuzDrawPath can throw - and a multiplier left set
    ; by a throw would be the session-wide slowdown all over again, arrived at
    ; through the back door.
    PZ_retryMul := PZ_SlowStep
    try
        PuzDrawPath(path)
    finally
        PZ_retryMul := 1.0
}

; The tray tooltip is the whole readout. No popup, no status text, nothing on
; screen over the game - hover the tray icon when a session ends and the numbers
; are there.
PuzAuditTip() {
    if !PZ_Audit
        return
    ; APPNAME, not "puzzle_ai" - that name came from the standalone bench file
    ; and this is the hub's tray entry, which should say whose it is
    ; The hint HubHide left on the tray is overwritten by the line below on
    ; every board, and with the hub away this tooltip is the ONLY surface still
    ; on screen that says anything - PZ.msg is drawn by the hub's own FORSAKEN
    ; panel and by nothing else, so the status line cannot be read at all. The
    ; way back rides along with the numbers rather than being buried by them.
    A_IconTip := Format("{} - boards {} - pairs {} - short {} ({} cells)"
                      , APPNAME, PZ_runs, PZ_auPairs, PZ_auShort, PZ_auCells)
               . (hubHidden ? "`nhub hidden - click to open" : "")
}

PuzSay(msg, ok) {
    PZ.msg := msg, PZ.msgOk := ok, PZ.msgAt := A_TickCount
    HubPoke()
}

; ---- the capture rect, in ONE place ----
; PuzScanGrid, PuzAuditPath and the window check below all need the same
; rectangle, and they each had their own copy of the arithmetic. They cannot
; disagree now: a scan that reads one region while the "is anything of ours in
; the way" test asks about another is a test that passes on the wrong rectangle.
PuzBoardRect(&bx, &by, &bw, &bh) {
    off := Round(PZ_SampleOffset * PZ_SX())
    bx := PuzPX(1) - off - 2
    by := PuzPY(1) - 2
    bw := PuzPX(PZ_GridN()) + off + 2 - bx + 1
    bh := PuzPY(PZ_GridN()) + 2 - by + 1
}
PuzRectsHit(ax, ay, aw, ah, bx, by, bw, bh)
    => (ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by)

; ---- get our OWN windows off the board ----
; PuzScanGrid captures the SCREEN - BitBlt from the desktop DC - and that is the
; composited desktop, layered windows included. Every window this suite owns is
; layered, and with ALWAYS ON TOP (the default) they sit over full-screen Roblox.
; So anything of ours covering the board is simply what the scan reads.
;
; The hub is the one that matters. It is 832 x 572 before scaling and CENTRED on
; the primary monitor, and the board is centred too: at 1080p the board is
; entirely inside it. A solve with the hub open read hub pixels and nothing else,
; which arrives as "no dots detected" or a nonsense "detection error" on every
; press. The file already knew this in two other places - PuzCalStart hides the
; hub for exactly this reason, and the anchor watch waits for Roblox to be in
; front because "a capture taken then is of the hub" - but the solve itself
; never hid anything except the markers.
;
; Hiding rather than refusing, because that is what grid setup does and because
; the alternative is a module that tells you to go and close a window before it
; will work. Only what actually OVERLAPS is touched: the two cards live in the
; bottom-right corner by default and are normally left alone, but both are
; draggable and either can be parked on the board.
; ---- what the hub is actually PUTTING ON THE SCREEN ----
; Not the window rect. Collapsed, the hub keeps its full-size surface and
; draws a small pill in the corner of it with everything around that pill
; transparent - so the window rect condemns a minimised hub for 832 x 572 of
; pixels it is not showing, and hiding it takes the pill with it. The pill is
; the one part of the hub that is MEANT to stay on screen.
;
; Returns 1 when the visible thing is the pill, 0 when it is the whole hub.
; The collapsed test is the same two terms HubBodyLive settles this with, and
; for the same reason: minTo is right the instant the button is pressed, minT
; covers a collapse already eased past halfway.
HubVisRect(&x, &y, &w, &h) {
    if (HL.minTo = 1.0 || HL.minT >= 0.5) {
        x := HL.px + (HL.mbx - MBW/2)*HL.k, y := HL.py + (HL.mby - MBH/2)*HL.k
        w := MBW*HL.k, h := MBH*HL.k
        return 1
    }
    x := HL.px, y := HL.py, w := HL.pw, h := HL.ph
    return 0
}
global PZ_slvOv := 0, PZ_slvCard := 0, PZ_slvPill := 0
PuzWinsClear() {
    global PZ_slvOv, PZ_slvCard, PZ_slvPill
    PZ_slvOv := 0, PZ_slvCard := 0, PZ_slvPill := 0
    PuzBoardRect(&bx, &by, &bw, &bh)
    hid := 0
    if (hubLive && !hubHidden && IsObject(HL)) {
        pill := HubVisRect(&hx, &hy, &hw, &hh)
        if PuzRectsHit(hx, hy, hw, hh, bx, by, bw, bh) {
            hid := 1
            if pill {
                ; Treated like the two cards, not like the hub. A raw SW_HIDE
                ; leaves HL.min* alone, so SW_SHOWNA afterwards gives the pill
                ; back exactly as it was. HubHide would not: it drops the pill
                ; state deliberately, so the window would come back EXPANDED -
                ; the one thing a minimised hub must not do.
                PZ_slvPill := 1
                try DllCall("ShowWindow", "ptr", HL.gui.Hwnd, "int", 0)
            } else
                HubHide()              ; and it STAYS hidden - see PuzWinsRestore
        }
    }
    ; SW_HIDE, not the module's own close path: both cards keep rendering to
    ; their layered surface while hidden (UpdateLayeredWindow does not reveal a
    ; hidden window), so nothing is torn down and nothing animates.
    if (abOn && IsSet(ui) && PuzRectsHit(winPX, winPY, PW, PH, bx, by, bw, bh)) {
        PZ_slvOv := 1, hid := 1
        try DllCall("ShowWindow", "ptr", ui.Hwnd, "int", 0)
    }
    if (PZO.gui != "" && PuzRectsHit(PZO.px, PZO.py, PW, PH, bx, by, bw, bh)) {
        PZ_slvCard := 1, hid := 1
        try DllCall("ShowWindow", "ptr", PZO.gui.Hwnd, "int", 0)
    }
    return hid
}
; ---- the hub is NOT brought back ----
; A session ends with you in the game, looking at the next puzzle. Putting a
; window the size of the hub back over the middle of the screen at that moment
; is not a restore, it is an interruption - and it would happen again on the
; next press, and the one after that.
;
; Hidden is a state the suite already supports and already advertises: HubHide
; points the tray at "click to open", and the tray is the way back. Nothing is
; destroyed and nothing is forgotten - the window is intact and one click away.
;
; The two CARDS are restored. They are small, they are the module's own status
; readout, and they were only in the way because they had been dragged there -
; leaving either of them hidden would read as the module having died.
;
; So is the PILL, for the same argument. A minimised hub is already out of the
; way and already one click from being back; taking it off the screen for good
; would be removing the thing the user chose INSTEAD of closing the hub. It is
; also rarely touched at all - the pill lives in the corner of the surface and
; on a centred board it does not reach the capture.
;
; Restores ONLY what this session hid, so a card the user had already put away
; stays away.
PuzWinsRestore() {
    global PZ_slvOv, PZ_slvCard, PZ_slvPill
    if PZ_slvPill {
        PZ_slvPill := 0
        if (hubLive && IsObject(HL))
            try DllCall("ShowWindow", "ptr", HL.gui.Hwnd, "int", 8)   ; SW_SHOWNA
    }
    if PZ_slvCard {
        PZ_slvCard := 0
        if (PZO.gui != "")
            try DllCall("ShowWindow", "ptr", PZO.gui.Hwnd, "int", 8)   ; SW_SHOWNA
    }
    if PZ_slvOv {
        PZ_slvOv := 0
        if IsSet(ui)
            try DllCall("ShowWindow", "ptr", ui.Hwnd, "int", 8)
    }
}

; ---- what the board does, kept as a note ----
; MEASURED, from two screenshots of the same client:
;
;   pitch       86.4 px in both, identical
;   columns     exact in both, 0 px error
;   rows        exact in one, 53.7 px out in the other
;
; A pure vertical translation with the pitch untouched is not a calibration
; that has gone wrong - it is a board that MOVED. The one screenshot carries the
; "Completing four puzzles will fix the generator" banner above the board and
; the other does not; the panel is centred, so a banner of roughly 107 px pushes
; the board down by half of it. 53.7 is half of 107.
;
; That accounts for the sequence people describe: open the puzzle with the
; banner up and the default grid sits a third of a cell high; SET GRID against
; that state and the grid is right until the banner goes away, then wrong by the
; same amount the other way - the "custom grid gets position bugged". RESET, and
; the default happens to match the no-banner state, so the grid looks fixed.
; Nothing in that story is a bug in the numbers.
;
; It is recorded here because it is worth knowing, NOT because anything acts on
; it. If the board moves, that is one press of SET GRID.
; This generation counter is all that remains of the machinery: PuzEnable and
; PuzDisable still bump it so any timer closure captured by an older arm retires
; itself. Nothing that can touch the grid is armed by either of them.
global PZ_ancGen := 0

; ---- the re-anchor is GONE, not disabled ----
; What stood here searched a small window around the calibration for an
; alignment that read as a legal board and moved the ORIGIN onto it, with its
; helper PuzAnchorRead. It was bounded and it never touched the pitch, and the
; measurement above still holds - but none of that earns it a place in the file.
; The grid may only change when the user changes it, and a correct search that
; moves the grid is still a thing that moves the grid.
;
; Leaving the body behind a `return 0` was not neutral either: AHK warns about
; the unreachable code on every launch, which is the file being honest about
; dead code pretending to be documentation. Both functions are deleted, and the
; watch that drove them with them.

PuzScanGrid(cap := "", bx := 0, by := 0) {
    ; samples off-center; the exact center often lands on the white digit,
    ; which would break color pairing
    dots := []
    off := Round(PZ_SampleOffset * PZ_SX())
    if (cap = "") {
        PuzBoardRect(&x0, &y0, &w, &h)         ; one definition, shared - see PuzBoardRect
        cap := PuzCaptureRegion(x0, y0, w, h)
    } else {
        x0 := bx, y0 := by
    }
    ; n and the row offset hoisted: the row was being resolved once per CELL
    ; rather than once per row, so 49 lookups where 7 will do.
    n := PZ_GridN()
    loop n {
        r := A_Index
        ry := PuzPY(r) - y0
        loop n {
            c := A_Index
            cx := PuzPX(c) - x0
            col := PuzReadPx(cap, cx + off, ry)
            if (PuzBrightness(col) <= PZ_BrightThresh)
                col := PuzReadPx(cap, cx - off, ry)
            if (PuzBrightness(col) > PZ_BrightThresh)
                dots.Push({r: r, c: c, col: col})
        }
    }
    return dots
}

PuzBrightness(col) => Max((col >> 16) & 0xFF, (col >> 8) & 0xFF, col & 0xFF)

PuzColorDist(a, b) {
    dr := ((a >> 16) & 0xFF) - ((b >> 16) & 0xFF)
    dg := ((a >> 8) & 0xFF) - ((b >> 8) & 0xFF)
    db := (a & 0xFF) - (b & 0xFF)
    return Sqrt(dr * dr + dg * dg + db * db)
}

; ---- pairing: a MATCHING problem, not a clustering one ----
; This used to cluster dots into colour groups with a fixed tolerance of
; PZ_PairTol (60 in RGB distance) and then require every group to hold exactly
; two. That works while a board carries a handful of colours and cannot work at
; all once it carries many, because the tolerance is an absolute distance and
; the colours have to share one RGB cube:
;
;     8 evenly spaced hues   closest pair 142 apart   fine
;    16 hues                  72                      fine
;    20 hues                  57                      MERGES
;   150 hues                  10                      hopeless
;
; A 25x25 board carries well over a hundred pairs. Two of them land within 60 of
; each other long before that, their four dots collapse into one group, and the
; whole board is rejected with "detection error" before the solver ever runs.
; No tolerance value fixes this - raising it merges more, lowering it splits
; antialiased dots apart.
;
; So the tolerance is gone from the decision. The thing actually known about
; this board is that every colour appears EXACTLY TWICE, which makes this a
; matching problem: pair each dot with its closest colour-match and there is no
; threshold to get wrong. Three passes, cheapest first, because the first one
; resolves nearly everything on a cleanly rendered board:
;
;   1  exact colour        the two dots of a pair are drawn from one value
;   2  colour to within 8  absorbs antialiasing on the sampled pixel
;   3  mutual nearest      whatever is left, by distance, with no threshold
;
; PZ_PairTol survives only as the report threshold in pass 3 - a "closest" match
; further away than that says the board did not read cleanly, which is worth
; saying rather than silently pairing two unrelated dots.
; Each channel is masked out BEFORE it is shifted. Shifting the packed value
; first and masking after lets red's low bits slide down into green's byte, so
; two dots of one colour can land in different buckets while two unrelated ones
; collide.
PuzColorKey(col, shift) =>
    (((((col >> 16) & 0xFF) >> shift) << 16)
   | ((((col >>  8) & 0xFF) >> shift) <<  8)
   |   ((col        & 0xFF) >> shift))

; Squared distance, for the matcher's inner loop. Ordering by d is ordering by
; d^2, and the fallback pass runs this O(m^2) times per round - the Sqrt in
; PuzColorDist is the single most expensive thing on that path and it buys
; nothing there. PuzColorDist keeps the real distance for everything else.
PuzColorDist2(a, b) {
    dr := ((a >> 16) & 0xFF) - ((b >> 16) & 0xFF)
    dg := ((a >> 8) & 0xFF) - ((b >> 8) & 0xFF)
    db := (a & 0xFF) - (b & 0xFF)
    return dr*dr + dg*dg + db*db
}

; Dots sharing one bucket, matched off two at a time. An even bucket larger than
; two is a board that genuinely uses one colour for two different pairs; nearest
; on the BOARD is the only signal left, and it is the right one - the alternative
; was failing the whole board over an ambiguity worth one guess.
PuzMatchBucket(dots, ix, pairs) {
    used := Map()
    for , i in ix {
        ; O(m^2), and m is one colour's share of the board - which on a board
        ; that reads badly is the whole board. Same two courtesies as everything
        ; else that scales with what was scanned.
        PuzUiBreath()
        if (PuzBoardOver("pairing") || PuzCancelPoll())
            break
        if used.Has(i)
            continue
        bj := 0, bd := 999999
        for , j in ix {
            if (j = i || used.Has(j))
                continue
            dd := Abs(dots[i].r - dots[j].r) + Abs(dots[i].c - dots[j].c)
            if (dd < bd)
                bd := dd, bj := j
        }
        if !bj
            continue                         ; odd one out, left for the next pass
        used[i] := 1, used[bj] := 1
        pairs.Push({a: dots[i], b: dots[bj]})
    }
    out := []
    for , i in ix {
        if !used.Has(i)
            out.Push(i)
    }
    return out
}

; One pass of exact-key bucketing. Returns the indices it could not resolve.
PuzPairByKey(dots, ix, shift, pairs) {
    buckets := Map()
    for , i in ix {
        k := PuzColorKey(dots[i].col, shift)
        if !buckets.Has(k)
            buckets[k] := []
        buckets[k].Push(i)
    }
    left := []
    for , bx in buckets {
        if (bx.Length = 2) {
            pairs.Push({a: dots[bx[1]], b: dots[bx[2]]})
            continue
        }
        if (bx.Length = 1) {
            left.Push(bx[1])
            continue
        }
        for , i in PuzMatchBucket(dots, bx, pairs)
            left.Push(i)
    }
    return left
}

PuzGroupPairs(dots) {
    ; An odd count is the one thing no matching can fix, and it is also the
    ; clearest signal the grid is off by a row or a column - one dot found
    ; twice, or one missed.
    if (Mod(dots.Length, 2) = 1) {
        PuzSay("detection error - " dots.Length " dots is an odd number, check the grid", 0)
        return ""
    }
    pairs := []
    ix := []
    loop dots.Length
        ix.Push(A_Index)
    ix := PuzPairByKey(dots, ix, 0, pairs)      ; exact
    ix := PuzPairByKey(dots, ix, 3, pairs)      ; to within 8 per channel
    ; ---- what is left, by colour distance, with no threshold ----
    ; Rounds of MUTUAL nearest rather than one greedy sweep: a dot taking the
    ; first partner within reach is how scan order used to decide pairings, and
    ; it is wrong for the same reason it was wrong before. Two dots that are
    ; each other's closest match are a pair whatever order they were found in.
    ; A round that matches nothing - a cycle of three or more - falls back to
    ; joining the single closest remaining couple, which always makes progress.
    far := 0
    farLim := PZ_PairTol * PZ_PairTol            ; nd holds squared distance
    while (ix.Length >= 2) {
        ; This pass is O(m^2) per round and m is the number of dots no bucket
        ; could resolve. On a board that reads badly that is every dot on it, so
        ; it gets the same two courtesies the search gets: it yields, and it
        ; stops when the press is out of time.
        PuzUiBreath()
        if (PuzBoardOver("pairing") || PuzCancelPoll())
            break
        near := Map(), nd := Map()
        for , i in ix {
            bj := 0, bd := 1.0e9
            for , j in ix {
                if (j = i)
                    continue
                dd := PuzColorDist2(dots[i].col, dots[j].col)
                if (dd < bd)
                    bd := dd, bj := j
            }
            near[i] := bj, nd[i] := bd
        }
        took := Map(), got := 0
        for , i in ix {
            j := near[i]
            if (!j || took.Has(i) || took.Has(j))
                continue
            if (near[j] != i)
                continue                     ; not mutual - leave it for a later round
            took[i] := 1, took[j] := 1, got := 1
            if (nd[i] > farLim)
                far++
            pairs.Push({a: dots[i], b: dots[j]})
        }
        if !got {
            ; a cycle: take the globally closest couple and go round again
            bi := 0, bj := 0, bd := 1.0e9
            for , i in ix {
                if (near[i] && nd[i] < bd)
                    bd := nd[i], bi := i, bj := near[i]
            }
            if !bi
                break
            took[bi] := 1, took[bj] := 1
            if (bd > farLim)
                far++
            pairs.Push({a: dots[bi], b: dots[bj]})
        }
        rest := []
        for , i in ix {
            if !took.Has(i)
                rest.Push(i)
        }
        ix := rest
    }
    if (pairs.Length = 0) {
        PuzSay("detection error - no pairs could be matched", 0)
        return ""
    }
    ; Reported, not fatal. A handful of loose matches on a big board is still a
    ; board worth attempting; the solver will say so if the pairing was wrong.
    if far
        PuzSay(far " pair(s) matched loosely - colours are close on this board", 0)
    ; route short pairs first (insertion sort by manhattan distance)
    i := 2
    while (i <= pairs.Length) {
        j := i
        while (j > 1 && PuzPairDist(pairs[j - 1]) > PuzPairDist(pairs[j])) {
            t := pairs[j - 1], pairs[j - 1] := pairs[j], pairs[j] := t
            j--
        }
        i++
    }
    return pairs
}

PuzPairDist(p) => Abs(p.a.r - p.b.r) + Abs(p.a.c - p.b.c)

PuzSolveBoard(pairs) {
    global PZ_iter, PZ_iterCap, PZ_solveEnd, PZ_solveOut, PZ_stop
    PZ_iter := 0
    PZ_iterCap := PZ_IterMax()
    PZ_stop := 0                 ; the latch is per SOLVE - see PuzSolveStop
    ; Whichever runs out first. The search used to own four seconds regardless
    ; of how much of the press was already gone.
    PZ_solveEnd := Min(A_TickCount + PZ_SolveMax(), PZ_boardEnd)
    PZ_solveOut := 0
    board := []
    loop PZ_GridN() {
        row := []
        loop PZ_GridN()
            row.Push(0)
        board.Push(row)
    }
    for i, p in pairs {
        board[p.a.r][p.a.c] := i
        board[p.b.r][p.b.c] := i
    }
    paths := Map()
    if PuzRoutePair(1, pairs, board, paths)
        return paths
    return ""
}

PuzRoutePair(k, pairs, board, paths, depth := 0) {
    if (k > pairs.Length)
        return true
    p := pairs[k]
    path := [[p.a.r, p.a.c]]
    ; depth carries ACROSS pairs on purpose - the stack does. See PZ_DepthMax.
    return PuzDFS(k, pairs, board, paths, p.a.r, p.a.c, p.b.r, p.b.c, path, 0, 0, depth)
}

; How many free cells this one can still move to.
PuzFreeDeg(board, n, r, c) {
    d := 0
    if (r > 1 && board[r - 1][c] = 0)
        d++
    if (r < n && board[r + 1][c] = 0)
        d++
    if (c > 1 && board[r][c - 1] = 0)
        d++
    if (c < n && board[r][c + 1] = 0)
        d++
    return d
}
; An endpoint of a pair that has NOT been routed yet still needs a way out.
; j <= k means the cell belongs to a pair already routed or to the path being
; drawn right now; above that, only endpoints carry an index, because nothing
; else has been placed for those pairs.
PuzEndAlive(k, pairs, board, n, r, c) {
    j := board[r][c]
    if (j <= k)
        return true
    p := pairs[j]
    o := (p.a.r = r && p.a.c = c) ? p.b : p.a
    if (Abs(r - o.r) + Abs(c - o.c) = 1)
        return true            ; already touching its partner, needs nothing
    return PuzFreeDeg(board, n, r, c) > 0
}
; ---- a path that runs alongside itself is never necessary ----
; If a route reaches a cell that touches an earlier, non-consecutive cell of the
; SAME route, it has looped: you could have stepped straight across at the
; earlier cell and thrown the loop away. The shortened route joins the same two
; endpoints and occupies a strict SUBSET of the cells, so it cannot block
; anything the longer one did not. Every solution therefore has a
; non-self-touching equivalent, and refusing these cannot lose one.
;
; It is also by far the strongest prune available here. Measured on the 10x10
; that was reported: 58,000 work units down to 5,100. On 25x25 boards at the
; density the panel deals: 640,000 down to 83,000, and 970,000 down to 110,000.
; Across 54 generated boards it changed no answer and turned two timeouts into
; solves.
;
; Two neighbours are excluded. The cell we came FROM is the consecutive
; predecessor - that is the path, not a touch. The TARGET is where this route is
; trying to arrive, so running up beside it is the goal rather than a loop.
; Note the start endpoint is deliberately NOT excluded: coming back around to
; touch your own start is exactly the case the shortcut argument covers.
PuzTouchesSelf(k, board, n, nr, nc, pr, pc, tr, tc) {
    if (nr > 1 && board[nr - 1][nc] = k
        && !(nr - 1 = pr && nc = pc) && !(nr - 1 = tr && nc = tc))
        return true
    if (nr < n && board[nr + 1][nc] = k
        && !(nr + 1 = pr && nc = pc) && !(nr + 1 = tr && nc = tc))
        return true
    if (nc > 1 && board[nr][nc - 1] = k
        && !(nr = pr && nc - 1 = pc) && !(nr = tr && nc - 1 = tc))
        return true
    if (nc < n && board[nr][nc + 1] = k
        && !(nr = pr && nc + 1 = pc) && !(nr = tr && nc + 1 = tc))
        return true
    return false
}
; ---- is this step survivable ----
; Two tests, both of which only cut states that provably have no continuation,
; so neither can lose a solution.
;
;  1. the head has nowhere to go and is not beside the target, or the target
;     has nothing left to be entered from. Either way this path is finished.
;  2. filling this cell just took the last free neighbour of an endpoint that
;     still has to be routed.
;
; The second only looks at the FOUR neighbours of the cell just filled, not at
; every remaining pair: nothing else lost a degree, and an endpoint reaching
; zero is always caught on the move that takes its last neighbour. Measured
; against the full scan it prunes identically and costs about a thirtieth.
PuzStepOk(k, pairs, board, n, nr, nc, tr, tc) {
    if (Abs(nr - tr) + Abs(nc - tc) != 1
        && (!PuzFreeDeg(board, n, nr, nc) || !PuzFreeDeg(board, n, tr, tc)))
        return false
    if (nr > 1 && !PuzEndAlive(k, pairs, board, n, nr - 1, nc))
        return false
    if (nr < n && !PuzEndAlive(k, pairs, board, n, nr + 1, nc))
        return false
    if (nc > 1 && !PuzEndAlive(k, pairs, board, n, nr, nc - 1))
        return false
    if (nc < n && !PuzEndAlive(k, pairs, board, n, nr, nc + 1))
        return false
    return true
}
PuzDFS(k, pairs, board, paths, r, c, tr, tc, path, dr, dc, depth := 0) {
    global PZ_iter, PZ_iterCap, PZ_solveEnd, PZ_solveOut
    ; Hoisted, and this is the one that matters most: PuzDFS recurses once per
    ; cell of every path it tries, and the bounds test below runs four times per
    ; recursion. Two interpreted calls each, on a search whose ceiling is two
    ; million nodes. A local copy of a constant is still a constant - the grid
    ; stays unassignable, this is just not asking for it a million times.
    ;
    ; Below the declaration, not above it: a `global` must not be preceded by
    ; other statements in the same function.
    n := PZ_GridN()
    ; Three ways to stop, and all three are recorded so PuzSolveOne can tell
    ; "this board has no solution" apart from "this board was not finished".
    ; They read the same from here and mean completely different things to
    ; whoever pressed the key. Two of them live in PuzSolveStop because the
    ; reachability walk has to answer to them as well.
    if (++PZ_iter, PuzSolveStop())
        return false
    if (depth > PZ_DepthMax) {
        PZ_solveOut := 2
        return false
    }
    dirs := [[r - 1, c], [r + 1, c], [r, c - 1], [r, c + 1]]
    ; ---- four keys, computed ONCE ----
    ; The sort called PuzDKey inside its comparison, twice per comparison, so a
    ; four-element insertion sort spent between six and twelve calls per node
    ; re-deriving four values that never change while the node is being sorted.
    ; PuzDKey is two Abs() and a direction test behind an interpreted call, and
    ; this is the innermost line of the whole search - it runs once per cell of
    ; every path the DFS tries. Computing the keys up front and carrying them
    ; alongside is the same sort with a third of the calls.
    ky := [PuzDKey(dirs[1], r, c, tr, tc, dr, dc), PuzDKey(dirs[2], r, c, tr, tc, dr, dc)
         , PuzDKey(dirs[3], r, c, tr, tc, dr, dc), PuzDKey(dirs[4], r, c, tr, tc, dr, dc)]
    i := 2
    while (i <= 4) {  ; closest to target first; straight beats turning on ties
        j := i
        while (j > 1 && ky[j - 1] > ky[j]) {
            t := dirs[j - 1], dirs[j - 1] := dirs[j], dirs[j] := t
            t := ky[j - 1],   ky[j - 1]   := ky[j],   ky[j]   := t
            j--
        }
        i++
    }
    for d in dirs {
        nr := d[1], nc := d[2]
        if (nr < 1 || nr > n || nc < 1 || nc > n)
            continue
        if (nr = tr && nc = tc) {
            path.Push([nr, nc])
            paths[k] := path.Clone()
            if (PuzRemainingReachable(k + 1, pairs, board) && PuzRoutePair(k + 1, pairs, board, paths, depth + 1))
                return true
            paths.Delete(k)
            path.Pop()
            continue
        }
        if (board[nr][nc] != 0)
            continue
        if PuzTouchesSelf(k, board, n, nr, nc, r, c, tr, tc)
            continue
        board[nr][nc] := k
        path.Push([nr, nc])
        ; ---- two dead ends, caught on the move that creates them ----
        ; Reachability was only tested when a pair COMPLETED, so the search
        ; would walk a path into a corner, or seal off an endpoint it still had
        ; to reach, and only discover it by exhausting everything underneath.
        ; On the 10x10 that was reported this is the difference between 349,000
        ; work units and 58,000 - the board was solvable all along, it was just
        ; landing either side of the four-second deadline depending on the day.
        if (PuzStepOk(k, pairs, board, n, nr, nc, tr, tc)
            && PuzDFS(k, pairs, board, paths, nr, nc, tr, tc, path, nr - r, nc - c, depth + 1))
            return true
        path.Pop()
        board[nr][nc] := 0
    }
    return false
}

PuzDKey(d, r, c, tr, tc, dr, dc) => 2 * (Abs(d[1] - tr) + Abs(d[2] - tc)) + ((d[1] - r = dr && d[2] - c = dc) ? 0 : 1)

; ---- one authority for "stop", and it has to be charged by ALL the work ----
; PZ_iter counted PuzDFS calls and nothing else, and both guards hung off it:
; the node cap directly, and the wall clock through a `Mod(PZ_iter, 1024)` gate.
; But the DFS is not where the time goes. Every time a pair completes,
; PuzRemainingReachable runs a full BFS for every pair still to place, and none
; of that touched the counter. Measured on generated boards:
;
;     7x7     ~30 DFS nodes    ~300 BFS cells      10x uncounted
;     10x10   ~50 DFS nodes  ~1,100 BFS cells   20-34x uncounted
;
; So on a 10x10 board the search does twenty to thirty times more work than the
; thing supposed to be limiting it can see. The four-second deadline is not
; wrong, it is simply never evaluated: PZ_iter crawls to the next multiple of
; 1024 while the real work runs for a minute. That is the freeze, and it is why
; it appears at 10x10 and not at 7x7 - the ratio grows with the board.
;
; The counter is a WORK counter now, charged by the BFS as well, and the gate is
; 256 rather than 1024. Same two limits, actually enforced.
; ---- and it has to LATCH, or it is not a stop at all ----
; This returned 1 and the search CARRIED ON. A stop here only makes the current
; PuzDFS frame return false, which to its parent is indistinguishable from "that
; direction did not work" - so the parent takes the next direction and recurses,
; the counter is no longer a multiple of 256, the clock is not looked at, and
; the full tree keeps being explored. One node in 256 was being abandoned and
; the other 255 ran normally. The four-second deadline pruned about 0.4% of the
; search and terminated nothing.
;
; What actually ended a run was the node cap, which is the only test that was on
; every call - and it scales with the board: 2.0M nodes at 6x6, 5.6M at 10x10,
; 34.7M at 25x25. Interpreted, with the reachability walk charged to the same
; counter, that is seconds at 6x6 and 7x7 and MINUTES at 10x10 and 25x25. It is
; also silent, because the deadline check returns above PuzUiBreath - so once
; the four seconds are up the yield stops happening too and the suite is not
; merely slow, it is frozen with nothing repainting. That is the whole bug, and
; it appears at exactly the two sizes it was reported at.
;
; A latch fixes it in one flag: the first limit to fire is remembered, every
; later call returns immediately, and the recursion unwinds all the way out to
; PuzSolveBoard instead of resuming at the next sibling. The reason is latched
; with it, so the depth prune below cannot overwrite a real timeout on the way
; back up.
PuzSolveStop() {
    global PZ_iter, PZ_iterCap, PZ_solveEnd, PZ_solveOut, PZ_stop
    if PZ_stop
        return 1
    if (PZ_iter > PZ_iterCap) {
        PZ_solveOut := 1, PZ_stop := 1
        return 1
    }
    if !Mod(PZ_iter, 256) {
        if PuzCancelPoll() {
            PZ_solveOut := 4, PZ_stop := 1
            return 1
        }
        if (A_TickCount > PZ_solveEnd) {
            PZ_solveOut := 3, PZ_stop := 1
            return 1
        }
        ; Nothing here is Critical - PuzDrawPath has not started - so this is a
        ; real yield and the hub keeps drawing through a long solve. A search
        ; that legitimately takes four seconds should not look like a hang.
        PuzUiBreath()
    }
    return 0
}

PuzRemainingReachable(fromK, pairs, board) {
    k := fromK
    while (k <= pairs.Length) {
        p := pairs[k]
        if !PuzReachable(p.a.r, p.a.c, p.b.r, p.b.c, board)
            return false
        k++
    }
    return true
}

PuzReachable(sr, sc, tr, tc, board) {
    ; First line: a `global` must not be preceded by another statement.
    global PZ_iter
    if (Abs(sr - tr) + Abs(sc - tc) = 1)
        return true
    ; Hoisted. This is the innermost line of a BFS that itself runs once per
    ; remaining pair after every tentative completion of the DFS above, so two
    ; interpreted calls per neighbour test is two too many. A local copy of a
    ; constant is still a constant.
    n := PZ_GridN()
    ; Key base derived from the grid, not the literal 8 this used to carry. A
    ; base of 8 packs r,c into one integer without collisions only while c stays
    ; under 8 - true at 6, still true at 7, and silently wrong at 8, where
    ; (1,8) and (2,0) collide and the BFS starts skipping cells it never
    ; visited. n+1 is the same trick with the boundary tied to the grid.
    kb := n + 1
    ; ---- a STAMPED array, not a fresh Map ----
    ; This walk runs once per remaining pair after every tentative completion,
    ; so it is called thousands of times in a solve - and it was building a new
    ; Map each time and paying a hash lookup per neighbour. A flat array indexed
    ; by the packed key is a direct index, and stamping it with a per-call
    ; counter means it is never cleared: an entry from a previous call carries
    ; an older stamp and reads as unvisited. Rebuilt only when the grid changes.
    static seenA := [], seenN := 0, seenS := 0
    if (seenN != n) {
        seenA := [], seenN := n, seenS := 0
        loop n*kb + n
            seenA.Push(0)
    }
    seenS += 1
    seenA[sr*kb + sc] := seenS
    ; The queue holds the PACKED KEY, not a two-element array. One allocation
    ; per enqueue was one too many when the key is already being computed.
    q := [sr*kb + sc]
    qi := 1
    while (qi <= q.Length) {
        ; Charged to the same counter the DFS uses, one unit per cell taken off
        ; the queue - see PuzSolveStop. This walk is most of the search's real
        ; cost and used to be invisible to both limits.
        ;
        ; A stop here returns "not reachable", which prunes rather than accepts:
        ; the DFS backs out, its own check fires on the next node, and the board
        ; ends as a stopped search rather than a wrong route. It can cost a
        ; solvable board at the deadline. It cannot draw a line that is wrong.
        if (++PZ_iter, PuzSolveStop())
            return false
        cur := q[qi], qi++
        r := cur // kb, c := cur - r*kb
        ; ---- unrolled, because the literal was five allocations a cell ----
        ; `for d in [[r-1,c],[r+1,c],[r,c-1],[r,c+1]]` built an outer array and
        ; four inner ones for every cell taken off the queue. On a 10x10 that is
        ; five thousand allocations per walk, and the walk is most of the cost of
        ; the search. Written out, it allocates nothing.
        if (r > 1) {
            if (r - 1 = tr && c = tc)
                return true
            key := cur - kb
            if (board[r - 1][c] = 0 && seenA[key] != seenS)
                seenA[key] := seenS, q.Push(key)
        }
        if (r < n) {
            if (r + 1 = tr && c = tc)
                return true
            key := cur + kb
            if (board[r + 1][c] = 0 && seenA[key] != seenS)
                seenA[key] := seenS, q.Push(key)
        }
        if (c > 1) {
            if (r = tr && c - 1 = tc)
                return true
            key := cur - 1
            if (board[r][c - 1] = 0 && seenA[key] != seenS)
                seenA[key] := seenS, q.Push(key)
        }
        if (c < n) {
            if (r = tr && c + 1 = tc)
                return true
            key := cur + 1
            if (board[r][c + 1] = 0 && seenA[key] != seenS)
                seenA[key] := seenS, q.Push(key)
        }
    }
    return false
}

PuzOptimizePaths(paths) {
    board := []
    loop PZ_GridN() {
        row := []
        loop PZ_GridN()
            row.Push(0)
        board.Push(row)
    }
    for k, p in paths {
        for cell in p
            board[cell[1]][cell[2]] := k
    }
    loop 2 {                               ; a second round uses space freed by the first
        improved := false
        for k, p in paths {
            ; Per pair, because this is one of the two stages that had neither a
            ; yield nor a ceiling: PuzBestReroute walks the grid twice for every
            ; pair, twice over, and on a board that produced many pairs that is
            ; the whole hub sitting still with nothing able to interrupt it.
            PuzUiBreath()
            if (PuzBoardOver("optimise") || PuzCancelPoll())
                return
            for cell in p
                board[cell[1]][cell[2]] := 0    ; lift this pair off the board
            np := PuzBestReroute(p[1][1], p[1][2], p[p.Length][1], p[p.Length][2], board, PuzPathCost(p))
            if (np != "") {
                paths[k] := np, p := np, improved := true
            }
            for cell in p
                board[cell[1]][cell[2]] := k    ; put the (old or new) route back
        }
        if !improved
            break
    }
}

PuzPathCost(p) {
    c := 0
    i := 2
    while (i < p.Length) {
        if PuzIsCorner(p, i)
            c++
        i++
    }
    return 2 * (p.Length - 1) + 3 * c
}

PuzBestReroute(sr, sc, tr, tc, board, budget) {
    best := "", bc := budget
    loop PZ_GridN() {
        for cells in [PuzCandCol(sr, sc, tr, tc, A_Index), PuzCandRow(sr, sc, tr, tc, A_Index)] {
            if (PuzTryRoute(cells, board) && PuzPathCost(cells) < bc) {
                bc := PuzPathCost(cells)
                best := cells
            }
        }
    }
    return best
}

PuzCandCol(sr, sc, tr, tc, x) {
    cells := [[sr, sc]]
    c := sc
    while (c != x) {
        c += (x > sc) ? 1 : -1
        cells.Push([sr, c])
    }
    r := sr
    while (r != tr) {
        r += (tr > sr) ? 1 : -1
        cells.Push([r, x])
    }
    while (c != tc) {
        c += (tc > x) ? 1 : -1
        cells.Push([tr, c])
    }
    return cells
}

PuzCandRow(sr, sc, tr, tc, y) {
    cells := [[sr, sc]]
    r := sr
    while (r != y) {
        r += (y > sr) ? 1 : -1
        cells.Push([r, sc])
    }
    c := sc
    while (c != tc) {
        c += (tc > sc) ? 1 : -1
        cells.Push([y, c])
    }
    while (r != tr) {
        r += (tr > y) ? 1 : -1
        cells.Push([r, tc])
    }
    return cells
}

; The same packing trap PuzReachable was fixed for, and this copy was missed. A
; base of 8 separates (r,c) only while c stays under 8: true at 6 and 7, wrong
; at 10 and 25, where (1,9) and (2,1) both come out 17 and a perfectly legal
; candidate reads as self-intersecting. Every reroute that crossed column 8 or
; beyond was being thrown away, so the optimiser silently stopped working on the
; two large boards. Base n+1, tied to the grid, like the other one.
PuzTryRoute(cells, board) {
    kb := PZ_GridN() + 1
    seen := Map()
    for cell in cells {
        if (board[cell[1]][cell[2]] != 0)
            return false
        key := cell[1] * kb + cell[2]
        if seen.Has(key)
            return false
        seen[key] := true
    }
    return true
}

PuzIsCorner(path, i) {
    return (path[i + 1][1] - path[i][1] != path[i][1] - path[i - 1][1])
        || (path[i + 1][2] - path[i][2] != path[i][2] - path[i - 1][2])
}


PuzCaptureRegion(x, y, w, h) {
    global PZ_caps
    ; ---- rounded, so the cache can actually hit ----
    ; Keyed on the exact region size, this cached one entry for the board scan
    ; and then a NEW one for every line: PuzAuditPath asks for the bounding box
    ; of a path, which is a different size on nearly every pair. So each line of
    ; each board added a DIB and a DC that nothing freed until the grid changed,
    ; and a held session is dozens of boards.
    ;
    ; Rounding up to a 64 px grid turns thousands of unique sizes into a handful.
    ; Reading is unaffected - the ORIGIN does not move, callers offset by x - x0
    ; as before, and cap.w carries the stride - the DIB is simply larger than the
    ; area anyone looks at. The count is capped as a backstop.
    w := ((w + 63) // 64) * 64
    h := ((h + 63) // 64) * 64
    key := w "_" h
    if (!PZ_caps.Has(key) && PZ_caps.Count >= PZ_CapsMax)
        PuzFreeCaps()
    if !PZ_caps.Has(key) {
        mdc := DllCall("CreateCompatibleDC", "ptr", 0, "ptr")
        bi := Buffer(40, 0)
        NumPut("uint", 40, bi, 0)
        NumPut("int", w, bi, 4)
        NumPut("int", -h, bi, 8)     ; top-down
        NumPut("ushort", 1, bi, 12)
        NumPut("ushort", 32, bi, 14)
        hbm := DllCall("CreateDIBSection", "ptr", mdc, "ptr", bi, "uint", 0, "ptr*", &pBits := 0, "ptr", 0, "uint", 0, "ptr")
        DllCall("SelectObject", "ptr", mdc, "ptr", hbm, "ptr")
        PZ_caps[key] := {mdc: mdc, hbm: hbm, pBits: pBits}
    }
    e := PZ_caps[key]
    hdc := DllCall("GetDC", "ptr", 0, "ptr")
    DllCall("BitBlt", "ptr", e.mdc, "int", 0, "int", 0, "int", w, "int", h
        , "ptr", hdc, "int", x, "int", y, "uint", 0x00CC0020)  ; SRCCOPY
    DllCall("ReleaseDC", "ptr", 0, "ptr", hdc)
    return {w: w, h: h, ptr: e.pBits}
}

PuzFreeCaps() {
    global PZ_caps
    for , e in PZ_caps {
        DllCall("DeleteDC", "ptr", e.mdc)
        DllCall("DeleteObject", "ptr", e.hbm)
    }
    PZ_caps := Map()
}

PuzReadPx(cap, x, y) => NumGet(cap.ptr, 4 * (y * cap.w + x), "uint") & 0xFFFFFF

PuzSendMouseInput(flags, dx := 0, dy := 0) {
    static size := A_PtrSize = 8 ? 40 : 28
    static off := A_PtrSize = 8 ? 8 : 4
    ; dwExtraInfo is NOT off + 20: the x64 struct pads after `type` AND again
    ; before the pointer-sized field, so it is 32 there and 24 on x86.
    static exo := A_PtrSize = 8 ? 32 : 24
    static buf := Buffer(size, 0)        ; type/mouseData/time stay zero; only these vary:
    NumPut("int", dx, buf, off)
    NumPut("int", dy, buf, off + 4)
    NumPut("uint", flags, buf, off + 12) ; dwFlags
    NumPut("uptr", PZ_SelfMark, buf, exo)  ; ours - see PZ_SelfMark
    DllCall("SendInput", "uint", 1, "ptr", buf, "int", size)
}

; MOVE | ABSOLUTE | VIRTUALDESK - works across multiple monitors.
;
; The virtual-screen metrics are read EVERY call and cached only until the
; display layout changes. They used to be `static`, evaluated once on the first
; call and never again: change resolution while the suite is running and every
; injected coordinate stayed normalised against the OLD screen, so each click
; landed scaled by the ratio between the two. That is exactly the "it behaves as
; if it is still on 1920x1080" symptom - the grid was right, the mapping was not.
; PuzScreenChanged() is wired to WM_DISPLAYCHANGE so the refresh is free.
PuzScreenSync() {
    global PZ_vx, PZ_vy, PZ_vw, PZ_vh
    PZ_vx := DllCall("GetSystemMetrics", "int", 76)
    PZ_vy := DllCall("GetSystemMetrics", "int", 77)
    PZ_vw := DllCall("GetSystemMetrics", "int", 78)
    PZ_vh := DllCall("GetSystemMetrics", "int", 79)
}
; Rebuilds what really is sized to the screen. It does NOT declare the grid
; globals, because it no longer assigns them - there is nothing here to declare.
; ---- the one that cannot be missed ----
; Called at the top of anything that is about to READ the grid, and it does
; nothing at all unless the screen has actually moved since the grid was last
; resolved. Everything else in this file that reacts to a resolution change is
; an optimisation on top of this: WM_DISPLAYCHANGE is faster, the 1 Hz watcher
; catches what the message misses, and this catches what BOTH miss, at the only
; moment where being wrong has a consequence.
;
; It exists because the previous two rounds of this fix were both correct and
; both insufficient - each assumed some notification would land, and the failure
; mode of that assumption is silent and looks exactly like a stale cache.
PuzScreenGuard() {
    PuzScreenSync()
    if (PZ_gridFor = PZ_vw "x" PZ_vh)
        return 0
    PuzScreenChanged()
    return 1
}
PuzScreenChanged(*) {
    global PZ_gridFor
    PuzScreenSync()
    PZ_gridFor := PZ_vw "x" PZ_vh
    PuzFreeCaps()                  ; capture buffers are sized for the old screen
    PuzMarkersKill()               ; and the marker surface is sized for it too
    ; ---- NOTHING here touches the calibration ----
    ; This has held the 1080p default and, later, an ini reload. Both were a
    ; display event deciding what the grid is, and WM_DISPLAYCHANGE fires for
    ; things nobody thinks of as a resolution change: a fullscreen client
    ; switching modes sends one, and so does alt-tabbing back out of it. Roblox
    ; going fullscreen below the desktop resolution was enough to have the grid
    ; replaced, and by the time you tabbed back the replacement fitted, so
    ; nothing put it back. That reads exactly as the grid moving itself.
    ;
    ; A SAVED grid does not answer to resolution: PZ_Grid holds the pixels the
    ; user clicked and nothing here touches them. The DEFAULT does, and must -
    ; it is derived from the viewport centre and scaled to it, which is the
    ; whole point of it being universal. Both go through the same cache in
    ; PuzPX/PuzPY, so the generation is bumped either way: for a saved grid the
    ; rebuild produces identical numbers and costs twelve rounds, and for the
    ; default it is the only thing that stops the old screen's numbers being
    ; served after the screen has gone.
    global PZ_gridGen
    PZ_gridGen += 1
    ; ---- and the saved grid is per-resolution now ----
    ; Carrying the old screen's calibration across a resolution change is the
    ; one thing worse than falling back to the default: it is a grid that was
    ; right somewhere else. Drop it and load this screen's, which is the default
    ; again if this screen has never been calibrated.
    PuzGridClear()
    PuzGridLoad()
    PuzMarkersApply()              ; rebuilt at the new coordinates, not dropped
}
PuzMoveTo(x, y) {
    if (PZ_vw < 1)
        PuzScreenSync()
    ; ceil mapping: Windows truncates converting back, so this lands on the exact pixel
    PuzSendMouseInput(0xC001, Ceil((x - PZ_vx)*65536/PZ_vw), Ceil((y - PZ_vy)*65536/PZ_vh))
}

PuzCursorPos(&x, &y) {
    static pt := Buffer(8, 0)
    DllCall("GetCursorPos", "ptr", pt)
    x := NumGet(pt, 0, "int"), y := NumGet(pt, 4, "int")
}

PuzQPCms() {
    static f := 0
    if (f = 0)
        DllCall("QueryPerformanceFrequency", "int64*", &f)
    DllCall("QueryPerformanceCounter", "int64*", &c := 0)
    return c * 1000.0 / f
}

; ---- alive to Windows, without letting anything run ----
; Windows marks a top-level window "not responding" and greys it out when the
; thread that owns it has not touched its message queue for five seconds. AHK's
; own Sleep touches it. DllCall("Sleep") does not - it is the raw OS call and
; goes nowhere near the queue.
;
; PuzWaitUntil takes that second branch whenever the remaining time is under
; 2 ms, and at the fast end of the slider that is essentially every wait in the
; module: PZ_FrameInterval is 1, so PuzGlideTo asks for 1 ms at a time, and a
; cell budget of 1.5 x 5 ms leaves nothing over for the dwell afterwards. So a
; fast solve runs from the first press to the last release without the script
; answering its queue once, and the whole suite greys out. That is the freeze.
;
; It arrives with SPEED rather than with size because of that 2 ms boundary: at
; the slow end a cell budget is 63 ms, the dwell at the end of every cell has
; tens of milliseconds left on it, and the branch above runs AHK's Sleep
; thousands of times a board. Size then decides how long the fast case has to
; last - 7x7 finishes inside the five seconds, 10x10 and 25x25 do not.
;
; PeekMessage with PM_NOREMOVE is the fix and it is the whole fix. It counts as
; touching the queue, so the hung-window timer resets, and it removes and
; dispatches NOTHING - which is the part that matters, because this runs inside
; PuzDrawPath's Critical section, where letting a render or a timer fire between
; the press and the release is exactly what must not happen. The drag is
; untouched; only Windows' opinion of the thread changes.
;
; On a clock, because the spin runs thousands of times a second and the timer it
; is resetting is five seconds long.
PuzAlive() {
    static msg := Buffer(48, 0), last := 0
    t := A_TickCount
    if (t - last < PZ_AliveMs)
        return
    last := t
    DllCall("PeekMessageW", "ptr", msg, "ptr", 0, "uint", 0, "uint", 0, "uint", 0)  ; PM_NOREMOVE
}

; ---- and one real yield, between lines ----
; PuzAlive stops the window being ghosted; it does not let the hub DRAW, because
; nothing is dispatched. Critical is off between lines - PuzDrawPath restores it
; in its finally - so a plain Sleep here is the one door the render timer can
; come through. The note on PZ_BetweenPaths is right that opening that door on
; every pair is expensive; opening it on a clock costs nothing on a board that
; finishes inside one interval, and keeps a 150-line board animating.
PuzUiBreath() {
    static last := 0
    t := A_TickCount
    if (t - last < PZ_BreathMs)
        return
    last := t
    Sleep 1                      ; AHK's Sleep, not the OS one: this is the pump
}

; ---- three branches, because the middle one was missing ----
; The old shape was "over 2 ms, sleep; otherwise spin". At the SLOW end of the
; slider nearly every wait is over 2 ms, so the core is free and the script is
; polite. At 100% nothing is: a cell budget is 1.5 x 5 ms and PuzGlideTo asks
; for 1 ms at a time, so every single wait in the module lands in the else and
; DllCall("Sleep", 0) is not a sleep - it yields only to threads already ready
; on this processor and otherwise returns immediately. So a full-speed board
; pegs a core from the first press to the last release.
;
; That is what makes 100% worse than 10% instead of better, and the damage is
; not to this script - it is to the CLIENT. Roblox is rendering the board being
; drawn on, competing for the same processor, and losing frames to a spin loop.
; Lines then come up short, PuzVerifyLine redraws them at PZ_SlowStep, and the
; redraws spin too. The faster it is asked to go the further behind it gets.
;
; The middle branch is the fix. timeBeginPeriod(1) is already held process-wide
; (see the top of the file), so the OS Sleep is good to about a millisecond -
; accurate enough for a 7.5 ms cell and, unlike Sleep(0), it actually releases
; the processor. Only the last fraction of a millisecond spins now, and
; SwitchToThread yields to anything runnable rather than burning through.
PuzWaitUntil(target) {
    loop {
        rem := target - PuzQPCms()
        if (rem <= 0.2)
            return
        if (rem > 2)
            Sleep 1                        ; AHK's: frees the core AND pumps
        else if (rem > 0.6) {
            PuzAlive()
            DllCall("Sleep", "uint", 1)    ; the OS one: frees the core, no pump
        } else {
            PuzAlive()
            DllCall("SwitchToThread")      ; sub-millisecond tail, yielding
        }
    }
}

PuzGlideTo(x0, y0, x1, y1, speed, ease := false) {
    dist := Sqrt((x1 - x0) ** 2 + (y1 - y0) ** 2)
    if (dist < 1) {
        PuzMoveTo(x1, y1)
        return
    }
    dur := dist / speed
    t0 := PuzQPCms()
    step := PZ_FrameInterval
    lx := -99999, ly := -99999
    loop {
        el := PuzQPCms() - t0
        if (el >= dur)
            break
        t := el / dur
        if ease
            t := t * t * (3 - 2 * t)
        nx := Round(x0 + (x1 - x0) * t), ny := Round(y0 + (y1 - y0) * t)
        if (nx != lx || ny != ly) {      ; only inject when the pixel actually changes
            PuzMoveTo(nx, ny)
            lx := nx, ly := ny
        }
        PuzWaitUntil(t0 + step)
        step += PZ_FrameInterval
    }
    PuzMoveTo(x1, y1)
}

; ---- the drag, walked CELL BY CELL ----
; The time budget has not changed; WHERE it is spent has. It used to be spent at
; the corners: the cursor ran ahead at DragBoost and handed the time back when it
; arrived. That gives the LINE its frames, but it never gives any single
; intermediate CELL a frame of cursor presence - and the game extends its tip
; from the last place it SAW the cursor, not from where the cursor ended up. A
; straight pair two cells apart is crossed in a third of a frame, so the cell
; between them could go completely unobserved; the tip then stops at the last
; cell that was seen, and holding at the end cannot recover it because the cursor
; is no longer next to the tip. Adding margin never fixed that because the
; problem was never a shortage of time - it was time spent in the wrong place.
;
; So the walk now visits every cell centre in turn and holds each one until its
; own frame has elapsed. A corner is held longer, because a turn has to be seen
; in the corner cell itself. The hop between centres still runs at DragBoost, so
; the motion is a quick slide and a beat rather than a crawl.
; ---- uninterruptible for the length of ONE line ----
; Every budget below is a DEADLINE, and this thread sets Critical nowhere: it
; yields at the Sleep after the press and, far more often, inside the Sleep 1 /
; Sleep 0 spin in PuzWaitUntil, which is where PuzGlideTo spends nearly all of
; its time. Any armed timer can run in those gaps. In the bench file exactly one
; can - PuzRender - and the numbers were tuned with that as the only competition.
; In the hub there is also HubRender, which takes Critical for a whole panel
; frame and is gated on hubHidden rather than on focus, so it keeps drawing
; behind Roblox for the entire solve; the block overlay's Render does the same
; whenever AUTOBLOCK is armed; and FFMIHGuard, UsageTick, FFMPoll and the SPF
; timers are all armed as well.
;
; A cell budget at the top of the slider is 7.5 ms and a corner 10 ms. A hub
; frame fits inside either one comfortably, and the damage is worse than the
; time it costs: the walk stalls, PuzGlideTo resumes and injects the positions
; it owes in a burst, Windows coalesces those to one WM_MOUSEMOVE per pump, and
; the client sees a cursor that jumped several cells at once. Under the
; observation model those cells are gone for good. That is the short line the
; whole per-cell rework exists to prevent, arriving from a source that does not
; appear anywhere in the numbers.
;
; Critical here rather than stopping the timers by name: there is no list to
; keep in step as modules are added, and it covers hotkeys and OnMessage too.
; The window is ONE line, not the session - a held key can run for hundreds of
; boards, and going uninterruptible for all of that would take the tray, the
; hotkeys and every escape hatch with it. Between lines Critical drops and
; everything catches up. Nothing in here can hang: PuzGlideTo breaks on
; wall-clock time and PuzWaitUntil has a hard target.
;
; Note this leaves the hub TIGHTER than the bench file, where PuzRender can
; still interrupt a walk. It can only remove skipped cells, never add them.
PuzDrawPath(path) {
    prevC := A_IsCritical
    Critical "On"
    down := 0
    try {
        n  := path.Length
        sx := PuzPX(path[1][2]), sy := PuzPY(path[1][1])
        PuzApproachDot(sx, sy)                    ; travel + settle: hover is on THIS dot
        PuzSendMouseInput(0x0002)                 ; LEFTDOWN alone - never batched with a
        down := 1
        Sleep PuzPressHold()                      ; move, so no stale hover can serve it
        cx := sx, cy := sy
        loop n - 1 {
            i  := A_Index + 1
            tx := PuzPX(path[i][2]), ty := PuzPY(path[i][1])
            PuzCellGlide(cx, cy, tx, ty, PuzCellBudget(path, i, n))
            cx := tx, cy := ty
            ; Mid-line. This BREAKS rather than returning: the button is still
            ; down, and the only exit that leaves the game with a finished
            ; gesture instead of a held button is the release below. A part-drawn
            ; line is the correct result of a cancel.
            if PuzCancelPoll()
                break
        }
        if !PZ_cancel
            PuzTailRecover(path, n)
        ; the last extension still has to be observed before the button lifts,
        ; and that is the one thing stationary time can buy
        PuzWaitUntil(PuzQPCms() + PuzEndHold())
        PuzSendMouseInput(0x0004)                 ; LEFTUP alone, already parked on the dot
        down := 0
    } finally {
        ; restored rather than turned off, and in a finally: a throw inside the
        ; walk that left Critical on would take the rest of the session with it
        Critical prevC
        ; and the same argument for the BUTTON. PuzSolve catches what this throws
        ; and carries on to the next board by design, so a throw between the press
        ; and the release used to hand the rest of the session - and the desktop
        ; afterwards - a left button that was physically still down.
        if down
            try PuzSendMouseInput(0x0004)
    }
}

; Cross one cell in `bud` ms: travel for (1 - PZ_CellDwell) of it, hold the centre
; for the rest. The trailing PuzWaitUntil is what makes the budget a floor as well
; as a target - the glide lands on it, and its own deadline is the only one it
; owes, so an overrun here does not come out of the next cell.
PuzCellGlide(x0, y0, x1, y1, bud) {
    t0   := PuzQPCms()
    trav := bud * (1.0 - Clamp(PZ_CellDwell, 0.0, 0.9))
    dist := Sqrt((x1 - x0)**2 + (y1 - y0)**2)
    PuzGlideTo(x0, y0, x1, y1, (trav > 0.5) ? dist/trav : 9999)
    PuzWaitUntil(t0 + bud)
}

; Budget for crossing path[i] and being seen there. `n` is the path length, so
; the corner test can be skipped on the last cell - it has no successor.
; ---- the budget is in frames; the DISTANCE is not ----
; PZ_CellFrames was tuned at 1920x1080, where a cell is 86.2 px and the walk
; runs at 9.6 px/ms. The budget is a fixed number of frames, so at 2880x1620 the
; same budget covers a 132.8 px cell in the same time: 14.8 px/ms, 54% faster
; than anything was ever validated at, with the cursor jumping ~15 px between
; injected moves instead of ~10. The game samples the cursor per frame, and a
; drag that skips most of a cell between samples is a drag it can miss.
;
; So the budget scales with the pitch, which holds the PIXEL speed at what was
; tuned. Clamped at 1.0 on the way down: below 1920 this multiplies by exactly
; one and nothing changes, because the failure mode of a too-SLOW walk is a
; slower solve while the failure mode of a too-fast one is a wrong board.
; The pitch keeps the pixel speed at what 1080p was tuned for. PZ_retryMul is
; 1.0 everywhere except inside a verify redraw, so on the ordinary path this is
; the pitch term alone.
PuzPitchScale() => Max(1.0, PZ_SX()/86.2) * PZ_retryMul * PZ_paceMul
PuzCellBudget(path, i, n) => ((i < n && PuzIsCorner(path, i)) ? PZ_CornerFrames : PZ_CellFrames)
                           * PZ_FrameMs * PuzPitchScale()

; ---- the tail walk, kept but disarmed ----
; What originally sat here was a sleep: hold the end circle for LagFrames +
; SlackFrames and hope the line caught up. It never did, and zeroing it changed
; nothing, which is the experiment that identified the model. A tip two cells
; short is not adjacent to a cursor parked on the end dot, so no amount of
; waiting there can produce the adjacency the game is waiting for.
;
; This hands it one instead: step BACK down the path to within a cell of where a
; stalled tip would be, then travel forward to the end again. In the failure case
; the retreat re-establishes adjacency and the return drives the tip home. In the
; ordinary case - line already complete - the retreat retracts the last cells and
; the return redraws them.
;
; That last sentence is why PZ_TailBackCells now defaults to 0. "Ordinary case"
; is nearly every line: the repair fires unconditionally, visibly reversing the
; cursor and re-drawing finished cells on every pair, to catch the few that need
; it. Per-cell budgets prevent most of what it was built to repair, so it is off
; and one constant away if failures return.
;
; It never steps onto path[1]. Retracting to the start dot is not the same
; gesture as retracting along the line, and a client that reads it as cancelling
; the drag would turn a complete line into no line at all. Paths of two cells
; therefore get no tail walk, which is free: an adjacent pair has no intermediate
; cell to miss and none of them has ever failed.
PuzTailRecover(path, n) {
    k := Min(PZ_TailBackCells, n - 2)
    if (k < 1)
        return
    loop k                                        ; back down the path
        PuzTailStep(path, n - A_Index, n)
    loop k                                        ; and forward to the end again
        PuzTailStep(path, n - k + A_Index, n)
}
PuzTailStep(path, i, n) {
    PuzCursorPos(&cx, &cy)
    PuzCellGlide(cx, cy, PuzPX(path[i][2]), PuzPY(path[i][1]), PuzCellBudget(path, i, n))
}

PuzApproachDot(x, y) {
    PuzCursorPos(&cx, &cy)
    if (Abs(cx - x) + Abs(cy - y) > 2)
        PuzGlideTo(cx, cy, x, y, PZ_ApproachSpeed, true)
    else
        PuzMoveTo(x, y)
    PuzDwellIn(x, y, PuzStartSettle())
}

PuzDwellIn(x, y, ms) {
    t0 := PuzQPCms()
    PuzMoveTo(x + PZ_JigglePx, y)
    Sleep PZ_JiggleDwell
    PuzMoveTo(x, y)
    rem := ms - Round(PuzQPCms() - t0)
    if (rem > 0)
        Sleep rem
}

PuzParkCursor() {
    ; NOTE: locals must not be named px/py — those collide with the PuzPX()/PuzPY() functions
    tx := Round(PuzPX(1) - PZ_SX()), ty := Round(PuzPY(1))
    PuzCursorPos(&cx, &cy)
    if (Abs(cx - tx) + Abs(cy - ty) > 2)
        PuzGlideTo(cx, cy, tx, ty, PZ_ApproachSpeed, true)
    else
        PuzMoveTo(tx, ty)
}

PuzStartSettle() => Round(PZ_FrameMs * PZ_StartFrames)

; The grab lag lives here. It is the interval between the button going down and
; the client accepting the drag, so it belongs BEFORE the first cell is crossed -
; paying it after the last one, as the old tail did, settled a debt that had
; already cost the line its opening cells.
PuzPressHold()   => Round(PZ_FrameMs * (PZ_PressFrames + PZ_LagFrames))

PuzEndHold()     => (PZ_EndFrames + PZ_SlackFrames) * PZ_FrameMs

; PuzCornerDwell() lived here: a leftover from before the per-cell budget, when
; a corner was a stationary hold rather than a longer crossing. Nothing has
; called it since PuzCellBudget arrived, and sitting among the live helpers it
; read like one of them.

; ---- resolved ONCE, then looked up ----
; These are the most-called functions in the module: once per cell per scan, once
; per cell of every walk, once per path cell of every audit, and every poll
; while waiting for the next deal. Each call was two constant-function calls, a
; multiply and a Round - and the answer is the same every single time, because
; the grid is a constant now. So the columns are computed on first use and
; indexed after that.
;
; The table is a STATIC, deliberately, not a global. Nothing outside these two
; functions can reach it, so caching the grid this way cannot become another
; way for the grid to be changed - which is the whole point of PZ_X0 and its
; siblings being functions in the first place.
;
; Every caller passes 1..PZ_GridN(): a literal 1, PZ_GridN() itself, a loop
; index, or a path cell. Checked across all 13 call sites.
PuzPX(c) {
    static t := "", g := -1, cw := -1, ch := -1
    ; Rebuilt when the grid CHANGES, not merely when it is first needed. The
    ; cache was safe while the grid was a constant; with SET GRID back it would
    ; otherwise keep answering with the previous calibration.
    ; ---- the SCREEN is part of the key, not just the grid ----
    ; The default is derived from the viewport, so it changes when the viewport
    ; does - and PZ_gridGen only moves when something deliberately changes the
    ; grid. Keyed on the generation alone this served the old resolution's
    ; positions after a mode change: PuzSolve re-read PZ_vw/PZ_vh, PuzDefRef
    ; returned the right numbers, and this handed back the table it built before
    ; any of that happened. That is exactly the "works until I change
    ; resolution, then only a restart fixes it" symptom.
    ;
    ; Two integer compares per call, and it cannot go stale even if every
    ; display notification in the file is missed.
    if (g != PZ_gridGen || cw != PZ_vw || ch != PZ_vh) {
        t := [], g := PZ_gridGen, cw := PZ_vw, ch := PZ_vh
        loop PZ_GridN()
            t.Push(Round(PZ_X0() + (A_Index - 1) * PZ_SX()))
    }
    return t[c]
}

PuzPY(r) {
    static t := "", g := -1, cw := -1, ch := -1
    ; Rebuilt when the grid CHANGES, not merely when it is first needed. The
    ; cache was safe while the grid was a constant; with SET GRID back it would
    ; otherwise keep answering with the previous calibration.
    if (g != PZ_gridGen || cw != PZ_vw || ch != PZ_vh) {
        t := [], g := PZ_gridGen, cw := PZ_vw, ch := PZ_vh
        loop PZ_GridN()
            t.Push(Round(PZ_Y0() + (A_Index - 1) * PZ_SY()))
    }
    ; The table is the CALIBRATION and is cached on the grid generation. The
    ; offset is a fact about where the panel is sitting right now, so it is added
    ; at read rather than baked in - otherwise the cache would have to be thrown
    ; away every time the banner appeared, and the calibration and the board's
    ; position would stop being separable.
    return t[r] + PZ_boardDy
}

Cleanup(*) {
    global selfies, selTall, shadowCache, G, brCache, brOwn, penCache, penOwn, rrScratchP
    static done := 0
    if done
        return
    done := 1
    ; Written FIRST. If one of the teardown steps below throws, the log still
    ; shows this shutdown was orderly - which is the whole point of the marker.
    try YuriSessionEnd()
    ; both preview bitmaps - the Studio slot was added later and would have
    ; leaked its handle on every exit
    if (IsObject(RSET) && RSET.HasOwnProp("logoBmp") && RSET.logoBmp) {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", RSET.logoBmp)
        RSET.logoBmp := 0
    }
    if (IsObject(RSET) && RSET.HasOwnProp("logoSBmp") && RSET.logoSBmp) {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", RSET.logoSBmp)
        RSET.logoSBmp := 0
    }
    if (IsObject(RSET) && RSET.HasOwnProp("logoDef")) {
        for i, hb in RSET.logoDef {
            if hb
                try DllCall("gdiplus\GdipDisposeImage", "ptr", hb)
        }
        RSET.logoDef := [0, 0]
    }
    try ScrStopAll()
    try UsageFlush()
    if IsObject(CSR) {
        for cs in CSR.slot {
            if cs.bmp {
                try DllCall("gdiplus\GdipDisposeImage", "ptr", cs.bmp)
                cs.bmp := 0
            }
            if cs.dbmp {
                try DllCall("gdiplus\GdipDisposeImage", "ptr", cs.dbmp)
                cs.dbmp := 0
            }
        }
    }
    ; every renderer repoints the shared G at its own surface. If we tear down
    ; while it still points at the hub target, the handle gets released twice
    ; and the second call is an access violation - so rebase it first and track
    ; what has already been freed.
    try G := G0
    gone := Map()
    if IsObject(HL) {
        try {
            if (HL.g2 && !gone.Has(HL.g2)) {
                gone[HL.g2] := 1
                DllCall("gdiplus\GdipDeleteGraphics", "ptr", HL.g2)
            }
        }
        try DllCall("gdi32\DeleteDC", "ptr", HL.hdc)
        try DllCall("gdi32\DeleteObject", "ptr", HL.hbm)
    }
    if fP {
        try DllCall("gdiplus\GdipDeleteFont", "ptr", fP)
        try DllCall("gdiplus\GdipDeleteFont", "ptr", fPs)
        try DllCall("gdiplus\GdipDeleteFontFamily", "ptr", famP)
    }
    try DllCall("winmm\timeEndPeriod", "uint", 1)
    for bmp in selfies
        try DllCall("gdiplus\GdipDisposeImage", "ptr", bmp)
    for bmp in selTall
        try DllCall("gdiplus\GdipDisposeImage", "ptr", bmp)
    selfies := [], selTall := []
    for , e in shadowCache
        try DllCall("gdiplus\GdipDisposeImage", "ptr", e.bmp)
    shadowCache := Map()
    try PuzOvClose()
    try RNKill()
    try PuzCalCardKill()
    try PuzDbgKill()
    try PuzMarkersKill()
    try PuzFreeCaps()
    try SPFDcClose()
    ; ---- QUIET MODE must not outlive the process that armed it ----
    ; Everything else this suite does to another process is either read-only or
    ; dies with the handle. A priority class does not: demote a browser and
    ; exit, and it stays demoted until that browser is restarted, with nothing
    ; anywhere connecting the two. There is no diagnosing that from the outside,
    ; so the restore is unconditional and runs before any of the graphics
    ; teardown that could throw.
    try SPFFpsQuietRestore()
    try SPFFpsHookSet(false)
    try SPFFpsSelfRestore()
    ; ---- and the machine-wide set, which outlives everything ----
    ; A power scheme and a registry value survive this process, a crash and a
    ; reboot. Put back here on the ordinary path; the journal on disk is what
    ; covers the path where this function never runs at all.
    try SPFFpsSysRevert()
    try SPFFpsGpuRevert()
    ; The client's own settings are left as they are ON PURPOSE. They live in
    ; the client process and die with it, and a user who closes the hub mid-
    ; session did not ask for the game they are still playing to drop back to
    ; normal priority. The GPU preference is likewise left: it is a persisted
    ; choice with its own chip, and clearing it at exit would make that chip
    ; silently forget itself every session.
    for , b in brCache
        try DllCall("gdiplus\GdipDeleteBrush", "ptr", b)
    for , pn in penCache
        try DllCall("gdiplus\GdipDeletePen", "ptr", pn)
    brCache := Map(), brOwn := Map(), penCache := Map(), penOwn := Map()
    if rrScratchP
        try DllCall("gdiplus\GdipDeletePath", "ptr", rrScratchP)
    rrScratchP := 0
    try DllCall("gdiplus\GdipDisposeImageAttributes", "ptr", IA2)
    try DllCall("gdiplus\GdipDisposeImageAttributes", "ptr", IA)
    try {
        if (G && !gone.Has(G)) {
            gone[G] := 1
            DllCall("gdiplus\GdipDeleteGraphics", "ptr", G)
        }
    }
    try DllCall("gdi32\DeleteDC", "ptr", hdc)
    try DllCall("gdi32\DeleteObject", "ptr", hbm)
    try DllCall("gdiplus\GdiplusShutdown", "ptr", gdipToken)
}
