HubFinish() {
    global hubLive, G
    hubLive := 0
    HubTim(0)
    G := G0
    ; the update card has already swapped the files; the new build starts as
    ; this one leaves, so the hub's close is the last thing this process shows
    if (updRestartCmd != "")
        try Run(updRestartCmd)
    ExitApp
}
HubRender() {
    Critical "On"
    global G, hubTabAt, selCur, selNext, selFadeAt, hubCur
    static SCRSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&"
    static zfH := 0
    if (!hubLive || hubHidden)
        return
    G := HL.g2
    ; ---- LOW PERFORMANCE MODE: rasteriser quality ----
    ; The largest single lever left. Antialiasing costs on every path fill and
    ; stroke in the frame, and bicubic costs on every blit. Re-asserted each
    ; frame rather than once at creation so the switch takes effect the moment
    ; it is flipped.
    static lastQ := -1
    if (hubLowPerf != lastQ) {
        lastQ := hubLowPerf
        DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", G, "int", hubLowPerf ? 3 : 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G, "int", hubLowPerf ? 1 : 4)
        DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G, "int", hubLowPerf ? 5 : 7)
        DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", G, "int", hubLowPerf ? 1 : 2)
        MeasureW("", 0)                          ; text metrics change with the hint
    }
    now := A_TickCount
    BrushCacheTick(), PenCacheTick()
    ThemeTick()
    ; LOW PERFORMANCE MODE: the hub is simply THERE. The open animation is
    ; time-based rather than eased, so EK never touched it and it kept playing
    ; after every other transition had been stripped out.
    it := hubLowPerf ? 1.0 : Min((now - HL.intro)/INTRO_MS, 1.0)
    ei := 1 - (1 - it)**3
    winA := Round(255*Min(it*1.7, 1.0))
    yO := Round((1 - ei)*30*HL.k)
    scl := 1.0
    fin := 0
    if HL.closeAt {
        ft := Min((now - HL.closeAt)/380.0, 1.0)
        winA := Round(winA*(1 - ft)), scl := 1 - 0.06*ft
        yO += Round(10*ft*HL.k)
        if ft >= 1
            fin := 1
    }
    scl *= 1 + 0.02*HL.dragT

    SelTick(now)
    if HL.minStart {
        t := Min((now - HL.minStart)/HL.minDur, 1.0)
        ; logic gates cross 0.5 at the midpoint instead of 20% in
        HL.minT := Lerp(HL.minFrom, HL.minTo, t*t*(3 - 2*t))
        ; visual curve anticipates before collapsing and overshoots on the way back
        ev := (HL.minTo = 1.0) ? MinIn(t) : EBackOut(t, 1.15)
        HL.minV := Lerp(HL.minFrom, HL.minTo, ev)
        if t >= 1
            HL.minStart := 0, HL.minT := HL.minTo, HL.minV := HL.minTo
    } else
        HL.minV := HL.minT
    ; hold the panel readable through most of the shrink, then fade late
    cf := Clamp(1 - Max(0.0, HL.minV - 0.40)/0.50, 0.0, 1.0)
    dtgt := (HL.drag = 2 || (HL.drag = 1 && now - HL.dragAt > 130)) ? 1.0 : 0.0
    HL.dragT := HL.dragT + (dtgt - HL.dragT)*EK(0.2)
    if HL.dragT < 0.004 && HL.drag != 2
        HL.dragT := 0.0
    ; Ahead of the velocity sample, so prevBX tracks the corrected position and a
    ; correction cannot be mistaken for a throw and leaned into by the tilt.
    posFix := HubClampTick()
    velX := HL.bx - HL.prevBX
    HL.prevBX := HL.bx
    HL.tilt := HL.tilt + ((HL.drag = 2 ? Clamp(velX*0.22, -3.0, 3.0) : 0.0) - HL.tilt)*EK(0.18)
    if !HL.drag && Abs(HL.tilt) < 0.03
        HL.tilt := 0.0
    ; Physical mouse-down edge landing outside every hub zone. Anything that
    ; hit-tests HTTRANSPARENT, and the whole world outside the window, never
    ; delivers WM_LBUTTONDOWN here, so HubClick's blur guard cannot see these
    ; clicks - poll for them instead. Skipped while a drag or a text selection
    ; owns the mouse, since that press started inside.
    lb2 := GetKeyState("LButton", "P"), rb2 := GetKeyState("RButton", "P")
    dnEdge := ((lb2 && !HL.lbP) || (rb2 && !HL.rbP)) && !HL.drag && !SH.msel && !FFM.msel
    if (dnEdge && HubZoneCursor() = 0) {
        if SH.focus
            ScrBlur()
        FFMBlur()
    }
    HL.lbP := lb2, HL.rbP := rb2
    if now - HL.runChkAt > 900 {
        HL.runChkAt := now
        rn := 0
        loop SHList.Length {
            r1 := ScrRunning(A_Index)
            HL.runFlg[A_Index] := r1
            rn += r1
        }
        HL.runN := rn
    }
    hz := (HL.drag || HL.closeAt) ? 0 : HubZoneCursor()
    hmax := 0.0
    for z in HL.hz {
        v := HL.h.Get(z, 0.0)
        ; already fully decayed and not the hovered zone - the arithmetic below
        ; is a no-op for it, so skip the Map write. ~100 zones every frame.
        if (v = 0.0 && hz != z)
            continue
        ; LOW PERFORMANCE MODE snaps instead of easing. The row still lights
        ; up, so the interface is not dead under the cursor - it just does not
        ; spend a 200 ms fade holding the whole frame at the busy rate, and
        ; hmax settles to 0 or 1 immediately instead of trickling.
        if hubLowPerf
            v := (hz = z) ? 1.0 : 0.0
        else {
            v += (((hz = z) ? 1.0 : 0.0) - v)*EK(0.2)
            v := (v < 0.004 && hz != z) ? 0.0 : v
        }
        HL.h[z] := v
        hmax := Max(hmax, v)
    }
    HL.profT := HL.profT + ((HL.profOpen ? 1.0 : 0.0) - HL.profT)*EK(0.18)
    if !HL.profOpen && HL.profT < 0.004
        HL.profT := 0.0
    HL.bioT := HL.bioT + ((HL.bioOpen ? 1.0 : 0.0) - HL.bioT)*EK(0.2)
    if !HL.bioOpen && HL.bioT < 0.004
        HL.bioT := 0.0
    HL.tabU := HL.tabU + (SH.cur - HL.tabU)*EK(0.26)
    HL.lgSc := HL.lgSc + (HL.lgScT - HL.lgSc)*EK(0.3)
    if Abs(HL.lgSc - HL.lgScT) < 0.3
        HL.lgSc := HL.lgScT
    if Abs(HL.tabU - SH.cur) < 0.01
        HL.tabU := SH.cur + 0.0
    HL.libT := HL.libT + (((SH.libOpen && hubTab = 3) ? 1.0 : 0.0) - HL.libT)*EK(0.2)
    if !SH.libOpen && HL.libT < 0.004
        HL.libT := 0.0
    HL.expT := HL.expT + (((SH.expOpen && hubTab = 3) ? 1.0 : 0.0) - HL.expT)*EK(0.22)
    if !SH.expOpen && HL.expT < 0.004
