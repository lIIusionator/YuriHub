ScrGuessVer(body) {
    r := ScrReqVer(body)
    if (r != "")
        return r
    v1 := 0, v2 := 0
    for pat in ["^\s*#NoEnv\b", "^\s*SetBatchLines\b", "^\s*SetFormat\b", "^\s*AutoTrim\b"
              , "^\s*StringCaseSense\b", "^\s*#MaxThreadsPerHotkey\b", "^\s*SetEnv\b"
              , "^\s*(?:Sleep|Send|SendInput|MsgBox|Gui|Menu|StringReplace|StringSplit|StringTrimLeft"
              . "|FileRead|FileAppend|FileDelete|WinActivate|WinWait|SetTimer|Run|RunWait|Random"
              . "|SoundBeep|ControlSend|MouseMove|MouseClick|Process|Sort|Transform|EnvSet|EnvGet"
              . "|SetTitleMatchMode|SetKeyDelay|SetMouseDelay|DetectHiddenWindows|CoordMode|Loop)\s*,"
              , "^\s*If(?:WinActive|WinExist|Equal|NotEqual|InString|Greater|Less)\b"]
        if RegExMatch(body, "im)" pat)
            v1 += 1
    for pat in ["^\s*#Requires\b", "=>", "\bMap\(", "\bArray\(", "\bInputHook\(", "\bA_Args\b"
              , "\bObjBindMethod\(", ":=\s*\{", "\.Push\(", "\bStrSplit\("]
        if RegExMatch(body, "im)" pat)
            v2 += 1
    if (v1 > 0 && v1 >= v2)
        return "1"
    if (v2 > 0 && v2 > v1)
        return "2"
    return ""
}
ScrErrPretty(raw, v) {
