                } else if k = 2 {
                    b := SBrush(icL)
                    FillRR(icx2 - 11, icy3 - 8, 22, 16, 5, b), DelB(b)
                    b := SBrush(FA(0xFF12141F, f))
                    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &pY := 0)
                    DllCall("gdiplus\GdipAddPathLine", "ptr", pY, "float", icx2 - 3, "float", icy3 - 4.5, "float", icx2 + 4.5, "float", icy3)
                    DllCall("gdiplus\GdipAddPathLine", "ptr", pY, "float", icx2 + 4.5, "float", icy3, "float", icx2 - 3, "float", icy3 + 4.5)
                    DllCall("gdiplus\GdipClosePathFigure", "ptr", pY)
                    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", pY)
                    DllCall("gdiplus\GdipDeletePath", "ptr", pY), DelB(b)
                } else {
                    b := SBrush(icL)
                    FillRR(icx2 - 11, icy3 - 7, 22, 14, 7, b)
                    FillEll(icx2 - 11, icy3 + 1, 7, 8, b)
                    FillEll(icx2 + 4, icy3 + 1, 7, 8, b), DelB(b)
                    b := SBrush(FA(0xFF12141F, f))
                    FillEll(icx2 - 6, icy3 - 4, 4, 5, b)
                    FillEll(icx2 + 2, icy3 - 4, 4, 5, b), DelB(b)
                }
                Txt(names[k], lx + 56, lky - lift + 14, 96, 16, fBadge, FA(Alpha(AccHi(hubCur, 0.8), 235), f), fmtL)
                if cwS {
                    Txt(lnkOld[k].h, lx + 56, lky - lift + 31 - 9*cwT, 96, 14, fHint
                      , FA(Alpha(0xFFC7CBE0, Round(138*(1 - cwT))), f), fmtL)
                    Txt(lnkNow[k].h, lx + 56, lky - lift + 31 + 9*(1 - cwT), 96, 14, fHint
                      , FA(Alpha(0xFFC7CBE0, Round(138*cwT)), f), fmtL)
                } else
                    Txt(lnkNow[k].h, lx + 56, lky - lift + 31, 96, 14, fHint, FA(0x8AC7CBE0, f), fmtL)
                cpd := (k = 3 && HL.cpAt && now - HL.cpAt < 1600)
                Txt(cpd ? "copied" : acts[k], lx + 56, lky - lift + 50, 96, 13, HL.fXs
                    , FA(Alpha(cpd ? C_ON : hubCur, cpd ? 235 : 120 + 120*hvL), f), fmtL)
                arw := lx + 140 + 3*hvL
                pn := Pen(FA(Alpha(AccHi(hubCur, 0.4), 90 + 150*hvL), f), 1.5)
                Line(arw - 4, lky - lift + 50, arw + 1, lky - lift + 55, pn)
                Line(arw + 1, lky - lift + 55, arw - 4, lky - lift + 60, pn), DelP(pn)
                loop 3 {
                    j3 := A_Index
                    b := SBrush(FA(Alpha(hubCur, 30 + 60*Abs(Sin(DecT(now)*0.0026 + j3 + k))), f))
                    FillEll(lx + 128 + (j3 - 1)*7, lky - lift + 18, 3.4, 3.4, b), DelB(b)
                }
                if cpd {
                    e := Ease3((now - HL.cpAt)/900.0)
                    if e < 1 {
                        pn := Pen(FA(Alpha(C_ON, 170*(1 - e)), f), 2*(1 - e) + 0.4)
                        ex2 := e*12
                        StrokeRR(lx - ex2, lky - lift - ex2*0.6, 162 + ex2*2, HL.lkh + ex2*1.2, 12 + ex2*0.3, pn), DelP(pn)
                    }
