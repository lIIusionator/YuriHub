    ; ever arrives from a hook that is no longer the installed one, it belongs
    ; to a field already left and acting on it would blur whatever took the
    ; caret since. Identity by address, so there is no question of how two
    ; objects compare.
    if (SH.ih && ObjPtr(ih) != ObjPtr(SH.ih))
        return
