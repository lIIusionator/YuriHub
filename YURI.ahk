                BlitTallRR(SelAtTall(HL.lgIdx), gx0, gy0, gw2, gh2, 12, f)
                if HL.lgFadeAt
                    BlitTallRR(SelAtTall(HL.lgNext), gx0, gy0, gw2, gh2, 12, f*lgf)
                if HL.lgFadeAt && lgf >= 1
                    HL.lgIdx := HL.lgNext, HL.lgFadeAt := 0, HL.lgAt := now
                pS := RRPath(gx0, gy0, gw2, gh2, 12)
                DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pS, "int", 0)
                bandY := gy0 + Mod(DecT(now)*0.05, gh2 + 60) - 30
                b := VBrush(gx0, bandY, gw2, 20, Alpha(0xFFFFFF, 0), FA(Alpha(0xFFFFFF, 26), f))
                DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", gx0, "float", bandY, "float", gw2, "float", 20), DelB(b)
                cur2 := (HL.lgFadeAt && lgf >= 0.5) ? HL.lgNext : HL.lgIdx
                b := SBrush(FA(Alpha(0x0B0C14, 170), f))
                FillRR(gx0 + gw2 - 42, gy0 + gh2 - 24, 36, 18, 5, b), DelB(b)
                Txt((cur2 - gateBase) "/" galRotN, gx0 + gw2 - 42, gy0 + gh2 - 25, 36, 18, HL.fS, FA(Alpha(AccHi(hubCur, 0.4), 235), f), fmtC)
                DllCall("gdiplus\GdipResetClip", "ptr", G)
                DllCall("gdiplus\GdipDeletePath", "ptr", pS)
                pn := Pen(FA(0x2EFFFFFF, f), 1)
                StrokeRR(gx0, gy0, gw2, gh2, 12, pn), DelP(pn)
                pn := Pen(FA(Alpha(hubCur, 150 + 50*emb2G), f), 1.4)
                StrokeRR(gx0 - 3.5, gy0 - 3.5, gw2 + 7, gh2 + 7, 15, pn), DelP(pn)
                pn := Pen(FA(Alpha(AccHi(hubCur, 0.4), 220), f), 1.8)
                Line(gx0 - 3.5, gy0 + 12, gx0 - 3.5, gy0 + 34, pn)
                Line(gx0 + gw2 + 3.5, gy0 + gh2 - 34, gx0 + gw2 + 3.5, gy0 + gh2 - 12, pn), DelP(pn)
                prg := HL.lgFadeAt ? 1.0 : Clamp((now - HL.lgAt)/3000.0, 0.0, 1.0)
                b := SBrush(FA(0x1EFFFFFF, f))
                FillRR(gx0, gy0 + gh2 + 10, gw2, 3, 1.5, b), DelB(b)
                b := SBrush(FA(Alpha(hubCur, 210), f))
                FillRR(gx0, gy0 + gh2 + 10, Max(gw2*prg, 3), 3, 1.5, b), DelB(b)
                Txt("GALLERY", gx0 - 30, gy0 + gh2 + 20, gw2 + 60, 12, HL.fS, FA(Alpha(AccHi(hubCur, 0.3), 170), f), fmtC)
            }
            loop 7 {
                k := A_Index
                tkx2 := x0 + HL.ctw - 186
                pn := Pen(FA(Alpha(0xFFFFFF, Mod(k, 2) ? 34 : 18), f), 1)
                Line(tkx2, y0 + 74 + (k - 1)*34, tkx2 + (Mod(k, 2) ? 7 : 4), y0 + 74 + (k - 1)*34, pn), DelP(pn)
            }
            ocx := x0 + 276, ocy := y0 + 46
            pn := Pen(FA(Alpha(hubCur, 40), f), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            Ell(ocx - 13, ocy - 13, 26, 26, pn), DelP(pn)
            oaL := now*0.0026
            b := SBrush(FA(Alpha(AccHi(hubCur, 0.5), 200), f))
            FillEll(ocx + 13*Cos(oaL) - 2, ocy + 13*Sin(oaL) - 2, 4, 4, b), DelB(b)
            b := SBrush(FA(Alpha(hubCur, 120 + 60*emb2G), f))
            FillEll(ocx - 3, ocy - 3, 6, 6, b), DelB(b)
            loop 3 {
                k := A_Index - 1
                sxL := x0 + 308 + k*10
                twL := Max(0.0, Sin(DecT(now)*0.0023 + k*2.0))**5
                pn := Pen(FA(Alpha(AccHi(hubCur, 0.45), 40 + 170*twL), f), 1.3)
                Line(sxL - 4, ocy, sxL + 4, ocy, pn)
                Line(sxL, ocy - 4, sxL, ocy + 4, pn), DelP(pn)
            }
            fy2 := y0 + 76 + ents.Length*24 + 46
            FadeLine(x0, x0 + HL.ctw - 216, fy2 - 4, 0x1CFFFFFF, f)
            ; ---- drifting hearts in the empty stretch under the timeline ----
            hbx := x0 + HL.ctw - 190, hby := HL.pd + HL.ch - 96
            if (hby - 40 > fy2) {
                DllCall("gdiplus\GdipSetClipRect", "ptr", G, "float", hbx - 70, "float", hby - 54
                    , "float", 168, "float", 104, "int", 0)
                loop 7 {
                    hk := A_Index
                    cyc7 := 4200 + hk*730
                    ph7 := Mod(now + hk*941, cyc7)/cyc7
                    hx7 := hbx - 46 + Mod(hk*53, 132) + 11*Sin(DecT(now)*0.0011 + hk*1.4)
                    hy7 := hby + 40 - ph7*112
                    ha7 := Sin(3.14159*ph7)
                    MiniHeart(hx7, hy7, 3.2 + Mod(hk, 3)*1.3, FA(Alpha(AccHi(hubCur, 0.32 + 0.12*Mod(hk, 2))
                        , Round(150*ha7)), f))
                }
                pu7 := 0.5 + 0.5*Sin(DecT(now)*0.0021)
                b := SBrush(FA(Alpha(hubCur, Round(12 + 8*pu7)), f))
                FillEll(hbx - 34, hby - 34, 68, 68, b), DelB(b)
                MiniHeart(hbx, hby - 2, 11 + 1.4*pu7, FA(Alpha(AccHi(hubCur, 0.35), 205), f))
                pn := Pen(FA(Alpha(hubCur, Round(40 + 26*pu7)), f), 1.1)
                DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
                DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.016, 1000))
                Ell(hbx - 30, hby - 32, 60, 60, pn), DelP(pn)
                Txt("made with love", hbx - 74, hby + 34, 148, 13, HL.fXs, FA(Alpha(hubCur, 105), f), fmtC)
                DllCall("gdiplus\GdipResetClip", "ptr", G)
            }
            Txt("v0.9 - internal: gate / loading / overlay / hub", x0, fy2 + 6, HL.ctw - 226, 14, fHint, FA(0x42C7CBE0, f), fmtL)
            Txt("build 3.4.5", x0, fy2 + 24, 120, 14, fHint, FA(Alpha(hubCur, 90), f), fmtL)
        }
    }
