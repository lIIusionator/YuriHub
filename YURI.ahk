SPFSync() {
    on := (spfDiscord || spfRegion || spfMatch || spfOdds || SPF.hunting)
    if on {
        if !SPF.wasOn {
            ; Coming on - rescan the logs. The remembered sessions have to go
            ; with the offsets: SPFTick loads a session BEFORE parsing its
            ; chunk, so a session left saying "in game" from before the switch
            ; was turned off survived the rescan unless the replayed window
            ; happened to contain the disconnect - and a leave that had scrolled
            ; past never did. The panel then reported a game left ten minutes
            ; ago as live.
            SPF.logPos := Map(), SPF.sess := Map()
            SPF.shownLog := "", SPF.shownPlace := "", SPF.shownJob := ""
            SPF.ipScanFor := Map()
        }
        SPF.wasOn := 1
        SetTimer(SPFTick, SPF.hunting ? SPF_MM_FAST : 1500)
        ; The kick has to be a DIFFERENT function. SetTimer keyed on SPFTick
        ; with a negative period reconfigures that same timer to fire once and
        ; then delete itself - so the periodic timer set on the line above was
        ; being cancelled, SPFTick ran exactly once per toggle, and nothing
        ; updated again until the user flipped the switch. That is why joining
        ; a game appeared to need the switches turned off and on.
        SetTimer(SPFKick, -60)
    } else {
        SPF.wasOn := 0
        SetTimer(SPFTick, 0)
        SetTimer(SPFKick, 0)
        SPFDcClose()
        SPFClearGame()
    }
}
SPFKick() {
    SPFTick()
