    SH.fgWin := 0
    try SH.fgWin := WinExist("A")
    SetTimer(ScrIHGuard, 250)                    ; see ScrIHGuard
    HubPoke()
}
ScrBlur() {
    global SH
    SH.focus := 0
    if SH.ih {
        ; Stop() TERMINATES the input, and terminating fires OnEnd - but OnEnd
        ; is dispatched as its own thread, so ScrEnd does not run inside this
        ; call, it runs after whatever click caused the blur has finished. If
        ; that click went on to focus another field, the stale ScrEnd lands on
        ; the NEW hook and blurs it. Detaching the handler first says what this
        ; is: a deliberate teardown, not the user pressing Escape.
        try SH.ih.OnEnd := ""
        try SH.ih.Stop()
        SH.ih := 0
    }
    SH.fgWin := 0
    SetTimer(ScrIHGuard, 0)
