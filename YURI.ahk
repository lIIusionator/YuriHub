            fbt := f*c8
            FFMBtn(1204, ax2 + PZ_BTX, ay2p + PZ_BTY, PZ_BTW, 22
                 , PZ_cal ? "CANCEL" : "SET GRID", hubCur, fbt, PZ_cal ? 2 : 0)
            FFMBtn(1205, ax2 + PZ_B2X, ay2p + PZ_BTY, PZ_B2W, 22, "RESET", hubCur, fbt, 0)
            ; full width now - from the left margin to the right, so the whole
            ; sentence has somewhere to be. Elided anyway as a backstop against
            ; a longer key label or a different font.
            stW := HL.abw - PZ_BTX - 16
            Txt(FFMElide(stTxt, fBadge, stW), ax2 + PZ_BTX + sld2, ay2p + PZ_STY
                , stW, 16, fBadge, FA(Alpha(stCl2, 225), f), fmtL)
            ; ---- the note under the grid row ----
            ; Same construction as the caveat under the speed slider: HL.fXs at
            ; low alpha, amber because it is a warning rather than a label, and
            ; sitting directly beneath the control it is about. It is drawn
            ; whether or not the module is armed - a caveat you only see once
            ; you have already switched something on is not a caveat.
            ; ---- SESSION INDICATOR ----
            ; A session is "one generator": armed to disarmed. It matters because
            ; the first board of one carries the banner that pushes the board
            ; down 54 px, and the module measures that per board rather than
            ; assuming it - so this is here to be READ ALONGSIDE the measurement,
            ; not to drive it.
            ;
            ; Three states, and the colour is the message: green while board 1 is
            ; still ahead and the shift is expected, accent once the session is
            ; past it, grey when the module is off and there is no session at all.
            ; Sits on the note row, right-aligned, because that row was empty to
            ; the right of the caveat and the two belong together - both are
            ; things to know before pressing the key.
            ; sX is computed FIRST and the note's width is derived from it below.
            ; Its old box was HL.abw - 130 = 272 px for about 120 px of text, and
            ; the pill lands at 260 - a 68 px overlap, which is the third time a
            ; fixed-width box in this file has been caught sitting on its
            ; neighbour. One edge, one source.
            sX := 0, sW := 0
            if puzOn {
                sTx := PZ_sess ? ("SESSION  ·  BOARD " (PZ_sess + 1))
                               : "SESSION  ·  BOARD 1"
                sCl := PZ_sess ? AccHi(hubCur, 0.35) : C_ON
                sW  := MeasureW(sTx, HL.fXs) + 26
                sX  := ax2 + HL.abw - 16 - sW + sld2
                sY  := ay2p + PZ_BTY + 3           ; beside the buttons, not the note
                b := VBrush(sX, sY, sW, 16, FA(Alpha(sCl, 34), f*c8), FA(Alpha(sCl, 14), f*c8))
                FillRR(sX, sY, sW, 16, 8, b), DelB(b)
                pn := Pen(FA(Alpha(sCl, 80), f*c8), 1)
                StrokeRR(sX, sY, sW, 16, 8, pn), DelP(pn)
                ; the pip breathes only while board 1 is still ahead - once the
                ; banner has been and gone there is nothing left to warn about
                pa := PZ_sess ? 200 : Round(150 + 90*(Sin(DecT(now)*0.005) + 1)/2)
                b := SBrush(FA(Alpha(sCl, pa), f*c8))
                FillEll(sX + 9, sY + 6, 4, 4, b), DelB(b)
                Txt(sTx, sX + 18, sY + 1, sW - 22, 14, HL.fXs
                  , FA(Alpha(sCl, 225), f*c8), fmtL)
            }
            ; whatever is left to the LEFT of the pill, and elided rather than
            ; clipped if that is not enough
            ; the pill is on the button row now, so this row is the note's alone
            nX := ax2 + PZ_BTX + sld2
            nW := HL.abw - PZ_BTX - 16
            if (nW > 40)
                Txt(FFMElide("(SET IN-GAME, BIT BUGGY)", HL.fXs, nW), nX, ay2p + PZ_NTY
                    , nW, 13, HL.fXs, FA(Alpha(AMBER, 165), f), fmtL)
            ; ---- speed slider ----
            ; One control for the whole solve: it sets the assumed frame budget,
            ; and every dwell and the drag budget are derived from that, so the
            ; timing stays internally consistent at any position. Full right is
            ; the fastest the module has ever run - which is exactly why the
            ; caveat under it is there: that setting assumes a 60 FPS client.
            slx := ax2 + PZ_SLX, sly := ay2p + PZ_SLY
            sfa := f*(puzOn ? 1 : 0.45)
            hvS := HL.h.Get(1203, 0.0)
            Txt("speed", ax2 + 56, sly - 8, 44, 16, fHint, FA(0x62C7CBE0, sfa), fmtL)
            b := SBrush(FA(Alpha(0xFFFFFF, 26), sfa))
            FillRR(slx, sly - 1.5, PZ_SLW, 3, 1.5, b), DelB(b)
            b := SBrush(FA(Alpha(hubCur, 190), sfa))
            FillRR(slx, sly - 1.5, PZ_SLW*PZ_SpeedT, 3, 1.5, b), DelB(b)
            ; ticks mark the ends so the travel reads as a range, not a bar
            loop 2 {
                b := SBrush(FA(Alpha(0xFFFFFF, 40), sfa))
                FillRR(slx + (A_Index - 1)*PZ_SLW, sly - 5, 1, 10, 0.5, b), DelB(b)
            }
            knx := slx + PZ_SLW*PZ_SpeedT
            kr2 := 6 + 1.6*hvS + ((HL.drag = 19) ? 1.4 : 0)
            b := SBrush(FA(Alpha(0x000000, 90), sfa))
            FillEll(knx - kr2, sly - kr2 + 1.5, kr2*2, kr2*2, b), DelB(b)
            b := SBrush(FA(Alpha(0xFEFEFE, 245), sfa))
            FillEll(knx - kr2, sly - kr2, kr2*2, kr2*2, b), DelB(b)
            b := SBrush(FA(Alpha(hubCur, 215), sfa))
            FillEll(knx - 2.2, sly - 2.2, 4.4, 4.4, b), DelB(b)
            Txt(PuzSpeedPct() "%", slx + PZ_SLW + 12, sly - 9, 46, 18, fBadge
                , FA(Alpha(Mix(0xFFE8EAF6, hubCur, 0.3), 225), sfa), fmtL)
            ; the caveat, and it earns its place: the top of this range is the
            ; setting that failed on slower clients
            ; the percentage is the control; the fps it implies is the thing you
            ; can check against your client, so it rides underneath
            Txt("assumes " PuzSpeedFps() " fps - keep at or below what your client holds"
                , ax2 + 56, sly + 12, HL.abw - 130, 13, HL.fXs
                , FA(Alpha(PZ_SpeedT > 0.72 ? AMBER : 0xFFC7CBE0, 150), sfa), fmtL)

            ; ---- toggle: identical construction to AUTOBLOCK's ----
            f := fb2*c8
            tx2 := HL.tgx2 + dx + (1 - c8)*12, ty2 := HL.tgy2 + dy2
            b := SBrushP(FA(THMix(0xFF33354E, 0xFF34D399, HL.puzT), f))
            FillRR(tx2, ty2, HL.tgw, HL.tgh, HL.tgh/2, b), DelB(b)
            MicroBackdrop(tx2, ty2, HL.tgw, HL.tgh, HL.tgh/2, hubCur, f, now, 0.6)
            pn := Pen(FA(Alpha(hubCur, 130 + 60*hvP + 40*emb2G), f), 1)
            StrokeRR(tx2, ty2, HL.tgw, HL.tgh, HL.tgh/2, pn), DelP(pn)
            if HL.puzT > 0.02 {
                pn := Pen(FA(Alpha(C_ON, (60 + 50*emb2G)*HL.puzT), f), 1.6)
                StrokeRR(tx2 - 2.5, ty2 - 2.5, HL.tgw + 5, HL.tgh + 5, HL.tgh/2 + 2.5, pn), DelP(pn)
            }
            kx2 := tx2 + HL.tgh/2 + (HL.tgw - HL.tgh)*HL.puzT
            kpop2 := puzFlash ? 1 + 0.22*(1 - (now - puzFlashAt)/340.0) : 1
            b := SBrush(FA(Alpha(0x000000, 90), f))
            FillEll(kx2 - 8*kpop2, ty2 + HL.tgh/2 - 8*kpop2 + 1.5, 16*kpop2, 16*kpop2, b), DelB(b)
            b := SBrush(FA(Alpha(0xFEFEFE, 245), f))
            FillEll(kx2 - 8*kpop2, ty2 + HL.tgh/2 - 8*kpop2, 16*kpop2, 16*kpop2, b), DelB(b)
            b := SBrush(FA(Alpha(hubCur, 210), f))
            FillEll(kx2 - 2.6, ty2 + HL.tgh/2 - 2.6, 5.2, 5.2, b), DelB(b)
            Pop(stPC)                  ; clip + transform back to the hub body
            f := fb2
            HubKeyRow(2, ax2, by3, f*c7, now, hubCur, rbp)
            HubKeyRow(3, ax2, by3 + HUB_KBRG, f*c7, now, hubCur, rbp)
            f := fb*c5
            if c5 <= 0.01
                return
            sy2 := by3 + HUB_KBRG + 22 + 26   ; clears the markers row, line included
            FadeLine(ax2, ax2 + HL.abw, sy2 - 12, 0x1CFFFFFF, f)
            Txt("systems ship inside the script and cannot be removed", ax2, sy2, HL.abw, 14, fHint, FA(0x44C7CBE0, f), fmtL)
            loop 20 {
                k := A_Index
                gr2 := Clamp((c5 - k*0.02)*2.4, 0.0, 1.0)
                hh := (3 + 9*Abs(Sin(DecT(now)*0.0026 + k*0.7)))*gr2
                b := SBrush(FA(Alpha(hubCur, 22 + 40*Abs(Sin(DecT(now)*0.0018 + k*0.5))), f))
                FillRR(ax2 + (k - 1)*13, sy2 + 44 - hh, 5, hh, 2, b), DelB(b)
            }
            ; ---- keybind clash warning ----
            ; LAST in the panel, deliberately. Drawn before the footer it was
            ; painted over by it, so the strip and the bars stayed bright under a
            ; card that is meant to be modal.
            if (PuzClashUp() && mt > 0.9) {
                HubClashGeom(&wx, &wy, &ww, &wh)
                ; panel-local -> draw space. ax2/ay2 are the panel's origin as
                ; the renderer has it (HL.abx/HL.aby plus the entry slide), which
                ; is exactly what the original expressions used.
                wx += ax2, wy += ay2
                ; ---- in and out ----
                ; The entrance was here from the start; there was no exit at all.
                ; GOT IT cleared the state and the card was simply gone on the
                ; next frame, which is the one transition in the suite that used
                ; to happen with a cut. The exit is the entrance run backwards:
                ; the dim lifts, the card shrinks and rises, and the ring that
                ; punched OUTWARD on the way in collapses INWARD on the way out.
                ce := PZ_clashAt ? Clamp((now - PZ_clashAt)/420.0, 0.0, 1.0) : 1.0
                cs := EBackOut(ce, 1.5)
                co := PZ_clashOut ? Clamp((now - PZ_clashOut)/300.0, 0.0, 1.0) : 0.0
                coE := Ease3(co)
                wp := (Sin(DecT(now)*0.003) + 1)/2
                fw := f*Min(ce*2.2, 1.0)*(1 - coE)
                ; contents arrive in sequence rather than all at once, the same
                ; staging the overlay card and the grid setup card use
                q1 := Ease3((ce - 0.08)/0.40), q2 := Ease3((ce - 0.16)/0.40)
                q3 := Ease3((ce - 0.26)/0.40), q4 := Ease3((ce - 0.38)/0.40)
                q5 := Ease3((ce - 0.48)/0.40), q6 := Ease3((ce - 0.58)/0.40)
                ; The dim has to cover the WHOLE column - header, both cards,
                ; every keybind row, the footer strip and the bars. It used to
                ; span only the two card rectangles, which left half the panel
                ; bright underneath a supposedly modal card.
                dimY := y0 + 28
                dimH := (by3 + HUB_KBRG + 22 + 26 + 50) - dimY
                b := SBrush(FA(Alpha(0x05060C, Round(175*Min(ce*2, 1.0)*(1 - coE))), f))
                FillRR(ax2 - 8, dimY, HL.abw + 16, dimH, 12, b), DelB(b)
                ; a shade of anticipation on the way out: the card gathers a
                ; hair before it goes, so the dismissal reads as deliberate
                anti := (co > 0 && co < 0.24) ? 1 + 0.018*Sin(3.14159*co/0.24) : 1
                ; and a damped shudder on the way in. A refusal that arrives
                ; perfectly still reads as a panel; this reads as a rejection,
                ; and it is over in a third of a second.
                shk := (!hubLowPerf && ce < 1) ? Sin(ce*34)*((1 - ce)**2)*6 : 0
                stW := PushXform(wx + ww/2, wy + wh/2
                               , (0.94 + 0.06*cs)*anti*(1 - 0.08*coE), 0)
                wx += shk
                wy -= (1 - cs)*10 + coE*10
                f0 := f, f := fw
                if (ce < 1 && !co) {
                    ex := (1 - ce)*22
                    pn := Pen(FA(Alpha(AMBER, Round(180*(1 - ce))), f), 2.4*(1 - ce) + 0.4)
                    StrokeRR(wx - ex, wy - ex*0.6, ww + ex*2, wh + ex*1.2, 16 + ex*0.4, pn), DelP(pn)
                }
                ShadowDraw(wx, wy, ww, wh, 16, 8, 26, 26, f)
                b := VBrush(wx, wy, ww, wh, FA(0xFF241C1E, f), FA(0xFF171216, f))
                FillRR(wx, wy, ww, wh, 16, b), DelB(b)
                ; PanelBackdrop, not MiniBackdrop. Mini is meant for a 26-tall
                ; strip; on a card this size it puts a couple of faint dots in
                ; the middle of a lot of empty plate, which is exactly how this
                ; read - large and bare. Panel is the full treatment the overlay
                ; and grid setup cards get: lattice, hatch, corner arcs, blooms.
                PanelBackdrop(wx, wy, ww, wh, AMBER, f, now, 0.95)

                ; ---- inside the plate ----
                ; Clipped and INTERSECTED, then the whole graphics state is put
                ; back: this card is drawn inside the systems panel's own clip,
                ; and replacing it here would let everything after spill out of
                ; the panel - the same trap FFMBtn's shine sweep documents.
                cp := RRPath(wx, wy, ww, wh, 16)
                svW := PushG()
                DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", cp, "int", 1)
                ; hazard stripes, drifting. A warning motif rather than a copy of
                ; the scan band every other card here uses - low enough to read
                ; as texture, not as decoration competing with the message.
                if !hubLowPerf {
                    dr := Mod(DecT(now), 4200)/4200.0*40
                    pn := Pen(FA(Alpha(AMBER, 12), f), 10)
                    sxh := wx - wh - 40
                    while (sxh < wx + ww + wh) {
                        Line(sxh + dr, wy + wh, sxh + dr + wh, wy, pn)
                        sxh += 40
                    }
                    DelP(pn)
                }
                ; ---- the key, again, as a watermark ----
                ; The card is mostly plate, and the one thing it is about is a
                ; single short string. Set enormous and nearly invisible behind
                ; the content it fills the space with the subject rather than
                ; with ornament - and it is the cheapest possible fill: one
                ; string, one brush.
                if !hubLowPerf {
                    TxtP(PZ_clashKey, wx, wy + wh*0.30, ww, wh*0.5, HL.fG
                       , FA(Alpha(AMBER, Round(13 + 5*wp)), f*q3), fmtC)
                }
                ; ---- hazard chevrons along the foot ----
                ; A band of them, marching. The stripes above are texture; this
                ; is the card saying what KIND of card it is from across the
                ; room, and it anchors the bottom edge the button sits on.
                if !hubLowPerf {
                    ; flush with the foot, BELOW the button row. At wh - 54 it
                    ; ran straight through GOT IT.
                    cvy := wy + wh - 13, cvh := 10
                    cdr := Mod(DecT(now), 2600)/2600.0*30
                    b := SBrush(FA(Alpha(0x000000, 40), f*q6))
                    FillRR(wx, cvy - 3, ww, cvh + 6, 0, b), DelB(b)
                    pn := Pen(FA(Alpha(AMBER, 58), f*q6), 4)
                    cvx := wx - 40
                    while (cvx < wx + ww + 40) {
                        Line(cvx + cdr, cvy + cvh, cvx + cdr + cvh*0.8, cvy, pn)
                        Line(cvx + cdr + cvh*0.8, cvy, cvx + cdr + cvh*1.6, cvy + cvh, pn)
                        cvx += 30
                    }
                    DelP(pn)
                }
                ; the accent rail every other card in the suite carries, and the
                ; one thing this card was missing at a glance
                b := SBrush(FA(Alpha(AMBER, Round(40 + 26*wp)), f))
                DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
                      , "float", wx, "float", wy, "float", 12, "float", wh), DelB(b)
                b := VBrush(wx, wy, 4, wh, FA(Alpha(AMBER, 245), f), FA(Alpha(AMBER, 120), f))
                DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b
                      , "float", wx, "float", wy, "float", 4, "float", wh), DelB(b)
                Pop(svW)
                DllCall("gdiplus\GdipDeletePath", "ptr", cp)

                pn := Pen(FA(Alpha(AMBER, Round(120 + 60*Abs(Sin(DecT(now)*0.003)))), f), 1.4)
                StrokeRR(wx, wy, ww, wh, 16, pn), DelP(pn)
                loop 4 {
                    kg := A_Index - 1
                    shm := (Sin(DecT(now)*0.005 + kg*1.5708) + 1)/2
                    xk := (kg = 1 || kg = 2) ? wx + ww - 31.5 : wx + 0.5
                    yk := (kg >= 2) ? wy + wh - 31.5 : wy + 0.5
                    ang := kg = 0 ? 195 : kg = 1 ? 285 : kg = 2 ? 15 : 105
                    pn := Pen(FA(Alpha(AMBER, Round(85 + 65*shm)), f), 1.8)
                    Arc(xk, yk, 31, 31, ang, 60, pn), DelP(pn)
                    ; and a bracket outside each arc - the reticle mark the grid
                    ; setup card uses, which is what makes a corner read as a
                    ; corner rather than as a rounded edge
                    sgx := (kg = 1 || kg = 2) ? -1 : 1
                    sgy := (kg >= 2) ? -1 : 1
                    bcx := (kg = 1 || kg = 2) ? wx + ww - 6 : wx + 6
                    bcy := (kg >= 2) ? wy + wh - 6 : wy + 6
                    pn := Pen(FA(Alpha(AccHi(AMBER, 0.4), Round(70 + 60*shm)), f), 1.6)
                    Line(bcx, bcy + sgy*7, bcx, bcy + sgy*20, pn)
                    Line(bcx + sgx*7, bcy, bcx + sgx*20, bcy, pn), DelP(pn)
                }
                ; ---- a light running the perimeter ----
                ; One pass every four seconds. The border already breathes, which
                ; is a state; this is motion with a direction, and it is what
                ; stops a card this large from sitting completely still.
                if !hubLowPerf {
                    per2 := (ww + wh)*2
                    tp2 := Mod(DecT(now)/4200.0, 1.0)*per2
                    loop 14 {
                        d2 := tp2 - (A_Index - 1)*7
                        if (d2 < 0)
                            d2 += per2
                        if (d2 < ww)
                            lpx := wx + d2, lpy := wy
                        else if (d2 < ww + wh)
                            lpx := wx + ww, lpy := wy + (d2 - ww)
                        else if (d2 < ww*2 + wh)
                            lpx := wx + ww - (d2 - ww - wh), lpy := wy + wh
                        else
                            lpx := wx, lpy := wy + wh - (d2 - ww*2 - wh)
                        la := Round(150*(1 - (A_Index - 1)/14.0)**2)
                        rl := 2.2*(1 - (A_Index - 1)/16.0)
                        b := SBrush(FA(Alpha(AccHi(AMBER, 0.5), la), f))
                        FillEll(lpx - rl, lpy - rl, rl*2, rl*2, b), DelB(b)
                    }
                }

                ; ---- header ----
                tcx := wx + 42, tcy := wy + 36 - (1 - q1)*6
                loop 2 {
                    rh := 13 + A_Index*(3.2 + 2.6*wp)
                    b := SBrush(FA(Alpha(AMBER, Round(22 - A_Index*6)), f*q1))
                    FillEll(tcx - rh, tcy - rh, rh*2, rh*2, b), DelB(b)
                }
                pn := Pen(FA(Alpha(AMBER, 235), f*q1), 2.3)
                Line(tcx, tcy - 12, tcx + 12, tcy + 9, pn)
                Line(tcx + 12, tcy + 9, tcx - 12, tcy + 9, pn)
                Line(tcx - 12, tcy + 9, tcx, tcy - 12, pn), DelP(pn)
                b := SBrush(FA(Alpha(AMBER, 235), f*q1))
                FillRR(tcx - 1.1, tcy - 5, 2.2, 7.5, 1.1, b)
                FillRR(tcx - 1.1, tcy + 4.5, 2.2, 2.2, 1.1, b), DelB(b)
                Txt("KEYBIND CONFLICT", wx + 68, wy + 20 - (1 - q1)*6, ww - 88, 24, HL.fV
                    , FA(Alpha(AccHi(AMBER, 0.35), 245), f*q1), fmtL)
                Txt("one key cannot serve both systems", wx + 68, wy + 44 - (1 - q1)*4, ww - 88, 16
                    , fHint, FA(0x8AC7CBE0, f*q2), fmtL)
                FadeLine(wx + 24, wx + ww - 24, wy + 74, 0x30FFFFFF, f*q2)
                if (q2 > 0.01 && q2 < 1 && !hubLowPerf) {
                    lw := (ww - 48)*q2
                    b := SBrush(FA(Alpha(AccHi(AMBER, 0.4), Round(200*(1 - q2))), f))
                    FillRR(wx + 24, wy + 73.2, lw, 1.6, 0.8, b), DelB(b)
                }

                ; ---- the contested key, as a key ----
                ; It used to be the first two words of a sentence. The suite
                ; draws bindings as caps everywhere else, and the whole message
                ; turns on WHICH key - so it gets a cap of its own, centred,
                ; and large enough to be the thing you see first.
                kcw := Max(84, MeasureW(PZ_clashKey, fKey) + 44)
                kcx := wx + (ww - kcw)/2, kcy := wy + 94 + (1 - q3)*10
                loop 2 {
                    rg := A_Index
                    b := SBrush(FA(Alpha(AMBER, Round((26 - rg*8)*(0.5 + 0.5*wp))), f*q3))
                    FillRR(kcx - rg*5, kcy - rg*4, kcw + rg*10, 44 + rg*8, 12 + rg*2, b), DelB(b)
                }
                b := VBrush(kcx, kcy, kcw, 44, FA(0xFF3E302A, f*q3), FA(0xFF251D1F, f*q3))
                FillRR(kcx, kcy, kcw, 44, 10, b), DelB(b)
                MicroBackdrop(kcx, kcy, kcw, 44, 10, AMBER, f*q3, now, 0.85)
                pn := Pen(FA(Alpha(AMBER, Round(150 + 80*wp)), f*q3), 1.4)
                StrokeRR(kcx, kcy, kcw, 44, 10, pn), DelP(pn)
                TxtP(PZ_clashKey, kcx, kcy - 1, kcw, 44, fKey
                   , FA(Alpha(AccHi(AMBER, 0.45), 252), f*q3), fmtC)
                Txt("is already in use", wx, kcy + 52, ww, 18, fHint
                    , FA(Alpha(0xFFC7CBE0, 215), f*q3), fmtC)

                ; ---- the two systems, one row each ----
                ; Names lead and carry the brighter ink: they are the two things
                ; being told apart, and burying them mid-sentence made the card
                ; something to read rather than scan. A row apiece means neither
                ; can be truncated by the other, and neither runs under GOT IT -
                ; the body text used to be sized to the full card width and
                ; passed straight through the button.
                rw := ww - 48, rx := wx + 24
                loop 2 {
                    kk := A_Index
                    ry := wy + 176 + (kk - 1)*54
                    qr := (kk = 1) ? q4 : q5
                    ry += (1 - qr)*8
                    nm := (kk = 1) ? PZ_clashOwn : PZ_clashWho
                    sb := (kk = 1) ? "is listening on it" : "needs its own key, or disarm the other"
                    b := SBrush(FA(Alpha(0xFFFFFF, Round(10 + 6*(kk = 1 ? 1 : 0))), f*qr))
                    FillRR(rx, ry, rw, 46, 10, b), DelB(b)
                    MicroBackdrop(rx, ry, rw, 46, 10, AMBER, f*qr, now, 0.85)
                    ; a left bar apiece: solid on the system that holds the key,
                    ; hollow on the one that was turned away, so the pair reads
                    ; without the labels
                    if (kk = 1) {
                        b2 := VBrush(rx, ry + 8, 3, 30, FA(Alpha(AMBER, 235), f*qr)
                                                       , FA(Alpha(AMBER, 90), f*qr))
                        FillRR(rx, ry + 8, 3, 30, 1.5, b2), DelB(b2)
                    } else {
                        pn := Pen(FA(Alpha(AMBER, 110), f*qr), 1)
                        StrokeRR(rx + 0.5, ry + 8, 2.5, 30, 1.2, pn), DelP(pn)
                    }
                    pn := Pen(FA(Alpha(AMBER, Round(kk = 1 ? 90 : 52)), f*qr), 1)
                    if (kk = 2)
                        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
                    StrokeRR(rx, ry, rw, 46, 10, pn), DelP(pn)
