SPFToggle(i) {
    ; spfMulti belongs here for the same reason as the other four: this
    ; function ASSIGNS to it, and an assignment to an undeclared name creates a
    ; local no matter that a super-global of that name exists - so the toggle
    ; would read an empty local and throw instead of flipping the setting.
    global spfDiscord, spfRegion, spfMatch, spfOdds, spfMulti, spfFps
    if (i = 1) {
        ; Refuse rather than accept a switch that cannot do anything - turning
        ; it on here would light the toggle while the card stayed withdrawn.
        if (!spfDiscord && SPFMultiBlock()) {
            SPFSay("DISCORD ACTIVITY UNAVAILABLE WITH SEVERAL ROBLOX CLIENTS OPEN", AMBER)
            return
        }
        spfDiscord := !spfDiscord
        if (!spfDiscord)
            SPFDcClose()
        SPFSay(spfDiscord ? "DISCORD ACTIVITY ON" : "DISCORD ACTIVITY OFF"
             , spfDiscord ? C_ON : 0xFFC7CBE0)
        SPFSave("discord", spfDiscord ? 1 : 0)   ; last, so a failure is what shows
    } else if (i = 2) {
        spfRegion := !spfRegion
        if (!spfRegion && !spfMatch)
            SPF.region := "", SPF.regionCC := "", SPF.regionIP := ""
        SPFSay(spfRegion ? "SERVER REGION ON" : "SERVER REGION OFF"
             , spfRegion ? C_ON : 0xFFC7CBE0)
        SPFSave("region", spfRegion ? 1 : 0)
    } else if (i = 3) {
        spfMatch := !spfMatch
        SPF.mmTries := 0, SPF.mmAt := 0, SPF.mmNote := ""
        SPFSay(spfMatch ? "AUTO-REGION FINDER ON - rerolls wrong-region servers"
                        : "AUTO-REGION FINDER OFF", spfMatch ? C_ON : 0xFFC7CBE0)
        SPFSave("match", spfMatch ? 1 : 0)
    } else if (i = 4) {
        spfOdds := !spfOdds
        SPFSay(spfOdds ? "BETTER MATCHMAKING ON - experimental, picks from servers it has measured"
                       : "BETTER MATCHMAKING OFF", spfOdds ? AMBER : 0xFFC7CBE0)
        SPFSave("odds", spfOdds ? 1 : 0)
    } else if (i = 5) {
        spfMulti := !spfMulti
        if spfMulti {
            held := SPFMultiHold()
            if held {
                ; Stamped only once the take succeeded, so a failed arm cannot
                ; leave a timestamp that makes every running client look stale.
                SPF.multiAt := A_Now
                ; The shortcut launch is the mistake everyone makes, and it
                ; fails in a way that looks like this switch is broken rather
                ; than like a missing login ticket - so say it here, not only
                ; in the detail sheet.
                SPFSay("MULTI-INSTANCE ON - LAUNCH EACH CLIENT WITH PLAY ON THE WEBSITE, NOT THE SHORTCUT", C_ON)
            } else {
                ; nothing to fall back to - say so rather than showing a lit
                ; switch that does nothing
                spfMulti := 0
                SPFSay("COULD NOT TAKE THE ROBLOX SINGLETON - TRY RUNNING AS ADMIN", C_ACC)
            }
        } else {
            SPFMultiRelease()
            SPF.multiAt := ""
            SPFSay("MULTI-INSTANCE OFF - CLIENTS ALREADY OPEN STAY OPEN", 0xFFC7CBE0)
        }
        SPFSave("multi", spfMulti ? 1 : 0)
    } else {
        spfFps := !spfFps
        SPFFpsTimerRes(spfFps)
        n := SPFFpsApply(spfFps ? true : false)
        SPFFpsManage()
        if spfFps {
            ; A client that is not running yet is not a failure - the watcher
            ; picks it up within six seconds of launch. Say which case it is,
            ; because a switch that lights over nothing looks broken.
            ; Says what took, not what was attempted. A number below the full
            ; count is normal and not a fault - the core preference is a no-op
            ; on any CPU that is not hybrid and the timer bit is Windows 11 only
            ; - so the levers that reported nothing are NAMED rather than left
            ; as a shortfall for the user to read as breakage.
            ; The long form lives HERE, on the status line, because the row's
            ; hint gives its space to the chips and only has room for the terse
            ; version - see SPFFpsHintShort.
            lv := SPFFpsTookN()
            msg := n ? ("FPS BOOST ON - " StrUpper(SPFFpsReport()))
                     : "FPS BOOST ON - WAITING FOR ROBLOX TO START"
            if (n && lv < SPF_FPS_LEVERS.Length) {
                ms := SPFFpsMissing()
                if ms.Length {
                    msg .= "  ·  NOT: "
                    for i2, m2 in ms
                        msg .= (i2 > 1 ? ", " : "") m2
                }
            }
            ; The power state outranks the lever tally: neither is a failure of
            ; this switch, but one of them is the reason the frames did not move.
            if (SPF.fpsPower != "")
                msg .= "  ·  " StrUpper(SPF.fpsPower)
            SPFSay(msg, C_ON)
        } else {
            ; Every reversible thing this feature did, said out loud on the way
            ; out. The two opt-ins reach outside the client, so "off" has to be
            ; visibly complete rather than merely asserted.
            ; The parent switch owns everything the chips turned on. Leaving a
            ; power scheme changed under a switch that reads OFF is precisely
            ; the failure the journal exists for, and it should not need the
            ; journal to catch it.
            sysBack := SPF.fpsSysN ? SPFFpsSysRevert() : 0
            sysBack += SPFFpsGpuRevert()
            msg := n ? "FPS BOOST OFF - CLIENTS BACK TO NORMAL PRIORITY"
                     : "FPS BOOST OFF"
            if sysBack
                msg .= "  ·  " sysBack " SYSTEM SETTING(S) PUT BACK"
            SPFSay(msg, 0xFFC7CBE0)
        }
        SPFSave("fps", spfFps ? 1 : 0)
    }
    SPF.flashAt[i] := A_TickCount
    SPFSync()
}
; ---- FPS BOOST's two opt-ins ----
; Split out from SPFSubToggle rather than folded into it: these two are not
; cosmetic. One writes a registry value that survives a reboot and the other
; changes the scheduling of processes that are not ours, so each states plainly
; what it did and each is reverted in full the moment it goes off.
SPFFpsSubToggle(i) {
    global spfFpsGpu, spfFpsQuiet, spfFpsSys
    if (i = 3) {
        ; ---- machine-wide settings ----
        ; The only control in this suite that changes anything outside a
        ; process, so it is the only one that says what it is before it does it
        ; - and the only one whose undo is written to disk before the change is
        ; made rather than held in memory. See the journal block above.
        spfFpsSys := !spfFpsSys
        if spfFpsSys {
            n := SPFFpsSysApply(true)
            mx := SPFFpsSysMax()
            if n {
                msg := "SYSTEM TWEAKS ON - " n " OF " mx " APPLIED, ALL RECORDED FOR UNDO"
                if (SPF.fpsPwrNote != "")
                    msg .= "  ·  " StrUpper(SPF.fpsPwrNote)
                if !A_IsAdmin
                    msg .= "  ·  RUN AS ADMIN FOR THE TWO UNDER HKLM"
                SPFSay(msg, C_ON)
            } else {
                spfFpsSys := 0
                SPFSay(SPF.fpsWhy != "" ? StrUpper(SPF.fpsWhy)
                                        : "NOTHING TO CHANGE - ALREADY SET THAT WAY", AMBER)
            }
        } else {
            n := SPFFpsSysRevert()
            SPFSay(n ? ("SYSTEM TWEAKS OFF - " n " SETTING(S) PUT BACK EXACTLY AS FOUND")
                     : "SYSTEM TWEAKS OFF", 0xFFC7CBE0)
        }
        SPFSave("fpssys", spfFpsSys ? 1 : 0)
        SPF.flashAt[20 + i] := A_TickCount
        HubPoke()
        return
    }
    if (i = 1) {
        ; ---- per-app GPU preference ----
        ; Refused rather than lit over nothing on a machine with one GPU, the
        ; same contract MULTI-ROBLOX INSTANCES holds itself to when it cannot
        ; take the singleton: a switch that is on and doing nothing is worse
        ; than one that says why it will not turn on.
        if (!spfFpsGpu && !SPFGpuHybrid()) {
            SPFSay("ONE GPU ON THIS MACHINE - NOTHING TO PREFER", AMBER)
            return
        }
        spfFpsGpu := !spfFpsGpu
        if spfFpsGpu {
            if (SPFClientExe() = "") {
                ; the preference is keyed on the client's full path, and with
                ; no client running there is no path to key it on
                spfFpsGpu := 0
                SPFSay("START ROBLOX ONCE SO YURI CAN SEE WHERE IT IS INSTALLED", AMBER)
            } else {
                r := SPFFpsGpuPref(true)
                ; 1 = we wrote it, 2 = it was already correct and is somebody
                ; else's to remove, 0 = refused. The middle case leaves the chip
                ; ON - the state is what the chip promises - but nothing was
                ; written and nothing will be deleted when it goes off.
                if (r = 1)
                    SPFSay("GPU PREFERENCE SET TO HIGH PERFORMANCE - RESTART ROBLOX FOR IT TO TAKE", C_ON)
                else if (r = 2)
                    SPFSay("ALREADY SET TO HIGH PERFORMANCE - LEFT EXACTLY AS IT IS", C_ON)
                else {
                    spfFpsGpu := 0
                    SPFSay(SPF.fpsGpuNote != "" ? StrUpper(SPF.fpsGpuNote)
                         : "WINDOWS ALREADY HAS A GPU PREFERENCE SET FOR ROBLOX - LEFT ALONE", AMBER)
                }
            }
        } else {
            ; Only removes a value YURI wrote. One that was already there when
            ; the chip went on was never adopted, so there is nothing to clear
            ; and saying "cleared" would be a lie about the user's own setting.
            SPFSay(SPFFpsGpuPref(false)
                     ? "GPU PREFERENCE CLEARED - BACK TO WINDOWS' OWN CHOICE"
                     : "GPU PREFERENCE OFF - NOTHING TO CLEAR, IT WAS NOT OURS"
                 , 0xFFC7CBE0)
        }
        SPFSave("fpsgpu", spfFpsGpu ? 1 : 0)
    } else {
        ; ---- quiet mode ----
        ; Names what it touched. A feature that reaches into other people's
        ; processes and does not say which ones is one the user cannot audit.
        spfFpsQuiet := !spfFpsQuiet
        if spfFpsQuiet {
            n := SPFFpsQuietApply(true)
            if n {
                lst := SPFFpsQuietList()
                nm := ""
                loop Min(lst.Length, 3)
                    nm .= (A_Index > 1 ? ", " : "") lst[A_Index]
                if (lst.Length > 3)
                    nm .= " +" (lst.Length - 3)
                SPFSay("QUIET MODE ON - " n " DEMOTED: " StrUpper(nm), C_ON)
            } else
                SPFSay("QUIET MODE ON - NOTHING WORTH DEMOTING IS RUNNING", C_ON)
        } else {
            n := SPFFpsQuietRestore()
            SPFSay(n ? ("QUIET MODE OFF - " n " RESTORED") : "QUIET MODE OFF", 0xFFC7CBE0)
        }
        SPFSave("fpsquiet", spfFpsQuiet ? 1 : 0)
    }
    SPF.flashAt[20 + i] := A_TickCount
    HubPoke()
}
; The sub-options belong to system 1 and change nothing but the shape of the
; presence card, so there is no SPFSync here - no timer period changes and no
; log rescan is needed. Clearing dcSent is what makes the card redraw at once
