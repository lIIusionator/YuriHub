; ---- TRUE MINIMISE: hide and show ----
; Hiding is not the pill animation with its last frame removed - it is a
; different thing. The pill is a state the hub is IN; this is the hub not being
; there. So the eased minimise state is dropped to zero, the window is hidden,
; and the renderer is stopped rather than left spinning on a surface that is
; never presented to anything.
HubHide() {
    global hubHidden
    if (hubHidden || !hubLive || !IsObject(HL))
        return
    if SH.focus
        ScrBlur()
    FFMBlur()
    ; Any pill state is dropped rather than preserved: coming back from the tray
    ; should give you the hub, not the hub caught mid-collapse.
    HL.minT := 0.0, HL.minV := 0.0, HL.minStart := 0
    HL.minFrom := 0.0, HL.minTo := 0.0
    HL.burstAt := 0, HL.scatAt := 0
    hubHidden := 1
    HubTim(0)
    ; SW_HIDE. Paired with the SW_SHOWNA above rather than Gui.Hide/Gui.Show so
    ; both halves go through the same API and neither can touch the geometry.
    try DllCall("ShowWindow", "ptr", HL.gui.Hwnd, "int", 0)
    A_IconTip := APPNAME " - hidden (click to open)"
}
HubShow() {
    global hubHidden
    if (!hubLive || !IsObject(HL))
        return
    ; The surface is sized and transformed for a screen that no longer exists.
    ; Showing it would put a hub on screen that looks right and mis-places every
    ; click in it, so the notice comes back instead of the hub.
    if HL.HasOwnProp("resStale") && HL.resStale {
        HubResNotice()
        return
    }
    if hubHidden {
        hubHidden := 0
        ; The intro is replayed deliberately. Coming back from the tray with the
        ; window simply existing at full opacity reads as a glitch next to every
        ; other transition in the suite.
        HL.intro := A_TickCount, HL.scrAt := A_TickCount
        HL.pokeAt := A_TickCount
        ; Painted BEFORE it is shown. The layered surface still holds the last
        ; frame from before it was hidden, so revealing the window first would
        ; flash that stale frame at full opacity for one tick and then restart
        ; the intro from nothing - a visible double-take. One render while still
        ; hidden puts frame zero of the intro on the surface, and SW_SHOWNA then
        ; reveals something already correct.
        try HubRender()
        ; ShowWindow(SW_SHOWNA) rather than Gui.Show: Show re-applies the size
        ; and position it was last given, and this window is placed by
        ; UpdateLayeredWindow rather than by WinMove - so letting Gui.Show near
        ; it is how a hub dragged somewhere would jump back to where it opened.
        try DllCall("ShowWindow", "ptr", HL.gui.Hwnd, "int", 8)
    }
    A_IconTip := APPNAME
    HL.pokeAt := A_TickCount
    HubRaise()
    HubTim(TICK_A)
}
; Put the hub in front of everything, whatever ALWAYS ON TOP is set to. With it
; on this is just a re-assert. With it off, -1 then HubTopZ() is the standard
; two-step: the first call lifts the window into the topmost band and therefore
; above everything, the second drops it back out of that band but leaves it at
; the front of the ordinary one - which is "on top" without making it stay there.
; ---- is the hub BODY able to accept input? ----
; "Is the hub minimised" was being answered three different ways across the
; file - `HL.minT >= 0.5`, `HL.minTo = 1.0`, and `hubHidden` - and none of them
; is right on its own:
;
;   HL.minT   is the EASED value. It crosses 0.5 roughly 215 ms into a 430 ms
;             collapse, so for the first half of every minimise the whole hub
;             was still hit-testing and still swallowing keys. That is the
;             "sometimes" in the report: it depended entirely on how fast the
;             pointer moved after the click.
;   HL.minTo  is the INTENT, and is correct the instant the button is pressed,
;             but says nothing about a window hidden to the tray.
;   hubHidden covers TRUE MINIMIZE only.
;
; All three, in one place, so every caller agrees. The pill itself is handled
; separately by its caller - this is about the body behind it.
HubBodyLive() {
    if (!hubLive || hubHidden || !IsObject(HL) || HL.closeAt)
        return false
    ; collapsing or collapsed - minTo settles this the moment minimise is asked
    ; for, rather than a fifth of a second later
    if (HL.minTo = 1.0 || HL.minT >= 0.5)
        return false
    return true
}
HubRaise() {
    if (!hubLive || !IsObject(HL))
        return
    HubZRaise(HL.gui.Hwnd)
}
; What the minimise button does. One control with two meanings, picked by the
; setting, rather than two controls - there is only ever one thing the user
; wants out of that button.
; ---- a settings group heading ----
; An accent tick, the name, then the divider running out to the right edge -
; the same shape the SPECIAL FEATURES panel uses for its own group breaks, so
; the two read as the same idea rather than as two inventions.
SetHead(x, w, y, label, acc, f, now) {
    b := SBrush(FA(Alpha(acc, 200), f))
    FillRR(x, y + 2, 2.5, 11, 1.2, b), DelB(b)
    Txt(label, x + 9, y, 160, 14, HL.fXs
      , FA(Alpha(Mix(0xFFC7CBE0, acc, 0.4), 205), f), fmtL)
    GroupLine(x + 9 + MeasureW(label, HL.fXs) + 10, x + w, y + 7, acc, f, now)
}
; ---- behaviour tile glyphs ----
; The same three drawings the rows used, re-centred on a point so they can sit
; in a tile instead of a row's icon column. `on` is the eased switch state, so
; each one animates between its two readings rather than snapping.
SetTileIcon(i, cx, cy, on, acc, f, now) {
    if (i = 1) {
        ; performance: three bars that flatten as the switch engages
        b := SBrush(FA(Alpha(on > 0.5 ? C_ON : acc, Round(150 + 80*on)), f))
        loop 3 {
            k := A_Index
            bh := (3 + k*3.4)*(1 - on) + 3
            FillRR(cx - 8 + (k - 1)*5.4, cy + 6 - bh, 3.4, bh, 1.6, b)
        }
        DelB(b)
    } else if (i = 2) {
        ; on top: two stacked frames, the front one lifting clear while armed
        pn := Pen(FA(Alpha(acc, Round(80 + 50*on)), f), 1.3)
        StrokeRR(cx + 1, cy - 2, 13, 11, 2.2, pn), DelP(pn)
        fy := cy - 8 - 2.5*on
        pn := Pen(FA(Alpha(on > 0.5 ? C_ON : acc, Round(150 + 80*on)), f), 1.4)
        StrokeRR(cx - 4, fy, 13, 11, 2.2, pn)
        Line(cx - 4, fy + 3.4, cx + 9, fy + 3.4, pn), DelP(pn)
    } else if (i = 3) {
        ; minimize: an arrow dropping into a tray, which fills as it lands
        pn := Pen(FA(Alpha(on > 0.5 ? C_ON : acc, Round(150 + 80*on)), f), 1.5)
        ay := cy - 8 + 4*on
        Line(cx, ay, cx, ay + 8, pn)
        Line(cx - 3.5, ay + 4.5, cx, ay + 8, pn)
        Line(cx + 3.5, ay + 4.5, cx, ay + 8, pn)
        Line(cx - 8, cy + 2, cx - 8, cy + 7, pn)
        Line(cx - 8, cy + 7, cx + 8, cy + 7, pn)
        Line(cx + 8, cy + 7, cx + 8, cy + 2, pn), DelP(pn)
        if (on > 0.02) {
            b := SBrush(FA(Alpha(C_ON, Round(150*on)), f))
            FillRR(cx - 7, cy + 7 - 3.4*on, 14, 3.4*on, 1.2, b), DelB(b)
        }
    } else {
        ; auto update: a circular arrow that closes its loop as the switch
        ; engages, and a dot that lands in the middle once it has
        col4 := on > 0.5 ? C_ON : acc
        pn := Pen(FA(Alpha(col4, Round(150 + 80*on)), f), 1.5)
        sw4 := 215 + 100*on
        Arc(cx - 8, cy - 8, 16, 16, -60, sw4, pn)
        ae := (-60 + sw4)*0.0174533
        ex := cx + 8*Cos(ae), ey := cy + 8*Sin(ae)
        tx4 := -Sin(ae), ty4 := Cos(ae)                ; the arc's direction of travel at its tip
        Line(ex, ey, ex - 4.2*tx4 + 2.6*Cos(ae), ey - 4.2*ty4 + 2.6*Sin(ae), pn)
        Line(ex, ey, ex - 4.2*tx4 - 2.6*Cos(ae), ey - 4.2*ty4 - 2.6*Sin(ae), pn), DelP(pn)
        if (on > 0.02) {
            b := SBrush(FA(Alpha(C_ON, Round(170*on)), f))
            FillEll(cx - 2.4*on, cy - 2.4*on, 4.8*on, 4.8*on, b), DelB(b)
        }
    }
}
HubMinPress() {
    if hubTrueMin
        HubHide()
    else
        HubMin(1.0)
}
; ---- system tray ----
; Not optional decoration once TRUE MINIMISE exists: it is the only route back
; to a hidden window, so it is set up unconditionally and stays whatever the
; setting is. ClickCount 1 makes the default item fire on a SINGLE click rather
; than the usual double, which is what every other tray application does and
; therefore the first thing anybody tries.
; ---- the tray icon ----
; The tray entry was AutoHotkey's default green H, which is not a YURI icon -
; it is the icon of every AHK script on the machine at once. With more than one
; running there is no way to tell which entry is the hub short of hovering each
; of them, and the tooltip was the only thing that had ever been set.
;
; Drawn rather than shipped, because the suite is one file and has nowhere to
; keep a binary. It is written once per accent to YURI\config and handed to
; TraySetIcon by path: TraySetIcon takes an icon FILE, and going through a file
; also means a compiled build and any shortcut pointing at it pick the mark up
; for free.
;
; The mark: the accent as a filled rounded square with the Y knocked out of it
; in the panel's own near-black. Contrast that heavy is the only thing that
; survives being scaled to sixteen pixels - a thin glyph on a dark plate turns
; to mush at that size, which is the size that actually matters here.
global TRAY_ICO := ""            ; path of the icon currently applied
global trayIcoAcc := 0           ; the accent it was drawn for

; Keyed on the accent, so a launch that has not changed it does no drawing and
; no writing at all - and the file being rewritten is never the file currently
; loaded as the icon.
TrayIcoPath() => YURI_CFG "\tray_" Format("{:06X}", hubAccent & 0xFFFFFF) ".ico"

TrayIcoBuild(force := false) {
    global TRAY_ICO, trayIcoAcc
    p := TrayIcoPath()
    if (!force && FileExist(p)) {
        trayIcoAcc := hubAccent, TRAY_ICO := p
        return p
    }
    SZ := 256
    if (DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SZ, "int", SZ
              , "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &bmp := 0) || !bmp)
        return ""
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", bmp, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", g2, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", g2, "int", 2)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", 4)

    ; the plate. A little inset so the corners are not clipped by whatever the
    ; shell composites it over, and rounded hard enough to read as a badge.
    m := 12, r := 56, w := SZ - m*2
    pth := 0
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &pth)
    DllCall("gdiplus\GdipAddPathArc", "ptr", pth, "float", m, "float", m, "float", r*2, "float", r*2, "float", 180, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", pth, "float", m + w - r*2, "float", m, "float", r*2, "float", r*2, "float", 270, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", pth, "float", m + w - r*2, "float", m + w - r*2, "float", r*2, "float", r*2, "float", 0, "float", 90)
    DllCall("gdiplus\GdipAddPathArc", "ptr", pth, "float", m, "float", m + w - r*2, "float", r*2, "float", r*2, "float", 90, "float", 90)
    DllCall("gdiplus\GdipClosePathFigure", "ptr", pth)

    ; vertical accent gradient, lighter at the top so the badge has a light
    ; source rather than reading as a flat sticker
    rc := Buffer(16)
    NumPut("float", m - 1, "float", m - 1, "float", w + 2, "float", w + 2, rc)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc
          , "uint", 0xFF000000 | (AccHi(hubAccent, 0.30) & 0xFFFFFF)
          , "uint", 0xFF000000 | (hubAccent & 0xFFFFFF)
          , "int", 1, "int", 3, "ptr*", &gb := 0)
    DllCall("gdiplus\GdipFillPath", "ptr", g2, "ptr", gb, "ptr", pth)
    DllCall("gdiplus\GdipDeleteBrush", "ptr", gb)
    ; a bright rim, the same lift every card here has - it keeps the badge from
    ; disappearing into a light taskbar
    DllCall("gdiplus\GdipCreatePen1", "uint", 0x40FFFFFF, "float", 5, "int", 2, "ptr*", &pn := 0)
    DllCall("gdiplus\GdipDrawPath", "ptr", g2, "ptr", pn, "ptr", pth)
    DllCall("gdiplus\GdipDeletePen", "ptr", pn)
    DllCall("gdiplus\GdipDeletePath", "ptr", pth)

    ; the Y, knocked out in the panel's own near-black
    hFont := 0
    DllCall("gdiplus\GdipCreateFontFamilyFromName", "wstr", "Segoe UI", "ptr", 0, "ptr*", &fam := 0)
    if !fam
        DllCall("gdiplus\GdipGetGenericFontFamilySansSerif", "ptr*", &fam)
    DllCall("gdiplus\GdipCreateFont", "ptr", fam, "float", 150, "int", 1, "int", 2, "ptr*", &hFont)
    DllCall("gdiplus\GdipCreateStringFormat", "int", 0, "int", 0, "ptr*", &fmt := 0)
    DllCall("gdiplus\GdipSetStringFormatAlign", "ptr", fmt, "int", 1)        ; centre
    DllCall("gdiplus\GdipSetStringFormatLineAlign", "ptr", fmt, "int", 1)
    DllCall("gdiplus\GdipCreateSolidFill", "uint", 0xFF12141F, "ptr*", &br := 0)
    lay := Buffer(16)
    NumPut("float", 0, "float", 4, "float", SZ, "float", SZ, lay)   ; nudged for optical centre
    DllCall("gdiplus\GdipDrawString", "ptr", g2, "wstr", "Y", "int", -1
          , "ptr", hFont, "ptr", lay, "ptr", fmt, "ptr", br)
    DllCall("gdiplus\GdipDeleteBrush", "ptr", br)
    DllCall("gdiplus\GdipDeleteStringFormat", "ptr", fmt)
    DllCall("gdiplus\GdipDeleteFont", "ptr", hFont)
    DllCall("gdiplus\GdipDeleteFontFamily", "ptr", fam)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g2)

    ok := TrayIcoWrite(bmp, p)
    DllCall("gdiplus\GdipDisposeImage", "ptr", bmp)
    if !ok
        return ""
    trayIcoAcc := hubAccent, TRAY_ICO := p
    return p
}

; A GDI+ bitmap into a single-entry PNG .ico. Same container RSetIcoWrite builds
; for the Roblox shortcuts, but from a bitmap already in memory rather than from
; a file on disk.
TrayIcoWrite(bmp, outPath) {
    tmp := A_Temp "\yuri_tray_src.png"
    try FileDelete(tmp)
    SaveAvatarPng(bmp, tmp)
    if !FileExist(tmp)
        return 0
    png := 0
    try png := FileRead(tmp, "RAW")
    try FileDelete(tmp)
    if (!IsObject(png) || !png.Size)
        return 0
    ico := Buffer(22 + png.Size, 0)
    NumPut("ushort", 0, ico, 0)                  ; reserved
    NumPut("ushort", 1, ico, 2)                  ; type 1 = icon
    NumPut("ushort", 1, ico, 4)                  ; one image
    ; width/height of 0 is how an .ico says 256 - it is a single byte field
    NumPut("uchar", 0, ico, 6), NumPut("uchar", 0, ico, 7)
    NumPut("uchar", 0, ico, 8), NumPut("uchar", 0, ico, 9)
    NumPut("ushort", 1,  ico, 10)                ; colour planes
    NumPut("ushort", 32, ico, 12)                ; bits per pixel
    NumPut("uint", png.Size, ico, 14)            ; bytes of image data
    NumPut("uint", 22, ico, 18)                  ; offset to it
    DllCall("RtlMoveMemory", "ptr", ico.Ptr + 22, "ptr", png.Ptr, "uptr", png.Size)
    try FileDelete(outPath)
    try {
        f := FileOpen(outPath, "w")
        f.RawWrite(ico, ico.Size)
        f.Close()
    }
    return FileExist(outPath) ? 1 : 0
}

; Freeze is on: without it AHK swaps the icon for its own pause and suspend
; marks, which would put the green H back the first time either happened.
TrayIcoApply(force := false) {
    p := TrayIcoBuild(force)
    if (p != "")
        try TraySetIcon(p, 1, true)
}

TrayInit() {
    A_IconTip := APPNAME
    TrayIcoApply()                               ; the hub's own mark, not AHK's
    try A_TrayMenu.Delete()                      ; drop AHK's own default items
    A_TrayMenu.Add("Open " APPNAME, TrayOpen)
    A_TrayMenu.Add("Hide to tray", TrayHide)
    A_TrayMenu.Add()
    A_TrayMenu.Add("Exit " APPNAME, TrayExit)
    A_TrayMenu.Default := "Open " APPNAME
    try A_TrayMenu.ClickCount := 1
}
TrayOpen(*) {
    if (!hubLive || !IsObject(HL))
        return
    ; Three states to come back from and the icon has to handle all of them:
    ; hidden, collapsed to the pill, or already open and simply buried under
    ; something else. The last is why this is not gated on hubHidden.
    if hubHidden
        HubShow()
    else if (HL.minT >= 0.5 || HL.minTo = 1.0) {
        HubMin(0.0)
        HubRaise()
    } else {
        HL.pokeAt := A_TickCount
        HubRaise()
        HubPoke()
    }
}
TrayHide(*) {
    if (!hubLive || !IsObject(HL) || hubHidden)
        return
    ; Hides outright even when TRUE MINIMISE is off. The menu item says "hide to
    ; tray"; collapsing to a pill on screen instead would not be that.
    HubHide()
}
TrayExit(*) {
    ExitApp
}
HubMin(target) {
    HL.minFrom := HL.minT, HL.minTo := target, HL.minStart := A_TickCount
    HL.minDur := target ? 430 : 480
    HL.burstAt := target ? HL.minStart + Round(HL.minDur*0.72) : 0
    HL.scatAt := target ? 0 : HL.minStart
    if target {
        if SH.focus
            ScrBlur()
        FFMBlur()
    }
    HubPoke()
}
HubAccentSet(i) {
    global hubAccent, hubAccPrev
    if hubAccent = ACCENTS[i]
        return
    hubAccPrev := hubAccent
    hubAccent := ACCENTS[i]
    try IniWrite(Format("0x{:08X}", hubAccent), iniPath, "hub", "accent")
    TrayIcoApply(true)                  ; the mark IS the accent - redraw it
    HL.accFlashAt := A_TickCount
    if abOn
        RendTim(TICK_A)
    HubPoke()
}
HubArmTintSet(v) {
    global hubArmTint
    hubArmTint := v ? 1 : 0
    try IniWrite(hubArmTint, iniPath, "hub", "armtint")
    HL.tintAt := A_TickCount
    HubPoke()
}
HubLowPerfSet(v) {
    global hubLowPerf
    hubLowPerf := v ? 1 : 0
    try IniWrite(hubLowPerf, iniPath, "hub", "lowperf")
    HL.lpAt := A_TickCount
    ; the caches hold surfaces built under the OLD setting, so drop them
    ShadowFlush()
    HubPoke()
}
; Applied to the LIVE windows as well as written to disk. A window keeps the
; extended style it was created with, so flipping the flag alone would only
; take effect on the next launch - which reads as a switch that does nothing.
; Both persistent windows and whichever modal is up are moved together; leaving
; one behind is how you end up with a gallery floating over a hub that is not.
HubTopSet(v) {
    global hubTop
    hubTop := v ? 1 : 0
    try IniWrite(hubTop, iniPath, "hub", "ontop")
    z := HubTopZ()
    if (hubLive && IsObject(HL))
        try DllCall("SetWindowPos", "ptr", HL.gui.Hwnd, "ptr", z
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    if IsObject(ui)
        try DllCall("SetWindowPos", "ptr", ui.Hwnd, "ptr", z
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    if (cropUIOn && cropHwnd)
        try DllCall("SetWindowPos", "ptr", cropHwnd, "ptr", z
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    if (galOpen && galHwnd)
        try DllCall("SetWindowPos", "ptr", galHwnd, "ptr", z
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    ; the PUZZLE AI card is a persistent window while the module is armed, so it
    ; belongs in the same sweep - left out, it stayed topmost over a hub that was
    ; not, which is the exact defect the comment above this function describes
    if (IsSet(PZO) && PZO.gui != "")
        try DllCall("SetWindowPos", "ptr", PZO.gui.Hwnd, "ptr", z
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    ; guarded, unlike the two setters above it: HL is the integer 0 until the
    ; hub is first opened, and this can be reached from a hotkey later
    if IsObject(HL)
        HL.topAt := A_TickCount
    HubPoke()
}
HubTrueMinSet(v) {
    global hubTrueMin
    hubTrueMin := v ? 1 : 0
    try IniWrite(hubTrueMin, iniPath, "hub", "truemin")
    ; Turning it on while the pill is showing applies it there and then. Leaving
    ; a pill on screen under a setting that says there is not one is the setting
    ; appearing not to work.
    if (hubTrueMin && hubLive && IsObject(HL) && (HL.minT >= 0.5 || HL.minTo = 1.0)) {
        HubHide()
        return
    }
    if IsObject(HL)
        HL.tmAt := A_TickCount
    HubPoke()
}
; AUTO UPDATE. Nothing to apply live: the check runs when the hub opens, so
; the setting is read at the next launch, and the tile's caption says so. The
; ring pulse is the acknowledgement.
HubAutoUpdSet(v) {
    global hubAutoUpd
    hubAutoUpd := v ? 1 : 0
    try IniWrite(hubAutoUpd, iniPath, "hub", "autoupdate")
    if IsObject(HL)
        HL.auAt := A_TickCount
    HubPoke()
}
HubResetDesign() {
    HubArmTintSet(1)
    global bgOpacity, hubOpacity
    HubAccentSet(1)
    bgOpacity := 1.0, hubOpacity := 1.0
    try IniWrite(1.0, iniPath, "hub", "opacity")
    try IniWrite(1.0, iniPath, "hub", "bg")
