    keep := !(t.lines.Length = 1 && t.lines[1] = "" && t.name = "")
    if keep {
        ScrTabLoad(SH.cur)
        if !ScrTabAdd() {
            SH.ceIdx := i
            it := SHList[i]
            b2 := ""
            try b2 := FileRead(it.file, "UTF-8")
            ScrSetText(body != "" ? body : b2)
            SH.name := nm, SH.desc := ds
            ScrWarn("tab limit reached - SAVE or CANCEL here, or close a tab first")
            HubPoke()
            return
        }
        ScrSetText(body)
        SH.name := nm, SH.desc := ds
    }
    SH.editIdx := i, SH.dirty := 1, SH.flashAt := A_TickCount
    ScrFocus(1)
    HubPoke()
}
ScrSelGet(&l1, &c1, &l2, &c2) {
    if !SH.selOn || (SH.sl = SH.cl && SH.sc = SH.cc)
        return 0
    if SH.sl < SH.cl || (SH.sl = SH.cl && SH.sc < SH.cc)
        l1 := SH.sl, c1 := SH.sc, l2 := SH.cl, c2 := SH.cc
    else
        l1 := SH.cl, c1 := SH.cc, l2 := SH.sl, c2 := SH.sc
    return 1
}
ScrCheck(silent := 0) {
    global SH
    body := ScrText()
    ; An empty editor is not a passing script. The validator was being handed a
    ; zero-byte file, which of course parses clean, so CHECK reported success on
    ; nothing at all. Both other callers guard this before they reach here, so
    ; the warning is only ever raised by the CHECK button itself.
    if (Trim(body) = "") {
        SH.outOk := -1, SH.outVer := "", SH.chkVer := "", SH.outMsg := ""
        SH.outAt := A_TickCount
        if !silent {
            ScrWarn("nothing to check - write or paste a script first")
            HubPoke()
        }
        return 0
    }
    e2 := AhkV2Exe(), e1 := AhkV1Exe()
    if e2 = "" && e1 = "" {
        SH.outOk := 0, SH.outVer := "", SH.outMsg := "AutoHotkey not found - cannot validate", SH.outAt := A_TickCount
        HubPoke()
        return 0
    }
    if !DirExist(ScrDir())
        try DirCreate(ScrDir())
    tmp := ScrDir() "\_check.ahk", outF := ScrDir() "\_check.txt"
    try FileDelete(tmp)
    try FileAppend(body, tmp, "UTF-8")
    req := ScrGuessVer(body)
    order := req = "1" ? [["1", e1]] : req = "2" ? [["2", e2]] : [["2", e2], ["1", e1]]
    ok := 0, usedV := "", firstErr := "", firstV := ""
    for pr in order {
        if pr[2] = ""
            continue
        if pr[1] = "1" && !AhkV1CanValidate() {
            ok := 1, usedV := "1"
            SH.outMsg := (firstErr != "")
                ? "v2 rejected it - will run under AutoHotkey v1 (not pre-validated)"
                : "detected as AutoHotkey v1 - will run under v1 (v1 has no validate switch)"
            break
        }
        try FileDelete(outF)
        rc := 1
        try rc := RunWait(A_ComSpec ' /c ""' pr[2] '" /ErrorStdOut /validate "' tmp '" > "' outF '" 2>&1"', , "Hide")
        r := ""
        try r := FileRead(outF, "UTF-8")
        if rc = 0 {
            ok := 1, usedV := pr[1]
            SH.outMsg := "no errors - parses clean as AutoHotkey v" usedV
            break
        }
        if firstErr = ""
            firstErr := r, firstV := pr[1]
    }
    try FileDelete(tmp)
    try FileDelete(outF)
    if ok
        SH.outOk := 1, SH.outVer := usedV, SH.chkVer := usedV
    else {
        SH.outOk := 0, SH.outVer := firstV, SH.chkVer := ""
        SH.outMsg := firstErr = "" ? ("AutoHotkey v" (req != "" ? req : "?") " not found - install it to validate, the script itself was not checked") : ScrErrPretty(firstErr, firstV)
    }
    SH.outAt := A_TickCount
    if !silent
        HubPoke()
    return ok
}
ScrWarn(msg) {
    global SH
    SH.expOpen := 0
    if SH.warnAt && A_TickCount - SH.warnAt < 2340
        SH.warnAt := A_TickCount - 220
    else
        SH.warnAt := A_TickCount
    SH.warnMsg := msg
    HubPoke()
}
; how many cards actually fit between the list top and the hub floor
ScrCardsVis() {
    avail := (HL.pd + HL.ch - 22) - HL.lsy
    return Max(1, Floor((avail + 6)/(HL.lsh + 6)))
}
ScrListDrag(sy) {
    if (SH.lsMax <= 0)
        return
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    vis := ScrCardsVis()*(HL.lsh + 6) - 6
    th := Max(26, vis*(vis/(vis + SH.lsMax)))
    span := Max(1, vis - th)
    grip := ScrGrip(uy, HL.lsy, span, th, SH.lsMax > 0 ? SH.lsSc/SH.lsMax : -1)
    f2 := Clamp((uy - HL.lsy - grip)/span, 0.0, 1.0)
    SH.lsScT := f2*SH.lsMax
    SH.lsSc := SH.lsScT
    HubPoke()
}
ScrListW() => HL.ctw - (SH.lsMax > 0 ? 14 : 0)
; editor box currently on screen: inline card editor or the main one
ScrEdY() => SH.ceIdx ? HL.ceY : HL.edy + ScrShiftAll()
ScrEdH() => SH.ceIdx ? HL.ceH : HL.edh
ScrEdVis() => Max(1, Floor((ScrEdH() - 16)/15))
ScrEdTxtW() => HL.ctw - 52

ScrEdVDrag(sy) {
    vs := ScrEdVis()
    if (SH.lines.Length <= vs)
        return
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    edY := ScrEdY(), edH := ScrEdH()
    trk := edH - 16
    th := Max(20, trk*vs/SH.lines.Length)
    span := Max(1, trk - th)
    grip := ScrGrip(uy, edY + 8, span, th
        , (SH.lines.Length > vs) ? (SH.top - 1)/(SH.lines.Length - vs) : -1)
    fr := Clamp((uy - (edY + 8) - grip)/span, 0.0, 1.0)
    SH.top := Clamp(1 + Round(fr*(SH.lines.Length - vs)), 1, Max(1, SH.lines.Length - vs + 1))
    HubPoke()
}

ScrEdHDrag(sx) {
    if (SH.hscMax <= 0)
        return
    k := HL.pw/HL.bw
    ux := (sx - HL.px)/k
    htk := HL.ctw - 56
    hbw := Max(28, htk*(ScrEdTxtW()/(ScrEdTxtW() + SH.hscMax)))
    span := Max(1, htk - hbw)
    grip := ScrGrip(ux, HL.ctx + 42, span, hbw, SH.hscMax > 0 ? SH.hsc/SH.hscMax : -1)
    fr := Clamp((ux - (HL.ctx + 42) - grip)/span, 0.0, 1.0)
    SH.hscT := fr*SH.hscMax
    SH.hsc := SH.hscT
    HubPoke()
}
ScrFootH() => 46
ScrPitch() => HL.lsh + 6
ScrRowsH() => (SHList.Length ? SHList.Length : 1)*(HL.lsh + 6)
ScrCardMax() => Max(0.0, ScrRowsH() + ScrFootH() - ScrCardsVis()*(HL.lsh + 6) + 0.0)
ScrShiftAll() => ScrShift() + 26*HL.expT
ScrShift() {
    if !SH.warnAt
        return 0.0
    t := A_TickCount - SH.warnAt
    if t >= 2600
        return 0.0
    if t < 220
        return 34*Ease3(t/220.0)
    if t > 2340
        return 34*(1 - Ease3((t - 2340)/260.0))
    return 34.0
}
ScrSelLen() {
    if !ScrSelGet(&l1, &c1, &l2, &c2)
        return 0
    if l1 = l2
        return c2 - c1
    n := StrLen(SH.lines[l1]) - c1 + c2 + (l2 - l1)
    loop l2 - l1 - 1
        n += StrLen(SH.lines[l1 + A_Index])
    return n
}
ScrSelText() {
    if !ScrSelGet(&l1, &c1, &l2, &c2)
        return ""
    if l1 = l2
        return SubStr(SH.lines[l1], c1 + 1, c2 - c1)
    s := SubStr(SH.lines[l1], c1 + 1)
    loop l2 - l1 - 1
        s .= "`n" . SH.lines[l1 + A_Index]
    return s . "`n" . SubStr(SH.lines[l2], 1, c2)
}
ScrDelSel() {
    if !ScrSelGet(&l1, &c1, &l2, &c2)
        return 0
    SH.lines[l1] := SubStr(SH.lines[l1], 1, c1) . SubStr(SH.lines[l2], c2 + 1)
    loop l2 - l1
        SH.lines.RemoveAt(l1 + 1)
    SH.cl := l1, SH.cc := c1
    SH.selOn := 0, SH.sl := l1, SH.sc := c1
    SH.dirty := 1
    return 1
}
ScrCaretFromMouse(sx, sy) {
    k := HL.pw/HL.bw
    ux := (sx - HL.px)/k, uy := (sy - HL.py)/k
    edB := SH.ceIdx ? HL.ceY : HL.edy + ScrShiftAll()
    li := SH.top + Floor((uy - (edB + 8))/15)
    li := Clamp(li, 1, SH.lines.Length)
    co := Round((ux - (HL.ctx + 42 - SH.hsc))/HL.chW)
    SH.cl := li, SH.cc := Clamp(co, 0, StrLen(SH.lines[li]))
    SH.caretAt := A_TickCount
}
ScrIsKw(w) {
    static kw := Map()
    if !kw.Count
        for k in ["if", "else", "loop", "while", "for", "return", "break", "continue"
            , "global", "local", "static", "try", "catch", "finally", "throw", "class"
            , "until", "switch", "case", "default", "goto", "and", "or", "not", "in", "is"
            , "true", "false", "unset", "super", "this", "new", "extends"]
            kw[k] := 1
    return kw.Has(StrLower(w))
}
ScrRetok() {
    global SH
    SH.toks := []
    az := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    dg := "0123456789"
    hx := "0123456789ABCDEFabcdefxX."
    for line in SH.lines {
        toks := [], n := StrLen(line), i := 1
        while i <= n {
            c := SubStr(line, i, 1)
            if c = ";" && (i = 1 || SubStr(line, i - 1, 1) = " " || SubStr(line, i - 1, 1) = "`t") {
                toks.Push({t: 4, s: SubStr(line, i), c: i - 1})
                break
            }
            if c = '"' || c = "'" {
                j := i + 1
                while j <= n && SubStr(line, j, 1) != c
                    j += 1
                toks.Push({t: 3, s: SubStr(line, i, j - i + 1), c: i - 1})
                i := j + 1
                continue
            }
            if InStr(az, c, true) {
                j := i
                while j <= n && (InStr(az, SubStr(line, j, 1), true) || InStr(dg, SubStr(line, j, 1)))
                    j += 1
                w := SubStr(line, i, j - i)
                toks.Push({t: ScrIsKw(w) ? 1 : (SubStr(line, j, 1) = "(" ? 5 : 0), s: w, c: i - 1})
                i := j
                continue
            }
            if InStr(dg, c) {
                j := i
                while j <= n && InStr(hx, SubStr(line, j, 1), true)
                    j += 1
                toks.Push({t: 2, s: SubStr(line, i, j - i), c: i - 1})
                i := j
                continue
            }
            j := i
            while j <= n {
                cc := SubStr(line, j, 1)
                if cc = ";" || cc = '"' || cc = "'" || InStr(az, cc, true) || InStr(dg, cc)
                    break
                j += 1
            }
            toks.Push({t: 0, s: SubStr(line, i, j - i), c: i - 1})
            i := j
        }
        SH.toks.Push(toks)
    }
    SH.dirty := 0
}

; ================= password gate =================
; ---- the launch gate ----
; The password gate's card - the hero, the reel, the grip, the clock, the
; standby readout - with the well and everything that fed it taken out and
; two buttons in its place: OPEN ROBLOX, which starts the client and then the
; hub, and OPEN HUB, which starts the hub alone. It shows after the loading
; screen, so by the time it is up there is nothing left to wait for. No
; InputHook: nothing is typed, and Enter / Escape arrive as WM_KEYDOWN because
; the card is an active window. Returns once the card has left; the choice is
; in gateChoice.
LaunchGate() {
    global G, gateChoice
    gateChoice := ""
    gPressAt := 0, gPressZ := 0           ; which button was pressed, and when - the ring and the fade read them
    gMvX := 0, gMvY := 0, gMvAt := 0       ; the last drag sample, for the jump check in GMove
    gRbx := 0, gRbxAt := 0                ; 2 = client running, 1 = installed, 0 = not found; polled by GRender
    gSets := 0
    for ent in FFM_COMM
        gSets += ent.sets.Length

    CW2 := 560, CH2 := 312, PD := 26
    BW2 := CW2 + PD*2, BH2 := CH2 + PD*2
    GWp := Round(BW2*scaleF), GHp := Round(BH2*scaleF)
    cx := PD, cy := PD
    bcxU := PD + CW2 - 24, btyU := PD + 22
    ; hero gallery panel (left, inset clear of the card border)
    hpx := cx + 24, hpy := cy + 24, hpw := 170, hph := CH2 - 48
    ; right column origin
    rx := cx + 208
    ; the two buttons, in the band the password well used to fill
    fx := rx, fy := cy + 144, fw := CW2 - 208 - 26, fh := 40
    fy2 := fy + fh + 8, fh2 := 34         ; the second row: OPEN HUB and ACCOUNTS, side by side
    bw1 := (fw - 10)/2                    ; each of the two; 10 between them
    ; thumbnail carousel strip (bottom of right column)
    thR := 12, thGap := 30, thY := cy + CH2 - 34, thX0 := rx + thR
    ; The rotation, not the whole pool: pictures the user took out of the
    ; gallery are still loaded and still offered as profile pictures, they just
    ; sit past GalHi() and the hero never reaches them.
    gBase := GalHasRot() ? gateBase : 0     ; fall back to the full pool if nothing else exists
    gN := GalHasRot() ? galRotN : Max(1, SelDispN())
    thShow := Min(gN, 8)
    maxDots := 11
    SCRSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&"

    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", GWp, bi, 4), NumPut("int", -GHp, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    hbm2 := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0, "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    hdc2 := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", hdc2, "ptr", hbm2, "ptr")
    mainG := G
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", hdc2, "ptr*", &G2 := 0)
    G := G2
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", G, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", G, "int", 2)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G, "float", GWp/BW2, "float", GHp/BH2, "int", 0)
    fGateT := NewFont(22, 1)         ; big LOCKED / GRANTED
    fGateS := NewFont(9, 1)          ; hero name line / counter
    fGateC := NewFont(7.5, 1)        ; hero caption micro-line
    scrReady := BuildScr("READY", fGateT)
    scrRbx := BuildScr("LAUNCHING", fGateT), scrHub := BuildScr("OPENING", fGateT)

    ; ---- a window that can hold the keyboard ----
    ; Not WS_EX_NOACTIVATE like the overlays: the gate is the thing on screen,
    ; it takes real focus (WinActivate below), and Enter and Escape reach it as
    ; ordinary key messages. There is no hook and nothing to type.
    gw := Gui("-Caption +E0x80000 +AlwaysOnTop +ToolWindow -DPIScale", "YURIGATE")
    ; an active window can be Alt+F4'd. A Gui's default answer to that is to
    ; hide itself, which would leave the wait loop below spinning on a card
    ; nobody can see - so it closes the gate the way Escape does
    gw.OnEvent("Close", GCloseEv)
    gw.Show("NA x0 y0 w" GWp " h" GHp)
    try WinActivate("ahk_id " gw.Hwnd)
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    gbx := mL + ((mR - mL) - GWp)//2
    gby := mT + ((mB - mT) - GHp)//2
    gpx := gbx, gpy := gby

    gIntro := A_TickCount
    gOkAt := 0, gCloseAt := 0, gDenyAt := 0, gShakeAt := 0, gKeyAt := 0
    gPrevLen := 0, gDone := 0, gDrag := 0, gh2 := 0.0, ghE := 0.0, gbE := 0.0, gaE := 0.0
    gHovAv := 0.0
    grX := 0, grY := 0, grBX := 0, grBY := 0
    gLBPrev := 0
    gDragT := 0.0, gTilt := 0.0, gPrevGBX := gbx
    gHndE := 0.0
    ; NOTE: selCur/selNext/selFadeAt are LOCAL here. PasswordGate assigns them
    ; without a global declaration, and AHK v2 makes a name local throughout a
    ; function if it is assigned anywhere in it - so the gate carousel shadows
    ; the display-picture globals rather than overwriting them. Do not read
    ; these before this line, and do not add a global declaration without
    ; rewriting the carousel: it would start clobbering the profile picture.
    ; ---- starts at the FIRST rotation entry ----
    ; It used to start on the last, on the reasoning that somebody who has just
    ; added a photo wants to see it. That case is real, but it belongs to the
    ; gallery manager - which reseeds to the new picture when one is added, and
    ; still does. Every OTHER open is an ordinary one, and an ordinary open
    ; reading "5 / 5" looks like a rotation that has already finished.
    selCur := gBase + 1, selNext := selCur, selFadeAt := 0, selCycleAt := A_TickCount
    selQ := 0
    ringW := Map()

    OnMessage(0x84, GHT), OnMessage(0x201, GClick), OnMessage(0x202, GUp)
    OnMessage(0x200, GMove), OnMessage(0x20, GCur), OnMessage(0x100, GKeyDown)
    OnMessage(0x215, GCapLost)
    SetTimer(GRender, TICK_A)
    while !gDone
        Sleep 25
    return

    GZone(sx, sy) {
        k := GWp/BW2
        ux := (sx - gpx)/k, uy := (sy - gpy)/k
        if (ux - bcxU)**2 + (uy - btyU)**2 <= 81
            return 2
        if (!gOkAt && !gCloseAt) {
            if (uy >= fy && uy <= fy + fh && ux >= fx && ux <= fx + fw)
                return 7                            ; OPEN ROBLOX, the whole first row
            if (uy >= fy2 && uy <= fy2 + fh2) {
                if (ux >= fx && ux <= fx + bw1)
                    return 3                        ; OPEN HUB
                if (ux >= fx + bw1 + 10 && ux <= fx + fw)
                    return 8                        ; ACCOUNTS
            }
        }
        if gN > 1 {
            loop thShow {
                txc := thX0 + (A_Index - 1)*thGap
                if (ux - txc)**2 + (uy - thY)**2 <= (thR + 2)**2
                    return 9 + A_Index
            }
        }
        if gN > 1 && ux >= hpx && ux <= hpx + hpw && uy >= hpy && uy <= hpy + hph
            return 6
        if ux >= rx + 62 && ux <= rx + 98 && uy >= cy + 10 && uy <= cy + 34
            return 5
        if ux >= cx && ux <= cx + CW2 && uy >= cy && uy <= cy + CH2
            return 4
        return 0
    }
    GZoneCursor() {
        CursorXY(&x, &y)
        return GZone(x, y)
    }
    GHT(wParam, lParam, msg, hwnd) {
        if hwnd != gw.Hwnd
            return
        LpXY(lParam, &x, &y)
        return GZone(x, y) ? 1 : -1
    }
    GClick(wParam, lParam, msg, hwnd) {
        global gateDrag
        if hwnd != gw.Hwnd
            return
        CursorXY(&x, &y)
        z := GZone(x, y)
        if z = 2
            GClose()
        else if z = 7
            GGo("roblox", 7)
        else if z = 3
            GGo("hub", 3)
        else if z = 8
            GGo("acct", 8)
        else if z = 6
            GSelSwitch(gBase + Mod(selCur - gBase, gN) + 1)   ; hero → next gate image
        else if z >= 10
            GSelSwitch(gBase + z - 9)               ; thumbnail → that gate image
        else if z = 5 {
            gDrag := 1, gateDrag := 1, grX := x, grY := y, grBX := gbx, grBY := gby
            gMvX := x, gMvY := y, gMvAt := A_TickCount
            DllCall("SetCapture", "ptr", gw.Hwnd)
        }
        return 0
    }
    ; ---- the choice ----
    ; Both buttons end the same way the right key used to: the card says what
    ; it is doing, celebrates for half a second and folds away, and the caller
    ; reads gateChoice. Nothing can be pressed twice - the zones close with
    ; gOkAt.
    GGo(which, z) {
        global gateChoice
        if gOkAt || gCloseAt || gDone
            return
        gateChoice := which
        gPressAt := A_TickCount, gPressZ := z
        gOkAt := A_TickCount
    }
    ; Enter is OPEN HUB - the quiet default - and Escape closes, as it always
    ; did. The card holds the focus, so these are plain key messages.
    GKeyDown(wParam, lParam, msg, hwnd) {
        if hwnd != gw.Hwnd
            return
        if (wParam = 13)
            GGo("hub", 3)
        else if (wParam = 27)
            GClose()
        return 0
    }
    ; ---- the card's button ----
    ; The hub gate card's button (HubGateBtnDraw), re-drawn here because that
    ; one reads the hub's hover map and click clock and this card has its own.
    ; primary = 1 is the accent-filled offer, 0 the ghost beside it.
    GBtn(z, bx, by, bw, bh, label, primary, hv, pr, a, now, acc, glyph := "") {
        lift := -2.0*hv + 2.4*pr
        st := PushXform(bx + bw/2, by + bh/2 + lift, 1 - 0.025*pr, 0)
        x0 := bx, y0 := by + lift
        brth := (Sin(DecT(now)*0.0021) + 1)/2
        if (pr > 0.01) {
            ; the ring the press throws off - outward and fading
            rp := 1 - pr
            gr := 6 + 26*Ease3(rp)
            pn := Pen(FA(Alpha(AccHi(acc, 0.45), Round(150*pr)), a), 1.6*pr + 0.4)
            StrokeRR(x0 - gr, y0 - gr, bw + gr*2, bh + gr*2, 10 + gr, pn), DelP(pn)
        }
        if primary {
            ; lit all the time, not only under the pointer: this is the offer
            SoftGlow(x0 + bw/2, y0 + bh/2, bw*0.72, bh*1.25, acc, Round((70 + 30*brth + 60*hv)*a), 1.0, 6)
            if (hv > 0.01) {
                b := SBrush(FA(Alpha(AccHi(acc, 0.4), Round(34*hv)), a))
                FillRR(x0 - 6, y0 - 5, bw + 12, bh + 10, 14, b), DelB(b)
            }
            ShadowDraw(x0, y0 + 2, bw, bh, 10, 4, 26, 14, a*(0.55 + 0.45*hv), 1.0)
            b := VBrush(x0, y0, bw, bh, FA(Alpha(AccHi(acc, 0.5), Round(198 + 40*hv)), a)
                                      , FA(Alpha(acc, Round(140 + 40*hv)), a))
            FillRR(x0, y0, bw, bh, 10, b), DelB(b)
            b := VBrush(x0 + 6, y0 + 1, bw - 12, bh*0.42, FA(Alpha(0xFFFFFF, Round(52 + 26*hv)), a)
                                                        , FA(Alpha(0xFFFFFF, 0), a))
            FillRR(x0 + 6, y0 + 1, bw - 12, bh*0.42, 8, b), DelB(b)
            ; a sheen crosses on its own every few seconds, and rides the
            ; pointer when there is one
            shp := (hv > 0.02 && hv < 0.995) ? hv : Mod(DecT(now), 3400)/3400.0
            shA := (hv > 0.02 && hv < 0.995) ? 46*Sin(hv*3.14159) : 26*Max(0.0, Sin(shp*3.14159))
            if (shA > 0.5) {
                sx2 := x0 - 30 + (bw + 60)*shp
                pth := RRPath(x0, y0, bw, bh, 10)
                stS := PushG()
                DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pth, "int", 1)
                b := HBrush(sx2 - 16, y0, 32, bh, FA(Alpha(0xFFFFFF, 0), a)
                                                , FA(Alpha(0xFFFFFF, Round(shA)), a))
                FillRR(sx2 - 16, y0, 32, bh, 0, b), DelB(b)
                Pop(stS)
                DllCall("gdiplus\GdipDeletePath", "ptr", pth)
            }
            pn := Pen(FA(Alpha(AccHi(acc, 0.6), Round(215 + 40*hv)), a), 1.3)
            StrokeRR(x0, y0, bw, bh, 10, pn), DelP(pn)
            tc := FA(0xFFFFFFFF, a)
            gc := FA(0xFFFFFFFF, a)
        } else {
            ; the ghost, lit: an accent-tinted body and a border that can be
            ; seen, so it reads as a second door and not a disabled one
            if (hv > 0.01) {
                b := SBrush(FA(Alpha(acc, Round(22*hv)), a))
                FillRR(x0 - 4, y0 - 3, bw + 8, bh + 6, 12, b), DelB(b)
            }
            b := VBrush(x0, y0, bw, bh, FA(Alpha(acc, Round(40 + 26*hv)), a)
                                      , FA(Alpha(acc, Round(16 + 14*hv)), a))
            FillRR(x0, y0, bw, bh, 10, b), DelB(b)
            b := VBrush(x0 + 6, y0 + 1, bw - 12, bh*0.4, FA(Alpha(0xFFFFFF, Round(16 + 14*hv)), a)
                                                       , FA(Alpha(0xFFFFFF, 0), a))
            FillRR(x0 + 6, y0 + 1, bw - 12, bh*0.4, 8, b), DelB(b)
            pn := Pen(FA(Alpha(AccHi(acc, 0.3), Round(150 + 90*hv)), a), 1.2)
            StrokeRR(x0, y0, bw, bh, 10, pn), DelP(pn)
            if (hv > 0.02) {
                uw := (bw - 24)*Ease3(hv)
                b := SBrush(FA(Alpha(AccHi(acc, 0.5), Round(200*hv)), a))
                FillRR(x0 + bw/2 - uw/2, y0 + bh - 4, uw, 2, 1, b), DelB(b)
            }
            tc := FA(Alpha(THMix(0xFFE8EAF6, 0xFFFFFFFF, hv), Round(225 + 30*hv)), a)
            gc := FA(Alpha(AccHi(acc, 0.55), Round(230 + 25*hv)), a)
        }
        ; ---- glyph and label, centred as one ----
        lw := MeasureW(label, fBadge)
        gw2 := (glyph != "") ? 20 : 0
        tx0 := x0 + (bw - lw - gw2)/2
        gcx := tx0 + 7, gcy := y0 + bh/2 - (0.6*hv - 0.8*pr)
        if (glyph = "dart") {
            ; the launch dart the dashboard's LAUNCH wears, in flight on hover
            HubDart(gcx + 1.5*hv, gcy, 6.2, gc)
        } else if (glyph = "acct") {
            ; two people: a head and shoulders, and a second behind - the
            ; account manager's own mark
            b := SBrush(gc)
            FillEll(gcx - 5.5, gcy - 6.5, 6, 6, b)
            FillRR(gcx - 8.5, gcy + 0.5, 12, 6, 3, b), DelB(b)
            pn := Pen(gc, 1.3)
            Ell(gcx + 2, gcy - 5.5, 5, 5, pn)
            Arc(gcx - 1, gcy + 0.5, 11, 9, 200, 140, pn), DelP(pn)
        } else if (glyph = "hub") {
            ; the hub: four cells, the top-left lit - the dashboard tile
            pn := Pen(gc, 1.5)
            loop 4 {
                k := A_Index - 1
                qx := gcx - 6 + Mod(k, 2)*7, qy := gcy - 6 + (k // 2)*7
                if (k = 0) {
                    b := SBrush(gc)
                    FillRR(qx, qy, 5, 5, 1.5, b), DelB(b)
                } else
                    StrokeRR(qx, qy, 5, 5, 1.5, pn)
            }
            DelP(pn)
        }
        TxtP(label, tx0 + gw2, y0 - 1 - (0.6*hv - 0.8*pr), lw + 6, bh, fBadge, tc, fmtL)
        Pop(st)
    }
    ; ---- a chip in the readout row ----
    ; value in the badge face, its label small beside it; returns the x it
    ; ended at so the row lays itself out
    GChip(x, y, val, label, col, a) {
        vs := String(val)
        vw2 := MeasureW(vs, fBadge), lw2 := MeasureW(label, fGateC)
        cw := 10 + vw2 + 6 + lw2 + 10
        b := VBrush(x, y, cw, 17, FA(Alpha(col, 46), a), FA(Alpha(col, 22), a))
        FillRR(x, y, cw, 17, 8.5, b), DelB(b)
        pn := Pen(FA(Alpha(col, 120), a), 1)
        StrokeRR(x, y, cw, 17, 8.5, pn), DelP(pn)
        Txt(vs, x + 10, y, vw2 + 4, 17, fBadge, FA(Alpha(AccHi(col, 0.35), 240), a), fmtL)
        Txt(label, x + 10 + vw2 + 6, y + 1, lw2 + 4, 16, fGateC, FA(Alpha(0xFFC7CBE0, 170), a), fmtL)
        return x + cw
    }
    GSelSwitch(idx) {
        selCycleAt := A_TickCount                   ; user touched it -> restart auto timer
        if selFadeAt {
            ; a fade is in flight. Snapping selCur to selNext here would jump the
            ; blend to 100% before the next fade starts, which is what made rapid
            ; clicks flicker. Reverse if they picked the outgoing image, otherwise
            ; queue the request and run it when this fade lands.
            if (idx = selNext)
                return
            if (idx = selCur) {
                e0 := Ease3(Clamp((A_TickCount - selFadeAt)/SEL_FADE, 0.0, 1.0))
                tmp := selCur, selCur := selNext, selNext := tmp
                selFadeAt := A_TickCount - Round(Ease3Inv(1 - e0)*SEL_FADE)
                selQ := 0
                return
            }
            selQ := idx
            return
        }
        if idx = selCur
            return
        selQ := 0
        selNext := idx, selFadeAt := A_TickCount
    }
    GUp(wParam, lParam, msg, hwnd) {
        global gateDrag
        if !gDrag
            return
        gDrag := 0, gateDrag := 0                   ; cleared first - see HubBtnUp
        DllCall("ReleaseCapture")
        return 0
    }
    GCapLost(wParam, lParam, msg, hwnd) {
        global gateDrag
        if (hwnd = gw.Hwnd && gDrag && lParam != gw.Hwnd)
            gDrag := 0, gateDrag := 0               ; the capture left: the drag is over where it stands
    }
    GMove(wParam, lParam, msg, hwnd) {
        global gateDrag
        if hwnd != gw.Hwnd || !gDrag
            return
        ; a drag whose button is up is over - see HubMove
        if (!GetKeyState("LButton", "P") && !GetKeyState("RButton", "P")) {
            gDrag := 0, gateDrag := 0
            DllCall("ReleaseCapture")
            return 0
        }
        if !CursorXY(&x, &y)
            return 0                                ; no read, no move - see CursorXY
        ; ---- a jump no mouse makes ----
        ; Between two consecutive move messages a pointer covers tens of
        ; pixels, a few hundred at most; only a stalled queue draining makes a
        ; large one, and a stall shows as a gap in time. A sample that would
        ; throw the window most of a screen with no gap before it is not the
        ; pointer - it is dropped and the anchor re-taken from the next one.
        now_ := A_TickCount
        if (gMvAt && Abs(x - gMvX) > 500 && now_ - gMvAt < 120) {
            gMvAt := 0
            grX := x, grY := y, grBX := gbx, grBY := gby
            return 0
        }
        gMvX := x, gMvY := y, gMvAt := now_
        gbx := grBX + (x - grX), gby := grBY + (y - grY)
        ; The handle rule - see HandleBounds. The gate has no collapsed state, so
        ; there is only the one handle (zone 5, the 6-dot grip). It is also the
        ; window it matters most on: park this one where its grip cannot be
        ; reached and there is no way into the suite at all.
        HandleBounds(rx + 62, cy + 10, rx + 98, cy + 34, GWp/BW2
                   , &lox, &hix, &loy, &hiy)
        gbx := Clamp(gbx, lox, hix), gby := Clamp(gby, loy, hiy)
        return 0
    }
    GCur(wParam, lParam, msg, hwnd) {
        if hwnd = gw.Hwnd {
            zc := gDrag ? 5 : GZoneCursor()
            id := (zc = 5) ? 32646 : (zc = 7) ? 32513 : (zc = 4) ? 32512 : 32649
            DllCall("SetCursor", "ptr", DllCall("LoadCursor", "ptr", 0, "ptr", id, "ptr"))
            return 1
        }
    }
    GClose() {
        if gCloseAt || gOkAt
            return
        gCloseAt := A_TickCount
    }
    GCloseEv(*) {
        GClose()
        return 0                                    ; the card fades out on its own; do not hide it here
    }
    GFinish() {
        global G
        SetTimer(GRender, 0)
        OnMessage(0x84, GHT, 0), OnMessage(0x201, GClick, 0)
        OnMessage(0x202, GUp, 0), OnMessage(0x200, GMove, 0)
        OnMessage(0x20, GCur, 0), OnMessage(0x100, GKeyDown, 0), OnMessage(0x215, GCapLost, 0)
        DllCall("gdiplus\GdipDeleteFont", "ptr", fGateT)
        DllCall("gdiplus\GdipDeleteFont", "ptr", fGateS)
        DllCall("gdiplus\GdipDeleteFont", "ptr", fGateC)
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", G2)
        DllCall("gdi32\DeleteDC", "ptr", hdc2)
        DllCall("gdi32\DeleteObject", "ptr", hbm2)
        gw.Destroy()
        G := mainG
        gDone := 1
    }
    GRender() {
        global gateDrag
        now := A_TickCount
        BrushCacheTick(), PenCacheTick()          ; bounded, like every other renderer - this one never asked
        ThemeTick()
        it := Min((now - gIntro)/INTRO_MS, 1.0)
        ei := 1 - (1 - it)**3
        winA := Round(255 * Min(it*1.7, 1.0))
        yO := Round((1 - ei) * 30 * scaleF)
        okT := gOkAt ? Ease3((now - gOkAt)/380.0) : 0.0
        curG := AccSat(Mix(hubAccent, C_ON, okT))   ; accent until the password lands
        dnT := gDenyAt ? Clamp(1 - (now - gDenyAt)/900.0, 0.0, 1.0) : 0.0
        fl := gDenyAt ? Clamp(1 - (now - gDenyAt)/520.0, 0.0, 1.0) : 0.0
        dnGl := gDenyAt ? Clamp(1 - (now - gDenyAt)/350.0, 0.0, 1.0) : 0.0
        embG := (Sin(now * 0.0016) + 1)/2
        emb2G := (Sin(now * 0.004) + 1)/2
        hb := Mod(DecT(now), 2200)
        blink := (hb < 140 || (hb > 300 && hb < 440)) ? 1 : 0
        shO := 0.0
        if gShakeAt {
            stq := (now - gShakeAt)/420.0
            if stq >= 1
                gShakeAt := 0
            else
                shO := Sin(stq*34.5)*8*(1 - stq)**2
        }
        scl := 1.0
        if gOkAt {
            if now - gOkAt > 520 {
                ft := Min((now - gOkAt - 520)/330.0, 1.0)
                winA := Round(winA*(1 - ft)), scl := 1 - 0.06*ft
                yO += Round(10*ft*scaleF)
                if ft >= 1 {
                    GFinish()
                    return
                }
            } else
                scl := 1 + 0.02*Sin(3.14159*Min((now - gOkAt)/260.0, 1.0))
        }
        if gCloseAt {
            ft := Min((now - gCloseAt)/300.0, 1.0)
            winA := Round(winA*(1 - ft)), scl := 1 - 0.05*ft
            if ft >= 1 {
                GFinish()
                ExitApp
            }
        }
        if !gOkAt && !gCloseAt
            scl *= 1 + 0.004*Sin(DecT(now)*0.0012)      ; idle breathing
        scl *= 1 + 0.02*gDragT                    ; drag lift
        gDragT += ((gDrag ? 1.0 : 0.0) - gDragT)*EK(0.2)
        if gDragT < 0.004 && !gDrag
            gDragT := 0.0
        ; ---- the drag, from the loop ----
        ; Moving the card used to depend on WM_MOUSEMOVE reaching this window,
        ; and that delivery is not a given: a window that is not the
        ; foreground gets only the mouse events whose hot spot is over its
        ; visible pixels even after SetCapture, so a pointer that crosses a
        ; transparent margin or outruns the card for a frame leaves the card
        ; behind, and the next event that does arrive throws it to wherever the
        ; pointer is by then. The hub never shows it because its window is
        ; never activated and never asks; this one was activated once, on
        ; creation, and lost the foreground at some point after. So the loop
        ; reads the pointer itself, every frame, and places the card from the
        ; anchors - the same sum GMove does - and ends the drag when no button
        ; is down. Messages still arrive; they now agree with the loop.
        if gDrag {
            if (!GetKeyState("LButton", "P") && !GetKeyState("RButton", "P")) {
                gDrag := 0, gateDrag := 0
                DllCall("ReleaseCapture")
            } else if CursorXY(&dxq, &dyq) {
                gbx := grBX + (dxq - grX), gby := grBY + (dyq - grY)
                HandleBounds(rx + 62, cy + 10, rx + 98, cy + 34, GWp/BW2, &lox, &hix, &loy, &hiy)
                gbx := Clamp(gbx, lox, hix), gby := Clamp(gby, loy, hiy)
            }
        }
        velX := gbx - gPrevGBX, gPrevGBX := gbx
        gTilt += ((gDrag ? Clamp(velX*0.22, -3.0, 3.0) : 0.0) - gTilt)*EK(0.18)
        hz := (gDrag || gCloseAt || gOkAt) ? 0 : GZoneCursor()
        hzT := hz >= 10 ? hz - 9 : 0
        gHndE += (((hz = 5) ? 1.0 : 0.0) - gHndE)*EK(0.2)
        if gHndE < 0.004 && hz != 5
            gHndE := 0.0
        gh2 += (((hz = 2) ? 1.0 : 0.0) - gh2)*EK(0.2)
        if gh2 < 0.004 && hz != 2
            gh2 := 0.0
        ghE += (((hz = 3) ? 1.0 : 0.0) - ghE)*EK(0.2)
        if ghE < 0.004 && hz != 3
            ghE := 0.0
        gaE += (((hz = 8) ? 1.0 : 0.0) - gaE)*EK(0.2)
        if gaE < 0.004 && hz != 8
            gaE := 0.0
        gbE += (((hz = 7) ? 1.0 : 0.0) - gbE)*EK(0.2)
        if gbE < 0.004 && hz != 7
            gbE := 0.0

        ; --- selfie carousel: auto-advance when idle, honor manual switches ---
        if selFadeAt && now - selFadeAt >= SEL_FADE
            selCur := selNext, selFadeAt := 0, selCycleAt := now
        if (!selFadeAt && selQ) {
            if (selQ != selCur)
                selNext := selQ, selFadeAt := now, selCycleAt := now
            selQ := 0
        }
        if gN > 1 && !selFadeAt && !gOkAt && !gCloseAt && now - selCycleAt >= SEL_HOLD {
            selNext := gBase + Mod(selCur - gBase, gN) + 1, selFadeAt := now
        }
        ; computed last: on the frame a fade begins selFadeAt has just been set,
        ; so reading it earlier would leave selFT stale at 1.0 and snap the ring
        ; straight onto the incoming thumbnail for one frame
        selFT := selFadeAt ? Clamp(Ease3((now - selFadeAt)/SEL_FADE), 0.0, 1.0) : 1.0
        gHovAv += (((hz = 6) ? 1.0 : 0.0) - gHovAv)*EK(0.2)
        if gHovAv < 0.004 && hz != 6
            gHovAv := 0.0

        ims := now - gIntro
        stg := ims < 700
        s1 := stg ? Ease3((ims - 60)/340.0) : 1.0
        s2 := stg ? Ease3((ims - 140)/340.0) : 1.0
        s3 := stg ? Ease3((ims - 220)/340.0) : 1.0
        hdy := -(1 - s1)*6, mdy := (1 - s2)*10, fdy2 := (1 - s3)*8

        ResetSurface(G, GWp/BW2, GHp/BH2)
        DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
        st0 := PushXform(cx + CW2/2, cy + CH2/2, scl, gTilt)

        ; ---- card shadow + glass body ----
        ShadowDraw(cx, cy + 3 + 2.5*gDragT, CW2, CH2, 16, 10, 8, 8, 1.0)
        b := BgV(cx, cy, CW2, CH2, 0xF2222438, 0xF8121423)
        FillRR(cx, cy, CW2, CH2, 16, b), DelB(b)

        p := RRPath(cx, cy, CW2, CH2, 16)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 0)
        PanelBackdrop(cx, cy, CW2, CH2, hubAccent, s1, now, 0.95)
        ; ---- the aurora ----
        ; The plate was a navy sheet with the accent kept to hairlines, and it
        ; read as grey. Two slow glows in the accent - one behind the readout,
        ; one low behind the buttons - tint the card the colour of the theme
        ; and give the flat glass somewhere to be lit from. They drift on
        ; their own clocks so the light never holds still.
        aur := (Sin(DecT(now)*0.00052) + 1)/2
        SoftGlow(rx + 150 + 24*Sin(DecT(now)*0.00041), cy + 52 + 12*Cos(DecT(now)*0.00037)
               , 250, 110, curG, Round((52 + 22*aur)*s1), 1.0, 7)
        SoftGlow(rx + 90 + 30*Cos(DecT(now)*0.00033), cy + CH2 - 60 + 10*Sin(DecT(now)*0.00045)
               , 210, 80, AccHi(curG, 0.4), Round((30 + 14*(1 - aur))*s1), 1.0, 6)
        ; ... and a cooler pool low on the hero side, so the left is lit too
        SoftGlow(cx + 60, cy + CH2 - 30, 160, 70, curG, Round(26*s1), 1.0, 5)
        rcD := Buffer(16), NumPut("float", cx - 1, "float", cy - 1, "float", CW2 + 2, "float", CH2 + 2, rcD)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcD, "uint", 0x0EFFFFFF, "uint", 0x00FFFFFF, "int", 2, "int", 3, "ptr*", &db := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", db, "float", cx, "float", cy, "float", CW2, "float", CH2), DelB(db)
        ; ambient dust motes drifting up the card
        loop 12 {
            k := A_Index
            cyc := 5200 + k*337
            prt := Mod(now + k*997, cyc)/cyc
            mx_ := cx + 34 + Mod(k*167, CW2 - 68) + 9*Sin(DecT(now)*0.0009 + k*1.7)
            my_ := cy + CH2 - 10 - prt*(CH2 - 20)
            b := SBrush(FA(Alpha(AccHi(curG, 0.35), 44*Sin(3.14159*prt)), s1))
            mr_ := 0.9 + Mod(k, 3)*0.5
            FillEll(mx_ - mr_, my_ - mr_, mr_*2, mr_*2, b), DelB(b)
        }
        ; animated sweep band
        per := gOkAt ? 3000.0 : 4600.0
        swp := Mod(DecT(now), per)/per
        swx := cx - 26 + (CW2 + 52)*swp
        c0s := (gOkAt ? AccHi(curG, 0.3) : curG) & 0xFFFFFF
        c1s := Alpha(c0s, 34 + 20*okT)
        rcS := Buffer(16), NumPut("float", swx - 25, "float", cy - 2, "float", 26, "float", CH2 + 4, rcS)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS, "uint", c0s, "uint", c1s, "int", 0, "int", 3, "ptr*", &sbA := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbA, "float", swx - 24, "float", cy, "float", 24, "float", CH2), DelB(sbA)
        rcS2 := Buffer(16), NumPut("float", swx - 1, "float", cy - 2, "float", 26, "float", CH2 + 4, rcS2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS2, "uint", c1s, "uint", c0s, "int", 0, "int", 3, "ptr*", &sbB := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbB, "float", swx, "float", cy, "float", 24, "float", CH2), DelB(sbB)
        loop 9 {
            k := A_Index
            cyc := 5600 + k*373
            prt := Mod(now + k*911, cyc)/cyc
            mx_ := cx + 40 + Mod(k*167, CW2 - 80) + 10*Sin(DecT(now)*0.0008 + k*1.7)
            my_ := cy + CH2 - 12 - prt*(CH2 - 24)
            if Mod(k, 3) = 0
                MiniHeart(mx_, my_, 3 + Mod(k, 2)*1.4, Alpha(AccHi(curG, 0.35), Round(120*Sin(3.14159*prt)*s1)))
            else {
                b := SBrush(Alpha(AccHi(curG, 0.35), Round(46*Sin(3.14159*prt)*s1)))
                mr_ := 0.9 + Mod(k, 3)*0.5
                FillEll(mx_ - mr_, my_ - mr_, mr_*2, mr_*2, b), DelB(b)
            }
        }
        ; left accent bar
        b := SBrush(Alpha(curG, Min(255, 46 + 16*embG + 60*fl + 50*okT)))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 14, "float", CH2), DelB(b)
        b := VBrush(cx, cy, 4.5, CH2, Alpha(curG, 245), Alpha(curG, 110 + 40*embG))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 4.5, "float", CH2), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", p)

        pn := Pen(0x28FFFFFF, 1)
        StrokeRR(cx, cy, CW2, CH2, 16, pn), DelP(pn)
        pn := Pen(0x16FFFFFF, 1)
        Line(cx + 18, cy + 1.5, cx + CW2 - 18, cy + 1.5, pn), DelP(pn)
        pn := Pen(0x30000000, 1)
        Line(cx + 18, cy + CH2 - 1.5, cx + CW2 - 18, cy + CH2 - 1.5, pn), DelP(pn)
        ; slow-drifting dashed accent frame (glows while dragging)
        pn := Pen(Alpha(curG, 20 + 10*emb2G + 46*gDragT), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
        StrokeRR(cx + 6, cy + 6, CW2 - 12, CH2 - 12, 12, pn), DelP(pn)
        CornerFlourish(cx, cy, CW2, CH2, curG, s1)

        ; ================= HERO: GALLERY =================
        hxo := -(1 - s1)*16
        hx_ := hpx + hxo
        hp := RRPath(hx_, hpy, hpw, hph, 14)
        b := SBrush(FA(0xFF12141F, s1))
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", hp), DelB(b)
        ; only when no photo covers it - otherwise this is a full pass a frame
        ; drawing under an opaque bitmap
        if gN < 1
            MiniBackdrop(hx_, hpy, hpw, hph, 14, curG, s1, now, 0.8)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", hp, "int", 0)
        if gN >= 1 {
            SetImgAlpha(s1)
            if a := SelAtTall(selCur)
                DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", a
                    , "float", hx_, "float", hpy, "float", hpw, "float", hph
                    , "float", 0, "float", 0, "float", SELW, "float", SELTH
                    , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
            if selNext != selCur && selFT < 1 {
                SetImgAlpha(s1*selFT)
                if bb := SelAtTall(selNext)
                    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bb
                        , "float", hx_, "float", hpy, "float", hpw, "float", hph
                        , "float", 0, "float", 0, "float", SELW, "float", SELTH
                        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
            }
            ; wrong password: sliced glitch displacement + red wash
            if dnGl > 0 {
                if gsrc := SelAtTall(selFT >= 0.5 ? selNext : selCur) {
                    SetImgAlpha(s1)
                    loop 3 {
                        k := A_Index
                        ry_ := k = 1 ? 0.16 : k = 2 ? 0.45 : 0.72
                        sh_ := hph*0.085
                        dxg := (Mod(k, 2) ? 1 : -1)*(3 + 9*dnGl)*Sin(DecT(now)*0.055 + k*2.3)
                        DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", gsrc
                            , "float", hx_ + dxg, "float", hpy + ry_*hph, "float", hpw, "float", sh_
                            , "float", 0, "float", ry_*SELTH, "float", SELW, "float", SELTH*sh_/hph
                            , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
                    }
                    b := SBrush(Alpha(C_BAD, 34*dnGl))
                    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", hx_, "float", hpy, "float", hpw, "float", hph), DelB(b)
                }
            }
        } else
            Txt("Z", hx_, hpy, hpw, hph, fGateT, FA(Alpha(curG, 200), s1), fmtC)
        ; roaming scanline
        sly := hpy - 16 + Mod(DecT(now), 3600)/3600.0*(hph + 32)
        b := VBrush(hx_, sly - 12, hpw, 12, Alpha(0xFFFFFF, 0), Alpha(0xFFFFFF, 24))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", hx_, "float", sly - 12, "float", hpw, "float", 12), DelB(b)
        pn := Pen(FA(Alpha(AccHi(curG, 0.5), 60), s1), 1)
        Line(hx_, sly, hx_ + hpw, sly, pn), DelP(pn)
        ; caption: gradient + GALLERY + index
        b := VBrush(hx_, hpy + hph - 58, hpw, 58, 0x00060810, 0xE8060810)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", hx_, "float", hpy + hph - 58, "float", hpw, "float", 58), DelB(b)
        ; ONE line now that the name is one word. The old pair set "GALLERY OF"
        ; small and dim above "ZEAL" in the accent, and that split only earned
        ; its two lines because the name had two halves to give them. Leaving
        ; the dim line with a single word above an empty accent line would read
        ; as a caption that had lost something.
        ;
        ; Sat at -38 (11px) and -25 (15px), so the pair spanned -38..-10 and
        ; centred on -24. A single 15px line centred on the same point is -31,
        ; which keeps the underline below it and the index beside it exactly
        ; where they were relative to the text.
        Txt("GALLERY", hx_ + 10, hpy + hph - 31, 120, 15, fGateS, FA(Alpha(AccHi(curG, 0.75), 240), s1), fmtL)
        pn := Pen(FA(Alpha(curG, 90 + 70*(Sin(DecT(now)*0.0035) + 1)/2), s1), 1.4)
        Line(hx_ + 10, hpy + hph - 8, hx_ + 38, hpy + hph - 8, pn), DelP(pn)
        if gN >= 1
            Txt((selCur - gBase) "/" gN, hx_, hpy + hph - 31, hpw - 30, 15, fGateS, FA(Alpha(curG, 225), s1), fmtR)
        ; hover scrim + NEXT
        if gHovAv > 0.01 && gN > 1 {
            he := gHovAv
            b := SBrush(Alpha(0x05060C, 130*he))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", hx_, "float", hpy, "float", hpw, "float", hph), DelB(b)
            hyc := hpy + hph/2 - 10 + (1 - he)*6
            pn := Pen(Alpha(0xFFFFFF, 225*he), 2.2)
            Line(hx_ + hpw/2 - 4, hyc - 9, hx_ + hpw/2 + 5, hyc, pn)
            Line(hx_ + hpw/2 + 5, hyc, hx_ + hpw/2 - 4, hyc + 9, pn), DelP(pn)
            Txt("NEXT", hx_, hyc + 15, hpw, 14, fBadge, Alpha(0xFFFFFF, 240*he), fmtC)
        }
        ; grant bloom
        if gOkAt && okT < 1 {
            b := SBrush(Alpha(0xFFFFFF, 70*(1 - okT)))
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", hx_, "float", hpy, "float", hpw, "float", hph), DelB(b)
        }
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", hp)
        pn := Pen(FA(Alpha(AccHi(curG, 0.35), 120 + 70*emb2G), s1), 1.6)
        Arc(hx_ - 8, hpy - 8, 26, 26, 175, 100, pn)
        Arc(hx_ + hpw - 18, hpy + hph - 18, 26, 26, 355, 100, pn), DelP(pn)
        daH := (185 + 78*(0.5 + 0.5*Sin(DecT(now)*0.0024)))*0.0174533
        b := SBrush(FA(Alpha(AccHi(curG, 0.55), 210), s1))
        FillEll(hx_ + 5 + 13*Cos(daH) - 1.5, hpy + 5 + 13*Sin(daH) - 1.5, 3, 3, b), DelB(b)
        ; hero frame: inner shade + crisp on-path stroke (matches image corners exactly)
        pn := Pen(FA(Alpha(0x000000, 110), s1), 1)
        StrokeRR(hx_ + 1, hpy + 1, hpw - 2, hph - 2, 13, pn), DelP(pn)
        pn := Pen(FA(Alpha(Mix(0xFF2A2C42, curG, 0.45), 235), s1), 2)
        StrokeRR(hx_, hpy, hpw, hph, 14, pn), DelP(pn)
        ; shield-lock badge on the hero corner
        bdx := hx_ + hpw - 8, bdy := hpy + hph - 8
        okScl := 1 + 0.10*Sin(3.14159*Min(okT*1.3, 1.0))
        stB := PushXform(bdx, bdy, okScl, 0)
        b := SBrush(FA(Alpha(0x0B0C14, 235), s1))
        FillEll(bdx - 13, bdy - 13, 26, 26, b), DelB(b)
        sp := ShieldPath(bdx - 8, bdy - 9, 16, 19)
        b := SBrush(FA(Alpha(curG, Min(255, 150 + 40*emb2G + 90*okT)), s1))
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", sp), DelB(b)
        pn := Pen(FA(Alpha(AccHi(curG, 0.35), 235), s1), 1.4)
        DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", sp), DelP(pn)
        DllCall("gdiplus\GdipDeletePath", "ptr", sp)
        if okT < 0.5 {
            b := SBrush(FA(Alpha(0x05060C, 235), s1))
            FillRR(bdx - 3.4, bdy - 1, 6.8, 6.2, 1.6, b), DelB(b)
            pn := Pen(FA(Alpha(0x05060C, 235), s1), 1.4)
            Arc(bdx - 2.6, bdy - 5.4, 5.2, 5.2, 180, 180, pn), DelP(pn)
        } else {
            pn := Pen(FA(Alpha(0x05060C, 245), s1), 1.8)
            Line(bdx - 3.4, bdy + 0.6, bdx - 1, bdy + 3, pn)
            Line(bdx - 1, bdy + 3, bdx + 3.6, bdy - 3, pn), DelP(pn)
        }
        Pop(stB)
        ; access-granted spark burst from the badge
        if gOkAt {
            gsp := Min((now - gOkAt)/560.0, 1.0)
            if gsp < 1 {
                e := Ease3(gsp)
                loop 8 {
                    a_ := (A_Index*45 + 22*e)*0.0174533
                    rr_ := 9 + e*30
                    sr := 2.2*(1 - e) + 0.4
                    b := SBrush(Alpha(AccHi(curG, 0.4), 220*(1 - e)))
                    FillEll(bdx + rr_*Cos(a_) - sr, bdy + rr_*Sin(a_) - sr, sr*2, sr*2, b), DelB(b)
                }
                pn := Pen(Alpha(curG, 170*(1 - e)), 2.2*(1 - e) + 0.4)
                r_ := 13 + e*26
                Ell(bdx - r_, bdy - r_, r_*2, r_*2, pn), DelP(pn)
            }
        }

        ; ================= CLOSE BUTTON =================
        ec := 1 + 0.28*gh2
        ycb := btyU + hdy - 1.2*gh2
        ; chrome, so it follows the hub accent - curG is the gate's own
        ; rose-to-green validation ramp and means something different
        gAcc := hubAccent
        b := SBrush(FA(Alpha(gAcc, 36 + 60*gh2), s1))
        FillEll(bcxU - 7*ec, ycb - 7*ec, 14*ec, 14*ec, b), DelB(b)
        pn := Pen(FA(Alpha(gAcc, 100 + 80*gh2), s1), 1)
        Ell(bcxU - 7*ec, ycb - 7*ec, 14*ec, 14*ec, pn), DelP(pn)
        pn := Pen(FA(Alpha(AccHi(gAcc, 0.45), 210 + 45*gh2), s1), 1.5)
        Line(bcxU - 3.2*ec, ycb - 3.2*ec, bcxU + 3.2*ec, ycb + 3.2*ec, pn)
        Line(bcxU - 3.2*ec, ycb + 3.2*ec, bcxU + 3.2*ec, ycb - 3.2*ec, pn), DelP(pn)

        ; ================= HEADER =================
        Txt(APPNAME, rx, cy + 12 + hdy, 90, 20, fBrand, FA(0xCFE8EAF6, s1), fmtL)
        b := SBrush(FA(Alpha(curG, gOkAt ? 240 : Min(255, 150 + 35*emb2G + 48*blink)), s1))
        FillEll(rx + wZeal + 6, cy + 19.5 + hdy, 5, 5, b), DelB(b)
        ; drag handle: the 6-dot grid is the only drag spot
        hnA := Max(gHndE, gDragT)
        if hnA > 0.01 {
            b := SBrush(FA(Alpha(0xFFFFFF, 24*hnA), s1))
            FillRR(rx + 63, cy + 11 + hdy, 34, 22, 6, b), DelB(b)
            pn := Pen(FA(Alpha(curG, 90*hnA), s1), 1)
            StrokeRR(rx + 63, cy + 11 + hdy, 34, 22, 6, pn), DelP(pn)
        }
        b := SBrush(FA(Alpha(AccHi(curG, 1 - (0.5*hnA)), 46 + 70*hnA), s1))
        loop 6 {
            gc := Mod(A_Index - 1, 3), gr := (A_Index - 1) // 3
            FillEll(rx + 71.8 + gc*7, cy + 18 + gr*5.6 + hdy, 2.4, 2.4, b)
        }
        DelB(b)
        ; signal-bar ticker
        sbn := 1 + Mod(now // 520, 4)
        loop 4 {
            k := A_Index
            bh_ := 3 + k*2.4
            on_ := k <= sbn
            b := SBrush(FA(Alpha(on_ ? curG : 0xFFFFFF, on_ ? 200 : 42), s1))
            FillRR(rx + 126 + (k - 1)*6, cy + 26 + hdy - bh_, 3, bh_, 1.2, b), DelB(b)
        }
        ; rotating spinner + live clock (top-right)
        ckx := cx + CW2 - 44
        pn := Pen(FA(Alpha(curG, 170), s1), 1.6)
        Arc(ckx - 86, cy + 15 + hdy, 10, 10, Mod(DecT(now)*0.22, 360), 100, pn)
        Arc(ckx - 86, cy + 15 + hdy, 10, 10, Mod(DecT(now)*0.22, 360) + 180, 40, pn), DelP(pn)
        Txt(ClockStr(), ckx - 70, cy + 13 + hdy, 70, 14, fBadge, FA(0x86C7CBE0, s1), fmtR)

        ; ================= STATUS (scramble decode) =================
        sy := cy + 52 + mdy
        scr := gOkAt ? (gateChoice = "roblox" ? scrRbx : scrHub) : scrReady
        scrAt := gOkAt ? gOkAt : gIntro
        ; the word sits in its own pool of light, and a rule under it breathes
        ; with a highlight running its length - the card's pulse, next to the
        ; standby card's heartbeat
        SoftGlow(rx + scr.w/2, sy + 16, scr.w*0.85 + 30, 30, curG, Round(70*s2), 1.0, 6)
        rlw := scr.w + 26
        b := HBrush(rx, sy + 34, rlw, 2, FA(Alpha(curG, Round(200 + 40*embG)), s2), FA(Alpha(curG, 0), s2))
        FillRR(rx, sy + 34, rlw, 2, 1, b), DelB(b)
        rhx := rx + Mod(DecT(now)*0.09, rlw + 24) - 12
        b := SBrush(FA(Alpha(AccHi(curG, 0.6), 220), s2))
        FillRR(rhx, sy + 33.5, 14, 3, 1.5, b), DelB(b)
        if now < scrAt + 130 + scr.chs.Length*42 {
            loop scr.chs.Length {
                i := A_Index
                if now < scrAt + 90 + i*42 {
                    ch := SubStr(SCRSET, Random(1, StrLen(SCRSET)), 1)
                    cc := Alpha(Mix(curG, 0xFFE8EAF6, 0.55), 205)
                } else {
                    ch := scr.chs[i]
                    cc := Alpha(curG, 245)
                }
                Txt(ch, rx + scr.xs[i], sy, 46, 30, fGateT, FA(cc, s2), fmtL)
            }
        } else
            Txt(gOkAt ? (gateChoice = "roblox" ? "LAUNCHING" : "OPENING") : "READY"
              , rx, sy, 240, 30, fGateT, FA(Alpha(curG, 245), s2), fmtL)
        stw := scr.w
        loop 3 {
            k := A_Index - 1
            x0 := rx + stw + 12 + k*7
            ca := 50 + 85*Max(0.0, Sin(DecT(now)*0.0025 - k*0.9))**3 + 120*okT*Max(0.0, Sin(DecT(now)*0.005 - k*0.9))**3
            pn := Pen(FA(Alpha(Mix(0xFFE8EAF6, curG, 0.35 + 0.3*okT), Min(255, ca)), s2), 1.8)
            Line(x0, sy + 15 - 3.8, x0 + 3.6, sy + 15, pn)
            Line(x0 + 3.6, sy + 15, x0, sy + 15 + 3.8, pn)
            DelP(pn)
        }
        vx := fx + fw - 128, vy := cy + 46 + mdy, vw := 128, vh := 38
        b := SBrush(FA(Alpha(0xFFFFFF, 8), s2))
        FillRR(vx, vy, vw, vh, 10, b), DelB(b)
        MiniBackdrop(vx, vy, vw, vh, 10, curG, s2, now, 0.7)
        pn := Pen(FA(Alpha(curG, 110 + 40*emb2G), s2), 1)
        StrokeRR(vx, vy, vw, vh, 10, pn), DelP(pn)
        vph := Mod(DecT(now), 1400)/1400.0
        vth := Max(0.0, Sin(vph*6.283))**8 + 0.55*Max(0.0, Sin(vph*6.283 - 1.05))**8
        MiniHeart(vx + 17, vy + vh/2 - 1, 5.2 + 1.6*vth, FA(Alpha(AccHi(curG, 0.3), 225), s2))
        if vth > 0.05 {
            pn := Pen(FA(Alpha(curG, 110*vth), s2), 1.1)
            Ell(vx + 17 - 8 - 5*(1 - vth), vy + vh/2 - 9 - 5*(1 - vth), 16 + 10*(1 - vth), 16 + 10*(1 - vth), pn), DelP(pn)
        }
        vex0 := vx + 32, vex1 := vx + vw - 10, vey := vy + vh/2
        vpx := vex0 + 5 + Mod(DecT(now)*0.05, vex1 - vex0 - 10)
        pn := Pen(FA(Alpha(AccHi(curG, 0.3), 170), s2), 1.2)
        if vpx > vex0 + 8 && vpx < vex1 - 8 {
            Line(vex0, vey, vpx - 7, vey, pn)
            Line(vpx - 7, vey, vpx - 3.5, vey - 6, pn)
            Line(vpx - 3.5, vey - 6, vpx, vey + 7, pn)
            Line(vpx, vey + 7, vpx + 3.5, vey - 3, pn)
            Line(vpx + 3.5, vey - 3, vpx + 7, vey, pn)
            Line(vpx + 7, vey, vex1, vey, pn)
        } else
            Line(vex0, vey, vex1, vey, pn)
        DelP(pn)
        Txt(gOkAt ? "WELCOME" : "LOADED", vx + 30, vy + 2, vw - 38, 11, fGateC, FA(Alpha(Mix(curG, 0xFFC7CBE0, 0.3), 215), s2), fmtL)
        ; ---- what was loaded, as chips ----
        ; "everything is loaded" was a dim sentence. The chips are the
        ; evidence: how big the flag database came in, how many community
        ; sets are cached, and whether Roblox is running, installed or not
        ; found - the last one is the thing OPEN ROBLOX needs to know. Once a
        ; button is pressed the row gives way to what the card is doing.
        if (now - gRbxAt > 2000 && !gDrag) {      ; a process snapshot and a folder walk: not under a drag
            gRbxAt := now
            gRbx := FFMProcList().Length ? 2 : (RSetAppSettingsPaths().Length ? 1 : 0)
        }
        chy := cy + 90 + mdy
        if !gOkAt {
            chx := rx
            chx := GChip(chx, chy, FFMNum(FFM.db.Length), "FLAGS", curG, s2)
            chx := GChip(chx + 8, chy, gSets, "SETS", AccHi(curG, 0.3), s2)
            GChip(chx + 8, chy, gRbx = 2 ? "RUNNING" : gRbx = 1 ? "INSTALLED" : "NOT FOUND", "ROBLOX"
                , gRbx ? C_ON : AMBER, s2)
        } else {
            htxt := (gateChoice = "roblox") ? "starting roblox, then the hub"
                  : (gateChoice = "acct")   ? "opening the hub, on your accounts"
                  :                           "opening the hub"
            Txt(htxt, rx, chy, 320, 16, fHint, FA(Alpha(curG, 215), s2), fmtL)
        }

        ; --- cipher strip: sits centred in the gap between the separator
        ; (cy + 108) and the password well (cy + 148), and spans exactly the
        ; well's width so both edges line up with the field below ---
        cpy := cy + 119 + mdy
        cpw := fw
        FadeLine(rx, rx + cpw, cpy + 9, FA(Alpha(0xFFFFFF, 22), s2), 1)
        loop 26 {
            ck := A_Index
            cpx := rx + (ck - 1)*(cpw - 2)/25
            ph2 := now*0.0024 + ck*0.55
            hgt := 3 + 7*(Sin(ph2) + 1)/2
            al2 := Round(56 + 120*(Sin(ph2*0.7 + 1.2) + 1)/2)
            if (dnT > 0)
                al2 := Round(al2*(1 - dnT) + 150*dnT)
            b := SBrush(FA(Alpha(dnT > 0 ? C_BAD : curG, al2), s2))
            FillRR(cpx, cpy + 9 - hgt/2, 2, hgt, 1, b), DelB(b)
        }
        ; travelling read-head
        rh := Mod(DecT(now)*0.16, cpw + 40) - 20
        if (rh > -12 && rh < cpw + 12) {
            b := SBrush(FA(Alpha(curG, 40), s2))
            FillEll(rx + rh - 9, cpy + 9 - 9, 18, 18, b), DelB(b)
            pn := Pen(FA(Alpha(AccHi(curG, 0.5), 190), s2), 1.4)
            Line(rx + rh, cpy + 1, rx + rh, cpy + 17, pn), DelP(pn)
        }
        ; end ticks capping both extremes of the run
        pn := Pen(FA(Alpha(curG, 90), s2), 1.2)
        Line(rx + 1, cpy + 3, rx + 1, cpy + 15, pn)
        Line(rx + cpw - 1, cpy + 3, rx + cpw - 1, cpy + 15, pn), DelP(pn)
        b := SBrush(FA(Alpha(curG, Round(120 + 90*Abs(Sin(DecT(now)*0.0026)))), s2))
        FillEll(rx + cpw - 3.5, cpy + 6.5, 5, 5, b), DelB(b)
        FadeLine(rx, rx + fw, cy + 108, 0x24FFFFFF, s3)

        ; ================= THE TWO BUTTONS =================
        ; In the band the password well filled. OPEN ROBLOX is the offer and
        ; wears the primary face; OPEN HUB is the way in without the client and
        ; wears the ghost. Once one is pressed it holds its press ring and the
        ; other steps back, so the card shows which way it is going while it
        ; folds. The faces are the hub's own gate card buttons, drawn here with
        ; this card's own hover eases and press clock.
        fyy := fy + fdy2
        pr := gPressAt ? Clamp(1 - (now - gPressAt)/320.0, 0.0, 1.0) : 0.0
        oth := gOkAt ? Clamp(1 - (now - gOkAt)/260.0, 0.0, 1.0) : 1.0
        ; The offer has the first row to itself; the two other doors - the hub
        ; alone, and the hub opened on the saved accounts - share the second.
        ; Whichever was pressed keeps its ring; the other two step back.
        dim := 0.35 + 0.65*oth
        GBtn(7, fx, fyy, fw, fh, "OPEN ROBLOX", 1, gbE, gPressZ = 7 ? pr : 0.0
           , s3*((gPressZ && gPressZ != 7) ? dim : 1.0), now, curG, "dart")
        fyy2 := fy2 + fdy2
        GBtn(3, fx, fyy2, bw1, fh2, "OPEN HUB", 0, ghE, gPressZ = 3 ? pr : 0.0
           , s3*((gPressZ && gPressZ != 3) ? dim : 1.0), now, curG, "hub")
        GBtn(8, fx + bw1 + 10, fyy2, bw1, fh2, "ACCOUNTS", 0, gaE, gPressZ = 8 ? pr : 0.0
           , s3*((gPressZ && gPressZ != 8) ? dim : 1.0), now, curG, "acct")

        ; ---- ambient doodles: circuit pulse (left) + mini equalizer (right) ----
        cyD := cy + CH2 - 64                    ; under the second row - see fy2
        pn := Pen(FA(Alpha(0xFFFFFF, 34), s3), 1)
        Line(fx + 2, cyD, fx + 46, cyD, pn)
        Line(fx + 46, cyD, fx + 46, cyD - 10, pn)
        Line(fx + 46, cyD - 10, fx + 92, cyD - 10, pn)
        Line(fx + 92, cyD - 10, fx + 92, cyD + 8, pn)
        Line(fx + 92, cyD + 8, fx + 128, cyD + 8, pn), DelP(pn)
        b := SBrush(FA(Alpha(0xFFFFFF, 70), s3))
        FillEll(fx + 44.6, cyD - 1.4, 2.8, 2.8, b)
        FillEll(fx + 90.6, cyD - 11.4, 2.8, 2.8, b)
        FillEll(fx + 126.6, cyD + 6.6, 2.8, 2.8, b), DelB(b)
        tp := Mod(DecT(now), 2600)/2600.0*154
        if tp <= 44
            pxD := fx + 2 + tp, pyD := cyD
        else if tp <= 54
            pxD := fx + 46, pyD := cyD - (tp - 44)
        else if tp <= 100
            pxD := fx + 46 + (tp - 54), pyD := cyD - 10
        else if tp <= 118
            pxD := fx + 92, pyD := cyD - 10 + (tp - 100)
        else
            pxD := fx + 92 + (tp - 118), pyD := cyD + 8
        b := SBrush(FA(Alpha(curG, 60), s3))
        FillEll(pxD - 4, pyD - 4, 8, 8, b), DelB(b)
        b := SBrush(FA(Alpha(AccHi(curG, 0.4), 225), s3))
        FillEll(pxD - 1.8, pyD - 1.8, 3.6, 3.6, b), DelB(b)
        oex := fx + fw - 22, oey := thY
        pn := Pen(FA(Alpha(curG, 55), s3), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
        Ell(oex - 13, oey - 13, 26, 26, pn), DelP(pn)
        oaG := now*0.0022
        b := SBrush(FA(Alpha(AccHi(curG, 0.5), 215), s3))
        FillEll(oex + 13*Cos(oaG) - 1.7, oey + 13*Sin(oaG) - 1.7, 3.4, 3.4, b), DelB(b)
        b := SBrush(FA(Alpha(curG, 130), s3))
        FillEll(oex + 8*Cos(-oaG*1.6) - 1.2, oey + 8*Sin(-oaG*1.6) - 1.2, 2.4, 2.4, b), DelB(b)
        MiniHeart(oex, oey + 1, 3.4 + 0.8*emb2G, FA(Alpha(AccHi(curG, 0.35), 200), s3))
        eqx := fx + fw - 96, eqy := cy + CH2 - 50
        loop 14 {
            k := A_Index
            bh := 3.5 + 11*Abs(Sin(DecT(now)*0.0042 + k*0.93))*(0.5 + 0.5*Sin(DecT(now)*0.0016 + k*0.6)**2)
            b := SBrush(FA(Alpha(AccHi(curG, 0.25), 44 + 52*Abs(Sin(DecT(now)*0.003 + k*1.3))), s3))
            FillRR(eqx + (k - 1)*7, eqy - bh, 3, bh, 1.5, b), DelB(b)
        }

        ; ================= SELFIE CAROUSEL STRIP =================
        if gN > 1 {
            loop thShow {
                i := A_Index
                txc := thX0 + (i - 1)*thGap
                ; The ring no longer reads the image crossfade. Deriving it from
                ; selCur/selNext/selFT meant every commit, queue drain or reversal
                ; could restate the weight for a frame. Instead each thumbnail
                ; keeps its own weight and low-pass filters toward a binary
                ; target, so it is monotonic by construction and cannot flicker
                ; however the underlying selection is reshuffled.
                tgtW := ((gBase + i) = (selFadeAt ? selNext : selCur)) ? 1.0 : 0.0
                aw := ringW.Has(i) ? ringW[i] : tgtW
                aw += (tgtW - aw)*EK(0.16)
                if (Abs(tgtW - aw) < 0.004)
                    aw := tgtW
                ringW[i] := aw
                tr := (thR - 2 + 2*aw) + (i = hzT ? 1.5 : 0)
                if bmp := SelAt(gBase + i) {
                    BlitCircle(bmp, txc, thY, tr, s3 * (0.72 + 0.28*aw))
                    pn := Pen(FA(Alpha(0x000000, 70), s3), 1)
                    Ell(txc - tr + 0.5, thY - tr + 0.5, (tr - 0.5)*2, (tr - 0.5)*2, pn), DelP(pn)
                    if (aw < 0.999) {
                        pn := Pen(FA(Alpha(0xFFFFFF, Round((i = hzT ? 120 : 55)*(1 - aw))), s3), 1)
                        Ell(txc - tr, thY - tr, tr*2, tr*2, pn), DelP(pn)
                    }
                    if (aw > 0.001) {
                        pn := Pen(FA(Alpha(curG, Round(235*aw)), s3), 2)
                        Ell(txc - tr - 1, thY - tr - 1, (tr + 1)*2, (tr + 1)*2, pn), DelP(pn)
                        aa := Mod(DecT(now)*0.12, 360)
                        pn := Pen(FA(Alpha(AccHi(curG, 0.5), Round(235*aw)), s3), 2)
                        Arc(txc - tr - 1, thY - tr - 1, (tr + 1)*2, (tr + 1)*2, aa, 70, pn), DelP(pn)
                    }
                }
            }
        } else
            Txt(APPNAME, cx + CW2 - 152, cy + CH2 - 27, 128, 16, fHint, FA(0x3EC7CBE0, s3), fmtR)

        if gDragT > 0.01 {
            d := gDragT
            b := SBrush(Alpha(0x0B0C14, 122*d))
            FillRR(cx, cy, CW2, CH2, 16, b), DelB(b)
            pn := Pen(Alpha(curG, 205*d), 1.6)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
            StrokeRR(cx + 3, cy + 3, CW2 - 6, CH2 - 6, 13, pn), DelP(pn)
            mcx := cx + CW2/2, mcy := cy + CH2/2 - 7
            pn := Pen(Alpha(0xFFFFFF, 225*d), 1.8)
            loop 4 {
                a_ := (A_Index - 1) * 1.5708
                x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
                Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
            }
            DelP(pn)
            Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, Alpha(0xFFFFFF, 235*d), fmtC)
        }

        Pop(st0)

        pt0 := Buffer(8, 0)
        sz := Buffer(8), NumPut("int", GWp, "int", GHp, sz)
        gpx := gbx + Round(shO*scaleF), gpy := gby + yO
        ptd := Buffer(8), NumPut("int", gpx, "int", gpy, ptd)
        bf := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
        DllCall("user32\UpdateLayeredWindow", "ptr", gw.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz, "ptr", hdc2, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
    }
}

; ================= interaction =================
HitZone(sx, sy) {
    if !abOn
        return 0
    if galOpen || cropUIOn
        return 0
    if closing
        return 0
    k := PW/BW
    ux := (sx - winPX)/k, uy := (sy - winPY)/k
    if minT < 0.5 {
        if (ux - BMX)**2 + (uy - BTY)**2 <= 81
            return 1
        if (ux - BCX)**2 + (uy - BTY)**2 <= 81
            return 2
        if (ux - AVX)**2 + (uy - AVY)**2 <= 676
            return 5
        if ux >= PAD + 24 && ux <= PAD + 24 + (rebindOn ? qqqBW : bindBW) && uy >= PAD + 106 && uy <= PAD + 126
            return 6
        ; only the six-dot grip is draggable, not the whole title bar
        if ux >= PAD + CW/2 - 16 && ux <= PAD + CW/2 + 16 && uy >= PAD + 4 && uy <= PAD + 28
            return 4
    } else if (ux - BBX)**2 + (uy - BBY)**2 <= 1024
        return 3
    return 0
}
HitZoneAtCursor() {
    CursorXY(&x, &y)
    return HitZone(x, y)
}
; The buffer is zeroed and the call's result is returned: GetCursorPos can
; fail - a secure desktop, a foreground window this process may not query -
; and an unzeroed buffer then hands back whatever was in that memory as a
; position. A drag that read one such sample put its window wherever the
; garbage said, which is a window teleporting for no reason anyone can see.
; On failure x and y keep the last good read.
CursorXY(&x, &y) {
    static lx := 0, ly := 0
    pt := Buffer(8, 0)
    if !DllCall("GetCursorPos", "ptr", pt) {
        x := lx, y := ly
        return 0
    }
    x := NumGet(pt, 0, "int"), y := NumGet(pt, 4, "int")
    lx := x, ly := y
    return 1
}
LpXY(lParam, &x, &y) {
    x := lParam & 0xFFFF, y := (lParam >> 16) & 0xFFFF
    x := x > 0x7FFF ? x - 0x10000 : x
    y := y > 0x7FFF ? y - 0x10000 : y
}
HitTest(wParam, lParam, msg, hwnd) {
    if hwnd != ui.Hwnd
        return
    LpXY(lParam, &x, &y)
    return HitZone(x, y) ? 1 : -1
}
Click(wParam, lParam, msg, hwnd) {
    if hwnd != ui.Hwnd
        return
    CursorXY(&x, &y)
    zone := HitZone(x, y)
    if zone = 1
        StartMin(1.0)
    else if zone = 2
        AbDisable()
    else if zone = 3 || zone = 4
        DragBegin(zone, x, y)
    else if zone = 5
        GalleryPick()
    else if zone = 6
        RebindClick()
    return 0
}
LUp(wParam, lParam, msg, hwnd) {
    global dragOn
    if !dragOn
        return
    wasClick := (dragOn = 1), z := dragZone
    dragOn := 0                                  ; cleared before the release - see HubBtnUp
    DllCall("ReleaseCapture")
    if wasClick && z = 3
        StartMin(0.0)
    return 0
}
MMove(wParam, lParam, msg, hwnd) {
    global dragOn, baseX, baseY
    if hwnd != ui.Hwnd
        return
    if !dragOn {
        RendTim(TICK_S)
        return
    }
    ; a drag whose button is up is over - see HubMove
    if (!GetKeyState("LButton", "P") && !GetKeyState("RButton", "P")) {
        LUp(wParam, lParam, 0x202, hwnd)
        return 0
    }
    CursorXY(&x, &y)
    if dragOn = 1 && (x - grabX)**2 + (y - grabY)**2 > 16
        dragOn := 2
    if dragOn = 2 {
        baseX := grabBX + (x - grabX)
        baseY := grabBY + (y - grabY)
        ClampPos()
    }
    return 0
}
DragBegin(zone, x, y) {
    global dragOn := 1, dragZone := zone, dragDownAt := A_TickCount
    global grabX := x, grabY := y, grabBX := baseX, grabBY := baseY
    DllCall("SetCapture", "ptr", ui.Hwnd)
    RendTim(TICK_A)
}
; ---- where the overlay is allowed to sit ----
; Same rule and the same reasoning as HubClampBounds - see the note above
; HandleBounds. The old clamp here only ever described the OPEN window, and the
; collapsed overlay has exactly one hit zone: the orb at BBX/BBY, bottom-right
; of the canvas. Drag the open card until its grip is near the right or lower
; edge, press minimise, and that orb landed off the display with nothing left to
; click - no restore, no close, and right-click needs the orb too.
OvClampBounds(&lox, &hix, &loy, &hiy) {
    k := PW/BW
    if (minTo = 1.0)                                      ; collapsed: the orb
        HandleBounds(BBX - 32, BBY - 32, BBX + 32, BBY + 32, k, &lox, &hix, &loy, &hiy)
    else                                                  ; open: the 6-dot grip
        HandleBounds(PAD + CW/2 - 16, PAD + 4
                   , PAD + CW/2 + 16, PAD + 28, k, &lox, &hix, &loy, &hiy)
}
ClampPos() {
    global baseX, baseY
    OvClampBounds(&lox, &hix, &loy, &hiy)
    baseX := Clamp(baseX, lox, hix), baseY := Clamp(baseY, loy, hiy)
}
OvClampTick() {
    global baseX, baseY
    OvClampBounds(&lox, &hix, &loy, &hiy)
    tx := Clamp(baseX, lox, hix), ty := Clamp(baseY, loy, hiy)
    if (dragOn = 2 || (Abs(tx - baseX) <= 1 && Abs(ty - baseY) <= 1)) {
        baseX := tx, baseY := ty
        return 0
    }
    baseX := StepTo(baseX, tx, EK(0.24)), baseY := StepTo(baseY, ty, EK(0.24))
    return 1
}
RClick(wParam, lParam, msg, hwnd) {
    if hwnd != ui.Hwnd
        return
    CursorXY(&x, &y)
    if HitZone(x, y) = 3
        AbDisable()
    return 0
}
SetCur(wParam, lParam, msg, hwnd) {
    if hwnd = ui.Hwnd {
        id := (dragOn || HitZoneAtCursor() = 4) ? 32646 : 32649
        DllCall("SetCursor", "ptr", DllCall("LoadCursor", "ptr", 0, "ptr", id, "ptr"))
        return 1
    }
}
StartMin(target) {
    global minFrom := minT, minTo := target, minStart := A_TickCount
    global burstAt := target ? minStart + Round(MIN_MS*0.45) : 0
    global scatAt := target ? 0 : minStart
    RendTim(TICK_A)
}
StartClose() {
    global closing
    if !closing {
        closing := A_TickCount
        RendTim(TICK_A)
    }
}
PickAvatar() {
    global pickerPid
    if pickerPid && ProcessExist(pickerPid)
        return
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" pick ' ui.Hwnd
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" pick ' ui.Hwnd
    try Run(cmd, , , &pickerPid)
    HubPickWatch(pickerPid)   ; raise the hub again when the dialog closes
}
CopyData(wParam, lParam, msg, hwnd) {
    magic := NumGet(lParam, 0, "uptr")
    if magic != 0x5A11 && magic != 0x5A12 && magic != 0x5A13 && magic != 0x5A14
        && magic != 0x5A15 && magic != 0x5A16 && magic != 0x5A17 && magic != 0x5A18
        && magic != 0x5A19 && magic != 0x5A1A && magic != 0x5A1B && magic != 0x5A1C
        && magic != 0x5A1D && magic != 0x5A1E && magic != 0x5A1F
        && magic != 0x5A20 && magic != 0x5A21 && magic != 0x5A22 && magic != 0x5A23
        && magic != 0x5A24 && magic != 0x5A25 && magic != 0x5A26 && magic != 0x5A27
        && magic != 0x5A31                       ; LOGIN ITEMS' picker
        return
    sel := StrGet(NumGet(lParam, A_PtrSize*2, "ptr"), "UTF-16")
    if sel = ""
        return 1
    if magic = 0x5A27
        FFMCommSynced(sel)
    else if magic = 0x5A26
        GalAddGot(sel)
    else if magic = 0x5A25
        RSetSetLogoTarget(sel)
    else if magic = 0x5A24
        RSetSetLogo(sel)
    else if magic = 0x5A23
        FFMUpdateGot(sel)
    else if magic = 0x5A22
        AcctCookieGot(sel)
    else if magic = 0x5A21
        AcctMeshGot(sel)
    else if magic = 0x5A20
        AcctProfGot(sel)
    else if magic = 0x5A1F
        AcctNameGot(sel)
    else if magic = 0x5A1E
        AcctTickGot(sel)
    else if magic = 0x5A1D
        SPFUserGot(sel)
    else if magic = 0x5A1C
        SPFStatsGot(sel)
    else if magic = 0x5A1B
        SPFServersGot(sel)
    else if magic = 0x5A1A
        SPFHomeGot(sel)
    else if magic = 0x5A19
        SPFNameGot(sel)
    else if magic = 0x5A18
        SPFRegionGot(sel)
    else if magic = 0x5A17
        RSetSetFont(sel)
    else if magic = 0x5A16 {
        ss := StrSplit(sel, "|", , 2)
        if (ss.Length >= 2)
            CurSetImage(Integer(ss[1]), ss[2])
    }
    else if magic = 0x5A14
        FFMDbLoaded(sel)
    else if magic = 0x5A15 {
        if (sel = "`f")
            FFMExportClip()
        else
            FFMExportFile(sel)
    }
    else if magic = 0x5A31
        LGIPicked(sel)
    else if magic = 0x5A13 {
        if (sel = "`f")
            FFMImportClip()
        else
            FFMImportFiles(sel)
    }
    else if magic = 0x5A12
        ScrLoadFile(sel)
    else
        ApplyAvatar(sel)
    return 1
}

; ============================================================================
;  AVATAR CROPPER
;  Its own layered GDI+ window, same shape as the gallery: build a DIB, render
;  on a timer, drive it from raw messages. The user pans by dragging and zooms
;  with the wheel; the circle shows exactly what the profile picture will be.
;  On confirm the chosen source rect is resampled into a SELW square and added
;  to the pool as a normal custom avatar.
; ============================================================================
global cropUIOn := 0, cropHwnd := 0

; src can be a file path, or an existing pool index to re-crop
; bmpIn: an already-decoded bitmap the cropper takes ownership of (used for
; embedded pictures, where the pool only holds a pre-cropped square).
CropOpen(src, poolIdx := 0, bmpIn := 0) {
    global cropUIOn, cropHwnd, G, hubP, pickFor
    if cropUIOn {
        if cropHwnd && WinExist("ahk_id " cropHwnd)
            return
        cropUIOn := 0, cropHwnd := 0
    }

    ; ---- load the source at full resolution where we can ----
    srcBmp := 0, ownBmp := 0
    if bmpIn
        srcBmp := bmpIn, ownBmp := 1
    else if (src != "" && FileExist(src)) {
        if DllCall("gdiplus\GdipCreateBitmapFromFile", "wstr", src, "ptr*", &srcBmp := 0)
            srcBmp := 0
        ownBmp := 1
    }
    if (!srcBmp && poolIdx >= 1 && poolIdx <= selfies.Length)
        srcBmp := selfies[poolIdx]                  ; borrowed - do not dispose
    if !srcBmp {
        FFMSay("COULD NOT OPEN THAT IMAGE", C_ACC)
        return
    }
    DllCall("gdiplus\GdipGetImageWidth",  "ptr", srcBmp, "uint*", &iw := 0)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", srcBmp, "uint*", &ih := 0)
    if (!iw || !ih) {
        if ownBmp
            DllCall("gdiplus\GdipDisposeImage", "ptr", srcBmp)
        return
    }

    cropUIOn := 1
    mainG4 := G0

    ; ---- layout ----
    DIA := 236                                       ; crop circle diameter
    CW4 := 360, ty4 := 62
    footY4 := ty4 + DIA + 46
    CH4 := footY4 + 34 + 16
    PD4 := 24
    BW4 := CW4 + PD4*2, BH4 := CH4 + PD4*2
    GW4 := Round(BW4*scaleF), GH4 := Round(BH4*scaleF)
    cx4 := PD4, cy4 := PD4
    ccx := cx4 + CW4/2, ccy := cy4 + ty4 + DIA/2

    ; ---- crop state: side = length of the source square we sample ----
    fitSide := Min(iw, ih)
    minSide := Max(24, Round(fitSide*0.18))          ; ~5.5x max zoom
    side    := fitSide + 0.0
    ctrX    := iw/2.0, ctrY := ih/2.0
    sideT   := side, ctrXT := ctrX, ctrYT := ctrY

    ClampCtr() {
        h := side/2
        ctrXT := Clamp(ctrXT, h, iw - h)
        ctrYT := Clamp(ctrYT, h, ih - h)
        if (side >= iw)
            ctrXT := iw/2.0
        if (side >= ih)
            ctrYT := ih/2.0
    }

    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", GW4, bi, 4), NumPut("int", -GH4, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    hbm4 := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0, "ptr*", &pb4 := 0, "ptr", 0, "uint", 0, "ptr")
    hdc4 := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", hdc4, "ptr", hbm4, "ptr")
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", hdc4, "ptr*", &G4 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", G4, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G4, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", G4, "int", 2)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G4, "int", 7)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G4, "float", GW4/BW4, "float", GH4/BH4, "int", 0)

    crGui := Gui("-Caption +E0x80000 +E0x8000000 " (hubTop ? "+AlwaysOnTop " : "") "+ToolWindow -DPIScale", "YURICROP")
    cropHwnd := crGui.Hwnd
    DllCall("SetWindowPos", "ptr", cropHwnd, "ptr", HubTopZ(), "int", 0, "int", 0, "int", GW4, "int", GH4, "uint", 0x10)
    HubReassert()
    DllCall("SetWindowPos", "ptr", cropHwnd, "ptr", HubTopZ(), "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    ; always centre on the monitor - the hub may be minimised, dragged off to
    ; one side, or not running at all when a picture is picked
    MonitorGetWorkArea(MonitorGetPrimary(), &mL4, &mT4, &mR4, &mB4)
    crbx := mL4 + ((mR4 - mL4) - GW4)//2
    crby := mT4 + ((mB4 - mT4) - GH4)//2
    crbx := Clamp(crbx, mL4 + 8, mR4 - GW4 - 8)
    crby := Clamp(crby, mT4 + 8, mB4 - GH4 - 8)
    crpx := crbx, crpy := crby

    crIntro := A_TickCount
    crCloseAt := 0, crCommit := 0, crOkAt := 0
    crDrag := 0, crPanning := 0
    ; drag feel, the same three values every draggable card carries: an eased
    ; 0..1 driving the whole animation, a velocity-driven tilt, and last
    ; frame's x so that velocity can be measured
    crDragT := 0.0, crTilt := 0.0, crPrevBX := crbx
    crGX := 0, crGY := 0, crGrabX := 0, crGrabY := 0
    crPanCX := 0.0, crPanCY := 0.0
    crLBP := GetKeyState("LButton", "P") ? 1 : 0
    crHov := 0
    crH := Map()                       ; eased hover per zone
    crPressZ := 0, crPressAt := 0      ; click-pop feedback
    crSlide := 0                       ; dragging the zoom slider
    ; zoom slider geometry, shared by the hit test and the renderer
    zbw := 120, zbx := ccx - zbw/2, zby := ccy + DIA/2 + 13

    OnMessage(0x84, CrHT), OnMessage(0x201, CrClick), OnMessage(0x202, CrUp)
    OnMessage(0x200, CrMove), OnMessage(0x20, CrCur), OnMessage(0x20A, CrWheel)
    CrRender()
    Critical "Off"
    HubReassert()
    DllCall("ShowWindow", "ptr", cropHwnd, "int", 4)
    ; raise above the hub, which re-asserts itself topmost on its own timer
    GalZFix()
    SetTimer(GalZFix, -60)
    SetTimer(GalZFix, -220)
    if hubLive {
        hubP := -1
        HubTim(TICK_A)
    }
    SetTimer(CrRender, TICK_A)
    return

    CrZone(sx, sy) {
        k := GW4/BW4
        ux := (sx - crpx)/k, uy := (sy - crpy)/k
        if (ux - (cx4 + CW4 - 24))**2 + (uy - (cy4 + 24))**2 <= 121
            return 2                                  ; close X
        ; 6-dot grip: the deliberate drag handle, centred in the header
        if (ux >= ccx - 24 && ux <= ccx + 24 && uy >= cy4 + 12 && uy <= cy4 + 34)
            return 7
        if uy >= cy4 + footY4 && uy <= cy4 + footY4 + 34 {
            if ux >= cx4 + CW4 - 132 && ux <= cx4 + CW4 - 24
                return 3                              ; USE PHOTO
            if ux >= cx4 + 24 && ux <= cx4 + 116
                return 4                              ; CANCEL
            if ux >= cx4 + 126 && ux <= cx4 + 198
                return 6                              ; RESET
        }
        ; the zoom slider sits just under the circle and its grab box overlaps
        ; it, so it has to be tested first
        if (ux >= zbx - 10 && ux <= zbx + zbw + 10 && uy >= zby - 9 && uy <= zby + 12)
            return 8
        if (ux - ccx)**2 + (uy - ccy)**2 <= (DIA/2 + 10)**2
            return 5                                  ; pan the picture
        ; The card itself is NOT a drag surface - the 6-dot grip is the only
        ; way to move the window. Zone 1 just marks "inside the card" so a
        ; click there is not treated as a click-away dismiss.
        if ux >= cx4 && ux <= cx4 + CW4 && uy >= cy4 && uy <= cy4 + CH4
            return 1
        return 0
    }
    ; screen X -> zoom. The track runs from "fit" on the left to the closest
    ; zoom on the right, matching the fill drawn in CrRender.
    CrSlideTo(sx) {
        k := GW4/BW4
        ux := (sx - crpx)/k
        fr := Clamp((ux - zbx)/zbw, 0.0, 1.0)
        sideT := fitSide - fr*(fitSide - minSide)
        side  := sideT                       ; follow the handle exactly
        ClampCtr()
        ctrX := ctrXT, ctrY := ctrYT
    }
    CrZoneCur() {
        CursorXY(&x, &y)
        return CrZone(x, y)
    }
    CrHT(wParam, lParam, msg, hwnd) {
        if hwnd != crGui.Hwnd
            return
        LpXY(lParam, &x, &y)
        return CrZone(x, y) ? 1 : -1
    }
    CrClick(wParam, lParam, msg, hwnd) {
        if hwnd != crGui.Hwnd || crCloseAt || crOkAt
            return
        CursorXY(&x, &y)
        z := CrZone(x, y)
        if z = 2 || z = 4 {
            crCommit := 0
            CrClose()
        } else if z = 3 {
            crCommit := 1
            crOkAt := A_TickCount
        } else if z = 6 {
            sideT := fitSide + 0.0, ctrXT := iw/2.0, ctrYT := ih/2.0
        } else if z = 5 {
            crPanning := 1, crGX := x, crGY := y
            crPanCX := ctrXT, crPanCY := ctrYT
            DllCall("SetCapture", "ptr", crGui.Hwnd)
        } else if z = 8 {
            crSlide := 1
            CrSlideTo(x)
            DllCall("SetCapture", "ptr", crGui.Hwnd)
        } else if z = 7 {
            crDrag := 1, crGX := x, crGY := y, crGrabX := crbx, crGrabY := crby
            DllCall("SetCapture", "ptr", crGui.Hwnd)
        }
        if (z >= 2)
            crPressZ := z, crPressAt := A_TickCount
        return 0
    }
    CrUp(wParam, lParam, msg, hwnd) {
        if !crDrag && !crPanning && !crSlide
            return
        DllCall("ReleaseCapture")
        crDrag := 0, crPanning := 0, crSlide := 0
        return 0
    }
    CrMove(wParam, lParam, msg, hwnd) {
        if hwnd != crGui.Hwnd || (!crDrag && !crPanning && !crSlide)
            return
        CursorXY(&x, &y)
        if crSlide {
            CrSlideTo(x)
            return 0
        }
        if crPanning {
            ; screen pixels -> source pixels: the circle shows `side` px across DIA
            k := GW4/BW4
            sc := side/(DIA*k)
            ctrXT := crPanCX - (x - crGX)*sc
            ctrYT := crPanCY - (y - crGY)*sc
            ClampCtr()
            ; follow the cursor exactly - the render easing is for zoom only,
            ; and letting it smooth the pan made it feel like it was sliding
            ctrX := ctrXT, ctrY := ctrYT
            return 0
        }
        ; move the window now rather than on the next render tick: waiting a
        ; frame is what made the card lag behind and skate past the cursor
        crbx := crGrabX + (x - crGX), crby := crGrabY + (y - crGY)
        ; the handle rule, as everywhere else - see HandleBounds
        HandleBounds(ccx - 24, cy4 + 12, ccx + 24, cy4 + 34, GW4/BW4
                   , &lox, &hix, &loy, &hiy)
        crbx := Clamp(crbx, lox, hix), crby := Clamp(crby, loy, hiy)
        crpx := crbx, crpy := crby
        DllCall("SetWindowPos", "ptr", crGui.Hwnd, "ptr", 0
            , "int", crbx, "int", crby, "int", 0, "int", 0, "uint", 0x15)
        return 0
    }
    CrWheel(wParam, lParam, msg, hwnd) {
        if hwnd != crGui.Hwnd
            return
        d := (wParam >> 16) & 0xFFFF
        d := d > 0x7FFF ? d - 0x10000 : d
        sideT := Clamp(sideT*(d > 0 ? 0.86 : 1.163), minSide, fitSide + 0.0)
        ClampCtr()
        return 0
    }
    CrCur(wParam, lParam, msg, hwnd) {
        if hwnd = crGui.Hwnd {
            zc := (crPanning || crDrag) ? 7 : CrZoneCur()
            id := (zc = 5 || zc = 7 || crPanning || crDrag) ? 32646 : 32649
            DllCall("SetCursor", "ptr", DllCall("LoadCursor", "ptr", 0, "ptr", id, "ptr"))
            return 1
        }
    }
    CrClose() {
        if crCloseAt
            return
        crCloseAt := A_TickCount
    }
    CrFinish() {
        global G, cropUIOn, cropHwnd, hubP, selN, pickFor
        SetTimer(CrRender, 0)
        OnMessage(0x84, CrHT, 0), OnMessage(0x201, CrClick, 0)
        OnMessage(0x202, CrUp, 0), OnMessage(0x200, CrMove, 0)
        OnMessage(0x20, CrCur, 0), OnMessage(0x20A, CrWheel, 0)
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", G4)
        DllCall("gdi32\DeleteDC", "ptr", hdc4)
        DllCall("gdi32\DeleteObject", "ptr", hbm4)
        crGui.Destroy()
        G := mainG4
        cropUIOn := 0, cropHwnd := 0
        if crCommit
            CropCommit(srcBmp, ctrX, ctrY, side)
        if ownBmp
            DllCall("gdiplus\GdipDisposeImage", "ptr", srcBmp)
        if !crCommit
            pickFor := 0
        if hubLive {
            HubReassert()
            hubP := -1
            HubTim(TICK_A)
        }
        GalZFix()
        SetTimer(GalZFix, -60)
        if abOn
            RendTim(TICK_A)
    }
    CrRender() {
        Critical "On"
        global G
        G := G4
        now := A_TickCount
        ThemeTick()
        it := Min((now - crIntro)/300.0, 1.0)
        ei := 1 - (1 - it)**3
        winA := Round(255*Min(it*1.8, 1.0))
        scl := 0.96 + 0.04*ei
        if crOkAt && now - crOkAt >= 180
            CrClose()
        if crCloseAt {
            ft := Min((now - crCloseAt)/220.0, 1.0)
            winA := Round(winA*(1 - ft)), scl := 1 - 0.04*ft
            if ft >= 1 {
                CrFinish()
                return
            }
        }
        ; click-away cancels
        lb := GetKeyState("LButton", "P")
        if lb && !crLBP && !crDrag && !crPanning && !crSlide && !crCloseAt && now - crIntro > 200 && CrZoneCur() = 0 {
            crCommit := 0
            CrClose()
        }
        crLBP := lb
        crDragT += ((crDrag ? 1.0 : 0.0) - crDragT)*EK(0.2)
        if crDragT < 0.004 && !crDrag
            crDragT := 0.0
        ; tilt leans into the throw: CrMove has already moved the window by the
        ; time this runs, so the frame-to-frame delta IS the drag velocity
        velX := crbx - crPrevBX, crPrevBX := crbx
        crTilt += ((crDrag ? Clamp(velX*0.22, -3.0, 3.0) : 0.0) - crTilt)*EK(0.18)
        scl *= 1 + 0.02*crDragT
        ; ease the crop transform so zoom/pan feel smooth
        side += (sideT - side)*EK(0.28)
        ctrX += (ctrXT - ctrX)*EK(0.28)
        ctrY += (ctrYT - ctrY)*EK(0.28)
        crHov := CrZoneCur()
        for hz in [1, 2, 3, 4, 5, 6, 7, 8] {
            hvv := crH.Has(hz) ? crH[hz] : 0.0
            hvv += (((crHov = hz) ? 1.0 : 0.0) - hvv)*EK(0.22)
            crH[hz] := (hvv < 0.004 && crHov != hz) ? 0.0 : hvv
        }
        yO4 := Round((1 - ei)*18*scaleF)

        ResetSurface(G, GW4/BW4, GH4/BH4)
        DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
        st4 := PushXform(cx4 + CW4/2, cy4 + CH4/2, scl, crTilt)

        ShadowDraw(cx4, cy4 + 3 + 2.5*crDragT, CW4, CH4, 18, 10, 8, 8, 1.0, GW4/BW4)
        b := BgV(cx4, cy4, CW4, CH4, 0xF2222438, 0xF8121423)
        FillRR(cx4, cy4, CW4, CH4, 18, b), DelB(b)
        ; top-level card, same treatment as the hub / gate / gallery / loading
        ; cards - PanelBackdrop overhangs deliberately, so clip first
        p4 := RRPath(cx4, cy4, CW4, CH4, 18)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p4, "int", 0)
        PanelBackdrop(cx4, cy4, CW4, CH4, hubCur, 1.0, now, 0.9)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", p4)
        pn := Pen(Alpha(hubCur, 90), 1.2)
        StrokeRR(cx4, cy4, CW4, CH4, 18, pn), DelP(pn)
        ; slow-drifting dashed accent frame (glows while dragging) - the same
        ; chrome the hub, gate, loading and gallery cards all carry, and the
        ; surface the drag glow attaches to. Inset 6 with the radius 4 under
        ; the card's, which is what the other four work out to.
        emb4 := (Sin(DecT(now)*0.004) + 1)/2
        pn := Pen(Alpha(hubCur, 20 + 10*emb4 + 46*crDragT), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
        StrokeRR(cx4 + 6, cy4 + 6, CW4 - 12, CH4 - 12, 14, pn), DelP(pn)

        Txt("CROP PICTURE", cx4 + 24, cy4 + 18, 240, 22, fBrand, Alpha(0xFFE8EAF6, 240), fmtL)
        Txt("drag the dots to move  ·  scroll to zoom", cx4 + 24, cy4 + 38, 260, 16, fHint, 0x7EC7CBE0, fmtL)

        ; ---- 6-dot grip: the drag handle (shared build, see GripDots) ----
        hvG := crH.Has(7) ? crH[7] : 0.0
        GripDots(ccx, cy4 + 23, crDrag ? 1.0 : hvG, hubCur, now)

        ; ---- close button: same build as the hub's (see HubRender) ----
        h1c := crH.Has(2) ? crH[2] : 0.0
        ec4 := 1 + 0.28*h1c
        xx := cx4 + CW4 - 24 + 3*h1c
        xy := cy4 + 24 - 1.2*h1c
        b := SBrush(Alpha(hubAccent, Round(36 + 60*h1c)))
        FillEll(xx - 7*ec4, xy - 7*ec4, 14*ec4, 14*ec4, b), DelB(b)
        pn := Pen(Alpha(hubAccent, Round(100 + 80*h1c)), 1)
        Ell(xx - 7*ec4, xy - 7*ec4, 14*ec4, 14*ec4, pn), DelP(pn)
        pn := Pen(Alpha(AccHi(hubAccent, 0.4), Round(210 + 45*h1c)), 1.5)
        Line(xx - 3.2*ec4, xy - 3.2*ec4, xx + 3.2*ec4, xy + 3.2*ec4, pn)
        Line(xx - 3.2*ec4, xy + 3.2*ec4, xx + 3.2*ec4, xy - 3.2*ec4, pn), DelP(pn)

        ; ---- the photo, clipped to the crop circle ----
        cp := DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &cpP := 0)
        DllCall("gdiplus\GdipAddPathEllipse", "ptr", cpP
            , "float", ccx - DIA/2, "float", ccy - DIA/2, "float", DIA, "float", DIA)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", cpP, "int", 0)
        b := SBrush(0xFF0C0E17)
        FillEll(ccx - DIA/2, ccy - DIA/2, DIA, DIA, b), DelB(b)
        DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", srcBmp
            , "float", ccx - DIA/2, "float", ccy - DIA/2, "float", DIA, "float", DIA
            , "float", ctrX - side/2, "float", ctrY - side/2, "float", side, "float", side
            , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", cpP)

        ; ring reacts while the picture is being moved
        hvC := Max(crH.Has(5) ? crH[5] : 0.0, crPanning ? 1.0 : 0.0)
        if (hvC > 0.01) {
            pn := Pen(Alpha(hubCur, Round(60*hvC)), 6)
            Ell(ccx - DIA/2, ccy - DIA/2, DIA, DIA, pn), DelP(pn)
        }
        pn := Pen(Alpha(AccHi(hubCur, 0.35 + 0.25*hvC), Round(200 + 55*hvC)), 2)
        Ell(ccx - DIA/2, ccy - DIA/2, DIA, DIA, pn), DelP(pn)
        ; rule-of-thirds guides, only while you are actually adjusting
        if (hvC > 0.01) {
            pn := Pen(Alpha(0xFFFFFF, Round(52*hvC)), 1)
            loop 2 {
                k := A_Index
                off := DIA*(k/3.0) - DIA/2
                Line(ccx - DIA/2 + 6, ccy + off, ccx + DIA/2 - 6, ccy + off, pn)
                Line(ccx + off, ccy - DIA/2 + 6, ccx + off, ccy + DIA/2 - 6, pn)
            }
            DelP(pn)
        }
        ; sweeping tick marks around the rim, faster while panning
        pn := Pen(Alpha(AccHi(hubCur, 0.4), Round(70 + 90*hvC)), 1.4)
        Arc(ccx - DIA/2 - 5, ccy - DIA/2 - 5, DIA + 10, DIA + 10
            , Mod(DecT(now)*(0.04 + 0.08*hvC), 360), 40, pn), DelP(pn)

        ; zoom readout
        zf := fitSide/Max(1.0, side)
        zfr := Clamp((fitSide - side)/Max(1.0, fitSide - minSide), 0.0, 1.0)
        ; zbx / zbw / zby come from the shared geometry so the handle and its
        ; hit box can never drift apart
        hvZ := Max(crH.Has(8) ? crH[8] : 0.0, crSlide ? 1.0 : 0.0)
        zh := 3 + 1.5*hvZ
        b := SBrush(Alpha(0xFFFFFF, Round(22 + 22*hvZ)))
        FillRR(zbx, zby - (zh - 3)/2, zbw, zh, zh/2, b), DelB(b)
        b := SBrush(Alpha(hubCur, Round(200 + 55*hvZ)))
        FillRR(zbx, zby - (zh - 3)/2, Max(zh, zbw*zfr), zh, zh/2, b), DelB(b)
        kr8 := 3.5 + 1.6*hvZ
        if (hvZ > 0.01) {
            b := SBrush(Alpha(hubCur, Round(70*hvZ)))
            FillEll(zbx + zbw*zfr - kr8 - 4, zby + 1.5 - kr8 - 4, (kr8 + 4)*2, (kr8 + 4)*2, b), DelB(b)
        }
        b := SBrush(Alpha(AccHi(hubCur, 0.5 + 0.3*hvZ), 245))
        FillEll(zbx + zbw*zfr - kr8, zby + 1.5 - kr8, kr8*2, kr8*2, b), DelB(b)
        Txt(Format("{:.1f}x", zf), ccx - 30, ccy + DIA/2 + 22, 60, 16, fBadge, Alpha(0xFFC7CBE0, 185), fmtC)

        ; ---- buttons ----
        CrBtn(4, cx4 + 24,  cy4 + footY4, 92,  34, "CANCEL", 0)
        CrBtn(6, cx4 + 126, cy4 + footY4, 72,  34, "RESET",  0)
        CrBtn(3, cx4 + CW4 - 132, cy4 + footY4, 108, 34, "USE PHOTO", 1)

        ; ---- drag overlay ----
        ; Drawn last so it covers the whole card including the crop circle and
        ; the buttons - the point is that nothing on it is interactive while it
        ; is being moved. Identical build to the hub, gate, gallery and overlay
        ; cards: scrim, marching dashed frame, four-way move glyph, MOVING.
        if crDragT > 0.01 {
            d := crDragT
            b := SBrush(Alpha(0x0B0C14, 122*d))
            FillRR(cx4, cy4, CW4, CH4, 18, b), DelB(b)
            pn := Pen(Alpha(hubCur, 205*d), 1.6)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
            StrokeRR(cx4 + 3, cy4 + 3, CW4 - 6, CH4 - 6, 15, pn), DelP(pn)
            mcx := cx4 + CW4/2, mcy := cy4 + CH4/2 - 7
            pn := Pen(Alpha(0xFFFFFF, 225*d), 1.8)
            loop 4 {
                a_ := (A_Index - 1) * 1.5708
                x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
                Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
            }
            DelP(pn)
            Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, Alpha(0xFFFFFF, 235*d), fmtC)
        }

        Pop(st4)

        pt0 := Buffer(8, 0)
        sz := Buffer(8), NumPut("int", GW4, "int", GH4, sz)
        crpx := crbx, crpy := crby
        ptd := Buffer(8), NumPut("int", crpx, "int", crpy + (crDrag ? 0 : yO4), ptd)
        bf := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
        DllCall("user32\UpdateLayeredWindow", "ptr", crGui.Hwnd, "ptr", 0, "ptr", ptd
            , "ptr", sz, "ptr", hdc4, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
        G := mainG4
        Critical "Off"
    }
    CrBtn(z, bx, by, bw, bh, label, prim) {
        hv := Ease3(crH.Has(z) ? crH[z] : 0.0)
        nowB := A_TickCount
        pr := 0.0, rip := 0.0
        if (crPressZ = z && nowB - crPressAt < 400) {
            el := nowB - crPressAt
            pr  := el < 90 ? el/90.0 : Max(0.0, 1 - EBackOut(Clamp((el - 90)/310.0, 0.0, 1.0), 1.7))
            rip := Clamp(el/400.0, 0.0, 1.0)
        }
        stB4 := PushXform(bx + bw/2, by + bh/2, 1 + 0.04*hv - 0.05*pr, 0)
        if (rip > 0.01 && rip < 1.0) {
            rr4 := rip**0.55
            pn := Pen(Alpha(prim ? 0xFFFFFFFF : hubCur, Round(170*(1 - rip)**1.6)), 1.4*(1 - rip) + 0.3)
            StrokeRR(bx - 12*rr4, by - 8*rr4, bw + 24*rr4, bh + 16*rr4, 8 + 6*rr4, pn), DelP(pn)
        }
        if prim {
            loop 3 {
                k4 := A_Index
                b := SBrush(Alpha(hubCur, Round((18 - k4*5)*(0.35 + 0.65*hv))))
                FillRR(bx - k4*1.5, by + k4, bw + k4*3, bh + k4, 10 + k4, b), DelB(b)
            }
            mixB := (0.24 + 0.16*hv - 0.10*pr)*(1 - thT) + (0.10*hv)*thT
            b := VBrush(bx, by, bw, bh, AccHi(hubCur, mixB), Mix(hubCur, 0xFF000000, 0.16 + 0.10*pr))
            FillRR(bx, by, bw, bh, 8, b), DelB(b)
            MicroBackdrop(bx, by, bw, bh, 8, hubCur, 1.0, nowB, 0.6)
            gl4 := Round((36 + 26*hv - 16*pr)*(1 - thT))
            if (gl4 > 1) {
                b := SBrush(Alpha(0xFFFFFF, gl4))
                FillRR(bx + 1, by + 1, bw - 2, bh*0.40, 7, b), DelB(b)
            }
            tc := Alpha(THMix(0xFF080C18, 0xFFFDFDFE, thT), 252)
        } else {
            b := SBrush(Alpha(0x000000, Round(14*(0.5 + 0.5*hv))))
            FillRR(bx - 1, by + 1 + hv, bw + 2, bh + 1, 9, b), DelB(b)
            b := VBrush(bx, by, bw, bh, Mix(0xFF171A30, 0xFF232744, hv), 0xFF12141F)
            FillRR(bx, by, bw, bh, 8, b), DelB(b)
            MicroBackdrop(bx, by, bw, bh, 8, hubCur, 1.0, nowB, 0.9)
            pn := Pen(Alpha(hubCur, Round(75 + 120*hv)), 1)
            StrokeRR(bx, by, bw, bh, 8, pn), DelP(pn)
            sh1 := Round((20 + 22*hv)*(1 - thT))
            if (sh1 > 1) {
                b := SBrush(Alpha(0xFFFFFF, sh1))
                FillRR(bx + 3, by + 1, bw - 6, 2, 1, b), DelB(b)
            }
            if (hv > 0.02) {
                uw4 := (bw - 16)*hv
                b := SBrush(Alpha(hubCur, Round(170*hv)))
                FillRR(bx + bw/2 - uw4/2, by + bh - 3, uw4, 2, 1, b), DelB(b)
            }
            tc := Alpha(THMix(0xFFC0C4DC, 0xFFFFFFFF, hv), 215 + 40*hv)
        }
        TxtP(label, bx, by - 1 - 0.6*hv + 0.8*pr, bw, bh, fBadge, tc, fmtC)
        Pop(stB4)
    }
}

; Open the cropper on an existing pool entry. Uses the original file when we
; still have it so the crop is done at full resolution rather than from the
; already-downscaled pool thumbnail.
CropFromPool(idx) {
    global selfies, selSrc, selEmb, embImgs
    if (idx < 1 || idx > selfies.Length)
        return
    src := (idx <= selSrc.Length) ? selSrc[idx] : ""
    if (src != "" && FileExist(src)) {
        CropOpen(src, idx)                       ; original file, full resolution
        return
    }
    ; Embedded picture: the pool only holds a pre-cropped square, so decode the
    ; original base64 again and hand the cropper the whole image.
    nm := (idx <= selEmb.Length) ? selEmb[idx] : ""
    if (nm != "") {
        for e in embImgs {
            if (e.name = nm) {
                if full := BitmapFromB64(e.b64) {
                    CropOpen("", idx, full)      ; cropper takes ownership
                    return
                }
                break
            }
        }
    }
    CropOpen("", idx)
}

; render the chosen source square into a pool-sized avatar and select it
CropCommit(srcBmp, cx, cy, side) {
    global selfies, selTall, selSrc, selEmb, selN, pickFor, selCustomIdx
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SELW, "int", SELW
        , "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &sq := 0)
    if !sq
        return
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", sq, "ptr*", &g5 := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g5, "int", 7)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", g5, "ptr", srcBmp
        , "float", 0, "float", 0, "float", SELW, "float", SELW
        , "float", cx - side/2, "float", cy - side/2, "float", side, "float", side
        , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g5)

    ; the gate hero wants a tall crop of the same region, letterboxed from it
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SELW, "int", SELTH
        , "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &tl := 0)
    if tl {
        DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", tl, "ptr*", &g6 := 0)
        DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g6, "int", 7)
        tallH := side*(SELTH/SELW)
        DllCall("gdiplus\GdipDrawImageRectRect", "ptr", g6, "ptr", srcBmp
            , "float", 0, "float", 0, "float", SELW, "float", SELTH
            , "float", cx - side/2, "float", cy - tallH/2, "float", side, "float", tallH
            , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", g6)
    } else {
        tl := sq
    }

    ; Persist under a name the gallery scan ignores, then take the dedicated
    ; slot - replacing it in place if one already exists, so repeated crops
    ; never grow the pool and never appear in the Gallery.
    dst := YURI_AV "\profile_crop.png"
    SaveAvatarPng(sq, dst)
    if (selCustomIdx >= 1 && selCustomIdx <= selfies.Length) {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", selfies[selCustomIdx])
        try DllCall("gdiplus\GdipDisposeImage", "ptr", selTall[selCustomIdx])
        selfies[selCustomIdx] := sq, selTall[selCustomIdx] := tl
        selSrc[selCustomIdx] := dst, selEmb[selCustomIdx] := ""
    } else {
        selfies.Push(sq), selTall.Push(tl), selSrc.Push(dst), selEmb.Push("")
        selCustomIdx := selfies.Length
    }
    selN := selfies.Length

    if pickFor >= 1 && pickFor <= SHList.Length {
        SHList[pickFor].av := selCustomIdx
        ScrSaveList()
        pickFor := 0
    } else {
        global profPicSet
        profPicSet := 1
        SelSwitchG(selCustomIdx)
        ProfPicSave()
    }
    if hubLive
        HubPoke()
}

; ================= Gallery: editing the rotation =================
; ---- one-time rename of manager-added files from the previous build ----
; They went in as selfie_<tick>_<n>, which is the same pattern the base set and
; the profile-picture picker use, and is exactly why those two ended up sharing
; images. The match is deliberately strict - selfie_ then digits then _ then
; digits - so somebody's own "selfie_beach.jpg" is left alone.
GalMigrateAdded() {
    global galHide
    ren := Map()
    for pat in ["selfie_*.png", "selfie_*.jpg", "selfie_*.jpeg"] {
        loop Files, YURI_AV "\" pat {
            if !RegExMatch(A_LoopFileName, "i)^selfie_(\d+_\d+\.(?:png|jpe?g))$", &m)
                continue
            nn := "galimg_" m[1]
            try {
                FileMove(A_LoopFileFullPath, YURI_AV "\" nn, 0)
                ren[StrLower(A_LoopFileName)] := StrLower(nn)
            }
        }
    }
    if !ren.Count
        return
    ; the hide list keys on the filename, so anything renamed has to follow
    out := ""
    for p in StrSplit(galHide, "|") {
        if p = ""
            continue
        q := ren.Has(p) ? ren[p] : p
        out .= (out = "" ? "" : "|") q
    }
    galHide := out
    try IniWrite(galHide, iniPath, "gallery", "hidden")
}
GalHidden(name) => (galHide != "" && InStr("|" galHide "|", "|" StrLower(name) "|") > 0)
; First and last POOL index in the display rotation. Everything past GalHi() is
; either out of the rotation or the cropped profile picture, and everything
; before GalLo() is the overlay portrait.
; Was this pool entry added through the manager? Derived from the filename
; rather than a parallel array, so it cannot drift out of step with the four
; arrays PoolAdd already has to keep aligned.
SelIsGalOnly(idx) => SubStr(StrLower(SelKey(idx)), 1, 7) = "galimg_"
GalAddedN() {
    n := 0
    for pat in ["galimg_*.png", "galimg_*.jpg", "galimg_*.jpeg"] {
        loop Files, YURI_AV "\" pat
            n++
    }
    return n
}
GalLo() => gateBase + 1
GalHi() => gateBase + Max(1, galRotN)
GalHasRot() => galRotN >= 1
GalHideSet(name, hide) {
    global galHide
    k := StrLower(name)
    parts := []
    for p in StrSplit(galHide, "|") {
        if (p != "" && p != k)
            parts.Push(p)
    }
    if hide
        parts.Push(k)
    out := ""
    for p in parts
        out .= (out = "" ? "" : "|") p
    galHide := out
    try IniWrite(galHide, iniPath, "gallery", "hidden")
}
GalHidNSync() {
    global galHidN
    galHidN := GalHiddenN()
}
; Every gallery-eligible image on the machine, in or out of the rotation, so
; the manager can offer a removed one back. Deliberately reads DISK and the
; embedded list rather than the pool: the pool only ever holds what is
; currently in rotation, which is the whole point of it.
GalCandidates() {
    out := [], seen := Map()
    for pat in ["avatar_1.jpg", "avatar_1.jpeg", "avatar_1.png"
              , "selfie*.png", "selfie*.jpg", "selfie*.jpeg"
              , "galimg_*.png", "galimg_*.jpg", "galimg_*.jpeg"] {
        loop Files, YURI_AV "\" pat {
            k := StrLower(A_LoopFileName)
            if seen.Has(k)
                continue
            seen[k] := 1
            out.Push({name: A_LoopFileName, on: !GalHidden(A_LoopFileName)})
        }
    }
    for e in embImgs {
        k := StrLower(e.name)
        if (seen.Has(k) || e.b64 = "" || k = "avatar.jpg")
            continue
        seen[k] := 1
        out.Push({name: e.name, on: !GalHidden(e.name)})
    }
    return out
}
GalHiddenN() {
    n := 0
    for c in GalCandidates() {
        if !c.on
            n++
    }
    return n
}
; ---- rebuild the pool in place ----
; Called after anything changes the rotation. Safe only from an input handler,
; never from inside a frame: it frees every bitmap the renderer draws from, so
; a half-finished frame would be blitting from freed handles. Every carousel
; index is re-clamped afterwards, because the pool they point into no longer
; has the length they were clamped against.
GalReload() {
    global selfies, selTall, selSrc, selEmb, selN, selCur, selNext, selFadeAt, profPicSet
    ; ---- the profile picture is NOT a gallery carousel ----
    ; selCur/selNext are the overlay's DISPLAY PICTURE, and the first version of
    ; this pointed them at the newest gallery image along with everything else -
    ; so adding a picture to the rotation silently changed the user's profile
    ; picture to it, and wrote that choice to the ini on exit.
    ;
    ; It is remembered the same way a launch remembers it: by SelKey, because
    ; adding or removing anything renumbers the pool underneath it.
    pk := (selN >= 1 && selCur >= 1 && selCur <= selN) ? SelKey(selFadeAt ? selNext : selCur) : ""
    for bm in selfies {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", bm)
    }
    for bm in selTall {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", bm)
    }
    selfies := [], selTall := [], selSrc := [], selEmb := [], selN := 0
    LoadSelfiePool()
    selFadeAt := 0
    pi := (pk != "") ? SelFindKey(pk) : 0
    ; A gallery-only picture is not a valid profile picture - it is never
    ; offered as one. Rejecting it here heals the state left behind by the bug
    ; described above, which could have written one into the ini.
    if (pi && SelIsGalOnly(pi))
        pi := 0
    if pi
        selCur := pi, selNext := pi
    else {
        selCur := 1, selNext := 1
        if (pk != "")
            profPicSet := 0
    }
    ; The GALLERY carousels do restart on the last entry, which is the newest
    ; picture: after adding one the thing you want to see is the one you added,
    ; and after removing one you want proof it is gone.
    hi := GalHi()
    if IsObject(HL) {
        HL.lgIdx := hi, HL.lgNext := hi
        HL.mbIdx := hi, HL.mbNext := hi
        HL.lgFadeAt := 0, HL.mbFade := 0, HL.lgAt := A_TickCount, HL.mbAt := A_TickCount
    }
    GalHidNSync()
    ShadowFlush()
    if hubLive
        HubPoke()
}
; Take an image OUT of the rotation by pool index. The file stays where it is.
GalRemovePool(idx) {
    k := SelKey(idx)
    if k = ""
        return 0
    GalHideSet(k, 1)
    GalReload()
    return 1
}
; ---- RESET ----
; Back to the gallery as shipped: the three base pictures (avatar_1, selfie3,
; selfie4) plus anything the user put in the avatars folder by hand, which was
; never the manager's to take away. Everything the manager added is moved to
; an archive folder rather than deleted - these are photographs, and a button
; on a settings page should not be the last word on one - but they are out of
; the pool for good, so an added picture is not something RESET can bring back.
GalResetGallery() {
    global galHide
    arc := YURI_AV "\archive"
    if !DirExist(arc)
        try DirCreate(arc)
    for pat in ["galimg_*.png", "galimg_*.jpg", "galimg_*.jpeg"] {
        loop Files, YURI_AV "\" pat {
            src := A_LoopFileFullPath, nm := A_LoopFileName
            dst := arc "\" nm
            k := 1
            while (FileExist(dst) && k < 500) {
                SplitPath(nm, , , &ex, &nx)
                dst := arc "\" nx "_" (k++) "." ex
            }
            try FileMove(src, dst, 0)
        }
    }
    ; every removal is undone as well - RESET means the default state, and the
    ; default state has nothing hidden
    galHide := ""
    try IniWrite("", iniPath, "gallery", "hidden")
    GalReload()
}
; ---- adding ----
; The file dialog runs in a child process, the same way avatar picking does: a
; modal dialog on this thread would stall the render loop and the message pump
; behind it. "M3" is multi-select, so several photos go in at once.
GalPickFiles() {
    global pickerPid
    if pickerPid && ProcessExist(pickerPid)
        return
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" galpick ' ui.Hwnd
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" galpick ' ui.Hwnd
    try Run(cmd, , , &pickerPid)
    HubPickWatch(pickerPid)   ; raise the hub again when the dialog closes
}
; Reply from that child. FileSelect "M" returns the FOLDER on the first line
; and bare filenames after it, so a single-file pick and a multi-file pick do
; not have the same shape and both have to be unpacked.
GalAddGot(sel) {
    lines := StrSplit(sel, "`n", "`r")
    files := []
    if (lines.Length >= 2 && DirExist(lines[1])) {
        loop lines.Length - 1
            files.Push(lines[1] "\" lines[A_Index + 1])
    } else if (lines.Length >= 1 && lines[1] != "")
        files.Push(lines[1])
    n := 0, seq := 0, stamp := A_TickCount
    for fp in files {
        if !FileExist(fp)
            continue
        SplitPath(fp, , , &ext)
        if !RegExMatch(StrLower(ext), "^(png|jpg|jpeg)$")
            continue
        ; galimg_ marks it as gallery-only, so the profile-picture picker never
        ; offers it and RESET knows to archive it. The sequence increments on
        ; every file rather than on every SUCCESS: keying it off the success
        ; count meant one failed copy handed the next file the same name, and
        ; FileCopy with overwrite off then failed on all of them. One timestamp
        ; for the batch, because A_TickCount does not move inside this loop.
        seq++
        dst := YURI_AV "\galimg_" stamp "_" seq "." StrLower(ext)
        try {
            FileCopy(fp, dst, 0)
            ; re-adding something that had been removed must bring it back IN
            SplitPath(dst, &dn)
            GalHideSet(dn, 0)
            n++
        }
    }
    if n
        GalReload()
    return n
}

GalReopenManage() {
    GalleryPick(0, 1)
}
; ---- Gallery: pick the overlay display picture ----
GalleryPick(target := 0, manage := 0) {
    global galOpen, G, galTarget, galHwnd, hubP, galManage
    galManage := manage ? 1 : 0
    if galOpen {
        if galHwnd && WinExist("ahk_id " galHwnd)
            return
        galOpen := 0, galHwnd := 0
    }
    if selN < 1 {
        PickAvatar()
        return
    }
    galTarget := (target >= 1 && target <= SHList.Length) ? target : 0
    galOpen := 1
    mainG3 := G0

    ; the custom crop is always last in the pool - leave it out of the grid,
    ; unless it is the only picture there is
    ; Only pictures the user may pick as a profile picture. avatar_1 is a stock
    ; portrait shown elsewhere, and the custom crop is their current one - both
    ; are skipped here, so the grid needs a map back to real pool indices.
    galIdx := []
    if galManage {
        ; Exactly the rotation, GalLo()..GalHi(). Not the pool: entries past
        ; GalHi() are pictures already taken out, and RESTORE brings those back
        ; as a set - listing them here greyed out would only invite clicking
        ; "remove" on something already removed.
        if GalHasRot() {
            loop GalHi() - GalLo() + 1
                galIdx.Push(GalLo() + A_Index - 1)
        }
    } else {
        ; The profile-picture picker and the Gallery are two different
        ; sets that happen to share one pool. Pictures added through the gallery
        ; manager belong to the gallery alone, so they are skipped here - adding
        ; a wallpaper to the rotation should not put it in the list of faces.
        loop selN {
            if (A_Index = selAv1Idx || A_Index = selCustomIdx || SelIsGalOnly(A_Index))
                continue
            galIdx.Push(A_Index)
        }
    }
    ; Picker only. In manage mode an empty rotation must stay empty: the
    ; fallback fills the list with the WHOLE pool, and a click in the manager
    ; removes what it lands on - which would have let somebody hide the overlay
    ; portrait or their own cropped profile picture from a screen that is not
    ; supposed to reach either.
    if (!galIdx.Length && !galManage)
        loop selN
            galIdx.Push(A_Index)
    show := Min(galIdx.Length, galManage ? 12 : 8)
    cols := Min(show, 4)
    rows := (show + 3) // 4
    TH := 64, GP := 14
    ; 360 in manage mode, not 300. The footer carries the ADD button on the left
    ; AND the RESET button on the right, and at the 300 minimum - which is what
    ; a card with fewer than four pictures clamps to - the two had nowhere to go
    ; but through each other.
    CW3 := Max(galManage ? 360 : 300, 48 + cols*TH + (cols - 1)*GP)
    ty0 := 58
    footY := ty0 + rows*(TH + GP) - GP + 16
    CH3 := footY + 30 + 18
    PD3 := 24
    BW3 := CW3 + PD3*2, BH3 := CH3 + PD3*2
    GW3 := Round(BW3*scaleF), GH3 := Round(BH3*scaleF)
    cx3 := PD3, cy3 := PD3

    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", GW3, bi, 4), NumPut("int", -GH3, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    hbm3 := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0, "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    hdc3 := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", hdc3, "ptr", hbm3, "ptr")
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", hdc3, "ptr*", &G3 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", G3, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G3, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", G3, "int", 2)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G3, "float", GW3/BW3, "float", GH3/BH3, "int", 0)

    galGui := Gui("-Caption +E0x80000 +E0x8000000 " (hubTop ? "+AlwaysOnTop " : "") "+ToolWindow -DPIScale", "YURIGALLERY")
    galHwnd := galGui.Hwnd
    ; size/position without ever showing it - avoids Gui.Show's activation path
    DllCall("SetWindowPos", "ptr", galHwnd, "ptr", HubTopZ()
        , "int", 0, "int", 0, "int", GW3, "int", GH3, "uint", 0x10)
    HubReassert()
    DllCall("SetWindowPos", "ptr", galHwnd, "ptr", HubTopZ(), "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    if hubLive
        ox := HL.px, oy := HL.py, ow := HL.pw, oh := HL.ph
    else
        WinGetPos(&ox, &oy, &ow, &oh, ui.Hwnd)
    glbx := ox + (ow - GW3)//2, glby := oy + (oh - GH3)//2
    ; The monitor the PARENT is on, not the primary. This centres on the hub and
    ; then clamped against MonitorGetPrimary(), so opening the gallery from a hub
    ; on a second display threw the card back onto the first one.
    MonWorkAreaAt(ox + ow//2, oy + oh//2, &mL, &mT, &mR, &mB)
    ; a card taller than the work area inverts the range; centre it rather than
    ; let Clamp pin it to the top edge
    glbx := (mR - GW3 - 8 < mL + 8) ? mL + ((mR - mL) - GW3)//2 : Clamp(glbx, mL + 8, mR - GW3 - 8)
    glby := (mB - GH3 - 8 < mT + 8) ? mT + ((mB - mT) - GH3)//2 : Clamp(glby, mT + 8, mB - GH3 - 8)
    glpx := glbx, glpy := glby

    glIntro := A_TickCount
    glCloseAt := 0, glPend := 0, glPickAt := 0, galRmIdx := 0
    ; sampled once at open rather than per frame - both of these walk the folder
    glHidN := galManage ? (GalHiddenN() + GalAddedN()) : 0
    ; ---- footer right-hand block ----
    ; Derived from where the ADD button actually ENDS (cx3 + 24 + 134) rather
    ; than from a fixed inset off the right edge. The first version used
    ; CW3 - 172, which is only clear of the button on a card at least 330 wide -
    ; so the overlap appeared and disappeared with the number of pictures.
    fbX := Max(24 + 134 + 12, CW3 - 172)
    fbW := CW3 - 24 - fbX
    glHovE := 0.0, glHovIdx := 0, glBrE := 0.0, glClE := 0.0, glGrE := 0.0
    ; grip centred on the card, nudged right off the title
    glGx := cx3 + CW3/2 + 10, glGy := cy3 + 20
    glDrag := 0, glrX := 0, glrY := 0, glrBX := 0, glrBY := 0, glLBP := GetKeyState("LButton", "P") ? 1 : 0
    glDragT := 0.0, glTilt := 0.0, glPrevBX := glbx
    ; 0 when nothing is chosen yet, so no grid tile gets the "current" tick
    curSel := galTarget ? SHList[galTarget].av
            : (profPicSet ? (selFadeAt ? selNext : selCur) : 0)

    OnMessage(0x84, GalHT), OnMessage(0x201, GalClick), OnMessage(0x202, GalUp)
    OnMessage(0x200, GalMove), OnMessage(0x20, GalCur)
    ; fill and position the surface first, then show - the window is never
    ; visible without content, so there is no empty or black frame
    GalRender()
    Critical "Off"
    HubReassert()
    DllCall("ShowWindow", "ptr", galHwnd, "int", 4)
    GalZFix()
    SetTimer(GalZFix, -60)
    SetTimer(GalZFix, -220)
    if hubLive {
        hubP := -1
        HubTim(TICK_A)
    }
    SetTimer(GalRender, TICK_A)
    return

    GalZone(sx, sy) {
        k := GW3/BW3
        ux := (sx - glpx)/k, uy := (sy - glpy)/k
        if (ux - (cx3 + CW3 - 22))**2 + (uy - (cy3 + 22))**2 <= 81
            return 2
        if ux >= cx3 + 24 && ux <= cx3 + 158 && uy >= cy3 + footY && uy <= cy3 + footY + 30
            return 3
        ; RESTORE sits where the hint text does, and only exists when there is
        ; something to restore - removal has to be undoable from the same place
        ; it is done, or it is a delete with extra steps.
        if (galManage && glHidN > 0 && ux >= cx3 + fbX && ux <= cx3 + fbX + fbW
            && uy >= cy3 + footY && uy <= cy3 + footY + 30)
            return 5
        ; 6-dot grip - the labelled drag handle
        if ux >= glGx - 26 && ux <= glGx + 26 && uy >= glGy - 12 && uy <= glGy + 12
            return 7
        loop show {
            i := A_Index
            tx := cx3 + 24 + Mod(i - 1, 4)*(TH + GP)
            ty := cy3 + ty0 + ((i - 1) // 4)*(TH + GP)
            if ux >= tx - 2 && ux <= tx + TH + 2 && uy >= ty - 2 && uy <= ty + TH + 2
                return 19 + i
        }
        ; The card itself is NOT a drag surface - the 6-dot grip is the only
        ; way to move the window. Zone 4 just marks "inside the card" so a
        ; click there is not treated as a click-away dismiss.
        if ux >= cx3 && ux <= cx3 + CW3 && uy >= cy3 && uy <= cy3 + CH3
            return 4
        return 0
    }
    GalZoneCur() {
        CursorXY(&x, &y)
        return GalZone(x, y)
    }
    GalHT(wParam, lParam, msg, hwnd) {
        if hwnd != galGui.Hwnd
            return
        LpXY(lParam, &x, &y)
        return GalZone(x, y) ? 1 : -1
    }
    GalClick(wParam, lParam, msg, hwnd) {
        if hwnd != galGui.Hwnd || glCloseAt || glPickAt
            return
        CursorXY(&x, &y)
        z := GalZone(x, y)
        if z = 2 {
            glPend := 0
            GalClose()
        } else if z = 5 {
            glPend := -4                             ; put every removed image back
            GalClose()
        } else if z = 3 {
            glPend := galManage ? -2 : -1            ; add images / browse computer
            GalClose()
        } else if z >= 20 {
            gi := z - 19
            glPend := (gi >= 1 && gi <= galIdx.Length) ? galIdx[gi] : 0
            ; In manage mode a tile click removes rather than picks. The card is
            ; closed and reopened rather than re-laid-out in place: the grid
            ; size, the card size and every hit zone are computed once at open
            ; from the image count, so changing the count means opening again.
            if (galManage && glPend >= 1)
                galRmIdx := glPend, glPend := -3
            glPickAt := A_TickCount                  ; confirm flash, then close
        } else if z = 7 {
            glDrag := 1, glrX := x, glrY := y, glrBX := glbx, glrBY := glby
            DllCall("SetCapture", "ptr", galGui.Hwnd)
        }
        return 0
    }
    GalUp(wParam, lParam, msg, hwnd) {
        if !glDrag
            return
        DllCall("ReleaseCapture")
        glDrag := 0
        return 0
    }
    ; Same handle rule as the hub and the two overlays - see HandleBounds. This
    ; card has no collapsed state, so there is only ever the one handle, and no
    ; per-frame correction is needed: the modal is short-lived and cannot outlive
    ; a display change the way a persistent window can.
    GalClampPos() {
        HandleBounds(glGx - 26, glGy - 12, glGx + 26, glGy + 12, GW3/BW3
                   , &lox, &hix, &loy, &hiy)
        glbx := Clamp(glbx, lox, hix), glby := Clamp(glby, loy, hiy)
    }
    GalMove(wParam, lParam, msg, hwnd) {
        if hwnd != galGui.Hwnd || !glDrag
            return
        CursorXY(&x, &y)
        glbx := glrBX + (x - glrX), glby := glrBY + (y - glrY)
        GalClampPos()
        return 0
    }
    GalCur(wParam, lParam, msg, hwnd) {
        if hwnd = galGui.Hwnd {
            zc := glDrag ? 7 : GalZoneCur()
            id := (zc = 7) ? 32646 : 32649
            DllCall("SetCursor", "ptr", DllCall("LoadCursor", "ptr", 0, "ptr", id, "ptr"))
            return 1
        }
    }
    GalClose() {
        if glCloseAt
            return
        glCloseAt := A_TickCount
    }
    GalFinish() {
        global G, galOpen, selCur, selNext, selFadeAt, galTarget, pickFor, hubP
        SetTimer(GalRender, 0)
        OnMessage(0x84, GalHT, 0), OnMessage(0x201, GalClick, 0)
        OnMessage(0x202, GalUp, 0), OnMessage(0x200, GalMove, 0)
        OnMessage(0x20, GalCur, 0)
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", G3)
        DllCall("gdi32\DeleteDC", "ptr", hdc3)
        DllCall("gdi32\DeleteObject", "ptr", hbm3)
        galGui.Destroy()
        G := mainG3
        galOpen := 0, galHwnd := 0
        if hubLive {
            HubReassert()
            hubP := -1
            HubTim(TICK_A)
        }
        GalZFix()
        SetTimer(GalZFix, -60)
        SetTimer(GalZFix, -220)
        if galTarget >= 1 && galTarget <= SHList.Length {
            if glPend >= 1 {
                ; crop the chosen gallery image before it becomes the picture
                pickFor := galTarget
                CropFromPool(glPend)
            } else if glPend = -1 {
                pickFor := galTarget
                PickAvatar()
            }
        } else if galManage {
            ; Manager: no cropping and no picking. -2 adds, -3 removes and
            ; comes straight back so the change is visible where it was made.
            pickFor := 0
            if glPend = -2
                GalPickFiles()
            else if (glPend = -3 && galRmIdx >= 1) {
                GalRemovePool(galRmIdx)
                SetTimer(GalReopenManage, -120)
            } else if glPend = -4 {
                GalResetGallery()
                SetTimer(GalReopenManage, -120)
            }
        } else {
            ; Display picture, not a script card. pickFor is what CropCommit
            ; routes on, so it has to be cleared here: a card flow that was
            ; abandoned (file dialog cancelled, cropper never opened) leaves
            ; its index behind, and the crop taken for the profile picture
            ; then lands on that card instead.
            pickFor := 0
            if glPend >= 1
                CropFromPool(glPend)
            else if glPend = -1
                PickAvatar()
        }
        galManage := 0
        galTarget := 0
        if abOn
            RendTim(TICK_A)
        if hubLive
            HubTim(TICK_A)
    }
    GalRender() {
        Critical "On"
        global G
        G := G3
        now := A_TickCount
        ThemeTick()
        it := Min((now - glIntro)/300.0, 1.0)
        ei := 1 - (1 - it)**3
        winA := Round(255 * Min(it*1.8, 1.0))
        yO := Round((1 - ei) * 22 * scaleF)
        scl := 0.96 + 0.04*ei
        if glPickAt && now - glPickAt >= 200
            GalClose()
        if glCloseAt {
            ft := Min((now - glCloseAt)/240.0, 1.0)
            winA := Round(winA*(1 - ft)), scl := 1 - 0.04*ft
            if ft >= 1 {
                GalFinish()
                return
            }
        }
        lb := GetKeyState("LButton", "P")
        if lb && !glLBP && !glDrag && !glCloseAt && now - glIntro > 200 && GalZoneCur() = 0 {
            glPend := 0
            GalClose()
        }
        glLBP := lb
        glDragT += ((glDrag ? 1.0 : 0.0) - glDragT)*EK(0.2)
        if glDragT < 0.004 && !glDrag
            glDragT := 0.0
        velX := glbx - glPrevBX, glPrevBX := glbx
        glTilt += ((glDrag ? Clamp(velX*0.22, -3.0, 3.0) : 0.0) - glTilt)*EK(0.18)
        scl *= 1 + 0.02*glDragT
        hz := (glDrag || glCloseAt) ? 0 : GalZoneCur()
        glClE += (((hz = 2) ? 1.0 : 0.0) - glClE)*EK(0.2)
        glBrE += (((hz = 3) ? 1.0 : 0.0) - glBrE)*EK(0.2)
        glGrE += (((hz = 7) ? 1.0 : 0.0) - glGrE)*EK(0.2)
        nhi := hz >= 20 ? hz - 19 : 0
        if nhi != glHovIdx
            glHovIdx := nhi, glHovE := 0.0
        glHovE += ((glHovIdx ? 1.0 : 0.0) - glHovE)*EK(0.25)
        emb3 := (Sin(DecT(now)*0.0035) + 1)/2

        ResetSurface(G, GW3/BW3, GH3/BH3)
        DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
        ; Derived here rather than read from the `cur` global. That global is
        ; only written by the overlay's Render loop, so opening the gallery
        ; before the overlay has ever drawn - from the gate at boot - left it
        ; on its C_OFF initialiser, which is the DEFAULT accent rose. Reading
        ; hubAccent directly makes it correct on the first frame either way.
        galAcc := hubAccent
        st0 := PushXform(cx3 + CW3/2, cy3 + CH3/2, scl, glTilt)
        ShadowDraw(cx3, cy3 + 3 + 2.5*glDragT, CW3, CH3, 15, 8, 9, 9, 1.0)
        b := BgV(cx3, cy3, CW3, CH3, 0xF2222438, 0xF8121423)
        FillRR(cx3, cy3, CW3, CH3, 15, b), DelB(b)
        p := RRPath(cx3, cy3, CW3, CH3, 15)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 0)
        PanelBackdrop(cx3, cy3, CW3, CH3, galAcc, 1.0, now, 0.9)
        loop 8 {
            k := A_Index
            cyc := 4800 + k*401
            prt := Mod(now + k*887, cyc)/cyc
            mx_ := cx3 + 24 + Mod(k*151, CW3 - 48) + 7*Sin(DecT(now)*0.001 + k*1.9)
            my_ := cy3 + CH3 - 8 - prt*(CH3 - 16)
            b := SBrush(Alpha(AccHi(galAcc, 0.35), 40*Sin(3.14159*prt)))
            FillEll(mx_ - 1.1, my_ - 1.1, 2.2, 2.2, b), DelB(b)
        }
        b := SBrush(Alpha(galAcc, 44 + 14*emb3))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx3, "float", cy3, "float", 10, "float", CH3), DelB(b)
        b := VBrush(cx3, cy3, 3.5, CH3, Alpha(galAcc, 240), Alpha(galAcc, 110))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx3, "float", cy3, "float", 3.5, "float", CH3), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", p)
        pn := Pen(0x28FFFFFF, 1)
        StrokeRR(cx3, cy3, CW3, CH3, 15, pn), DelP(pn)
        pn := Pen(Alpha(galAcc, 20 + 10*emb3 + 46*glDragT), 1)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
        StrokeRR(cx3 + 5, cy3 + 5, CW3 - 10, CH3 - 10, 11, pn), DelP(pn)

        Txt("GALLERY", cx3 + 24, cy3 + 14, 200, 18, fBrand, 0xE0E8EAF6, fmtL)
        b := SBrush(Alpha(galAcc, 200 + 40*emb3))
        FillEll(cx3 + 24 + wGal + 7, cy3 + 21.5, 5, 5, b), DelB(b)
        Txt("select display picture", cx3 + 24, cy3 + 33, 220, 13, fHint, 0x55C7CBE0, fmtL)
        ; the count moves to the subtitle row so the grip owns the top-right
        Txt(galIdx.Length " items", cx3 + CW3 - 104, cy3 + 32, 80, 15, fBadge, 0x62C7CBE0, fmtR)
        ; ---- 6-dot grip: the drag handle (shared build, see GripDots) ----
        GripDots(glGx, glGy, glDrag ? 1.0 : glGrE, galAcc, now)
        ; Same construction as the hub, cropper and overlay close buttons:
        ; hover grows it by 28%, lifts it 1.2px and drifts it 3px outward, and
        ; a ring stroke sits between the fill and the X. This one had neither
        ; motion and no ring, which is what made it read as a different kind
        ; of control from every other close in the suite.
        ec := 1 + 0.28*glClE
        clbx := cx3 + CW3 - 22 + 3*glClE
        clby := cy3 + 22 - 1.2*glClE
        b := SBrush(Alpha(galAcc, 36 + 60*glClE))
        FillEll(clbx - 7*ec, clby - 7*ec, 14*ec, 14*ec, b), DelB(b)
        pn := Pen(Alpha(galAcc, 100 + 80*glClE), 1)
        Ell(clbx - 7*ec, clby - 7*ec, 14*ec, 14*ec, pn), DelP(pn)
        pn := Pen(Alpha(AccHi(galAcc, 0.45), 210 + 45*glClE), 1.5)
        Line(clbx - 3.2*ec, clby - 3.2*ec, clbx + 3.2*ec, clby + 3.2*ec, pn)
        Line(clbx - 3.2*ec, clby + 3.2*ec, clbx + 3.2*ec, clby - 3.2*ec, pn), DelP(pn)

        loop show {
            i := A_Index
            tdel := Min(Max((now - glIntro - 60 - i*36)/260.0, 0.0), 1.0)
            ta := 1 - (1 - tdel)**3
            if ta <= 0
                continue
            tx := cx3 + 24 + Mod(i - 1, 4)*(TH + GP)
            ty := cy3 + ty0 + ((i - 1) // 4)*(TH + GP) + (1 - ta)*8
            hv := (i = glHovIdx) ? glHovE : 0.0
            gxp := 2*hv
            realI := galIdx[i]
            if bmp := SelAt(galIdx[i]) {
                b := SBrush(Alpha(0x000000, 90*ta))
                FillRR(tx + 2, ty + 3, TH, TH, 10, b), DelB(b)
                BlitRRect(bmp, tx - gxp, ty - gxp, TH + gxp*2, TH + gxp*2, 10, ta*(0.82 + 0.18*hv + (realI = curSel ? 0.18 : 0)))
                pn := Pen(Alpha(0x000000, 80*ta), 1)
                StrokeRR(tx - gxp + 0.5, ty - gxp + 0.5, TH + gxp*2 - 1, TH + gxp*2 - 1, 9.5, pn), DelP(pn)
                if realI = curSel {
                    pn := Pen(Alpha(galAcc, 235*ta), 2)
                    StrokeRR(tx - gxp - 1.5, ty - gxp - 1.5, TH + gxp*2 + 3, TH + gxp*2 + 3, 11, pn), DelP(pn)
                    aa := Mod(DecT(now)*0.1, 360)
                    pn := Pen(Alpha(AccHi(galAcc, 0.5), 235*ta), 2)
                    Arc(tx - gxp - 1.5, ty - gxp - 1.5, TH + gxp*2 + 3, TH + gxp*2 + 3, aa, 46, pn), DelP(pn)
                    b := SBrush(Alpha(0x0B0C14, 235*ta))
                    FillEll(tx + TH - 16, ty + TH - 16, 16, 16, b), DelB(b)
                    pn := Pen(Alpha(galAcc, 245*ta), 1.8)
                    Line(tx + TH - 12, ty + TH - 8, tx + TH - 9.5, ty + TH - 5.5, pn)
                    Line(tx + TH - 9.5, ty + TH - 5.5, tx + TH - 4.5, ty + TH - 11.5, pn), DelP(pn)
                } else if hv > 0.01 {
                    pn := Pen(Alpha(AccHi(galAcc, 0.6), 90 + 130*hv), 1.4)
                    StrokeRR(tx - gxp - 1, ty - gxp - 1, TH + gxp*2 + 2, TH + gxp*2 + 2, 10.5, pn), DelP(pn)
                } else {
                    pn := Pen(Alpha(0xFFFFFF, 46*ta), 1)
                    StrokeRR(tx, ty, TH, TH, 10, pn), DelP(pn)
                }
                if glPickAt && i = glPend {
                    pe := Min((now - glPickAt)/200.0, 1.0)
                    b := SBrush(Alpha(0xFFFFFF, 110*(1 - pe)))
                    FillRR(tx, ty, TH, TH, 10, b), DelB(b)
                }
            }
        }

        bre := 1 + 0.03*glBrE
        stB := PushXform(cx3 + 24 + 67, cy3 + footY + 15, bre, 0)
        b := VBrush(cx3 + 24, cy3 + footY, 134, 30, Mix(0xFF31344C, 0xFF41466A, glBrE), Mix(0xFF20223A, 0xFF262A45, glBrE))
        FillRR(cx3 + 24, cy3 + footY, 134, 30, 8, b), DelB(b)
        MicroBackdrop(cx3 + 24, cy3 + footY, 134, 30, 8, galAcc, 1.0, now, 0.9)
        pn := Pen(Alpha(galAcc, 100 + 90*glBrE), 1)
        StrokeRR(cx3 + 24, cy3 + footY, 134, 30, 8, pn), DelP(pn)
        pn := Pen(Alpha(Mix(0xFFE8EAF6, galAcc, 0.3), 220), 1.3)
        Line(cx3 + 36, cy3 + footY + 11, cx3 + 40, cy3 + footY + 11, pn)
        Line(cx3 + 40, cy3 + footY + 11, cx3 + 42, cy3 + footY + 13, pn)
        Line(cx3 + 42, cy3 + footY + 13, cx3 + 50, cy3 + footY + 13, pn)
        Line(cx3 + 50, cy3 + footY + 13, cx3 + 50, cy3 + footY + 20, pn)
        Line(cx3 + 50, cy3 + footY + 20, cx3 + 36, cy3 + footY + 20, pn)
        Line(cx3 + 36, cy3 + footY + 20, cx3 + 36, cy3 + footY + 11, pn), DelP(pn)
        Txt(galManage ? "ADD IMAGES" : "BROWSE FILES", cx3 + 54, cy3 + footY, 100, 30, fBadge, Alpha(Mix(0xFFE8EAF6, galAcc, 0.25), 235), fmtL)
        Pop(stB)
        ; fbX/fbW are computed at open from where the ADD button ends, so this
        ; block can never start inside it whatever the card width works out to.
        if (galManage && glHidN > 0) {
            hvR := (GalZoneCur() = 5) ? 1.0 : 0.0
            pn := Pen(Alpha(galAcc, 70 + 120*hvR), 1)
            StrokeRR(cx3 + fbX, cy3 + footY, fbW, 30, 8, pn), DelP(pn)
            Txt("RESET GALLERY", cx3 + fbX, cy3 + footY, fbW, 30, fBadge
              , Alpha(Mix(0xFFE8EAF6, galAcc, 0.3), 200 + 55*hvR), fmtC)
        } else
            Txt(galManage ? "click to remove" : "click to use"
              , cx3 + fbX, cy3 + footY, fbW, 30, fHint, 0x4EC7CBE0, fmtR)

        if glDragT > 0.01 {
            d := glDragT
            b := SBrush(Alpha(0x0B0C14, 122*d))
            FillRR(cx3, cy3, CW3, CH3, 15, b), DelB(b)
            pn := Pen(Alpha(galAcc, 205*d), 1.6)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
            StrokeRR(cx3 + 3, cy3 + 3, CW3 - 6, CH3 - 6, 12, pn), DelP(pn)
            mcx := cx3 + CW3/2, mcy := cy3 + CH3/2 - 7
            pn := Pen(Alpha(0xFFFFFF, 225*d), 1.8)
            loop 4 {
                a_ := (A_Index - 1) * 1.5708
                x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
                Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
                Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
            }
            DelP(pn)
            Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, Alpha(0xFFFFFF, 235*d), fmtC)
        }

        Pop(st0)

        pt0 := Buffer(8, 0)
        sz := Buffer(8), NumPut("int", GW3, "int", GH3, sz)
        glpx := glbx, glpy := glby + yO
        ptd := Buffer(8), NumPut("int", glpx, "int", glpy, ptd)
        bf := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
        DllCall("user32\UpdateLayeredWindow", "ptr", galGui.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz, "ptr", hdc3, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
        G := mainG3
    }
}
; A picked file goes to the cropper first - CropCommit() is what registers it
; in the pool, saves it under YURI\avatars and selects it.
ApplyAvatar(path) {
    if (path = "" || !FileExist(path))
        return
    CropOpen(path)
}
SaveAvatarPng(bmp, dst) {
    clsid := Buffer(16)
    NumPut("uint", 0x557CF406, "ushort", 0x1A04, "ushort", 0x11D3, clsid)
    NumPut("uchar", 0x9A, "uchar", 0x73, "uchar", 0x00, "uchar", 0x00, "uchar", 0xF8, "uchar", 0x1E, "uchar", 0xF3, "uchar", 0x2E, clsid, 8)
    try DllCall("gdiplus\GdipSaveImageToFile", "ptr", bmp, "wstr", dst, "ptr", clsid, "ptr", 0)
}
; portrait-aware crop: square biased toward the upper body (bias 0=top, .5=center)
LoadSelfieDetached(path, bias := 0.32) {
    if DllCall("gdiplus\GdipCreateBitmapFromFile", "wstr", path, "ptr*", &tmp := 0) || !tmp
        return 0
    nb := CropSquare(tmp, bias)
    DllCall("gdiplus\GdipDisposeImage", "ptr", tmp)
    return nb
}
CropSquare(tmp, bias := 0.32) {
    DllCall("gdiplus\GdipGetImageWidth", "ptr", tmp, "uint*", &w := 0)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", tmp, "uint*", &h := 0)
    s := Min(w, h)
    sx := (w - s)//2
    sy := (h > w) ? Round((h - s)*bias) : (h - s)//2
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SELW, "int", SELW, "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &nb := 0)
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", nb, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", g2, "ptr", tmp
        , "float", 0, "float", 0, "float", SELW, "float", SELW
        , "float", sx, "float", sy, "float", s, "float", s
        , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g2)
    return nb
}
; scan script dir for avatar.* + selfie*.*, merge embedded images (disk wins), natural-sorted
LoadSelfiePool() {
    global selfies, selN, embImgs
    seen := Map(), avv := [], av1 := [], sel := []
    for pat in ["avatar.jpg", "avatar.jpeg", "avatar.png"] {
        if avv.Length
            break
        loop Files, YURI_AV "\" pat {
            k := StrLower(A_LoopFileName)
            if !seen.Has(k)
                seen[k] := 1, avv.Push({name: A_LoopFileName, path: A_LoopFileFullPath, b64: ""})
            break
        }
    }
    ; Nothing is filtered out here. Taking a picture out of the ROTATION must
    ; not take it out of the POOL: the pool is also what the profile-picture
    ; picker offers, and those are two different questions. Which pictures the
    ; gallery cycles is decided by the ORDER the entries go in below.
    for pat in ["avatar_1.jpg", "avatar_1.jpeg", "avatar_1.png"] {
        if av1.Length
            break
        loop Files, YURI_AV "\" pat {
            k := StrLower(A_LoopFileName)
            if !seen.Has(k)
                seen[k] := 1, av1.Push({name: A_LoopFileName, path: A_LoopFileFullPath, b64: ""})
            break
        }
    }
    ; galimg_* are the pictures added through the manager. They are scanned into
    ; the same pool because the gallery needs them loaded, but the prefix marks
    ; them as GALLERY-ONLY: the profile-picture picker skips them, and RESET
    ; archives them. A picture the user put in this folder themselves keeps the
    ; selfie* name and is treated as part of the base set.
    for pat in ["selfie*.png", "selfie*.jpg", "selfie*.jpeg"
              , "galimg_*.png", "galimg_*.jpg", "galimg_*.jpeg"]
        loop Files, YURI_AV "\" pat {
            k := StrLower(A_LoopFileName)
            if !seen.Has(k)
                seen[k] := 1, sel.Push({name: A_LoopFileName, path: A_LoopFileFullPath, b64: ""})
        }
    for e in embImgs {
        k := StrLower(e.name)
        if seen.Has(k)
            continue
        seen[k] := 1
        it := {name: e.name, path: "", b64: e.b64}
        if RegExMatch(k, "^avatar\.(jpg|jpeg|png)$") {
            if !avv.Length
                avv.Push(it)
        } else if RegExMatch(k, "^avatar_1\.(jpg|jpeg|png)$") {
            if !av1.Length
                av1.Push(it)
        }
        else if RegExMatch(k, "^selfie.*\.(jpg|jpeg|png)$")
            sel.Push(it)
    }
    ; natural sort so selfie2 < selfie10 and extension doesn't dictate order
    i := 2
    while i <= sel.Length {
        v := sel[i], j := i - 1
        while j >= 1 && StrCompare(sel[j].name, v.name, "Logical") > 0 {
            sel[j + 1] := sel[j], j -= 1
        }
        sel[j + 1] := v
        i += 1
    }
    global gateBase, galRotN
    n1 := 0
    for it in avv
        n1 += PoolAddEntry(it)
    ; ---- rotation first, removed-from-rotation after ----
    ; Both halves are loaded, so both stay pickable as a profile picture; only
    ; the first half is what the gate hero, the update-log card and the
    ; minimised pill cycle through. Keeping the rotation as a contiguous range
    ; at a known offset is what lets those three keep their existing range
    ; arithmetic instead of each learning about a hide list.
    rotL := [], hidL := []
    for it in av1
        (GalHidden(it.name) ? hidL : rotL).Push(it)
    for it in sel
        (GalHidden(it.name) ? hidL : rotL).Push(it)
    global selAv1Idx := 0
    r := 0
    for it in rotL {
        if PoolAddEntry(it) {
            r++
            if InStr(StrLower(it.name), "avatar_1")
                selAv1Idx := selfies.Length
        }
    }
    galRotN := r
    for it in hidL {
        if PoolAddEntry(it) {
            if InStr(StrLower(it.name), "avatar_1")
                selAv1Idx := selfies.Length
        }
    }
    ; the user's cropped picture, kept out of the gallery: its filename does not
    ; match the avatar.*/selfie* patterns scanned above, so it is only ever added
    ; here - last in the pool - and the gallery ranges below exclude it
    global selCustomIdx := 0
    cst := YURI_AV "\profile_crop.png"
    if (FileExist(cst) && PoolAdd(cst))
        selCustomIdx := selfies.Length
    selN := selfies.Length
    gateBase := n1                                  ; gate shows selfies only (avatar.* is overlay-only)
}

; ---- create the data tree and pull in files from the old flat layout ----
YuriInitDirs() {
    for d in [YURI_ROOT, YURI_CFG, YURI_FLAGS, YURI_AV, YURI_SCR, YURI_EXP, YURI_CUR, YURI_CUR "\backup"
        , YURI_RSB, YURI_RSB "\fonts", YURI_COMM] {
        if !DirExist(d)
            try DirCreate(d)
    }
    ; one-time migration: move, never copy, so we do not run twice
    MoveIn(src, dst) {
        if (FileExist(src) && !FileExist(dst))
            try FileMove(src, dst, 0)
    }
    MoveIn(A_ScriptDir "\zeal.ini",         YURI_CFG   "\zeal.ini")
    MoveIn(A_ScriptDir "\zeal_flags.json",  YURI_FLAGS "\zeal_flags.json")
    MoveIn(A_ScriptDir "\selfie_zz_custom.png", YURI_AV "\selfie_zz_custom.png")
    ; legacy script library folder
    if (DirExist(A_ScriptDir "\yuri_scripts") && !DirExist(YURI_SCR "\.moved")) {
        try {
            loop Files, A_ScriptDir "\yuri_scripts\*.*" {
                if !FileExist(YURI_SCR "\" A_LoopFileName)
                    FileMove(A_LoopFilePath, YURI_SCR "\" A_LoopFileName, 0)
            }
            DirDelete(A_ScriptDir "\yuri_scripts", 0)
        }
    }
    ; user-dropped avatar/selfie images move into the avatars folder
    for pat in ["avatar.jpg", "avatar.jpeg", "avatar.png"
              , "selfie*.png", "selfie*.jpg", "selfie*.jpeg"] {
        try {
            loop Files, A_ScriptDir "\" pat {
                if !FileExist(YURI_AV "\" A_LoopFileName)
                    FileMove(A_LoopFilePath, YURI_AV "\" A_LoopFileName, 0)
            }
        }
    }
}
PoolAddEntry(it) => it.path != "" ? PoolAdd(it.path) : PoolAddB64(it.b64, it.name)
; load one image as a square+tall pair; both or neither (keeps arrays parallel)
PoolAdd(path) {
    global selfies, selTall, selSrc, selEmb
    sq := LoadSelfieDetached(path)
    if !sq
        return 0
    tl := LoadSelfieTallDetached(path)
    if !tl {
        DllCall("gdiplus\GdipDisposeImage", "ptr", sq)
        return 0
    }
    selfies.Push(sq), selTall.Push(tl), selSrc.Push(path), selEmb.Push("")
    return 1
}
; 256x368 portrait crop for the gate hero panel (bias 0=top, .5=center)
LoadSelfieTallDetached(path, bias := 0.18) {
    if DllCall("gdiplus\GdipCreateBitmapFromFile", "wstr", path, "ptr*", &tmp := 0) || !tmp
        return 0
    nb := CropTall(tmp, bias)
    DllCall("gdiplus\GdipDisposeImage", "ptr", tmp)
    return nb
}
CropTall(tmp, bias := 0.18) {
    DllCall("gdiplus\GdipGetImageWidth", "ptr", tmp, "uint*", &w := 0)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", tmp, "uint*", &h := 0)
    if h*SELW >= w*SELTH {
        cw := w, ch := w*SELTH//SELW
        sx := 0, sy := Round((h - ch)*bias)
    } else {
        ch := h, cw := h*SELW//SELTH
        sy := 0, sx := (w - cw)//2
    }
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", SELW, "int", SELTH, "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &nb := 0)
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", nb, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", g2, "ptr", tmp
        , "float", 0, "float", 0, "float", SELW, "float", SELTH
        , "float", sx, "float", sy, "float", cw, "float", ch
        , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g2)
    return nb
}
; add an embedded (base64 JPEG/PNG) image to the pool without touching disk
PoolAddB64(b64, name := "") {
    global selfies, selTall, selSrc, selEmb
    tmp := BitmapFromB64(b64)
    if !tmp
        return 0
    sq := CropSquare(tmp), tl := CropTall(tmp)
    DllCall("gdiplus\GdipDisposeImage", "ptr", tmp)
    if !sq || !tl {
        if sq
            DllCall("gdiplus\GdipDisposeImage", "ptr", sq)
        if tl
            DllCall("gdiplus\GdipDisposeImage", "ptr", tl)
        return 0
    }
    selfies.Push(sq), selTall.Push(tl), selSrc.Push(""), selEmb.Push(name)
    return 1
}
; ---- LUNARIS' credits avatar ----
; Decoded once on first paint and held. `lunaTried` stops a bad decode being
; retried on every frame of a 30fps panel - the failure is permanent, so one
; attempt is the right number.
LunaAvatar() {
    global lunaBmp, lunaTried
    if (!lunaBmp && !lunaTried) {
        lunaTried := 1
        try lunaBmp := BitmapFromB64(LUNA_B64)
    }
    return lunaBmp
}
; BlitCircle is fixed to SELW because it only ever fed on the avatar pool,
; whose members are all one size. This one asks the bitmap how big it is and
; centre-crops to cover, so an arbitrary embedded image lands round instead of
; squashed.
BlitCircleFit(bmp, cx, cy, r, f) {
    if !bmp
        return 0
    sw := 0, sh := 0
    DllCall("gdiplus\GdipGetImageWidth",  "ptr", bmp, "uint*", &sw)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", bmp, "uint*", &sh)
    if (!sw || !sh)
        return 0
    ss := Min(sw, sh)
    ep := 0
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
    DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", cx - r, "float", cy - r
        , "float", r*2, "float", r*2)
    stBF := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 1)
    SetImgAlpha(f)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
        , "float", cx - r, "float", cy - r, "float", r*2, "float", r*2
        , "float", (sw - ss)/2, "float", (sh - ss)/2, "float", ss, "float", ss
        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    Pop(stBF)
    DllCall("gdiplus\GdipDeletePath", "ptr", ep)
    return 1
}
BitmapFromB64(b64) {
    buf := B64Decode(b64)
    if !buf
        return 0
    strm := DllCall("shlwapi\SHCreateMemStream", "ptr", buf, "uint", buf.Size, "ptr")
    if !strm
        return 0
    DllCall("gdiplus\GdipCreateBitmapFromStream", "ptr", strm, "ptr*", &bmp := 0)
    ObjRelease(strm)
    return bmp
}
B64Decode(s) {
    if !DllCall("crypt32\CryptStringToBinaryW", "wstr", s, "uint", 0, "uint", 0x1, "ptr", 0, "uint*", &n := 0, "ptr", 0, "ptr", 0) || !n
        return 0
    buf := Buffer(n)
    if !DllCall("crypt32\CryptStringToBinaryW", "wstr", s, "uint", 0, "uint", 0x1, "ptr", buf, "uint*", &n, "ptr", 0, "ptr", 0)
        return 0
    return buf
}
; ================= rebind =================
; `tgt` picks which binding the capture writes to: 1 AUTOBLOCK, 2 PUZZLE AI
; solve, 3 PUZZLE AI markers. One capture flow, three destinations - a second
; copy of this machinery per binding is how they drift apart.
RebindClick(tgt := 1) {
    rebindOn ? RebindCancel() : RebindStart(tgt)
}
RebindStart(tgt := 1) {
    global rebindOn := 1, rebindAt := A_TickCount, capIH, rebindTgt
    rebindTgt := tgt
    ; Every binding is released for the duration of the capture, not just the
    ; one being replaced: otherwise pressing the PUZZLE AI key while rebinding
    ; AUTOBLOCK would fire a solve and be captured at the same time.
    if (bindKey != "")
        try Hotkey("*" bindKey, "Off")
    PuzHotkeys(0)
    for mk in ["XButton1", "XButton2", "MButton"]
        try Hotkey("*" mk, RebindMouse, "On")
    capIH := InputHook("L0 T8")
    capIH.KeyOpt("{All}", "ES")
    capIH.OnEnd := RebindKey
    capIH.Start()
    if abOn
        RendTim(TICK_A)
    HubPoke()
}
RebindMouse(hk) {
    RebindEnd(StrReplace(hk, "*"))
}
RebindKey(ih) {
    if !rebindOn
        return
    if ih.EndReason = "EndKey" && ih.EndKey != "Escape"
        RebindEnd(ih.EndKey)
    else
        RebindCancel()
}
RebindTeardown() {
    global capIH
    for mk in ["XButton1", "XButton2", "MButton"]
        try Hotkey("*" mk, "Off")
    if capIH {
        try capIH.Stop()
        capIH := 0
    }
}
RebindCancel() {
    global rebindOn, rebindTgt
    if !rebindOn
        return
    rebindOn := 0
    if (bindKey != "")
        try Hotkey("*" bindKey, ToggleBind, "On")
    PuzHotkeys(puzOn)
    rebindTgt := 0
    RebindTeardown()
    if abOn
        RendTim(TICK_A)
    HubPoke()
}
RebindEnd(key) {
    global rebindOn, rebindTgt, bindKey, bindLabel, bindBW, bindFlashAt
    global puzKey, puzLabel, puzBW, puzBindFlashAt, mkKey, mkLabel, mkBW, mkFlashAt
    if !rebindOn
        return
    tgt := rebindTgt
    ; SOLVE and MARKERS share the `puzOn` condition, so one key cannot serve
    ; both - whichever variant was created first would win and the other would
    ; be silently dead. Refused; the badge keeps its old label, which reads as
    ; "that one is taken". AUTOBLOCK is NOT in this test: it sits in a different
    ; context and can share a key with either of them safely.
    ; SOLVE and MARKERS share the puzOn condition, so one key cannot serve both.
    ; And a key an ALREADY-ARMED other system is listening on is refused for the
    ; same reason arming is: it would silently deafen one of them.
    taken := (tgt = 2 && key = mkKey) || (tgt = 3 && key = puzKey)
    clashWith := ""
    if (tgt = 1 && puzOn && (key = puzKey || key = mkKey))
        clashWith := "PUZZLE AI"
    else if ((tgt = 2 || tgt = 3) && abOn && key = bindKey)
        clashWith := "EXTERNAL BLOCK REBIND"
    if (taken || clashWith != "") {
        if (clashWith != "")
            PuzClashRaise(tgt = 1 ? "EXTERNAL BLOCK REBIND" : "PUZZLE AI", clashWith, KeyLabel(key))
        RebindCancel()
        return
    }
    rebindOn := 0, rebindTgt := 0
    RebindTeardown()
    if (tgt = 2) {
        puzKey := key
        puzLabel := KeyLabel(key)
        puzBW := Max(38, MeasureW(puzLabel, fBadge) + 16)
        puzBindFlashAt := A_TickCount
    } else if (tgt = 3) {
        mkKey := key
        mkLabel := KeyLabel(key)
        mkBW := Max(38, MeasureW(mkLabel, fBadge) + 16)
        mkFlashAt := A_TickCount
    } else {
        bindKey := key
        bindLabel := KeyLabel(key)
        bindBW := Max(38, MeasureW(bindLabel, fBadge) + 16)
        bindFlashAt := A_TickCount
    }
    if (bindKey != "")
        Hotkey("*" bindKey, ToggleBind, "On")
    PuzHotkeys(puzOn)                   ; re-registers under whatever the keys are now
    PuzSaveKeys()
    if abOn
        RendTim(TICK_A)
    HubPoke()
}
; ---- unbind a row, back to "???" ----
; The mirror of RebindEnd. It cannot go through the capture at all: RebindStart
; releases every binding and waits for a keypress, and there is no keypress that
; means "none".
;
; The old hotkey is turned OFF before the name is dropped, and that ORDER is the
; whole of it - clear the variable first and the handle to unregister with is
; gone, leaving the key live with nothing on screen saying so. HotIf() is
; explicit for the same class of reason: an Off evaluated under the wrong
; criterion silently unregisters nothing, and PuzHotkeys leaves a context set
; while it works.
RebindClear(tgt) {
    global bindKey, bindLabel, bindBW, bindFlashAt
    global puzKey, puzLabel, puzBW, puzBindFlashAt
    global mkKey, mkLabel, mkBW, mkFlashAt
    ; a capture aimed at this very row has nothing left to land on
    if (rebindOn && rebindTgt = tgt)
        RebindCancel()
    if (tgt = 1) {
        if (bindKey = "")
            return
        HotIf()
        try Hotkey("*" bindKey, "Off")
        bindKey := "", bindLabel := "???", bindBW := qqqBW
        bindFlashAt := A_TickCount
    } else if (tgt = 2) {
        if (puzKey = "")
            return
        puzKey := "", puzLabel := "???", puzBW := qqqBW
        puzBindFlashAt := A_TickCount
    } else {
        if (mkKey = "")
            return
        mkKey := "", mkLabel := "???", mkBW := qqqBW
        mkFlashAt := A_TickCount
        ; Markers are only reachable from their key, so unbinding it with them
        ; on screen would leave an overlay nothing could remove. Put them away
        ; with the key that controlled them; binding a key again brings back
        ; whatever the preference was.
        PuzMarkers(0)
    }
    ; SOLVE and MARKERS are registered together, so this re-registers whichever
    ; of the two is still bound and drops the one that is not
    PuzHotkeys(puzOn)
    PuzSaveKeys()
    if abOn
        RendTim(TICK_A)
    HubPoke()
}

KeyLabel(k) {
    static m := Map("XButton1", "XB1", "XButton2", "XB2", "MButton", "M3"
        , "Space", "SPC", "Tab", "TAB", "CapsLock", "CAPS", "Backspace", "BKSP"
        , "Enter", "ENT", "Delete", "DEL", "Insert", "INS", "Home", "HOME"
        , "End", "END", "PgUp", "PGUP", "PgDn", "PGDN", "Left", "LEFT"
        , "Right", "RGT", "Up", "UP", "Down", "DOWN", "LShift", "LSFT"
        , "RShift", "RSFT", "LControl", "LCTL", "RControl", "RCTL"
        , "LAlt", "LALT", "RAlt", "RALT", "LWin", "LWIN", "RWin", "RWIN"
        , "PrintScreen", "PRT", "ScrollLock", "SCRL", "Pause", "PAUS"
        , "AppsKey", "MENU", "NumLock", "NLCK")
    if m.Has(k)
        return m[k]
    return StrUpper(StrReplace(k, "Numpad", "N"))
}

; ================= render =================
Render() {
    Critical "On"
    global stateT, animStart, minT, minStart, cur, pulse, emb, emb2, winPX, winPY
    global dragT, tiltS, prevBX, hovT, h1T, h2T, h3T, h4T, hgT, G
    G := G0
    ; The overlay has its own Graphics, created before the hub's and never
    ; touched by the hub's quality switch - so LOW PERFORMANCE MODE was
    ; stripping the hub and leaving this window on full antialiasing.
    static lastQ0 := -1
    if (hubLowPerf != lastQ0) {
        lastQ0 := hubLowPerf
        DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", G, "int", hubLowPerf ? 3 : 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", G, "int", hubLowPerf ? 1 : 4)
        DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G, "int", hubLowPerf ? 5 : 7)
        DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", G, "int", hubLowPerf ? 1 : 2)
    }
    now := A_TickCount
    ThemeTick()

    it := Min((now - introStart)/INTRO_MS, 1.0)
    ei := 1 - (1 - it)**3
    winA := Round(255 * Min(it*1.7, 1.0))
    yOff := Round((1 - ei) * 30 * scaleF)

    global selCur, selNext, selFadeAt
    SelTick(now)
    if animStart {
        t := Min((now - animStart)/ANIM_MS, 1.0)
        stateT := Lerp(animFrom, animTo, 1 - (1 - t)**3)
        if t >= 1
            animStart := 0, stateT := animTo
    }
    if minStart {
        t := Min((now - minStart)/MIN_MS, 1.0)
        minT := Lerp(minFrom, minTo, 1 - (1 - t)**3)
        if t >= 1
            minStart := 0, minT := minTo
    }
    closeS := 1.0, closeRot := 0.0, ct := 0.0
    if closing {
        ct := Min((now - closing)/CLOSE_MS, 1.0)
        if ct >= 1 {
            AbFinishHide()
            return
        }
        if ct < 0.16
            closeS := 1 + 0.05*Sin(3.14159*ct/0.16)
        else {
            cb := (ct - 0.16)/0.84
            e := cb*cb
            closeS := 1 - 0.97*e
            closeRot := -14*e
            winA := Round(winA * (1 - Max(0.0, cb - 0.35)/0.65))
            yOff += Round(12 * e * scaleF)
        }
    }
    dtgt := (dragOn = 2 || (dragOn = 1 && now - dragDownAt > 130)) ? 1.0 : 0.0
    dragT += (dtgt - dragT)*EK(0.16)
    if !dragOn && dragT < 0.004
        dragT := 0.0
    ; before the velocity sample, so a correction is not leaned into as a throw
    posFix := OvClampTick()
    vxd := baseX - prevBX
    prevBX := baseX
    tiltS += ((dragOn = 2 ? Clamp(vxd*0.35, -6.0, 6.0) : 0.0) - tiltS)*EK(0.18)
    if !dragOn && Abs(tiltS) < 0.03
        tiltS := 0.0
    hz := (closing || dragOn) ? 0 : HitZoneAtCursor()
    hovT += (((hz = 5) ? 1.0 : 0.0) - hovT)*EK(0.2)
    h1T  += (((hz = 1) ? 1.0 : 0.0) - h1T)*EK(0.2)
    h2T  += (((hz = 2) ? 1.0 : 0.0) - h2T)*EK(0.2)
    h3T  += (((hz = 3) ? 1.0 : 0.0) - h3T)*EK(0.2)
    h4T  += (((hz = 6) ? 1.0 : 0.0) - h4T)*EK(0.2)
    hgT  += (((hz = 4) ? 1.0 : 0.0) - hgT)*EK(0.2)
    hgT  := hgT  < 0.004 && hz != 4 ? 0.0 : hgT
    hovT := hovT < 0.004 && hz != 5 ? 0.0 : hovT
    h1T  := h1T  < 0.004 && hz != 1 ? 0.0 : h1T
    h2T  := h2T  < 0.004 && hz != 2 ? 0.0 : h2T
    h3T  := h3T  < 0.004 && hz != 3 ? 0.0 : h3T
    h4T  := h4T  < 0.004 && hz != 6 ? 0.0 : h4T

    pulse := enabled ? (Sin(now * 0.00417) + 1)/2 : 0
    emb := (Sin(now * 0.0016) + 1)/2                 ; slow ambient ember wave
    emb2 := (Sin(now * 0.004) + 1)/2                 ; faster dormant flash wave
    cur := Mix(hubAccent, C_ON, stateT)
    tg := togAt ? Min((now - togAt)/TOG_MS, 1.0) : 1.0
    togActive := togAt && tg < 1

    BrushCacheTick(), PenCacheTick()
    ResetSurface(G, PW/BW, PH/BH)
    DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)

    oAX := minT < 0.5 ? PAD + CW/2 : BBX
    oAY := minT < 0.5 ? PAD + CH/2 : BBY
    stO := PushXform(oAX, oAY, (1 + 0.035*dragT)*closeS, tiltS + closeRot)

    cf := 1 - Min(minT*1.7, 1.0)
    if minStart && cf > 0.004 {
        loop 2 {
            lag := Clamp(minT + (minTo = 1 ? -0.09 : 0.09) * A_Index, 0.0, 1.0)
            stG := PushXform(BBX, BBY, 1 - 0.16*lag, 8*lag)
            pn := Pen(Alpha(cur, 80 - A_Index*32), 1.4)
            StrokeRR(PAD, PAD, CW, CH, 16, pn), DelP(pn)
            Pop(stG)
        }
    }
    if cf > 0.004 {
        antic := (minStart && minTo = 1.0 && minT < 0.18) ? 1 + 0.05*Sin(minT/0.18 * 3.14159) : 1
        cardPop := (togActive && togDir = 1) ? 1 + 0.018*Sin(3.14159*Min(tg*1.5, 1.0)) : 1
        st := PushXform(BBX, BBY, (1 - 0.16*minT) * antic * cardPop, 8*minT)
        DrawCard(cf, now)
        Pop(st)
    }
    bt_ := Max(0.0, (minT - 0.45)/0.55)
    if bt_ > 0.004 {
        eb := 1 + 2.3*((bt_ - 1)**3) + 1.3*((bt_ - 1)**2)
        popB := (togActive && togDir = 1) ? 1 + 0.14*Sin(tg*7.85)*(1 - tg)**1.5 : 1
        sqB  := (togActive && togDir = -1) ? 1 - 0.05*Sin(3.14159*tg) : 1
        prsB := (scatAt && now - scatAt < 120) ? 1 - 0.06*(1 - (now - scatAt)/120.0) : 1
        bsc := (0.55 + 0.45*eb) * popB * sqB * prsB * (1 + 0.05*h3T) * (enabled ? 1 + 0.02*(pulse - 0.5) : 1)
        rotKick := (togActive && togDir = 1) ? 10*Sin(tg*6.9)*(1 - tg)**2 : 0
        rotB := -35 * (1 - Clamp(bt_, 0.0, 1.0))**2 + rotKick
        dipY := (togActive && togDir = -1) ? 7*Sin(3.14159*Min(tg*1.15, 1.0))*(1 - 0.35*tg) : 0
        stS := PushShift(0, dipY)
        st := PushXform(BBX, BBY, bsc, rotB)
        DrawBubble(Min(bt_*1.6, 1.0), now)
        Pop(st), Pop(stS)
    }
    Pop(stO)

    if closing && ct > 0.30 {
        p2 := (ct - 0.30)/0.70
        e2 := 1 - (1 - p2)**3
        loop 8 {
            a_ := (A_Index*45 + 25*e2) * 0.0174533
            rr_ := 10 + e2*38
            srad := 2.6*(1 - e2) + 0.5
            b := SBrush(Alpha(cur, 210*(1 - e2)))
            FillEll(oAX + rr_*Cos(a_) - srad, oAY + rr_*Sin(a_) - srad, srad*2, srad*2, b), DelB(b)
        }
    }

    pt0 := Buffer(8, 0)
    sz  := Buffer(8), NumPut("int", PW, "int", PH, sz)
    winPX := baseX, winPY := baseY + yOff
    ptd := Buffer(8), NumPut("int", winPX, "int", winPY, ptd)
    bf  := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
    DllCall("user32\UpdateLayeredWindow", "ptr", ui.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz, "ptr", hdc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)

    ; ambient life everywhere: 60 fps when armed/hovered, 30 fps dormant baseline
    if it >= 1 && !animStart && !rippleStart && !minStart && !burstAt && !closing && !dragOn && dragT = 0 && tiltS = 0 && !togActive && !(scatAt && now - scatAt < 400) {
        keep := thAt || hz || hovT > 0 || h1T > 0 || h2T > 0 || h3T > 0 || h4T > 0 || rebindOn || selFadeAt || posFix || (bindFlashAt && now - bindFlashAt < 520)
        RendTim((enabled || keep || hgT > 0.004) ? TICK_A : TICK_S)
    }
}

DrawCard(f, now) {
    global rippleStart
    cx := PAD, cy := PAD
    tp := togAt ? Min((now - togAt)/TOG_MS, 1.0) : 1.0
    dm := (1 - stateT)                       ; dormant weight
    hb := Mod(DecT(now), 2200)
    blink := (hb < 140 || (hb > 300 && hb < 440)) ? 1 : 0   ; standby double-blink

    ims := now - introStart
    stg := ims < 700
    s1 := stg ? Ease3((ims - 60)/340.0)  : 1.0
    s2 := stg ? Ease3((ims - 140)/340.0) : 1.0
    s3 := stg ? Ease3((ims - 220)/340.0) : 1.0
    s4 := stg ? Ease3((ims - 300)/340.0) : 1.0
    hdy := -(1 - s1)*6, ady := (1 - s2)*10, rdy := (1 - s3)*10, fdy := (1 - s4)*8

    ShadowDraw(cx, cy + 3, CW, CH, 16, 10, 7, 7 + 4*dragT, f)
    b := BgV(cx, cy, CW, CH, FA(0xF2222438, f), FA(0xF8121423, f))
    FillRR(cx, cy, CW, CH, 16, b), DelB(b)

    ab := rippleStart ? (1 - Min((now - rippleStart)/RIPPLE_MS, 1.0)) : 0
    p := RRPath(cx, cy, CW, CH, 16)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 0)
    ; The overlay is a top-level card like the hub, gate, gallery, loading and
    ; cropper, and it was the only one of the six never given the shared
    ; backdrop - so it stayed a flat gradient in dark mode and had no paper
    ; design at all in light. The clip is already set above, which is what
    ; PanelBackdrop needs.
    PanelBackdrop(cx, cy, CW, CH, cur, f, now, 0.95)
    rcD := Buffer(16), NumPut("float", cx - 1, "float", cy - 1, "float", CW + 2, "float", CH + 2, rcD)
    DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcD, "uint", FA(0x0EFFFFFF, f), "uint", 0x00FFFFFF, "int", 2, "int", 3, "ptr*", &db := 0)
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", db, "float", cx, "float", cy, "float", CW, "float", CH), DelB(db)
    if true {
        ; looping scan band: brisk emerald-white sweep armed, faint rose drift dormant
        per := enabled ? 3000.0 : 4600.0
        swp := Mod(DecT(now), per)/per
        swx := cx - 26 + (CW + 52)*swp
        c0s := (enabled ? AccHi(cur, 0.3) : cur) & 0xFFFFFF
        c1s := FA(Alpha(c0s, 16*dm + 34*stateT), f)
        rcS := Buffer(16), NumPut("float", swx - 25, "float", cy - 2, "float", 26, "float", CH + 4, rcS)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS, "uint", c0s, "uint", c1s, "int", 0, "int", 3, "ptr*", &sbA := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbA, "float", swx - 24, "float", cy, "float", 24, "float", CH), DelB(sbA)
        rcS2 := Buffer(16), NumPut("float", swx - 1, "float", cy - 2, "float", 26, "float", CH + 4, rcS2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcS2, "uint", c1s, "uint", c0s, "int", 0, "int", 3, "ptr*", &sbB := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sbB, "float", swx, "float", cy, "float", 24, "float", CH), DelB(sbB)
    }
    loop 2 {
        rg := 66 + A_Index*24
        b := SBrush(FA(Alpha(cur, 9 + 5*pulse + 5*emb2*dm), f*s2))
        FillEll(cx + 46 - rg, cy + 65 + ady - rg, rg*2, rg*2, b), DelB(b)
    }
    b := SBrush(FA(Alpha(cur, Min(255, 46 + 24*pulse + 16*emb*dm + 60*ab)), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 14, "float", CH), DelB(b)
    b := VBrush(cx, cy, 4.5, CH, FA(Alpha(cur, Min(255, 245 + 10*ab)), f), FA(Alpha(cur, 110 + 40*emb*dm), f))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", cx, "float", cy, "float", 4.5, "float", CH), DelB(b)
    if tp < 1 {
        e := Ease3(tp)
        bcx_ := cx + CW * (togDir = 1 ? e : 1 - e)
        sc := togDir = 1 ? 0xFFFFFF : (cur & 0xFFFFFF)
        c1 := FA(Alpha(sc, 64*(1 - tp)), f), c0 := sc & 0xFFFFFF
        rc := Buffer(16), NumPut("float", bcx_ - 29, "float", cy - 2, "float", 30, "float", CH + 4, rc)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc, "uint", c0, "uint", c1, "int", 0, "int", 3, "ptr*", &sb := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sb, "float", bcx_ - 28, "float", cy, "float", 28, "float", CH), DelB(sb)
        rc2 := Buffer(16), NumPut("float", bcx_ - 1, "float", cy - 2, "float", 30, "float", CH + 4, rc2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rc2, "uint", c1, "uint", c0, "int", 0, "int", 3, "ptr*", &sb2 := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", sb2, "float", bcx_, "float", cy, "float", 28, "float", CH), DelB(sb2)
    }
    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)

    pn := Pen(FA(0x28FFFFFF, f), 1)
    StrokeRR(cx, cy, CW, CH, 16, pn), DelP(pn)
    pn := Pen(FA(0x16FFFFFF, f), 1)
    Line(cx + 18, cy + 1.5, cx + CW - 18, cy + 1.5, pn), DelP(pn)
    pn := Pen(FA(0x30000000, f), 1)
    Line(cx + 18, cy + CH - 1.5, cx + CW - 18, cy + CH - 1.5, pn), DelP(pn)
    ; corner glints twinkle in sequence
    loop 4 {
        k := A_Index - 1
        shim := (Sin(DecT(now)*(enabled ? 0.006 : 0.003) + k*1.5708) + 1)/2
        ga := Min(255, 105 + 40*pulse*stateT + 38*shim*dm + 58*shim*stateT + 100*(1 - tp))
        xk := (k = 1 || k = 2) ? cx + CW - 31.5 : cx + 0.5
        yk := (k >= 2) ? cy + CH - 31.5 : cy + 0.5
        ang := k = 0 ? 195 : k = 1 ? 285 : k = 2 ? 15 : 105
        pn := Pen(FA(Alpha(cur, ga), f), 2)
        Arc(xk, yk, 31, 31, ang, 60, pn), DelP(pn)
    }
    FadeLine(cx + 20, cx + CW - 20, cy + 30, 0x30FFFFFF, f)
    FadeLine(cx + 20, cx + CW - 20, cy + 100, 0x30FFFFFF, f)

    Txt(APPNAME, cx + 36, cy + 6 + hdy, 90, 20, fBrand, FA(0xCFE8EAF6, f*s1), fmtL)
    b := SBrush(FA(Alpha(cur, enabled ? 200 + 55*pulse : Min(255, 150 + 35*emb2 + 48*blink)), f*s1))
    FillEll(cx + 36 + wZeal + 6, cy + 13.5 + hdy, 5, 5, b), DelB(b)
    if (hgT > 0.01 || dragT > 0.01) {
        gg := Max(hgT, dragT)
        b := SBrush(FA(Alpha(cur, Round(30*gg)), f*s1))
        FillRR(cx + CW/2 - 17, cy + 7 + hdy, 34, 17, 7, b), DelB(b)
        pn := Pen(FA(Alpha(cur, Round(90*gg)), f*s1), 1)
        StrokeRR(cx + CW/2 - 17, cy + 7 + hdy, 34, 17, 7, pn), DelP(pn)
    }
    gLift := 0.9*hgT
    gDot := 2.4 + 0.8*hgT
    gOff := (gDot - 2.4)/2
    b := SBrush(FA(Alpha(Mix(0xFFFFFF, cur, 0.6*hgT), Round(46 + 105*hgT)), f*s1))
    loop 6 {
        gc := Mod(A_Index - 1, 3), gr := (A_Index - 1) // 3
        gwv := hgT*1.1*Sin(DecT(now)*0.006 - gc*0.9)
        FillEll(cx + CW/2 - 8.2 + gc*7 - gOff, cy + 11.8 + gr*5.6 + hdy - gOff - gLift + gwv, gDot, gDot, b)
    }
    DelB(b)
    em := 1 + 0.28*h1T, ec := 1 + 0.28*h2T
    bmx_ := BMX - 3*h2T, bcx_ := BCX + 3*h1T
    ym := BTY + hdy - 1.2*h1T, yc := BTY + hdy - 1.2*h2T
    b := SBrush(FA(Alpha(0xFFFFFF, 22 + 34*h1T), f*s1))
    FillEll(bmx_ - 7*em, ym - 7*em, 14*em, 14*em, b), DelB(b)
    pn := Pen(FA(Alpha(0xFFFFFF, 42 + 60*h1T), f*s1), 1)
    Ell(bmx_ - 7*em, ym - 7*em, 14*em, 14*em, pn), DelP(pn)
    pn := Pen(FA(Alpha(0xE8EAF6, 168 + 87*h1T), f*s1), 1.5)
    Line(bmx_ - 3.5*em, ym, bmx_ + 3.5*em, ym, pn), DelP(pn)
    b := SBrush(FA(Alpha(hubAccent, 36 + 60*h2T), f*s1))
    FillEll(bcx_ - 7*ec, yc - 7*ec, 14*ec, 14*ec, b), DelB(b)
    pn := Pen(FA(Alpha(hubAccent, 100 + 80*h2T), f*s1), 1)
    Ell(bcx_ - 7*ec, yc - 7*ec, 14*ec, 14*ec, pn), DelP(pn)
    pn := Pen(FA(Alpha(AccHi(hubAccent, 0.4), 210 + 45*h2T), f*s1), 1.5)
    Line(bcx_ - 3.2*ec, yc - 3.2*ec, bcx_ + 3.2*ec, yc + 3.2*ec, pn)
    Line(bcx_ - 3.2*ec, yc + 3.2*ec, bcx_ + 3.2*ec, yc - 3.2*ec, pn), DelP(pn)

    ax := cx + 46, ay := cy + 65 + ady
    if enabled {
        loop 3 {
            r_ := 27 + A_Index * (2.0 + 1.8*pulse)
            b := SBrush(FA(Alpha(cur, 20 - A_Index*5), f*s2))
            FillEll(ax - r_, ay - r_, r_*2, r_*2, b), DelB(b)
        }
    }
    DrawAvatar(ax, ay, 26, f*s2)
    if hovT > 0.01 {
        he := hovT
        ep := 0
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
        DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", ax - 26, "float", ay - 26, "float", 52, "float", 52)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 0)
        b := SBrush(FA(Alpha(0x05060C, 158*he), f*s2))
        FillEll(ax - 26, ay - 26, 52, 52, b), DelB(b)
        gy := ay - 13 + (1 - he)*7
        pn := Pen(FA(Alpha(0xFFFFFF, 210*he), f*s2), 1.2)
        StrokeRR(ax - 7, gy, 14, 10, 2, pn)
        Line(ax - 4.5, gy + 7.5, ax - 1.5, gy + 3.5, pn)
        Line(ax - 1.5, gy + 3.5, ax + 2, gy + 7.5, pn)
        Line(ax + 2, gy + 7.5, ax + 4.5, gy + 5, pn), DelP(pn)
        b := SBrush(FA(Alpha(0xFFFFFF, 220*he), f*s2))
        FillEll(ax + 2.2, gy + 1.6, 2.2, 2.2, b), DelB(b)
        Txt("CHANGE", ax - 26, ay + 2 + (1 - he)*7, 52, 14, fBadge, FA(Alpha(0xFFFFFF, 245*he), f*s2), fmtC)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", ep)
    }
    pn := Pen(FA(0x50000000, f*s2), 1)
    Ell(ax - 25, ay - 25, 50, 50, pn), DelP(pn)
    RingDraw(ax, ay, 26.5, AccHi(cur, 0.5*hovT), f*s2, hovT)
    if enabled {
        sa := Mod(now * 0.09, 360)
        cc := AccHi(cur, 0.4)
        pn := Pen(FA(Alpha(cc, 80), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa, 64, pn), DelP(pn)
        pn := Pen(FA(Alpha(cc, 160), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa + 24, 40, pn), DelP(pn)
        pn := Pen(FA(Alpha(cc, 245), f*s2), 2.7)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sa + 44, 20, pn), DelP(pn)
        sb2_ := 360 - Mod(DecT(now)*0.06, 360)
        pn := Pen(FA(Alpha(cur, 90), f*s2), 1.8)
        Arc(ax - 26.5, ay - 26.5, 53, 53, sb2_, 40, pn), DelP(pn)
    } else {
        ; dormant scanner: soft tapered comet circling the avatar ring
        da := Mod(DecT(now)*0.055, 360)
        pn := Pen(FA(Alpha(cur, 55), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, da, 50, pn), DelP(pn)
        pn := Pen(FA(Alpha(cur, Min(255, 120 + 45*emb2)), f*s2), 2.5)
        Arc(ax - 26.5, ay - 26.5, 53, 53, da + 30, 20, pn), DelP(pn)
    }

    rowY := cy + 56 + rdy

    clf := lastClick ? (now - lastClick)/260.0 : 2
    fe := clf < 1 ? 1 - (1 - clf)**3 : 1
    mx := cx + 88, my := rowY - 15 + (enabled ? 0.8*Sin(DecT(now)*0.004) : 0.5*Sin(DecT(now)*0.0028))
    mp := RRPath(mx, my, 20, 30, 9)
    b := SBrush(FA(0x12FFFFFF, f*s3))
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", mp), DelB(b)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", mp, "int", 0)
    b := SBrush(FA(Alpha(cur, Min(255, 205 + 50*pulse + 24*emb2*dm + 45*(1 - fe))), f*s3))
    DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", mx, "float", my, "float", 10, "float", 13), DelB(b)
    DllCall("gdiplus\GdipResetClip", "ptr", G)
    pn := Pen(FA(0x5CFFFFFF, f*s3), 1.4)
    DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", mp), DelP(pn)
    DllCall("gdiplus\GdipDeletePath", "ptr", mp)
    pn := Pen(FA(0x3CFFFFFF, f*s3), 1)
    Line(mx + 10, my, mx + 10, my + 13, pn)
    Line(mx, my + 13, mx + 20, my + 13, pn), DelP(pn)
    b := SBrush(FA(Alpha(0xFFFFFF, 70 + 90*pulse*stateT + 30*emb2*dm), f*s3))
    FillRR(mx + 8.4, my + 4, 3.2, 6.2, 1.6, b), DelB(b)
    if stateT > 0.05 {
        irt := Mod(DecT(now), 1600)/1600.0
        pn := Pen(FA(Alpha(cur, 75*(1 - irt)*stateT), f*s3), 1.6*(1 - irt) + 0.3)
        r_ := 3 + irt*11
        Ell(mx + 5 - r_, my + 6.5 - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if clf < 1 {
        pn := Pen(FA(Alpha(cur, 180*(1 - fe)), f*s3), 2*(1 - fe) + 0.4)
        r_ := 4 + fe*14
        Ell(mx + 5 - r_, my + 6.5 - r_, r_*2, r_*2, pn), DelP(pn)
    }

    loop 3 {
        k := A_Index - 1
        x0 := mx + 25 + k*6
        ca := enabled ? 70 + 185*Max(0.0, Sin(DecT(now)*0.005 - k*0.9))**3 : 50 + 85*Max(0.0, Sin(DecT(now)*0.0025 - k*0.9))**3
        pn := Pen(FA(Alpha(Mix(0xFFE8EAF6, cur, 0.35*stateT), ca), f*s3), 1.8)
        Line(x0, rowY - 3.8, x0 + 3.6, rowY, pn)
        Line(x0 + 3.6, rowY, x0, rowY + 3.8, pn)
        DelP(pn)
    }
    if enabled {
        loop 2 {
            pph := Mod(now + (A_Index - 1)*450, 900)/900.0
            b := SBrush(FA(Alpha(AccHi(cur, 0.4), 235*Sin(3.14159*pph)), f*s3))
            FillEll(mx + 22 + 26*pph - 1.6, rowY - 1.6, 3.2, 3.2, b), DelB(b)
        }
    }

    ; Q keycap in a recessed well; under-glow stays clipped inside the well
    kx := mx + 50
    wp := RRPath(kx - 1.5, rowY - 12.5, 29, 26, 8)
    b := SBrush(FA(0xFF171A30, f*s3))
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", wp), DelB(b)
    if stateT > 0.05 {
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", wp, "int", 0)
        b := SBrush(FA(Alpha(cur, (40 + 30*pulse)*stateT), f*s3))
        FillEll(kx - 2, rowY + 4, 30, 12, b), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
    }
    DllCall("gdiplus\GdipDeletePath", "ptr", wp)
    ky := rowY - 13 + 1.2*stateT + 0.9*pulse + 2.2*(1 - fe)
    b := VBrush(kx, ky, 26, 26, FA(0xFF31344C, f*s3), FA(0xFF20223A, f*s3))
    FillRR(kx, ky, 26, 26, 7, b), DelB(b)
    MicroBackdrop(kx, ky, 26, 26, 7, cur, f*s3, now, 0.85)
    pn := Pen(FA(Mix(0x30FFFFFF, Alpha(cur, 130), stateT), f*s3), 1)
    StrokeRR(kx, ky, 26, 26, 7, pn), DelP(pn)
    qc := (togDir = 1 && tp < 1) ? AccHi(Alpha(cur, 235), 1 - (Min(tp*1.4, 1.0))) : Alpha(cur, 235)
    Txt("Q", kx, ky - 1, 26, 26, fKey, FA(qc, f*s3), fmtC)
    if clf < 1 {
        pn := Pen(FA(Alpha(cur, 150*(1 - fe)), f*s3), 1.8*(1 - fe) + 0.3)
        r_ := 8 + fe*10
        Ell(kx + 13 - r_, rowY + 0.5 - r_, r_*2, r_*2, pn), DelP(pn)
    }

    b := SBrush(FA(Alpha(cur, Min(255, (120 + 120*(Sin(DecT(now)*0.006) + 1)/2)*Max(stateT, 0.35) + 50*blink*dm)), f*s3))
    FillEll(cx + 89, cy + 75.5 + rdy, 4, 4, b), DelB(b)
    Txt("external block", cx + 98, cy + 70 + rdy, 150, 16, fHint, FA(0x62C7CBE0, f*s3), fmtL)

    pw_ := Lerp(wOff, wOn, stateT) + 46
    px1 := cx + CW - 20 - pw_
    ps := tp < 1 ? 1 + 0.07*Sin(3.14159*Min(tp*1.5, 1.0)) : 1
    stP := PushXform(px1 + pw_/2, rowY, ps, 0)
    b := VBrush(px1, rowY - 14, pw_, 28, FA(Alpha(cur, 58), f*s3), FA(Alpha(cur, 26), f*s3))
    FillRR(px1, rowY - 14, pw_, 28, 14, b), DelB(b)
    MicroBackdrop(px1, rowY - 14, pw_, 28, 14, cur, f*s3, now, 0.85)
    pn := Pen(FA(Alpha(cur, 105), f*s3), 1)
    StrokeRR(px1, rowY - 14, pw_, 28, 14, pn), DelP(pn)
    dx := px1 + 15, dy := rowY
    if enabled {
        loop 3 {
            r_ := 5 + A_Index * (2.6 + 2.2*pulse)
            b := SBrush(FA(Alpha(cur, 26 - A_Index*6), f*s3))
            FillEll(dx - r_, dy - r_, r_*2, r_*2, b), DelB(b)
        }
    }
    b := SBrush(FA(Alpha(cur, enabled ? 250 : Min(255, 165 + 30*emb2 + 50*blink)), f*s3))
    FillEll(dx - 4, dy - 4, 8, 8, b), DelB(b)
    b := SBrush(FA(0x8CFFFFFF, f*s3))
    FillEll(dx - 2.4, dy - 2.6, 1.8, 1.8, b), DelB(b)
    if enabled {
        oa := now*0.0042
        b := SBrush(FA(Alpha(AccHi(cur, 0.5), 220), f*s3))
        FillEll(dx + 7.5*Cos(oa) - 1.3, dy + 7.5*Sin(oa) - 1.3, 2.6, 2.6, b), DelB(b)
    }
    txtA := animStart ? Abs(stateT*2 - 1) : 1.0
    Txt(stateT >= 0.5 ? "ENABLED" : "DISABLED", dx + 10 + 3*(1 - txtA), rowY - 12, pw_ - 34, 24, fStatus, FA(Alpha(cur, 245*txtA), f*s3), fmtL)
    if rippleStart {
        rt := (now - rippleStart)/RIPPLE_MS
        if rt >= 1
            rippleStart := 0
        else {
            e := 1 - (1 - rt)**3
            pn := Pen(FA(Alpha(cur, 150*(1 - e)), f*s3), 2.4*(1 - e) + 0.4)
            r_ := 5 + e*24
            Ell(dx - r_, dy - r_, r_*2, r_*2, pn), DelP(pn)
        }
    }
    Pop(stP)

    hy := cy + 116 + fdy
    lbl := rebindOn ? "???" : bindLabel
    bw_ := rebindOn ? qqqBW : bindBW
    rbp := rebindOn ? (Sin(DecT(now)*0.01) + 1)/2 : 0.0
    fl := bindFlashAt ? Clamp(1 - (now - bindFlashAt)/520.0, 0.0, 1.0) : 0.0
    hk_ := Max(h4T, rbp)
    by_ := hy - 10 - 0.9*h4T
    stK := PushXform(cx + 24 + bw_/2, hy, 1 + 0.05*h4T + 0.03*rbp, 0)
    if hk_ > 0.01 || fl > 0 {
        b := SBrush(FA(Alpha(cur, 24*h4T + 30*rbp + 55*fl), f*s4))
        FillRR(cx + 20, by_ - 4, bw_ + 8, 28, 9, b), DelB(b)
    }
    b := VBrush(cx + 24, by_, bw_, 20, FA(Mix(0xFF343752, 0xFF41466A, hk_), f*s4), FA(Mix(0xFF1C1E33, 0xFF262A45, hk_), f*s4))
    FillRR(cx + 24, by_, bw_, 20, 6, b), DelB(b)
    MicroBackdrop(cx + 24, by_, bw_, 20, 6, cur, f*s4, now, 0.9)
    pn := Pen(FA(Mix(0x26FFFFFF, Alpha(cur, 190), Max(hk_, fl)), f*s4), 1)
    StrokeRR(cx + 24, by_, bw_, 20, 6, pn), DelP(pn)
    tc := rebindOn ? TH(Alpha(cur, 205 + 50*rbp)) : THMix(0x96E8EAF6, 0xF0FFFFFF, Max(h4T, fl))
    TxtP(lbl, cx + 24, by_, bw_, 20, fBadge, FA(tc, f*s4), fmtC)
    if rebindOn {
        prt := Mod(now - rebindAt, 900)/900.0
        ex := prt*9
        pn := Pen(FA(Alpha(cur, 130*(1 - prt)), f*s4), 1.8*(1 - prt) + 0.3)
        StrokeRR(cx + 24 - ex, by_ - ex*0.6, bw_ + ex*2, 20 + ex*1.2, 6 + ex*0.4, pn), DelP(pn)
    } else if fl > 0 {
        ex := (1 - fl)*10
        pn := Pen(FA(Alpha(cur, 170*fl), f*s4), 2.2*fl + 0.3)
        StrokeRR(cx + 24 - ex, by_ - ex*0.6, bw_ + ex*2, 20 + ex*1.2, 6 + ex*0.4, pn), DelP(pn)
    }
    Pop(stK)
    Txt(rebindOn ? "press any key" : "external block keybind", cx + 24 + bw_ + 10, hy - 10, 190, 20, fHint, rebindOn ? FA(Alpha(cur, 150 + 55*rbp), f*s4) : FA(0x6EC7CBE0, f*s4), fmtL)
    sp := ShieldPath(cx + CW - 37, hy - 8, 13, 16)
    b := SBrush(FA(Alpha(cur, 34 + 70*stateT + 30*pulse + 20*emb2*dm), f*s4))
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", sp), DelB(b)
    pn := Pen(FA(Alpha(cur, 210), f*s4), 1.4)
    DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", sp), DelP(pn)
    DllCall("gdiplus\GdipDeletePath", "ptr", sp)
    sp2 := ShieldPath(cx + CW - 34, hy - 4.6, 7, 8.6)
    pn := Pen(FA(Alpha(cur, 40 + 90*stateT), f*s4), 1)
    DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", sp2), DelP(pn)
    DllCall("gdiplus\GdipDeletePath", "ptr", sp2)

    if dragT > 0.01 {
        d := dragT
        b := SBrush(FA(Alpha(0x0B0C14, 122*d), f))
        FillRR(cx, cy, CW, CH, 16, b), DelB(b)
        pn := Pen(FA(Alpha(cur, 205*d), f), 1.6)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
        StrokeRR(cx + 3, cy + 3, CW - 6, CH - 6, 13, pn), DelP(pn)
        mcx := cx + CW/2, mcy := cy + CH/2 - 7
        pn := Pen(FA(Alpha(0xFFFFFF, 225*d), f), 1.8)
        loop 4 {
            a_ := (A_Index - 1) * 1.5708
            x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
            Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
        }
        DelP(pn)
        Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, FA(Alpha(0xFFFFFF, 235*d), f), fmtC)
    }
}

DrawBubble(f, now) {
    global burstAt
    tp := togAt ? Min((now - togAt)/TOG_MS, 1.0) : 1.0
    sct := (scatAt && now - scatAt < 380) ? (now - scatAt)/380.0 : -1
    hx := h3T
    bcol := enabled ? cur : AccHi(cur, 0.14)   ; lifted dormant rose
    if enabled {
        loop 3 {
            r_ := 31 + A_Index * (2.4 + 2.2*pulse) + 3*hx
            b := SBrush(FA(Alpha(cur, 22 - A_Index*6 + 8*hx), f))
            FillEll(BBX - r_, BBY - r_, r_*2, r_*2, b), DelB(b)
        }
    } else if hx > 0.01 {
        b := SBrush(FA(Alpha(cur, 26*hx), f))
        FillEll(BBX - 36, BBY - 36, 72, 72, b), DelB(b)
    }
    loop 5 {
        b := SBrush(FA(Alpha(0x000000, 9 + 4*dragT), f))
        FillEll(BBX - 30 - A_Index, BBY - 28 - A_Index, 60 + A_Index*2, 60 + A_Index*2, b), DelB(b)
    }
    crA := enabled ? 15 : Mod(DecT(now)*0.02, 360)
    pn := Pen(FA(Alpha(bcol, enabled ? 55 + 30*pulse : 62 + 30*emb), f), 5)
    Arc(BBX - 33, BBY - 33, 66, 66, crA, 120, pn), DelP(pn)
    DrawAvatar(BBX, BBY, 30, f)
    ; hover: darken the portrait, OPEN slides in
    if hx > 0.01 {
        ep := 0
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
        DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", BBX - 30, "float", BBY - 30, "float", 60, "float", 60)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 0)
        b := SBrush(FA(Alpha(0x05060C, 152*hx), f))
        FillEll(BBX - 30, BBY - 30, 60, 60, b), DelB(b)
        gy := BBY - 12 + (1 - hx)*7
        pn := Pen(FA(Alpha(0xFFFFFF, 215*hx), f), 1.6)
        Line(BBX - 5, gy + 4, BBX, gy - 1, pn)
        Line(BBX, gy - 1, BBX + 5, gy + 4, pn)
        Line(BBX - 5, gy + 10, BBX, gy + 5, pn)
        Line(BBX, gy + 5, BBX + 5, gy + 10, pn), DelP(pn)
        Txt("OPEN", BBX - 26, BBY + 3 + (1 - hx)*7, 52, 14, fBadge, FA(Alpha(0xFFFFFF, 245*hx), f), fmtC)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", ep)
    }
    pn := Pen(FA(0x2EFFFFFF, f), 1)
    Ell(BBX - 26, BBY - 26, 52, 52, pn), DelP(pn)
    pn := Pen(FA(0x50000000, f), 1)
    Ell(BBX - 29, BBY - 29, 58, 58, pn), DelP(pn)
    pn := Pen(FA(0x66000000, f), 1)
    Ell(BBX - 32, BBY - 32, 64, 64, pn), DelP(pn)
    if enabled {
        aa := Mod(DecT(now)*0.05, 360)
        flash := (togDir = 1 && tp < 1) ? (1 - tp)*0.6 : 0
        cc := AccHi(cur, flash)
        loop 2 {
            base := aa + (A_Index - 1)*180
            pn := Pen(FA(Alpha(cc, 78), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base, 104, pn), DelP(pn)
            pn := Pen(FA(Alpha(cc, 160), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base + 40, 64, pn), DelP(pn)
            pn := Pen(FA(Alpha(cc, 245), f), 2.8)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, base + 76, 28, pn), DelP(pn)
        }
        ; counter-rotating faint arcs one ring inward
        ba2 := Mod(-now*0.07, 360)
        pn := Pen(FA(Alpha(cur, 70), f), 1.6)
        Arc(BBX - 33.2, BBY - 33.2, 66.4, 66.4, ba2, 58, pn)
        Arc(BBX - 33.2, BBY - 33.2, 66.4, 66.4, ba2 + 180, 58, pn), DelP(pn)
    } else {
        flick := (togDir = -1 && tp < 1) ? 0.55 + 0.45*Abs(Sin(DecT(now)*0.045)) : 1
        loop 4 {
            emb_ := 150 + 85*(Sin(DecT(now)*0.0022 + (A_Index - 1)*1.5708) + 1)/2
            pn := Pen(FA(Alpha(bcol, Min(255, emb_)*flick), f), 2.6)
            Arc(BBX - 30.75, BBY - 30.75, 61.5, 61.5, (A_Index - 1)*90 + 25 + 6*Sin(DecT(now)*0.0011), 40, pn)
            DelP(pn)
        }
    }
    pn := Pen(FA(Alpha(bcol, (enabled ? 24 : 32) + 20*hx), f), 1)
    Ell(BBX - 35.2 - 2.5*hx, BBY - 35.2 - 2.5*hx, 70.4 + 5*hx, 70.4 + 5*hx, pn), DelP(pn)
    head := Mod(DecT(now)*0.18, 360)
    head2 := 360 - Mod(DecT(now)*0.11, 360)
    drift := Mod(DecT(now)*0.008, 360)
    glint := Mod(DecT(now)*0.055, 360)
    igniteA := (togDir = 1 && tp < 1) ? 360*Ease3(tp) : -1
    extingA := (togDir = -1 && tp < 1) ? 360*Ease3(tp) : -1
    loop 24 {
        segA := (A_Index - 1)*15
        boost := 0.0
        if enabled {
            d_ := Mod(segA - head + 540, 360) - 180
            boost := Max(0.0, Cos(d_*0.017453))**7
            d2 := Mod(segA - head2 + 540, 360) - 180
            al := Min(255, 34 + 210*boost + 95*Max(0.0, Cos(d2*0.017453))**5)
            colr := cur
            segD := segA
            if igniteA >= 0
                al := segA <= igniteA ? 255 : 22, colr := segA <= igniteA ? AccHi(cur, 0.5*(1 - tp)) : cur
        } else {
            segD := segA + drift
            g_ := Mod(segD - glint + 540, 360) - 180
            al := (Mod(A_Index, 2) ? 85 : 44) + 110*Max(0.0, Cos(g_*0.017453))**5
            colr := bcol
            if extingA >= 0 && segA <= extingA
                al := 16
        }
        rr_ := (Mod(A_Index, 2) ? 34.0 : 36.2) + 2.5*hx
        if sct >= 0 {
            e := Ease3(sct)
            rr_ += 16*e
            al *= (1 - e)
        }
        sw := 6 + 5*boost
        pn := Pen(FA(Alpha(colr, al), f), 2.2)
        Arc(BBX - rr_ - 0.5, BBY - rr_ - 0.5, rr_*2 + 1, rr_*2 + 1, (enabled ? segA : segD) + (15 - sw)/2, sw, pn), DelP(pn)
    }
    ; dotted counter-march ring + outer twinkle ticks
    pn := Pen(FA(Alpha(bcol, enabled ? 70 : 55 + 20*emb), f), 1.3)
    DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
    DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", 1000 - Mod(DecT(now)*0.02, 1000))
    Ell(BBX - 38.8, BBY - 38.8, 77.6, 77.6, pn), DelP(pn)
    tb := -now*0.012
    loop 12 {
        a_ := (tb + A_Index*30)*0.017453
        tw := (Sin(DecT(now)*0.002 + A_Index*0.52) + 1)/2
        al := enabled ? 45 + 70*tw : 38 + 42*tw
        pn := Pen(FA(Alpha(bcol, al), f), 1.3)
        Line(BBX + 40*Cos(a_), BBY + 40*Sin(a_), BBX + 42.6*Cos(a_), BBY + 42.6*Sin(a_), pn), DelP(pn)
    }
    if enabled {
        ha := head*0.017453
        b := SBrush(FA(Alpha(AccHi(cur, 0.6), 255), f))
        FillEll(BBX + 35.1*Cos(ha) - 2.2, BBY + 35.1*Sin(ha) - 2.2, 4.4, 4.4, b), DelB(b)
        loop 3 {
            k := A_Index - 1
            twA := (k*120 + now*0.02)*0.017453
            twI := Max(0.0, Sin(DecT(now)*0.003 + k*2.1))**9
            b := SBrush(FA(Alpha(0xFFFFFF, 200*twI), f))
            FillEll(BBX + 35*Cos(twA) - 1.4, BBY + 35*Sin(twA) - 1.4, 2.8, 2.8, b), DelB(b)
        }
    }
    if hx > 0.01 {
        prt := Mod(DecT(now), 950)/950.0
        pn := Pen(FA(Alpha(cur, 130*hx*(1 - prt)), f), 2.2*(1 - prt) + 0.4)
        r_ := 31 + prt*11
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if sct >= 0 {
        e := Ease3(sct)
        pn := Pen(FA(Alpha(0xFFFFFF, 190*(1 - e)), f), 2.6*(1 - e) + 0.4)
        r_ := 30 + e*12
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if togDir = 1 && tp > 0.5 && tp < 1 {
        e := (tp - 0.5)/0.5
        pn := Pen(FA(Alpha(cur, 150*(1 - e)), f), 2.4*(1 - e) + 0.4)
        r_ := 30 + e*22
        Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
    }
    if burstAt && now >= burstAt {
        btm := (now - burstAt)/450.0
        if btm >= 1
            burstAt := 0
        else {
            e := 1 - (1 - btm)**3
            pn := Pen(FA(Alpha(cur, 170*(1 - e)), f), 2.6*(1 - e) + 0.4)
            r_ := 30 + e*18
            Ell(BBX - r_, BBY - r_, r_*2, r_*2, pn), DelP(pn)
        }
    }
    qx := BBX + 12, qy := BBY + 12
    b := SBrush(FA(0x59000000, f))
    FillEll(qx + 1, qy + 2.5, 20, 19, b), DelB(b)
    b := VBrush(qx, qy, 20, 20, FA(0xFF3A3D58, f), FA(0xFF20223A, f))
    FillRR(qx, qy, 20, 20, 6, b), DelB(b)
    MicroBackdrop(qx, qy, 20, 20, 6, cur, f, now, 0.8)
    pn := Pen(FA(Alpha(cur, 150 + 70*(enabled ? pulse : emb)), f), 1)
    StrokeRR(qx, qy, 20, 20, 6, pn), DelP(pn)
    Txt("Q", qx, qy, 20, 20, fBrand, FA(Alpha(cur, 240), f), fmtC)

    if dragT > 0.01 {
        d := dragT
        b := SBrush(FA(Alpha(0x0B0C14, 118*d), f))
        FillEll(BBX - 30, BBY - 30, 60, 60, b), DelB(b)
        pn := Pen(FA(Alpha(cur, 200*d), f), 1.6)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
        Ell(BBX - 36, BBY - 36, 72, 72, pn), DelP(pn)
    }
}

; timer wrappers: only touch SetTimer when the period actually changes.
; Re-calling SetTimer with the same period every frame resets its countdown,
; making the effective interval (render cost + period) instead of the period.
RendTim(p) {
    global rendP
    ; The overlay runs its own timer, so the hub's cap never reached it - this
    ; window was still repainting at 125 fps with the switch on. Same rates as
    ; HubTim; the overlay is small, but it sits on top of a game.
    ; Keyed off the constants, NOT off a literal 8. When the base rates moved
    ; to 16/33 a `p <= 8` test stopped matching the busy rate at all, which
    ; would have dropped an actively dragged window to the idle cap.
    if hubLowPerf
        p := (p <= TICK_A) ? 40 : 220
    if p != rendP
        rendP := p, SetTimer(Render, p, -10)
}
HubTim(p) {
    global hubP
    ; Hidden means hidden. HubPoke is reached from a dozen background timers and
    ; from every WM_COPYDATA reply, and any one of them would otherwise re-arm
    ; the renderer behind a window nobody can see - which is exactly the cost
    ; this feature exists to remove. Stopping (p = 0) is always allowed.
    if (hubHidden && p)
        return
    ; ---- and a solve in progress is a window nobody is looking at ----
    ; The solver yields every PZ_BreathMs, and every timer that is due fires
    ; ONCE per yield - so the hub's rate during a solve never mattered: at 50 ms,
    ; 33 ms or 16 ms it landed exactly one frame per yield. What varied was the
    ; COST of that frame - the pill crossfading its gallery, a full hub on the
    ; community panel, an idle dashboard - and that cost was paid on every yield
    ; of every board, which is how the same board took a different time
    ; depending on what the hub happened to be showing. Solving requires Roblox
    ; to be FOCUSED, so the hub is behind it; its frames buy nothing there.
    ; Stopped, not slowed: a slower period still lands its one frame per yield
    ; until it is longer than the yield interval, and at that point it is a
    ; static picture with extra steps. HubPoke restarts it when the session
    ; ends. Here rather than only at the call site in PuzSolve because thirty
    ; other places ask for TICK_A directly and any one of them would re-arm it.
    ; IsSet for the same reason HubPoke gives: PZ_solving is assigned after
    ; HubOpen in the auto-execute order.
    if (p && IsSet(PZ_solving) && PZ_solving)
        return
    ; LOW PERFORMANCE MODE caps the frame rate on top of the tiers above it.
    ; 40 ms is still smooth enough to drag a window by; 220 ms is four frames a
    ; second, which is all a static picture needs; 300 ms is the deep tier,
    ; where nothing but slow ambient motion is left to miss.
    ; Keyed off the constants, not a literal 8 - see the note in RendTim.
    ; Max, not a plain assignment. This is a CAP - it may only ever make the
    ; renderer slower - and a bare assignment turned the 500 ms in-game stand-down
    ; into 300 ms, i.e. LOW PERFORMANCE MODE speeding the hub up while a game had
    ; focus, which is the exact opposite of both features.
    ; ---- and `&& p`, because Max(0, 40) is 40 ----
    ; The guard above says stopping is always allowed and this line then took it
    ; back: with LOW PERFORMANCE MODE on, every HubTim(0) in the file - HubHide,
    ; HubResNotice, HubFinish - asked for a stop and got a 40 ms timer instead.
    ; The renderer carried on against a hidden window, a window put away for a
    ; resolution change, and a hub that had already called ExitApp.
    ; ---- LOW PERFORMANCE MODE: three rates, all slower, and a stop ----
    ; Fast becomes 40 ms (25 fps) - enough for a drag to track and a switch
    ; to travel. Idle becomes 250. And deep idle STOPS the timer outright: in
    ; this mode nothing ambient is drawn, so a frame with no pointer on the
    ; card and nothing in flight would be the last frame again. Every input
    ; path pokes the loop back to TICK_A (HubPoke), and every background
    ; result that lands calls HubPoke too, so a stopped loop is never a stuck
    ; one - it is the hub costing nothing while it is left alone.
    if (hubLowPerf && p)
        p := (p <= TICK_A) ? 40 : (p <= TICK_S) ? 250 : 0
    if p != hubP
        hubP := p, SetTimer(HubRender, p, -10)
}

; card drop-shadow: the ring stack is deterministic per geometry, so it is
; rasterized once into a PARGB bitmap and drawn as a single image per frame
; (was: 8-10 near-full-surface antialiased rounded-rect alpha fills per frame,
; the single largest per-frame cost on every surface).
; baseA = per-ring alpha baked into the cache; dynA/f scale the whole stack at
; draw time (linear scaling of the composite; visually identical for these alphas).
; ---- armed systems ----
; Every module has its own "on" signal and the hub used to read only abOn, so
; FORSAKEN's autoblock was the only thing that lit the shell - the other three
; modules could all be enabled with the hub still looking idle. One predicate,
; used by both the armed chrome and the dashboard's active-systems tile.
;   FAST FLAG MANAGER : flags actually injected into Roblox (FFM.orig)
;   FORSAKEN          : autoblock armed
;   CURSOR            : cursor files written by the last apply
;   CLIENT SETTINGS   : master switch applied
;   plus any script currently running
SysArmedN() {
    n := abOn ? 1 : 0
    n += puzOn ? 1 : 0
    n += (FFM.orig.Count > 0) ? 1 : 0
    n += CSR.applied ? 1 : 0
    n += RSET.on ? 1 : 0
    n += (spfDiscord || spfRegion || spfMatch || spfOdds || spfMulti) ? 1 : 0
    return n + HL.runN
}
; Drops every cached shadow surface. Called when LOW PERFORMANCE MODE flips,
; because the cache is keyed on geometry and would otherwise keep serving
; surfaces built under the other setting.
; ---- e.bmp, not e ----
; shadowCache stores {bmp, bw, bh}; this handed the WRAPPER OBJECT to
; GdipDisposeImage, which fails, and the try ate the failure. So every flush
; dropped its references and leaked every bitmap in the cache - and these are
; full ARGB surfaces the size of the card plus its blur rings, the largest
; things this suite allocates. Cleanup got it right; this did not.
ShadowFlush() {
    global shadowCache
    for , e in shadowCache
        try DllCall("gdiplus\GdipDisposeImage", "ptr", e.bmp)
    shadowCache := Map()
}
; ---- and the cache had no ceiling ----
; Every other cache in the file is bounded - brCache and penCache flush at 4096
; a frame, the theme memos at 2048, MeasureW at 4000. This one grew for the life
; of the hub, and its key includes rounded WIDTH and HEIGHT: one caller whose
; panel size follows an animation mints a fresh full-size bitmap per pixel of
; travel and never gives one back. That is the slow-down that arrives with
; uptime rather than with any particular action.
;
; Least-recently-USED rather than oldest-created: the handful of shadows drawn
; every frame must not be evicted by a burst of one-off sizes. Only ever walked
; when the cap is already exceeded.
ShadowCacheTrim() {
    global shadowCache
    ; A static, NOT a top-level `global SHADOW_MAX := 64`. ShadowDraw is called
    ; by the LOADING SCREEN, which runs some fourteen thousand lines above where
    ; that initialiser would sit - a top-level global runs when control reaches
    ; it, so the first trim of the session would have read an unset variable and
    ; thrown. Same trap as the one documented at RN_gui and PuzSolveStop.
    static MAXN := 64
    while (shadowCache.Count > MAXN) {
        oldK := "", oldT := 0
        for k, e in shadowCache {
            if (oldK = "" || e.at < oldT)
                oldK := k, oldT := e.at
        }
        if (oldK = "")
            return
        try DllCall("gdiplus\GdipDisposeImage", "ptr", shadowCache[oldK].bmp)
        shadowCache.Delete(oldK)
    }
}
ShadowDraw(x, y, w, h, r0, rings, baseA, dynA, f, sc := 0) {
    global shadowCache, G, scaleF, hubOpacity, IA2
    ; LOW PERFORMANCE MODE drops shadows outright - a card without one still
    ; reads as a card because it has a border
    if hubLowPerf
        return
    sc := sc ? sc : scaleF
    pad := rings + 2
    key := Round(w) "|" Round(h) "|" r0 "|" rings "|" baseA "|" Round(sc*1000)
    if shadowCache.Has(key) {
        e := shadowCache[key]
        e.at := A_TickCount                   ; keeps the hot ones out of the trim
    } else {
        lw := w + pad*2, lh := h + pad*2
        bw := Round(lw*sc), bh := Round(lh*sc)
        DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", bw, "int", bh, "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &bmp := 0)
        DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", bmp, "ptr*", &sg := 0)
        DllCall("gdiplus\GdipSetSmoothingMode", "ptr", sg, "int", 4)
        DllCall("gdiplus\GdipScaleWorldTransform", "ptr", sg, "float", bw/lw, "float", bh/lh, "int", 0)
        loop rings {
            i := A_Index
            DllCall("gdiplus\GdipCreateSolidFill", "uint", (baseA & 0xFF) << 24, "ptr*", &sb := 0)
            p := RRPath(pad - i, pad - i, w + i*2, h + i*2, r0 + i)
            DllCall("gdiplus\GdipFillPath", "ptr", sg, "ptr", sb, "ptr", p)
            DllCall("gdiplus\GdipDeletePath", "ptr", p)
            DllCall("gdiplus\GdipDeleteBrush", "ptr", sb)
        }
        DllCall("gdiplus\GdipDeleteGraphics", "ptr", sg)
        e := {bmp: bmp, bw: bw, bh: bh, at: A_TickCount}
        shadowCache[key] := e
        ShadowCacheTrim()
    }
    a := f*hubOpacity*(dynA/baseA)
    if a <= 0.004
        return
    cm := Buffer(100, 0)
    NumPut("float", 1, cm, 0), NumPut("float", 1, cm, 24), NumPut("float", 1, cm, 48)
    NumPut("float", a, cm, 72), NumPut("float", 1, cm, 96)
    DllCall("gdiplus\GdipSetImageAttributesColorMatrix", "ptr", IA2, "int", 0, "int", 1, "ptr", cm, "ptr", 0, "int", 0)
    DllCall("gdiplus\GdipGetInterpolationMode", "ptr", G, "int*", &oim := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G, "int", 3)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", e.bmp
        , "float", x - pad, "float", y - pad, "float", w + pad*2, "float", h + pad*2
        , "float", 0, "float", 0, "float", e.bw, "float", e.bh
        , "int", 2, "ptr", IA2, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", G, "int", oim)
}

; blit one pool bitmap into a circular clip at alpha f (no ring/gloss)
BlitCircle(bmp, ax, ay, r, f) {
    ep := 0
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
    DllCall("gdiplus\GdipAddPathEllipse", "ptr", ep, "float", ax - r, "float", ay - r, "float", r*2, "float", r*2)
    stBC := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 1)
    SetImgAlpha(f)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
        , "float", ax - r, "float", ay - r, "float", r*2, "float", r*2
        , "float", 0, "float", 0, "float", SELW, "float", SELW
        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    Pop(stBC)
    DllCall("gdiplus\GdipDeletePath", "ptr", ep)
}
; Draw a bitmap's FULL extent into a rounded rect, scaled to cover and centred.
; BlitTallRR crops against SELW/SELTH - the avatar pool's fixed dimensions - so
; feeding it a 768x432 game banner sliced the picture apart. This one asks the
; image how big it actually is.
; zm/px/py are an optional Ken Burns crop: zm > 1 takes a tighter source rect
; (which reads as a zoom in), px/py place that rect across the source, 0.5 being
; centred. At the defaults the arithmetic reduces exactly to the centred crop
; every existing caller already gets.
BlitFitRR(bmp, x, y, w, h, r, f, zm := 1.0, px := 0.5, py := 0.5) {
    if !bmp
        return
    sw := 0, sh := 0
    DllCall("gdiplus\GdipGetImageWidth",  "ptr", bmp, "uint*", &sw)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", bmp, "uint*", &sh)
    if (!sw || !sh)
        return
    da := w/h, sa := sw/sh
    if (sa >= da)                                ; source wider - trim the sides
        sh2 := sh, sw2 := sh*da
    else                                         ; source taller - trim top/bottom
        sw2 := sw, sh2 := sw/da
    if (zm > 1.0)
        sw2 /= zm, sh2 /= zm
    sx2 := (sw - sw2)*px, sy2 := (sh - sh2)*py
    p := RRPath(x, y, w, h, r)
    stBF := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 1)
    SetImgAlpha(f)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
        , "float", x, "float", y, "float", w, "float", h
        , "float", sx2, "float", sy2, "float", sw2, "float", sh2
        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    Pop(stBF)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)
}
; ---- greedy word wrap ----
WrapText(txt, font, maxw, maxLines) {
    out := [], cur := ""
    for word in StrSplit(Trim(txt), " ") {
        if (word = "")
            continue
        try2 := (cur = "") ? word : (cur " " word)
        if (MeasureW(try2, font) <= maxw)
            cur := try2
        else {
            if (cur != "")
                out.Push(cur)
            cur := word
            if (out.Length >= maxLines)
                break
        }
    }
    if (cur != "" && out.Length < maxLines)
        out.Push(cur)
    if (out.Length > maxLines)
        out.Length := maxLines
    ; mark the tail when there was more than fits
    if (out.Length = maxLines && MeasureW(Trim(txt), font) > maxw*maxLines)
        out[maxLines] := FFMElide(out[maxLines] " ...", font, maxw)
    return out
}
BlitTallRR(bmp, x, y, w, h, r, f) {
    if !bmp
        return
    p := RRPath(x, y, w, h, r)
    stBT := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 1)
    SetImgAlpha(f)
    da := w/h
    if da >= SELW/(SELTH + 0.0)
        sw2 := SELW, sh2 := SELW/da, sx2 := 0, sy2 := (SELTH - sh2)/2
    else
        sh2 := SELTH, sw2 := SELTH*da, sy2 := 0, sx2 := (SELW - sw2)/2
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
        , "float", x, "float", y, "float", w, "float", h
        , "float", sx2, "float", sy2, "float", sw2, "float", sh2
        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    Pop(stBT)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)
}
BlitRRect(bmp, x, y, w, h, r, f) {
    p := RRPath(x, y, w, h, r)
    ; shared helper, called from inside other clipped regions - intersect and
    ; restore so it can never clear the caller's clip
    svB := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", p, "int", 1)
    SetImgAlpha(f)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
        , "float", x, "float", y, "float", w, "float", h
        , "float", 0, "float", 0, "float", SELW, "float", SELW
        , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    Pop(svB)
    DllCall("gdiplus\GdipDeletePath", "ptr", p)
}
; resolve pool index (1-based), clamped; 0 if pool empty
; Pool entries that form the Gallery. The user's cropped profile
; picture is always last and is never part of it.
SelDispN() => selN - (selCustomIdx ? 1 : 0)

SelAt(idx) {
    global selfies, selN
    if selN < 1
        return 0
    idx := Mod(idx - 1, selN) + 1
    return selfies[idx]
}
; ---- stable identity for a pool entry ----
; Pool order depends on which files are on disk, so an index is not portable
; between launches. The source filename (or the embedded image's name) is.
SelKey(idx) {
    global selSrc, selEmb, selfies
    if (idx < 1 || idx > selfies.Length)
        return ""
    if (idx <= selSrc.Length && selSrc[idx] != "") {
        SplitPath(selSrc[idx], &nm)
        return nm
    }
    return idx <= selEmb.Length ? selEmb[idx] : ""
}
SelFindKey(key) {
    global selfies
    if key = ""
        return 0
    loop selfies.Length
        if (SelKey(A_Index) = key)
            return A_Index
    return 0
}
SelAtTall(idx) {
    global selTall, selN
    if selN < 1
        return 0
    idx := Mod(idx - 1, selN) + 1
    return selTall[idx]
}
DrawAvatar(ax, ay, r, f) {
    global selN, selCur, selNext, selFadeAt, profPicSet
    have := profPicSet && selN >= 1
    if have {
        ft := selFadeAt ? Ease3((A_TickCount - selFadeAt)/SEL_FADE) : 1.0
        if selNext != selCur && ft < 1 {
            if a := SelAt(selCur)
                BlitCircle(a, ax, ay, r, f)
            if b := SelAt(selNext)
                BlitCircle(b, ax, ay, r, f*ft)
        } else if a := SelAt(selNext != selCur ? selNext : selCur)
            BlitCircle(a, ax, ay, r, f)
    } else {
        ; No picture chosen yet - a plain disc, no accent tint and no glyph.
        ; Blended off thT rather than pinned: a photo covers this completely
        ; when one is set, so it only ever shows while empty - and an empty
        ; slot that stays pure black in light mode is a black dot on paper.
        ; Not pure white either, or the placeholder would vanish into the card.
        b := SBrushP(FA(Alpha(Mix(0x000000, 0xE6EAF2, thT), 255), f))
        FillEll(ax - r, ay - r, r*2, r*2, b), DelB(b)
    }
    pn := Pen(FA(Alpha(0xFFFFFF, 58), f), 2)
    Arc(ax - (r - 4), ay - (r - 4), (r - 4)*2, (r - 4)*2, 195, 55, pn), DelP(pn)
}
SetImgAlpha(f) {
    f := f*hubOpacity
    cm := Buffer(100, 0)
    NumPut("float", 1, cm, 0), NumPut("float", 1, cm, 24), NumPut("float", 1, cm, 48)
    NumPut("float", f, cm, 72), NumPut("float", 1, cm, 96)
    DllCall("gdiplus\GdipSetImageAttributesColorMatrix", "ptr", IA, "int", 0, "int", 1, "ptr", cm, "ptr", 0, "int", 0)
}
; Reset a surface to its base state: no clip, identity + its own DPI scale.
; Clear honours the clip region and the world transform persists between
; frames, so one leaked Push/SetClip anywhere leaves stale pixels behind.
ResetSurface(gr, sx, sy) {
    DllCall("gdiplus\GdipResetClip", "ptr", gr)
    DllCall("gdiplus\GdipResetWorldTransform", "ptr", gr)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", gr, "float", sx, "float", sy, "int", 0)
}

; Re-present the hub's current surface and keep it in the topmost band.
; Creating another always-on-top window can drop the hub behind other topmost
; windows, which looks exactly like the hub vanishing.
; Keep the topmost band in the right order. While a modal (gallery / cropper)
; is up it owns the top and NOTHING else is re-raised: raising the hub first and
; the modal after left a frame where the hub covered it, which showed up as the
; modal blinking out and back at irregular intervals.
; Which Z band this suite's windows belong in. -1 is HWND_TOPMOST, -2 is
; HWND_NOTOPMOST - and -2 is not merely "do nothing": it CLEARS WS_EX_TOPMOST
; and still raises the window to the front of the ordinary band, which is
; exactly the behaviour ALWAYS ON TOP off is asking for. Passing 0 (HWND_TOP)
; instead would raise the window while leaving it in the topmost band, so the
; setting would appear to do nothing.
HubTopZ() => hubTop ? -1 : -2

; ---- put a window at the FRONT of the band it belongs to ----
; HubTopZ() alone cannot do this, and that is the whole of the "hub ends up
; behind everything after a browse" report.
;
; -1 (HWND_TOPMOST) genuinely raises, because it also promotes. -2
; (HWND_NOTOPMOST) is documented to have NO EFFECT ON Z ORDER when the window
; is ALREADY non-topmost - it exists to demote one that is topmost, nothing
; more. So with ALWAYS ON TOP switched off, every reassert in this file was a
; no-op: the file dialog took the foreground, the hub sank behind whatever was
; underneath, and the call meant to bring it back did nothing at all. With
; ALWAYS ON TOP on it worked, which is exactly why the report is specific about
; the setting being disabled.
;
; The two-step is the standard way round it: promote to topmost, which really
; does raise, then demote, which leaves the window at the FRONT of the normal
; band rather than buried in it. HubRaise already did this; HubReassert and
; GalZFix did not, and they are the ones the picker paths call.
; ---- bring the hub forward once a file dialog is gone ----
; The pickers run in child processes, and when the dialog closes the shell
; hands the foreground to whatever was behind it. Two things then go wrong:
; with ALWAYS ON TOP off the hub has no claim on the front, and on a CANCEL
; there is no reply message at all - so none of the code that reasserts the Z
; order downstream of a RESULT ever runs. The hub is simply left buried.
;
; One watcher covers every picker. Armed with a pid, it polls; called with
; nothing - which is what the timer does - it checks and raises once the child
; is gone, whatever the user did in the dialog.
;
; `watch` is a STATIC rather than a global on purpose. A top-level
; `global x := v` down here would never be assigned: the auto-execute section
; ends at the first hotkey label, hundreds of lines above this, so the
; declaration would be hoisted and the value never set. That trap has already
; cost this file its gallery hide list once.
HubPickWatch(pid := 0) {
    static watch := 0
    if pid {
        watch := pid
        SetTimer(HubPickWatch, 250)
        return
    }
    if (watch && ProcessExist(watch))
        return
    watch := 0
    SetTimer(HubPickWatch, 0)
    ; GalZFix, not HubReassert: it already knows to raise the cropper or the
    ; gallery instead of the hub when one of them owns the top, and that is
    ; usually the state a picker was launched from.
    GalZFix()
}
HubZRaise(hw) {
    if !hw
        return
    try {
        DllCall("SetWindowPos", "ptr", hw, "ptr", -1
            , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
        if !hubTop
            DllCall("SetWindowPos", "ptr", hw, "ptr", -2
                , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    }
}

GalZFix() {
    modal := (cropUIOn && cropHwnd) ? cropHwnd
           : ((galOpen && galHwnd) ? galHwnd : 0)
    if modal {
        HubZRaise(modal)
        return
    }
    if hubLive && IsObject(HL)
        HubZRaise(HL.gui.Hwnd)
    if abOn && IsObject(ui)
        HubZRaise(ui.Hwnd)
}

HubReassert() {
    if !hubLive || !IsObject(HL)
        return
    if (galOpen || cropUIOn)        ; a modal owns the top - leave it there
        return
    HubZRaise(HL.gui.Hwnd)
}

; small hand-drawn marks used to fill the empty stretches in CREDITS.
; kind: 1 star, 2 spiral, 3 squiggle, 4 arrow, 5 orbit dot
Doodle(kind, dx, dy, sc, col, f, now, ph) {
    ; LOW PERFORMANCE MODE: no doodles - little drawn ornaments, nothing more
    if hubLowPerf
        return
    tw := (Sin(DecT(now)*0.0014 + ph) + 1)/2
    al := Round(70 + 90*tw)
    pn := Pen(FA(Alpha(col, al), f), 1.3)
    if (kind = 1) {
        loop 4 {
            a := (A_Index - 1)*45 + now*0.02
            r := (Mod(A_Index, 2) ? 1.0 : 0.55)*sc*(0.85 + 0.15*tw)
            Line(dx - r*Cos(a*0.017453), dy - r*Sin(a*0.017453)
               , dx + r*Cos(a*0.017453), dy + r*Sin(a*0.017453), pn)
        }
    } else if (kind = 2) {
        pr := 0, px := dx, py := dy
        loop 22 {
            t := A_Index/22.0
            a := t*720 + now*0.03
            r := t*sc
            nx := dx + r*Cos(a*0.017453), ny := dy + r*Sin(a*0.017453)
            if pr
                Line(px, py, nx, ny, pn)
            px := nx, py := ny, pr := 1
        }
    } else if (kind = 3) {
        px := dx - sc, py := dy
        loop 18 {
            t := A_Index/18.0
            nx := dx - sc + t*sc*2
            ny := dy + Sin(t*9.4 + now*0.003 + ph)*sc*0.42
            Line(px, py, nx, ny, pn)
            px := nx, py := ny
        }
    } else if (kind = 4) {
        Line(dx - sc, dy + sc*0.5, dx + sc*0.4, dy - sc*0.5, pn)
        Line(dx + sc*0.4, dy - sc*0.5, dx + sc*0.1, dy - sc*0.1, pn)
        Line(dx + sc*0.4, dy - sc*0.5, dx, dy - sc*0.62, pn)
    } else {
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
        Ell(dx - sc, dy - sc*0.62, sc*2, sc*1.24, pn)
        DelP(pn)
        oa := now*0.0022 + ph
        b := SBrush(FA(Alpha(AccHi(col, 0.45), 200), f))
        FillEll(dx + sc*Cos(oa) - 1.6, dy + sc*0.62*Sin(oa) - 1.6, 3.2, 3.2, b), DelB(b)
        return
    }
    DelP(pn)
}

SelTick(now) {
    global selCur, selNext, selFadeAt, selCycleAt, selQG
    if selFadeAt && now - selFadeAt >= SEL_FADE
        selCur := selNext, selFadeAt := 0, selCycleAt := now
    if (!selFadeAt && selQG) {
        if (selQG != selCur)
            selNext := selQG, selFadeAt := now, selCycleAt := now
        selQG := 0
    }
}

; Retarget the shared avatar crossfade without ever snapping the blend:
; already heading there -> ignore, going back -> reverse in place,
; anything else -> queue until the running fade lands.
SelSwitchG(idx) {
    global selCur, selNext, selFadeAt, selQG
    if (idx < 1)
        return
    if selFadeAt {
        if (idx = selNext)
            return
        if (idx = selCur) {
            e0 := Ease3(Clamp((A_TickCount - selFadeAt)/SEL_FADE, 0.0, 1.0))
            tmp := selCur, selCur := selNext, selNext := tmp
            selFadeAt := A_TickCount - Round(Ease3Inv(1 - e0)*SEL_FADE)
            selQG := 0
            return
        }
        selQG := idx
        return
    }
    selQG := 0
    if (idx = selCur) {
        selNext := idx
        return
    }
    selNext := idx, selFadeAt := A_TickCount
}

PushG() {
    DllCall("gdiplus\GdipSaveGraphics", "ptr", G, "uint*", &st := 0)
    return st
}
PushXform(px, py, s, rot) {
    DllCall("gdiplus\GdipSaveGraphics", "ptr", G, "uint*", &st := 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "ptr", G, "float", px, "float", py, "int", 0)
    if rot
        DllCall("gdiplus\GdipRotateWorldTransform", "ptr", G, "float", rot, "int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G, "float", s, "float", s, "int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "ptr", G, "float", -px, "float", -py, "int", 0)
    return st
}
PushShift(dx, dy) {
    DllCall("gdiplus\GdipSaveGraphics", "ptr", G, "uint*", &st := 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "ptr", G, "float", dx, "float", dy, "int", 0)
    return st
}
Pop(st) => DllCall("gdiplus\GdipRestoreGraphics", "ptr", G, "uint", st)

; ================= helpers =================
ClockStr() {
    global clkStr, clkAt
    if A_TickCount - clkAt >= 500 || clkStr = ""
        clkStr := FormatTime(A_Now, "HH:mm:ss"), clkAt := A_TickCount
    return clkStr
}
CurHour() {
    global curHrC, curHrAt
    if A_TickCount - curHrAt >= 10000 || !curHrAt
        curHrC := Integer(FormatTime(, "H")) + 1, curHrAt := A_TickCount
    return curHrC
}
BgScale(c) => bgOpacity >= 0.996 ? (0xFF000000 | (c & 0xFFFFFF)) : ((Round(((c >> 24) & 0xFF)*bgOpacity) & 0xFF) << 24) | (c & 0xFFFFFF)
ThemeTick() {
    global thT, thAt
    if !thAt
        return
    t := Min((A_TickCount - thAt)/THEME_MS, 1.0)
    thT := Lerp(thFrom, thTo, 1 - (1 - t)**3)
    if t >= 1
        thAt := 0, thT := thTo
}
; ---- accent highlight ----
; "A brighter version of this accent" is Mix(acc, white, t) on a dark surface.
; On paper that is backwards twice over: it lowers contrast, and once the base
; is desaturated the result is a near-neutral near-white that THLight cannot
; tell apart from body text - so it comes out as ink. The loading ring is the
; worst case: curL blends rose -> green across the bar, and at ~54% it is a
; sage grey whose white-mix has a spread of 10, identical to a UI neutral.
; That is why the whole ring, bar and readout went black mid-load.
;
; So the highlight moves AWAY from the surface: toward white on dark, toward a
; near-ink on paper. The target crossfades on thT, so the theme animation
; carries it across and there is no step for a highlight to pop through.
;
; The paper target is a mid slate, NOT near-black. Darker targets push the
; mixed result under THLight's mx <= 0x70 line, where a dark colour is flipped
; to near-white for use as a background - and the highlight vanished into the
; page instead of going black. 0x6A707E was solved for: swept against every
; accent, every accent-to-accent blend and every mix ratio in the file, it is
; the lightest target with zero such flips.
; ---- keep an accent an accent ----
; Blending two accents in RGB passes through grey: rose -> green is a sage at
; the midpoint, and rose -> teal is very nearly neutral. A desaturated colour
; lands in THLight's "neutral mid-tone" branch, which strips the hue and
; returns near-black - so the loading bar's accent goes BLACK twice as it
; sweeps, once on the way into the grey and once on the way out. Same for the
; gate, and for six of the fifteen accent-change pairs.
;
; Fixed at the source rather than in THLight, which cannot tell a desaturated
; accent from body text by colour alone. Chroma is pushed back out only as far
; as clearing that branch, and only for colours that need it - a saturated
; accent gets k = 1 and is returned untouched. Dark mode is byte-identical:
; thT = 0 returns c immediately.
AccSat(c) {
    if (thT <= 0.002)
        return c
    r := (c >> 16) & 0xFF, g := (c >> 8) & 0xFF, b := c & 0xFF
    sp := Max(r, g, b) - Min(r, g, b)
    if (sp <= 0 || sp >= 0x3C)
        return c
    k := Min(0x3C/sp, 6.0)
    y := (r*30 + g*59 + b*11)//100
    nr := Clamp(Round(y + (r - y)*k), 0, 255)
    ng := Clamp(Round(y + (g - y)*k), 0, 255)
    nb := Clamp(Round(y + (b - y)*k), 0, 255)
    m := (c & 0xFF000000) | (nr << 16) | (ng << 8) | nb
    return thT >= 0.998 ? m : Mix(c, m, thT)
}
AccHi(c, t) {
    global ahMemo, ahMemoT
    ; Colour is 32 bits and t is a 0..1 blend, so pack rather than build a
    ; string key - a string key is an allocation per call, and this is called
    ; from inside loops.
    ky := c*4096 + Round(t*1000)
    if (thT != ahMemoT)
        ahMemo := Map(), ahMemoT := thT
    else if ahMemo.Has(ky)
        return ahMemo[ky]
    v := AccHiCalc(c, t)
    if (ahMemo.Count < 2048)
        ahMemo[ky] := v
    return v
}
AccHiCalc(c, t) {
    dk := Mix(c, 0xFFFFFFFF, t)                  ; the dark-theme highlight
    if (thT <= 0.002)
        return dk
    ; ---- paper highlight ----
    m := Mix(c, 0xFF6A707E, t)
    r := (m >> 16) & 0xFF, g := (m >> 8) & 0xFF, b := m & 0xFF
    sp := Max(r, g, b) - Min(r, g, b)
    ; Darkening alone is not enough. A desaturated accent - the loading ring is
    ; a rose->green blend, and mid-bar it is a sage grey - comes out of the mix
    ; with a channel spread under 0x38, which is exactly THLight's "neutral
    ; mid-tone" branch, and that branch strips the hue and returns near-black.
    ; So chroma is pushed back out, but only as far as clearing that branch and
    ; only for colours that need it: an accent that is already saturated gets
    ; k = 1 and is left exactly as the mix made it.
    if (sp > 0 && sp < 0x3C) {
        k := Min(0x3C/sp, 6.0)
        y := (r*30 + g*59 + b*11)//100
        r := Clamp(Round(y + (r - y)*k), 0, 255)
        g := Clamp(Round(y + (g - y)*k), 0, 255)
        b := Clamp(Round(y + (b - y)*k), 0, 255)
        m := (m & 0xFF000000) | (r << 16) | (g << 8) | b
    }
    return thT >= 0.998 ? m : Mix(dk, m, thT)
}
TH(c) {
    global thMemo, thMemoT
    if thT <= 0.002
        return c
    if (thT != thMemoT)                ; a moving thT means a different answer
        thMemo := Map(), thMemoT := thT
    else if thMemo.Has(c)
        return thMemo[c]
    lc := THLight(c)
    v := thT >= 0.998 ? lc : Mix(c, lc, thT)
    if (thMemo.Count < 2048)
        thMemo[c] := v
    return v
}

; ---- theme-space blending ----
; THLight is a CLASSIFIER, not a continuous map: it sorts a colour into a
; branch by min/max channel and luminance, and each branch transforms very
; differently. Blending two design colours and handing the result to a
; primitive therefore walks the blend across branch boundaries, and the drawn
; colour snaps partway through an animation. The switch track was the visible
; case: Mix(0xFF2A2D44, 0xFF34D399, on) sits in the "very dark, lighten to
; near-white" branch until on = 0.41, then crosses into the passthrough branch
; and jumps straight to a dark teal before settling on green.
; Blending the MAPPED endpoints instead is continuous by construction, and both
; ends still land on colours THLight was actually tuned for.
; The result is ALREADY themed. Draw it with SBrushP/TxtP below - running it
; back through TH() inverts it, because THLight reads a light colour as a
; dark-mode source and maps it to dark ink.
THMix(c1, c2, t) => Mix(TH(c1), TH(c2), t)
TxtP(s, x, y, w, h, font, c, fmt) {
    b := SBrushP(c)
    static rc := Buffer(16)
    NumPut("float", x, "float", y, "float", w, "float", h, rc)
    DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", s, "int", -1, "ptr", font, "ptr", rc, "ptr", fmt, "ptr", b)
    DelB(b)
}
THLight(c) {
    static m := 0
    if !m {
        m := Map()
        m[0x222438] := 0xFFFFFF, m[0x121423] := 0xFCFCFD
        m[0x171A30] := 0xFFFFFF, m[0x12141F] := 0xFDFDFE
        m[0x161930] := 0xFFFFFF, m[0x10121C] := 0xFCFCFD
        m[0x10131F] := 0xFFFFFF, m[0x0C0E17] := 0xFAFBFC
        m[0x141728] := 0xFFFFFF, m[0x1B2038] := 0xF2F5FA
        m[0x1E2340] := 0xF6F8FC, m[0x20254A] := 0xEEF3FB
        m[0x1C2142] := 0xF5F8FC, m[0x232744] := 0xF0F4FB
        m[0x31344C] := 0xFFFFFF, m[0x20223A] := 0xF1F3F7
        m[0x41466A] := 0xF6F8FC, m[0x262A45] := 0xE9EDF4
        m[0x33354E] := 0xDFE3EB, m[0x3A3D58] := 0xF2F4F8
        m[0x23263C] := 0xFFFFFF, m[0x191C2E] := 0xF4F6F9
        m[0x0B0C14] := 0xF3F5F8, m[0x05060C] := 0xF6F8FB
        m[0x6B7392] := 0x99A2B8
    }
    rgb := c & 0xFFFFFF
    if !rgb || rgb = 0xFEFEFE
        return c
    if m.Has(rgb)
        return (c & 0xFF000000) | m[rgb]
    r := (rgb >> 16) & 0xFF, g := (rgb >> 8) & 0xFF, b := rgb & 0xFF
    mx := Max(r, g, b), mn := Min(r, g, b)
    ; ---- near-white ----
    ; Two different jobs meet here. A NEUTRAL near-white is UI text or a
    ; highlight, and on paper it has to become ink. A SATURATED near-white is a
    ; pale accent tint - Mix(acc, white, t) - and it has to stay that accent,
    ; only darker.
    ;
    ; This used to be one hard branch that treated both as text, so a pastel
    ; rose or violet came out at r*0.13, effectively black. Those mixes are
    ; driven by pulses and hovers, so the colour crossed the boundary and back
    ; every frame - the black FLASH on the gate and loading screens.
    ;
    ; A hard saturation cutoff would only move the flash to the cutoff, so the
    ; two results are BLENDED across the saturation range instead. Real UI
    ; neutrals span at most 28 (0xC7CBE0 is the widest) and land on pure ink;
    ; an accent tint spans 56+ and keeps its hue. Nothing is discontinuous, so
    ; no animation can flash across it.
    if (mn >= 0xB0) {
        a  := (c >> 24) & 0xFF
        sw := Clamp((0x40 - (mx - mn))/40.0, 0.0, 1.0)     ; 1 neutral, 0 tinted
        ; ---- faint foreground gets lifted ----
        ; A half-alpha near-white over a near-black panel is a perfectly
        ; legible hint line. The same alpha over paper is a pale grey: the ink
        ; it maps to is dark, but half of nothing is still nothing. Measured on
        ; white, alpha 0x62 came out at 2.4:1 and 0x7E at 3.2:1, both under the
        ; 4.5:1 floor - which is the washed-out hint text in the flag manager's
        ; empty state.
        ;
        ; The curve is sqrt, so it lifts the middle hard and the bottom barely:
        ; 0x62 -> 4.7:1 and 0x7E -> 6.2:1, while a decorative alpha 8 or 15
        ; stays decorative. Scoped to the UI FOREGROUND neutrals (0xC7CBE0,
        ; 0xE8EAF6 and friends, spread >= 8) and NOT to the pure-white family,
        ; which is sheens, hover plates and hatches - lifting those would paint
        ; grey smears across every light-theme surface.
        if (mx - mn >= 8 && a > 0 && a < 0xFF) {
            a := Min(0xFF, Round(255*(a/255.0)**0.5))
            ; The curve alone still left the faintest tertiary labels - version
            ; stamps, subtitles, the 0x36..0x5C band - under the floor, so
            ; anything that was meant to be READ at all is floored at 0x9B,
            ; measured as the exact 4.5:1 point for this ink on white. Alphas
            ; under 0x30 are decoration and keep falling away to nothing.
            if ((c >> 24) & 0xFF >= 0x30)
                a := Max(a, 0x9B)
        }
        if (a <= 0x60 && sw > 0.5)
            return ((Min(0xFF, Round(a*2.7)) & 0xFF) << 24) | 0x9BA3B4
        lum := (r*30 + g*59 + b*11)/25500.0
        kk  := lum > 0.58 ? 0.58/lum : 1.0
        nr  := Round(r*kk + (r*0.13 - r*kk)*sw)
        ng  := Round(g*kk + (g*0.13 - g*kk)*sw)
        nb  := Round(b*kk + (b*0.15 - b*kk)*sw)
        return (a << 24) | (nr << 16) | (ng << 8) | nb
    }
    if mx <= 0x70 {
        t := Min(0xFE, 0xF8 + Round((0x70 - (r*30 + g*59 + b*11)//100)*0.05))
        return (c & 0xFF000000) | (t << 16) | (t << 8) | Min(0xFF, t + 1)
    }
    if mx - mn < 0x38 {
        ; Mid-tone -> ink, but RAMPED rather than switched. This was a hard
        ; branch: a colour animating across spread 0x38 jumped straight from
        ; hue-preserved to near-black, which is a flash. The ramp only spans
        ; the top 0x14 of the range, so a genuine UI grey (0x9AA8C0 at spread
        ; 38, 0x6E7590 at 34) still lands on full ink and stays readable,
        ; while anything approaching the threshold eases into it.
        a2 := (c >> 24) & 0xFF
        if (a2 >= 0x30 && a2 < 0xFF)
            a2 := Max(Min(0xFF, Round(255*(a2/255.0)**0.5)), 0xAD)
        w2  := Clamp((0x38 - (mx - mn))/20.0, 0.0, 1.0)
        lum := (r*30 + g*59 + b*11)/25500.0
        kk  := lum > 0.58 ? 0.58/lum : 1.0
        nr  := Round(r*kk + (r*0.32 - r*kk)*w2)
        ng  := Round(g*kk + (g*0.32 - g*kk)*w2)
        nb  := Round(b*kk + (b*0.34 - b*kk)*w2)
        return (a2 << 24) | (nr << 16) | (ng << 8) | nb
    }
    lum := (r*30 + g*59 + b*11)/25500.0
    if lum > 0.58 {
        k := 0.58/lum
        return (c & 0xFF000000) | (Round(r*k) << 16) | (Round(g*k) << 8) | Round(b*k)
    }
    return c
}
; ---- emoji-aware text ----
; Splits a string into runs the body font can draw and runs it cannot, and
; hands each to the family that carries it. Only the description uses this:
; it is the one place fed arbitrary text from Roblox, and per-run measuring is
; not worth paying for on a label the suite wrote itself.
;
; The test is by code point, not by lookup - anything astral (a surrogate pair
; in UTF-16) plus the BMP symbol and dingbat blocks, and the joiners that hold
; a sequence together so a flag or a family does not get split down the middle.
IsEmojiCp(cp) {
    return (cp >= 0x1F000)                                   ; astral symbols
        || (cp >= 0x2190 && cp <= 0x2BFF)                     ; arrows, misc, dingbats
        || (cp >= 0xFE00 && cp <= 0xFE0F)                     ; variation selectors
        || (cp = 0x200D)                                      ; zero-width joiner
        || (cp >= 0x2000 && cp <= 0x206F && cp != 0x2018 && cp != 0x2019
            && cp != 0x201C && cp != 0x201D && cp != 0x2013 && cp != 0x2014
            && cp != 0x2026 && cp != 0x0020)                  ; punctuation we do carry
}
TextRuns(str) {
    runs := [], cur := "", curE := -1, i := 1, n := StrLen(str)
    while (i <= n) {
        ch := SubStr(str, i, 1)
        cp := Ord(ch)
        w  := 1
        ; a surrogate pair is one code point across two UTF-16 units
        if (cp >= 0xD800 && cp <= 0xDBFF && i < n) {
            lo := Ord(SubStr(str, i + 1, 1))
            if (lo >= 0xDC00 && lo <= 0xDFFF)
                cp := 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00), w := 2
        }
        e := IsEmojiCp(cp) ? 1 : 0
        if (e != curE && cur != "")
            runs.Push({t: cur, e: curE}), cur := ""
        curE := e, cur .= SubStr(str, i, w), i += w
    }
    if (cur != "")
        runs.Push({t: cur, e: curE})
    return runs
}
TxtRich(str, x, y, w, h, font, fontE, col, fmt) {
    if (!famE || !fontE) {
        Txt(str, x, y, w, h, font, col, fmt)
        return
    }
    runs := TextRuns(str)
    if (runs.Length <= 1) {
        Txt(str, x, y, w, h, runs.Length && runs[1].e ? fontE : font, col, fmt)
        return
    }
    cx := x
    for , rn in runs {
        fo2 := rn.e ? fontE : font
        rw  := MeasureW(rn.t, fo2)
        if (cx + rw > x + w)                     ; ran out of line, stop cleanly
            break
        Txt(rn.t, cx, y, rw + 6, h, fo2, col, fmt)
        cx += rw
    }
}
NewFontE(sz, style) {
    if !famE
        return 0
    DllCall("gdiplus\GdipCreateFont", "ptr", famE, "float", sz, "int", style, "int", 2, "ptr*", &f := 0)
    return f
}
NewFontM(sz, style) {
    global famM
    DllCall("gdiplus\GdipCreateFont", "ptr", famM, "float", sz, "int", style, "int", 2, "ptr*", &f := 0)
    return f
}
DrawAvatarBase(ax, ay, r, f) {
    if bm := SelAt(1)
        BlitCircle(bm, ax, ay, r, f)
    else {
        b := SBrush(FA(Alpha(hubAccent, 50), f))
        FillEll(ax - r, ay - r, r*2, r*2, b), DelB(b)
        Txt("P", ax - r, ay - r, r*2, r*2, fStatus, FA(Alpha(hubAccent, 235), f), fmtC)
    }
    pn := Pen(FA(Alpha(0xFFFFFF, 58), f), 2)
    Arc(ax - (r - 4), ay - (r - 4), (r - 4)*2, (r - 4)*2, 195, 55, pn), DelP(pn)
