            StrokeRR(gbx + 15, gby + 9, 13, 10, 2, pn)
            StrokeRR(gbx + 11, gby + 6, 13, 10, 2, pn), DelP(pn)
            Txt("MANAGE", gbx + 34, gby + 5.5, 74, 15, HL.fS, FA(Alpha(AccHi(hubCur, 0.4), 235), f), fmtL)
            ; The card is anchored to the footer band rather than to the strip
            ; above it, so nothing added higher up the page can push it down
            ; into the version stamp. RSH keeps the button, the swatches and
            ; both caption lines inside one shorter card.
            RSH := 46
            ; Pinned to the footer band outright. The Min is kept so a future
