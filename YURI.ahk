; The capture went to another window (lParam) or nowhere: whatever was being
; dragged is dropped where it is, through the same path a release takes.
; Our own ReleaseCapture lands here too, with the state already cleared, and
; falls straight out.
HubCapLost(wParam, lParam, msg, hwnd) {
    if (!hubLive || hwnd != HL.gui.Hwnd || lParam = HL.gui.Hwnd)
        return
    if (HL.drag || SH.msel || FFM.msel)
        HubBtnUp(wParam, lParam, 0x202, hwnd)
}
HubBtnUp(wParam, lParam, msg, hwnd) {
    if !hubLive || (!HL.drag && !SH.msel && !FFM.msel)
        return
    ; The state is read and cleared BEFORE the capture is released:
    ; ReleaseCapture posts WM_CAPTURECHANGED, HubCapLost answers it by coming
    ; back here, and with the drag still armed that second pass would have run
    ; the whole tail and stolen the click from the first.
    if FFM.msel
        FFM.msel := 0
    if SH.msel
        SH.msel := 0
    wasClick := (HL.drag = 1), z := HL.dragZone
    wasSlide := (HL.drag = 3 || HL.drag = 4)
    was19 := (HL.drag = 19)
    SPF.avDrag := 0
    HL.drag := 0, HL.dragZone := 0
    HL.dragOff := -1                             ; next drag samples a fresh grip
    DllCall("ReleaseCapture")
    if was19
        try IniWrite(Round(PZ_SpeedT, 3), iniPath, "puzzle", "speed")
    if wasClick && z = 9
        HubMin(0.0)
    if wasSlide {
        try IniWrite(Round(hubOpacity, 3), iniPath, "hub", "opacity")
        try IniWrite(Round(bgOpacity, 3), iniPath, "hub", "bg")
        if abOn
            RendTim(TICK_A)
    }
    HubPoke()
    return 0
}
; second click of a double-click arrives as 0x203, not 0x201 - without this the
; click is simply lost, so forward non-field cases and select a word on fields
HubDblClick(wParam, lParam, msg, hwnd) {
    if !hubLive || hwnd != HL.gui.Hwnd
        return
    if (DET.on || DET.t > 0.004)
        return 0
    CursorXY(&x, &y)
    z := HubZone(x, y)
    isFFM := (z = 422 || z = 437 || (z >= 541 && z <= 545) || RSetIsFldZone(z))
    isScr := (z = 66 || z = 67 || z = 240 || z = 241 || z = 136 || z = 137
           || z = 966 || z = 967 || z = 1006 || z = 1009)
    isEd  := (z = 242)
    if (isFFM || isScr || isEd || FFMActFld()) {
        if ((isFFM || isScr || isEd) && !FFMActFld())
            HubClick(wParam, lParam, 0x201, hwnd)
        md := FFMActFld()
        if (md = 3) {
            ScrWordSelect()
            SH.msel := 0
        } else if md {
            FFMWordAt(FFMActText(), FFMActCar(), &wa, &wb)
            FFMActSetRange(wb, wa)
            if (md = 1)
                FFM.dblAt := A_TickCount, FFM.msel := 0
            else
                SH.dblAt := A_TickCount, SH.msel := 0
        }
        return 0
    }
    return HubClick(wParam, lParam, 0x201, hwnd)
}

HubRClick(wParam, lParam, msg, hwnd) {
    if !hubLive || hwnd != HL.gui.Hwnd
        return
    if (DET.on || DET.t > 0.004)
        return 0
    if FFM.ctx {
        FFMCtxClose()
        return 0
    }
    CursorXY(&x, &y)
    z := HubZone(x, y)
    isFld := (z = 422 || z = 437 || (z >= 541 && z <= 545) || RSetIsFldZone(z)
           || z = 66 || z = 67 || z = 240 || z = 241 || z = 136 || z = 137 || z = 242)
    if (!isFld && !FFMActFld())
        return 0
    if (isFld && !FFMActFld()) {
        HubClick(wParam, lParam, 0x201, hwnd)
        FFM.msel := 0, SH.msel := 0
    }
    k := HL.pw/HL.bw
    FFMCtxOpen((x - HL.px)/k, (y - HL.py)/k)
    return 0
}

HubMove(wParam, lParam, msg, hwnd) {
    if !hubLive || hwnd != HL.gui.Hwnd
        return
    ; ---- a drag whose button is no longer down is over ----
    ; The release is supposed to arrive as WM_LBUTTONUP through the capture.
    ; Lose the capture - a window of this process activating, a system
    ; cancel - and it never does: the drag stays armed, and the next move
    ; over the window, seconds later and pixels away, throws the window to
    ; the pointer. Both buttons checked, for a swapped-button mouse.
    if ((HL.drag || SH.msel || FFM.msel)
        && !GetKeyState("LButton", "P") && !GetKeyState("RButton", "P")) {
        HubBtnUp(wParam, lParam, 0x202, hwnd)
        return 0
    }
    CursorXY(&x, &y)
    if SH.msel = 2 {
        if ScrFldIsLine() {
            k2 := HL.pw/HL.bw
            vv := ScrFld()
            FldWindow(vv, SH.fCar, fHint, ScrFldWidth(), &vo)
            SH.fCar := vo + ScrFldCaretX(SubStr(vv, vo + 1), (x - HL.px)/k2 - ScrFldOriginX())
            SH.caretAt := A_TickCount
        }
        HubPoke()
        return 0
    }
    if SH.msel {
        ScrCaretFromMouse(x, y)
        SH.selOn := (SH.sl != SH.cl || SH.sc != SH.cc) ? 1 : 0
        HubPoke()
        return 0
    }
    if FFM.msel {
        FFMFldDrag(x)
        return 0
    }
    if !HL.drag {
        ; motion over the card is pointer contact whether or not it is over a
        ; zone - it keeps the hub off the deep tiers for HUB_DEEP_MS, so a
        ; cursor drifting across blank card does not land on a 100 ms frame
        if IsObject(HL)
            HL.pokeAt := A_TickCount
        HubPoke()
        return
    }
    if HL.drag = 19 {
        PuzSlideSet(x)
        return 0
    }
    if HL.drag = 3 || HL.drag = 4 {
        HubSlideSet(x, HL.drag = 3 ? 1 : 2)
        return 0
    }
    if HL.drag = 5 || HL.drag = 6 || HL.drag = 11 || HL.drag = 12 {
        FFMDragScroll(y)
        return 0
    }
    if HL.drag = 23 {
        FFMCommDragBody(y)
        return 0
    }
    if HL.drag = 24 {
        FFMCommDragDsc(HL.dragZone - 580, y)
        return 0
    }
    if HL.drag = 25 {
        FFMCommDragSet(HL.dragZone - FFM_CMZ_SBAR, y)
        return 0
    }
    if HL.drag = 13 {
        CurDragScroll(y)
        return 0
    }
    if HL.drag = 18 {
        DetailDragScroll(y)
        return 0
    }
    if HL.drag = 14 {
        RSetDragScroll(y)
        return 0
    }
    if HL.drag = 21 {
        RSetFxDragScroll(y)
        return 0
    }
    if HL.drag = 22 {
        RSetDbDragScroll(y)
        return 0
    }
    if HL.drag = 16 {
        SPFDragScroll(y)
        return 0
    }
    if HL.drag = 17 {
        ; screen pixels straight to radians. Pitch is clamped so the figure
        ; can be tilted to look at but never rolled upside down.
        CursorXY(&amx, &amy)
        SPF.avYaw   += (amx - SPF.avPX)*0.011      ; sensitivity, not an ease
        SPF.avPitch := Clamp(SPF.avPitch + (amy - SPF.avPY)*0.009, -0.9, 0.9)
        SPF.avPX := amx, SPF.avPY := amy
        HubPoke()
        return 0
    }
    if HL.drag = 15 {
        RSetSlideSet(RSET.sld, x)
        return 0
    }
    if HL.drag = 7 {
        ScrListDrag(y)
        return 0
    }
    if HL.drag = 10 {
        ScrEdVDrag(y)
        return 0
    }
    if HL.drag = 9 {
        ScrEdHDrag(x)
        return 0
    }
    if HL.drag = 1 && (x - HL.grX)**2 + (y - HL.grY)**2 > 16
        HL.drag := 2
    if HL.drag != 2
        return 0
    HL.bx := HL.grBX + (x - HL.grX), HL.by := HL.grBY + (y - HL.grY)
    HubClampPos()
    return 0
}
; ---- where the hub is allowed to sit ----
; Two handles, and which one is live follows the INTENT (HL.minTo), not the
; eased HL.minT. That distinction is the same one HubBodyLive was written for:
; HL.minT crosses 0.5 at the MIDPOINT of the animation, so reading it here -
; which is what this clamp used to do - meant the first half of every expand ran
; under the pill's bounds while the hit test was already handing out the
; expanded zones. Grab the grip during those 240 ms and the hub could be shoved
; most of the way off the display in one drag.
HubClampBounds(&lox, &hix, &loy, &hiy) {
    k := HL.pw/HL.bw
    if (HL.minTo = 1.0)                                   ; collapsed: the pill
        HandleBounds(HL.mbx - MBW/2, HL.mby - MBH/2
                   , HL.mbx + MBW/2, HL.mby + MBH/2, k, &lox, &hix, &loy, &hiy)
    else                                                  ; open: the 6-dot grip
        HandleBounds(HL.brx + 68, HL.pd + 10
                   , HL.brx + 104, HL.pd + 34, k, &lox, &hix, &loy, &hiy)
}
; ---- where the hub sits when it is centred ----
; The same arithmetic HubOpen places it with, against the CURRENT work area -
; which after a resolution change is the new one, and is the whole point.
HubCenterPos(&cx, &cy) {
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    cx := mL + ((mR - mL) - HL.pw)//2
    cy := mT + ((mB - mT) - HL.ph)//2
}
HubClampPos() {
    HubClampBounds(&lox, &hix, &loy, &hiy)
    HL.bx := Clamp(HL.bx, lox, hix), HL.by := Clamp(HL.by, loy, hiy)
}
; The per-frame half, and the reason nothing else needs a WM_DISPLAYCHANGE hook:
; the bounds are recomputed every frame from the CURRENT virtual desktop, so a
; resolution change, a monitor unplugged, or the handle swapping between grip
; and pill all correct themselves the same way. Returns 1 while a correction is
; still running so the caller can keep the renderer at the fast tier.
;
; Eased rather than snapped on purpose. Pressing minimise switches the live
; handle from the grip to the pill in one frame, and a hard jump of up to a few
; hundred pixels in the middle of a collapse reads as a glitch; walking there
; over the same few frames the card is shrinking reads as part of it. A drag is
; the exception - the pointer owns the window then, so that stays exact.
HubClampTick() {
    HubClampBounds(&lox, &hix, &loy, &hiy)
    ; ---- recentring rides the correction that is already here ----
    ; The resolution card asks for the hub to come back to the middle of the
    ; screen, and this loop already eases the window toward a target every frame
    ; and reports through posFix so the renderer stays on the fast tier while it
    ; moves. So the recentre is a different TARGET, not a second mover - a snap
    ; would jump a window the user is looking at, and a parallel animation would
    ; be one more thing to keep in step with the clamp.
    ;
    ; Still clamped: on a screen that got smaller the centre of the new work
    ; area can put the handle out of reach, and the bounds win over the wish.
    if (HL.HasOwnProp("reCtr") && HL.reCtr) {
        HubCenterPos(&ccx, &ccy)
        tx := Clamp(ccx, lox, hix), ty := Clamp(ccy, loy, hiy)
        if (Abs(tx - HL.bx) <= 1 && Abs(ty - HL.by) <= 1)
            HL.reCtr := 0                      ; arrived - back to plain clamping
    } else
        tx := Clamp(HL.bx, lox, hix), ty := Clamp(HL.by, loy, hiy)
    if (HL.drag = 2 || (Abs(tx - HL.bx) <= 1 && Abs(ty - HL.by) <= 1)) {
        HL.bx := tx, HL.by := ty
        return 0
    }
    HL.bx := StepTo(HL.bx, tx, EK(0.24)), HL.by := StepTo(HL.by, ty, EK(0.24))
    return 1
}
