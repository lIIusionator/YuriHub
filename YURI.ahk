            ; backdrop - carry it here or the swatch misrepresents the result
            MiniBackdrop(pvx, pvy, 64, 40, 8, hubCur, f*bgOpacity, now, 0.7)
            pn := Pen(FA(Alpha(hubCur, 120), f), 1)
            StrokeRR(pvx, pvy, 64, 40, 8, pn), DelP(pn)
            b := SBrush(FA(Alpha(hubCur, Round(210*hubOpacity)), f))
            FillRR(pvx + 7, pvy + 7, 12, 2.2, 1.1, b), DelB(b)
            b := SBrush(FA(Alpha(0xC7CBE0, Round(120*hubOpacity)), f))
