            Txt("GALLERY", gbx - 16 - 190, pvy + 6, 190, 12, HL.fS, FA(0x58C7CBE0, f), fmtR)
            ; galHidN is CACHED. The first version called GalHiddenN() here,
            ; which enumerates a folder - once per frame, thirty times a second.
            Txt(galRotN " in rotation" (galHidN ? ("  ·  " galHidN " removed") : "")
              , gbx - 16 - 190, pvy + 21, 190, 13, HL.fXs, FA(Alpha(hubCur, 150), f), fmtR)
            b := VBrush(gbx, gby, 116, 26, FA(Alpha(hubCur, 40 + 55*hvG), f), FA(Alpha(hubCur, 16 + 26*hvG), f))
            FillRR(gbx, gby, 116, 26, 8, b), DelB(b)
            pn := Pen(FA(Alpha(hubCur, 120 + 110*hvG), f), 1.1)
            StrokeRR(gbx, gby, 116, 26, 8, pn), DelP(pn)
            ; a stack of two frames, the same picture-set mark the manager uses
