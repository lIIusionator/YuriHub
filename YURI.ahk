            ; past the bottom of the card it sits in. Kept identical in HubZone.
            ryR := Min(pvy + 48, HubFtrY() - RSH)
            b := VBrush(x0, ryR, HL.ctw, RSH, FA(0xFF14172A, f), FA(0xFF0F1120, f))
            FillRR(x0, ryR, HL.ctw, RSH, 12, b), DelB(b)
