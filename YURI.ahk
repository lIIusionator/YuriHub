    global TUT_STEPS
    st := []
    st.Push({tab: 1, mod: -1, ttl: "WELCOME TO YURI", cur: 0, glyph: "brand", anchor: 0
        , body: ["This is a hub of tools for Roblox: fast flags, cursors, client"
