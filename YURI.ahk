; ---- browser login cookie detect child ----
; Reads the .ROBLOSECURITY cookie from the isolated login browser over the
; Chrome DevTools Protocol.  AcctAddFromBrowser() launches that browser with
; --remote-debugging-port on an isolated profile; here we connect to that
; port, open the DevTools websocket, and ask Storage.getCookies.  DevTools
; hands back cookie VALUES in plaintext, so this sidesteps disk encryption
; entirely (DPAPI, Chrome 127+ app-bound "v20", and the SQLite WAL that the
; just-set login cookie lives in) and needs no Python or pip packages.
; Result goes back to the parent via WM_COPYDATA 0x5A22 once it appears.
if A_Args.Length >= 3 && A_Args[1] = "cookiedetect" {
    Suspend true
    hwnd   := Integer(A_Args[2])
    port   := Integer(A_Args[3])
    result := CdpGetRoblosecurity(port)
    if result != "" {
        sb := Buffer(StrPut(result, "UTF-16"))
        StrPut(result, sb, "UTF-16")
        cds := Buffer(A_PtrSize*3)
        NumPut("uptr", 0x5A22, cds, 0)
        NumPut("uint", sb.Size, cds, A_PtrSize)
        NumPut("ptr", sb.Ptr, cds, A_PtrSize*2)
        DllCall("SendMessage", "ptr", hwnd, "uint", 0x4A, "ptr", 0, "ptr", cds)
    }
    ExitApp
}

; Pull the .ROBLOSECURITY cookie from a DevTools endpoint on 127.0.0.1:port.
; Pure WinHTTP - the WebSocket API (Win8+) does the handshake, masking and
; framing for us, so this is far less error-prone than hand-rolling a socket.
; Returns the cookie value, or "" if the port isn't up yet / no cookie yet.
CdpGetRoblosecurity(port) {
    for path in CdpWsPaths(port) {
        v := CdpQueryCookies(port, path)
        if v != ""
            return v
    }
    return ""
}
; Candidate DevTools websocket paths: every page target first, browser last.
; Which target actually answers a cookie query depends on the browser build,
; so we try them in turn rather than betting on one.
CdpWsPaths(port) {
    paths := [], late := []
    try {
        req := ComObject("WinHttp.WinHttpRequest.5.1")
        req.Open("GET", "http://127.0.0.1:" port "/json", false)
        req.SetTimeouts(4000, 4000, 4000, 4000)
        req.Send()
        txt := req.ResponseText
        pos := 1
        ; Seeding the profile with the user's extensions means this list is no
        ; longer just the login tab - every extension page target shows up here
        ; too, and each one that is tried costs up to a 4 s websocket timeout.
        ; The roblox tab is the one that can answer, so it goes first and the
        ; rest are only reached if it does not.
        while (fnd := RegExMatch(txt, 'webSocketDebuggerUrl"\s*:\s*"(ws://[^"]+)"', &m, pos)) {
            if InStr(m[1], "/devtools/page/") {
                ; the target's own url sits a little before its socket url in
                ; the same object - close enough to read back for a hint
                head := SubStr(txt, Max(1, fnd - 600), Min(600, fnd - 1))
                if InStr(head, "roblox.com")
                    paths.Push(CdpPathOf(m[1]))
                else
                    late.Push(CdpPathOf(m[1]))
            }
            pos := fnd + StrLen(m[0])
        }
        for p in late
            paths.Push(p)
    }
    try {
        req := ComObject("WinHttp.WinHttpRequest.5.1")
        req.Open("GET", "http://127.0.0.1:" port "/json/version", false)
        req.SetTimeouts(4000, 4000, 4000, 4000)
        req.Send()
        if RegExMatch(req.ResponseText, 'webSocketDebuggerUrl"\s*:\s*"([^"]+)"', &m)
            paths.Push(CdpPathOf(m[1]))
    }
    return paths
}
CdpPathOf(wsUrl) {
    idx := InStr(wsUrl, "/devtools")
    return idx ? SubStr(wsUrl, idx) : "/devtools/browser"
}
; Open the DevTools websocket at `path`, ask for cookies with whichever method
; that target speaks, and return the .ROBLOSECURITY value (or "").  Pure WinHTTP
; - the WebSocket API (Win8+) does the handshake, masking and framing for us.
; DevTools hands back cookie VALUES in plaintext, so this sidesteps disk
; encryption entirely (DPAPI, Chrome 127+ app-bound "v20", and the SQLite WAL
; the just-set login cookie lives in) and needs no Python or pip packages.
CdpQueryCookies(port, path) {
    hSession := DllCall("winhttp\WinHttpOpen", "ptr", 0, "uint", 0, "ptr", 0, "ptr", 0, "uint", 0, "ptr")
    if !hSession
        return ""
    result := ""
    hWs := 0
    try {
        hConnect := DllCall("winhttp\WinHttpConnect", "ptr", hSession, "wstr", "127.0.0.1", "ushort", port, "uint", 0, "ptr")
        if !hConnect
            throw Error("connect")
        hRequest := DllCall("winhttp\WinHttpOpenRequest", "ptr", hConnect, "wstr", "GET", "wstr", path, "ptr", 0, "ptr", 0, "ptr", 0, "uint", 0, "ptr")
        if !hRequest
            throw Error("openreq")
        DllCall("winhttp\WinHttpSetTimeouts", "ptr", hRequest, "int", 4000, "int", 4000, "int", 4000, "int", 4000)
        if !DllCall("winhttp\WinHttpSetOption", "ptr", hRequest, "uint", 114, "ptr", 0, "uint", 0)   ; UPGRADE_TO_WEB_SOCKET
            throw Error("setopt")
        if !DllCall("winhttp\WinHttpSendRequest", "ptr", hRequest, "ptr", 0, "uint", 0, "ptr", 0, "uint", 0, "uint", 0, "uptr", 0)
            throw Error("send")
        if !DllCall("winhttp\WinHttpReceiveResponse", "ptr", hRequest, "ptr", 0)
            throw Error("recv")
        hWs := DllCall("winhttp\WinHttpWebSocketCompleteUpgrade", "ptr", hRequest, "uptr", 0, "ptr")
        DllCall("winhttp\WinHttpCloseHandle", "ptr", hRequest)
        if !hWs
            throw Error("upgrade")

        ; Ask BOTH cookie APIs on every target rather than betting on one:
        ; Network.getAllCookies is deprecated in newer builds and
        ; Storage.getCookies is missing from older ones. An unknown method just
        ; returns an error object, so the cost of asking twice is one message.
        ok := 0
        if CdpSend(hWs, '{"id":1,"method":"Network.getAllCookies"}')
            ok++
        if CdpSend(hWs, '{"id":2,"method":"Storage.getCookies"}')
            ok++
        if !ok
            throw Error("send-cmd")

        combined := "", got1 := false, got2 := false
        rbuf := Buffer(65536)
        loop 80 {
            got := 0, btype := 0
            rc := DllCall("winhttp\WinHttpWebSocketReceive", "ptr", hWs, "ptr", rbuf, "uint", rbuf.Size, "uint*", &got, "int*", &btype)
            if rc != 0
                break
            if got > 0
                combined .= StrGet(rbuf, got, "UTF-8")
            ; btype 0=BINARY_MESSAGE 1=BINARY_FRAGMENT 2=UTF8_MESSAGE
            ;       3=UTF8_FRAGMENT 4=CLOSE.  A long reply arrives as FRAGMENT
            ;       buffers followed by a MESSAGE buffer, so only test on 0/2.
            if btype = 4
                break
            if btype = 0 || btype = 2 {
                v := CdpFindCookie(combined)
                if v != "" {
                    result := v
                    break
                }
                if InStr(combined, '"id":1')
                    got1 := true
                if InStr(combined, '"id":2')
                    got2 := true
                ; both commands answered and neither carried the cookie
                if got1 && got2
                    break
            }
        }
    }
    if hWs
        try DllCall("winhttp\WinHttpWebSocketClose", "ptr", hWs, "ushort", 1000, "ptr", 0, "uint", 0)
    if hWs
        try DllCall("winhttp\WinHttpCloseHandle", "ptr", hWs)
    try DllCall("winhttp\WinHttpCloseHandle", "ptr", hSession)
    return result
}
; Sends one JSON command as a WebSocket TEXT frame. Returns true on success.
; Two things here are easy to get wrong and both silently break detection:
;   * buffer type must be 2 (WINHTTP_WEB_SOCKET_UTF8_MESSAGE). Type 0 is
;     BINARY_MESSAGE - DevTools only processes text frames, so a JSON command
;     sent as binary is dropped and no response ever arrives.
;   * StrPut writes a null terminator, so the buffer must have room for it
;     (same Buffer(StrPut(...)) form used everywhere else in this file). The
;     frame length then excludes that null.
CdpSend(hWs, msg) {
    n  := StrPut(msg, "UTF-8")                 ; bytes INCLUDING the null
    mb := Buffer(n)
    StrPut(msg, mb, "UTF-8")
    return DllCall("winhttp\WinHttpWebSocketSend", "ptr", hWs, "uint", 2
        , "ptr", mb, "uint", n - 1) = 0
}
; Find the .ROBLOSECURITY value in a DevTools cookie JSON blob.  Cookie
; objects serialise name-then-value, but tolerate either order.  The value
; has no embedded quotes, so [^"]* is safe.
CdpFindCookie(json) {
    ; the .ROBLOSECURITY value always opens with the warning banner, so match
    ; on that directly - immune to however the cookie's fields are ordered
    if RegExMatch(json, '"value"\s*:\s*"(_\|WARNING:[^"]*)"', &m)
        return m[1]
    if RegExMatch(json, '"name"\s*:\s*"\.ROBLOSECURITY"\s*,\s*"value"\s*:\s*"([^"]*)"', &m)
        return m[1]
    if RegExMatch(json, '"value"\s*:\s*"([^"]*)"\s*,\s*"name"\s*:\s*"\.ROBLOSECURITY"', &m)
        return m[1]
    return ""
}

