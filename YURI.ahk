    ; overlay, which owns the whole window while a drag is running
    DetailDraw(cf, now, hubCur)

    if HL.dragT > 0.01 && HL.minT < 0.5 {
        d := HL.dragT
        b := SBrush(FA(Alpha(0x0B0C14, 122*d), cf))
        FillRR(cx, cy, cw, ch, 20, b), DelB(b)
        pn := Pen(FA(Alpha(hubCur, 205*d), cf), 1.6)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
        StrokeRR(cx + 3, cy + 3, cw - 6, ch - 6, 17, pn), DelP(pn)
        mcx := cx + cw/2, mcy := cy + ch/2 - 7
        pn := Pen(FA(Alpha(0xFFFFFF, 225*d), cf), 1.8)
        loop 4 {
            a_ := (A_Index - 1) * 1.5708
            x2 := mcx + 13*Cos(a_), y2 := mcy + 13*Sin(a_)
            Line(mcx + 4*Cos(a_), mcy + 4*Sin(a_), x2, y2, pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ - 0.5), y2 - 4.5*Sin(a_ - 0.5), pn)
            Line(x2, y2, x2 - 4.5*Cos(a_ + 0.5), y2 - 4.5*Sin(a_ + 0.5), pn)
        }
        DelP(pn)
        Txt("MOVING", mcx - 40, mcy + 16, 80, 14, fBadge, FA(Alpha(0xFFFFFF, 235*d), cf), fmtC)
    }
    Pop(stM)
    }

    ; Armed-aware base for every orb border layer. stCol already tracks the
    ; armed state; the layers below used to be split between this and raw
    ; hubCur, so half the frame stayed accent-coloured while the hub was armed.
    bcol := AccHi(stCol, 0.14)
    mbA  := HL.armT                              ; armed strength for orb chrome
    mbPul := (Sin(DecT(now)*0.0021) + 1)/2             ; slow breathe under the halo

    ; ---- collapse cues: a ring closing onto the orb plus inbound sparks ----
    if HL.minStart {
        mDir := (HL.minTo = 1.0)
        mp := Clamp(HL.minV, 0.0, 1.0)
        rp := mDir ? mp : 1 - mp
        if (rp > 0.02 && rp < 0.995) {
            rr := Lerp(330, 34, Ease3(rp))
            ra := Round(165*(1 - rp)**1.6*(mDir ? 1 : 0.8))
            if (ra > 3) {
                pn := Pen(Alpha(AccHi(bcol, 0.25), ra), 2.6*(1 - rp) + 0.5)
                Ell(HL.mbx - rr, HL.mby - rr, rr*2, rr*2, pn), DelP(pn)
            }
        }
        sp := Sin(3.14159*Clamp(mp, 0.0, 1.0))
        if (sp > 0.04) {
            loop 8 {
                sk := A_Index
                sAng := sk*0.7854 + (mDir ? 0.35 : 1.95)
                d0 := 215 + Mod(sk*67, 110)
                dd := mDir ? Lerp(d0, 30, Ease3(mp)) : Lerp(30, d0, Ease3(1 - mp))
                b := SBrush(Alpha(AccHi(bcol, 0.5), Round(205*sp)))
                FillEll(HL.mbx + dd*Cos(sAng) - 1.7, HL.mby + dd*Sin(sAng) - 1.7, 3.4, 3.4, b), DelB(b)
                b := SBrush(Alpha(AccHi(bcol, 0.3), Round(70*sp)))
                FillEll(HL.mbx + (dd + 9)*Cos(sAng) - 1.1, HL.mby + (dd + 9)*Sin(sAng) - 1.1, 2.2, 2.2, b), DelB(b)
            }
        }
    }
    bt_ := Max(0.0, (Clamp(HL.minV, 0.0, 1.0) - 0.34)/0.66)
    if bt_ > 0.004 {
        hubDrew := 1
        eb := 1 + 2.3*((bt_ - 1)**3) + 1.3*((bt_ - 1)**2)
        prsB := (HL.scatAt && now - HL.scatAt < 120) ? 1 - 0.06*(1 - (now - HL.scatAt)/120.0) : 1
        h9 := HL.h.Get(9, 0.0)
        bsc := (0.55 + 0.45*eb) * prsB * (1 + 0.05*h9)
        rotB := -35 * (1 - Clamp(bt_, 0.0, 1.0))**2
        fB := Min(bt_*1.6, 1.0)
        stB := PushXform(HL.mbx, HL.mby, bsc, rotB)
        if h9 > 0.01 {
            b := SBrush(FA(Alpha(bcol, 26*h9), fB))
            FillRR(HL.mbx - MBW/2 - 7, HL.mby - MBH/2 - 7, MBW + 14, MBH + 14, 22, b), DelB(b)
        }
        ; ---- gallery card: tall selfies (index 2+), avatar.* deliberately skipped ----
        gw3 := MBW, gh3 := MBH, gr3 := 16
        gx3 := HL.mbx - gw3/2, gy3 := HL.mby - gh3/2
        if (GalHasRot()) {
            if (HL.mbIdx < GalLo() || HL.mbIdx > GalHi())
                HL.mbIdx := GalLo(), HL.mbNext := GalLo()
            if (!HL.mbFade && now - HL.mbAt >= 4200) {
                HL.mbNext := (HL.mbIdx >= GalHi()) ? GalLo() : HL.mbIdx + 1
                HL.mbFade := now, HL.mbAt := now
            }
        }
        gfd := HL.mbFade ? Ease3((now - HL.mbFade)/460.0) : 1.0

        loop 5 {
            b := SBrush(FA(Alpha(0x000000, 10 + 5*HL.dragT), fB))
            FillRR(gx3 - A_Index, gy3 - A_Index + 2, gw3 + A_Index*2, gh3 + A_Index*2, gr3 + A_Index, b), DelB(b)
        }
        b := SBrush(FA(Alpha(0xFF0B0C14, 235), fB))
        FillRR(gx3, gy3, gw3, gh3, gr3, b), DelB(b)
        if (GalHasRot()) {
            BlitTallRR(SelAtTall(HL.mbIdx), gx3, gy3, gw3, gh3, gr3, fB)
            if HL.mbFade
                BlitTallRR(SelAtTall(HL.mbNext), gx3, gy3, gw3, gh3, gr3, fB*gfd)
            if (HL.mbFade && gfd >= 1)
                HL.mbIdx := HL.mbNext, HL.mbFade := 0
        } else {
            DrawAvatar(HL.mbx, HL.mby, gw3/2 - 4, fB)
        }
        ; bottom scrim so the glyphs stay legible over any photo
        pC3 := RRPath(gx3, gy3, gw3, gh3, gr3)
        DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pC3, "int", 0)
        b := VBrush(gx3, gy3 + gh3 - 30, gw3, 30, Alpha(0x000000, 0), FA(0x9E000000, fB))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", gx3, "float", gy3 + gh3 - 30, "float", gw3, "float", 30), DelB(b)
        bandY3 := gy3 + Mod(DecT(now)*0.045, gh3 + 50) - 25
        b := VBrush(gx3, bandY3, gw3, 18, Alpha(0xFFFFFF, 0), FA(Alpha(0xFFFFFF, 22), fB))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", gx3, "float", bandY3, "float", gw3, "float", 18), DelB(b)
        DllCall("gdiplus\GdipResetClip", "ptr", G)
        DllCall("gdiplus\GdipDeletePath", "ptr", pC3)
        ; (frame is drawn by the border stack below, after the photo)
        ; one dot per ROTATION entry, not per pool entry - the pool also holds
        ; the pictures taken out of the rotation and the overlay portrait, and
        ; counting those put dots under a carousel that never reaches them
        if (GalHasRot()) {
            loop galRotN {
                dk := A_Index
                onD := (dk = HL.mbIdx - gateBase)
                b := SBrush(FA(Alpha(onD ? AccHi(bcol, 0.4) : 0xFFFFFF, onD ? 235 : 70), fB))
                FillEll(HL.mbx - (galRotN - 1)*3 + (dk - 1)*6 - 1.6, gy3 + gh3 - 11, 3.2, 3.2, b), DelB(b)
            }
        }
        if h9 > 0.01 {
            ep := 0
            DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ep)
            DllCall("gdiplus\GdipDeletePath", "ptr", ep)
            ep := RRPath(HL.mbx - MBW/2, HL.mby - MBH/2, MBW, MBH, 16)
            DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", ep, "int", 0)
            b := SBrush(FA(Alpha(0x05060C, 168*h9), fB))
            FillRR(HL.mbx - MBW/2, HL.mby - MBH/2, MBW, MBH, 16, b), DelB(b)
            gy2 := HL.mby - 14 + (1 - h9)*7
            pn := Pen(FA(Alpha(0xFFFFFF, 215*h9), fB), 1.6)
            Line(HL.mbx - 5, gy2 + 4, HL.mbx, gy2 - 1, pn)
            Line(HL.mbx, gy2 - 1, HL.mbx + 5, gy2 + 4, pn)
            Line(HL.mbx - 5, gy2 + 10, HL.mbx, gy2 + 5, pn)
            Line(HL.mbx, gy2 + 5, HL.mbx + 5, gy2 + 10, pn), DelP(pn)
            Txt("OPEN", HL.mbx - 26, HL.mby + 3 + (1 - h9)*7, 52, 14, fBadge, FA(Alpha(0xFFFFFF, 245*h9), fB), fmtC)
            DllCall("gdiplus\GdipResetClip", "ptr", G)
            DllCall("gdiplus\GdipDeletePath", "ptr", ep)
        }
        ; ---- border stack: soft halo, gradient ring, inner hairline, glint ----
        bxL := HL.mbx - MBW/2, bxR := HL.mbx + MBW/2
        byT := HL.mby - MBH/2, byB := HL.mby + MBH/2

        ; soft accent halo, strongest right at the edge; breathes when armed
        loop 4 {
            hk := A_Index
            ha := (26 - hk*5)*(0.55 + 0.45*embG)*(1 + 0.55*mbA*mbPul)
            b := SBrush(FA(Alpha(bcol, Round(Min(255, ha))), fB))
            FillRR(bxL - hk*2.2, byT - hk*2.2, MBW + hk*4.4, MBH + hk*4.4, gr3 + hk*2, b), DelB(b)
        }

        ; gradient ring: the bright end drifts instead of sitting fixed, so the
        ; rim light reads as light moving over the frame rather than a decal
        rimT := (Sin(DecT(now)*0.0013) + 1)/2
        gbr := VBrush(bxL - 1, byT - 1, MBW + 2, MBH + 2
            , FA(Alpha(AccHi(bcol, 0.45 + 0.30*rimT), 240), fB)
            , FA(Alpha(Mix(bcol, 0xFF000000, 0.24 - 0.14*rimT), Round(150 + 30*rimT)), fB))
        DllCall("gdiplus\GdipCreatePen2", "ptr", gbr, "float", 1.8, "int", 2, "ptr*", &gpn := 0)
        StrokeRR(bxL - 1, byT - 1, MBW + 2, MBH + 2, gr3 + 1, gpn)
        DllCall("gdiplus\GdipDeletePen", "ptr", gpn), DelB(gbr)

        ; status bar set into the top edge: widens and brightens when armed
        stbW := 14 + 16*mbA
        b := VBrush(HL.mbx - stbW/2, byT - 1.4, stbW, 2.8
            , FA(Alpha(AccHi(bcol, 0.7), Round(120 + 120*mbA)), fB)
            , FA(Alpha(bcol, Round(60 + 90*mbA)), fB))
        FillRR(HL.mbx - stbW/2, byT - 1.4, stbW, 2.8, 1.4, b), DelB(b)

        ; crisp inner hairline lifts the photo off the frame, and picks up the
        ; armed tint so the whole frame agrees rather than half of it
        pn := Pen(FA(Alpha(AccHi(bcol, 1 - (0.55*mbA)), Round(38 + 26*mbA)), fB), 1)
        StrokeRR(bxL + 1.5, byT + 1.5, MBW - 3, MBH - 3, gr3 - 1.5, pn), DelP(pn)

        ; corner brackets tracing the actual corner curve, echoing the expanded
        ; card's corner arcs so collapsed and open read as the same object
        loop 4 {
            ck := A_Index - 1
            csh := (Sin(DecT(now)*0.0032 + ck*1.5708) + 1)/2
            cxk := (ck = 1 || ck = 2) ? bxR - gr3*2 : bxL
            cyk := (ck >= 2) ? byB - gr3*2 : byT
            cang := ck = 0 ? 195 : ck = 1 ? 285 : ck = 2 ? 15 : 105
            pn := Pen(FA(Alpha(bcol, Round(Min(255, 40 + 38*csh + 74*mbA))), fB), 1.5 + 0.4*mbA)
            Arc(cxk, cyk, gr3*2, gr3*2, cang, 60, pn), DelP(pn)
        }

        ; ---- style layer: follows the portrait ring chosen in EDIT PROFILE, so
        ; the collapsed orb is recognisably the same identity as the avatar ----
        if profRing = 2 {
            ; DASH - two dashed frames turning against each other
            pn := Pen(FA(Alpha(bcol, Round(150 + 60*mbA)), fB), 1.6)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.02, 1000))
            StrokeRR(bxL - 3, byT - 3, MBW + 6, MBH + 6, gr3 + 3, pn), DelP(pn)
            pn := Pen(FA(Alpha(AccHi(bcol, 0.4), Round(70 + 60*mbA)), fB), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", 1000 - Mod(DecT(now)*0.031, 1000))
            StrokeRR(bxL - 7, byT - 7, MBW + 14, MBH + 14, gr3 + 7, pn), DelP(pn)

        } else if profRing = 3 {
            ; DUAL - two comet heads on opposite sides of the perimeter
            d0 := Mod(DecT(now)*0.00042, 1.0)
            loop 2 {
                hd := (A_Index - 1)*0.5
                loop 5 {
                    tk := A_Index - 1
                    RectPerim(d0 + hd - tk*0.014, bxL - 3, byT - 3, MBW + 6, MBH + 6, &gxg, &gyg)
                    ta := (1 - tk/5.0)**2
                    r6 := 2.2*ta + 0.4
                    b := SBrush(FA(Alpha(AccHi(bcol, 0.5), Round(215*ta)), fB))
                    FillEll(gxg - r6, gyg - r6, r6*2, r6*2, b), DelB(b)
                }
            }

        } else if profRing = 4 {
            ; ORBIT - three satellites on three offset tracks, matching the
            ; three-orbit portrait ring
            loop 3 {
                ok := A_Index
                ins := -1 - ok*4
                spd := (ok = 1) ? 0.00042 : (ok = 2) ? -0.00028 : 0.00019
                RectPerim(now*spd + ok*0.31, bxL + ins, byT + ins
                        , MBW - ins*2, MBH - ins*2, &gxg, &gyg)
                if (ok = 1) {
                    b := SBrush(FA(Alpha(bcol, 55), fB))
                    FillEll(gxg - 6, gyg - 6, 12, 12, b), DelB(b)
                    b := SBrush(FA(Alpha(AccHi(bcol, 0.6), 210), fB))
                    FillEll(gxg - 2, gyg - 2, 4, 4, b), DelB(b)
                } else {
                    sr := (ok = 2) ? 2.4 : 1.8
                    b := SBrush(FA(Alpha(AccHi(bcol, ok = 2 ? 0.3 : 0.12)
                                        , Round((ok = 2 ? 150 : 105) + 60*mbA)), fB))
                    FillEll(gxg - sr, gyg - sr, sr*2, sr*2, b), DelB(b)
                }
            }

        } else {
            ; SOLID - the glint head with its comet trail, plus a counter spark
            gl4 := Mod(DecT(now)*0.00042, 1.0)
            loop 6 {
                tk := A_Index - 1
                RectPerim(gl4 - tk*0.013, bxL, byT, MBW, MBH, &gxg, &gyg)
                if (tk = 0) {
                    b := SBrush(FA(Alpha(bcol, 55), fB))
                    FillEll(gxg - 6, gyg - 6, 12, 12, b), DelB(b)
                    b := SBrush(FA(Alpha(AccHi(bcol, 0.6), 210), fB))
                    FillEll(gxg - 2, gyg - 2, 4, 4, b), DelB(b)
                } else {
                    ta := (1 - tk/6.0)**2
                    r5 := 1.5*ta + 0.35
                    b := SBrush(FA(Alpha(AccHi(bcol, 0.45), Round(150*ta)), fB))
                    FillEll(gxg - r5, gyg - r5, r5*2, r5*2, b), DelB(b)
                }
            }
            RectPerim(0.5 - gl4, bxL, byT, MBW, MBH, &g2x, &g2y)
            b := SBrush(FA(Alpha(bcol, Round(64 + 66*mbA)), fB))
            FillEll(g2x - 3.4, g2y - 3.4, 6.8, 6.8, b), DelB(b)
        }

        ; armed: a slow ping shedding off the frame, idle costs nothing
        if mbA > 0.02 {
            pt5 := Mod(DecT(now), 1700)/1700.0
            pn := Pen(FA(Alpha(bcol, Round(115*mbA*(1 - pt5)**1.5)), fB), 2.0*(1 - pt5) + 0.3)
            ex7 := 3 + pt5*22
            StrokeRR(bxL - ex7, byT - ex7, MBW + ex7*2, MBH + ex7*2, gr3 + ex7*0.5, pn), DelP(pn)
        }

        ; hover reveals a dashed orbit instead of showing it permanently
        if (h9 > 0.01) {
            pn := Pen(FA(Alpha(bcol, Round((60 + 25*embG)*h9)), fB), 1.2)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", 1000 - Mod(DecT(now)*0.02, 1000))
            StrokeRR(bxL - 8, byT - 8, MBW + 16, MBH + 16, gr3 + 8, pn), DelP(pn)
            ; a tighter orbit turning the other way - two crossing rates read as
            ; rotation, where one dashed ring alone reads as a marquee
            pn := Pen(FA(Alpha(AccHi(bcol, 0.35), Round(42*h9)), fB), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.034, 1000))
            StrokeRR(bxL - 4, byT - 4, MBW + 8, MBH + 8, gr3 + 4, pn), DelP(pn)
        }
        if h9 > 0.01 {
            prt := Mod(DecT(now), 950)/950.0
            pn := Pen(FA(Alpha(bcol, 130*h9*(1 - prt)), fB), 2.2*(1 - prt) + 0.4)
            ex4 := 6 + prt*13
            StrokeRR(HL.mbx - MBW/2 - ex4, HL.mby - MBH/2 - ex4, MBW + ex4*2, MBH + ex4*2, 20 + ex4*0.4, pn), DelP(pn)
        }
        if HL.scatAt && now - HL.scatAt < 380 {
            e := Ease3((now - HL.scatAt)/380.0)
            pn := Pen(FA(Alpha(0xFFFFFF, 190*(1 - e)), fB), 2.6*(1 - e) + 0.4)
            ex5 := 2 + e*14
            StrokeRR(HL.mbx - MBW/2 - ex5, HL.mby - MBH/2 - ex5, MBW + ex5*2, MBH + ex5*2, 18 + ex5*0.4, pn), DelP(pn)
        }
        if HL.burstAt && now >= HL.burstAt {
            btm := (now - HL.burstAt)/450.0
            if btm >= 1
                HL.burstAt := 0
            else {
                e := 1 - (1 - btm)**3
                pn := Pen(FA(Alpha(bcol, 170*(1 - e)), fB), 2.6*(1 - e) + 0.4)
                ex6 := 2 + e*20
                StrokeRR(HL.mbx - MBW/2 - ex6, HL.mby - MBH/2 - ex6, MBW + ex6*2, MBH + ex6*2, 18 + ex6*0.5, pn), DelP(pn)
            }
        }
        gqx := HL.mbx + 12, gqy := HL.mby + 12
        b := SBrush(FA(0x59000000, fB))
        FillEll(gqx + 1, gqy + 2.5, 20, 19, b), DelB(b)
        b := VBrush(gqx, gqy, 20, 20, FA(0xFF3A3D58, fB), FA(0xFF20223A, fB))
        FillRR(gqx, gqy, 20, 20, 6, b), DelB(b)
        MicroBackdrop(gqx, gqy, 20, 20, 6, bcol, fB, now, 0.8)
        pn := Pen(FA(Alpha(bcol, 150 + 70*embG), fB), 1)
        StrokeRR(gqx, gqy, 20, 20, 6, pn), DelP(pn)
        b := SBrush(FA(Alpha(bcol, 240), fB))
        loop 4 {
            q := A_Index
            qx2 := gqx + 5.4 + Mod(q - 1, 2)*5.4, qy2 := gqy + 5.4 + ((q - 1) // 2)*5.4
            FillRR(qx2, qy2, 3.8, 3.8, 1.1, b)
        }
        DelB(b)
        if HL.dragT > 0.01 && HL.minT >= 0.5 {
            d := HL.dragT
            b := SBrush(FA(Alpha(0x0B0C14, 118*d), fB))
            FillRR(HL.mbx - MBW/2, HL.mby - MBH/2, MBW, MBH, 16, b), DelB(b)
            pn := Pen(FA(Alpha(bcol, 200*d), fB), 1.6)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", Mod(DecT(now)*0.03, 1000))
            StrokeRR(HL.mbx - MBW/2 - 7, HL.mby - MBH/2 - 7, MBW + 14, MBH + 14, 22, pn), DelP(pn)
        }
        Pop(stB)
    }

    FFMCtxDraw(now, hubCur)
    ; the update check reports through files (see UpdPoll); read them here,
    ; every frame, whether or not its card is up - the launch check has none
    UpdPoll(now)
    ; ---- the tour, over the interface and under the modal gate ----
    TutDraw(now, hubCur)
    ; ---- the opening gate, over EVERYTHING ----
    ; After the context menu and the footer, because anything drawn later would
    ; sit on top of a sheet that is meant to be modal - the mistake the clash
    ; card made when it was painted before the footer.
    HubGateDraw(now)

    if (galOpen || cropUIOn) && (++zfH >= 12)
        zfH := 0, GalZFix()

    Pop(st0)
    pt0 := Buffer(8, 0)
    sz := Buffer(8), NumPut("int", HL.pw, "int", HL.ph, sz)
    HL.px := HL.bx, HL.py := HL.by + yO
    ptd := Buffer(8), NumPut("int", HL.px, "int", HL.py, ptd)
    bf := Buffer(4), NumPut("uchar", 0, "uchar", 0, "uchar", winA, "uchar", 1, bf)
    HL.winA := winA
    if (hubDrew && G = HL.g2)
        DllCall("user32\UpdateLayeredWindow", "ptr", HL.gui.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz, "ptr", HL.hdc, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
    G := G0
    if fin {
        HubFinish()
        return
    }
    busy := it < 1 || HL.closeAt || HL.drag || HL.dragT > 0 || Abs(HL.tilt) > 0.03 || hz
        || posFix                                 ; walking back onto the screen
        || (hubTabAt && now - hubTabAt < 700) || (abFlashAt && now - abFlashAt < 900)
        || (hubTab = 1 && FFM.clickAt.Has(205))   ; launch wedge in flight
        || (abOn ? HL.abT < 0.996 : HL.abT > 0.004)
        || (puzOn ? HL.puzT < 0.996 : HL.puzT > 0.004)
        || (tinted ? HL.armT < 0.996 : HL.armT > 0.004)
        || Abs(HL.tintT - (hubArmTint ? 1.0 : 0.0)) > 0.004
        || Abs(HL.actT - (enabled ? 1.0 : 0.0)) > 0.004
        || Abs(HL.topT - (hubTop ? 1.0 : 0.0)) > 0.004
        || (HL.topAt && now - HL.topAt < 700)
        || Abs(HL.tmT - (hubTrueMin ? 1.0 : 0.0)) > 0.004
        || (HL.tmAt && now - HL.tmAt < 700)
        || Abs(HL.auT - (hubAutoUpd ? 1.0 : 0.0)) > 0.004
        || (HL.auAt && now - HL.auAt < 700)
        || (hubTab = 1 && FFM.clickAt.Has(2001))  ; CHECK FOR UPDATES, pressed
        ; LOW PERFORMANCE MODE was never listed here, so its switch only slid
        ; while something else happened to hold the loop busy - usually the
        ; cursor still being over the row. Added alongside the new one rather
        ; than left inconsistent with the row directly beneath it.
