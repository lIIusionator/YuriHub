            ; faint enough to read as structure, not as a border.
            pn := Pen(FA(0x1EC7CBE0, f), 1)
            Line(x0 + 228, pvy + 9, x0 + 228, pvy + 31, pn), DelP(pn)
            hvG := HL.h.Get(54, 0.0)
            gbx := x0 + HL.ctw - 116, gby := pvy + 7 - 1.5*hvG
            ; Right-aligned so it ends against the button it belongs to, instead
