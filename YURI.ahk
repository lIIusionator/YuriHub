            colW := HL.ctw/2
            pn := Pen(FA(Alpha(hubCur, 40 + 30*emb2G), f), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 2)
            Line(x0 + colW, py0 + 22, x0 + colW, py0 + ph_ - 22, pn), DelP(pn)
            acy := py0 + ph_/2
            loop 2 {
                pk   := A_Index
                pcx  := x0 + (pk - 1)*colW
                acx  := pcx + 46
                nm   := (pk = 1) ? "ZEAL" : "LUNARIS"
