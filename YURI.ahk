; ---- geometry shared by FFMCommView and FFMCommZone ----
; The card's height and the set bar's offset were written out twice, in the
; renderer and in the hit test, with a comment asking whoever changed one to
; remember the other. Making room for the scrollable description moved both, so
; they are derived here instead and the two cannot disagree.
;
; The card can only grow so far: the view's backing plate runs 18 px past its
; bottom edge and the hub's content area ends at pd + ch, which at the current
; 780x520 leaves the plate about 15 px of headroom over the old 210. That is the
; budget the numbers below spend, and it is why the viewport is three lines and
; not five - the rest of the description is reachable by scrolling, which is the
; point.
global FFM_COMM_DSCLH  := 15                  ; description line height
global FFM_COMM_DSCVIS := 3                   ; lines visible at once
FFMCommDscY()  => 112                         ; description top, relative to the card: the header is the 148x84 picture's height plus its margins
FFMCommDscH()  => FFM_COMM_DSCVIS*FFM_COMM_DSCLH
; The description sits on a plate inset 4 px around it, so the gaps either side
; are measured from the PLATE, not the text: 3 px clear of the rating bar above
; (which ends at sy+103) and 4 px clear of the set bar below. Both were 4 and 0
; before, which is why the description and the rating bar read as one row.
FFMCommBarY()  => FFMCommDscY() + FFMCommDscH() + 8     ; the set list, same origin

; ---- a card is a GAME, and a game has as many sets as it has files ----
; One card used to be one set, so the card's height was a constant. A folder in
; the repo can publish any number of .json files, so the sets are a list inside
; the card with its own scroll, and the card's height depends on which KIND it
; is. GENERAL has no place id, so no thumbnail, no icon, no stat chips, no
; rating and no description to draw - all of that height goes to its list
; instead, which is what makes it the taller card.
global FFM_COMM_SETRH := 44                   ; one row of the set list
global FFM_COMM_MAXC  := 8                    ; cards the zone bands below carry
; ---- the list is as tall as it needs to be, up to a cap ----
; This returned the cap flat, so a game card always reserved two rows and a
; folder with one set carried 54 px of dead card under it. The card height is
; derived from this, and nothing depends on that height being a constant any
; more - FFMCommCardTop and FFMCommContentH both walk the entries - so it can
; follow the content instead.
;
; The floor is 1, not 0: a folder with no sets still needs a row's height to
; print "no sets in this folder" into.
;
; A card GROWS when a folder gains its second set, which moves everything below
; it. That only happens on a sync, and FFMCommClampAll re-clamps every scroll
; the moment a new index lands.
FFMCommSetCap(ent) => (ent.kind = "general") ? 6 : 2
FFMCommSetVis(ent) => Clamp(ent.sets.Length, 1, FFMCommSetCap(ent))
FFMCommSetY(ent)   => (ent.kind = "general") ? 44 : FFMCommBarY()
FFMCommCardH(ent)  => FFMCommSetY(ent) + FFMCommSetVis(ent)*FFM_COMM_SETRH + 10

; ---- a fixed frame around a scrolling body ----
; The panel's height is pinned by the hub content area and cannot follow the
; cards, so it does not try: the view is a constant and everything below the
; header lives in a viewport. Sized to what ONE game card needs, which is the
; shape the panel had before any of this - a single game still fills it exactly
; and does not scroll. Anything more is scroll.
global FFM_COMM_BANNERH := 236                ; the hero banner - was 132, a 4:1 letterbox on a 16:9 source; this shows the picture
global FFM_COMM_GAP     := 14                 ; banner to card, and card to card
; PINNED, not derived. It used to be built up from the card, which worked while
; a card was one set tall; a card carrying a set LIST is taller than the panel
; can ever be, and deriving from it put the view's backing plate 33 px past the
; bottom of the hub. The hub content area ends at pd + ch and the plate runs
; 18 px past the view, which at 780x520 caps the view here. Cards larger than
; the viewport are exactly what the viewport is for.
FFMCommViewH() => 423
FFMCommBodyY() => 38                          ; viewport top, relative to the view's y
FFMCommBodyH() => FFMCommViewH() - 38 - 14
; Cards are no longer a uniform height, so this walks rather than multiplies.
FFMCommCardTop(k) {
    t := FFM_COMM_BANNERH + FFM_COMM_GAP
    loop Min(k - 1, FFM_COMM.Length)
        t += FFMCommCardH(FFM_COMM[A_Index]) + FFM_COMM_GAP
    return t
}
FFMCommContentH() {
    if !FFM_COMM.Length
        return FFM_COMM_BANNERH + FFM_COMM_GAP + 120      ; the empty-state card
    n := FFM_COMM.Length
    return FFMCommCardTop(n) + FFMCommCardH(FFM_COMM[n])
}
FFMCommScrMax() => Max(0.0, FFMCommContentH() - FFMCommBodyH() + 0.0)

; ---- the bars: one definition each, for the draw, the hit box and the drag ----
; Every other scrollbar in the hub can be grabbed and dragged - the flag list,
; the database, the log, the detail sheet, the cursor list, the script library.
; These two could only be turned with the wheel, because they were drawn and
; never given a zone. Dragging needs the renderer, the hit test and the drag
; handler to agree on the track to the pixel, so the track lives here and all
; three read it rather than each deriving its own.
FFMCommBodyTrackH() => FFMCommBodyH() - 8
FFMCommBodyThumb()  => Max(24, FFMCommBodyTrackH()*(FFMCommBodyH()/FFMCommContentH()))
FFMCommDscThumb(n)  => Max(16, FFMCommDscH()*(FFM_COMM_DSCVIS/Max(1, n)))
FFMCommSetListH(ent) => FFMCommSetVis(ent)*FFM_COMM_SETRH
; The rows give up 10 px to the bar when there is one, and the renderer, the hit
; test and the drag all have to agree on that or the button and the rail sit
; where nothing can click them. One definition, three callers.
FFMCommSetRowW(ent, lw) => lw - (FFMCommSetMax(ent) > 0 ? 10 : 0)
FFMCommSetThumb(ent, n) => Max(16, FFMCommSetListH(ent)*(FFMCommSetVis(ent)/Max(1, n)))
FFMCommSetMax(ent) => Max(0, ent.sets.Length - FFMCommSetVis(ent))
; ---- zone bands ----
; 1900+ because everything below it is taken: the RSET extras' value and delete
; bands run to 1899. Both are sized for FFM_COMM_MAXC cards, and the INSERT band
; is indexed by VISIBLE SLOT rather than by set index - the same thing the flag
; database does with 600 + row - so a list of two hundred sets still needs only
; eight ids per card.
global FFM_CMZ_SBAR := 1900                   ; set-list scrollbar  -> + card
global FFM_CMZ_INS  := 1930                   ; a row's INSERT      -> + (card-1)*8 + slot

; Body position from a screen y. Same shape as FFMDragScroll: to hub units,
; then through FFMScrollFromY, which carries the grab offset so the thumb does
; not jump to the cursor on the first press.
FFMCommDragBody(sy) {
    uy := (sy - HL.py)/(HL.pw/HL.bw)
    bodyY := HL.cty + 30 + FFMCommBodyY()
    FFM.cmScrT := FFMScrollFromY(uy, bodyY + 4, FFMCommBodyTrackH()
        , FFMCommContentH(), FFMCommBodyH(), FFMCommBodyThumb(), FFM.cmScr)
    FFM.cmScr := FFM.cmScrT
    HubPoke()
}
; A card's set list, in ROWS. Same reasoning as the description below it.
FFMCommDragSet(gi, sy) {
    if (gi < 1 || gi > FFM_COMM.Length)
        return
    ent := FFM_COMM[gi]
    if (FFMCommSetMax(ent) <= 0)
        return
    ds := FFMCommState(ent.folder)
    uy := (sy - HL.py)/(HL.pw/HL.bw)
    ly := HL.cty + 30 + FFMCommBodyY() - FFM.cmScr + FFMCommCardTop(gi) + FFMCommSetY(ent)
    v := FFMScrollFromY(uy, ly, FFMCommSetListH(ent), ent.sets.Length
        , FFMCommSetVis(ent), FFMCommSetThumb(ent, ent.sets.Length), ds.s)
    ds.s := Round(Clamp(v, 0, FFMCommSetMax(ent)))
    HubPoke()
}
; And a description, in LINES rather than pixels - FFMScrollFromY does not care
; which unit it is given as long as total, viewLen and the thumb agree, so the
; totals here are line counts and what comes back is a line offset.
FFMCommDragDsc(gi, sy) {
    if (gi < 1 || gi > FFM_COMM.Length)
        return
    ds := FFMCommState(FFM_COMM[gi].folder)
    if (ds.dMax <= 0)
        return
    nl := ds.wrap.Length
    uy := (sy - HL.py)/(HL.pw/HL.bw)
    dscY := HL.cty + 30 + FFMCommBodyY() - FFM.cmScr + FFMCommCardTop(gi) + FFMCommDscY()
    v := FFMScrollFromY(uy, dscY, FFMCommDscH(), nl, FFM_COMM_DSCVIS
        , FFMCommDscThumb(nl), ds.d)
    ds.d := Round(Clamp(v, 0, ds.dMax))
    HubPoke()
}

; ---- per-game description scroll ----
; One record per place rather than one set of fields on FFM: two cards scroll
; their descriptions independently, and a card that has never been on screen
; should not need initialising anywhere.
;   d     description position, in WHOLE LINES - the renderer draws from here
;   dMax  how far the description can go, written once it has wrapped
;   s     set-list position, in WHOLE ROWS
;   wrap / wrapKey  the wrapped description lines, and what they came from
;
; Keyed on the FOLDER, not the place id: GENERAL has no place id, and two
; folders could in principle name the same game.
;
; No eased twin and no remembered bitmap. The ease existed to slide lines under
; a clip edge, which the renderer no longer relies on, and the bitmap was a
; handle owned by SPF.thumbs that SPFBannerDrop disposes - see the note in
; FFMCommGameCard.
FFMCommState(key) {
    if !FFM.cm.Has(key)
        FFM.cm[key] := {d: 0, dMax: 0, s: 0, wrap: [], wrapKey: "", off: 0, skipAt: 0}
    return FFM.cm[key]
}
; Which card's description is under the cursor, or 0. Positions are taken
; through FFM.cmScr - the EASED body position, which is what is on screen -
; so the answer matches what the user is pointing at mid-glide.
FFMCommDscAt(ux, uy) {
    x := HL.ctx, y := HL.cty + 30, w := HL.ctw
    bodyY := y + FFMCommBodyY(), bodyH := FFMCommBodyH()
    if (uy < bodyY || uy > bodyY + bodyH)
        return 0
    dscX := x + 14 + 12, dscW := w - 28 - 24
    if (ux < dscX || ux > dscX + dscW)
        return 0
    loop Min(FFM_COMM.Length, FFM_COMM_MAXC) {
        gi := A_Index
        if (FFM_COMM[gi].kind = "general")
            continue                          ; no description on that card at all
        dy3 := bodyY - FFM.cmScr + FFMCommCardTop(gi) + FFMCommDscY()
        if (uy >= dy3 - 2 && uy <= dy3 + FFMCommDscH() + 2)
            return gi
    }
    return 0
}
; And which card's set LIST is under the cursor. Same contract as
; FFMCommDscAt: positions come through FFM.cmScr, the eased body offset, so the
; answer matches what is actually on screen mid-glide.
FFMCommSetAt(ux, uy) {
    x := HL.ctx, y := HL.cty + 30, w := HL.ctw
    bodyY := y + FFMCommBodyY(), bodyH := FFMCommBodyH()
    if (uy < bodyY || uy > bodyY + bodyH)
        return 0
    lx := x + 14 + 12, lw := w - 28 - 24
    if (ux < lx || ux > lx + lw)
        return 0
    loop Min(FFM_COMM.Length, FFM_COMM_MAXC) {
        gi  := A_Index
        ent := FFM_COMM[gi]
        ly  := bodyY - FFM.cmScr + FFMCommCardTop(gi) + FFMCommSetY(ent)
        if (uy >= ly && uy <= ly + FFMCommSetListH(ent))
            return gi
    }
    return 0
}
; Anything still easing, so the hub knows to keep repainting.
; Only the BODY eases now - the descriptions step whole lines and are done in
; the frame the wheel turns.
FFMCommGliding() => Abs(FFM.cmScr - FFM.cmScrT) > 0.4

global FFM_SYSN := 9
; The preset rows are a different kind of control from the settings rows above
; them, so a labelled divider sits between the groups. Rows at FFM_SEPAT
; and below are pushed down by FFM_SEPH to make room for it; every place that
; positions a row or measures the scroll extent goes through the two helpers
; below so the gap can never be applied in one place and forgotten in another.
global FFM_SEPAT := 7
global FFM_SEPH  := 26
FFMSysRowY(i) => 12 + (i - 1)*HL.ffrg + (i >= FFM_SEPAT ? FFM_SEPH : 0)
FFMSysTotal() => FFM_SYSN*HL.ffrg + FFM_SEPH
