                Txt(wk = 1 ? "ZEAL" : "LUNARIS", wx, lky - 29, 74, 18, HL.fXs
                  , FA(Alpha(Mix(0xFFC7CBE0, 0xFFE8EAF6, wsl)
                     , Round(255*Lerp(0.4 + 0.3*whv, 1.0, wsl))), f), fmtC)
