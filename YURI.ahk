        DllCall("user32\UpdateLayeredWindow", "ptr", lw.Hwnd, "ptr", 0, "ptr", ptd, "ptr", sz, "ptr", hdcL, "ptr", pt0, "uint", 0, "ptr", bf, "uint", 2)
