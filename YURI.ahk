        cds := Buffer(A_PtrSize*3)
        NumPut("uptr", 0x5A19, cds, 0)
        NumPut("uint", sBuf.Size, cds, A_PtrSize)
        NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
        DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    }
    ExitApp
}

; ---- account lookup child: userId -> username / display name ----
; Same shape as rbxgame, and a child for the same reason: a stalled request
; must never touch the render thread. The endpoint is public and unauthenticated
; - it is the same one the profile page uses - so nothing about the session is
; read or sent, only the numeric id the client already wrote to its own log.
if A_Args.Length >= 3 && A_Args[1] = "rbxuser" {
    Suspend true
    unm := "", udsp := ""
    try {
        whr := ComObject("WinHttp.WinHttpRequest.5.1")
        whr.SetTimeouts(6000, 6000, 8000, 12000)
        whr.Open("GET", "https://users.roblox.com/v1/users/" A_Args[3], false)
        whr.SetRequestHeader("User-Agent", "YURI")
        whr.Send()
        if (whr.Status = 200) {
            jb := whr.ResponseText
            if RegExMatch(jb, '"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
                unm := RbxJsonUnesc(m[1])
            if RegExMatch(jb, '"displayName"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
                udsp := RbxJsonUnesc(m[1])
        }
    }
    if (unm != "") {
        out := A_Args[3] "|" unm "|" udsp
        sBuf := Buffer(StrPut(out, "UTF-16"))
        StrPut(out, sBuf, "UTF-16")
        cds := Buffer(A_PtrSize*3)
        NumPut("uptr", 0x5A1D, cds, 0)
        NumPut("uint", sBuf.Size, cds, A_PtrSize)
        NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
        DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    }
    ExitApp
}

; ---- authenticated launch -------------------------------------------------
; The desktop client has no login of its own. It is handed a ONE-TIME
; authentication ticket at launch and adopts whichever account that ticket
; belongs to - which is why starting the exe from a shortcut opens a logged-out
; client, and why the only way to get two accounts running has been to sign out
; and back in on the website between launches.
;
; A ticket can be requested directly from a stored .ROBLOSECURITY cookie, so
; this child does what the browser would: ask auth.roblox.com for a ticket for
; ONE account, build the launch URI around it, and start the client. Several
; accounts can therefore be launched back to back without touching the browser.
;
; Runs as a child for the usual reason - two blocking HTTP round trips must not
; sit on the render thread - and the cookie is passed via a file rather than the
; command line, because command lines are readable by any process on the box.
; The file is deleted the moment it has been read.
; ---- account profile ------------------------------------------------------
; Everything the detail panel shows about one account, in one pass: the blurb,
; friend and follower counts, presence, and the two avatar renders. Presence is
; the only one that needs to be a POST with the account's own cookie - the rest
; are public reads keyed on the user id.
if A_Args.Length >= 5 && A_Args[1] = "rbxprof" {
    Suspend true
    slot := A_Args[3], uid := A_Args[4], ckPath := A_Args[5]
    ck := ""
    try ck := FileRead(ckPath, "UTF-8")
    try FileDelete(ckPath)
    ck := Trim(ck)

    GetT(u, hdrCookie := "") {
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 15000)
            w.Open("GET", u, false)
            w.SetRequestHeader("User-Agent", "Roblox/WinInet")
            if (hdrCookie != "")
                w.SetRequestHeader("Cookie", ".ROBLOSECURITY=" hdrCookie)
            w.Send()
            return (w.Status = 200) ? w.ResponseText : ""
        }
        return ""
    }
    Grab(url, dst) {
        if (url = "")
            return 0
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 20000)
            w.Open("GET", url, false)
            w.Send()
            if (w.Status = 200) {
                ado := ComObject("ADODB.Stream")
                ado.Type := 1, ado.Open()
                ado.Write(w.ResponseBody)
                ado.SaveToFile(dst, 2)
                ado.Close()
                return 1
            }
        }
        return 0
    }

    desc := "", disp := "", nm := "", fr := "", fol := "", fwg := "", pres := "0", loc := ""
    made := "", grps := ""
    j := GetT("https://users.roblox.com/v1/users/" uid)
    if RegExMatch(j, '"description"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
        desc := RbxJsonUnesc(m[1])
    if RegExMatch(j, '"displayName"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
        disp := RbxJsonUnesc(m[1])
    if RegExMatch(j, '"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
        nm := RbxJsonUnesc(m[1])

    j := GetT("https://friends.roblox.com/v1/users/" uid "/friends/count")
    if RegExMatch(j, '"count"\s*:\s*(\d+)', &m)
        fr := m[1]
    j := GetT("https://friends.roblox.com/v1/users/" uid "/followers/count")
    if RegExMatch(j, '"count"\s*:\s*(\d+)', &m)
        fol := m[1]
    j := GetT("https://friends.roblox.com/v1/users/" uid "/followings/count")
    if RegExMatch(j, '"count"\s*:\s*(\d+)', &m)
        fwg := m[1]

    ; ---- the three lists ----
    ; Each item carries name, a sub-line, the id its LOGO is keyed on, and the
    ; id its page link uses - four halves joined with Chr(2), items joined with
    ; Chr(1). "|" separates payload fields and is stripped from every name,
    ; because a game or group can be called anything a user can type.
    Clean(v) => StrReplace(StrReplace(StrReplace(v, "|", " "), Chr(1), " "), Chr(2), " ")

    ; One batch request per list rather than one per row - a dozen round trips
    ; would dominate the time this child takes. Thumbnails are then cached on
    ; disk for a day, so reopening the panel costs nothing.
    ; Same GET, but it hands back the HTTP status. "empty" and "refused" look
    ; identical from a body alone, and they need opposite fixes - a 401 is an
    ; auth problem, a 400 is a bad parameter, a 404 is the wrong path.
    ; Referer and Accept are sent because Roblox rejects some authenticated
    ; reads without them; a browser always sends both.
    GetTS(u, ckv, &code) {
        code := 0
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 15000)
            w.Open("GET", u, false)
            w.SetRequestHeader("User-Agent", "Roblox/WinInet")
            w.SetRequestHeader("Accept", "application/json")
            if (ckv != "") {
                w.SetRequestHeader("Referer", "https://www.roblox.com/")
                w.SetRequestHeader("Cookie", ".ROBLOSECURITY=" ckv)
            }
            w.Send()
            code := w.Status
            return (code = 200) ? w.ResponseText : ""
        }
        code := -1
        return ""
    }

    IconMap(url) {
        mp := Map(), pos := 1
        j3 := GetT(url)
        while (pos := RegExMatch(j3, '"targetId"\s*:\s*(\d+)[^}]*?"imageUrl"\s*:\s*"([^"]*)"', &mm, pos)) {
            mp[mm[1]] := mm[2]
            pos += mm.Len
        }
        return mp
    }
    CacheIco(url, dst) {
        if (url = "")
            return
        if (FileExist(dst) && DateDiff(A_Now, FileGetTime(dst, "M"), "Hours") < 24)
            return
        Grab(url, dst)
    }

    ; games.roblox.com returns id then name for a universe; rootPlace and
    ; creator are nested objects whose own "id" is not followed by "name", so
    ; the adjacency in this pattern is what keeps it off them.
    ; urls is tried in order and the first that answers wins. Roblox has moved
    ; and re-parameterised these paths before, and a variant that 400s on one
    ; account can be the only one that works on another.
    GameList(urls, cap, ckv, &st) {
        st := 0
        items := [], ids := "", pos := 1
        j2 := "", code := 0
        for u in urls {
            j2 := GetTS(u, ckv, &code)
            if (j2 != "")
                break
        }
        ; Last resort: try it anonymously. A cookie that Roblox dislikes gets
        ; the whole read refused, and a public profile answers without one - so
        ; a failing cookie should not be the reason a public list stays blank.
        if (j2 = "" && ckv != "")
            j2 := GetTS(urls[1], "", &code)
        if (j2 = "") {
            st := (ckv = "") ? -2 : code         ; -2 = the helper had no cookie
            return ""
        }
        st := 200
        while (items.Length < cap
            && (pos := RegExMatch(j2, '\{"id"\s*:\s*(\d+)\s*,\s*"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &mm, pos))) {
            uni := mm[1], nmv := RbxJsonUnesc(mm[2])
            pos += mm.Len
            tail := SubStr(j2, pos, 1600)
            rp := "", vis := ""
            if RegExMatch(tail, '"rootPlace"\s*:\s*\{\s*"id"\s*:\s*(\d+)', &m3)
                rp := m3[1]
            if RegExMatch(tail, '"placeVisits"\s*:\s*(\d+)', &m3)
                vis := m3[1]
            if (nmv != "")
                items.Push({ic: uni, n: nmv, s: vis, lk: rp})
            ids .= (ids = "" ? "" : ",") uni
        }
        if (ids != "") {
            im := IconMap("https://thumbnails.roblox.com/v1/games/icons?universeIds=" ids
                        . "&size=128x128&format=Png&isCircular=false")
            for it in items
                CacheIco(im.Has(it.ic) ? im[it.ic] : "", A_Temp "\yuri_ic_g_" it.ic ".png")
        }
        out := ""
        for i2, it in items
            out .= (i2 > 1 ? Chr(1) : "") Clean(it.n) Chr(2) Clean(it.s) Chr(2) it.ic Chr(2) it.lk
        return out
    }

    ; groups nests the group under a "group" key and the rank under "role",
    ; so the group's own id and name are the pair to anchor on.
    GroupList(urls, cap, ckv, &st) {
        st := 0
        items := [], ids := "", pos := 1
        j2 := "", code := 0
        for u in urls {
            j2 := GetTS(u, ckv, &code)
            if (j2 != "")
                break
        }
        if (j2 = "") {
            st := code
            return ""
        }
        st := 200
        while (items.Length < cap
            && (pos := RegExMatch(j2, '"group"\s*:\s*\{\s*"id"\s*:\s*(\d+)\s*,\s*"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &mm, pos))) {
            gid := mm[1], nmv := RbxJsonUnesc(mm[2])
            pos += mm.Len
            rl := ""
            if RegExMatch(SubStr(j2, pos, 1200), '"role"\s*:\s*\{[^}]*?"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &m3)
                rl := RbxJsonUnesc(m3[1])
            if (nmv != "")
                items.Push({ic: gid, n: nmv, s: rl, lk: gid})
            ids .= (ids = "" ? "" : ",") gid
        }
        if (ids != "") {
            im := IconMap("https://thumbnails.roblox.com/v1/groups/icons?groupIds=" ids
                        . "&size=150x150&format=Png&isCircular=false")
            for it in items
                CacheIco(im.Has(it.ic) ? im[it.ic] : "", A_Temp "\yuri_ic_r_" it.ic ".png")
        }
        out := ""
        for i2, it in items
            out .= (i2 > 1 ? Chr(1) : "") Clean(it.n) Chr(2) Clean(it.s) Chr(2) it.ic Chr(2) it.lk
        return out
    }

    ; The cookie goes to ALL THREE. Creations and groups are public and answer
    ; without it, which is why they worked - but FAVOURITES is scoped to the
    ; signed-in user and returns 401 to an anonymous caller no matter how the
    ; account's privacy is set. Sending the account's own cookie is also what
    ; makes the list correct rather than merely present: it is that user's
    ; favourites being asked for, by that user.
    ; Favourites is gone on purpose. It is the one list of the three that is
    ; scoped to the signed-in user, it refused every endpoint variant and both
    ; the authenticated and anonymous reads, and it is the least interesting of
    ; the three - not worth more round trips.
    gOk := 0, mOk := 0
    gb := "https://games.roblox.com/v2/users/" uid
    made := GameList([gb "/games?limit=10&sortOrder=Asc"
                    , gb "/games?accessFilter=2&limit=10&sortOrder=Asc"
                    , gb "/games"], 10, ck, &mOk)
    grps := GroupList(["https://groups.roblox.com/v2/users/" uid "/groups/roles"], 12, ck, &gOk)
    ; the HTTP status per list, so the panel can name the actual failure
    lsOk := gOk Chr(2) mOk

    ; presence: POST, and Roblox wants a CSRF token for it like any other POST
    if (ck != "") {
        try {
            csrf := ""
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(6000, 6000, 8000, 15000)
            w.Open("POST", "https://presence.roblox.com/v1/presence/users", false)
            w.SetRequestHeader("User-Agent", "Roblox/WinInet")
            w.SetRequestHeader("Content-Type", "application/json")
            w.SetRequestHeader("Cookie", ".ROBLOSECURITY=" ck)
            try w.Send('{"userIds":[' uid ']}')
            try csrf := w.GetResponseHeader("x-csrf-token")
            body := (csrf = "") ? w.ResponseText : ""
            if (csrf != "") {
                w2 := ComObject("WinHttp.WinHttpRequest.5.1")
                w2.SetTimeouts(6000, 6000, 8000, 15000)
                w2.Open("POST", "https://presence.roblox.com/v1/presence/users", false)
                w2.SetRequestHeader("User-Agent", "Roblox/WinInet")
                w2.SetRequestHeader("Content-Type", "application/json")
                w2.SetRequestHeader("X-CSRF-TOKEN", csrf)
                w2.SetRequestHeader("Cookie", ".ROBLOSECURITY=" ck)
                w2.Send('{"userIds":[' uid ']}')
                body := w2.ResponseText
            }
            if RegExMatch(body, '"userPresenceType"\s*:\s*(\d+)', &m)
                pres := m[1]
            if RegExMatch(body, '"lastLocation"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
                loc := RbxJsonUnesc(m[1])
        }
    }

    ; the two renders. Circular headshot for the list, full body for the panel.
    hDst := A_Temp "\yuri_av_" uid "_h.png"
    fDst := A_Temp "\yuri_av_" uid "_f.png"
    j := GetT("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" uid
            . "&size=150x150&format=Png&isCircular=false")
    if RegExMatch(j, '"imageUrl"\s*:\s*"([^"]*)"', &m)
        Grab(m[1], hDst)
    j := GetT("https://thumbnails.roblox.com/v1/users/avatar?userIds=" uid
            . "&size=420x420&format=Png&isCircular=false")
    if RegExMatch(j, '"imageUrl"\s*:\s*"([^"]*)"', &m)
        Grab(m[1], fDst)

    out := slot "|" uid "|" StrReplace(nm, "|", " ") "|" StrReplace(disp, "|", " ")
         . "|" fr "|" fol "|" fwg "|" pres "|" StrReplace(loc, "|", " ")
         . "|" StrReplace(StrReplace(desc, "|", " "), "`n", " ")
         . "|" grps "|" made "|" lsOk
    sBuf := Buffer(StrPut(out, "UTF-16"))
    StrPut(out, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A20, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}

; ---- account avatar mesh ---------------------------------------------------
; Roblox publishes the real 3D avatar as an OBJ. This pulls it, keeps a
; subsample of its vertices and writes them as a flat point list the hub can
; spin. A textured triangle render is out of reach for a GDI+ software
; rasteriser driven from AHK - thousands of textured tris per frame is not
; something this renderer can do - but the geometry is genuinely the user's
; avatar, so rotating it is real rather than a faked turntable.
if A_Args.Length >= 4 && A_Args[1] = "rbx3d" {
    Suspend true
    slot := A_Args[3], uid := A_Args[4]
    Get3(u) {
        try {
            w := ComObject("WinHttp.WinHttpRequest.5.1")
            w.SetTimeouts(8000, 8000, 10000, 30000)
            w.Open("GET", u, false)
            w.SetRequestHeader("User-Agent", "Roblox/WinInet")
            w.Send()
            return (w.Status = 200) ? w.ResponseText : ""
        }
        return ""
    }
    ok := 0
    try {
        j := Get3("https://thumbnails.roblox.com/v1/users/avatar-3d?userId=" uid)
        if RegExMatch(j, '"imageUrl"\s*:\s*"([^"]*)"', &m) {
            meta := Get3(m[1])
            if RegExMatch(meta, '"obj"\s*:\s*"([^"]*)"', &m2) {
                objUrl := m2[1]
                if !InStr(objUrl, "://")
                    objUrl := "https://t0.rbxcdn.com/" objUrl
                body := Get3(objUrl)
                if (body != "") {
                    ; collect vertices, then keep an even subsample - a few
                    ; hundred points is all the renderer can spin smoothly
                    vs := []
                    loop parse body, "`n", "`r" {
                        ; lnv, not ln - this block is the auto-execute section,
                        ; not a function body, so a bare "ln" assigns to the
                        ; BUILT-IN Ln() rather than making a local. The same
                        ; name is safe everywhere else in this file only
                        ; because every other use of it sits inside a function.
                        lnv := A_LoopField
                        if (SubStr(lnv, 1, 2) != "v ")
                            continue
                        pp := StrSplit(Trim(SubStr(lnv, 3)), " ")
                        if (pp.Length >= 3)
                            vs.Push(pp[1] "," pp[2] "," pp[3])
                    }
                    n := vs.Length
                    if (n > 0) {
                        want := 700
                        step := (n > want) ? (n / want) : 1
                        out := "", k := 1.0, c := 0
                        while (Round(k) <= n && c < want) {
                            out .= vs[Round(k)] "`n"
                            k += step, c += 1
                        }
                        fh := FileOpen(A_Temp "\yuri_av_" uid ".pts", "w", "UTF-8")
                        fh.Write(out)
                        fh.Close()
                        ok := 1
                    }
                }
            }
        }
    }
    out := slot "|" uid "|" (ok ? "OK" : "ERR")
    sBuf := Buffer(StrPut(out, "UTF-16"))
    StrPut(out, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A21, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}

if A_Args.Length >= 4 && A_Args[1] = "rbxwhoami" {
    Suspend true
    slot := A_Args[3], ckPath := A_Args[4]
    ck := ""
    try ck := FileRead(ckPath, "UTF-8")
    try FileDelete(ckPath)
    unm := "", uid := ""
    if (Trim(ck) != "") {
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.SetTimeouts(6000, 6000, 8000, 12000)
            whr.Open("GET", "https://users.roblox.com/v1/users/authenticated", false)
            whr.SetRequestHeader("User-Agent", "Roblox/WinInet")
            whr.SetRequestHeader("Cookie", ".ROBLOSECURITY=" Trim(ck))
            whr.Send()
            if (whr.Status = 200) {
                jb := whr.ResponseText
                if RegExMatch(jb, '"name"\s*:\s*"((?:[^"\\]|\\.)*)"', &m)
                    unm := RbxJsonUnesc(m[1])
                ; the id is what every profile endpoint keys on, so it is worth
                ; taking here rather than asking again later
                if RegExMatch(jb, '"id"\s*:\s*(\d+)', &m)
                    uid := m[1]
            }
        }
    }
    out := slot "|" StrReplace(unm, "|", " ") "|" uid
    sBuf := Buffer(StrPut(out, "UTF-16"))
    StrPut(out, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A1F, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}

if A_Args.Length >= 5 && A_Args[1] = "rbxtick" {
    Suspend true
    slot := A_Args[3], ckPath := A_Args[4]
    ; target arrives as "placeId|jobId|privateCode" - one argument, so the
    ; three parts can never be misordered by a missing optional one
    tp := StrSplit(A_Args[5], "|")
    placeId := tp.Length >= 1 ? tp[1] : ""
    jobId   := tp.Length >= 2 ? tp[2] : ""
    privCd  := tp.Length >= 3 ? tp[3] : ""
    ck := ""
    try ck := FileRead(ckPath, "UTF-8")
    try FileDelete(ckPath)
    out := slot "|ERR|could not read the stored cookie"
    if (Trim(ck) != "") {
        ck := Trim(ck)
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.SetTimeouts(8000, 8000, 10000, 15000)
            ; Pass one: Roblox refuses and hands back the CSRF token to use.
            csrf := ""
            whr.Open("POST", "https://auth.roblox.com/v1/authentication-ticket/", false)
            whr.SetRequestHeader("User-Agent", "Roblox/WinInet")
            whr.SetRequestHeader("Referer", "https://www.roblox.com/")
            whr.SetRequestHeader("Content-Type", "application/json")
            whr.SetRequestHeader("Cookie", ".ROBLOSECURITY=" ck)
            try whr.Send("")
            try csrf := whr.GetResponseHeader("x-csrf-token")
            if (csrf = "") {
                out := slot "|ERR|no csrf token - cookie is probably expired"
            } else {
                ; Pass two: same request, now with the token.
                whr2 := ComObject("WinHttp.WinHttpRequest.5.1")
                whr2.SetTimeouts(8000, 8000, 10000, 15000)
                whr2.Open("POST", "https://auth.roblox.com/v1/authentication-ticket/", false)
                whr2.SetRequestHeader("User-Agent", "Roblox/WinInet")
                whr2.SetRequestHeader("Referer", "https://www.roblox.com/")
                whr2.SetRequestHeader("Content-Type", "application/json")
                whr2.SetRequestHeader("X-CSRF-TOKEN", csrf)
                whr2.SetRequestHeader("Cookie", ".ROBLOSECURITY=" ck)
                whr2.Send("")
                tick := ""
                try tick := whr2.GetResponseHeader("rbx-authentication-ticket")
                if (tick = "") {
                    out := slot "|ERR|roblox refused a ticket (status " whr2.Status ")"
                } else {
                    btid := Random(100000000, 999999999)
                    ts := DateDiff(A_NowUTC, "19700101000000", "Seconds") * 1000
                    if (placeId = "") {
                        ; No place named. "app" mode opens the client on its own
                        ; home screen, signed in as the ticket's account, which
                        ; is what "open Roblox as this account" should mean -
                        ; requiring a game to join first was the wrong shape.
                        uri := "roblox-player:1+launchmode:app"
                             . "+gameinfo:" tick
                             . "+launchtime:" ts
                             . "+browsertrackerid:" btid
                             . "+robloxLocale:en_us+gameLocale:en_us+channel:"
                    } else {
                        ; Three shapes of join, and Roblox names them
                        ; differently: a plain public join, a named public
                        ; instance, and a private server reached by its code.
                        req := privCd != "" ? "RequestPrivateGame"
                             : jobId  != "" ? "RequestGameJob" : "RequestGame"
                        pl := "https://assetgame.roblox.com/game/PlaceLauncher.ashx"
                            . "?request=" req
                            . "&browserTrackerId=" btid
                            . "&placeId=" placeId
                            . (jobId  != "" ? ("&gameId=" jobId) : "")
                            . (privCd != "" ? ("&accessCode=" privCd) : "")
                            . "&isPartyLeader=false&isTeleport=false&isPlayTogetherGame=false"
                        enc := ""
                        ; percent-encode the launcher url - it travels inside the
                        ; protocol argument and its own & would split the arguments
                        loop parse pl {
                            c := A_LoopField
                            enc .= RegExMatch(c, "[A-Za-z0-9._~-]") ? c : Format("%{:02X}", Ord(c))
                        }
                        uri := "roblox-player:1+launchmode:play"
                             . "+gameinfo:" tick
                             . "+launchtime:" ts
                             . "+placelauncherurl:" enc
                             . "+browsertrackerid:" btid
                             . "+robloxLocale:en_us+gameLocale:en_us+channel:"
                    }
                    ok := 0, rerr := ""
                    try {
                        Run(uri)
                        ok := 1
                    } catch as e2
                        rerr := StrReplace(e2.Message, "|", " ")
                    out := ok ? (slot "|OK|launching")
                              : (slot "|ERR|windows refused roblox-player: " rerr)
                }
            }
        } catch as e {
            out := slot "|ERR|" StrReplace(e.Message, "|", " ")
        }
    }
    sBuf := Buffer(StrPut(out, "UTF-16"))
    StrPut(out, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A1E, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}

; ---- one geo lookup, used by the child block below AND by the parent ----
; Pulled out of the child so the parent can run it directly when spawning a
; child is not possible. That happens more often than it sounds: a compiled exe
; launching copies of ITSELF with arguments is a textbook antivirus heuristic,
; and a source encryptor rewrites A_ScriptFullPath so the spawn points at the
; wrong file. Either way the region never resolved and nothing said why.
; `fast` is for the IN-PROCESS route only. That one runs on the render thread,
; and the ordinary budget is three providers at 3+3+4+5 s each - up to about
; forty-five seconds of frozen UI in the worst case, which the comment at the
; call site described as "one brief hitch". Fast mode tries a single provider
; with a total ceiling under four seconds, which is what that claim was
; actually worth.
GeoLookupRaw(target, fast := false) {
    self := (target = "self")
    urls := self ? ["https://ipinfo.io/json"
                  , "https://ipwho.is/"
                  , "http://ip-api.com/json/"]
                 : ["https://ipinfo.io/" target "/json"
                  , "https://ipwho.is/" target
                  , "http://ip-api.com/json/" target]
    if fast
        urls := [urls[1]]
    for url in urls {
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            if fast
                whr.SetTimeouts(800, 800, 1000, 1400)
            else
                whr.SetTimeouts(3000, 3000, 4000, 5000)
            whr.Open("GET", url, false)
            whr.SetRequestHeader("User-Agent", "YURI")
            whr.Send()
            if (whr.Status != 200)
                continue
            body := whr.ResponseText
            ; ip-api reports failure with HTTP 200 and {"status":"fail"}, and
            ; ipwho.is with {"success":false} - the status code is not enough.
            if RegExMatch(body, 'i)"status"\s*:\s*"fail"')
                continue
            if RegExMatch(body, 'i)"success"\s*:\s*false')
                continue
            city := "", reg := "", cc := "", glat := "", glng := ""
            if RegExMatch(body, '"city"\s*:\s*"([^"]*)"', &m)
                city := m[1]
            if RegExMatch(body, '"region(?:Name)?"\s*:\s*"([^"]*)"', &m)
                reg := m[1]
            if RegExMatch(body, '"country_?[Cc]ode"\s*:\s*"([^"]*)"', &m)
                cc := m[1]
            else if RegExMatch(body, '"country"\s*:\s*"([^"]*)"', &m)
                cc := m[1]
            if RegExMatch(body, '"loc"\s*:\s*"(-?[0-9.]+),(-?[0-9.]+)"', &m)
                glat := m[1], glng := m[2]
            else if (RegExMatch(body, '"lat(?:itude)?"\s*:\s*(-?[0-9.]+)', &m)
                  && RegExMatch(body, '"lon(?:gitude)?"\s*:\s*(-?[0-9.]+)', &m2))
                glat := m[1], glng := m2[1]
            loc := (city != "") ? city : reg
            if (cc != "")
                loc := (loc = "") ? cc : (loc ", " cc)
            ; a reply that names nowhere is not an answer
            if (loc = "" && glat = "")
                continue
            return loc "|" cc "|" glat "|" glng
        }
    }
    return ""
}

if A_Args.Length >= 3 && A_Args[1] = "geoip" {
    Suspend true
    ; the lookup itself lives in GeoLookupRaw above, so the parent can run the
    ; exact same code when this helper cannot be started at all
    out := GeoLookupRaw(A_Args[3])
    if (out != "") {
        sBuf := Buffer(StrPut(out, "UTF-16"))
        StrPut(out, sBuf, "UTF-16")
        cds := Buffer(A_PtrSize*3)
        NumPut("uptr", (A_Args[3] = "self") ? 0x5A1A : 0x5A18, cds, 0)
        NumPut("uint", sBuf.Size, cds, A_PtrSize)
        NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
        DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    }
    ExitApp
}

if A_Args.Length >= 2 && A_Args[1] = "galpick" {
    Suspend true
