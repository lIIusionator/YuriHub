TutPanelH() => Max(160, HL.pd + HL.ch - 34 - HL.aby)
; ---- a small drawing per step, in the card's header ----
; Line work in the accent, sixteen pixels across, the way the module cards and
; the settings tiles draw theirs - so the card belongs to the hub it explains.
TutGlyph(kind, cx, cy, acc, f) {
    hi := AccHi(acc, 0.45)
    pn := Pen(FA(Alpha(hi, 230), f), 1.5)
    b := SBrush(FA(Alpha(hi, 230), f))
    if (kind = "nav") {
        loop 3
            Line(cx - 7, cy - 6 + (A_Index - 1)*6, cx + 7, cy - 6 + (A_Index - 1)*6, pn)
    } else if (kind = "grip") {
        loop 6 {
            gc := Mod(A_Index - 1, 3), gr := (A_Index - 1) // 3
            FillEll(cx - 7 + gc*6, cy - 4 + gr*6, 2.6, 2.6, b)
        }
    } else if (kind = "gauge") {
        Arc(cx - 8, cy - 6, 16, 16, 180, 180, pn)
        Line(cx, cy + 2, cx + 4, cy - 3, pn)
    } else if (kind = "dart") {
        HubDart(cx, cy, 7, FA(Alpha(hi, 235), f))
    } else if (kind = "news") {
        StrokeRR(cx - 7, cy - 7, 14, 14, 2.5, pn)
        Line(cx - 4, cy - 3, cx + 4, cy - 3, pn), Line(cx - 4, cy + 1, cx + 4, cy + 1, pn), Line(cx - 4, cy + 4, cx + 1, cy + 4, pn)
    } else if (kind = "rail") {
        StrokeRR(cx - 7, cy - 8, 14, 6, 2, pn), StrokeRR(cx - 7, cy + 1, 14, 6, 2, pn)
    } else if (kind = "shield") {
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &sp := 0)
        DllCall("gdiplus\GdipAddPathLine", "ptr", sp, "float", cx - 7, "float", cy - 6, "float", cx, "float", cy - 9)
        DllCall("gdiplus\GdipAddPathLine", "ptr", sp, "float", cx, "float", cy - 9, "float", cx + 7, "float", cy - 6)
        DllCall("gdiplus\GdipAddPathLine", "ptr", sp, "float", cx + 7, "float", cy - 6, "float", cx + 6, "float", cy + 2)
        DllCall("gdiplus\GdipAddPathLine", "ptr", sp, "float", cx + 6, "float", cy + 2, "float", cx, "float", cy + 8)
        DllCall("gdiplus\GdipAddPathLine", "ptr", sp, "float", cx, "float", cy + 8, "float", cx - 6, "float", cy + 2)
        DllCall("gdiplus\GdipClosePathFigure", "ptr", sp)
        DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", sp)
        DllCall("gdiplus\GdipDeletePath", "ptr", sp)
    } else if (kind = "flag") {
        Line(cx - 6, cy - 8, cx - 6, cy + 8, pn)
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &fp := 0)
        DllCall("gdiplus\GdipAddPathLine", "ptr", fp, "float", cx - 6, "float", cy - 8, "float", cx + 7, "float", cy - 5)
        DllCall("gdiplus\GdipAddPathLine", "ptr", fp, "float", cx + 7, "float", cy - 5, "float", cx - 6, "float", cy - 1)
        DllCall("gdiplus\GdipClosePathFigure", "ptr", fp)
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", fp)
        DllCall("gdiplus\GdipDeletePath", "ptr", fp)
    } else if (kind = "list") {
        loop 3 {
            yy := cy - 6 + (A_Index - 1)*6
            FillEll(cx - 8, yy - 1.3, 2.6, 2.6, b), Line(cx - 3, yy, cx + 8, yy, pn)
        }
    } else if (kind = "folder") {
        StrokeRR(cx - 8, cy - 5, 16, 11, 2, pn), Line(cx - 8, cy - 5, cx - 2, cy - 5, pn), Line(cx - 2, cy - 5, cx, cy - 8, pn)
    } else if (kind = "bolt") {
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &bp := 0)
        DllCall("gdiplus\GdipAddPathLine", "ptr", bp, "float", cx + 2, "float", cy - 9, "float", cx - 5, "float", cy + 1)
        DllCall("gdiplus\GdipAddPathLine", "ptr", bp, "float", cx - 5, "float", cy + 1, "float", cx - 1, "float", cy + 1)
        DllCall("gdiplus\GdipAddPathLine", "ptr", bp, "float", cx - 1, "float", cy + 1, "float", cx - 2, "float", cy + 9)
        DllCall("gdiplus\GdipAddPathLine", "ptr", bp, "float", cx - 2, "float", cy + 9, "float", cx + 5, "float", cy - 1)
        DllCall("gdiplus\GdipAddPathLine", "ptr", bp, "float", cx + 5, "float", cy - 1, "float", cx + 1, "float", cy - 1)
        DllCall("gdiplus\GdipClosePathFigure", "ptr", bp)
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", bp)
        DllCall("gdiplus\GdipDeletePath", "ptr", bp)
    } else if (kind = "pointer") {
        Line(cx - 5, cy - 8, cx - 5, cy + 6, pn), Line(cx - 5, cy - 8, cx + 5, cy + 2, pn)
        Line(cx + 5, cy + 2, cx, cy + 2, pn), Line(cx, cy + 2, cx + 3, cy + 8, pn), Line(cx - 5, cy + 6, cx - 1, cy + 2, pn)
    } else if (kind = "sliders") {
        loop 3 {
            yy := cy - 6 + (A_Index - 1)*6
            Line(cx - 8, yy, cx + 8, yy, pn)
            FillEll(cx - 6 + Mod(A_Index*5, 11) - 1.6, yy - 2.2, 4.4, 4.4, b)
        }
    } else if (kind = "pin") {
        Arc(cx - 6, cy - 9, 12, 12, 200, 140, pn)
        Line(cx - 5.6, cy - 1, cx, cy + 8, pn), Line(cx + 5.6, cy - 1, cx, cy + 8, pn)
        FillEll(cx - 2, cy - 5, 4, 4, b)
    } else if (kind = "chip") {
        StrokeRR(cx - 6, cy - 6, 12, 12, 2, pn)
        loop 3 {
            o := -4 + (A_Index - 1)*4
            Line(cx + o, cy - 9, cx + o, cy - 6, pn), Line(cx + o, cy + 6, cx + o, cy + 9, pn)
            Line(cx - 9, cy + o, cx - 6, cy + o, pn), Line(cx + 6, cy + o, cx + 9, cy + o, pn)
        }
    } else if (kind = "power") {
        Arc(cx - 7, cy - 6, 14, 14, 300, 300, pn), Line(cx, cy - 9, cx, cy - 1, pn)
    } else if (kind = "palette") {
        Arc(cx - 8, cy - 8, 16, 16, 20, 320, pn)
        FillEll(cx - 4, cy - 5, 3, 3, b), FillEll(cx + 1, cy - 5, 3, 3, b), FillEll(cx + 3, cy, 3, 3, b)
    } else if (kind = "cog") {
        loop 8 {
            an := (A_Index - 1)*0.785398
            Line(cx + 5*Cos(an), cy + 5*Sin(an), cx + 8.5*Cos(an), cy + 8.5*Sin(an), pn)
        }
        Ell(cx - 5, cy - 5, 10, 10, pn), FillEll(cx - 1.8, cy - 1.8, 3.6, 3.6, b)
    } else if (kind = "tick") {
        Line(cx - 7, cy, cx - 2, cy + 5, pn), Line(cx - 2, cy + 5, cx + 8, cy - 6, pn)
    } else if (kind = "people") {
        ; two figures: a head and shoulders, and a second behind
        FillEll(cx - 7, cy - 8, 6.5, 6.5, b)
        FillRR(cx - 10, cy - 0.5, 12.5, 6.5, 3.2, b)
        Ell(cx + 1.5, cy - 7, 5.5, 5.5, pn)
        Arc(cx - 1.5, cy - 0.5, 11.5, 9.5, 200, 140, pn)
    } else {
        FillEll(cx - 3.5, cy - 3.5, 7, 7, b)
    }
    DelP(pn), DelB(b)
}
; the body, wrapped once to the card's width in the reading face; blank
; entries in the source are paragraph breaks and stay blank
TutLines(st, w) {
    if (st.HasOwnProp("wrap") && st.wrapW = w)
        return st.wrap
    out := [], para := ""
    for ln in st.body {
        if (ln = "") {
            if (para != "") {
                for wl in WrapText(para, fHint, w, 40)
                    out.Push(wl)
                para := ""
            }
            out.Push("")
            continue
        }
        para .= (para != "" ? " " : "") Trim(ln)
    }
    if (para != "")
        for wl in WrapText(para, fHint, w, 40)
            out.Push(wl)
    st.wrap := out, st.wrapW := w
    return out
}
; the largest title face the card's width can carry - the full face, then
; the status face, then the badge face - so a long title on a narrowed card
; is never cut at the edge
TutTitleFont(ttl, w) {
    if (MeasureW(ttl, HL.fT) <= w)
        return HL.fT
    if (MeasureW(ttl, fStatus) <= w)
        return fStatus
    return fBadge
}
; the small line above a title: the part of the hub the step is standing in
TutKicker(st) {
    if st.HasOwnProp("kick")
        return st.kick
    if (st.tab = 2)
        return st.mod = 1 ? "INTEGRATIONS  ·  FAST FLAG MANAGER" : st.mod = 2 ? "INTEGRATIONS  ·  FORSAKEN"
             : st.mod = 3 ? "INTEGRATIONS  ·  CURSOR"
             : st.mod = 4 ? "INTEGRATIONS  ·  CLIENT SETTINGS" : st.mod = 5 ? "INTEGRATIONS  ·  SPECIAL FEATURES"
             : st.mod = 6 ? "INTEGRATIONS  ·  DEVICE OPTIMIZATIONS" : st.mod = 7 ? "INTEGRATIONS  ·  LOGIN ITEMS"
             : "INTEGRATIONS"
    return st.tab = 4 ? "SETTINGS" : st.tab = 5 ? "CREDITS" : st.tab = 1 ? (st.anchor ? "DASHBOARD" : "YURI") : "HUB"
}

; ---- lifecycle ----
TutSeen() {
    v := 0
    try v := Integer(IniRead(iniPath, "hub", "tourseen", "0"))
    return v
}
TutStart(auto := 0) {
    if TUT.on
        return
    if !TUT_STEPS.Length
        TutBuild()
    TUT.on := 1, TUT.auto := auto, TUT.at := A_TickCount, TUT.outAt := 0
    TUT.hInit := 0, TUT.cInit := 0, TUT.lastTab := hubTab, TUT.lastMod := hubMod
    TutGo(1)
    HubPoke()
}
TutEnd() {
    if (!TUT.on || TUT.outAt)
        return
    TUT.outAt := A_TickCount
    TUT.seen := 1
    try IniWrite(1, iniPath, "hub", "tourseen")
    ; home: the dashboard, no module open, no sheet, the way the hub greets you
    if HL.profOpen
        TutProfClose()
    if (hubTab != 1)
        HubTabSet(1)
    if hubMod
        HubModSel(hubMod)
    HubPoke()
}
TutFinish() {
    TUT.on := 0, TUT.outAt := 0, TUT.step := 0
}
; enter a step: navigate the hub to where it looks, then time the card
TutGo(i) {
    if (i < 1 || i > TUT_STEPS.Length)
        return
    st := TUT_STEPS[i]
    TUT.prev := TUT.step, TUT.dir := (i >= TUT.step) ? 1 : -1
    TUT.step := i, TUT.stepAt := A_TickCount, TUT.curAt := 0, TUT.clickAt := 0
    if (FFM.view != "")
        FFMCloseView()
    if (SPF.view != "")
        SPFViewClose()
    if (st.tab != hubTab)
        HubTabSet(st.tab)
    if (st.mod >= 0 && st.mod != hubMod) {
        if hubMod
            HubModSel(hubMod)                     ; closes the one that is open
        if st.mod
            HubModSel(st.mod)
    }
    ; the EDIT PROFILE sheet, opened for the steps that walk through it and
    ; closed again the moment the tour moves on - through the sheet's own
    ; close path, so nothing typed into it is left dangling
    wantProf := st.HasOwnProp("prof") ? st.prof : 0
    if (wantProf && !HL.profOpen)
        HL.profOpen := 1, HL.bioOpen := 0
    else if (!wantProf && HL.profOpen)
        TutProfClose()
    if st.cur
        TUT.curAt := A_TickCount + 520            ; the cursor sets off once the card has landed
    HubPoke()
}
TutProfClose() {
    HL.profOpen := 0, HL.bioOpen := 0
    if (SH.focus >= 4)
        ScrFocus(0)
    ProfSave()
}
TutNext() {
    if (TUT.step >= TUT_STEPS.Length)
        TutEnd()
    else
        TutGo(TUT.step + 1)
}
TutBack() {
    if (TUT.step > 1)
        TutGo(TUT.step - 1)
}

; ---- zones and clicks ----
; 2200 NEXT / FINISH, 2201 BACK, 2202 SKIP, 2203 the card (inert), 2204 the
; spotlight (a click on the thing being shown counts as NEXT), 2206 the
; scrim (inert); 2207 is the dashboard's TOUR button, live outside the tour.
TutZone(ux, uy) {
    if (TUT.outAt || !TUT.cInit)
        return 2206
    cx := TUT.cx, cy := TUT.cy, cw := TUT.cwCur, ch := TUT.ch
    by := cy + ch - 56
    if (uy >= by && uy <= by + 26) {
        if (ux >= cx + cw - 96 && ux <= cx + cw - 14)
            return 2200
        if (TUT.step > 1 && ux >= cx + cw - 172 && ux <= cx + cw - 104)
            return 2201
    }
    if (ux >= cx + cw - 82 && ux <= cx + cw - 12 && uy >= cy + 11 && uy <= cy + 33)
        return 2202
    if (ux >= cx && ux <= cx + cw && uy >= cy && uy <= cy + ch)
        return 2203
    if (TUT.hasHole && ux >= TUT.hx && ux <= TUT.hx + TUT.hw && uy >= TUT.hy && uy <= TUT.hy + TUT.hh)
        return 2204
    return 2206
}
TutClick(z) {
    if (z = 2207) {
        TutStart(0)
        return
    }
    if !TUT.on
        return
    if (z = 2200 || z = 2204)
        TutNext()
    else if (z = 2201)
        TutBack()
    else if (z = 2202)
        TutEnd()
}

; ---- drawing ----
TutDraw(now, acc) {
    static SCRSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&"   ; the scramble alphabet - a local of each renderer that decodes text
    if !TUT.on
        return
    st := TUT_STEPS[TUT.step]
    ; the sheet: in over TUT_IN_MS, out over TUT_OUT_MS, then gone
    if TUT.outAt {
        e := Clamp((now - TUT.outAt)/(TUT_OUT_MS + 0.0), 0.0, 1.0)
        f := 1 - Ease3(e)
        if (e >= 1) {
            TutFinish()
            return
        }
    } else
        f := Ease3(Clamp((now - TUT.at)/(TUT_IN_MS + 0.0), 0.0, 1.0))
    ; ---- where the light falls ----
    a := st.anchor ? st.anchor.Call() : 0
    hasHole := IsObject(a)
    if hasHole {
        tx := a[1] - 8, ty := a[2] - 8, tw := a[3] + 16, th := a[4] + 16
        if !TUT.hInit {
            TUT.hx := tx, TUT.hy := ty, TUT.hw := tw, TUT.hh := th, TUT.hInit := 1
        } else {
            k := EK(0.2)
            TUT.hx += (tx - TUT.hx)*k, TUT.hy += (ty - TUT.hy)*k
            TUT.hw += (tw - TUT.hw)*k, TUT.hh += (th - TUT.hh)*k
        }
    }
    TUT.hasHole := hasHole
    hx := TUT.hx, hy := TUT.hy, hw := TUT.hw, hh := TUT.hh
    ; the hole eases to the new target; while it travels the card waits
    settled := !hasHole || (Abs(hx - tx) < 3 && Abs(hy - ty) < 3 && Abs(hw - tw) < 4 && Abs(hh - th) < 4)

    ; ---- the scrim, with the spotlight cut out of it ----
    ; One path, two figures, alternate fill: the whole window, and the rounded
    ; hole - so the fill covers everything but the hole in one operation.
    px := HL.pd, py := HL.pd, pw := HL.cw, ph := HL.ch
    DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &sp := 0)    ; FillModeAlternate
    DllCall("gdiplus\GdipAddPathRectangle", "ptr", sp, "float", px, "float", py, "float", pw, "float", ph)
    if hasHole {
        hp := RRPath(hx, hy, hw, hh, 12)
        DllCall("gdiplus\GdipAddPathPath", "ptr", sp, "ptr", hp, "int", 0)
        DllCall("gdiplus\GdipDeletePath", "ptr", hp)
    }
    b := SBrushP(FA(Alpha(0x05060C, 168), f))     ; theme-preserving: a dimming is a dimming in both
    DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", sp), DelB(b)
    DllCall("gdiplus\GdipDeletePath", "ptr", sp)

    if hasHole {
        ; the ring around the light: breathing, with the four corner ticks the
        ; hub's cards wear, and a soft outer bloom
        brth := (Sin(DecT(now)*0.0035) + 1)/2
        SoftGlow(hx + hw/2, hy + hh/2, hw/2 + 40, hh/2 + 40, acc, Round((44 + 20*brth)*f), 1.0, 5)
        pn := Pen(FA(Alpha(acc, Round(150 + 70*brth)), f), 1.6)
        StrokeRR(hx, hy, hw, hh, 12, pn), DelP(pn)
        pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(60 + 40*brth)), f), 4)
        StrokeRR(hx - 3, hy - 3, hw + 6, hh + 6, 15, pn), DelP(pn)
        ; a dashed orbit walking round the light, the way the gate's frame does
        if !hubLowPerf {
            pn := Pen(FA(Alpha(acc, 110), f), 1)
            DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
            DllCall("gdiplus\GdipSetPenDashOffset", "ptr", pn, "float", -Mod(DecT(now)*0.02, 1000))
            StrokeRR(hx - 9, hy - 9, hw + 18, hh + 18, 18, pn), DelP(pn)
        }
        ; the click flash: the ring blinks bright when the ghost cursor lands
        if (TUT.clickAt && now - TUT.clickAt < 320) {
            fl := 1 - (now - TUT.clickAt)/320.0
            pn := Pen(FA(Alpha(AccHi(acc, 0.7), Round(230*fl)), f), 2.5)
            StrokeRR(hx - 1, hy - 1, hw + 2, hh + 2, 13, pn), DelP(pn)
        }
        pn := Pen(FA(Alpha(AccHi(acc, 0.5), 230), f), 2)
        tk := 12
        Line(hx - 6, hy + tk, hx - 6, hy - 6, pn), Line(hx - 6, hy - 6, hx + tk, hy - 6, pn)
        Line(hx + hw - tk, hy - 6, hx + hw + 6, hy - 6, pn), Line(hx + hw + 6, hy - 6, hx + hw + 6, hy + tk, pn)
        Line(hx - 6, hy + hh - tk, hx - 6, hy + hh + 6, pn), Line(hx - 6, hy + hh + 6, hx + tk, hy + hh + 6, pn)
        Line(hx + hw - tk, hy + hh + 6, hx + hw + 6, hy + hh + 6, pn), Line(hx + hw + 6, hy + hh + 6, hx + hw + 6, hy + hh - tk, pn)
        DelP(pn)
    }

    ; ---- the card ----
    ; Sized to its lines, placed where there is room - under the light, above
    ; it, beside it - or centred when there is nothing to light. It eases to a
    ; new place between steps, and fades and slides in on each.
    ; ---- width first ----
    ; A light that takes the whole panel column leaves no room below, above
    ; or beside it at the card's full width - and a card laid over the panel
    ; hides the thing it is describing. So when the full width fits nowhere,
    ; the card narrows to the room on the left of the light (the sidebar and
    ; the rail, which are not the subject) down to 300 px, and only when even
    ; that will not fit does it take the other half of the window.
    cw := TUT.cw
    if hasHole {
        below := hy + hh + 16 + (96 + 6*17 + 76) <= py + ph - 12
        above := hy - 16 - (96 + 6*17 + 76) >= py + 12
        rightR := hx + hw + 16 + cw <= px + pw - 12
        leftR  := hx - 16 - cw >= px + 12
        if (!below && !above && !rightR && !leftR && hx - 16 - 300 >= px + 12)
            cw := hx - 16 - (px + 12)
    }
    TUT.cwCur := cw
    lines := TutLines(st, cw - 40)
    ch := 96 + lines.Length*17 + 76
    if hasHole {
        cxT := Clamp(hx + hw/2 - cw/2, px + 12, px + pw - cw - 12)
        if (hy + hh + 16 + ch <= py + ph - 12)
            cyT := hy + hh + 16
        else if (hy - 16 - ch >= py + 12)
            cyT := hy - 16 - ch
        else if (hx + hw + 16 + cw <= px + pw - 12) {
            cyT := Clamp(hy + hh/2 - ch/2, py + 12, py + ph - ch - 12), cxT := hx + hw + 16
        } else if (hx - 16 - cw >= px + 12) {
            cyT := Clamp(hy + hh/2 - ch/2, py + 12, py + ph - ch - 12), cxT := hx - 16 - cw
        } else
            ; no room on any side even narrowed: the other half of the window
            cyT := (hy + hh/2 < py + ph/2) ? py + ph - ch - 12 : py + 12
    } else
        cxT := px + pw/2 - cw/2, cyT := py + ph/2 - ch/2
    if !TUT.cInit {
        TUT.cx := cxT, TUT.cy := cyT, TUT.ch := ch, TUT.cInit := 1
    } else {
        k := EK(0.22)
        TUT.cx += (cxT - TUT.cx)*k, TUT.cy += (cyT - TUT.cy)*k, TUT.ch += (ch - TUT.ch)*k
    }
    cx := TUT.cx, cy := TUT.cy, ch := TUT.ch
    sf := Ease3(Clamp((now - TUT.stepAt)/(TUT_STEP_MS + 0.0), 0.0, 1.0))   ; the step's own entrance
    ; the plate itself only fades with the sheet; its contents change over
    cf := f
    ; the card scales in from slightly small on every step, round its centre
    stC := PushXform(cx + cw/2, cy + ch/2, 0.97 + 0.03*sf, 0)
    ShadowDraw(cx, cy + 3, cw, ch, 14, 6, 34, 18, cf, 1.0)
    b := VBrush(cx, cy, cw, ch, FA(Mix(0xFF1B1F38, 0xFF232948, 0.4), cf), FA(0xFF10121E, cf))
    FillRR(cx, cy, cw, ch, 14, b), DelB(b)
    MiniBackdrop(cx, cy, cw, ch, 14, acc, cf, now, 0.85)
    pn := Pen(FA(Alpha(acc, 130), cf), 1.2)
    StrokeRR(cx, cy, cw, ch, 14, pn), DelP(pn)
    ; ---- the header band ----
    ; A lighter strip across the top with the accent bleeding in from the
    ; left, the step counter and the kicker on it, the step's glyph in a ring
    ; at its right, and SKIP as a proper chip. The band is what makes the card
    ; read as a card of the hub rather than a box of text.
    hbh := 44
    pH := RRPath(cx, cy, cw, ch, 14)
    stH := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pH, "int", 1)
    b := HBrush(cx, cy, cw, hbh, FA(Alpha(acc, 46), cf), FA(Alpha(acc, 8), cf))
    FillRR(cx, cy, cw, hbh, 0, b), DelB(b)
    b := VBrush(cx, cy, cw, hbh, FA(Alpha(0xFFFFFF, 14), cf), FA(Alpha(0xFFFFFF, 0), cf))
    FillRR(cx, cy, cw, hbh, 0, b), DelB(b)
    b := SBrush(FA(Alpha(acc, 60), cf))
    FillRR(cx, cy + hbh - 1, cw, 1, 0, b), DelB(b)
    Pop(stH)
    DllCall("gdiplus\GdipDeletePath", "ptr", pH)
    ; the rail grows down the card's edge on each step
    rlh := (ch - 28)*sf
    b := VBrush(cx, cy + 14, 3, Max(rlh, 1), FA(Alpha(AccHi(acc, 0.4), 230), cf), FA(Alpha(acc, 90), cf))
    FillRR(cx, cy + 14, 3, Max(rlh, 1), 1.5, b), DelB(b)
    ; step counter, as a small chip on the band
    cnt := TUT.step " / " TUT_STEPS.Length
    cnw := MeasureW(cnt, HL.fXs) + 14
    b := SBrush(FA(Alpha(0x000000, 70), cf))
    FillRR(cx + 16, cy + 13, cnw, 18, 9, b), DelB(b)
    pn := Pen(FA(Alpha(acc, 110), cf), 1)
    StrokeRR(cx + 16, cy + 13, cnw, 18, 9, pn), DelP(pn)
    Txt(cnt, cx + 16, cy + 15, cnw, 14, HL.fXs, FA(Alpha(AccHi(acc, 0.4), 235), cf), fmtC)
    ; the step's glyph in a ring, right of centre on the band
    gcx := cx + cw - 118, gcy := cy + hbh/2
    b := SBrush(FA(Alpha(0x000000, 60), cf))
    FillEll(gcx - 15, gcy - 15, 30, 30, b), DelB(b)
    pn := Pen(FA(Alpha(acc, 140), cf), 1.2)
    Ell(gcx - 15, gcy - 15, 30, 30, pn), DelP(pn)
    if st.HasOwnProp("glyph")
        TutGlyph(st.glyph, gcx, gcy, acc, cf*sf)
    ; ---- SKIP, as a chip ----
    ; A ghost pill with a double chevron: it reads as a control, lights on
    ; hover, and sits apart from the step controls at the foot.
    hvS := HL.h.Get(2202, 0.0)
    skx := cx + cw - 82, sky := cy + 11, skw := 70
    b := VBrush(skx, sky, skw, 22, FA(Alpha(0xFFFFFF, Round(10 + 16*hvS)), cf), FA(Alpha(0xFFFFFF, Round(4 + 6*hvS)), cf))
    FillRR(skx, sky, skw, 22, 11, b), DelB(b)
    pn := Pen(FA(Alpha(acc, Round(70 + 120*hvS)), cf), 1)
    StrokeRR(skx, sky, skw, 22, 11, pn), DelP(pn)
    Txt("SKIP", skx + 10, sky + 4, 34, 14, HL.fXs, FA(Alpha(THMix(0xFFC7CBE0, 0xFFFFFFFF, hvS), Round(180 + 75*hvS)), cf), fmtL)
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(180 + 60*hvS)), cf), 1.4)
    chx := skx + skw - 20 + 2*hvS, chy := sky + 11
    loop 2 {
        ox := (A_Index - 1)*5
        Line(chx + ox, chy - 4, chx + ox + 4, chy, pn), Line(chx + ox + 4, chy, chx + ox, chy + 4, pn)
    }
    DelP(pn)
    ; ---- the contents change over ----
    ; The outgoing step's title and lines slide out and fade the way the new
    ; ones slide in and fade, in the direction the tour went, so a step
    ; change reads as the card turning a page rather than swapping a label.
    if (TUT.prev >= 1 && TUT.prev <= TUT_STEPS.Length && sf < 1) {
        po := TUT_STEPS[TUT.prev]
        of := (1 - sf)*cf
        ox := -14*sf*TUT.dir
        pl := TutLines(po, cw - 40)
        Txt(TutKicker(po), cx + 18 + ox, cy + hbh + 8, cw - 60, 12, HL.fXs, FA(Alpha(acc, Round(150*(1 - sf))), of), fmtL)
        Txt(po.ttl, cx + 18 + ox, cy + hbh + 20, cw - 36, 24, TutTitleFont(po.ttl, cw - 36), FA(Alpha(Mix(0xFFE8EAF6, acc, 0.15), 245), of), fmtL)
        loop pl.Length {
            ln := pl[A_Index]
            if (ln != "")
                Txt(ln, cx + 18 + ox, cy + 96 + (A_Index - 1)*17, cw - 36, 17, fHint, FA(0xD2C7CBE0, of), fmtL)
        }
    }
    ix := 14*(1 - sf)*TUT.dir
    Txt(TutKicker(st), cx + 18 + ix, cy + hbh + 8, cw - 60, 12, HL.fXs, FA(Alpha(acc, Round(150*sf)), cf), fmtL)
    ; the title decodes in, the way the gate's status word does
    tf := TutTitleFont(st.ttl, cw - 36)
    if (!st.HasOwnProp("scr") || st.scrF != tf)
        st.scr := BuildScr(st.ttl, tf), st.scrF := tf
    scr := st.scr
    if (now < TUT.stepAt + 120 + scr.chs.Length*22 && !hubLowPerf) {
        loop scr.chs.Length {
            i := A_Index
            if (now < TUT.stepAt + 80 + i*22) {
                ch2 := SubStr(SCRSET, Random(1, StrLen(SCRSET)), 1)
                cc := Alpha(Mix(acc, 0xFFE8EAF6, 0.55), 200)
            } else {
                ch2 := scr.chs[i]
                cc := Alpha(Mix(0xFFE8EAF6, acc, 0.15), 245)
            }
            Txt(ch2, cx + 18 + ix + scr.xs[i], cy + hbh + 20, 44, 24, tf, FA(cc, cf*sf), fmtL)
        }
    } else
        Txt(st.ttl, cx + 18 + ix, cy + hbh + 20, cw - 36, 24, tf, FA(Alpha(Mix(0xFFE8EAF6, acc, 0.15), 245), cf*sf), fmtL)
    ; the lines arrive one after another
    loop lines.Length {
        ln := lines[A_Index]
        if (ln = "")
            continue
        lf := Clamp(((now - TUT.stepAt) - 60 - (A_Index - 1)*40)/220.0, 0.0, 1.0)
        lf := Ease3(lf)
        Txt(ln, cx + 18 + 6*(1 - lf), cy + 96 + (A_Index - 1)*17, cw - 36, 17, fHint, FA(Alpha(0xFFC7CBE0, Round(215*lf)), cf), fmtL)
    }
    ; ---- the foot: a rule; the hint and the buttons on one row, the ----
    ; ---- progress dots on their own row beneath, full width           ----
    ; Nothing here shares a row with something anchored to the other edge
    ; at a width that can change: the hint stops where the buttons begin
    ; whatever the card's width, and the dots have the whole width to
    ; themselves.
    fty := cy + ch - 66
    b := HBrush(cx + 16, fty, cw - 32, 1, FA(Alpha(acc, 90), cf), FA(Alpha(acc, 0), cf))
    FillRR(cx + 16, fty, cw - 32, 1, 0, b), DelB(b)
    by := cy + ch - 56
    if hasHole
        Txt(FFMElide("click the lit control, or NEXT", HL.fXs, cw - 196), cx + 18, by + 6, cw - 196, 14, HL.fXs, FA(0x6EC7CBE0, cf), fmtL)
    n := TUT_STEPS.Length
    dx := cx + 18, dy := cy + ch - 18
    loop n {
        i := A_Index
        on := i = TUT.step
        w2 := on ? 3 + 9*sf : (i = TUT.prev && TUT.prev != TUT.step ? 3 + 9*(1 - sf) : 3)
        b := SBrush(FA(Alpha(on ? AccHi(acc, 0.4) : (i < TUT.step ? acc : 0xFFC7CBE0), on ? 235 : (i < TUT.step ? 150 : 60)), cf))
        FillRR(dx, dy, w2, 3, 1.5, b), DelB(b)
        dx += w2 + 3
    }
    if (TUT.step > 1)
        FFMBtn(2201, cx + cw - 172, by, 68, 26, "BACK", acc, cf, 0, HL.fS)
    FFMBtn(2200, cx + cw - 96, by, 82, 26, TUT.step = n ? "FINISH" : "NEXT", acc, cf, 1, HL.fS)
    ; the welcome card carries the brand as a watermark, low and to the right
    if (TUT.step = 1) {
        bw2 := MeasureW(APPNAME, HL.fG)
        Txt(APPNAME, cx + cw - 18 - bw2, cy + ch - 104, bw2 + 4, 50, HL.fG, FA(Alpha(acc, Round(22*sf)), cf), fmtL)
    }
    Pop(stC)

    ; ---- the ghost cursor ----
    ; Sets off from NEXT once the card has landed, curves to the middle of
    ; the light, clicks - a ring thrown off the tip - and rests there pulsing
    ; until the step changes. It is a demonstration, not a pointer: nothing
    ; it touches is pressed.
    if (st.cur && hasHole && settled && TUT.curAt && now >= TUT.curAt && !TUT.outAt) {
        tt := Clamp((now - TUT.curAt)/(TUT_CUR_MS + 0.0), 0.0, 1.0)
        et := Ease3(tt)
        x0 := cx + cw - 55, y0 := by + 13
        x1 := hx + hw/2, y1 := hy + hh/2
        ; a quadratic arc, bulging away from the straight line
        mx := (x0 + x1)/2 + (y0 - y1)*0.25, my := (y0 + y1)/2 + (x1 - x0)*0.25
        gx := (1 - et)**2*x0 + 2*(1 - et)*et*mx + et**2*x1
        gy := (1 - et)**2*y0 + 2*(1 - et)*et*my + et**2*y1
        arr := now - (TUT.curAt + TUT_CUR_MS)
        if (arr >= 0 && arr < 40 && !TUT.clickAt)
            TUT.clickAt := now                    ; the landing: the ring flashes once
        ; a trail of fading beads behind the pointer while it travels
        if (tt < 1 && !hubLowPerf) {
            loop 5 {
                bt := Clamp(tt - A_Index*0.06, 0.0, 1.0)
                be := Ease3(bt)
                bx2 := (1 - be)**2*x0 + 2*(1 - be)*be*mx + be**2*x1
                by2 := (1 - be)**2*y0 + 2*(1 - be)*be*my + be**2*y1
                b := SBrush(FA(Alpha(acc, Round(150/A_Index)), cf))
                FillEll(bx2 + 2 - 2.5, by2 + 2 - 2.5, 5, 5, b), DelB(b)
            }
        }
        if (arr >= 0 && arr < 700) {
            rp := arr/700.0
            pn := Pen(FA(Alpha(acc, Round(200*(1 - rp))), cf), 2.4 - 1.8*rp)
            Ell(gx - 6 - 26*rp, gy - 6 - 26*rp, 12 + 52*rp, 12 + 52*rp, pn), DelP(pn)
        }
        if (arr >= 0) {
            pls := (Sin(DecT(now)*0.006) + 1)/2
            b := SBrush(FA(Alpha(acc, Round(40 + 30*pls)), cf))
            FillEll(gx - 12 - 4*pls, gy - 12 - 4*pls, 24 + 8*pls, 24 + 8*pls, b), DelB(b)
        }
        ; the pointer: a small arrow, dark keyline under white fill
        DllCall("gdiplus\GdipCreatePath", "int", 0, "ptr*", &ap := 0)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx, "float", gy, "float", gx, "float", gy + 15)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx, "float", gy + 15, "float", gx + 4, "float", gy + 11.5)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx + 4, "float", gy + 11.5, "float", gx + 6.5, "float", gy + 17)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx + 6.5, "float", gy + 17, "float", gx + 9.5, "float", gy + 15.6)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx + 9.5, "float", gy + 15.6, "float", gx + 7, "float", gy + 10.4)
        DllCall("gdiplus\GdipAddPathLine", "ptr", ap, "float", gx + 7, "float", gy + 10.4, "float", gx + 11.5, "float", gy + 10.4)
        DllCall("gdiplus\GdipClosePathFigure", "ptr", ap)
        pn := Pen(FA(Alpha(0xFF0C0E17, 230), cf), 2.4)
        DllCall("gdiplus\GdipDrawPath", "ptr", G, "ptr", pn, "ptr", ap), DelP(pn)
        b := SBrushP(FA(0xFFF4F5FA, cf))
        DllCall("gdiplus\GdipFillPath", "ptr", G, "ptr", b, "ptr", ap), DelB(b)
        DllCall("gdiplus\GdipDeletePath", "ptr", ap)
    }
}

; ---- the footer card -------------------------------------------------------
; Its own frame, its own fade and its own slide, on the same curve SPFLive uses
; for the strip under SPECIAL. Nothing about it is tied to how far the panel
; above has opened, which is what kept going wrong while it lived inside that
; panel: down there it was the last thing the growing frame uncovered, so it
; could only ever appear at the very end and vanish at the very start.
DOPFooter(px, py, pw, ff, now, acc, mt) {
    ; Last of all - after the frame and after every row, so the panel finishes
    ; assembling top to bottom. Still clear of HubEmptyGhost, which has gone by
    ; 0.625, so the placeholder never shares a frame with this card either.
    cg := Clamp((mt - 0.84)/0.12, 0.0, 1.0)
    if (cg <= 0.01)
        return
    fb := ff*cg
    ph := HL.dopbh
    sld := (1 - cg)*12
    py -= sld

    b := VBrush(px, py, pw, ph, FA(Mix(0xFF141728, 0xFF1B2038, 0.5), fb), FA(0xFF10121C, fb))
    FillRR(px, py, pw, ph, 12, b), DelB(b)
    MiniBackdrop(px, py, pw, ph, 12, acc, fb, now, 0.85)
    pn := Pen(FA(Alpha(acc, 60 + 40*mt), fb), 1.2)
    StrokeRR(px, py, pw, ph, 12, pn), DelP(pn)
    gl := 30*cg
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), 170*cg), fb), 1.5)
    Line(px + 12, py + 0.6, px + 12 + gl, py + 0.6, pn)
    Line(px + pw - 12 - gl, py + ph - 0.6, px + pw - 12, py + ph - 0.6, pn), DelP(pn)

    pClip := RRPath(px, py, pw, ph, 12)
    stF := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pClip, "int", 1)

    n := DOPOnCount()
    busy := (DOP.busy != "")
    ; a band sweeping the card while a child is out - the card says "working"
    ; on its own rather than leaving the sentence to carry it
    if (busy && !hubLowPerf) {
        bx := px + Mod(DecT(now)*0.10, pw + 80) - 40
        br := VBrush(bx, py, 46, ph, Alpha(0xFFFFFF, 0), FA(Alpha(AMBER, 26), fb))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", br
              , "float", bx, "float", py, "float", 46, "float", ph), DelB(br)
    }

    ; ---- state, left ----
    dot := busy ? AMBER : n ? C_ON : 0xFF8A90A6
    da  := busy ? Round(150 + 90*Abs(Sin(DecT(now)*0.005))) : (n ? 225 : 90)
    b := SBrush(FA(Alpha(dot, da), fb))
    FillRR(px + 16, py + 13, 3, 14, 1.5, b), DelB(b)
    mAge := DOP.msgAt ? (A_TickCount - DOP.msgAt) : 999999
    shown := (mAge < 6000) ? DOP.msg : DOPStatus()
    scol := (mAge < 6000) ? (DOP.msgCol = C_ACC ? acc : DOP.msgCol) : 0x8AC7CBE0
    ; pw - 220, not pw - 196: the tally block starts at pw - 16 - 116 and its
    ; count label reaches 52px further left again, so 196 put the sentence
    ; underneath it. This leaves 8px between the two.
    Txt(FFMElide(shown, fHint, pw - 220), px + 28, py + 11, pw - 220, 18, fHint
        , FA(scol, fb), fmtL)

    ; ---- the tally, right ----
    ; The right half was empty and the card read as two buttons on a slab. One
    ; segment per group, lit off the SAME eased value the row switches use, so
    ; this and the switch above always agree and the fill slides rather than
    ; snapping. It is the only place the whole module's state is visible at
    ; once, which is what a summary strip is for.
    segN := DOPGroups().Length
    segW := 20, segG := 4
    tw   := segN*segW + (segN - 1)*segG
    tx   := px + pw - 16 - tw
    Txt(n " / " segN, tx - 52, py + 10, 46, 14, HL.fS
        , FA(Alpha(n ? AccHi(acc, 0.4) : 0xFF8A90A6, n ? 235 : 150), fb), fmtR)
    Txt("APPLIED", tx, py + 10, tw, 14, HL.fXs, FA(0x62C7CBE0, fb), fmtR)
    for i, grp in DOPGroups() {
        ; each segment lands just after the one before it
        sg := Clamp((cg - 0.30 - i*0.06)/0.40, 0.0, 1.0)
        if (sg <= 0.01)
            continue
        sx := tx + (i - 1)*(segW + segG)
        sy2 := py + 30
        lit := DOP.t.Has(i) ? DOP.t[i] : (DOPIsOn(grp.id) ? 1.0 : 0.0)
        run := (DOP.busy = grp.id)
        b := SBrush(FA(Alpha(0xFFFFFF, Round(16*sg)), fb))
        FillRR(sx, sy2, segW, 5, 2.5, b), DelB(b)
        if (lit > 0.01) {
            b := HBrush(sx, sy2, segW*lit + 0.5, 5, FA(Alpha(AccHi(acc, 0.35), Round(230*sg)), fb)
                      , FA(Alpha(C_ON, Round(230*sg)), fb))
            FillRR(sx, sy2, segW*lit, 5, 2.5, b), DelB(b)
        }
        if run {
            pl := (Sin(DecT(now)*0.006 - i) + 1)/2
            b := SBrush(FA(Alpha(AMBER, Round((90 + 120*pl)*sg)), fb))
            FillRR(sx, sy2, segW, 5, 2.5, b), DelB(b)
        }
        ; a restart still owed reads on the segment, not only in the sentence
        if (lit > 0.5 && grp.rb) {
            b := SBrush(FA(Alpha(AMBER, Round(220*sg)), fb))
            FillEll(sx + segW/2 - 1.6, sy2 + 9, 3.2, 3.2, b), DelB(b)
        }
    }

    ; ---- the two buttons ----
    ; staggered a touch behind the text so the card assembles rather than
    ; arriving all at once
    bg := Clamp((cg - 0.22)/0.5, 0.0, 1.0)
    if (bg > 0.01) {
        by2 := py + ph - 32 + (1 - bg)*6
        FFMBtn(1270, px + 16,  by2, 104, 24, "REVERT ALL", acc, ff*bg, n ? 3 : 4)
        FFMBtn(1271, px + 128, by2, 104, 24, "SNAPSHOTS", acc, ff*bg, 0)
        ; Lit only when something HAS drifted. A re-apply button that is always
        ; live invites pressing it, and every press is a UAC prompt for a group
        ; that was already correct.
        FFMBtn(1274, px + 240, by2, 104, 24, "RE-APPLY", acc, ff*bg, DOPDriftN() ? 3 : 4)
    }

    Pop(stF)
    DllCall("gdiplus\GdipDeletePath", "ptr", pClip)
}

; ---------------- database insert pulse ----------------
; One curve and one stamp reader, shared by the flag manager's database and the
; client settings one, so the two managers acknowledge an insert identically
; rather than growing separate motion for the same act.
;
; `t` is elapsed 0..1. Nothing draws once it is spent, so a settled list pays
; one comparison per row.
FFMInsPulse(x, y, w, h, r, t, ff) {
    if (t >= 1 || t < 0)
        return
    pp := 1 - t
    b := SBrush(FA(Alpha(C_ON, Round(85*pp)), ff))
    FillRR(x, y, w, h, r, b), DelB(b)
    b := SBrush(FA(Alpha(C_ON, Round(215*pp)), ff))
    FillRR(x + 6, y + 4, 2.5, h - 8, 1.2, b), DelB(b)
    if hubLowPerf
        return
    ; The expanding edge is the same arriving language RSetFxField's focus ring
    ; uses - eased so it leaves quickly and then slows, which reads as one thing
    ; departing the row rather than the row blinking.
    ex := Ease3(t)*15
    pn := Pen(FA(Alpha(C_ON, Round(200*pp)), ff), 1.6*pp + 0.2)
    StrokeRR(x - ex, y - ex*0.55, w + ex*2, h + ex*1.1, r + ex*0.35, pn), DelP(pn)
}
; Elapsed 0..1 for a stamped name. The entry is dropped the moment it is spent,
; so browsing the database all session cannot grow the map without bound - the
; same self-pruning FFM.flash does on the staged list.
FFMInsT(mp, key, now) {
    k := StrLower(key)
    if !mp.Has(k)
        return 1.0
    t := (now - mp[k])/FFM_INSMS
    if (t >= 1) {
        mp.Delete(k)
        return 1.0
    }
    return t
}

; ---------------- log overlay ----------------
FFMLogZone(ux, uy) {
    x := HL.ctx, y := HL.cty + 30, w := HL.ctw
    lh := FFM_LGROWS*FFM_LGRH, ly := y + 38
    ; top-right X closes the view
    if (ux >= x + w - 32 && ux <= x + w && uy >= y && uy <= y + 28)
        return 440
    ; tab chips
    if (uy >= y + 7 && uy <= y + 29) {
        if (ux >= x + 14 && ux <= x + 14 + FFM_TABW)
            return 475
        if (ux >= x + 18 + FFM_TABW && ux <= x + 18 + FFM_TABW*2)
            return 476
        if (ux >= x + 22 + FFM_TABW*2 && ux <= x + 22 + FFM_TABW*3)
            return 478
    }
    ; HISTORY rows: the RESTORE button on each visible row, 619 + slot. The
    ; slot is turned back into a row against the list as it is now, the same
    ; way the database rows are.
    if (FFM.logTab = 3 && uy >= ly && uy <= ly + lh
        && ux >= x + w - 116 && ux <= x + w - 42) {
        k := Floor((uy - ly + FFM.hsScr)/FFM_HSRH) - Floor(FFM.hsScr/FFM_HSRH) + 1
        if (k >= 1 && k <= FFM_HSROWS + 1)
            return 619 + k
    }
    ; scrollbar thumb drag
    if (FFMLogTot() > lh
        && ux >= x + w - 26 && ux <= x + w - 6 && uy >= ly && uy <= ly + lh)
        return 441
    ; footer buttons - CLOSE (440), CLEAR (439), and UNDO (477) on the UPDATES
    ; tab when there is a rename pass to take back
    footerY := ly + lh + 14
    if (uy >= footerY && uy <= footerY + 24) {
        if (ux >= x + 14 && ux <= x + 88)      ; CLOSE button width 74
            return 440
        if (ux >= x + 100 && ux <= x + 174)     ; CLEAR button width 74
            return 439
        if (FFMCanUndo() && ux >= x + 186 && ux <= x + 260)
            return 477
    }
    ; Inert catch-all covering the rest of the panel. HubHT reports
    ; HTTRANSPARENT for zone 0, which made the list body click-through - so the
    ; wheel never reached the hub and only the scrollbar could be scrolled.
    h := 38 + lh + 48
    if (ux >= x && ux <= x + w && uy >= y && uy <= y + h)
        return 443
    return 0
}

; Scroll extent of whichever tab is showing. Both the wheel, the thumb drag and
; the thumb geometry read this, so the two tabs cannot drift apart.
FFMLogTot() => (FFM.logTab = 2) ? FFM.upd.Length*FFM_UPRH
             : (FFM.logTab = 3) ? FFM.hist.Length*FFM_HSRH : FFM.logs.Length*FFM_LGRH

FFMLogView(ff, now, acc, dx := 0, dy2 := 0) {
    ; only draw when this overlay is opening, or when it is the one closing
    e := Ease3(Clamp((now - FFM.viewAt)/280.0, 0.0, 1.0))
    if (FFM.view = "log")
        t := e
    else if (FFM.viewPrev = "log")
        t := 1 - e
    else
        return
    if (t <= 0.01)
        return
    fo := ff*t
    x := HL.ctx + dx, y := HL.cty + dy2 + 30, w := HL.ctw
    lh := FFM_LGROWS*FFM_LGRH
    h := 38 + lh + 48
    upTab := (FFM.logTab = 2)

    ; dim background
    b := SBrush(FA(Alpha(0x06070E, Round(215*t)), ff))
    FillRR(x - 10, HL.cty + dy2 - 6, w + 20, h + 54, 14, b), DelB(b)

    st := PushXform(x + w/2, y + h/2, 0.96 + 0.04*t, 0)
    HubViewChrome(x, y, w, h, fo, now, acc)

    ; ---- tabs ----
    ; ---- the switch transition ----
    ; lt runs 0..1 across the change; u is where the underline sits, 0 on
    ; INJECTION and 1 on UPDATES, eased. Both are 1/settled whenever nothing
    ; has been clicked, so the steady state costs one comparison.
    ; ---- three chips, one underline ----
    ; `u` is the underline's position in tab units - 0 on INJECTION, 1 on
    ; UPDATES, 2 on HISTORY - eased across a switch. Each chip's own selection
    ; is how close the underline is to it, so the pair being crossed both sit
    ; part-lit mid-travel exactly as they did with two tabs.
    lt := (FFM.logTabAt && now - FFM.logTabAt < FFM_TABMS)
        ? Ease3((now - FFM.logTabAt)/FFM_TABMS) : 1.0
    swp := (lt < 1) && (FFM.logTabPrev != FFM.logTab)
    uTo := FFM.logTab - 1.0
    u   := swp ? Lerp(FFM.logTabPrev - 1.0, uTo, lt) : uTo

    t1x := x + 14, t2x := x + 18 + FFM_TABW, t3x := x + 22 + FFM_TABW*2
    FFMLogTab(475, t1x, y + 7, "INJECTION", Clamp(1 - Abs(u - 0), 0.0, 1.0), acc, fo)
    FFMLogTab(476, t2x, y + 7, "UPDATES",   Clamp(1 - Abs(u - 1), 0.0, 1.0), acc, fo)
    FFMLogTab(478, t3x, y + 7, "HISTORY",   Clamp(1 - Abs(u - 2), 0.0, 1.0), acc, fo)
    ; one underline, slid between the chips. It also stretches slightly at
    ; the midpoint of each hop so the travel reads as a single object moving
    ; rather than a bar teleporting - the overshoot is on the width, not the
    ; position, so it can never leave the chip it lands on.
    ubx := t1x + u*(FFM_TABW + 4) + 8
    ubw := (FFM_TABW - 16) * (1 + 0.35*Sin(3.14159*(u - Floor(u))))
    b := SBrush(FA(Alpha(acc, 210), fo))
    FillRR(ubx - (ubw - (FFM_TABW - 16))/2, y + 26, ubw, 2, 1, b), DelB(b)

    cnt := upTab ? FFM.upd.Length : (FFM.logTab = 3) ? FFM.hist.Length : FFM.logs.Length
    Txt(cnt " entries", x + 30 + FFM_TABW*3, y + 12, 120, 16, HL.fS, FA(0x66C7CBE0, fo), fmtL)

    ; close X - coloured on hover
    hvX := HL.h.Get(440, 0.0)
    pn := Pen(FA(Alpha(hvX > 0.2 ? acc : 0xFFC7CBE0, 130 + 120*hvX), fo), 1.6)
    cxx := x + w - 18, cyy := y + 14
    Line(cxx - 5, cyy - 5, cxx + 5, cyy + 5, pn)
    Line(cxx + 5, cyy - 5, cxx - 5, cyy + 5, pn), DelP(pn)

    ly := y + 38
    lc := RRPath(x + 10, ly, w - 20, lh, 8)
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", lc, "int", 0)

    ; The two lists cross inside the clip above: the one being left slides out
    ; and fades, the one arriving slides in from the opposite edge. Direction
    ; follows the tab order, so INJECTION -> UPDATES always travels leftward
    ; and coming back always travels right - the motion tells you which way
    ; through the pair you moved.
    if swp {
        dir := (FFM.logTab > FFM.logTabPrev) ? 1 : -1
        oq  := 1 - lt
        if (oq > 0.01)
            FFMLogDrawTab(FFM.logTabPrev, x - dir*34*lt, w, ly, lh, t, fo*oq, acc)
        FFMLogDrawTab(FFM.logTab, x + dir*34*(1 - lt), w, ly, lh, t, fo*lt, acc)
    } else
        FFMLogDrawTab(FFM.logTab, x, w, ly, lh, t, fo, acc)

    DllCall("gdiplus\GdipResetClip", "ptr", G)
    DllCall("gdiplus\GdipDeletePath", "ptr", lc)

    ; scrollbar
    tot := FFMLogTot()
    if (tot > lh) {
        scr := upTab ? FFM.updScr : (FFM.logTab = 3) ? FFM.hsScr : FFM.logScr
        sbA := Max(HL.h.Get(441, 0.0), (HL.drag = 11) ? 1.0 : 0.0)
        sw := 3 + 4*sbA
        sx2 := x + w - 16 - 3*sbA
        b := SBrush(FA(Alpha(0xFFFFFF, 20 + 28*sbA), fo))
        FillRR(sx2, ly + 2, sw, lh - 4, sw/2, b), DelB(b)
        thmb := Max(22, (lh - 4)*(lh/tot))
        ty := ly + 2 + (lh - 4 - thmb)*(scr/Max(1, tot - lh))
        b := VBrush(sx2, ty, sw, thmb, FA(Alpha(AccHi(acc, 0.35), 195 + 60*sbA), fo)
                  , FA(Alpha(acc, 175 + 60*sbA), fo))
        FillRR(sx2, ty, sw, thmb, sw/2, b), DelB(b)
    }

    FadeLine(x + 14, x + w - 14, ly + lh + 6, 0x1CFFFFFF, fo)
    FFMBtn(440, x + 14, ly + lh + 14, 74, 24, "CLOSE", acc, fo, 0)
    FFMBtn(439, x + 100, ly + lh + 14, 74, 24, "CLEAR", acc, fo, 3)
    ftx := x + 190, ftw := w - 210
    if FFMCanUndo() {
        FFMBtn(477, x + 186, ly + lh + 14, 74, 24, "UNDO", acc, fo, 2)
        ftx := x + 276, ftw := w - 296
    }
    Txt(FFMLogFoot(), ftx, ly + lh + 16, ftw, 20, fHint, FA(0x5AC7CBE0, fo), fmtL)
    Pop(st)
}

; UPDATE's undo is only offered where its record is - the UPDATES tab - and
; only while the staged set still matches what was captured. FFMUpdateUndo
; checks the same thing before it writes; this is so the button is not there
; to be pressed when it would only report NOTHING TO UNDO.
FFMCanUndo() => (FFM.logTab = 2 && IsObject(FFM.updUndo)
              && FFM.updUndo.Length = FFM.flags.Length)

; whichever tab is showing, drawn by its own routine
FFMLogDrawTab(tab, x, w, ly, lh, t, fo, acc) {
    if (tab = 2)
        FFMLogDrawUpd(x, w, ly, lh, t, fo, acc)
    else if (tab = 3)
        FFMLogDrawHist(x, w, ly, lh, t, fo, acc)
    else
        FFMLogDrawInj(x, w, ly, lh, t, fo, acc)
}

; ---- HISTORY rows ----
; Newest first: when it was taken, what was about to happen, how many flags
; it holds and the first few of them, and RESTORE. Same plate, rail and
; stagger as the UPDATES rows, so the three tabs read as one instrument.
FFMLogDrawHist(x, w, ly, lh, t, fo, acc) {
    if (FFM.hist.Length = 0) {
        Txt("Nothing yet. A snapshot of the staged list is taken before CLEAR, an import,"
          , x + 22, ly + lh/2 - 22, w - 44, 18, HL.fS, FA(0x8AC7CBE0, fo), fmtC)
        Txt("a preset, a community set, PRUNE, UPDATE and a delete - and any one can be put back."
          , x + 22, ly + lh/2 - 4, w - 44, 18, HL.fS, FA(0x66C7CBE0, fo), fmtC)
        return
    }
    rowR := x + w - 32
    bX   := x + w - 116, bW := 74
    nmX  := x + 150
    nmW  := Max(80, bX - 12 - nmX)
    first := Floor(FFM.hsScr/FFM_HSRH) + 1
    visCount := Max(0, Min(FFM_HSROWS + 1, FFM.hist.Length - first + 1))
    loop visCount {
        k   := A_Index
        idx := first + k - 1
        if (idx < 1 || idx > FFM.hist.Length)
            continue
        sn := FFM.hist[idx]
        ry := ly + (idx - 1)*FFM_HSRH - FFM.hsScr
        rowF := fo * Clamp((t - (k - 1)*0.04)/0.6, 0.0, 1.0)
        if (rowF < 0.01)
            continue
        hv := HL.h.Get(619 + k, 0.0)
        mc := (sn.act = "restore") ? 0xFF38BDF8 : (sn.act = "clear" || sn.act = "delete") ? AMBER : C_ON
        b := SBrush(FA(Alpha(mc, Round((34 + 14*hv)*rowF)), fo))
        FillRR(x + 14, ry + 1, w - 46, FFM_HSRH - 3, 5, b), DelB(b)
        b := SBrush(FA(Alpha(mc, Round(215*rowF)), fo))
        FillRR(x + 14, ry + 3, 2.5, FFM_HSRH - 7, 1.2, b), DelB(b)
        Txt(sn.t, x + 22, ry + 1, 52, 14, HL.fS
          , FA(Alpha(0xFFC7CBE0, Round(150*rowF)), fo), fmtL)
        b := SBrush(FA(Alpha(mc, Round(60*rowF)), fo))
        FillRR(x + 78, ry + 3, 66, 12, 3, b), DelB(b)
        Txt("before " sn.act, x + 78, ry + 2, 66, 12, HL.fXs
          , FA(Alpha(mc, Round(245*rowF)), fo), fmtC)
        Txt(sn.flags.Length " flag" (sn.flags.Length = 1 ? "" : "s"), nmX, ry + 1, nmW, 14, HL.fMs
          , FA(Alpha(0xFFE8EAF6, Round(220*rowF)), fo), fmtL)
        names := ""
        for fl in sn.flags {
            names .= (names != "" ? ", " : "") fl["name"]
            if (StrLen(names) > 120)
                break
        }
        Txt(FFMElide(names, HL.fS, nmW), nmX, ry + 15, nmW, 15, HL.fS
          , FA(Alpha(0x9AC7CBE0, Round(220*rowF)), fo), fmtL)
        FFMBtn(619 + k, bX, ry + 4, bW, 24, "RESTORE", acc, rowF, 0)
    }
}

FFMLogFoot() {
    if (FFM.logTab = 3)
        return FFM.hist.Length = 0 ? "no snapshots" : (FFM.hist.Length " snapshot" (FFM.hist.Length = 1 ? "" : "s") "  -  newest first, " FFM_HSMAX " kept")
    if (FFM.logTab != 2)
        return FFM.logs.Length = 0 ? "no entries" : FFM.logs.Length " entries"
    if (FFM.upd.Length = 0)
        return "no update yet - press UPDATE to check these names against the live list"
    rev := 0, ren := 0, skip := 0
    for u in FFM.upd
        (u.kind = "REVIEW") ? rev++ : (u.kind = "SKIPPED") ? skip++ : ren++
    return ren " changed  -  " rev " need review  -  " skip " left alone"
}

; `sel` is 0..1, not a flag: during a switch both chips sit part-selected and
; the fill, the label colour and the label brightness all cross with it. The
; underline is NOT drawn here - one shared bar slides between the two chips in
; FFMLogView, which is the part that reads as a switch.
FFMLogTab(z, bx, by, label, sel, acc, ff) {
    hv := HL.h.Get(z, 0.0)
    a  := Lerp(0.35 + 0.35*hv, 1.0, sel)
    b := SBrush(FA(Alpha(Mix(0xFF8A90A6, acc, sel), Round(Lerp(16 + 14*hv, 34, sel))), ff))
    FillRR(bx, by, FFM_TABW, 22, 6, b), DelB(b)
    Txt(label, bx, by + 4, FFM_TABW, 16, fBadge
      , FA(Alpha(Mix(0xFFC7CBE0, 0xFFE8EAF6, sel), Round(255*a)), ff), fmtC)
}

; ---- INJECTION rows ----
FFMLogDrawInj(x, w, ly, lh, t, fo, acc) {
    COL_INJ := 0xFF38BDF8
    COL_REA := 0xFFA78BFA
    COL_ERR := acc

    ; Column geometry, computed once. The old code used three unrelated
    ; literals: the flag track was (w - 220) wide starting at x + 142, so it
    ; ended at x + w - 78, while the status track started at x + w - 122. That
    ; is a 44px overlap, and it is why a long flag name printed straight through
    ; the status text. The status was also elided to a hard-coded 90px whatever
    ; the panel width, which is why a sentence arrived as three words.
    rowR := x + w - 32                        ; row right edge, clear of the scrollbar
    stW  := Clamp((w - 190)*0.46, 130, 300)
    stX  := rowR - stW
    flX  := x + 142
    flW  := Max(60, stX - flX - 12)           ; 12px gutter, never negative

    first := Floor(FFM.logScr/FFM_LGRH) + 1
    visCount := Max(0, Min(FFM_LGROWS + 1, FFM.logs.Length - first + 1))
    loop visCount {
        k   := A_Index
        idx := first + k - 1
        if (idx < 1 || idx > FFM.logs.Length)
            continue
        entry := FFM.logs[idx]
        ry := ly + (idx - 1)*FFM_LGRH - FFM.logScr

        rowF := fo * Clamp((t - (k - 1)*0.04)/0.6, 0.0, 1.0)
        if (rowF < 0.01)
            continue

        mc := InStr(entry.method, "Re") ? COL_REA : (InStr(entry.status, "FAIL") ? COL_ERR : COL_INJ)

        b := SBrush(FA(Alpha(mc, Round(38*rowF)), fo))
        FillRR(x + 14, ry + 1, w - 46, FFM_LGRH - 3, 4, b), DelB(b)
        b := SBrush(FA(Alpha(mc, Round(200*rowF)), fo))
        FillRR(x + 14, ry + 3, 2.5, FFM_LGRH - 7, 1.2, b), DelB(b)

        Txt(entry.t, x + 22, ry, 52, FFM_LGRH - 2, HL.fS
          , FA(Alpha(0xFFC7CBE0, Round(160*rowF)), fo), fmtL)
        Txt(entry.method, x + 78, ry, 58, FFM_LGRH - 2, HL.fS
          , FA(Alpha(mc, Round(200*rowF)), fo), fmtL)
        Txt(FFMElide(entry.flag, HL.fM, flW), flX, ry, flW, FFM_LGRH - 2, HL.fM
          , FA(Alpha(0xFFE8EAF6, Round(200*rowF)), fo), fmtL)
        sc := InStr(entry.status, "OK") ? C_ON : (InStr(entry.status, "FAIL") ? acc : 0xFFC7CBE0)
        Txt(FFMElide(entry.status, HL.fS, stW), stX, ry, stW, FFM_LGRH - 2, HL.fS
          , FA(Alpha(sc, Round(190*rowF)), fo), fmtR)
    }
}

; ---- UPDATES rows ----
; Two lines per entry. The old name and the new one are both long and differ at
; the tail, which is exactly where a shared single-line track elides - so they
; get a line each and the full width.
FFMLogDrawUpd(x, w, ly, lh, t, fo, acc) {
    if (FFM.upd.Length = 0) {
        Txt("Nothing yet. UPDATE checks every staged flag against the live list"
          , x + 22, ly + lh/2 - 22, w - 44, 18, HL.fS, FA(0x8AC7CBE0, fo), fmtC)
        Txt("and records what it changed, what it left alone, and what it is unsure about."
          , x + 22, ly + lh/2 - 4, w - 44, 18, HL.fS, FA(0x66C7CBE0, fo), fmtC)
        return
    }
    rowR := x + w - 32
    kX   := x + 78, kW := 68
    nmX  := x + 152
    nmW  := Max(80, rowR - nmX - 52)
    scX  := rowR - 46

    first := Floor(FFM.updScr/FFM_UPRH) + 1
    visCount := Max(0, Min(FFM_UPROWS + 1, FFM.upd.Length - first + 1))
    loop visCount {
        k   := A_Index
        idx := first + k - 1
        if (idx < 1 || idx > FFM.upd.Length)
            continue
        u  := FFM.upd[idx]
        ry := ly + (idx - 1)*FFM_UPRH - FFM.updScr

        rowF := fo * Clamp((t - (k - 1)*0.04)/0.6, 0.0, 1.0)
        if (rowF < 0.01)
            continue

        mc := (u.kind = "REVIEW")  ? AMBER
            : (u.kind = "SKIPPED") ? 0xFF8A90A6
            : (u.kind = "PREFIX")  ? 0xFF38BDF8
                                   : C_ON

        b := SBrush(FA(Alpha(mc, Round((u.kind = "REVIEW" ? 52 : 34)*rowF)), fo))
        FillRR(x + 14, ry + 1, w - 46, FFM_UPRH - 3, 5, b), DelB(b)
        b := SBrush(FA(Alpha(mc, Round(215*rowF)), fo))
        FillRR(x + 14, ry + 3, 2.5, FFM_UPRH - 7, 1.2, b), DelB(b)

        ; line 1: time, kind chip, old name
        Txt(u.t, x + 22, ry + 1, 52, 14, HL.fS
          , FA(Alpha(0xFFC7CBE0, Round(150*rowF)), fo), fmtL)
        b := SBrush(FA(Alpha(mc, Round(60*rowF)), fo))
        FillRR(kX, ry + 3, kW, 12, 3, b), DelB(b)
        Txt(u.kind, kX, ry + 2, kW, 12, HL.fXs
          , FA(Alpha(mc, Round(245*rowF)), fo), fmtC)
        Txt(FFMElide(u.old, HL.fMs, nmW + 46), nmX, ry + 1, nmW + 46, 14, HL.fMs
          , FA(Alpha(0xFFC7CBE0, Round(150*rowF)), fo), fmtL)

        ; line 2: the outcome. A rename shows the arrow and the new name; a
        ; refusal shows why, because "SKIPPED" on its own tells you nothing
        ; about whether the flag is dead or merely unresolvable.
        if (u.new != "" && u.kind != "SKIPPED") {
            Txt("→", nmX - 14, ry + 15, 14, 15, HL.fS
              , FA(Alpha(mc, Round(220*rowF)), fo), fmtL)
            Txt(FFMElide(u.new, HL.fM, nmW), nmX, ry + 15, nmW, 15, HL.fM
              , FA(Alpha(0xFFE8EAF6, Round(230*rowF)), fo), fmtL)
            if u.score
                Txt(Round(u.score, 2), scX, ry + 16, 42, 13, HL.fS
                  , FA(Alpha(mc, Round(190*rowF)), fo), fmtR)
        } else {
            Txt(FFMElide(u.note != "" ? u.note : "no match in the live list", HL.fS, nmW + 40)
              , nmX, ry + 15, nmW + 40, 15, HL.fS
              , FA(Alpha(0x9AC7CBE0, Round(230*rowF)), fo), fmtL)
        }
        ; the note is the whole point of a REVIEW row, so it is never dropped
        if (u.kind = "REVIEW" && u.note != "")
            Txt(FFMElide(u.note, HL.fXs, 220), scX - 224, ry + 3, 220, 12, HL.fXs
              , FA(Alpha(AMBER, Round(190*rowF)), fo), fmtR)
    }
}

; ============================================================================
;  CURSOR  -  built-in module 3
;  Replaces the Roblox in-game pointer textures with pictures the user picks.
;  Nothing here touches the Windows pointer: Roblox loads its cursor PNGs out
;  of the version folder when the client starts, so all we do is write over
;  those files - after copying the untouched originals aside exactly once, so
;  RESTORE is always possible.
;
;  Two independent slots:
;    arrow -> ArrowCursor.png, plus ArrowFarCursor.png when FAR CURSOR is on
;    lock  -> MouseLockedCursor.png, the shift lock crosshair
;  A slot with no picture of its own previews whatever Roblox itself would
;  show, read back from the backup (untouched) or the live file.
;
;  Targets are re-resolved on every apply because Roblox lays down a NEW
;  version-* folder on each client update, which is what silently reverts a
;  custom cursor. AUTO RE-APPLY watches for that and rewrites.
; ============================================================================
; The far pointer is opt-in, so it is named separately from the slot table.
global CUR_FAROPT := "ArrowFarCursor.png"
; `prev` is which of a slot's files the PREVIEW reads, when that is not the
; first one. It matters for the arrow: ArrowCursor.png is the near/hover
; pointer Roblox swaps in over something clickable, while ArrowFarCursor.png is
; the plain pointer you actually look at most of the time. Previewing names[1]
; therefore showed the hover cursor and called it the arrow. Both are still
; written - only which one is shown changes.
global CUR_SLOTS  := [{key: "arrow",  label: "ARROW",      names: ["ArrowCursor.png", CUR_FAROPT]
                     , prev: CUR_FAROPT}
                    , {key: "lock",   label: "SHIFT LOCK", names: ["MouseLockedCursor.png"]}
                    ; CrossMouseIcon.png, and it lives in textures\Cursors - NOT in
                    ; textures\Cursors\KeyboardMouse where the arrow pair sits, and not
                    ; loose in textures\ where MouseLockedCursor sits. Three cursor
                    ; directories, one per slot; CurScan probes all three.
                    , {key: "camera", label: "CAMERA",     names: ["CrossMouseIcon.png"]}
                    ; The text caret. Roblox ships it in both textures\ and
                    ; textures\Cursors\KeyboardMouse depending on version;
                    ; CurScan probes all three cursor folders and FileExist
                    ; decides, so it does not matter which one this install has.
                    , {key: "text",   label: "TEXT",       names: ["IBeamCursor.png"]}]

; NB: named CSR, not CUR - identifiers are case-insensitive and `cur` is
; already the overlay's live accent colour (declared at the top of the state
; block). A `CUR` object here silently overwrote it, and the overlay renderer
; then fed an object into Mix().
global CSR := {}
CSR.slot    := []
loop CUR_SLOTS.Length {
    CSR.slot.Push({src: "", bmp: 0, bw: 0, bh: 0, has: 0
                 , dbmp: 0, dbw: 0, dbh: 0, dpath: "`f", pickAt: 0
                 ; where the preview below the tile came from: 2 = a backup we
                 ; took ourselves, 1 = a bloxstrap mod, 0 = whatever is on disk
                 , dsrc: 0})
}
CSR.msg     := "NO IMAGE", CSR.msgCol := 0xFFC7CBE0, CSR.msgAt := 0
CSR.targets := [], CSR.tgtAt := 0, CSR.defAt := -1
CSR.bakN    := 0,  CSR.bakAt := 0
CSR.applied := 0                 ; files written by the last apply
CSR.scr     := 0.0, CSR.scrT := 0.0
CSR.pickPid := 0
CSR.applyAt := 0                 ; sweep across the previews on apply
CSR.farT    := 0.0, CSR.autoT := 0.0
; 1 while CurApply or CurRestore is walking its file loop. The render path reads
; it (see CurSyncDefaults) so it cannot re-open a file mid-write, and the auto
; re-apply timer reads it so it cannot fire into the middle of a restore.
CSR.busy    := 0

global YURI_CURB := YURI_CUR "\backup"
global CUR_SIZE  := 64                                   ; Roblox ships these at 64x64
global CUR_SYSN  := 8
global CURPV     := 68                                   ; preview tile edge
; Both bottom cards sit at HL.ffby and must stop above the hub's footer band -
; the strip along the bottom of the content card that carries the version
; stamp. HubFtrY() is the top of that band; anything taller than
; HubFtrY() - HL.ffby overlaps it. They are SEPARATE constants because the two
; cards carry different content: sharing one was what pushed the CLIENT card
; 34px past its own footer when the CURSOR card grew a third slot.
global CURCH     := 194                                  ; cursor preview card height
global RSETCH    := 192                                  ; client-settings state card height
global curFar    := 1
global curAuto   := 0
; Height of the footer band reserved along the bottom of the content card. The
; version stamp lives in it and nothing else may draw there - every panel that
; runs to the bottom of the card is sized against HubFtrY().
global HUB_FTRH  := 32
global HUB_KBRG  := 30      ; keybind row pitch in the FORSAKEN systems panel
HubFtrY() => HL.pd + HL.ch - HUB_FTRH
try curFar  := Integer(IniRead(iniPath, "cursor", "far",  "1"))
try curAuto := Integer(IniRead(iniPath, "cursor", "auto", "0"))

CurSlotImg(si) => YURI_CUR "\" CUR_SLOTS[si].key ".png"
CurSlotSrc(si) => YURI_CUR "\" CUR_SLOTS[si].key "_src.png"
CurSysTotal()  => CUR_SYSN*HL.ffrg

CurSay(msg, col := 0) {
    CSR.msg := msg
    CSR.msgCol := col ? col : C_ON
    CSR.msgAt := A_TickCount
    HubPoke()
}

; ---------------- target discovery ----------------
; Newest client layout first. Roblox moved the arrow pair under
; Cursors\KeyboardMouse; the shift lock crosshair stayed in content\textures,
; and older clients keep everything in the latter - so both are probed and
; whatever actually exists is used. Bloxstrap's Modifications tree is included
; when Bloxstrap is installed: a file there survives client updates, which the
; version folders do not.
CurScan() {
    out := [], seen := Map()
    lad := ""
    try lad := EnvGet("LOCALAPPDATA")
    if (lad = "")
        return out
    dirs := []
    loop Files, lad "\Roblox\Versions\version-*", "D" {
        dirs.Push({d: A_LoopFileFullPath "\content\textures\Cursors\KeyboardMouse", mk: 0, only: 0})
        ; the camera-toggle crosshair sits one level up from KeyboardMouse, in
        ; Cursors itself - without this entry CrossMouseIcon.png is invisible to
        ; the scan no matter how the slot is named
        dirs.Push({d: A_LoopFileFullPath "\content\textures\Cursors", mk: 0, only: 0})
        dirs.Push({d: A_LoopFileFullPath "\content\textures", mk: 0, only: 0})
    }
    ; ---- the strappers ----
    ; Bloxstrap, Fishstrap and Voidstrap all install the client in a Versions
    ; tree of their own (since 2.5 or so), and all three carry a Modifications
    ; store the launcher lays over the client at every start. Only Bloxstrap
    ; was known here, and only its store: a player on Fishstrap had the files
    ; sitting in Fishstrap\Versions\version-*\content and this scan never
    ; looked, so there was nothing to write and the panel said so.
    for lc in ["Bloxstrap", "Fishstrap", "Voidstrap"] {
        if !DirExist(lad "\" lc)
            continue
        loop Files, lad "\" lc "\Versions\version-*", "D" {
            if !FileExist(A_LoopFileFullPath "\RobloxPlayerBeta.exe")
                continue
            dirs.Push({d: A_LoopFileFullPath "\content\textures\Cursors\KeyboardMouse", mk: 0, only: 0})
            dirs.Push({d: A_LoopFileFullPath "\content\textures\Cursors", mk: 0, only: 0})
            dirs.Push({d: A_LoopFileFullPath "\content\textures", mk: 0, only: 0})
        }
        ; we create these, so only make the folder each file truly belongs in.
        ; only: 0 here would scatter a copy of every slot through all three
        ; folders and the launcher would apply mods Roblox never reads.
        md := lad "\" lc "\Modifications\content\textures"
        dirs.Push({d: md "\Cursors\KeyboardMouse", mk: 1, only: 1})
        ; second pass over the same folder for slot 4 - `only` is one index, and
        ; the I-beam belongs beside the arrow pair rather than in its own place
        dirs.Push({d: md "\Cursors\KeyboardMouse", mk: 1, only: 4})
        dirs.Push({d: md "\Cursors", mk: 1, only: 3})
        dirs.Push({d: md, mk: 1, only: 2})
    }
    ; ---- and wherever a client is actually running from ----
    ; a custom install, or a launcher this list does not know
    for pid in FFMProcList() {
        exe := ""
        try exe := ProcessGetPath(pid)
        if (exe = "")
            continue
        SplitPath(exe, , &vdir)
        dirs.Push({d: vdir "\content\textures\Cursors\KeyboardMouse", mk: 0, only: 0})
        dirs.Push({d: vdir "\content\textures\Cursors", mk: 0, only: 0})
        dirs.Push({d: vdir "\content\textures", mk: 0, only: 0})
    }
    for e in dirs {
        for si, sl in CUR_SLOTS {
            if (e.only && e.only != si)
                continue
            for fn in sl.names {
                pth := e.d "\" fn
                k := StrLower(pth)
                if seen.Has(k)
                    continue
                if (!e.mk && !FileExist(pth))
                    continue
                seen[k] := 1
                out.Push({path: pth, dir: e.d, name: fn, slot: si, mk: e.mk})
            }
        }
    }
    return out
}

; Cached: the scan walks the disk, and the panel asks for this every frame.
CurTargets(force := false) {
    if (force || !CSR.tgtAt || A_TickCount - CSR.tgtAt > 4000) {
        CSR.targets := CurScan()
        CSR.tgtAt := A_TickCount
    }
    return CSR.targets
}

; A target counts only when FAR CURSOR allows it and its slot has an image -
; a slot with nothing staged has nothing to write.
CurWritable(t) {
    if (!curFar && t.name = CUR_FAROPT)
        return false
    return CSR.slot[t.slot].has > 0
}

CurActive() {
    out := []
    for t in CurTargets() {
        if CurWritable(t)
            out.Push(t)
    }
    return out
}

; the same count without building a list - the render path needs it per frame
CurActiveN() {
    n := 0
    for t in CurTargets() {
        if CurWritable(t)
            n++
    }
    return n
}

; every cursor file we can see, regardless of what is staged
CurFoundN() {
    n := 0
    for t in CurTargets() {
        if (!curFar && t.name = CUR_FAROPT)
            continue
        n++
    }
    return n
}

; FNV-1a over the full path: backups live in one flat folder, and mirroring the
; real path there blows past MAX_PATH on any normal Roblox install.
CurKey(s) {
    h := 2166136261
    loop Parse, StrLower(s)
        h := ((h ^ Ord(A_LoopField))*16777619) & 0xFFFFFFFF
    return Format("{:08X}", h)
}
CurBakPath(t) => YURI_CURB "\" CurKey(t.path) "_" t.name

; Cached like CurTargets - the panel asks for this every frame and it walks
; the backup folder on disk.
CurBakCount(force := false) {
    if (force || !CSR.bakAt || A_TickCount - CSR.bakAt > 4000) {
        n := 0
        loop Files, YURI_CURB "\*.png"
            n++
        CSR.bakN := n, CSR.bakAt := A_TickCount
    }
    return CSR.bakN
}

; ---------------- stock cursor preview ----------------
; What Roblox itself would show for a slot. A backup, where we have one, is the
; untouched original; the live file may already be ours, and Bloxstrap mod
; entries always are, so those are skipped.
; A backup is the file Roblox shipped - we copied it aside before overwriting
; anything, so it is genuinely the default. The live file is only a GUESS at
; the default, and on a machine that has ever used Bloxstrap it is often wrong:
; Modifications re-applies its mods into every new version folder on launch, so
; the file sitting there is somebody else's image and we never had a chance to
; back it up. Labelling that "roblox default" is simply false, so the source is
; recorded and the caption says which it is.
CurPrevName(si) {
    sl := CUR_SLOTS[si]
    return sl.HasOwnProp("prev") ? sl.prev : sl.names[1]
}
CurDefaultPath(si) {
    prim := CurPrevName(si)
    live := "", mod := ""
    CSR.slot[si].dsrc := 0
    for t in CurTargets() {
        if (t.slot != si || t.name != prim)
            continue
        if t.mk {
            ; a Modifications entry that EXISTS is a mod already in place
            if (mod = "" && FileExist(t.path))
                mod := t.path
            continue
        }
        bak := CurBakPath(t)
        if FileExist(bak) {
            CSR.slot[si].dsrc := 2
            return bak
        }
        if (live = "" && FileExist(t.path))
            live := t.path
    }
    if (mod != "") {
        CSR.slot[si].dsrc := 1
        return mod
    }
    return live
}

; ---- load a preview WITHOUT keeping the file open ----
; GdipCreateBitmapFromFile holds its source open for the lifetime of the bitmap.
; For every other image in this suite that is harmless; here it is not, because
; these previews are read from the exact files RESTORE has to delete - a
; Bloxstrap Modifications override, or a backup we took ourselves. The module
; was locking its own targets, so the delete failed, the restore reported an
; error, and it took a second press to get through.
;
; Reading the bytes first and decoding from a memory stream leaves no file
; handle at all, so nothing this module previews can ever block what it writes.
; Same shape as BitmapFromB64, which already does this for the embedded art; the
; buffer is kept alive by the stream, and both are a 64x64 PNG.
CurBitmapFromFile(pth) {
    if (pth = "" || !FileExist(pth))
        return 0
    buf := 0
    try {
        f := FileOpen(pth, "r")
        if !f
            return 0
        n := f.Length
        ; A cursor PNG is a few KB. Anything wildly larger is not one, and there
        ; is no reason to pull it into memory to find that out.
        if (n <= 0 || n > 8388608) {
            f.Close()
            return 0
        }
        buf := Buffer(n)
        f.RawRead(buf, n)
        f.Close()
    } catch
        return 0
    strm := DllCall("shlwapi\SHCreateMemStream", "ptr", buf, "uint", buf.Size, "ptr")
    if !strm
        return 0
    DllCall("gdiplus\GdipCreateBitmapFromStream", "ptr", strm, "ptr*", &bmp := 0)
    ObjRelease(strm)
    return bmp
}

CurSyncDefault(si) {
    s := CSR.slot[si]
    p := CurDefaultPath(si)
    if (p = s.dpath)
        return
    s.dpath := p
    if s.dbmp {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", s.dbmp)
        s.dbmp := 0
    }
    s.dbw := 0, s.dbh := 0
    if (p = "")
        return
    if (b := CurBitmapFromFile(p)) {
        s.dbmp := b
        DllCall("gdiplus\GdipGetImageWidth",  "ptr", b, "uint*", &w := 0)
        DllCall("gdiplus\GdipGetImageHeight", "ptr", b, "uint*", &h := 0)
        s.dbw := w, s.dbh := h
    }
}

; Only re-resolves when the target list itself changed, so the per-frame cost
; is one integer compare rather than a scan plus a decode.
;
; ---- and never while a file operation is in flight ----
; This runs from CurPreview, which is on the RENDER path, and CurApply /
; CurRestore run from a click and take far longer than AutoHotkey's 15 ms
; thread-interrupt threshold. So the renderer lands in the middle of their file
; loops as a matter of routine - and re-resolving there re-opens, through
; GdipCreateBitmapFromFile, the very files those loops are about to copy over or
; delete. GDI+ holds a bitmap's source file open for the bitmap's lifetime, so
; the next FileDelete or FileCopy fails on a lock this module took itself.
;
; That is the "sometimes it needs two restores" bug: the first restore copied
; the backup back, failed to delete it, counted the whole file as an error, and
; therefore skipped clearing the staged slots - so every preview carried on
; showing a cursor that was no longer installed. The second restore found the
; bitmaps released and went through. Whether it happened at all came down to
; whether a frame landed inside the window, which is why it looked random.
;
; A forced call still runs: CurApply and CurRestore both end with
; CurSyncDefaults(true), after their files are settled and busy is clear.
CurSyncDefaults(force := false) {
    if (CSR.busy && !force)
        return
    if force
        CSR.defAt := -1
    CurTargets()
    if (CSR.defAt = CSR.tgtAt)
        return
    CSR.defAt := CSR.tgtAt
    loop CUR_SLOTS.Length
        CurSyncDefault(A_Index)
}

; ---------------- image ----------------
; Decode, fit into CUR_SIZE with the aspect preserved and transparent padding,
; then write both the working copy Roblox gets and a full-res preview.
CurSetImage(si, path) {
    if (si < 1 || si > CUR_SLOTS.Length)
        return
    if (path = "" || !FileExist(path)) {
        CurSay("FILE NOT FOUND", C_OFF)
        return
    }
    ; Through memory like the previews. s.bmp keeps this bitmap for the lifetime
    ; of the slot, and loading it from the file directly meant the picture the
    ; user browsed to stayed locked until they cleared the slot or closed YURI -
    ; they could not move or delete their own file.
    if !(src := CurBitmapFromFile(path)) {
        CurSay("NOT A READABLE IMAGE", C_OFF)
        return
    }
    DllCall("gdiplus\GdipGetImageWidth",  "ptr", src, "uint*", &w := 0)
    DllCall("gdiplus\GdipGetImageHeight", "ptr", src, "uint*", &h := 0)
    if (!w || !h) {
        DllCall("gdiplus\GdipDisposeImage", "ptr", src)
        CurSay("EMPTY IMAGE", C_OFF)
        return
    }
    CurEnsureDirs()

    sc := Min(CUR_SIZE/w, CUR_SIZE/h)
    dw := Max(1, Round(w*sc)), dh := Max(1, Round(h*sc))
    ox := (CUR_SIZE - dw)/2, oy := (CUR_SIZE - dh)/2
    DllCall("gdiplus\GdipCreateBitmapFromScan0", "int", CUR_SIZE, "int", CUR_SIZE
        , "int", 0, "int", 0xE200B, "ptr", 0, "ptr*", &nb := 0)
    if !nb {
        DllCall("gdiplus\GdipDisposeImage", "ptr", src)
        CurSay("OUT OF MEMORY", C_OFF)
        return
    }
    DllCall("gdiplus\GdipGetImageGraphicsContext", "ptr", nb, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", g2, "int", 2)
    DllCall("gdiplus\GdipDrawImageRectRect", "ptr", g2, "ptr", src
        , "float", ox, "float", oy, "float", dw, "float", dh
        , "float", 0, "float", 0, "float", w, "float", h
        , "int", 2, "ptr", 0, "ptr", 0, "ptr", 0)
    DllCall("gdiplus\GdipDeleteGraphics", "ptr", g2)

    ; Release the slot's PREVIOUS image before writing the working copies. That
    ; bitmap was loaded from this very _src.png at boot, and GDI+ keeps the file
    ; open for its lifetime - so the save below failed on a lock we held, the
    ; on-disk copy kept the OLD picture, and the slot reverted to it the next
    ; time YURI started even though the preview looked right.
    s := CSR.slot[si]
    if s.bmp {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", s.bmp)
        s.bmp := 0
    }
    SaveAvatarPng(nb, CurSlotImg(si))
    SaveAvatarPng(src, CurSlotSrc(si))
    DllCall("gdiplus\GdipDisposeImage", "ptr", nb)

    s.bmp := src, s.bw := w, s.bh := h
    s.src := path
    s.has := FileExist(CurSlotImg(si)) ? 1 : 0
    s.pickAt := A_TickCount
    CSR.applied := 0, CSR.applyAt := 0
    try IniWrite(path, iniPath, "cursor", CUR_SLOTS[si].key)
    if !s.has {
        CurSay("COULD NOT WRITE THE WORKING COPY", C_OFF)
        return
    }
    CurSay(CUR_SLOTS[si].label " READY  " w "x" h " -> " CUR_SIZE "x" CUR_SIZE, C_ON)
}

; Drop a slot's staged pick and everything that would bring it back: the live
; bitmap, both working copies on disk, and the INI entry CurBoot reads. With
; those gone CurTile finds no `own` image and falls through to the default it
; reads from the game files, which is what the preview should show once Roblox
; has been put back the way it was.
CurClearSlot(si) {
    if (si < 1 || si > CUR_SLOTS.Length)
        return 0
    s := CSR.slot[si]
    if s.bmp {
        try DllCall("gdiplus\GdipDisposeImage", "ptr", s.bmp)
        s.bmp := 0
    }
    s.bw := 0, s.bh := 0, s.src := "", s.has := 0, s.pickAt := 0
    ; Retry, and do not swallow the outcome. CurBoot rebuilds a slot from these
    ; two files - `has` from the working copy, the bitmap from the _src copy - so
    ; a delete that quietly failed here brought the cleared cursor back the next
    ; time YURI started, with nothing anywhere to say why. GDI+ held _src.png
    ; open through s.bmp until the dispose above, and a scanner or a stray
    ; handle can hold either for a moment longer.
    okImg := CurTryDelete(CurSlotImg(si))
    okSrc := CurTryDelete(CurSlotSrc(si))
    try IniDelete(iniPath, "cursor", CUR_SLOTS[si].key)
    if (!okImg || !okSrc) {
        ; The INI entry is gone either way, so the pick will not be restaged from
        ; settings - but the working copy on disk would still be found by
        ; CurBoot, so say so rather than leave it to surprise them later.
        CurSay(CUR_SLOTS[si].label " CLEARED, BUT ITS WORKING COPY IS LOCKED", AMBER)
        return 0
    }
    return 1
}

CurEnsureDirs() {
    if !DirExist(YURI_CUR)
        try DirCreate(YURI_CUR)
    if !DirExist(YURI_CURB)
        try DirCreate(YURI_CURB)
}

CurPick(si) {
    if (CSR.pickPid && ProcessExist(CSR.pickPid))
        return
    cmd := A_IsCompiled ? '"' A_ScriptFullPath '" curpick ' ui.Hwnd ' ' si
                        : '"' A_AhkPath '" "' A_ScriptFullPath '" curpick ' ui.Hwnd ' ' si
    pid := 0
    try Run(cmd, , , &pid)
    HubPickWatch(pid)   ; raise the hub again when the dialog closes
    CSR.pickPid := pid
}

CurOpenFolder() {
    CurEnsureDirs()
    try Run('explorer.exe "' YURI_CUR '"')
    CurSay("OPENED THE CURSOR FOLDER", 0)
}

; ---------------- write / restore ----------------
CurApply(silent := false) {
    staged := 0
    loop CUR_SLOTS.Length
        staged += CSR.slot[A_Index].has ? 1 : 0
    if !staged {
        if !silent
            CurSay("PICK AN IMAGE FIRST", AMBER)
        return 0
    }
    tg := CurActive()
    if !tg.Length {
        if !silent
            CurSay("NO MATCHING ROBLOX CURSOR FILES FOUND", C_OFF)
        return 0
    }
    CurEnsureDirs()
    ; Before the first apply there is no backup yet, so the default previews are
    ; read from the LIVE files - the very files about to be overwritten. GDI+
    ; holds those open, so the copy below would fail on our own lock and report
    ; it as "close roblox". Drop them; CurSyncDefaults rebuilds at the end.
    ;
    ; Dropping them once was not enough. CurPreview re-resolves on the RENDER
    ; path, this loop runs far longer than AutoHotkey's 15 ms interrupt
    ; threshold, and a frame landing inside it re-opened the destination and
    ; brought the lock straight back - which is the same defect that made a
    ; restore need two goes. CSR.busy holds the renderer off for the duration.
    if CSR.busy
        return 0
    ; busy FIRST, then drop. Two statements sit under the interrupt threshold in
    ; practice, but ordering it the other way leaves a window in which a frame
    ; could re-open exactly what was just released, and there is no reason to
    ; leave one open.
    CSR.busy := 1
    CurDropDefaults()
    ok := 0, bad := 0
    try {
        for t in tg {
            if (t.mk && !DirExist(t.dir))
                try DirCreate(t.dir)
            bak := CurBakPath(t)
            ; capture the untouched original exactly once per file, never again -
            ; a second capture would back up our own cursor and strand the default
            if (!FileExist(bak) && FileExist(t.path))
                try FileCopy(t.path, bak, 0)
            try {
                FileCopy(CurSlotImg(t.slot), t.path, 1)
                ok++
            } catch {
                bad++
            }
        }
    } finally {
        CSR.busy := 0
    }
    CSR.applied := ok
    CSR.applyAt := A_TickCount
    CurTargets(true), CurBakCount(true), CurSyncDefaults(true)
    if !silent {
        rbx := ProcessExist("RobloxPlayerBeta.exe") ? "  -  RESTART ROBLOX" : ""
        if (ok && !bad)
            CurSay("APPLIED TO " ok " FILE(S)" rbx, C_ON)
        else if ok
            CurSay("APPLIED " ok ", " bad " LOCKED - CLOSE ROBLOX", AMBER)
        else
            CurSay("WRITE FAILED - CLOSE ROBLOX OR RUN AS ADMIN", C_OFF)
    }
    HubPoke()
    return ok
}

; Release every default-preview bitmap. GDI+ keeps the source file OPEN for the
; lifetime of the bitmap, and CurDefaultPath deliberately reads the BACKUP once
; one exists - so after an APPLY the module was holding its own backup files
; open. FileDelete on them then failed, the restore counted that as an error,
; and the previews were left showing cursors that were no longer installed.
; Callers rebuild these with CurSyncDefaults(true) once the files are settled.
CurDropDefaults() {
    loop CUR_SLOTS.Length {
        s := CSR.slot[A_Index]
        if s.dbmp {
            try DllCall("gdiplus\GdipDisposeImage", "ptr", s.dbmp)
            s.dbmp := 0
        }
        s.dbw := 0, s.dbh := 0, s.dpath := "`f"
    }
    CSR.defAt := -1
}

; Remove a file we no longer need, with a couple of retries. The busy flag stops
; the renderer re-opening it, but Roblox or a virus scanner can hold a handle for
; a moment of their own, and a backup left on disk is not worth failing a
; restore over.
CurTryDelete(pth) {
    loop 3 {
        try {
            FileDelete(pth)
            return true
        }
        if !FileExist(pth)
            return true
        Sleep(40)
    }
    return !FileExist(pth)
}

CurRestore() {
    if CSR.busy
        return                                   ; already running - a second
                                                 ; click must not interleave
    CSR.busy := 1                                ; before the drop - see CurApply
    CurDropDefaults()                            ; stop holding the backups open
    n := 0, bad := 0, rm := 0, stale := 0
    ; Counted so a run that changes nothing can say WHY. "No backups" is true
    ; of a machine with no Roblox install, of one where every original is
    ; already back, and of one where something else replaced the files before
    ; we ever saw them - three completely different situations that used to
    ; produce the same dead-end message.
    seen := 0, mkSeen := 0
    ; Failures per SLOT, not one flag for the whole run. A single locked file
    ; used to block the staged pick being cleared on every OTHER slot too, so
    ; three previews kept showing cursors that had just been put back.
    slotBad := Map()
    try {
        for t in CurTargets(true) {
            seen++
            if t.mk
                mkSeen++
            bak := CurBakPath(t)
            if !FileExist(bak) {
                ; A Bloxstrap Modifications file with no backup is one WE created -
                ; there was no original to save. Reverting has to remove it, or
                ; Bloxstrap keeps overriding the client with our cursor forever.
                if (t.mk && FileExist(t.path)) {
                    if CurTryDelete(t.path)
                        rm++
                    else
                        bad++, slotBad[t.slot] := 1
                }
                continue
            }
            ; ---- the copy is the restore; the backup cleanup is housekeeping ----
            ; These were one try block, so a backup that could not be deleted
            ; discarded a file that had ALREADY been put back: n went uncounted,
            ; bad went up, and the run reported failure over a leftover file.
            done := false
            try {
                FileCopy(bak, t.path, 1)
                done := true
            } catch
                bad++, slotBad[t.slot] := 1
            if !done
                continue
            n++
            if !CurTryDelete(bak)
                stale++                          ; harmless: it is still the original
        }
    } finally {
        CSR.busy := 0
    }
    CSR.applied := 0, CSR.applyAt := 0
    ; RESTORE puts Roblox back the way it was, so the module has to look that
    ; way too. Without this the staged picks survive and every preview keeps
    ; showing a cursor that is no longer installed. Done per slot: a slot whose
    ; files all went back is cleared even if some other slot is still locked.
    loop CUR_SLOTS.Length {
        if !slotBad.Has(A_Index)
            CurClearSlot(A_Index)
    }
    CurBakCount(true), CurSyncDefaults(true)
    if (n || rm) {
        rbx := ProcessExist("RobloxPlayerBeta.exe") ? "  -  RESTART ROBLOX" : ""
        msg := n ? ("RESTORED " n " FILE(S)") : ""
        if rm
            msg .= (msg = "" ? "" : "  -  ") "REMOVED " rm " OVERRIDE(S)"
        if bad
            msg .= "  -  " bad " LOCKED"
        if stale
            msg .= "  -  " stale " BACKUP(S) COULD NOT BE REMOVED"
        CurSay(msg rbx, (bad || stale) ? AMBER : C_ON)
    } else if bad
        CurSay("RESTORE FAILED - CLOSE ROBLOX OR RUN AS ADMIN", C_OFF)
    else if !seen
        CurSay("NOTHING TO RESTORE - NO CURSOR FILES FOUND", AMBER)
    else
        ; Nothing was ours to put back. Either it already is back, or the
        ; files were replaced by something other than this hub - a Bloxstrap
        ; mod or a manual swap - in which case there is no original here to
        ; return to and Roblox itself has to supply it.
        CurSay("NOTHING OF OURS TO RESTORE - " seen " FILE(S) CHECKED"
             . (mkSeen ? (", " mkSeen " MOD SLOT(S)") : "")
             . "  -  ANY CUSTOM CURSOR LEFT IS NOT ONE WE APPLIED", AMBER)
    HubPoke()
}

CurManageAuto() {
    SetTimer(CurAutoTick, curAuto ? 15000 : 0)
}

; Roblox lays down a fresh version-* folder on every client update, and the old
; one keeps the modified cursor while the new one ships the stock file. Detect
; the new folder and write into it.
CurAutoTick() {
    if !curAuto
        return
    ; A timer can interrupt a running thread, and this one calls CurApply. Firing
    ; it into the middle of a RESTORE would put the cursors back seconds after
    ; the user asked for them to be removed - and the restore would already have
    ; cleared the staged slots, so the panel would disagree with the disk.
    if CSR.busy
        return
    staged := 0
    loop CUR_SLOTS.Length
        staged += CSR.slot[A_Index].has ? 1 : 0
    if !staged
        return
    before := Map()
    for t in CSR.targets
        before[StrLower(t.path)] := 1
    fresh := 0
    for t in CurTargets(true) {
        if !before.Has(StrLower(t.path))
            fresh++
    }
    ; an empty "before" means we simply had not scanned yet, not an update
    if (!fresh || !before.Count)
        return
    if CurApply(true)
        CurSay("AUTO RE-APPLIED TO A NEW ROBLOX BUILD", C_ON)
}

CurBoot() {
    CurEnsureDirs()
    loop CUR_SLOTS.Length {
        si := A_Index
        s := CSR.slot[si]
        try s.src := IniRead(iniPath, "cursor", CUR_SLOTS[si].key, "")
        s.has := FileExist(CurSlotImg(si)) ? 1 : 0
        p := CurSlotSrc(si)
        if !FileExist(p)
            continue
        ; Through memory as well: CurClearSlot deletes this very file, and a
        ; handle held here is what let a cleared slot come back on next launch.
        if (b := CurBitmapFromFile(p)) {
            s.bmp := b
            DllCall("gdiplus\GdipGetImageWidth",  "ptr", b, "uint*", &w := 0)
            DllCall("gdiplus\GdipGetImageHeight", "ptr", b, "uint*", &h := 0)
            s.bw := w, s.bh := h
        }
    }
    any := 0
    loop CUR_SLOTS.Length
        any += CSR.slot[A_Index].has ? 1 : 0
    CSR.msg := any ? (any " OF 4 IMAGE(S) LOADED") : "NO IMAGE"
    CSR.msgCol := any ? C_ON : 0xFFC7CBE0
    CurTargets(true)                 ; prime, so CurAutoTick has a baseline
    CurSyncDefaults(true)
    CurManageAuto()
}

; ---------------- CURSOR: hit zones ----------------
; Rebased onto its own block. The old map grew organically into the 800s and a
; fourth image slot broke it in two places at once: an eighth row body wanted
; 808, which was OPEN FOLDER, and a sixth row button wanted 816, which was the
; shift-lock tile. Rather than shuffle three more numbers into the gaps, the
; module now owns a contiguous range with room left in it:
;   1111..1118  row bodies        (CUR_SYSN rows, the half that explains)
;   1131..1136  row buttons       (rows 1-6: four BROWSE, APPLY, RESTORE)
;   1137..1138  row toggles       (rows 7-8: FAR CURSOR, AUTO RE-APPLY)
;   1141..1144  preview tiles     (one per image slot)
;   1150        OPEN FOLDER
;   1151        inert card background - keeps the card from being click-through
;   1152        preview scrollbar
CurTileZone(si) => 1140 + si
CurZone(ux, uy) {
    ax := HL.abx, ay := HL.aby
    if (CurSysTotal() > HL.ffh - 20
        && ux >= ax + HL.abw - 12 && ux <= ax + HL.abw
        && uy >= ay + 10 && uy <= ay + HL.ffh - 10)
        return 1152
    if (uy >= ay + 6 && uy <= ay + HL.ffh - 6 && ux >= ax && ux <= ax + HL.abw) {
        loop CUR_SYSN {
            i := A_Index
            ry := ay + 12 + (i - 1)*HL.ffrg - CSR.scr
            if (uy >= ry && uy <= ry + 36) {
                if (i <= CUR_SYSN - 2 && ux >= ax + HL.abw - 108 && ux <= ax + HL.abw - 16)
                    return 1130 + i              ; BROWSE / APPLY / RESTORE
                if (i > CUR_SYSN - 2 && ux >= ax + HL.abw - 64 && ux <= ax + HL.abw - 16)
                    return 1130 + i              ; FAR / AUTO switch
                return 1110 + i                  ; the row explains
            }
        }
    }
    px := ax, py := HL.ffby, pw := HL.abw
    if (ux >= px && ux <= px + pw && uy >= py && uy <= py + CURCH) {
        ; OPEN FOLDER sits on the header line, above the tiles - tested first
        if (ux >= px + pw - 108 && ux <= px + pw - 16 && uy >= py + 6 && uy <= py + 28)
            return 1150
        if (uy >= py + 32 && uy <= py + 32 + CURPV) {
            loop CUR_SLOTS.Length {
                si := A_Index
                tx := px + 14 + (si - 1)*(CURPV + 10)
                if (ux >= tx && ux <= tx + CURPV)
                    return CurTileZone(si)
            }
        }
        return 1151
    }
    return 0
}

; Row-body ids (801-806) and button ids (811-814) used to run the same action,
; so the whole row was a second copy of the button. The button keeps the action;
; the body opens the detail sheet, which is the only place the full description
; fits. 809 and 816 are the two preview tiles and still pick a file directly -
; clicking the picture of a cursor to replace it is the obvious reading.
; The long-form text for each cursor row. Kept beside the rows it describes
; rather than inside the sheet, so a row and its explanation stay together.
; ---- detail text ----
; One sheet, four tables. Each row's long-form text lives beside the module it
; belongs to conceptually, but they are gathered here so the wiring is in one
; place and a new row is one array entry rather than a new code path.
FFMDetail(i) {
    ttl := ["INJECT LIVE", "SINGLETON", "RE-APPLY", "AUTO INJECT", "CLEAN", "UPDATE FLAGS"
          , "INSERT HITBOX", "INSERT 30HZ HITBOX", "COMMUNITY FLAGS"]
    hnt := ["write flags into Roblox memory"
          , "find the flag table by code signature"
          , "re-inject every 2 s to hold flags"
          , "inject 4 s after Roblox is detected"
          , "export your flags without the failed ones"
          , "rename outdated flags to their current names"
          , "replace the staged set with HITBOX"
          , "replace the staged set with 30HZ HITBOX"
          , "browse flag sets shared by other players"]
    b1 := "Walks the running client's memory, finds the flag table by hashing "
        . "each name, and writes your staged values straight into it. Nothing "
        . "is written to disk, so a flag set this way lasts until the client "
        . "closes. Flags the client does not carry are reported as failed "
        . "rather than silently dropped."
    b2 := "Chooses how the flag table is FOUND - injection works either way. "
        . "On, it matches a code signature that references the table: fast, and "
        . "the right default. Off, it sweeps the client's data for a structure "
        . "that reads like the table and proves it by reading real flag names "
        . "out of it - slower, but it survives a Roblox update that moved the "
        . "code. Turn it off if injection starts failing after an update."
    b3 := "Roblox rewrites some flags back to their defaults while you play. "
        . "This re-injects the whole staged set every two seconds so those "
        . "values stay where you put them. Costs a little CPU for as long as "
        . "it is on."
    b4 := "Waits four seconds after the client appears, then injects on its "
        . "own. The delay is deliberate - injecting before the flag table is "
        . "built is what produces a run of failures."
    b5 := "Drops every flag the last injection could not find, leaving a set "
        . "that this client actually accepts. Useful before exporting: it is "
        . "the difference between a set that works and one full of names from "
        . "an older version."
    b6 := "Fetches the current live flag list and renames any staged flag "
        . "whose name Roblox has retired to its closest current name. "
        . "Non-destructive: valid names are left alone and names with no match "
        . "are kept as-is. Pairs with CLEAN, which drops the ones that failed."
    b7 := "Replaces the staged set with the built-in HITBOX preset - a "
        . "replication and input group aimed at making hits register closer to "
        . "what you see. Replaces, not merges: whatever is staged now is gone."
    b8 := "The same idea tuned around interpolation and a lower effective "
        . "replication rate. It shares most of its entries with HITBOX and "
        . "adds the interpolation group. Also replaces the staged set."
    b9 := "Opens the community browser. Nothing is published yet, so this is "
        . "the frame and an empty shelf - sets shared by other players will "
        . "appear here once publishing opens."
    bdy := [b1, b2, b3, b4, b5, b6, b7, b8, b9]
    if (i < 1 || i > bdy.Length)
        return
    DetailOpen(ttl[i], hnt[i], bdy[i], "FAST FLAGS")
}
SPFDetail(i) {
    ttl := ["DISCORD ACTIVITY", "SHOW SERVER REGION", "AUTO-REGION FINDER"
          , "BETTER MATCHMAKING", "MULTI-ROBLOX INSTANCES", "FPS BOOST"]
    hnt := ["show the roblox game you are in on your discord profile"
          , "show which region your current server is hosted in"
          , "rejoin until you land on a server in your own region"
          , "picks a server this session already measured as close to you"
          , "run more than one roblox client at once, on different accounts"
          , "more frames without changing a single graphics setting"]
    b1 := "Publishes what you are playing to Discord over its local pipe - the "
        . "game's name, its icon, how long you have been in, and a link to the "
        . "game page. The three chips on this row add your Roblox account, a "
        . "join link to this exact server, and whether Roblox is the window "
        . "you are actually looking at."
    b2 := "Reads the server's address out of the client log and looks up where "
        . "it is hosted, then shows the region and how far away it is. The "
        . "lookup runs in a separate process, so a slow reply never stalls the "
        . "interface."
    b3 := "After a join it checks the distance, and if the server is too far "
        . "it closes the client and rejoins - up to fifteen times, asking for "
        . "a different instance each go. It stops the moment it lands close "
        . "enough. This is the one that restarts Roblox on you; JOIN only "
        . "rerolls while it is on."
    b4 := "Experimental, and it never rejoins anybody. Every join teaches it "
        . "the distance of one specific server of one specific place; a later "
        . "join then asks for a server it already measured as close instead of "
        . "letting the matchmaker draw blind. It cannot help on a first visit, "
        . "and it improves the odds rather than guaranteeing anything."
    b5 := "Roblox allows one client per machine by holding a named system "
        . "object; a second launch finds it, hands the join to the client "
        . "already running and quits. With this on, YURI holds that object "
        . "instead, so no client owns it and every launch starts its own. "
        . "Turn it on BEFORE launching the clients you want.  "
        . "LAUNCH THEM FROM THE WEBSITE, not from the desktop or Start Menu "
        . "shortcut. The client has no login screen of its own - it is handed "
        . "a one-time ticket by the browser at launch, and starting the "
        . "executable directly gives it no ticket, which is why a shortcut "
        . "launch opens a logged-out client that can do nothing. So: sign in "
        . "as the first account, press Play on any game, then sign in as the "
        . "second account and press Play again. Each client keeps the account "
        . "whose ticket started it, so signing out afterwards is fine.  "
        . "A client that was ALREADY RUNNING when you turned this on is not "
        . "covered by it - its singleton was resolved when it launched, and "
        . "this only changes what happens to launches after it. The row shows "
        . "a RESTART ROBLOX mark whenever that is the case, and says how many "
        . "clients it applies to: close those and start them again from the "
        . "website. The mark goes as soon as nothing older than the switch is "
        . "left running.  "
        . "Switching this off releases the object; clients already open are "
        . "unaffected. Two things worth knowing - Roblox works against this "
        . "deliberately and its anti-cheat may close or crash the extra "
        . "clients, and the fast flag manager attaches to one client at a "
        . "time, so flags land in whichever it picked up rather than in all."
    b6 := "Raises the frame rate by getting Windows out of the client's way, "
        . "and by changing nothing else. No fast flag is written, no client "
        . "file is edited, and nothing under CLIENT SETTINGS is read or "
        . "altered - your graphics quality, texture detail, lighting and "
        . "framerate cap are exactly where you left them. What it changes is "
        . "how the operating system treats the process:  "
        . "The client is raised in priority so its render and scheduler threads "
        . "stop giving up their slice to background work. How far it is raised "
        . "depends on how many logical processors you have, and that is "
        . "deliberate: the compositor, the audio graph and csrss all run at "
        . "High, and on a machine without room to spare a client at High can "
        . "crowd them out. Starving the compositor does not make frames appear "
        . "- it makes them arrive late and unevenly, which plays worse than a "
        . "lower average. So High only where there is headroom for it, and "
        . "Above Normal below that, which still outranks every piece of "
        . "ordinary background work on the machine. Never Realtime.  "
        . "Windows power throttling is switched off for the client you are "
        . "actually looking at, and only that one. Letting a background client "
        . "off the leash runs it at full clocks for a window nobody is "
        . "watching, and on a laptop that heat comes straight out of the boost "
        . "headroom of the client that IS being watched. This is "
        . "the one that usually matters most: on modern laptops and on "
        . "desktops with efficiency cores, Windows parks a process it reads as "
        . "idle onto the slow cores and holds its clocks down, and a windowed "
        . "game that is not the foreground window qualifies far more often "
        . "than you would expect.  "
        . "On a CPU with two kinds of core - Intel 12th generation and later - "
        . "the client MAY be told to prefer the performance cores, and this is "
        . "the one lever here whose benefit is not certain. It sets the default "
        . "for every thread in the process, not just the one that matters, so "
        . "on a chip with a lot of efficiency cores it asks the whole worker "
        . "pool to crowd onto the performance half - and what the workers lose "
        . "can cost more than the render thread gains. Windows own scheduler is "
        . "built for that decision and is usually good at it.  "
        . "So it is applied only when the row has MEASURED the client to be "
        . "bottlenecked on a single thread, which is the one case where the "
        . "render thread placement is the whole story. Otherwise Windows is "
        . "left alone, and the row says why rather than counting it as a "
        . "failure. On any CPU whose cores are all alike it does nothing at all "
        . "and is skipped.  "
        . "The client is allowed to ask for a finer system timer. The default "
        . "tick is 15.6 ms, so a frame that finished early could sit waiting "
        . "on the scheduler for longer than it took to draw. Note this is done "
        . "TO THE CLIENT: since Windows 10 2004 a program raising the timer "
        . "raises it only for itself, so a booster that calls timeBeginPeriod "
        . "in its own process - as this one used to - does nothing for the "
        . "game at all.  "
        . "The client's memory priority is held at normal. Windows demotes "
        . "processes it reads as background, and a demoted client is the first "
        . "thing trimmed when memory gets tight - then faults its pages back in "
        . "mid-frame. That is a hitch, and a hitch is worse to play through "
        . "than a slightly lower average.  "
        . "A client launched later is picked up on its own within a few "
        . "seconds, and the client you tab to takes the top slot the moment you "
        . "tab to it. Turning the switch off puts it all back: normal priority, "
        . "throttling handed back to Windows, core preference cleared.  "
        . "THE ROW TELLS YOU WHETHER ANY OF IT CAN HELP. It measures the "
        . "client's busiest single thread, because a game runs out of road on "
        . "its render thread long before it does on total CPU. If that thread "
        . "is sitting near 100% of one core you are CPU-bound and this feature "
        . "has something to work with; if it is not, the row says so plainly "
        . "rather than letting a switch that is working look like a switch that "
        . "is broken. It also names any lever that reported nothing - the core "
        . "preference does nothing on a CPU whose cores are all alike, and the "
        . "timer bit is Windows 11 only, so a count below the full six is "
        . "normal and not a fault.  "
        . "ONE RULE RUNS THROUGH ALL OF IT: nothing here is ever set lower "
        . "than it was found, and everything is put back to what was found "
        . "rather than to what the default happens to be. A client you had "
        . "already raised in Task Manager is not demoted to make room for the "
        . "one in front, and it comes back on High rather than on Normal when "
        . "the switch goes off. A value you have already tuned past the target "
        . "is left at your number, not overwritten with ours. A graphics "
        . "preference you set yourself is neither claimed nor deleted. The "
        . "guiding assumption is that a machine already configured better than "
        . "this feature would configure it is a machine to leave alone.  "
        . "THREE OPT-IN CHIPS sit on this row, and none is on by default "
        . "because all three reach further than the rest.  "
        . "GPU PREF is the largest single thing here on a laptop with two "
        . "graphics chips. If the client came up on the integrated one it is "
        . "not a few percent short, it is running on a different and far "
        . "smaller GPU, and no amount of scheduling recovers that. This writes "
        . "the same per-application preference the Windows Settings graphics "
        . "page writes, asking for the high-performance card. Unlike everything "
        . "else here it is a registry value: it survives a reboot, and Windows "
        . "reads it when the process STARTS, so it does nothing for a client "
        . "already open - restart Roblox for it to take. It refuses to turn on "
        . "at all where there is only one GPU, and if Windows already has a "
        . "preference set for Roblox it leaves that alone rather than "
        . "overruling a choice you made - including when that preference "
        . "already says high performance, which it neither claims nor removes. "
        . "Turning the chip off deletes only a value YURI itself wrote, and it "
        . "is recorded in the same restore file as everything else, so a crash "
        . "cannot strand it either.  "
        . "While the game has focus YURI also drops its own priority from high "
        . "to normal. The suite raises itself at startup so its overlays stay "
        . "smooth, but with the boost on that put the hub in the same class as "
        . "the client it was boosting - and QUIET was demoting your browser to "
        . "clear a path YURI was still standing in. It goes back the moment you "
        . "tab away from the game. Normal rather than lower on purpose: this "
        . "process holds the keyboard and mouse hooks for AUTOBLOCK and PUZZLE "
        . "AI, and Windows drops a hook whose owner is too slow to answer.  "
        . "QUIET drops known background CPU hogs - browsers, launchers, sync "
        . "clients, the search indexer - to below-normal priority while the "
        . "boost is on. Raising the client is only half of a contention "
        . "problem; this is the other half, and on a CPU-bound machine it is "
        . "worth as much as everything above put together, because below-normal "
        . "costs those programs nothing at all until the moment they actually "
        . "collide with the game. It works from a fixed list and never guesses: "
        . "Discord, Spotify and any capture or recording tool are deliberately "
        . "not on it, because those are exactly the programs that are cheap on "
        . "average and terrible to starve for the one millisecond that matters. "
        . "Neither is the Start menu and search UI, which was on the list and "
        . "was taken off it: demoting that costs nothing while you are in the "
        . "game and then makes Start feel slow the moment you tab out, which is "
        . "a slowdown you would actually notice bought for a gain you would "
        . "not. The rule the list follows is that it may only contain things "
        . "whose slowdown cannot be felt. "
        . "It only ever demotes something it finds at normal, it remembers what "
        . "it found and puts that back, and it names what it touched when you "
        . "turn it on. It is released when the chip goes off, when the switch "
        . "goes off, and when YURI exits.  "
        . "SYSTEM is the only control in YURI that changes anything outside a "
        . "process, and it is the only one whose undo is written to disk before "
        . "the change is made. It switches Windows to the High performance "
        . "power plan, turns off Game DVR and its background capture, turns Game "
        . "Mode on, and - if YURI is running as administrator - lowers the CPU "
        . "share Windows reserves for low-priority work and lifts the network "
        . "throttle. The power plan is the big one, especially on a laptop: "
        . "Balanced caps the processor's minimum state and holds boost back, and "
        . "no amount of scheduling priority argues with a clock that is not "
        . "being allowed to rise. The rest are modest, and are described that "
        . "way rather than sold as more than they are. If your plan already "
        . "lets the processor run unrestricted - Ultimate Performance, High "
        . "performance, a duplicate of either, or a custom plan you built - it "
        . "is left exactly as it is and the row says so. That test reads what "
        . "the plan actually does rather than what it is called, because "
        . "Ultimate Performance is normally created by duplicating the built-in "
        . "one and a duplicate carries a different identifier: matching on the "
        . "name or the identifier would take the better plan away from the one "
        . "person who had gone to the trouble of setting it up.  "
        . "HOW THE UNDO WORKS, because a machine-wide change deserves better "
        . "than a promise. Before any value is written, the value that was "
        . "there is read and recorded in YURI\config\fpsrestore.ini. A value "
        . "that did not exist is recorded as absent, so putting it back means "
        . "deleting it rather than writing a zero and calling that the same "
        . "thing. The record is written FIRST and the change second: a record "
        . "with no change is harmless, a change with no record is the thing this "
        . "is built to prevent. Restoring an entry clears it and the file is "
        . "deleted once it is empty, so the file existing at all means something "
        . "is still outstanding - and every launch restores whatever it finds "
        . "there before re-applying anything. Turn the chip off, turn the switch "
        . "off, close YURI, or have it killed outright and lose power: the "
        . "settings come back either immediately or at the next launch.  "
        . "Two things it will not do. It never touches hardware-accelerated GPU "
        . "scheduling - that genuinely helps on some GPU and driver combinations "
        . "and hurts on others, and it needs a reboot to try either way, so it "
        . "is read and reported and left to you. And it writes nothing whose "
        . "effect cannot be explained: the scheduler quantum value every tweak "
        . "guide recommends is contradicted by half the guides recommending it, "
        . "and a number written into the scheduler that nobody can account for "
        . "is a guess with a reboot attached rather than a tweak.  "
        . "One thing no switch here can reach: if the machine is on battery, or "
        . "Battery Saver is on, Windows holds the clocks down harder than any "
        . "of this can lift them. The row says so when it sees it. It also reads "
        . "your framerate cap from CLIENT SETTINGS and says so if one is set - "
        . "nothing on this row can push a client past a cap it was told to "
        . "respect, and letting you chase that with these switches while the "
        . "answer sits one panel away would be a worse silence than admitting "
        . "it.  "
        . "How much you gain depends entirely on what was holding you back. If "
        . "the GPU is the limit this does very little; if the client was being "
        . "throttled or fighting for CPU, it can be a large difference."
    ; Appended rather than written into b6, because it is the only part of this
    ; sheet that is not the same every time it is opened.
    b6 .= SPFFpsHeld()
    bdy := [b1, b2, b3, b4, b5, b6]
    if (i < 1 || i > bdy.Length)
        return
    DetailOpen(ttl[i], hnt[i], bdy[i], "SPECIAL")
}
; Built from the option record rather than written out: the row already knows
; its name, its hint, what it writes and what it can be set to, and a
; generated body cannot drift out of date the way a hand-written one would.
RSetDetail(i) {
    if (i < 1 || i > RSET_OPTS.Length)
        return
    o := RSET_OPTS[i]
    if (o.ui = "slider")
        w := "Moves the slider to pick a value."
    else if (o.k = "logorst") {
        w := "Puts both apps' logo art and both shortcut icons back, without "
           . "touching any other client setting - that is the whole reason it "
           . "is its own button rather than part of REVERT SETTINGS.  "
           . "Every file replaced is copied aside before it is overwritten, "
           . "and each shortcut's previous IconLocation is recorded before it "
           . "is changed, so this restores what was actually there rather than "
           . "guessing at Roblox's defaults. Anything with no backup held is "
           . "left alone instead of overwritten with a guess."
    }
    else if (o.k = "fps") {
        w := "The frame rate the client aims for. Unlike everything else in "
           . "this panel, this one does not have to wait for a restart.  "
           . "The value behind it is DFIntTaskSchedulerTargetFps, and the D on "
           . "the front is the point: in Roblox's flag system a D-prefixed "
           . "value is DYNAMIC - the kind Roblox itself can push to a client "
           . "that is already running. The task scheduler re-reads it as it "
           . "runs, so writing it into a live client takes effect on the next "
           . "frame. APPLY does that as well as writing the file, and reads "
           . "the value back afterwards to confirm it actually took rather "
           . "than assuming the write was enough.  "
           . "ABOVE 240 IS DIFFERENT, AND IT WILL NOT GO LIVE. The ceiling is "
           . "held by FFlagTaskSchedulerLimitTargetFpsTo2402, which has no D "
           . "prefix - it is read once when the process starts. Writing it "
           . "afterwards puts the value in memory and the engine never looks "
           . "there again, so nothing changes. That is a property of the "
           . "compiled client, not something a tool outside it can work "
           . "around.  "
           . "So: 60, 120, 144 and 240 apply instantly, because they sit under "
           . "the ceiling and only the dynamic value matters. 250 and above "
           . "are written and saved, but need one restart before they take. "
           . "Set them, restart Roblox once, and they hold from then on.  "
           . "The live write goes to the client the FAST FLAG MANAGER is "
           . "attached to. It attaches on its own within about a second of a "
           . "client starting, so this is normally available - but with "
           . "several clients open it is the selected one that changes, not "
           . "all of them.  "
           . "MAX is 9999, not infinity - Roblox wants a number."
    }
    else if (o.ui = "file" && (o.k = "logo" || o.k = "logos")) {
        kD := (o.k = "logos") ? 2 : 1
        tg := RSetLogoScan(kD)
        if (RSetLogoSubOf(kD) != "")
            w := "Replacing: " RSetLogoSubOf(kD) "  "
        else
            w := ""
        nsc := RSetLnkScan(kD).Length
        w .= "BROWSE picks an image, then APPLY writes it - picking alone "
           . "changes nothing on disk. One image goes to two different places, "
           . "because the Roblox logo is not one thing.  "
           . "1. THE ART INSIDE THE CLIENT. Roblox has never published the "
           . "name of its logo asset and it has moved between builds, so this "
           . "does not assume one - it searches the client's own texture "
           . "folders for every PNG whose filename says it is a logo. "
           . "Originals are copied aside first and REVERT puts them all back.  "
           . "2. THE DESKTOP, TASKBAR AND START ICON. That one is not a "
           . "texture at all, so no file swap under content\ could ever reach "
           . "it - it is the SHORTCUT's own icon. Every .lnk carries an "
           . "IconLocation, and pointing that at a new file changes the icon "
           . "everywhere the shortcut appears, without touching anything "
           . "inside the Roblox install. Windows wants an .ico rather than a "
           . ".png there, so your image is converted to a 256px icon "
           . "automatically - no converter site and no Resource Hacker. "
           . "Found " nsc " Roblox shortcut(s) on this machine. A Roblox "
           . "update rewrites its own shortcuts, so press APPLY again after "
           . "one; REVERT restores each shortcut's previous icon exactly, "
           . "because the old value is recorded before the first change.  "
           . "Roblox has never published the name of its logo asset and it has "
           . "moved between builds, so this does not assume one. It searches "
           . "the client's own texture folders for every PNG whose filename "
           . "says it is a logo. Originals are copied aside first and REVERT "
           . "puts them all back.  "
        ; The list is the point. If this feature does nothing, it is almost
        ; always because it matched nothing - and until you can SEE what it
        ; matched, that is indistinguishable from it being broken.
        if !tg.Length {
            w .= "RIGHT NOW NO TEXTURE MATCHES, so APPLY would change the "
               . "shortcut icon only. "
               . "Press BROWSE again: when the name search comes up empty it "
               . "opens a second dialog straight into the client's textures "
               . "folder and lets you point at the exact file to replace. That "
               . "choice is stored relative to content\textures, so it applies "
               . "to every installed version and survives Roblox updates."
        } else {
            w .= "It currently matches " tg.Length " file(s):  "
            shown := 0
            for t in tg {
                if (t.mk)
                    continue                     ; bloxstrap mirrors, not finds
                if (++shown > 12) {
                    w .= "  ...and more"
                    break
                }
                w .= "  " t.sub
            }
            w .= "  Restart Roblox after APPLY - these are read once at launch."
        }
    }
    else if (o.ui = "file")
        w := "BROWSE picks a file; the client's own is kept and can be restored."
    else if (o.ui = "action")
        w := "A one-shot action rather than a setting."
    else if (o.ui = "preset")
        w := "HIGH is every graphics row at its maximum. MEDIUM is a balance. "
           . "LOW is the cheapest the client will render, with the frame rate "
           . "uncapped - the point of the lowest tier is the highest frame "
           . "rate. All three set the rendering, lighting, FRM, texture, mesh, "
           . "anti-aliasing, framerate cap, scaling and graphics-quality rows "
           . "in one press. They leave the font, master volume and mouse "
           . "sensitivity exactly as you set them: those are yours, not "
           . "quality. Staged like everything else here - press APPLY to write "
           . "it. Change any row afterwards and the preset simply stops being "
           . "marked, because it is read back from the rows rather than "
           . "remembered."
    else
        w := "The chip on the right opens the list of values."
    if (o.HasOwnProp("xml") && o.xml != "")
        w .= "  Writes " o.xml " into ClientAppSettings."
    else if (o.ui != "file" && o.ui != "action" && o.ui != "preset")
        w .= "  Writes fast flags into ClientAppSettings."
    if (o.HasOwnProp("v") && o.v.Length) {
        vs := ""
        for k2, vv in o.v {
            if (k2 > 6) {
                vs .= ", ..."
                break
            }
            vs .= (k2 > 1 ? ", " : "") vv
        }
        w .= "  Values: " vs "."
    }
    if (o.ui != "action")
        w .= "  Staged only - nothing reaches the client until APPLY."
    DetailOpen(o.n, o.h, w, "CLIENT SETTINGS")
}
CurDetail(i) {
    ttl := ["ARROW IMAGE", "SHIFT LOCK IMAGE", "CAMERA TOGGLE IMAGE", "TEXT CURSOR IMAGE"
          , "APPLY TO ROBLOX", "RESTORE DEFAULT"
          , "FAR CURSOR", "AUTO RE-APPLY"]
    hnt := ["the pointer you see almost all the time"
          , "the crosshair while shift lock is held"
          , "the crosshair while camera toggle is on"
          , "the caret over chat and text boxes"
          , "write every staged slot over the roblox files"
          , "put the original roblox cursors back"
          , "also replace the distant-object pointer"
          , "rewrite after roblox updates its client"]
    ; explicit "." joins: AHK v2 does not concatenate two string literals just
    ; because a newline sits between them
    b1 := "This is ArrowCursor and ArrowFarCursor - the pointer Roblox draws in "
        . "almost every menu and over most of the world. Picking an image stages "
        . "it; nothing touches the client until you press APPLY. Square images "
        . "around 64x64 hold up best, since Roblox scales whatever you give it."
    b2 := "The reticle Roblox swaps in while shift lock is held. It is a separate "
        . "file from the arrow, so a set can replace one and leave the other "
        . "alone. Staged the same way - APPLY is still what writes it."
    b3 := "CrossMouseIcon.png - the crosshair for camera toggle, which is a "
        . "different Roblox feature from shift lock and a different file. Tap "
        . "right mouse button to enter toggle mode: the cursor parks above your "
        . "head and locks there, and tapping again leaves. It works in both "
        . "first and third person. Shift lock has its own crosshair in the slot "
        . "above, so replacing one leaves the other alone. Note this file lives "
        . "in textures\Cursors rather than textures\Cursors\KeyboardMouse "
        . "where the arrow pair sits - the panel handles that, but it matters if "
        . "you ever place one by hand. Staged like the other slots and written "
        . "by the same APPLY step."
    b4 := "IBeamCursor.png - the caret Roblox shows whenever the pointer is over "
        . "something you can type into: the chat entry box, a text field in a "
        . "game's interface, a search box in the menus. It is the one cursor "
        . "here you see outside of gameplay as much as inside it. Unlike the "
        . "other three this one is not a crosshair or a pointer, so an image "
        . "that reads as a vertical bar keeps it recognisable - a replacement "
        . "shaped like an arrow will work, but you lose the only signal that "
        . "tells you a field will accept typing. Staged like the rest and "
        . "written by the same APPLY step."
    b5 := "Copies every staged slot over the files in the Roblox install, backing "
        . "up whatever was there first. The backup is keyed to the install path, "
        . "so two installs never overwrite each other's originals. A Roblox "
        . "update replaces these files, which is what AUTO RE-APPLY watches for."
    b6 := "Puts the backed-up originals back and clears the staged set. Safe to "
        . "press at any time - if no backup exists for a slot it is left alone "
        . "rather than guessed at.  "
        . "It can only undo what THIS hub did. A backup is taken the first "
        . "time a file is overwritten, so a cursor put there by something else "
        . "- a Bloxstrap mod, a texture pack, a manual copy - has no original "
        . "stored here and RESTORE will say so rather than invent one. The "
        . "tile captions tell you which is which: 'roblox default' is the "
        . "client's own file, while 'bloxstrap mod' means Modifications is "
        . "copying an image over the client on every launch and RESTORE has "
        . "no original of its own to put back.  "
        . "To get Roblox's own cursors back in that case, take the file out of "
        . "Bloxstrap's Modifications folder if that is where it came from - "
        . "OPEN FOLDER goes straight there - and relaunch. Roblox restores its "
        . "own content on its next update either way."
    b7 := "Roblox draws a second, smaller pointer for things far away. With "
        . "this on, that slot is replaced from the same image as the arrow, so "
        . "the pointer does not change shape at distance. Off, Roblox keeps "
        . "its own."
    b8 := "A Roblox update replaces the cursor files, which quietly puts the "
        . "default pointers back. This watches for that and rewrites your set "
        . "afterwards, so a set applied once stays applied across updates."
    bdy := [b1, b2, b3, b4, b5, b6, b7, b8]
    if (i < 1 || i > bdy.Length)
        return
    nS := CUR_SLOTS.Length
    DetailOpen(ttl[i], hnt[i], bdy[i]
             , i <= nS ? "CURSOR  -  IMAGE SLOT"
             : (i <= nS + 2 ? "CURSOR  -  ACTION" : "CURSOR"))
}
CurClick(z) {
    global curFar, curAuto
    nS := CUR_SLOTS.Length                       ; 4 image slots
    ; a tile and its row's BROWSE button are the same action
    if (z > 1140 && z <= 1140 + nS)
        CurPick(z - 1140)
    else if (z > 1130 && z <= 1130 + nS)
        CurPick(z - 1130)
    else if (z = 1130 + nS + 1)
        CurApply()
    else if (z = 1130 + nS + 2)
        CurRestore()
    else if (z >= 1111 && z <= 1110 + CUR_SYSN)
        CurDetail(z - 1110)
    else if (z = 1130 + CUR_SYSN - 1) {
        curFar := !curFar
        try IniWrite(curFar ? 1 : 0, iniPath, "cursor", "far")
        CurSay(curFar ? "FAR CURSOR ON" : "FAR CURSOR OFF", 0)
    } else if (z = 1130 + CUR_SYSN) {
        curAuto := !curAuto
        try IniWrite(curAuto ? 1 : 0, iniPath, "cursor", "auto")
        CurManageAuto()
        CurSay(curAuto ? "AUTO RE-APPLY ON" : "AUTO RE-APPLY OFF", 0)
    } else if (z = 1150)
        CurOpenFolder()
    if (z > 0)
        FFM.clickAt[z] := A_TickCount
    HubPoke()
}

CurDragScroll(sy) {
    k := HL.pw/HL.bw
    uy := (sy - HL.py)/k
    vis := HL.ffh - 20, tot := CurSysTotal()
    thmb := Max(22, vis*(vis/Max(1, tot)))       ; not `th` - shadows TH()
    CSR.scrT := FFMScrollFromY(uy, HL.aby + 10, vis, tot, vis, thmb, CSR.scr)
    CSR.scr := CSR.scrT
    HubPoke()
}

; ---------------- CURSOR: glyphs ----------------
CurSysIcon(i, cx, cy, col, live, now) {
    if hubLowPerf
        return
    pn := Pen(col, 1.5)
    if (i = 1) {                                   ; arrow image: framed picture
        StrokeRR(cx - 8, cy - 7, 16, 14, 2.5, pn)
        Line(cx - 6, cy + 5, cx - 1.5, cy - 1, pn)
        Line(cx - 1.5, cy - 1, cx + 1.5, cy + 2.5, pn)
        Line(cx + 1.5, cy + 2.5, cx + 3.5, cy + 0.5, pn)
        Line(cx + 3.5, cy + 0.5, cx + 6, cy + 5, pn)
        b2 := SBrush(col)
        FillEll(cx + 1.5, cy - 5, 3, 3, b2), DelB(b2)
    } else if (i = 2) {                            ; shift lock: ringed crosshair
        Ell(cx - 6, cy - 6, 12, 12, pn)
        Line(cx - 10, cy, cx - 7, cy, pn)
        Line(cx + 7, cy, cx + 10, cy, pn)
        Line(cx, cy - 10, cx, cy - 7, pn)
        Line(cx, cy + 7, cx, cy + 10, pn)
        b2 := SBrush(col)
        FillEll(cx - 1.6, cy - 1.6, 3.2, 3.2, b2), DelB(b2)
    } else if (i = 3) {                            ; camera: camera body + lens
        ; body - two side edges + bottom
        Line(cx - 8, cy - 2, cx - 8, cy + 7, pn)
        Line(cx + 8, cy - 2, cx + 8, cy + 7, pn)
        Line(cx - 8, cy + 7, cx + 8, cy + 7, pn)
        ; top edge with notch for viewfinder bump
        Line(cx - 8, cy - 2, cx - 5, cy - 2, pn)
        Line(cx + 5, cy - 2, cx + 8, cy - 2, pn)
        ; viewfinder bump (the little protrusion on top)
        Line(cx - 5, cy - 2, cx - 3, cy - 6, pn)
        Line(cx - 3, cy - 6, cx + 3, cy - 6, pn)
        Line(cx + 3, cy - 6, cx + 5, cy - 2, pn)
        ; lens circle + centre dot
        Ell(cx - 4, cy, 8, 8, pn)
        b2 := SBrush(col)
        FillEll(cx - 1.5, cy + 2.5, 3, 3, b2), DelB(b2)
    } else if (i = 4) {                            ; text: I-beam over a field
        ; a caret between two serifs, sitting in a hinted text box - the shape
        ; Roblox actually draws over a chat entry
        pn2 := Pen(FA(Alpha(col, 90), 1), 1.1)
        StrokeRR(cx - 9, cy - 7, 18, 14, 2.5, pn2), DelP(pn2)
        Line(cx - 3.5, cy - 4.5, cx + 3.5, cy - 4.5, pn)   ; top serif
        Line(cx - 3.5, cy + 4.5, cx + 3.5, cy + 4.5, pn)   ; bottom serif
        Line(cx, cy - 4.5, cx, cy + 4.5, pn)               ; the stem
        if live {
            ; a caret blinks; that is the whole identity of this cursor
            bl := (Mod(DecT(now), 1060) < 530) ? 1.0 : 0.25
            b2 := SBrush(FA(Alpha(col, Round(220*bl)), 1))
            FillRR(cx - 0.9, cy - 4.5, 1.8, 9, 0.9, b2), DelB(b2)
        }
    } else if (i = 5) {                            ; apply: pointer
        CurArrow(cx - 4, cy - 8, 0.85, pn)
        if live {
            a_ := Mod(DecT(now)*0.2, 360)*0.0174533
            b2 := SBrush(col)
            FillEll(cx + 4 + 2*Cos(a_), cy - 5 + 2*Sin(a_), 2.6, 2.6, b2), DelB(b2)
        }
    } else if (i = 6) {                            ; restore: counter arrow
        Arc(cx - 7, cy - 7, 14, 14, 110, 250, pn)
        Line(cx - 6.6, cy - 1.5, cx - 6.6, cy - 6.5, pn)
        Line(cx - 6.6, cy - 1.5, cx - 2, cy - 3.5, pn)
    } else if (i = 7) {                            ; far cursor: near + far pointer
        CurArrow(cx - 9, cy - 7, 0.62, pn)
        CurArrow(cx + 1, cy - 2, 0.95, pn)
    } else {                                       ; auto: sweeping dial
        sp := live ? Mod(DecT(now)*0.12, 360) : 30
        Arc(cx - 7, cy - 7, 14, 14, sp, 265, pn)
        a_ := (sp + 265)*0.0174533
        b2 := SBrush(col)
        FillEll(cx + 7*Cos(a_) - 2, cy + 7*Sin(a_) - 2, 4, 4, b2), DelB(b2)
    }
    DelP(pn)
}

; the classic pointer outline, tip at (x, y), drawn at scale s
CurArrow(x, y, s, pn) {
    Line(x, y, x, y + 13*s, pn)
    Line(x, y + 13*s, x + 3.4*s, y + 9.6*s, pn)
    Line(x + 3.4*s, y + 9.6*s, x + 5.8*s, y + 15*s, pn)
    Line(x + 5.8*s, y + 15*s, x + 8*s, y + 14*s, pn)
    Line(x + 8*s, y + 14*s, x + 5.6*s, y + 8.8*s, pn)
    Line(x + 5.6*s, y + 8.8*s, x + 9.6*s, y + 8.2*s, pn)
    Line(x + 9.6*s, y + 8.2*s, x, y, pn)
}

CurBaseName(p) {
    SplitPath(p, &nm)
    return nm != "" ? nm : p
}

; ---------------- CURSOR: systems panel ----------------
CurSystems(ax, ay, x0, y0, dx, dy2, ff, now, acc) {
    global curFar, curAuto
    mt := HL.modT
    found := CurFoundN()

    Txt("SYSTEMS", ax, y0 + 36, 120, 14, fBadge, FA(0x62C7CBE0, ff), fmtL)
    Txt(mt > 0.5 ? CUR_SYSN " listed" : "0 listed", ax + 66, y0 + 36, 80, 14, HL.fS
        , FA(Alpha(acc, 60 + 120*mt), ff), fmtL)
    if (mt > 0.4) {
        fh := ff*Clamp((mt - 0.4)/0.4, 0.0, 1.0)
        hdr := found ? (found " cursor file(s) detected") : "no roblox cursor files found"
        Txt(hdr, ax + HL.abw - 240, y0 + 30, 240, 22, fHint
            , FA(Alpha(found ? 0xFFC7CBE0 : acc, 145), fh), fmtR)
    }

    ; ---- panel shell (same chrome as the fast flag systems panel) ----
    pah := 26 + (HL.ffh - 26)*mt
    b := VBrush(ax, ay, HL.abw, pah, FA(Mix(0xFF141728, 0xFF181C34, mt), ff), FA(0xFF12141F, ff))
    FillRR(ax, ay, HL.abw, pah, 12, b), DelB(b)
    MiniBackdrop(ax, ay, HL.abw, pah, 12, acc, ff, now, 0.9)
    HubEmptyGhost(ax, ay, pah, ff)          ; the collapsed state, fading back in
    pn := Pen(FA(Alpha(acc, 70 + 90*mt), ff), 1.2)
    StrokeRR(ax, ay, HL.abw, pah, 12, pn), DelP(pn)
    gl := 40*mt
    pn := Pen(FA(Alpha(AccHi(acc, 0.4), 200*mt), ff), 1.6)
    Line(ax + 14, ay + 0.6, ax + 14 + gl, ay + 0.6, pn)
    Line(ax + HL.abw - 14 - gl, ay + pah - 0.6, ax + HL.abw - 14, ay + pah - 0.6, pn), DelP(pn)

    ModRing(ax, ay, HL.abw, pah, 12, acc, ff, HL.modAt, now, 700, 18, hubMod != 0)
    if (mt < 0.02)
        return

    pClip := RRPath(ax, ay, HL.abw, pah, 12)
    stCS := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pClip, "int", 1)

    names := ["ARROW IMAGE", "SHIFT LOCK IMAGE", "CAMERA TOGGLE IMAGE", "TEXT CURSOR IMAGE"
            , "APPLY TO ROBLOX", "RESTORE DEFAULT"
            , "FAR CURSOR", "AUTO RE-APPLY"]
    hints := ["the pointer you see almost all the time"
            , "the crosshair while shift lock is held"
            , "the crosshair while camera toggle is on"
            , "the caret over chat and text boxes"
            , "write every staged slot over the roblox files"
            , "put the original roblox cursors back"
            , "also replace the distant-object pointer"
            , "rewrite after roblox updates its client"]
    ons   := [0, 0, 0, 0, 0, 0, CSR.farT, CSR.autoT]
    subs  := ["", "", "", "", "", "", curFar ? "ON" : "OFF", curAuto ? "ON" : "OFF"]
    isBtn := [true, true, true, true, true, true, false, false]
    btns  := ["BROWSE", "BROWSE", "BROWSE", "BROWSE", "APPLY", "RESTORE"]
    writeN := CurActiveN()

    loop CUR_SYSN {
        i := A_Index
        cg := Clamp((mt - 0.30 - Min(i, 6)*0.055)/0.38, 0.0, 1.0)
        if (cg <= 0.01)
            continue
        fb := ff*cg
        ry := ay + 12 + (i - 1)*HL.ffrg - CSR.scr
        if (ry + 36 < ay + 4 || ry > ay + pah - 4)
            continue
        hv := Max(HL.h.Get(1110 + i, 0.0), HL.h.Get(1130 + i, 0.0))
        sld := (1 - cg)*10
        axs  := ax + sld                     ; row CONTENT rides the entrance slide; panel chrome does not
        nS := CUR_SLOTS.Length
        live := (i <= nS)     ? (CSR.slot[i].has > 0)
              : (i = nS + 1)  ? (writeN > 0)
              : (i = nS + 2)  ? (CSR.applied > 0)
              : ons[i] > 0.5

        if (hv > 0.01) {
            b := HBrush(ax + 6, ry, HL.abw - 12, 36, FA(Alpha(0xFFFFFF, 15*hv), fb), FA(Alpha(0xFFFFFF, 3*hv), fb))
            FillRR(ax + 6, ry, HL.abw - 12, 36, 8, b), DelB(b)
        }
        b := VBrush(axs + 14, ry + 10, 3, 16, FA(Alpha(live ? AccHi(acc, 0.35) : 0xFFC7CBE0, live ? 235 : 60), fb)
                  , FA(Alpha(live ? acc : 0xFFC7CBE0, live ? 150 : 40), fb))
        FillRR(axs + 14, ry + 10, 3, 16, 1.5, b), DelB(b)

        CurSysIcon(i, axs + 36, ry + 18, FA(Alpha(live ? acc : 0xFF9AA8C0, live ? 220 : 110), fb), live, now)

        tw := (isBtn[i] ? HL.abw - 118 : HL.abw - 158) - 54
        Txt(names[i], axs + 54, ry + 4, tw, 16, fBadge
            , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.18), 235), fb), fmtL)
        Txt(FFMElide(hints[i], fHint, tw), axs + 54, ry + 20, tw, 13
            , fHint, FA(0x7EC7CBE0, fb), fmtL)

        if (isBtn[i]) {
            if (i <= nS && CSR.slot[i].has) {
                Txt("set", axs + HL.abw - 176, ry + 11, 62, 14, HL.fXs
                    , FA(Alpha(C_ON, 190), fb), fmtR)
            } else if (i = nS + 1 && CSR.applied) {
                Txt(CSR.applied " live", axs + HL.abw - 176, ry + 11, 62, 14, HL.fXs
                    , FA(Alpha(C_ON, 200), fb), fmtR)
            } else if (i = nS + 2) {
                nb2 := CurBakCount()
                if nb2
                    Txt(nb2 " saved", axs + HL.abw - 176, ry + 11, 62, 14, HL.fXs
                        , FA(Alpha(acc, 185), fb), fmtR)
            }
            kind := (i <= nS) ? (CSR.slot[i].has ? 0 : 1) : (i = nS + 1) ? (writeN ? 1 : 0) : 2
            FFMBtn(1130 + i, axs + HL.abw - 108, ry + 5, 92, 26, btns[i], acc, fb, kind)
        } else {
            Txt(subs[i], axs + HL.abw - 148, ry + 11, 70, 14, HL.fXs
                , FA(Alpha(ons[i] > 0.5 ? C_ON : 0xFF9AA8C0, ons[i] > 0.5 ? 200 : 95), fb), fmtR)
            FFMTogDraw(axs + HL.abw - 62, ry + 7, 44, 22, ons[i], acc, hv, fb)
        }
    }

    ; ---- systems scrollbar ----
    sysTot := CurSysTotal(), sysVis := HL.ffh - 20
    if (sysTot > sysVis) {
        sbS := Max(HL.h.Get(1152, 0.0), (HL.drag = 13) ? 1.0 : 0.0)
        sw2 := 3 + 3*sbS
        sxs := ax + HL.abw - 6 - 3*sbS
        b := SBrush(FA(Alpha(0xFFFFFF, 18 + 26*sbS), ff*mt))
        FillRR(sxs, ay + 10, sw2, sysVis, sw2/2, b), DelB(b)
        th2 := Max(22, sysVis*(sysVis/sysTot))
        ty2 := ay + 10 + (sysVis - th2)*(CSR.scr/Max(1, sysTot - sysVis))
        b := VBrush(sxs, ty2, sw2, th2, FA(Alpha(AccHi(acc, 0.35), 190 + 65*sbS), ff*mt)
                  , FA(Alpha(acc, 170 + 60*sbS), ff*mt))
        FillRR(sxs, ty2, sw2, th2, sw2/2, b), DelB(b)
    }

    Pop(stCS)
    DllCall("gdiplus\GdipDeletePath", "ptr", pClip)

    CurPreview(ax, ff, now, acc, mt, writeN)
}

; ---------------- CURSOR: preview card ----------------
; Vertical budget, all relative to the card top (CURCH = 194). The card sits at
; HL.ffby and HubFtrY() is the first row of the hub's footer band, so the last
; thing drawn here has to land above CURCH - nothing may spill past it.
;    8  header: PREVIEW badge, applied pill, OPEN FOLDER   ends  30
;   32  one tile per slot (CURPV tall)                     ends 100
;  102  tile captions                                      ends 114
;  115  tile filenames                                     ends 128
;  130  detail rows, 14px pitch:                           ends 186
;         L: ARROW / LOCK / CAMERA / TEXT
;         R: TARGETS / BACKUP / status
; The tiles are CURPV wide and laid out from CUR_SLOTS, so the detail block
; below them runs the full card width in two columns rather than being squeezed
; into the strip beside the tiles.
CurPreview(ax, ff, now, acc, mt, writeN) {
    cp := Clamp((mt - 0.60)/0.34, 0.0, 1.0)
    if (cp <= 0.01)
        return
    CurSyncDefaults()
    fp := ff*cp
    px := ax, pw := HL.abw
    py := HL.ffby + (1 - cp)*10

    b := VBrush(px, py, pw, CURCH, FA(Mix(0xFF141728, 0xFF181C34, cp), fp), FA(0xFF11131F, fp))
    FillRR(px, py, pw, CURCH, 12, b), DelB(b)
    MiniBackdrop(px, py, pw, CURCH, 12, acc, fp, now, 0.9)
    pn := Pen(FA(Alpha(acc, 60 + 70*cp), fp), 1.2)
    StrokeRR(px, py, pw, CURCH, 12, pn), DelP(pn)
    b := SBrush(FA(Alpha(acc, 200*cp), fp))
    FillRR(px, py + 9, 3, 20, 1.5, b), DelB(b)
    Txt("PREVIEW", px + 16, py + 8, 120, 16, fBadge, FA(Alpha(0xFFE8EAF6, 225), fp), fmtL)

    ; ---- applied pill + OPEN FOLDER, both on the header line ----
    ; The button moved up here when the third slot took the row it used to sit
    ; on. It reads as a header action rather than a footer one, which is what
    ; it always was.
    on := (CSR.applied > 0)
    pc := on ? C_ON : 0xFF9AA8C0
    plx := px + pw - 218
    b := SBrush(FA(Alpha(pc, on ? 40 : 22), fp))
    FillRR(plx, py + 8, 100, 18, 5, b), DelB(b)
    b := SBrush(FA(Alpha(pc, on ? 180 + 60*Abs(Sin(DecT(now)*0.0026)) : 90), fp))
    FillEll(plx + 8, py + 14.5, 5, 5, b), DelB(b)
    Txt(on ? "APPLIED" : "NOT APPLIED", plx + 18, py + 8, 76, 18, HL.fXs
        , FA(Alpha(AccHi(pc, 0.25), on ? 235 : 150), fp), fmtL)
    ; 1150, not 808. The CURSOR module was rebased into its own contiguous zone
    ; block when a fourth image slot collided with the old map (see the note at
    ; CurTileZone), and this call was left behind on the old id. The hit test,
    ; the click handler and HL.hz all moved to 1150; only the DRAW did not - so
    ; the button worked perfectly and never once lit, lifted or rippled, because
    ; HL.h.Get(808) is a value nothing ever writes.
    FFMBtn(1150, px + pw - 108, py + 6, 92, 22, "OPEN FOLDER", acc, fp, 0)

    ; ---- one tile per image slot ----
    ; Laid out from CUR_SLOTS rather than written out, so a fifth slot is a
    ; table entry and not another line here. Four at CURPV 68 span
    ; 14 + 68*4 + 10*3 = 316 of the card's 402, which still leaves the right
    ; margin clear.
    loop CUR_SLOTS.Length
        CurTile(A_Index, px + 14 + (A_Index - 1)*(CURPV + 10), py + 32
              , CurTileZone(A_Index), fp, now, acc, cp)

    ; ---- two detail columns under the tiles ----
    ; Left is one line per image slot, right is what a write would touch. Split
    ; from the card width rather than from the tile block, so the two columns
    ; stay even whatever CURPV is set to.
    cGap  := 10
    cHalf := (pw - 28 - cGap)//2
    lx := px + 14
    rx := px + 14 + cHalf + cGap

    ; Left column is one line per image slot, generated from the table. Four
    ; rows at a 14px pitch from py+130 end at py+186, inside CURCH.
    rowY := py + 130
    loop CUR_SLOTS.Length {
        si := A_Index
        CurRow(lx, rowY + (si - 1)*14, cHalf, CUR_SLOTS[si].label, CurDimText(si)
             , CSR.slot[si].has ? 0xFFC7CBE0 : 0xFF9AA8C0, fp)
    }

    which := curFar ? "arrow + far" : "arrow only"
    tgS   := writeN ? (writeN " file(s)  ·  " which) : "nothing to write"
    CurRow(rx, rowY, cHalf, "TARGETS", tgS, writeN ? 0xFFC7CBE0 : acc, fp)
    nb3 := CurBakCount()
    bkS := nb3 ? (nb3 " original(s) held") : "none held yet"
    CurRow(rx, rowY + 14, cHalf, "BACKUP",  bkS, nb3 ? 0xFFC7CBE0 : 0xFF9AA8C0, fp)

    ; ---- status line, in the right column's third row ----
    mf := CSR.msgAt ? Clamp(1 - (now - CSR.msgAt - 4200)/900.0, 0.0, 1.0) : 1.0
    if (mf > 0.01) {
        mc := (CSR.msgCol = C_ACC) ? acc : (CSR.msgCol ? CSR.msgCol : 0xFFC7CBE0)
        b := SBrush(FA(Alpha(mc, Round(150*mf)), fp))
        FillRR(rx, rowY + 30, 3, 12, 1.5, b), DelB(b)
        Txt(FFMElide(CSR.msg, HL.fXs, cHalf - 12), rx + 9, rowY + 28, cHalf - 12, 15, HL.fXs
            , FA(Alpha(AccHi(mc, 0.2), Round(225*mf)), fp), fmtL)
    }
}

; The column is half the card wide now, so the arrow spelling out "-> 64 x 64"
; no longer fits and would elide the source size away - which is the only part
; that varies. Every slot is normalised to CUR_SIZE, and the detail sheet says
; so, making the target redundant on the row.
; Only ONE case is genuinely not the default: a Bloxstrap mod sitting in
; Modifications, because that file is copied over the client on every launch.
; Everything else is Roblox's own - either a backup we took before overwriting
; anything, or a live file that nothing detectable has touched. Calling that
; second case "current file" was hedging about a question that can actually be
; answered: no backup means we never wrote there, and no mod means Bloxstrap
; is not writing there either, so what is on disk is what Roblox shipped.
CurSrcName(si) => (CSR.slot[si].dsrc = 1) ? "bloxstrap mod" : "roblox default"
CurDimText(si) {
    s := CSR.slot[si]
    if (s.bw && s.bh && s.has)
        return s.bw " x " s.bh "  ·  fitted"
    return s.dbmp ? ("not set  ·  " CurSrcName(si)) : "not set"
}

; One slot tile: the user's picture when there is one, otherwise whatever
; Roblox itself would draw, dimmed and badged so the two never read the same.
CurTile(si, tx, ty, zone, fp, now, acc, cp) {
    s := CSR.slot[si]
    own := (s.bmp && s.bw && s.bh)
    bmp := own ? s.bmp : s.dbmp
    bw  := own ? s.bw  : s.dbw
    bh  := own ? s.bh  : s.dbh

    pscl := 1.0                        ; not `pop` - that name shadows Pop()
    if (s.pickAt && now - s.pickAt < 520)
        pscl := 0.86 + 0.14*EBackOut(Clamp((now - s.pickAt)/520.0, 0.0, 1.0), 2.0)
    hvP := HL.h.Get(zone, 0.0)
    stT := PushXform(tx + CURPV/2, ty + CURPV/2, pscl*(1 + 0.025*Ease3(hvP)), 0)

    b := SBrush(FA(0xFF0B0D16, fp))
    FillRR(tx, ty, CURPV, CURPV, 10, b), DelB(b)
    tClip := RRPath(tx, ty, CURPV, CURPV, 10)
    stTC := PushG()
    DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", tClip, "int", 1)
    ; diagonal hatch so transparent pixels read as transparent, cheaply
    pn := Pen(FA(Alpha(0xFFFFFF, 9), fp), 1)
    k := -CURPV
    while (k < CURPV) {
        Line(tx + k, ty + CURPV, tx + k + CURPV, ty, pn)
        k += 11
    }
    DelP(pn)

    if bmp {
        fit := Min((CURPV - 20)/bw, (CURPV - 20)/bh)
        iw := bw*fit, ih := bh*fit
        SetImgAlpha(fp*(own ? 1.0 : 0.62))
        DllCall("gdiplus\GdipDrawImageRectRect", "ptr", G, "ptr", bmp
            , "float", tx + (CURPV - iw)/2, "float", ty + (CURPV - ih)/2, "float", iw, "float", ih
            , "float", 0, "float", 0, "float", bw, "float", bh
            , "int", 2, "ptr", IA, "ptr", 0, "ptr", 0)
    } else {
        ; nothing staged and nothing on disk to read back
        stR := PushXform(tx + CURPV/2, ty + CURPV/2, 1, Mod(DecT(now)*0.03, 360))
        pn := Pen(FA(Alpha(0xFFC7CBE0, 55), fp), 1.2)
        DllCall("gdiplus\GdipSetPenDashStyle", "ptr", pn, "int", 1)
        Ell(tx + CURPV/2 - 25, ty + CURPV/2 - 25, 50, 50, pn), DelP(pn)
        Pop(stR)
        pn := Pen(FA(Alpha(0xFFC7CBE0, 70), fp), 1.4)
        CurArrow(tx + CURPV/2 - 6, ty + CURPV/2 - 11, 1.4, pn), DelP(pn)
    }

    ; sweep while an apply lands
    if (CSR.applyAt && now - CSR.applyAt < 620 && own) {
        sw := Clamp((now - CSR.applyAt)/620.0, 0.0, 1.0)
        sxp := tx - 26 + (CURPV + 52)*Ease3(sw)
        sa := Sin(3.14159*sw)
        b := HBrush(sxp - 14, ty, 14, CURPV, FA(Alpha(acc, 0), fp), FA(Alpha(AccHi(acc, 0.5), Round(120*sa)), fp))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", sxp - 14, "float", ty, "float", 14, "float", CURPV), DelB(b)
        b := HBrush(sxp, ty, 14, CURPV, FA(Alpha(AccHi(acc, 0.5), Round(120*sa)), fp), FA(Alpha(acc, 0), fp))
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", b, "float", sxp, "float", ty, "float", 14, "float", CURPV), DelB(b)
    }
    Pop(stTC)
    DllCall("gdiplus\GdipDeletePath", "ptr", tClip)

    ; frame, brighter when the slot is the user's own picture
    fcol := own ? acc : 0xFF6E7590
    pn := Pen(FA(Alpha(fcol, 85 + 110*Ease3(hvP) + (own ? 30*Abs(Sin(DecT(now)*0.0022)) : 0)), fp), 1.3)
    StrokeRR(tx, ty, CURPV, CURPV, 10, pn), DelP(pn)
    pn := Pen(FA(Alpha(acc, 120 + 90*Ease3(hvP)), fp), 1.4)
    loop 4 {
        q := A_Index
        cxq := (q = 1 || q = 3) ? tx + 4 : tx + CURPV - 4
        cyq := (q <= 2) ? ty + 4 : ty + CURPV - 4
        sxq := (q = 1 || q = 3) ? 1 : -1
        syq := (q <= 2) ? 1 : -1
        Line(cxq, cyq, cxq + 8*sxq, cyq, pn)
        Line(cxq, cyq, cxq, cyq + 8*syq, pn)
    }
    DelP(pn)
    ; Corner badge for a tile showing something other than the user's own pick.
    ; It used to always read DEFAULT, which was a claim the code could not back
    ; up - with no backup held, the picture is just whatever is on disk, and on
    ; a Bloxstrap machine that is frequently somebody else's mod.
    if (!own && bmp) {
        isMod := (CSR.slot[si].dsrc = 1)
        bg  := isMod ? "MOD" : "DEFAULT"
        bgw := isMod ? 40 : 50
        b := SBrush(FA(Alpha(0xFF0B0D16, 210), fp))
        FillRR(tx + 6, ty + CURPV - 21, bgw, 15, 4, b), DelB(b)
        Txt(bg, tx + 6, ty + CURPV - 21, bgw, 15, HL.fXs
          , FA(isMod ? Alpha(AMBER, 190) : 0x8AC7CBE0, fp), fmtC)
    }
    if (s.pickAt && now - s.pickAt < 620) {
        e := Ease3((now - s.pickAt)/620.0)
        ex := e*16
        pn := Pen(FA(Alpha(acc, 180*(1 - e)), fp), 2.2*(1 - e) + 0.3)
        StrokeRR(tx - ex, ty - ex, CURPV + ex*2, CURPV + ex*2, 10 + ex*0.4, pn), DelP(pn)
    }
    Pop(stT)

    ; caption + filename, in their own bands under the tile
    Txt(CUR_SLOTS[si].label, tx, ty + CURPV + 2, CURPV, 13, HL.fXs
        , FA(Alpha(Mix(0xFFC7CBE0, acc, own ? 0.45 : 0.0), own ? 210 : 130), fp), fmtC)
    if own
        nm := CurBaseName(s.src != "" ? s.src : CurSlotSrc(si))
    else
        nm := bmp ? CurSrcName(si) : "not set"
    Txt(FFMElide(nm, HL.fXs, CURPV), tx, ty + CURPV + 15, CURPV, 13, HL.fXs
        , FA(Alpha(0xFFE8EAF6, own ? 190 : 110), fp), fmtC)
}

; one label / value line in the preview detail column
CurRow(x, y, w, label, value, col, ff) {
    Txt(label, x, y, 58, 16, HL.fXs, FA(0x72C7CBE0, ff), fmtL)
    Txt(FFMElide(value, fHint, w - 62), x + 62, y - 1, w - 62, 18, fHint, FA(Alpha(col, 200), ff), fmtL)
}


; ============================================================================
; SPECIAL FEATURES - discord activity + roblox server region
; ----------------------------------------------------------------------------
; Both features read the same source: the Roblox client's own log file. Roblox
; writes a join line naming the place and the server it handed you, so tailing
; the newest log tells us what the user is playing and which machine they are
; on. Nothing is injected and nothing is written back to Roblox - this module
; only reads.
;
; The log line formats are Roblox's, not a documented API. They have changed
; before and will change again, so every parse is a RegEx that fails closed:
; a miss leaves the previous state alone and the panel says so rather than
; showing something invented.
; ============================================================================
global SPF := {}
SPF.t1      := 0.0, SPF.t2 := 0.0, SPF.t3 := 0.0, SPF.t4 := 0.0   ; eased toggles
SPF.t5      := 0.0                         ; multi-instance switch
SPF.t6      := 0.0                         ; fps boost switch
; pid -> 1 for every client this session has already trimmed, so the watcher
; does not re-trim a working set every fifteen seconds
SPF.fpsSeen := Map()
SPF.fpsN    := 0                           ; clients currently boosted
SPF.fpsLive := 0                           ; clients seen by the last apply
SPF.fpsFoc  := 0                           ; which one held the top slot
; ---- what actually TOOK, per lever, on the last apply ----
; 1 priority (read back), 2 EcoQoS opt-out, 3 timer-resolution bit,
; 4 GPU scheduling class, 5 performance-core preference.
;
; None of these five changes a single thing about what the client RENDERS, so
; none of them can raise its ceiling - they are contention levers, and they pay
; only when something else is competing for the CPU or the GPU. Counting them
; is the difference between a switch that claims a result and one that reports
; what it actually managed to do.
SPF.fpsTook := [0, 0, 0, 0, 0, 0]
SPF.fpsWhy  := ""                          ; why nothing took, when nothing did
; ---- FPS BOOST: the parts that reach outside the client process ----
; Two opt-in chips on the row, each with its own state. Neither is on by
; default: one writes to the registry and one changes OTHER people's processes,
; and both are things a user should have said yes to rather than discovered.
SPF.fpsGpuPath := ""                       ; exe path the gpu preference was written for
SPF.fpsGpuOn   := 0                        ; 1 while that preference is ours
SPF.fpsQuiet   := Map()                    ; pid -> the priority class we FOUND it at
SPF.fpsQuietNm := Map()                    ; pid -> image name, for the report
SPF.fpsQuietDn := 0                        ; 1 while the set is actually demoted
; ---- bottleneck probe ----
; fpsBusy is the busiest single client thread as a fraction of one core, or -1
; before two samples exist. fpsBound is the reading turned into a word.
SPF.fpsBusy    := -1.0
SPF.fpsBound   := ""
SPF.fpsProbe   := Map()                    ; tid -> cumulative 100ns cpu ticks
SPF.fpsProbePid := 0
SPF.fpsProbeAt := 0
SPF.fpsProbeTid := 0                       ; the thread that was busiest last full scan
SPF.fpsProbeScan := 0                      ; when that full scan happened
SPF.fpsPower   := ""                       ; battery / battery-saver advisory, "" when clear
SPF.fpsPowerAt := 0
SPF.fpsSysN    := 0                        ; system settings currently held by us
SPF.fpsPwrNote := ""                       ; what happened to the power plan, in words
SPF.fpsGpuNote := ""                       ; ... and to the per-app gpu preference
; When MULTI-ROBLOX INSTANCES was switched on, as wall-clock. A client older
; than this predates the change - see SPFMultiStale.
SPF.multiAt    := ""
; ---- what each client was BEFORE we touched it ----
; The same discipline the on-disk journal uses, applied per process: recorded
; on first sight, never overwritten by our own value on a later pass, and it is
; what the OFF branch puts back. Restoring to a hardcoded NORMAL would take
; away a client the user had raised in Task Manager themselves.
SPF.fpsPri     := Map()                    ; pid -> priority class as found
SPF.fpsGpuPri  := Map()                    ; pid -> gpu scheduling class as found
SPF.fpsThr     := Map()                    ; pid -> "ctl,state" power-throttling as found
SPF.fpsMem     := Map()                    ; pid -> memory priority as found
SPF.fpsCap     := ""                       ; the client's own framerate cap, when known
; saved accounts: {nm, ck}. ck is the live cookie, held in memory only - the
; copy on disk is DPAPI-encrypted. acctAt marks a launch in flight.
SPF.acct    := [], SPF.acctSel := 1, SPF.acctAt := 0
; the launch target box inside the accounts overlay
SPF.acctTgt := ""
SPF.acctPre := 0        ; client count before a launch, for the verify above
; per-account profile: id -> {desc, fr, fol, pres, loc, at}
SPF.acctProf := Map()
; decoded avatar bitmaps, and the point cloud for the spinner
SPF.acctHead := Map(), SPF.acctBody := Map(), SPF.acctPts := Map()
; viewport orientation. yaw spins on its own until the user grabs it, then
; keeps whatever they left it at - the auto-spin is an invitation, not a demand.
SPF.avYaw := 0.6, SPF.avPitch := 0.0, SPF.avAuto := 1, SPF.avAt := 0
SPF.avDrag := 0, SPF.avPX := 0, SPF.avPY := 0
; remove animation: the row collapses and fades before it actually goes
SPF.acctKill := 0, SPF.acctKillAt := 0
; last attempt per account key. The detail panel asks for a profile on every
; frame it draws, so a fetch that FAILS must not be retried on the next one -
; without this a dead endpoint spawns a child process sixty times a second.
SPF.acctTry := Map()
; which face of the detail pane is showing, and how far it is scrolled.
; 1 about  2 favourite games  3 groups  4 creations
SPF.acctTab := 1, SPF.acctPane := 0.0, SPF.acctPaneT := 0.0, SPF.acctTabT := 1.0
; decoded logos, and when the pane last changed face - the rows stagger in
; from that moment so a tab switch reads as the list arriving, not swapping.
SPF.acctIco := Map(), SPF.acctTabAt := 0
; How many Roblox clients are up. Counting walks a process snapshot, which is
; far too heavy for the render loop, so it is cached and refreshed on demand.
SPF.rbxN    := 0, SPF.rbxNAt := 0
SPF.sysScr  := 0.0, SPF.sysScrT := 0.0     ; the rows outgrew their window
; What this session has learned about individual servers of a place:
;   "<placeId>|<jobId>" -> km from home. Feeds SPFPickServer.
SPF.srvSeen := Map()
SPF.scr     := 0.0, SPF.scrT := 0.0
SPF.msg     := "IDLE", SPF.msgCol := 0xFFC7CBE0, SPF.msgAt := 0
SPF.flashAt := Map()
SPF.logPos  := Map(), SPF.logAt := 0        ; per-log-file read offsets
SPF.wasOn   := 0                           ; so a rescan happens only on off->on
SPF.rbxGone := 0                           ; when Roblox first went missing
SPF.inGame  := 0, SPF.place := "", SPF.job := "", SPF.ip := ""
SPF.gameNm  := ""                          ; resolved place name, "" until known
SPF.namePlace := ""                        ; place id the name lookup was fired for
; When that lookup was fired, and how long to wait before trying again. The
; claim used to be permanent: one failed request - a dropped connection, a
; Roblox API hiccup, the child killed - and the game name stayed blank for that
; place for the whole session, because SPF.place = SPF.namePlace refused every
; retry forever. Same defect the region lookup had, same fix.
SPF.nameAt := 0, SPF.nameWait := 6000
SPF.thumb   := ""                          ; game icon url for the discord asset
SPF.creator := ""                          ; who made the place
SPF.creatorId := "", SPF.creatorTy := ""   ; for the creator button
SPF.homeRegion := "", SPF.homeCC := ""     ; where WE are, for matchmaking
SPF.homeLa := "", SPF.homeLn := ""
SPF.srvLa  := "", SPF.srvLn := "", SPF.srvKm := -1
SPF.homeAt  := 0
SPF.mmLink := "", SPF.mmPriv := ""         ; typed targets: game / private server
SPF.srvList := [], SPF.srvTried := Map(), SPF.srvFor := ""
SPF.geoCache := Map()                      ; ip -> "region|cc|lat|lng"
; How many times the lookup for the CURRENT address has come back with nothing,
; and how long to wait before the next attempt. With every provider refusing -
; no network, or all three rate limited at once - the old fixed 8s retry
; spawned a process every eight seconds for the rest of the session and never
; got anywhere. This backs off to a minute instead, and any new address resets
; it, so hopping to a server that CAN be resolved is still instant.
SPF.geoFail := 0, SPF.geoWait := 8000
; 1 once the lookup has had to fall back to running in this process, which
; means the helper route is blocked - worth knowing, because the symptom
; otherwise looks identical to having no network.
SPF.geoInline := 0
; last backward sweep for a server address - see SPFIpRescan
SPF.ipScanAt := 0
; path of the log whose session is on screen right now
SPF.shownLog := ""
SPF.nameCache := Map()                     ; placeId -> "name|thumb|creator|id|type"
SPF.hunting := 0, SPF.huntPl := "", SPF.huntCode := "", SPF.huntShare := ""
SPF.huntWhich := 0                         ; 1 game link, 2 private server
SPF.tgtShare := ""                         ; share code, when the target is one
SPF.saved   := []                          ; [{id, nm}] favourite places
SPF.savedP  := []                          ; [{id, code, nm}] private servers
SPF.savTab  := 1                           ; 1 places, 2 private servers
; Rename sheet. PRIVATE SERVERS only: a saved place is identified by its place
; id and its name is the game's real name, so letting it be edited would just
; produce a library that disagrees with Roblox. A private server is the user's
; own instance of a game and there can be several of the same game - "Forsaken"
; twice tells you nothing - so a label is the only way to tell them apart.
SPF.renOpen := 0, SPF.renT := 0.0          ; sheet open + its eased state
SPF.renTxt  := "", SPF.renErr := ""
SPF.renIdx  := 0                           ; entry being renamed, index into savedP
SPF.tabT    := 0.0                         ; eased tab indicator
SPF.savSelP := 1
SPF.savAt   := 0                           ; flash when an entry is added
SPF.copyAt  := 0                           ; flash after COPY
SPF.addOpen := 0, SPF.addT := 0.0          ; the "add by id" sheet
SPF.addTxt  := "", SPF.addErr := ""       ; addTxt is ALWAYS the place id
SPF.addLink := ""                          ; the private server link, tab 2 only
SPF.view    := "", SPF.viewPrev := "", SPF.viewAt := 0, SPF.viewT := 0.0
SPF.savSel  := 1                           ; selected row in the saved overlay
SPF.stats   := Map()                       ; placeId -> live figures
SPF.shown   := Map()                       ; placeId -> eased figures, for rolling
SPF.thumbs  := Map()                       ; "placeId|n" -> banner bitmap
SPF.icons   := Map()                       ; placeId -> square icon bitmap
; ---- banner carousel ----
; bnFor is the place the rest of this state belongs to; changing selection
; resets it rather than carrying another game's index across.
SPF.bnFor   := "", SPF.bnI := 1, SPF.bnNext := 1
SPF.bnAt    := 0, SPF.bnFadeAt := 0
SPF.dscr    := 0.0, SPF.dscrT := 0.0       ; description scroll
SPF.dscrMax := 0
SPF.statAt  := 0, SPF.statFor := ""
SPF.preQ    := []                          ; ids waiting to be warmed up
global SPF_SAV_MAX := 8                    ; declared here: SPFSavedLoad runs below
SPF.mmTries := 0, SPF.mmAt := 0, SPF.mmNote := ""
SPF.joinAt  := 0
SPF.region  := "", SPF.regionCC := "", SPF.regionAt := 0, SPF.regionIP := ""
SPF.dc      := 0                           ; 0 idle 1 connecting 2 linked 3 failed
SPF.dcBadId := ""                          ; id discord explicitly refused
SPF.dcAt    := 0, SPF.dcPipe := 0, SPF.dcSent := 0, SPF.dcErr := ""
SPF.dcPushAt := 0                          ; floor between SET_ACTIVITY frames
; ---- discord sub-option state ----
SPF.userId  := "", SPF.userNm := "", SPF.userDsp := ""
SPF.userFor := ""                          ; id the lookup was fired for
; ...and when, so the claim can expire. Third place with this shape: claiming
; permanently means one failed request leaves the account nameless until the
; user happens to toggle the Discord sub-option off and on again.
SPF.userAt := 0, SPF.userWait := 6000
; focRaw is what the desktop says right now; focOn is what discord has been
; told. They are deliberately not the same value - see SPFFocusTick.
SPF.focRaw  := -1, SPF.focOn := 0, SPF.focAt := 0
SPF.focPid  := 0                           ; the client currently tabbed into
SPF.focLogKey := ""                        ; which log set we are reporting from
SPF.sess    := Map()                       ; log path -> that client's session
SPF.shownPlace := "", SPF.shownJob := ""   ; the session the panel is displaying
SPF.logOwn  := Map(), SPF.logOwnAt := 0    ; log path -> owning pid, cached
; The live pid set the ownership map was built against. A pure time cache left
; a client that had just started owning no log for eight seconds, and an
; unowned client used to mean "not in a game" - so the panel went blank for the
; whole of that window on every single launch.
SPF.logOwnKey := ""
; 1 when the displayed session belongs to a log the FOCUSED client owns. This
; is what SPFMultiBlock tests instead of the raw client count: several clients
; open is only a problem when they cannot be told apart, and usually they can.
; Seeded to 1 so the first tick, which runs before any attribution, is not
; treated as a failure.
SPF.attrOk  := 1
; Per-log throttle for the address sweep - see SPFIpRescan
SPF.ipScanFor := Map()
; Address the on-thread geo lookup has already been spent on. It is bounded to
; one attempt per address because it blocks the render thread.
SPF.geoInlineFor := ""
; ---- ONE log count for the whole module ----
; The tailer read the 4 newest logs and the ownership map covered 8, so logs
; 5-8 had a session created by SPFLogOwners and pruned by SPFLogRead on the very
; next tick: a session was born and destroyed every 1.5 s, and any join it
; carried died with it. Two numbers describing the same set was the bug.
; Declared HERE, in the auto-execute flow, and not beside SPFRecentLogs - a
; top-level `global x := v` only takes its value if control flow reaches the
; line, and the module already carries three comments about that exact trap.
global SPF_LOGN := 8
; How long the process table has to read empty before the remembered sessions
; are thrown away. Short enough that a closed client stops being reported almost
; at once, long enough that a client relaunching in place is not punished for it.
global SPF_GONE_MS := 5000
; A log untouched for this many minutes cannot describe a live session, so it is
; tailed from the end rather than replayed. See SPFLogRead.
global SPF_STALE_MIN := 10
; Slack when comparing a log line's timestamp to a client's start time. Both come
; from the same system clock, so this only absorbs the second or two between a
; client starting and it opening its log.
global SPF_TS_SLACK := 60
; UTC start of the OLDEST running Roblox client, "" when none is running.
; Refreshed by SPFLogOwners; read by SPFSessLive.
SPF.rbxStartU := ""
; Tick of the first reading that found no Roblox process. 0 while one is running.
SPF.noRbxAt := 0
SPF.u1      := 0.0, SPF.u2 := 0.0, SPF.u3 := 0.0   ; eased sub-toggle states
SPF.q1      := 0.0, SPF.q2 := 0.0, SPF.q3 := 0.0   ; ... and row 6's three
SPF.pulse   := 0                           ; set on any live update, drives the ping
SPF.saveOk  := 1                           ; cleared if a write to zeal.ini fails

global spfDiscord := 0                     ; feature 1 - discord activity
