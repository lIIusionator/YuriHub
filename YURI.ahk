}
UsageFlush() {
    global usgTot, usgSys, usgAllTot, usgDay, iniPath
    t := "", s := ""
    loop 24 {
        t .= (A_Index > 1 ? "," : "") usgTot[A_Index]
        s .= (A_Index > 1 ? "," : "") usgSys[A_Index]
    }
    try {
        IniWrite(t, iniPath, "usage", "d" usgDay)
        IniWrite(s, iniPath, "usage", "s" usgDay)
        IniWrite(usgAllTot, iniPath, "usage", "total")
    }
}
UsageTick() {
    global usgDay, usgAllTot, usgRunChk, usgRunOn, usgFlushN
    dk := FormatTime(, "yyyyMMdd")
    if dk != usgDay {
        UsageFlush()
        UsageLoad()
    }
    hr := Integer(FormatTime(, "H")) + 1
    usgTot[hr] += 1
    usgAllTot += 1
    usgRunChk += 1
    if usgRunChk >= 5 {
        usgRunChk := 0
        usgRunOn := 0
        loop SHList.Length
            if SHList[A_Index].pid && ProcessExist(SHList[A_Index].pid) {
                usgRunOn := 1
                break
            }
    }
    if abOn || usgRunOn
        usgSys[hr] += 1
