        HubThemeSet(0)
    HL.rstAt := A_TickCount
    if abOn
        RendTim(TICK_A)
    HubPoke()
}
HubThemeSet(v) {
    global hubTheme, thFrom, thTo, thAt
    if hubTheme = v
        return
    hubTheme := v
    thFrom := thT, thTo := v ? 1.0 : 0.0, thAt := A_TickCount
    try IniWrite(v, iniPath, "hub", "theme")
