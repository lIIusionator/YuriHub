; Installs vary: flat (AutoHotkey\AutoHotkey.exe), side-by-side (\v2\),
; and versioned (\v1.1.37.02\). Scan roots and one level of subfolders.
AhkRoots() {
    out := []
    for r in [A_ProgramFiles "\AutoHotkey", EnvGet("ProgramFiles(x86)") "\AutoHotkey"
            , EnvGet("LocalAppData") "\Programs\AutoHotkey", A_ScriptDir "\AutoHotkey"]
        if (r != "" && SubStr(r, 1, 1) != "\" && DirExist(r))
            out.Push(r)
    return out
}

AhkFindExe(major) {
    names := ["AutoHotkey64.exe", "AutoHotkey32.exe", "AutoHotkeyU64.exe", "AutoHotkeyU32.exe"
            , "AutoHotkeyA32.exe", "AutoHotkey.exe"]
    roots := AhkRoots()
    for r in roots {
        for n in names {
            c := r "\" n
            if FileExist(c) && AhkExeMajor(c) = major
                return c
        }
    }
    for r in roots {
        Loop Files, r "\*", "D" {
            d := A_LoopFilePath
            for n in names {
                c := d "\" n
                if FileExist(c) && AhkExeMajor(c) = major
                    return c
            }
        }
    }
    return ""
}

AhkV2Exe() {
    static p := -1
    if p != -1
        return p
    ; When compiled, A_AhkPath can resolve to this very executable - running a
    ; user script with it would just relaunch YURI, so never accept ourselves.
    if (A_AhkPath != "" && A_AhkPath != A_ScriptFullPath
        && FileExist(A_AhkPath) && AhkExeMajor(A_AhkPath) = "2")
        return p := A_AhkPath
    return p := AhkFindExe("2")
}
AhkV1Exe() {
    static p := -1
