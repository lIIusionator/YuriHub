        pa := StrSplit(d, ",")
        loop Min(24, pa.Length)
            usgTot[A_Index] := Integer(pa[A_Index])
    }
    ps := StrSplit(s, ",")
    if s != ""
        loop Min(24, ps.Length)
            usgSys[A_Index] := Integer(ps[A_Index])
    usgAllTot := 0, usgDays := 0
    try usgAllTot := Integer(IniRead(iniPath, "usage", "total", "0"))
    try usgDays := Integer(IniRead(iniPath, "usage", "days", "0"))
