#Requires AutoHotkey v2.0
#SingleInstance Off        ; must stay Off - the file-dialog / database helpers
                           ; relaunch this same binary as short-lived children

; ---- Ahk2Exe build settings -------------------------------------------------
; Compile with Ahk2Exe against the AutoHotkey v2 (64-bit) base file.
; For a custom icon, put YURI.ico beside this script and remove the extra
; leading semicolon from the SetMainIcon line below.
;@Ahk2Exe-SetName          YURI
;@Ahk2Exe-SetDescription   YURI - Control Suite
;@Ahk2Exe-SetProductName   YURI
;@Ahk2Exe-SetCompanyName   YURI
;@Ahk2Exe-SetVersion       1.0.0.0
;@Ahk2Exe-SetCopyright     YURI
;@Ahk2Exe-SetOrigFilename  YURI.exe
;;@Ahk2Exe-SetMainIcon     YURI.ico
; -----------------------------------------------------------------------------

; ---- version ----------------------------------------------------------------
; Bump BOTH of these together for every release. APP_VERSION is what the
; self-updater (see "self-update", further down) compares against the copy of
; this file in the repo, and it must stay within the first 8 KB of the file
; because that is all the check reads. SetVersion above is the exe's file
; version; the compiled updater installs a downloaded YURI.exe only if that is
; higher than the running one. ZVER, lower down, is built from these two, so
; the badge the hub draws can never disagree with the number the updater uses.
global APP_VERSION := "1.0.0"
global APP_STAGE   := ""        ; follows the number on every badge; "" once it is not a beta
; -----------------------------------------------------------------------------

; ============================================================================
;  YURI - CONTROL SUITE                                        AutoHotkey v2
; ----------------------------------------------------------------------------
;  FOUR WINDOWS, each a layered GDI+ surface with its own render loop:
;    gate -> loading -> hub (main UI)  +  overlay (autoblock) + gallery picker
;
;  Every renderer claims the shared `G` surface pointer at its top and hands
;  it back before returning, and runs Critical so they cannot interleave.
;  ResetSurface() normalises clip + transform before each frame is cleared.
;
;  CONTENTS
;     170  state                                             globals, tunables, embedded image pool
;     207  GDI+                                              startup, fonts, formats, base surfaces
;     320  FAST FLAG MANAGER                                 module state + persisted settings
;     365  FAST FLAG MANAGER: module implementation          88 fns - flags, database, writer, UI
;    2176  password gate                                     entry screen (own window + render loop)
;    2179  loading                                           boot splash trigger
;    2182  window (autoblock overlay: created dormant,...    overlay window creation
;    2199  hotkeys                                           global bindings
;    2227  main hub                                          hub window, zones, input, per-tab rendering
;    2230  autoblock feature switch                          arm/disarm the overlay
;    2270  shared UI + drawing helpers                       chips, fields, primitives reused everywhere
;    2383  loading screen                                    splash window + render loop
;    2695  main hub                                          hub window, zones, input, per-tab rendering
;    6364  script hub                                        editor, tabs, placed cards, library, profile
;    7629  password gate                                     entry screen (own window + render loop)
;    8524  interaction                                       overlay hit-testing, drag, click routing
;    9262  rebind                                            hotkey capture flow
;    9340  render                                            overlay render loop + image/surface helpers
;   10313  helpers                                           math, easing, theme, formatting



; ---- picker child process: shows the file dialog without freezing the overlay ----
if A_Args.Length >= 2 && A_Args[1] = "ahkfile" {
    Suspend true
    sel := FileSelect(3, , "Choose a script", "Scripts (*.ahk; *.txt)")
    if sel != "" {
        sBuf := Buffer(StrPut(sel, "UTF-16"))
        StrPut(sel, sBuf, "UTF-16")
        cds := Buffer(A_PtrSize*3)
        NumPut("uptr", 0x5A12, cds, 0)
        NumPut("uint", sBuf.Size, cds, A_PtrSize)
        NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
        DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    }
    ExitApp
}
; ---- database fetch child: download + parse off the UI thread ----
if A_Args.Length >= 2 && A_Args[1] = "ffdb" {
    Suspend true
    ; ---- every source, UNIONED - not the first one that answers ----
    ; This was a fallback chain: the first source that answered was written
    ; and the rest were never read, so the database was PCDesktopClient.json
    ; alone - the flags the settings server currently OVERRIDES for the desktop
    ; client. A flag the server leaves at its built-in default never appears
    ; in that file however real it is; DFFlagDebugDrawBroadPhaseAABBs is one of
    ; some six thousand. FVariables.txt is the other half: every flag defined
    ; in the client binary, with its prefix, whether the server touches it or
    ; not. The retired-flag check (the ffupd child) has read it all along; the
    ; database now does too. One name per line, sorted, prefixed - the same
    ; file the panel always read, only complete.
    ; Studio is deliberately NOT here. The old list named StudioClient.json
    ; (404 from the tracker for some time); its successor, PCStudioApp.json,
    ; would offer two thousand Studio-only names that the retired-flag check
    ; (the ffupd child, which reads the same three sources as this) would then
    ; report as "not in the live flag list" and drop. A database and a clean
    ; pass that disagree about what exists is worse than a shorter database.
    srcs := ["https://raw.githubusercontent.com/MaximumADHD/Roblox-FFlag-Tracker/main/PCDesktopClient.json"
           , "https://raw.githubusercontent.com/MaximumADHD/Roblox-FFlag-Tracker/main/PCClientBootstrapper.json"
           , "https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/roblox/FVariables.txt"]
    outPath := "`f"
    names := "", seen := Map(), got := 0
    for src in srcs {
        body := ""
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.SetTimeouts(8000, 8000, 15000, 30000)
            whr.Open("GET", src, false)
            whr.SetRequestHeader("User-Agent", "Velostrap")
            whr.Send()
            if (whr.Status != 200)
                continue
            body := whr.ResponseText
        } catch
            continue
        if (body = "")
            continue
        pos := 1
        if InStr(src, "FVariables") {
            ; "[C++] DFFlagDebugDrawBroadPhaseAABBs" - a tag, then the name
            while (pos := RegExMatch(body, 'm)^\[[^\]]+\]\s+([A-Za-z0-9_]+)', &m, pos)) {
                nm := m[1]
                if !seen.Has(nm) {
                    seen[nm] := true
                    names .= nm "`n"
                }
                pos += m.Len
            }
        } else {
            while (pos := RegExMatch(body, '[{,]\s*"([A-Za-z0-9_]+)"\s*:', &m, pos)) {
                nm := m[1]
                if !seen.Has(nm) {
                    seen[nm] := true
                    names .= nm "`n"
                }
                pos += m.Len - 1
            }
        }
        got++
    }
    if (names != "") {
        tmp := A_Temp "\yuri_ffdb.txt"
        try {
            FileOpen(tmp, "w", "UTF-8").Write(Sort(RTrim(names, "`n")) "`n")
            outPath := tmp
        }
    }
    sBuf := Buffer(StrPut(outPath, "UTF-16"))
    StrPut(outPath, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A14, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}
; ---- flag-name update child: fetch the current live flag list off the UI thread ----
; Pulls THREE sources and unions them. FVariables.txt alone carries ~10k names;
; PCDesktopClient.json carries ~22k, and the two overlap only partly - most of
; the network and physics tunables people actually stage (MaxDataPayloadSize,
; PhysicsSenderMaxBandwidthBps, S2PhysicsSenderRate) are in the JSON dumps and
; absent from FVariables. Reconciling against FVariables alone therefore
; reported a large part of a healthy flag set as retired. The ffdb child has
; been reading the richer source all along for the database panel; this is the
; same list, for the pass that needs it more.
;
; Also tokenises here rather than in the parent. FFMUpdateGot runs on the UI
; thread, and ~30k regex passes there is a visible freeze; this process is off
; that thread and about to exit anyway. Output is one line per flag:
;     fullName <TAB> bareName <TAB> Tok1 Tok2 Tok3
if A_Args.Length >= 2 && A_Args[1] = "ffupdate" {
    Suspend true
    outPath := "`f"
    seen := Map(), order := []

    FFUFetch(url) {
        try {
            whr := ComObject("WinHttp.WinHttpRequest.5.1")
            whr.SetTimeouts(8000, 8000, 15000, 30000)
            whr.Open("GET", url, false)
            whr.SetRequestHeader("User-Agent", "Velostrap")
            whr.Send()
            if (whr.Status = 200)
                return whr.ResponseText
        }
        return ""
    }

    srcOk := 0
    for src in ["https://raw.githubusercontent.com/MaximumADHD/Roblox-FFlag-Tracker/main/PCDesktopClient.json"
              , "https://raw.githubusercontent.com/MaximumADHD/Roblox-FFlag-Tracker/main/PCClientBootstrapper.json"] {
        body := FFUFetch(src)
        if (body = "")
            continue
        srcOk++
        pos := 1
        while (pos := RegExMatch(body, '[{,]\s*"([A-Za-z0-9_]+)"\s*:', &m, pos)) {
            if !seen.Has(m[1])
                seen[m[1]] := true, order.Push(m[1])
            pos += m.Len - 1
        }
    }
    body := FFUFetch("https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/roblox/FVariables.txt")
    if (body != "") {
        srcOk++
        pos := 1
        while (pos := RegExMatch(body, "m)^\[.*?\]\s*(\w+)", &m, pos)) {
            if !seen.Has(m[1])
                seen[m[1]] := true, order.Push(m[1])
            pos += m.Len
        }
    }

    if (order.Length) {
        UPFX := "^(DynamicFastFlag|DynamicFastInt|DynamicFastString|DynamicFastLog"
              . "|DFString|SFString|FString|DFFlag|SFFlag|DFInt|DFLog|SFLog|SFInt|FFlag|FInt|FLog)"
        tmp := A_Temp "\yuri_ffupd.txt"
        try {
            fh := FileOpen(tmp, "w", "UTF-8")
            ; ---- the first line says how much of the list this is ----
            ; Three sources, and a fetch that fails is skipped rather than
            ; fatal - so a list can come back with one or two of them, and it
            ; used to come back looking whole. The parent read it as the live
            ; list, UPDATE renamed healthy flags to their nearest lookalikes
            ; and CLEAN dropped the rest as retired. No tab in this line, so an
            ; older parser skips it.
            fh.Write("#sources " srcOk " 3`n")
            ; flushed every 400 lines: `.=` on a string heading for 2.5MB is the
            ; kind of loop that turns linear work quadratic
            chunk := "", c := 0
            for nm in order {
                bn := RegExReplace(nm, UPFX)
                ts := "", p := 1
                ; [A-Z]+(?![a-z]) FIRST so a run of capitals stays one token.
                ; [A-Z][a-z]* alone shredded NOUCount into N,O,U,Count and
                ; GLEnableHQShaders into G,L,Enable,H,Q,Shaders - and a
                ; single-letter token is present in 56-94% of the live list, so
                ; it satisfied the old all-tokens-present test for free while
                ; narrowing nothing.
                while (p := RegExMatch(bn, "[A-Z]+(?![a-z])|[A-Z][a-z]*|[0-9]+", &tm, p)) {
                    ts .= (ts = "" ? "" : " ") tm[0]
                    p += tm.Len
                }
                chunk .= nm "`t" bn "`t" ts "`n"
                if (++c >= 400) {
                    fh.Write(chunk), chunk := "", c := 0
                }
            }
            if (chunk != "")
                fh.Write(chunk)
            fh.Close()
            outPath := tmp
        }
    }
    sBuf := Buffer(StrPut(outPath, "UTF-16"))
    StrPut(outPath, sBuf, "UTF-16")
    cds := Buffer(A_PtrSize*3)
    NumPut("uptr", 0x5A23, cds, 0)
    NumPut("uint", sBuf.Size, cds, A_PtrSize)
    NumPut("ptr", sBuf.Ptr, cds, A_PtrSize*2)
    DllCall("SendMessage", "ptr", Integer(A_Args[2]), "uint", 0x4A, "ptr", 0, "ptr", cds)
    ExitApp
}
