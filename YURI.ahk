; ================= main hub =================
; ---- the screen is WATCHED, not merely notified ----
; Everything above hangs off WM_DISPLAYCHANGE, and that message is the reason
; "change resolution, nothing works until you restart" survived a fix that
; looked complete. It is broadcast to top-level windows, it can arrive before
; the metrics it is announcing have settled, and a client changing mode inside
; a fullscreen swap can produce one, several, or none that reach this script.
;
; So the metrics are polled instead. Four GetSystemMetrics calls a second is
; nothing next to a single hub frame, it needs no message to arrive, and it
; cannot be early: it only fires once the numbers have ACTUALLY moved. The
; message handler stays wired as well - when it does arrive it is faster, and
; the watcher then sees nothing to do.
ScreenDpi() {
    ; A_ScreenDPI is read once when the script starts and never again, which is
    ; why a DPI change needed a restart. GetDpiForSystem is live; it is Win10
    ; 1607+, so the built-in remains the fallback.
    try return DllCall("user32\GetDpiForSystem", "uint")
    return A_ScreenDPI
}
; ---- one signature, and a SETTLE before anything reacts to it ----
; This used to be six statics compared in place, and it was only half the
; guard: ScreenWatch compared, but OnMessage(WM_DISPLAYCHANGE) went straight
; to DisplayChanged with no comparison at all. A fullscreen client sends that
; message when it swaps modes AND when it swaps back, at the SAME resolution -
; alt+enter in Roblox was enough to raise the notice and close the hub, which
; is the one thing the notice exists to avoid doing spuriously. The message is
; now a HINT to look, exactly like the timer tick; only the metrics decide.
;
; The settle window is the second half. Entering fullscreen can blank and
; re-detect displays: for a few hundred ms the monitor count drops, the
; bounding box shrinks, and then everything comes back where it was. A change
; therefore has to still be true a beat later before it counts (see SETTLE), and a
; signature that returns to the last accepted one clears the pending candidate
; instead of firing.
;
; MonitorGet, not MonitorGetWorkArea. The work area moves when the taskbar
; auto-hides, and the shell hides the taskbar for any fullscreen window - so
; the work area was reporting a display change every time a game went
; fullscreen. The monitor RECT only moves when the monitor's mode moves, which
; is the thing that actually invalidates the hub. The hub is still SIZED
; against the work area; being a little off-centre because the taskbar hid is
; not worth closing the application over.
ScreenSig() {
    vx := DllCall("GetSystemMetrics", "int", 76)
    vy := DllCall("GetSystemMetrics", "int", 77)
    vw := DllCall("GetSystemMetrics", "int", 78)
    vh := DllCall("GetSystemMetrics", "int", 79)
    if (vw < 100 || vh < 100)                 ; a mode mid-switch reports nonsense
        return ""                             ; "" = unreadable, never recorded
    ; ---- the VIRTUAL screen is not the only thing that can move ----
    ; SM_*VIRTUALSCREEN is the bounding box of every monitor, and a bounding box
    ; is exactly the measurement that can stay still while the display the hub is
    ; actually on changes underneath it: drop the secondary monitor's resolution
    ; on a side-by-side pair and the box is unchanged; change the primary's mode
    ; while a larger secondary defines both extents and it is unchanged again.
    mon := ""
    try {
        MonitorGet(MonitorGetPrimary(), &wL, &wT, &wR, &wB)
        mon := wL "," wT "," wR "," wB "," MonitorGetCount()
    }
    if (mon = "")                             ; enumeration failed mid-switch
        return ""
    return vx "," vy "," vw "," vh "," ScreenDpi() "," mon
}
; SELF-SEEDING, with the state in statics rather than globals. A separate seed
; call would have to run after its own `global x := 0` line or be wiped by it -
; the load-order trap this module has already been caught by three times - and
; statics inside the only function that touches them cannot be ordered wrong.
; The first look records and returns without acting.
;
; Returns 1 at most ONCE per real change: it commits the new signature on the
; same call that reports it, so the timer and the message handler can both call
; this freely and only one of them will win.
ScreenMoved() {
    ; A static, NOT a top-level `global SETTLE := 900`. This function is armed
    ; by SetTimer ~1150 lines above where such a line would sit, and a top-level
    ; initialiser runs when control REACHES it - a display event during the
    ; splash would find it unset. That is the trap documented at RN_gui.
    static SETTLE := 900
    static last := "", pend := "", pendAt := 0
    sig := ScreenSig()
    if (sig = "")
        return 0
    if (last = "") {
        last := sig, pend := "", pendAt := 0
        return 0                              ; first look: record, do not react
    }
    if (sig = last) {
        pend := "", pendAt := 0               ; back where it started - a blip
        return 0
    }
    if (sig != pend) {
        pend := sig, pendAt := A_TickCount    ; new candidate, start its clock
        return 0
    }
    if (A_TickCount - pendAt < SETTLE)
        return 0                              ; still settling
    last := sig, pend := "", pendAt := 0
    return 1
}
ScreenWatch() {
    if ScreenMoved()
        DisplayChanged()
}
; The message path. Confirms against the metrics first, then re-arms a fast
; re-check: WM_DISPLAYCHANGE can arrive BEFORE the mode it announces has
; settled, so the first look after it may still read the old screen. The extra
; polls close the gap between the message and the next 1 Hz tick without
; letting the message itself decide anything.
DisplayNudge(*) {
    if ScreenMoved()
        DisplayChanged()
    else
        SetTimer(DisplayPoll, -150)
}
DisplayPoll() {
    static n := 0
    if ScreenMoved() {
        n := 0
        DisplayChanged()
        return
    }
    if (++n < 12)                             ; ~1.8 s of 150 ms looks, then stop
        SetTimer(DisplayPoll, -150)
    else
        n := 0
}
; ---- one reaction, two triggers ----
; WM_DISPLAYCHANGE used to reach PuzScreenChanged ONLY, so the notice hung off
; the 1 Hz poller alone. That is backwards from what the rest of this file
; argues (see PuzScreenGuard): the message is the fast path and the watcher is
; the one that catches what the message misses - and the notice, which is the
; user-visible half, was wired to the slow one and to nothing else. Both now
; land here, and this is idempotent: HubResNotice returns early on a notice that
; is already up, and PuzScreenChanged is a rebuild that costs nothing to repeat.
;
; Independently guarded. OnError logs and SUPPRESSES, so a throw in the puzzle
; refresh would have taken the notice down with it and left no dialog and no
; visible symptom - which is exactly how this looked. Whatever else fails, the
; user gets told the resolution moved.
DisplayChanged(*) {
    ; ---- a stage trail, because this has failed silently three times ----
    ; Each line below is written before the step it names, so the LAST line in
    ; errors.log says exactly how far the reaction got. A hard fault inside a
    ; DllCall writes no error of its own - it takes the process down with no
    ; Error object - so the trail is the only thing that can distinguish "never
    ; detected" from "detected, then died in the puzzle refresh".
    try YuriLog("DISPLAY change reaction: start")
    ; ---- the NOTICE goes first ----
    ; PuzScreenChanged used to run ahead of it, and `try` does not make that
    ; safe. It frees capture DIBs, destroys the marker window and its GDI+
    ; surface, then rebuilds - and this file already records what that class of
    ; failure looks like: "OnError cannot see an access violation inside a
    ; DllCall, and a GDI+ handle used after it was disposed takes the process
    ; down with no Error object and no chance to write anything." A `try` catches
    ; a thrown Error; it does not catch the process dying. So the half that has
    ; to happen no matter what now happens first, and the half that touches
    ; handles runs after the user has already been told.
    ;
    ; If the log shows a START with no EXIT and no ERROR line after a resolution
    ; change, that is the case above and this ordering is what makes the notice
    ; survive it.
    try HubResNotice()
    try YuriLog("DISPLAY notice armed - starting puzzle refresh")
    try PuzScreenChanged()
    try YuriLog("DISPLAY change reaction: done")
}

; ---- the notice ----
; Its own window, like the grid inspector and for the same reason: it has a
; button, and the suite's other overlays are WS_EX_TRANSPARENT so the game can
; be clicked through them. Not activatable either - it appears over a running
; game and must not steal focus to say so.
;
; RN_gui / RN_at / RN_closing / RN_hot / RN_down / RN_h / RN_W / RN_H /
; RN_wasHub ARE NOT DECLARED HERE. They are in the state block at the top of the
; file, with the rest of the suite's globals, because a top-level initialiser
; runs when control reaches it and this point is ~1050 lines below the top-level
; HubOpen() call - see the note there.

; ---- the opening gate ----
; A modal over the WHOLE hub rather than a strip in the header, because the
; thing it says has to be read once and then never again, and a strip that can
; be scrolled past or ignored is a strip that gets ignored. It dims everything
; behind it and refuses every click that is not its own button, which is the
; same contract the keybind-clash card uses inside the PUZZLE AI panel - only
; hub-wide, so no control anywhere has to opt in.
; ---- the state lives in HL, NOT in top-level globals ----
; It was two `global x := 0` lines, and they sat 1064 lines BELOW the top-level
; HubOpen() call. A top-level global with an initialiser runs when control
; reaches it, so HubOpen set the timestamp and then this line wiped it before
; the first frame - HubGateDraw returned on its first line, every frame,
; forever. That is the fifth time this file has been caught by exactly that,
; and the previous four were all fixed by moving a declaration, which only
; works until the next one is added in the wrong place.
;
; HL is built inside HubOpen and cannot be re-initialised behind it, so putting
; the state there removes the ordering question instead of answering it.
HubGateUp() => (IsObject(HL) && HL.HasOwnProp("gateAt") && HL.gateAt != 0)
; Which of the two cards is up. Defaults to the opening gate, so nothing that
; predates gateKind can read as the resolution notice by accident.
HubGateKind() => (IsObject(HL) && HL.HasOwnProp("gateKind")) ? HL.gateKind : 1
; ---- one source for the card's box ----
; The draw and the hit test both ask for it here. The button was positioned off
; HL.ch independently of the card and ended up 12 px under the divider rule; a
; second copy of a rectangle is a second thing to keep in step, and it was not.
; The RESTING position - the draw adds its own entrance slide on top.
HubGateCard(&kx, &ky, &kw, &kh) {
    kw := 486, kh := 232
    kx := HL.pd + (HL.cw - kw)/2
    ky := HL.pd + (HL.ch - kh)/2 - 4
}
HubGateBtn(&bx, &by, &bw, &bh) {
    HubGateCard(&kx, &ky, &kw, &kh)
    bw := 150, bh := 34
    bx := kx + (kw - bw)/2
    by := ky + kh - bh - 24            ; anchored to the card's floor, not the hub's
}
; ---- nothing underneath a modal card may stay live ----
; The gate refuses every click but its own, and the hit test returns 0 for the
; whole hub while it is up - but a caret that was already blinking in the script
; editor, an open dropdown, or a detail sheet mid-scroll all keep drawing and
; keep believing they have the pointer. Dropped here rather than left to look
; interactive behind a sheet that will not let them be touched.
HubGateClearBelow() {
    if SH.focus
        ScrBlur()
    FFMBlur()
    try FFMCloseView()
    if (RSET.dd)
        try RSetDDClose()
    HL.drag := 0, HL.dragZone := 0
}
HubGateDismiss() {
    if (!HubGateUp() || HL.gateOut)
        return
    HL.gateOut := A_TickCount
    HubPoke()
}
HubGateDraw(now) {
    if !HubGateUp()
        return
    gKind := HubGateKind()             ; resolved once, read throughout
    ; in on 420 ms, out on 300, both from one timestamp so a late frame cannot
    ; strand it half-drawn
    if HL.gateOut {
        e := Clamp((now - HL.gateOut)/300.0, 0.0, 1.0)
        f := 1 - Ease3(e)
        if (e >= 1.0) {
            HL.gateAt := 0, HL.gateOut := 0
            ; ---- the update card forgets its verdict once it has left ----
            ; So the next CHECK starts from CHECKING rather than a stale
            ; answer, and nothing it was waiting on is left running.
            if (gKind = 3)
                UpdReset()
            ; ---- the resolution card closes the hub, and only once it is gone ----
            ; Sequenced after the exit rather than fired from the click, so the
            ; card is seen to leave before the hub starts its own close. Firing
            ; both at the press ran the two animations over each other.
            ; ---- a launch-check card that was waiting on this one ----
            ; Same sequencing, for the same reason: it enters once the opening
            ; gate has fully left, never over it - and not after the resolution
            ; card, which is closing the hub.
            if (gKind = 2)
                HubClose()
            else if HL.updPend
                UpdRaise()
            else if (gKind = 1 && !TutSeen())
                TutStart(1)                     ; the first run: the tour, once the welcome card has gone
            return
        }
    } else
        f := Ease3(Clamp((now - HL.gateAt)/420.0, 0.0, 1.0))
    if (f <= 0.004)
        return
    el  := now - (HL.gateOut ? HL.gateOut : HL.gateAt)
    pd  := HL.pd, cw := HL.cw, ch := HL.ch
    acc := hubAccent
    ; ---- the dim ----
    ; Two layers: a flat wash, and a vignette that pulls the corners darker so
    ; the eye is driven to the middle rather than merely told the hub is off.
    b := SBrush(FA(0xD8060710, f))
    FillRR(pd - 2, pd - 2, cw + 4, ch + 4, 22, b), DelB(b)
    b := VBrush(pd - 2, pd - 2, cw + 4, ch/2, FA(0x66000000, f), FA(0x00000000, f))
    FillRR(pd - 2, pd - 2, cw + 4, ch/2, 22, b), DelB(b)
    b := VBrush(pd - 2, pd + ch/2, cw + 4, ch/2 + 2, FA(0x00000000, f), FA(0x66000000, f))
    FillRR(pd - 2, pd + ch/2, cw + 4, ch/2 + 2, 22, b), DelB(b)

    HubGateCard(&kx, &ky, &kw, &kh)
    ky += (1 - f)*20                   ; the entrance slide, draw-only
    ShadowDraw(kx, ky + 6, kw, kh, 20, 8, 26, 26, f, 1.0)
    b := VBrush(kx, ky, kw, kh, FA(0xFF191D33, f), FA(0xFF0D0F1D, f))
    FillRR(kx, ky, kw, kh, 20, b), DelB(b)
    MicroBackdrop(kx, ky, kw, kh, 20, acc, f, now, 0.95)
    pn := Pen(FA(Alpha(acc, 165), f), 1.2)
    StrokeRR(kx, ky, kw, kh, 20, pn), DelP(pn)
    ; the accent rail down the leading edge, the hub card's own signature
    b := VBrush(kx + 1, ky + 16, 2, kh - 32, FA(Alpha(AccHi(acc, 0.5), 215), f)
                                           , FA(Alpha(acc, 35), f))
    FillRR(kx + 1, ky + 16, 2, kh - 32, 1, b), DelB(b)
    ; and the top edge sweeping out from the middle
    sw := (kw - 160)*f
    b := HBrush(kx + kw/2 - sw/2, ky + 0.8, sw, 2
              , FA(Alpha(AccHi(acc, 0.45), 30), f), FA(Alpha(AccHi(acc, 0.45), 230), f))
    FillRR(kx + kw/2 - sw/2, ky + 0.8, sw, 2, 1, b), DelB(b)

    ; ---- brand line ----
    Txt(APPNAME, kx + 28, ky + 20, 90, 18, fBrand, FA(0xC8E8EAF6, f), fmtL)
    bwz := MeasureW(APPNAME, fBrand)
    bp := Alpha(acc, Round(150 + 70*(Sin(DecT(now)*0.004) + 1)/2))
    b := SBrush(FA(bp, f))
    FillEll(kx + 32 + bwz, ky + 27, 5, 5, b), DelB(b)
    Txt("CONTROL SUITE", kx + 29, ky + 36, 120, 10, HL.fS, FA(Alpha(acc, 155), f), fmtL)
    ; the chip on the right: the live resolution for the two screen cards, the
    ; running version for the update card - each time, the thing the card is about
    rs := (gKind = 3) ? ZVER : PZ_vw " x " PZ_vh
    rw := MeasureW(rs, HL.fXs) + 22
    b := SBrush(FA(Alpha(0xFFFFFF, 16), f))
    FillRR(kx + kw - 28 - rw, ky + 22, rw, 18, 9, b), DelB(b)
    pn := Pen(FA(Alpha(acc, 90), f), 1)
    StrokeRR(kx + kw - 28 - rw, ky + 22, rw, 18, 9, pn), DelP(pn)
    Txt(rs, kx + kw - 28 - rw, ky + 25, rw, 13, HL.fXs, FA(Alpha(0xFFC7CBE0, 215), f), fmtC)
    FadeLine(kx + 26, kx + kw - 26, ky + 54, 0x1EFFFFFF, f)

    ; ---- the glyph, with a ring that punches outward on arrival ----
    gx := kx + 60, gy := ky + 112
    if (gKind = 3)
        UpdGlyph(gx, gy, acc, f, now)
    else {
        rr := 26 + 30*(1 - Ease3(Clamp(el/620.0, 0.0, 1.0)))
        ra := HL.gateOut ? 0 : (1 - Clamp(el/620.0, 0.0, 1.0))
        if (ra > 0.01) {
            pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(170*ra)), f), 1.4)
            Ell(gx - rr, gy - rr, rr*2, rr*2, pn), DelP(pn)
        }
        b := SBrush(FA(Alpha(acc, 26), f))
        FillEll(gx - 27, gy - 27, 54, 54, b), DelB(b)
        pn := Pen(FA(Alpha(acc, Round(95*f)), f), 1.4)
        StrokeRR(gx - 19, gy - 15, 30, 22, 4, pn), DelP(pn)
        pn := Pen(FA(Alpha(AccHi(acc, 0.42), 240), f), 1.9)
        StrokeRR(gx - 14, gy - 10, 30, 22, 4, pn)
        Line(gx - 6, gy + 17, gx + 8, gy + 17, pn)
        Line(gx + 1, gy + 12, gx + 1, gy + 17, pn), DelP(pn)
    }

    ; ---- copy, entering line by line ----
    ; Each line waits on the one above it. The stagger is what the hub's own
    ; panels do on open, and it is the difference between a card that appears
    ; and a card that arrives. The update card re-runs it on every change of
    ; phase, from its own clock, so a verdict arrives the way the card did.
    tx := kx + 108, tw := kw - 136
    elc := (gKind = 3 && !HL.gateOut) ? now - HL.updAt : el
    l1 := Ease3(Clamp((elc - 60)/380.0, 0.0, 1.0)) * (HL.gateOut ? f : 1)
    l2 := Ease3(Clamp((elc - 140)/380.0, 0.0, 1.0)) * (HL.gateOut ? f : 1)
    l3 := Ease3(Clamp((elc - 210)/380.0, 0.0, 1.0)) * (HL.gateOut ? f : 1)
    ; ---- one card, three things to say ----
    ; The opening gate warns that a resolution change will cost the hub; the
    ; resolution card is that promise being kept; the update card is the
    ; dashboard's question being answered. Same geometry, same stagger.
    if (gKind = 3)
        UpdCardCopy(&gTtl, &gL1, &gL2)
    else if (gKind = 2) {
        gTtl := "RESOLUTION CHANGE DETECTED"
        gL1  := "The hub builds its layout for the screen it opened on,"
        gL2  := "so it cannot follow this one. It will close."
    } else {
        gTtl := "BEFORE YOU START"
        gL1  := "The hub builds its layout for the screen it opens on."
        gL2  := "Change resolution and it will put itself away and say so."
    }
    Txt(gTtl, tx + (1 - l1)*10, ky + 78, tw, 24, HL.fV
      , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.22), 248), f*l1), fmtL)
    ; elided once per wording, not per frame: the two measures are cheap, but
    ; the card animates at full rate and the words change a handful of times
    gck := gKind "|" gTtl "|" gL1 "|" gL2
    if (HL.gateCapKey != gck)
        HL.gateCapKey := gck, HL.gateCap := [FFMElide(gL1, fHint, tw), FFMElide(gL2, fHint, tw)]
    Txt(HL.gateCap[1], tx + (1 - l2)*10, ky + 108, tw, 18, fHint, FA(0xBEC7CBE0, f*l2), fmtL)
    Txt(HL.gateCap[2], tx + (1 - l3)*10, ky + 128, tw, 18, fHint, FA(0xBEC7CBE0, f*l3), fmtL)

    ; ---- the buttons ----
    if (gKind = 3) {
        HubUpdBtns(&by, &bw, &bh, &x1, &z1, &x2, &z2, &n)
        by += (1 - f)*20               ; they ride the card's slide
        FadeLine(kx + 26, kx + kw - 26, by - 18, 0x1EFFFFFF, f)
        ; and follow the copy in, a beat behind its third line - but leave
        ; with the card, not on their own clock
        bf := HL.gateOut ? f : f*Ease3(Clamp((elc - 300)/320.0, 0.0, 1.0))
        if (n >= 1)
            HubGateBtnDraw(z1, x1, by, bw, bh, z1 = 2002 ? (HL.updPhase = 2 ? "UPDATE" : "CLOSE") : "CANCEL"
                         , acc, bf, now, z1 = 2002)
        if (n = 2)
            HubGateBtnDraw(z2, x2, by, bw, bh, "CANCEL", acc, bf, now, 0)
        return
    }
    HubGateBtn(&bx, &by, &bw, &bh)
    by += (1 - f)*20                   ; the button rides the card's slide
    FadeLine(kx + 26, kx + kw - 26, by - 18, 0x1EFFFFFF, f)
    HubGateBtnDraw(1210, bx, by, bw, bh, (gKind = 2) ? "CLOSE HUB" : "GOT IT", acc, f, now, 1)
}
; ---- the card's button ----
; It was a rounded rectangle with a word in it, which on a card carrying this
; much else read as the least considered thing on screen. Six layers now, all
; of them doing something: a halo that puts it above the card, a gradient
; body, a top-edge highlight so it reads as lit from above rather than merely
; filled, a sheen that crosses on hover, a ring that expands out of the press,
; and the label lifting a hair on hover and sinking on press - which is how
; every button from FFMBtn down draws its label, centred across the whole
; face with no glyph.
;
; primary = 0 is the way back - CANCEL beside UPDATE. The card's own surface
; with the accent as an edge, and the hub's centre-out underline on hover, so
; it is unmistakably a button and unmistakably not the offer.
HubGateBtnDraw(z, bx, by, bw, bh, label, acc, f, now, primary := 1) {
    hv := HL.h.Get(z, 0.0)
    pAt := FFM.clickAt.Has(z) ? now - FFM.clickAt[z] : 99999
    pr  := (pAt < 150) ? 1 - pAt/150.0 : 0.0
    lift := -2.0*hv + 2.4*pr
    st := PushXform(bx + bw/2, by + bh/2 + lift, 1 - 0.025*pr, 0)
    x0 := bx, y0 := by + lift
    ; the ring the press throws off - outward and fading, the suite's own idiom
    if (pAt < 420) {
        rp := pAt/420.0
        gr := 6 + 26*Ease3(rp)
        pn := Pen(FA(Alpha(AccHi(acc, 0.45), Round(150*(1 - rp))), f), 1.6*(1 - rp) + 0.4)
        StrokeRR(x0 - gr, y0 - gr, bw + gr*2, bh + gr*2, 10 + gr, pn), DelP(pn)
    }
    if primary {
        ; halo: lifts it off the card instead of just brightening in place
        if (hv > 0.01) {
            b := SBrush(FA(Alpha(AccHi(acc, 0.4), Round(34*hv)), f))
            FillRR(x0 - 6, y0 - 5, bw + 12, bh + 10, 14, b), DelB(b)
        }
        ShadowDraw(x0, y0 + 2, bw, bh, 10, 4, 26, 14, f*(0.55 + 0.45*hv), 1.0)
        b := VBrush(x0, y0, bw, bh, FA(Alpha(AccHi(acc, 0.5), Round(198 + 40*hv)), f)
                                  , FA(Alpha(acc, Round(140 + 40*hv)), f))
        FillRR(x0, y0, bw, bh, 10, b), DelB(b)
        ; lit from above: a bright hairline along the top inside edge
        b := VBrush(x0 + 6, y0 + 1, bw - 12, bh*0.42, FA(Alpha(0xFFFFFF, Round(52 + 26*hv)), f)
                                                    , FA(Alpha(0xFFFFFF, 0), f))
        FillRR(x0 + 6, y0 + 1, bw - 12, bh*0.42, 8, b), DelB(b)
        ; a sheen that crosses once as the pointer arrives
        if (hv > 0.02 && hv < 0.995) {
            sx2 := x0 - 30 + (bw + 60)*hv
            pth := RRPath(x0, y0, bw, bh, 10)
            DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pth, "int", 0)
            b := HBrush(sx2 - 16, y0, 32, bh, FA(Alpha(0xFFFFFF, 0), f)
                                            , FA(Alpha(0xFFFFFF, Round(46*Sin(hv*3.14159))), f))
            FillRR(sx2 - 16, y0, 32, bh, 0, b), DelB(b)
            DllCall("gdiplus\GdipResetClip", "ptr", G)
            DllCall("gdiplus\GdipDeletePath", "ptr", pth)
        }
        pn := Pen(FA(Alpha(AccHi(acc, 0.6), Round(215 + 40*hv)), f), 1.3)
        StrokeRR(x0, y0, bw, bh, 10, pn), DelP(pn)
        tc := FA(0xFFFFFFFF, f)
    } else {
        if (hv > 0.01) {
            b := SBrush(FA(Alpha(0xFFFFFF, Round(10*hv)), f))
            FillRR(x0 - 4, y0 - 3, bw + 8, bh + 6, 12, b), DelB(b)
        }
        b := VBrush(x0, y0, bw, bh, FA(Alpha(0xFFFFFF, Round(14 + 10*hv)), f)
                                  , FA(Alpha(0xFFFFFF, Round(6 + 6*hv)), f))
        FillRR(x0, y0, bw, bh, 10, b), DelB(b)
        pn := Pen(FA(Alpha(acc, Round(90 + 110*hv)), f), 1.1)
        StrokeRR(x0, y0, bw, bh, 10, pn), DelP(pn)
        if (hv > 0.02 && !hubLowPerf) {
            uw := (bw - 24)*Ease3(hv)
            b := SBrush(FA(Alpha(acc, Round(160*hv)), f))
            FillRR(x0 + bw/2 - uw/2, y0 + bh - 4, uw, 2, 1, b), DelB(b)
        }
        ; THMix, not Mix: TxtP draws what it is given, and a raw near-white is
        ; invisible on the card once the light theme has turned it to paper
        tc := FA(Alpha(THMix(0xFFC7CBE0, 0xFFFFFFFF, hv), Round(200 + 55*hv)), f)
    }
    TxtP(label, x0, y0 - 1 - (hubLowPerf ? 0 : 0.6*hv - 0.8*pr), bw, bh, fBadge, tc, fmtC)
    Pop(st)
}
RNw() => Round(RN_W*scaleF)
RNh() => Round(RN_H*scaleF)

HubResNotice() {
    global RN_at, RN_closing, RN_wasHub, RN_h, RN_hot, RN_down, RN_downAt, RN_hold, RN_last, RN_probed, hubHidden
    ; The card reads PZ_vw/PZ_vh, and PuzScreenChanged - which refreshes them -
    ; runs AFTER this so its handle teardown cannot take the notice with it.
    ; Sync here instead: four GetSystemMetrics calls, no handles, nothing that
    ; can fault.
    try PuzScreenSync()
    ; ---- said INSIDE the hub, and the hub closes when you answer ----
    ; This was a separate top-level window for four attempts, and every one of
    ; them failed the same way: the suite presents its surfaces through
    ; UpdateLayeredWindow, that call does not present on every machine, and a
    ; layered window that never appears is indistinguishable from a notice that
    ; was never raised. The hub's own surface demonstrably renders - you are
    ; looking at it when the resolution changes - so the notice belongs on it.
    ;
    ; It is the opening gate's card, not a copy of it: same geometry, same
    ; entrance, same modal dim that refuses every click but its own button, same
    ; glyph and stagger. gateKind picks the words and what the button does. The
    ; two are the same promise from the two ends - the gate warns the hub cannot
    ; follow a resolution change, and this is that being kept.
    ;
    ; The hub is NOT hidden here any more. It stays exactly where it is, holding
    ; the card, until the button is pressed; HubGateDraw calls HubClose once the
    ; card has finished leaving.
    if (hubLive && IsObject(HL)) {
        RN_wasHub := 1
        ; Already on its way out - nothing to tell it, and re-raising the card
        ; over a close animation would fight it.
        if HL.closeAt
            return
        ; already saying it - do not restart the entrance under the user
        if (HubGateUp() && HubGateKind() = 2 && !HL.gateOut) {
            HubPoke()
            return
        }
        ; A hub put away in the tray has to come back to be read.
        if hubHidden {
            hubHidden := 0
            try DllCall("ShowWindow", "ptr", HL.gui.Hwnd, "int", 8)   ; SW_SHOWNA
        }
        ; ...and one collapsed to the pill has to come back out. The card is
        ; drawn against the panel's geometry, so a pill would leave it floating
        ; beside a window that is no longer under it.
        if (HL.minTo = 1.0 || HL.minT >= 0.5)
            HubMin(0.0)
        HL.gateKind := 2
        HL.gateAt := A_TickCount, HL.gateOut := 0
        ; ---- and bring it back to the middle of the screen ----
        ; Wherever the hub had been dragged to, it was dragged there on the OLD
        ; screen: on a smaller one it can be half off the edge, and on a larger
        ; one stranded in a corner well away from where the eye is. The card is
        ; the last thing this window will ever show, so it is worth putting
        ; somewhere it will actually be read. HubClampTick walks it there over
        ; the same few frames the card is fading in.
        HL.reCtr := 1
        ; The card is modal over the whole hub, so anything already holding a
        ; caret or a hover underneath it is dropped rather than left live.
        try HubGateClearBelow()
        HubRaise()
        HubPoke()
        HubTim(TICK_A)
        try YuriLog("NOTICE raised in-hub (gate card)")
        return
    }
    ; ---- no hub to put it on ----
    ; A display change during the splash, or after the hub has already gone.
    ; There is nothing to close and nowhere to draw, so the standalone card is
    ; still the answer for this case alone.
    RN_wasHub := 0
    if (RN_gui != "" && !RN_closing) {
        RNTim(TICK_A)
        return
    }
    try PuzCalCancel()
    try PuzDbgKill()
    try PuzMarkersKill()
    RN_at := A_TickCount, RN_closing := 0, RN_h := 0.0, RN_hot := 0, RN_down := 0, RN_downAt := 0
    RN_hold := 0, RN_last := RN_at, RN_probed := 0
    RNTim(TICK_A)
}
RNTim(ms) {
    static cur := 0
    if (cur = ms)
        return
    cur := ms
    SetTimer(RNRender, ms)
}
RNKill() {
    global RN_gui, RN_dc, RN_bm, RN_g, RN_plain
    RNTim(0)
    if (RN_plain != "") {
        try RN_plain.Destroy()
        RN_plain := ""
    }
    if RN_g
        try DllCall("gdiplus\GdipDeleteGraphics", "ptr", RN_g)
    if RN_dc
        try DllCall("gdi32\DeleteDC", "ptr", RN_dc)
    if RN_bm
        try DllCall("gdi32\DeleteObject", "ptr", RN_bm)
    RN_g := 0, RN_dc := 0, RN_bm := 0
    if (RN_gui != "") {
        try OnMessage(0x201, RNClick, 0)
        try OnMessage(0x202, RNUp, 0)
        try OnMessage(0x200, RNMove, 0)
        try RN_gui.Destroy()
        RN_gui := ""
    }
}
RNClose() {
    global RN_closing, RN_at
    if RN_closing
        return
    RN_closing := 1, RN_at := A_TickCount
    RNTim(TICK_A)
}
RNBtnRect(&bx, &by, &bw, &bh) {
    bw := 150, bh := 36
    bx := RN_W - bw - 26, by := RN_H - bh - 24
}
RNRender() {
    global G, RN_gui, RN_dc, RN_bm, RN_g, RN_h, RN_hold, RN_last, RN_probed, RN_px, RN_py
    now := A_TickCount
    ; ---- one clock drives everything ----
    ; in on a 420 ms ease, out on 260. Deriving both from RN_at rather than
    ; stepping a value per frame means a late frame cannot leave the card
    ; half-faded at rest, which is the failure this suite has hit before.
    if RN_closing {
        e := Clamp((now - RN_at)/260.0, 0.0, 1.0)
        f := 1 - Ease3(e)
        if (e >= 1.0) {
            RNKill()
            return
        }
    } else {
        f := Ease3(Clamp((now - RN_at)/420.0, 0.0, 1.0))
    }
    w := RNw(), h := RNh()
    if !RN_g {
        bi := Buffer(40, 0)
        NumPut("uint", 40, bi, 0), NumPut("int", w, bi, 4), NumPut("int", -h, bi, 8)
        NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
        RN_bm := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0
                       , "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
        RN_dc := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
        DllCall("gdi32\SelectObject", "ptr", RN_dc, "ptr", RN_bm)
        DllCall("gdiplus\GdipCreateFromHDC", "ptr", RN_dc, "ptr*", &g2 := 0)
        DllCall("gdiplus\GdipSetSmoothingMode",     "ptr", g2, "int", 4)
        DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", 4)
        DllCall("gdiplus\GdipSetPixelOffsetMode",   "ptr", g2, "int", 2)
        RN_g := g2
    }
    ; ---- an ORDINARY window, not a layered one ----
    ; This card was built on UpdateLayeredWindow like every other surface in the
    ; suite, and on this machine that call does not present: the window is
    ; created, painted, shown and raised and stays invisible, which is why four
    ; rounds of work on detection, z-order, throw-guarding and paint order all
    ; changed nothing. The plain-control fallback appearing is what proved it -
    ; ordinary windows show, layered ones do not.
    ;
    ; So the presentation changes and the artwork does not. The card is still
    ; drawn with GDI+ into the same off-screen surface; it is simply BitBlt onto
    ; a normal window instead of handed to UpdateLayeredWindow. What is lost is
    ; per-pixel alpha - the soft drop shadow that bled onto the desktop and the
    ; antialiased corner blend - so the body is drawn full-bleed and opaque and
    ; the corners come from a window region instead. Everything inside the card
    ; is unchanged.
    if (RN_gui = "") {
        MonitorGetWorkArea(MonitorGetPrimary(), &sL, &sT, &sR, &sB)
        RN_px := sL + ((sR - sL) - w)//2
        RN_py := sT + ((sB - sT) - h)//2
        RN_gui := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x8000000", "YURIRESNOTE")
        RN_gui.Show(Format("NA x{} y{} w{} h{}", RN_px, RN_py, w, h))
        ; rounded corners without per-pixel alpha
        try WinSetRegion(Format("0-0 w{} h{} R{}-{}", w, h, Round(20*scaleF), Round(20*scaleF))
                       , RN_gui.Hwnd)
        OnMessage(0x201, RNClick)
        OnMessage(0x202, RNUp)
        OnMessage(0x200, RNMove)
        try YuriLog("NOTICE window created and shown " w "x" h " at " RN_px "," RN_py)
    }
    ; hover eases toward the pointer state, same feel as every other control
    tgt := RN_hot ? 1.0 : 0.0
    RN_h += (tgt - RN_h)*0.28
    if (Abs(tgt - RN_h) < 0.004)
        RN_h := tgt
    ; The hub's render pass is the only caller of these, and the hub is stopped
    ; by the time this runs - so with the notice up, nothing bounded the two
    ; caches at all. This is the top of a render pass, which is the one place
    ; they are safe to call from.
    BrushCacheTick(), PenCacheTick()

    prevC := A_IsCritical
    Critical "On"
    g0 := G
    G := RN_g
    try {
        ResetSurface(G, w/RN_W, h/RN_H)
        ; ---- opaque, and the card fills the surface ----
        ; On a layered window the surface was cleared to nothing and the card was
        ; inset so its drop shadow could bleed onto the desktop. A normal window
        ; has no per-pixel alpha: anything not painted shows as black, and a
        ; shadow drawn against the card's own backing is just a dark smear. So
        ; the plate covers the whole surface, the outer shadow is gone, and the
        ; rounded corners come from the window region instead of from the paint.
        DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0xFF0D0F1D)
        acc := hubAccent
        ; ---- fonts, with a fallback for the pre-hub case ----
        ; ScreenWatch and WM_DISPLAYCHANGE are armed before HubOpen() runs, and
        ; LoadingScreen spins a message loop in between - so a display change
        ; during the splash reaches here with HL still 0. HL.fV/HL.fXs would
        ; throw on that. fBrand and fBadge are true globals built at startup and
        ; read close enough; once the hub exists its own faces are used.
        fHead := (IsObject(HL) && HL.HasOwnProp("fV"))  ? HL.fV  : fBrand
        fChip := (IsObject(HL) && HL.HasOwnProp("fXs")) ? HL.fXs : fBadge
        el  := now - RN_at                       ; time since the card was armed
        ; The contents enter; the plate does not move, because a plate that
        ; slides on an opaque window drags a hole behind it.
        dy := 0
        pd := 0
        cw := RN_W, chh := RN_H

        ; ---- body: gradient plate, micro-backdrop, border ----
        b := VBrush(pd, pd, cw, chh, FA(0xFF191D33, 1.0), FA(0xFF0D0F1D, 1.0))
        FillRR(pd, pd, cw, chh, 0, b), DelB(b)
        MicroBackdrop(pd, pd, cw, chh, 0, acc, f, now, 0.95)
        pn := Pen(FA(Alpha(acc, 165), f), 1.4)
        StrokeRR(pd + 0.7, pd + 0.7, cw - 1.4, chh - 1.4, 0, pn), DelP(pn)
        ; accent rail down the leading edge - the hub card's own signature
        b := VBrush(pd + 1, pd + dy + 16, 2, chh - 32, FA(Alpha(AccHi(acc, 0.5), 215), f)
                                                     , FA(Alpha(acc, 35), f))
        FillRR(pd + 1, pd + dy + 16, 2, chh - 32, 1, b), DelB(b)
        ; top edge sweeping out from the middle as the card arrives
        sw := (cw - 170)*f
        b := HBrush(cw/2 - sw/2, pd + dy + 0.8, sw, 2
                  , FA(Alpha(AccHi(acc, 0.45), 30), f), FA(Alpha(AccHi(acc, 0.45), 230), f))
        FillRR(cw/2 - sw/2, pd + dy + 0.8, sw, 2, 1, b), DelB(b)

        ; ---- the monitor glyph, with a ring that punches outward on arrival ----
        ; drawn rather than a font character: it has to say "screen" at a glance
        ; and the suite has no icon font. A soft disc seats it; a second frame
        ; offset behind reads as the resolution that changed; a ring expands out
        ; of it once, the same idiom the gate glyph and every button press use.
        gx := 52, gy := 66 + dy
        rr := 24 + 26*(1 - Ease3(Clamp(el/640.0, 0.0, 1.0)))
        ra := RN_closing ? 0 : (1 - Clamp(el/640.0, 0.0, 1.0))
        if (ra > 0.01) {
            pn := Pen(FA(Alpha(AccHi(acc, 0.4), Round(175*ra)), f), 1.4)
            Ell(gx - rr, gy - rr, rr*2, rr*2, pn), DelP(pn)
        }
        b := SBrush(FA(Alpha(acc, 26), f))
        FillEll(gx - 27, gy - 27, 54, 54, b), DelB(b)
        ; the ghost frame behind - the old mode, dimmer and offset
        pn := Pen(FA(Alpha(acc, Round(95*f)), f), 1.4)
        StrokeRR(gx - 20, gy - 16, 30, 22, 4, pn), DelP(pn)
        ; the live frame in front, with its stand and base
        pn := Pen(FA(Alpha(AccHi(acc, 0.42), 240), f), 1.9)
        StrokeRR(gx - 14, gy - 11, 30, 22, 4, pn)
        Line(gx - 6, gy + 16, gx + 8, gy + 16, pn)
        Line(gx + 1, gy + 11, gx + 1, gy + 16, pn), DelP(pn)
        ; a small pulsing dot in the frame - the signal that something moved
        dp := Alpha(AccHi(acc, 0.5), Round(120 + 110*(Sin(DecT(now)*0.005) + 1)/2))
        b := SBrush(FA(dp, f))
        FillEll(gx - 1.5, gy - 3.5, 5, 5, b), DelB(b)

        ; ---- copy, entering line by line ----
        ; Each line waits on the one above it. The stagger is what the hub's own
        ; panels do on open, and it is the difference between a card that appears
        ; and one that arrives. On the way out everything fades together with f.
        tx := 96, tw := cw - 124
        l1 := Ease3(Clamp((el - 40)/360.0, 0.0, 1.0)) * (RN_closing ? f : 1)
        l2 := Ease3(Clamp((el - 120)/360.0, 0.0, 1.0)) * (RN_closing ? f : 1)
        l3 := Ease3(Clamp((el - 190)/360.0, 0.0, 1.0)) * (RN_closing ? f : 1)
        ; the new resolution, as a chip on the right of the heading line - laid
        ; out first so the heading can be clipped to stop short of it
        rs := PZ_vw " x " PZ_vh
        rw := MeasureW(rs, HL.fXs) + 22
        rcx := cw - 26 - rw
        Txt("RESOLUTION CHANGE DETECTED", tx + (1 - l1)*12, 34 + dy, rcx - tx - 10, 24, fHead
          , FA(Alpha(Mix(0xFFE8EAF6, acc, 0.22), 248), f*l1), fmtL)
        Txt("The hub builds its layout for the screen it opened on,"
          , tx + (1 - l2)*12, 66 + dy, tw, 18, fHint, FA(0xBEC7CBE0, f*l2), fmtL)
        Txt("so it has closed. Restart YURI to use it here."
          , tx + (1 - l3)*12, 86 + dy, tw, 18, fHint, FA(0xBEC7CBE0, f*l3), fmtL)
        b := SBrush(FA(Alpha(0xFFFFFF, Round(16*l1)), f))
        FillRR(rcx, 34 + dy, rw, 18, 9, b), DelB(b)
        pn := Pen(FA(Alpha(acc, Round(90*l1)), f), 1)
        StrokeRR(rcx, 34 + dy, rw, 18, 9, pn), DelP(pn)
        Txt(rs, rcx, 37 + dy, rw, 13, fChip, FA(Alpha(0xFFC7CBE0, Round(215*l1)), f), fmtC)

        FadeLine(26, cw - 26, 118 + dy, 0x1EFFFFFF, f)

        ; ---- self-dismiss progress bar ----
        ; The copy says the hub WILL close; this is the thing that makes that
        ; true without trapping anyone. A hairline track along the foot fills
        ; toward the accent, and RNRender closes the card when it completes.
        ; Hovering the card holds it - reading it should not be a race.
        prog := RN_closing ? 1.0 : Clamp((el - RN_hold)/RN_AUTO_MS, 0.0, 1.0)
        held := (RN_h > 0.02)                    ; pointer on the button - paused
        pbY := chh + dy - 3
        b := SBrush(FA(0x18FFFFFF, f))
        FillRR(pd, pbY, cw, 3, 0, b), DelB(b)
        b := SBrush(FA(Alpha(AccHi(acc, 0.4), held ? 90 : 200), f))
        FillRR(pd, pbY, Max(cw*prog, 2), 3, 0, b), DelB(b)

        ; ---- the button: six layers, matching the gate card exactly ----
        ; halo, gradient body, top-edge highlight, a sheen that crosses on hover,
        ; a ring that expands out of the press, and a tick that draws itself in
        ; beside the label. A resolution notice is not a lesser surface than the
        ; gate, so it gets the same button rather than a rectangle with a word.
        RNBtnRect(&bx, &by, &bw, &bh)
        by += dy
        hv := RN_h, pr := RN_down ? 1.0 : 0.0
        lift := -2.0*hv + 2.4*pr
        st := PushXform(bx + bw/2, by + bh/2 + lift, 1 - 0.025*pr, 0)
        x0 := bx, y0 := by + lift
        ; the ring the press throws off - outward and fading
        if (RN_downAt && now - RN_downAt < 420) {
            rp := (now - RN_downAt)/420.0
            gr := 6 + 26*Ease3(rp)
            pn := Pen(FA(Alpha(AccHi(acc, 0.45), Round(150*(1 - rp))), f), 1.6*(1 - rp) + 0.4)
            StrokeRR(x0 - gr, y0 - gr, bw + gr*2, bh + gr*2, 10 + gr, pn), DelP(pn)
        }
        ; halo lifts it off the card rather than merely brightening in place
        if (hv > 0.01) {
            b := SBrush(FA(Alpha(AccHi(acc, 0.4), Round(34*hv)), f))
            FillRR(x0 - 6, y0 - 5, bw + 12, bh + 10, 14, b), DelB(b)
        }
        ShadowDraw(x0, y0 + 2, bw, bh, 10, 4, 26, 14, f*(0.55 + 0.45*hv), 1.0)
        b := VBrush(x0, y0, bw, bh, FA(Alpha(AccHi(acc, 0.5), Round(198 + 40*hv)), f)
                                  , FA(Alpha(acc, Round(140 + 40*hv)), f))
        FillRR(x0, y0, bw, bh, 10, b), DelB(b)
        ; lit from above: a bright hairline along the top inside edge
        b := VBrush(x0 + 6, y0 + 1, bw - 12, bh*0.42, FA(Alpha(0xFFFFFF, Round(52 + 26*hv)), f)
                                                    , FA(Alpha(0xFFFFFF, 0), f))
        FillRR(x0 + 6, y0 + 1, bw - 12, bh*0.42, 8, b), DelB(b)
        ; a sheen that crosses once as the pointer arrives
        if (hv > 0.02 && hv < 0.995) {
            sx2 := x0 - 30 + (bw + 60)*hv
            pth := RRPath(x0, y0, bw, bh, 10)
            DllCall("gdiplus\GdipSetClipPath", "ptr", G, "ptr", pth, "int", 0)
            b := HBrush(sx2 - 16, y0, 32, bh, FA(Alpha(0xFFFFFF, 0), f)
                                            , FA(Alpha(0xFFFFFF, Round(46*Sin(hv*3.14159))), f))
            FillRR(sx2 - 16, y0, 32, bh, 0, b), DelB(b)
            DllCall("gdiplus\GdipResetClip", "ptr", G)
            DllCall("gdiplus\GdipDeletePath", "ptr", pth)
        }
        pn := Pen(FA(Alpha(AccHi(acc, 0.6), Round(215 + 40*hv)), f), 1.3)
        StrokeRR(x0, y0, bw, bh, 10, pn), DelP(pn)
        ; label centred across the whole button, no glyph - the hub's own
        ; convention, and the same shape the gate card uses
        TxtP("GOT IT", x0, y0 - 1 - (hubLowPerf ? 0 : 0.6*hv - 0.8*pr), bw, bh
           , fBadge, FA(0xFFFFFFFF, f), fmtC)
        Pop(st)
    } catch as paintErr {
        ; ---- the notice must not be able to fail silently ----
        ; The designed paint above reaches into the hub's whole drawing stack -
        ; ShadowDraw's cache, MicroBackdrop, the TH/AccHi memos, the shared brush
        ; and pen caches, HL's fonts - at the one moment that stack is KNOWN to
        ; describe a screen that no longer exists. Guarding it stopped a throw
        ; from destroying the window, but it did NOT make the window visible: the
        ; surface is cleared to transparent on the first line, so a throw two
        ; lines later presents a fully transparent bitmap through
        ; UpdateLayeredWindow. That is a window that exists, is shown, is topmost,
        ; and cannot be seen - which reads exactly like "no popup appeared".
        ;
        ; So the fall-back is a card drawn with the plainest calls in the file:
        ; one clear, one filled rounded rect, one stroke, three strings. No
        ; caches, no HL, no gradients, no backdrop. If THIS cannot draw, nothing
        ; in the process can.
        ;
        ; The exception is written to errors.log with its line, because a
        ; fall-back that hides the bug is only half a fix.
        try YuriLog("ERROR  resolution notice paint failed - fell back  "
                  . (IsObject(paintErr) && paintErr.HasOwnProp("Message") ? paintErr.Message : "")
                  . (IsObject(paintErr) && paintErr.HasOwnProp("Line") ? "  line " paintErr.Line : ""))
        try {
            DllCall("gdiplus\GdipResetClip", "ptr", G)
            DllCall("gdiplus\GdipResetWorldTransform", "ptr", G)
            DllCall("gdiplus\GdipScaleWorldTransform", "ptr", G, "float", w/RN_W, "float", h/RN_H, "int", 0)
            DllCall("gdiplus\GdipGraphicsClear", "ptr", G, "uint", 0)
            ; Direct GDI+ only. SBrush routes through TH and the brush cache, and
            ; Txt routes through SBrush - so the obvious helpers would put the
            ; theme memos and the cache back in the path of the one paint whose
            ; whole job is to work when that machinery does not.
            DllCall("gdiplus\GdipCreateSolidFill", "uint", 0xF01A1E33, "ptr*", &fb := 0)
            DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", fb
                  , "float", 0, "float", 0, "float", RN_W, "float", RN_H - 8)
            DllCall("gdiplus\GdipDeleteBrush", "ptr", fb)
            DllCall("gdiplus\GdipCreatePen1", "uint", 0xFF7A82A0, "float", 1.4, "int", 2, "ptr*", &fp := 0)
            DllCall("gdiplus\GdipDrawRectangle", "ptr", G, "ptr", fp
                  , "float", 0.7, "float", 0.7, "float", RN_W - 1.4, "float", RN_H - 9.4)
            DllCall("gdiplus\GdipDeletePen", "ptr", fp)
            DllCall("gdiplus\GdipCreateSolidFill", "uint", 0xFFE8EAF6, "ptr*", &tb := 0)
            rcF := Buffer(16)
            NumPut("float", 30, "float", 38, "float", RN_W - 60, "float", 26, rcF)
            DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", "RESOLUTION CHANGE DETECTED"
                  , "int", -1, "ptr", fBrand, "ptr", rcF, "ptr", fmtL, "ptr", tb)
            NumPut("float", 30, "float", 78, "float", RN_W - 60, "float", 20, rcF)
            DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", "The hub has closed."
                  , "int", -1, "ptr", fHint, "ptr", rcF, "ptr", fmtL, "ptr", tb)
            NumPut("float", 30, "float", 100, "float", RN_W - 60, "float", 20, rcF)
            DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", "Restart YURI to use it at this resolution."
                  , "int", -1, "ptr", fHint, "ptr", rcF, "ptr", fmtL, "ptr", tb)
            NumPut("float", RN_W - 176, "float", RN_H - 52, "float", 150, "float", 22, rcF)
            DllCall("gdiplus\GdipDrawString", "ptr", G, "wstr", "GOT IT"
                  , "int", -1, "ptr", fBadge, "ptr", rcF, "ptr", fmtC, "ptr", tb)
            DllCall("gdiplus\GdipDeleteBrush", "ptr", tb)
            DllCall("gdiplus\GdipCreatePen1", "uint", 0xFF8A90A6, "float", 1.2, "int", 2, "ptr*", &bp := 0)
            DllCall("gdiplus\GdipDrawRectangle", "ptr", G, "ptr", bp
                  , "float", RN_W - 176, "float", RN_H - 58, "float", 150, "float", 36)
            DllCall("gdiplus\GdipDeletePen", "ptr", bp)
        }
    } finally {
        ; ---- restored in a finally, and to what it WAS ----
        ; `G := g0` sat after the last draw call, so a throw left the suite's
        ; shared surface pointer aimed at this card's private graphics and every
        ; renderer after it drew into a small bitmap. Critical was left on for
        ; the same reason. Neither is recoverable and neither was visible.
        G := g0
        Critical prevC
    }

    ; ---- present: a straight blit onto the window ----
    ; The whole surface every frame. It is 520 x 212 and the card animates, so
    ; there is nothing to gain from partial updates, and blitting the lot means
    ; a repaint Windows asks for between frames can never show a torn card.
    ; SRCCOPY, and the surface is opaque, so no blend and no erase step.
    hdcW := DllCall("user32\GetDC", "ptr", RN_gui.Hwnd, "ptr")
    if hdcW {
        DllCall("gdi32\BitBlt", "ptr", hdcW, "int", 0, "int", 0, "int", w, "int", h
                              , "ptr", RN_dc, "int", 0, "int", 0, "uint", 0x00CC0020)
        DllCall("user32\ReleaseDC", "ptr", RN_gui.Hwnd, "ptr", hdcW)
    }
    ; ---- and kept at the FRONT of the topmost band ----
    ; +AlwaysOnTop puts it in the band; it does not keep it at the front of one.
    ; Everything this notice appears over is also topmost - the hub, the overlay,
    ; the puzzle card, the markers - and a resolution change is exactly the
    ; moment several of them are being rebuilt and re-raised.
    ; HWND_TOPMOST unconditionally, NOT HubZRaise: that one honours the hub's
    ; ALWAYS ON TOP setting, and this window is not the hub.
    try DllCall("SetWindowPos", "ptr", RN_gui.Hwnd, "ptr", -1
              , "int", 0, "int", 0, "int", 0, "int", 0, "uint", 0x13)
    ; ---- confirm it is actually on screen ----
    ; Kept from the layered version, because the lesson stands: this card has to
    ; be able to tell the difference between "presented" and "assumed
    ; presented". Ordinary windows are far more reliable than the layered path
    ; that failed here, but the cost of checking is one call once per notice and
    ; the cost of being wrong is the user losing their hub with no explanation.
    if (!RN_probed && !RN_closing && now - RN_at > 260) {
        RN_probed := 1
        vis := DllCall("user32\IsWindowVisible", "ptr", RN_gui.Hwnd)
        rc9 := Buffer(16, 0)
        DllCall("user32\GetWindowRect", "ptr", RN_gui.Hwnd, "ptr", rc9)
        gw9 := NumGet(rc9, 8, "int") - NumGet(rc9, 0, "int")
        gh9 := NumGet(rc9, 12, "int") - NumGet(rc9, 4, "int")
        try YuriLog("NOTICE probe: visible=" vis " rect=" gw9 "x" gh9)
        if (!vis || gw9 < 8 || gh9 < 8) {
            try YuriLog("NOTICE window did not present - using plain fallback")
            RNPlainShow()
        }
    }
    ; ---- self-dismiss ----
    ; The copy says the hub WILL close; this is what makes that true without
    ; trapping anyone. Hovering the button PAUSES the countdown rather than
    ; deferring it: RN_hold accumulates the paused time and the deadline moves
    ; out by exactly that much, so reading the card buys real time instead of
    ; queueing an instant close for the moment the pointer leaves.
    if (!RN_closing && RN_h > 0.02)
        RN_hold += now - RN_last
    RN_last := now
    if (!RN_closing && RN_h <= 0.02 && now - RN_at - RN_hold >= RN_AUTO_MS)
        RNClose()
    ; ---- frame rate ----
    ; Full rate while ANYTHING is moving: the entrance and exit eases, the
    ; punch-out ring, the button hover/press, and the whole time the dismiss bar
    ; is advancing. A paused countdown still animates (the bar holds dim under
    ; the pointer, the glyph keeps pulsing), so hovering stays on the fast tier
    ; too. The old test dropped to 2 fps at 460 ms unconditionally, which
    ; stuttered both the bar and the pulse.
    live := RN_closing || (now - RN_at < 700) || RN_h > 0.004 || RN_down
          || (RN_downAt && now - RN_downAt < 460)
          || (now - RN_at - RN_hold < RN_AUTO_MS)
    RNTim(live ? TICK_A : TICK_G)
}
; ---- the notice that cannot fail ----
; An ordinary window with real controls: no layered surface, no GDI+, no
; UpdateLayeredWindow, no shared graphics pointer, none of the machinery the
; designed card depends on. It is plainer than the card by a wide margin and it
; is meant to be - it exists so that "the hub closed and nothing told me why"
; cannot happen, whatever is wrong with the surface path on a given machine.
;
; Styled as far as an ordinary Gui goes: the hub's own plate colour, its text
; colours, Segoe UI, and a real button. Not animated, because a window made of
; controls cannot be animated the way the card is, and a static window that is
; visible beats an animated one that is not.
RNPlainShow() {
    global RN_plain
    if (RN_plain != "")
        return
    RN_plain := Gui("+AlwaysOnTop +ToolWindow -MinimizeBox -MaximizeBox", APPNAME)
    RN_plain.BackColor := "1A1E33"
    RN_plain.MarginX := 0, RN_plain.MarginY := 0
    RN_plain.SetFont("s12 w600 cE8EAF6", "Segoe UI")
    RN_plain.Add("Text", "x28 y26 w440", "Resolution change detected.")
    RN_plain.SetFont("s9 w400 cC7CBE0", "Segoe UI")
    RN_plain.Add("Text", "x28 y62 w440"
               , "The hub builds its layout for the screen it opened on, so it has`n"
               . "closed. Restart " APPNAME " to use it at this resolution.")
    b := RN_plain.Add("Button", "x186 y116 w120 h32", "GOT IT")
    b.OnEvent("Click", RNPlainClose)
    RN_plain.OnEvent("Close", RNPlainClose)
    RN_plain.OnEvent("Escape", RNPlainClose)
    RN_plain.Show("w492 h168")
}
RNPlainClose(*) {
    global RN_plain
    if (RN_plain = "")
        return
    try RN_plain.Destroy()
    RN_plain := ""
    RNClose()                       ; take the layered attempt down with it
}
RNZone(sx, sy) {
    if (RN_gui = "")
        return 0
    ; Against where the window ACTUALLY is, not where a fresh centring
    ; calculation says it should be - those are the same number until the work
    ; area moves, which for this card is precisely the event that raised it.
    k := RNw()/RN_W
    RNBtnRect(&bx, &by, &bw, &bh)
    x := (sx - RN_px)/k, y := (sy - RN_py)/k
    return (x >= bx && x < bx + bw && y >= by && y < by + bh) ? 1 : 0
}
RNMove(wParam, lParam, msg, hwnd) {
    global RN_hot
    if (RN_gui = "" || hwnd != RN_gui.Hwnd)
        return
    CursorXY(&x, &y)
    z := RNZone(x, y)
    if (z != RN_hot) {
        RN_hot := z
        RNTim(TICK_A)
    }
    return 0
}
RNClick(wParam, lParam, msg, hwnd) {
    global RN_down, RN_downAt
    if (RN_gui = "" || hwnd != RN_gui.Hwnd)
        return
    CursorXY(&x, &y)
    RN_down := RNZone(x, y)
    if RN_down
        RN_downAt := A_TickCount        ; the release ring expands from here
    RNTim(TICK_A)
    return 0
}
RNUp(wParam, lParam, msg, hwnd) {
    global RN_down
    if (RN_gui = "" || hwnd != RN_gui.Hwnd)
        return
    CursorXY(&x, &y)
    if (RN_down && RNZone(x, y))
        RNClose()
    RN_down := 0
    RNTim(TICK_A)
    return 0
}

; ============================================================================
;  RESOLUTION CHANGES
; ----------------------------------------------------------------------------
;  The hub does not follow a resolution change. It used to try - rebuild the
;  surface, re-derive the transform, re-key every cache - and each round of that
;  fixed something real and still left the module wrong, because the state that
;  matters is spread across the hub's surface, the puzzle grid, the capture
;  buffers, the marker layer and half a dozen caches that were each written
;  assuming the screen was a constant.
;
;  So it does the honest thing instead: it notices, says so, and closes. HubOpen
;  rebuilds everything from scratch, which is the one code path already proven
;  to be correct at any resolution - that is why launching at the new resolution
;  always worked. Reopening the hub runs exactly that path.
; ============================================================================


HubOpen() {
    global HL, hubLive, statStart, hubTab, hubTabPrev, hubTabAt
    if hubLive
        return
    ; ---- scaleF is NOT re-read here, and that is deliberate ----
    ; It was, for one build, from GetDpiForSystem - and that doubled the whole
    ; interface on a high-DPI display. GetDpiForSystem reports the PHYSICAL dpi.
    ; This process is DPI-unaware, so every coordinate it deals in - the metrics
    ; from GetSystemMetrics, the cursor from GetCursorPos, the desktop it BitBlts,
    ; the absolute mouse range it injects into - is in Windows' VIRTUALISED
    ; space, and A_ScreenDPI is the dpi OF THAT SPACE. Mixing the two scales the
    ; layout by the very factor the virtualisation already applied.
    ;
    ; ScreenWatch still uses the physical value, but only to notice that
    ; something changed - never to size anything.
    statStart := A_TickCount
    hubTab := 1, hubTabPrev := 1, hubTabAt := 0


    cw := 780, ch := 520, pd := 26
    bw := cw + pd*2, bh := ch + pd*2
    MonitorGetWorkArea(MonitorGetPrimary(), &mL, &mT, &mR, &mB)
    mag := Min(hubMag, ((mR - mL) - 16)/(bw*scaleF), ((mB - mT) - 16)/(bh*scaleF))
    pw := Round(bw*scaleF*mag), ph := Round(bh*scaleF*mag)

    bi := Buffer(40, 0)
    NumPut("uint", 40, bi, 0), NumPut("int", pw, bi, 4), NumPut("int", -ph, bi, 8)
    NumPut("ushort", 1, bi, 12), NumPut("ushort", 32, bi, 14)
    hbmH := DllCall("gdi32\CreateDIBSection", "ptr", 0, "ptr", bi, "uint", 0, "ptr*", &pb := 0, "ptr", 0, "uint", 0, "ptr")
    hdcH := DllCall("gdi32\CreateCompatibleDC", "ptr", 0, "ptr")
    DllCall("gdi32\SelectObject", "ptr", hdcH, "ptr", hbmH)
    DllCall("gdiplus\GdipCreateFromHDC", "ptr", hdcH, "ptr*", &g2 := 0)
    DllCall("gdiplus\GdipSetSmoothingMode", "ptr", g2, "int", 4)
    DllCall("gdiplus\GdipSetTextRenderingHint", "ptr", g2, "int", 4)
    DllCall("gdiplus\GdipSetPixelOffsetMode", "ptr", g2, "int", 2)
    DllCall("gdiplus\GdipSetInterpolationMode", "ptr", g2, "int", 7)
    DllCall("gdiplus\GdipScaleWorldTransform", "ptr", g2, "float", pw/bw, "float", ph/bh, "int", 0)

    ; ---- a normal window, with a taskbar button ----
    ; +ToolWindow is WS_EX_TOOLWINDOW, and its whole purpose is to keep a window
    ; OUT of the taskbar and out of alt-tab - which is right for the overlay and
    ; the puzzle card, floating things that belong to a game, and wrong for the
    ; hub, which is the application. Swapped for +E0x40000 (WS_EX_APPWINDOW),
    ; which forces the taskbar button and with it the icon and the alt-tab entry.
    ;
    ; WS_EX_NOACTIVATE and the "NA" show stay: the hub still never takes focus
    ; from a game by appearing or being clicked, which is the property the whole
    ; suite is built around. The taskbar entry is presence, not activation.
    gw := Gui("-Caption +E0x80000 +E0x8000000 +E0x40000 " (hubTop ? "+AlwaysOnTop " : "") "-DPIScale", "YURIHUB")
    gw.Show("NA x0 y0 w" pw " h" ph)
    bx := mL + ((mR - mL) - pw)//2
    by := mT + ((mB - mT) - ph)//2

    HL := {}
    HL.cw := cw, HL.ch := ch, HL.pd := pd, HL.bw := bw, HL.bh := bh, HL.pw := pw, HL.ph := ph
    HL.k := pw/bw
    HL.g2 := g2, HL.hdc := hdcH, HL.hbm := hbmH, HL.gui := gw
    HL.bx := bx, HL.by := by, HL.px := bx, HL.py := by, HL.prevBX := bx
    HL.reCtr := 0                            ; set only by the resolution card
    HL.bcx := pd + cw - 24, HL.bmx := pd + cw - 48, HL.bty := pd + 22
    HL.brx := pd + 30
    HL.sbx := pd + 18, HL.sby := pd + 46, HL.sbw := 140
    HL.nvh := 38, HL.nvg := 44
    HL.avcx := HL.sbx + 35, HL.avcy := pd + ch - 44
    HL.ctx := HL.sbx + HL.sbw + 30, HL.cty := pd + 46
    HL.ctw := cw - (HL.ctx - pd) - 22
    HL.abx := HL.ctx + 168, HL.aby := HL.cty + 56, HL.abw := HL.ctw - 168, HL.abh := 82
    ; Each system card owns the keybind rows directly beneath it, so a key is
    ; read against the thing it drives rather than from a pooled list at the
    ; bottom of the panel:
    ;     AUTOBLOCK card  ->  HL.kby   (1 row : autoblock)
    ;     PUZZLE AI card  ->  HL.kby2  (2 rows: solve, markers)
    HL.kby  := HL.aby + HL.abh + 14                      ; AUTOBLOCK's key
    ; 126, not 112: the grid row now carries a caption line under it the way the
    ; speed row carries its caveat - see PZ_NTY. Everything below is derived from
    ; this (kby2, the two key rows, the clash card's dim), so the extra 14 px
    ; propagates on its own. Checked against the column: the keys end at 462 and
    ; the panel body runs to 546.
    ; 178, not 150: the grid SIZE row (PZ_SZY) sits between the speed caveat and
    ; the buttons, and everything under it moved down 28 px with it. kby2, the
    ; two key rows and the clash card's dim all derive from this, so the extra
    ; height propagates on its own. Checked against the column: the keys now end
    ; at 490 and the panel body still runs to 546.
    HL.aby2 := HL.kby + 22 + 16, HL.abh2 := 178          ; PUZZLE AI panel (speed + size + grid + status + note)
    HL.kby2 := HL.aby2 + HL.abh2 + 14                    ; PUZZLE AI's two keys
    HL.tgw := 46, HL.tgh := 24
    HL.tgx := HL.abx + HL.abw - HL.tgw - 18, HL.tgy := HL.aby + 30
    HL.tgx2 := HL.tgx, HL.tgy2 := HL.aby2 + 28           ; PUZZLE AI toggle position
    ; ---- the rail had to give up height for a sixth card ----
    ; Six cards plus TWO labelled breaks do not fit at the old 54/64/10/22.
    ; A break needs ~30px of clear air (a caption above the hairline and one
    ; below it), so the separators are the one thing that could not shrink -
    ; the cards and the gaps absorbed it instead. mdsep2 is smaller because the
    ; second break carries a caption on ONE side only.
    HL.mdscr := 0.0, HL.mdscrT := 0.0
