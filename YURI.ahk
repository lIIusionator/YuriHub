; ---- watchdog for the editor's hook ----
; SH.ih is opened with KeyOpt("{All}", "NS") - the S is SUPPRESS, so while it
; is running it swallows EVERY key on the machine, not just the ones the hub
; wants. FFM.ih has had FFMIHGuard watching it for exactly that reason; this
; one had nothing, and relied entirely on every minimise path remembering to
; call ScrBlur. A hook stranded by any path that forgot does not merely leave
; the hub "still interactive" - it takes the user's whole keyboard with it.
;
; So it is watched rather than trusted. Same predicate as the mouse map.
ScrIHGuard() {
    if (!SH.focus && !SH.ih) {
        SetTimer(ScrIHGuard, 0)
        return
    }
    ; the hook is what swallows keystrokes - if it is gone, the focus is stale
    if (SH.focus && !SH.ih) {
        ScrBlur()
        return
    }
    if !HubBodyLive() {
        ScrBlur()
        return
    }
    ; ---- the user went somewhere else ----
    ; FFM.ih has had this since it was written; SH.ih never did, and SH.ih is
    ; the worse one to leave armed because it opens with KeyOpt("{All}", "NS")
    ; and SUPPRESSES every key on the machine. Typing a place id, switching to
    ; Discord and finding the keystrokes still going into the hub is this gap:
    ; nothing in the SH path could see that the user had left.
    ;
    ; The hub is WS_EX_NOACTIVATE and shown with "NA", so it never becomes the
    ; active window and WinActive() on it is always false - a CHANGE of
    ; foreground window is the signal that is actually available. The click-away
    ; poll in HubRender covers clicking back into the app that was already in
    ; front; this covers alt-tab, the taskbar, and anything that moves the
    ; foreground without a click landing on the hub - including every case where
    ; the render loop has stopped because the hub is hidden.
    fg := 0
    try fg := WinExist("A")
    if !fg
        return
    if !SH.fgWin {                ; nothing latched at focus time - latch now
        SH.fgWin := fg
        return
    }
    if (fg != SH.fgWin && fg != HL.gui.Hwnd)
        ScrBlur()
}
; Zones that must NOT blur the field in progress, because they TAKE the caret
; themselves - the dispatch below calls ScrFocus/ScrFldMouse for every one of
; them. A zone missing here is blurred on the way in and re-focused by the
; dispatch, which is how a text box could take the caret and lose it on the
; same click.
;
; This was an inline `z != 60 && z != 66 && ...` chain grown one id at a time,
; and 240/241/242 (the PLACED script card's name, description and editor body)
; and 1035 (the account target box) had never been added to it. Naming it means
; the next field is registered in one obvious place instead of appended to a
; boolean nobody reads.
ScrKeepFocus(z) {
    switch z {
        case  60, 242: return true      ; editor body - new script, placed card
        case  66, 240: return true      ; name field  - new script, placed card
        case  67, 241: return true      ; description - new script, placed card
        case 136, 137: return true      ; profile name / bio
        case 966, 967: return true      ; the two library link fields
        case 1006, 1009: return true    ; discord app id / token
        case 1013: return true          ; rename box
        case 1035: return true          ; account target box
    }
    return false
}
ScrFocus(field) {
    global SH
    ; The two text systems share the keyboard, and only the click preamble ever
    ; released one when the other took over. Every ScrFocus that is NOT reached
    ; from a click - opening the rename sheet, loading a card into the editor -
    ; could therefore leave a flag-manager edit live underneath, with two input
    ; hooks racing for the same keystrokes.
    ; `field &&`: ScrFocus(0) is used as a plain blur in several places, and a
    ; blur has no business ending an edit in the other system.
    if (field && FFM.edit != "")
        FFMBlur()
    if SH.focus = field
        return
    if SH.focus
        ScrBlur()
    SH.focus := field
    SH.caretAt := A_TickCount
    if ScrFldIsLine() {
        SH.fCar := StrLen(ScrFld())
        SH.fSel := -1
    }
    SH.dblAt := 0
    if !field
        return
    SH.ih := InputHook()
    SH.ih.VisibleText := false
    SH.ih.VisibleNonText := false
    SH.ih.NotifyNonText := true
    SH.ih.KeyOpt("{All}", "NS")
    SH.ih.KeyOpt("{LShift}{RShift}{CapsLock}", "-S")
    SH.ih.KeyOpt("{Escape}", "E")
    SH.ih.OnChar := ScrChar
    SH.ih.OnKeyDown := ScrKey
    SH.ih.OnEnd := ScrEnd
