        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcT, "uint", c0t, "uint", c1t, "int", 0, "int", 3, "ptr*", &tbA := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", tbA, "float", tsx - 78, "float", cy, "float", 78, "float", ch), DelB(tbA)
        rcT2 := Buffer(16), NumPut("float", tsx - 1, "float", cy - 2, "float", 36, "float", ch + 4, rcT2)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "ptr", rcT2, "uint", c1t, "uint", c0t, "int", 0, "int", 3, "ptr*", &tbB := 0)
        DllCall("gdiplus\GdipFillRectangle", "ptr", G, "ptr", tbB, "float", tsx, "float", cy, "float", 34, "float", ch), DelB(tbB)
